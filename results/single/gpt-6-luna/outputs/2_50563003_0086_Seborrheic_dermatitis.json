    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic flaky, itchy scalp and facial rash, increased over the last 3–4 weeks. Involves scalp, eyebrows, nasolabial folds, peri-auricular areas and hairline, with mild presternal and under-breast involvement. Itch is mild; skin described as tight, greasy and scaly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Scalp examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diffuse fine white-yellow scale and mild frontal/parietal erythema. No plaques, pustules or fissures."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Facial examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous greasy scale in nasolabial folds, medial cheeks, eyebrows and peri-auricular areas. No significant telangiectasia or ocular findings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Trunk and flexural skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and fine scale presternally and under the breasts. No maceration or satellite lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No oral thrush, lymph node enlargement, nail pitting or classic psoriatic plaques."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Associated symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever or rigors, oral or genital thrush, or new products. No history of psoriasis, eczema or rosacea documented. No known immunosuppression or known HIV."
      }
    },
