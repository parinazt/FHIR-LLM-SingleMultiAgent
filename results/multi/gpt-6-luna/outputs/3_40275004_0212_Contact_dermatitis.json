      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "After a twisting injury from slipping on a wet salon floor about one week ago; pain is somewhat better than last week, remains anteromedial, and is worse at the end of the day after being on her feet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional mild giving way when going downstairs. Denies locking, true instability, night pain, or fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Weight-bearing and work function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fully weight-bearing and working full time with no time off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right knee inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No swelling, deformity, or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right knee palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild medial joint line tenderness; no warmth or effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right knee range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flexion approximately 130 degrees and extension 0 degrees; mild pain only at end flexion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right knee special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "McMurray causes mild medial discomfort with no click. Thessaly at 20 degrees is mildly uncomfortable. Lachman, anterior/posterior drawer, and varus/valgus testing are stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly antalgic after repeated squat; otherwise steady."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Hand skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing itchy, dry, cracked skin on the dorsum of the hands and fingers, worse after busy days with frequent wet work, shampoos, colours, and bleach. Itch occasionally disturbs sleep. Denies rash elsewhere, weeping, or pustules."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, mildly scaly plaques with fine fissuring over the dorsum of both hands, especially the right, and the knuckles. Palms largely spared. No vesicles, exudate, crust, pustules, nail changes, or lymphangitis."
      }
    },
