    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right shoulder pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right shoulder pain for approximately 5–6 days, beginning as a mild ache on waking and worsening, with a marked flare over the last 24–48 hours described as sharp and grabbing with movement. Anterolateral shoulder pain radiating to the mid-humerus, not past the elbow; 7–8/10 with movement and 3/10 at rest. Worse at night; unable to lie on the right side and struggling to sleep. Aggravated by reaching overhead, putting on a jumper, reaching behind the back, reaching across the body, and hanging washing. Improved with the arm by the side; heat pack helps a little. No trauma, fall, or heavy lifting. Reports repetitive overhead whiteboard and class display work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain, paraesthesiae, chest pain, shortness of breath, fevers, sweats, weight loss, or reported redness or swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right shoulder inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, swelling, or erythema. Mild tenderness at the anterolateral acromion/greater tuberosity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active flexion approximately 120 degrees, limited by pain. Abduction approximately 90–100 degrees with a painful arc from approximately 60–120 degrees. Internal rotation behind the back limited; unable to reach bra strap. Passive range of motion near full, with pain but no hard stop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right shoulder strength and provocative tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Supraspinatus testing reproduces pain with possible slight weakness versus pain inhibition. Infraspinatus and subscapularis strength grossly okay. Hawkins positive, Neer positive, and painful arc positive."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Cervical spine and upper-limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cervical spine full range of motion without reproduction of pain. Upper-limb neurovascular examination intact."
      }
    },
