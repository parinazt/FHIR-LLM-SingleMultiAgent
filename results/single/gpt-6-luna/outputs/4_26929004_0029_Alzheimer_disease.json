        "code": {
          "text": "Weight change and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild weight loss of approximately 3–4 kg over a year, including 1 kg since six months ago. Appetite is small but stable."
      }
