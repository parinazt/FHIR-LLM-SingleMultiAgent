        "medicationCodeableConcept": {
          "text": "Olopatadine 0.1% eye drops"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Instil 1 drop in both eyes twice daily during the symptomatic period",
            "route": {
              "text": "ophthalmic"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "drop"
                }
              }
            ]
          }
        ]
