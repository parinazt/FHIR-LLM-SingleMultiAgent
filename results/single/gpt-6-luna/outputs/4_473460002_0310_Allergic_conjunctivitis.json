        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant pain, photophobia, visual change, halos, headache, nausea, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Moderate conjunctival injection with perilimbal sparing; no ciliary flush. Watery mucoid discharge and mild chemosis. Lids normal; cornea clear; extraocular movements intact; pupils equal, round, and reactive to light."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
