        "code": {
          "text": "Upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Day 6 of coryzal illness. Started with sore throat and fatigue; now mainly blocked nose with mild dry cough. Mildly reduced appetite; oral intake okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Chest tightness and associated respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes tight chest when walking to clinic. No shortness of breath at rest, pleuritic chest pain, wheeze, or haemoptysis. Tight chest assessed as likely upper airway congestion and increased anxiety rather than lower respiratory tract infection or asthma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
