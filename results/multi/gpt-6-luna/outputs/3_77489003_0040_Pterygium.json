          "text": "Right eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small nasal pinguecula/very early pterygium-like change; no corneal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
