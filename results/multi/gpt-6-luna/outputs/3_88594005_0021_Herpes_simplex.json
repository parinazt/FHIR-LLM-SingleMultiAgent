    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Background dry eczematous skin, especially on the neck, antecubital fossae, and hands. Superimposed widespread monomorphic vesicles and punched-out erosions with crusting on an erythematous base over the face, neck, upper chest, upper back, and proximal arms; some lesions coalesce."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Skin tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very tender to light touch; patient winces."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Perioral and oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few small perioral erosions. No obvious large intraoral ulcers; patient reluctant to open mouth wide. Oral mucosa mildly erythematous, with no widespread ulceration or thrush."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Skin lesion findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No classic honey-coloured crust or frank pus. Some lesions have mild surrounding erythema; possible bacterial superinfection was queried. No vesicles on fingertips."
      }
    },
