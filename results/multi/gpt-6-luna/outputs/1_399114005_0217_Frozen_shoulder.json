    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a bad headache for 3 days, gradual onset, dull and constant, frontal and bitemporal (right greater than left), severity 7/10, worse in the evenings and not waking her from sleep. No thunderclap onset and not described as the worst ever. No nausea or vomiting, photophobia or phonophobia; reports mild light sensitivity and no visual aura. No jaw claudication or scalp tenderness. No focal neurological symptoms, weakness, facial droop, speech difficulty, confusion, loss of consciousness, seizure or ataxia. No neck stiffness, fever or rigors. Patient thinks it may be due to eyestrain from television and bright supermarket LED lights. Paracetamol 500 mg, 1–2 tablets as needed, maximum 3 per day, has provided partial relief. No recent head trauma. Patient reports blood pressure is usually a bit high."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing left shoulder stiffness and pain for approximately 8–9 months. Initially very painful and now mainly stiff. Patient cannot lift the arm to comb her hair or hang washing; sleep is disturbed because she cannot lie on the left side."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
