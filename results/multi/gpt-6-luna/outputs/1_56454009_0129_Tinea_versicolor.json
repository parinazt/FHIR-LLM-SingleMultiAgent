        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent frontal/retro-orbital headache for approximately 1–2 weeks, possibly longer; pressing, band-like; worse at the end of shifts and with bright lights or screens; partially improves with over-the-counter analgesia, dose unsure. Mild nausea and photophobia when bad. No thunderclap onset, no headache waking the patient from sleep, and no recent head trauma. No focal neurological symptoms, speech change, limb weakness or tingling, neck stiffness, or fever. No vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep, meals, and caffeine history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleeping 5–6 hours, skipping meals, and consuming high amounts of coffee and energy drinks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
