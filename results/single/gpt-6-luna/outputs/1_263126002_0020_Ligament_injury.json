        "code": {
          "text": "Right ankle pain with walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain 4–6/10, worse with stairs and uneven ground; symptoms approximately 50% better since the injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ankle injury history and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Twisted right ankle stepping off a curb; inversion and plantar flexion, heard a small pop. Swelling and lateral ankle bruising developed within hours, worst during the first 48 hours. Able to bear weight immediately but limping. Denies fall from height, head strike, other trauma, midfoot pain, knee pain, numbness, tingling, weakness, or giving way."
      }
    },
