        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports being afebrile at home and eating and drinking okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported respiratory, sinus, and other symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, chest pain, wheeze, facial pain, purulent sputum, gastrointestinal symptoms, haemoptysis, confusion, sinus tenderness, severe headache, photophobia, and neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
