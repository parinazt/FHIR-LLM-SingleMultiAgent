        "code": {
          "text": "Sleep, meals, and caffeine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleeping 5–6 hours, skipping meals, and consuming a high amount of coffee and energy drinks."
      }
