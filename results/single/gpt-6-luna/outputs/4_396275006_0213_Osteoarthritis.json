        "code": {
          "text": "Bilateral knee osteoarthritis, clinically likely moderate, with subjective instability and functional limitation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Hand osteoarthritis, mild and stable today"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding dull aching pain in the medial and anterior knees, worse with walking more than 10–15 minutes, stairs, and prolonged standing; eased by rest and sitting. Occasional night pain, not waking her most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Knee instability and near falls"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent subjective giving way in both knees, right greater than left, for approximately 6–9 months, especially descending steps and rising from a chair. Reports 3–4 near falls in the last 2 months; no definite complete falls. Feels knees are wobbly and may buckle. No episodes of giving way with sharp severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Knee stiffness, swelling, and crepitus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stiff after sitting for more than 20–30 minutes and on waking, loosening after a few minutes of movement. Reports puffiness at the end of the day and marked crackling and grinding. No redness or warmth reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Hand pain and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent hand pain and stiffness, especially at DIP and PIP joints with heavy use; bony fingertip nodules. No acute flare today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
