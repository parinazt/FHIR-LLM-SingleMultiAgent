        "code": {
          "text": "Weakness and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling really weak, tired, drained and 'wiped out' over the last ~5/7; struggles to get through the workday and fatigues by mid-afternoon."
      }
    },
