        "code": {
          "text": "Calf size and oedema"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right calf approximately equal in size to left; no generalised oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Left medial malleolus and ankle examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Healed hyperpigmented scar at the medial malleolus consistent with a previous venous ulcer; mild pitting oedema at the ankle."
      }
    },
    {
