        "code": {
          "text": "Cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pleuritic chest pain, ankle swelling, orthopnoea, or paroxysmal nocturnal dyspnoea. Weight subjectively stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
