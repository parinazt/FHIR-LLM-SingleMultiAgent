        "code": {
          "text": "Left lower leg pain and tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports left shin/calf tightness and pain, described as 'tight, like going to explode', after approximately 20–30 minutes of fast walking, heavy work, or stairs. Settles after approximately 15 minutes of rest and leg elevation. No pain at rest currently; reports it is 'a bit tight after busy week'."
      }
    },
