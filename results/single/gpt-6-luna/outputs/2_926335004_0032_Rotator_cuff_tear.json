    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right shoulder symptoms and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insidious right shoulder pain and weakness for 3–4 months. Dull ache over the lateral right shoulder and upper arm, worse reaching overhead or out to the side. Reports the arm is more weak than painful. Difficulty lifting a jug and shopping items, struggles above shoulder height and uses the left hand to assist. Dressing, putting on a bra or jumper, washing hair, and hanging washing are slower; avoids overhead tasks but remains independent. Night pain, especially lying on the right side, wakes her a few times per week. Today describes the shoulder as 'just a bit weak and a bit sore nothing to fuss about'; daughter is concerned about hanging washing and lifting a kettle."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right shoulder pain onset and trauma history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insidious onset; no trauma, fall, or heavy lifting. Possible overreach into a cupboard and slept in a recliner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Red-flag and associated symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain, radicular symptoms, paraesthesia, weight loss, fevers, night sweats, or cancer history. No new neurological symptoms; speech is okay, with no facial droop or leg weakness."
      }
    },
