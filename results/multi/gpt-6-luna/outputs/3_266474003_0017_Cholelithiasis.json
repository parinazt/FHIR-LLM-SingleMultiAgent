    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Recurrent upper abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 6 months, intermittent colicky right upper quadrant or epigastric pain, described as like a bad stitch, sometimes radiating to the right shoulder; up to 7/10, usually lasting 30–60 minutes, with two episodes lasting 2–3 hours; approximately 3–4 episodes per month, mostly in the evenings after fatty meals."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
