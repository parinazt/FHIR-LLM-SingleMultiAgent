        "code": {
          "text": "ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nasal mucosal oedema and clear rhinorrhoea; throat mildly erythematous without exudate; tympanic membranes within normal limits; no sinus tenderness to palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
