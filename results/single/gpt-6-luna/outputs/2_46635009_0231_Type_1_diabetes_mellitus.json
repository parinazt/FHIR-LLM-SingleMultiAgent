    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "10/7 of mid-to-lower lumbar pain, right greater than left, described as a dull ache with a sharp twinge on flexion or lifting. Insidious onset without trauma or a single heavy lift. Worse at the end of the teaching day or after marking at a table; better lying flat and with heat. A new firmer mattress about 3/52 ago and increased gardening may have triggered it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radicular symptoms, neurological symptoms, bowel or bladder change, night pain, weight loss, or fevers reported. No urinary symptoms or CVA pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gait normal. SLR negative bilaterally. Mild right paraspinal tenderness at L3–5; no midline tenderness. Lower-limb power, sensation, and reflexes normal. No saddle anaesthesia or CVA tenderness."
      }
    },
