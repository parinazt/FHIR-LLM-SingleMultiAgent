        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small amount of bright red blood on toilet paper and a few spots on stool for 2 days only; blood was not mixed with stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Bowel history and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of constipation and holding on at work. Denies diarrhoea, mucus, change in stool calibre, abdominal pain, weight loss, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
