        "code": {
          "text": "Right ankle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain 4–6/10 when walking; worse on stairs and uneven ground."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ankle symptom course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Twisted the right ankle 6 days ago stepping off a curb; inversion and plantar flexion, with a small pop heard. Able to weight-bear straight away but limping. Swelling and bruising at the lateral ankle developed within hours, were worst during the first 48 hours, and are now about 50% better."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right ankle weight-bearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced weight-bearing while continuing to work; able to weight-bear for more than 4 steps in the room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right ankle reported associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No midfoot pain, knee pain, numbness, tingling, weakness, or giving way."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
