    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull deep ache, sometimes sharp, for approximately 4–5 days, rated 5–6/10 and disturbing sleep; mild blocked sensation. No discharge, vertigo, tinnitus, or fever. Had a cold last week, mostly resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Ear and temporomandibular joint examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Both tympanic membranes normal, with no effusion or bulging. Left ear canal mildly erythematous only, with no debris or discharge; right canal normal. No mastoid tenderness. Hearing grossly normal; Weber midline and Rinne air conduction greater than bone conduction bilaterally. Mild tenderness over left TMJ on palpation and jaw opening. No red-flag neurological signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right wrist symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain with typing and lifting. Mild swelling and tenderness over radial styloid; pain with resisted thumb movements and ulnar deviation; positive Finkelstein test. Range of motion okay, no warmth or redness, neurovascularly intact."
      }
    },
