    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Mid–lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "New gradual central to slightly right-sided mid–lower back dull, tight ache for approximately 5–6 days, with no clear injury or radiation to the legs. Baseline intensity 4–5/10, increasing to 7/10 after a big work day. Worse at the end of the day on concrete and first thing in the morning; eases somewhat after moving. The patient wonders whether a new firmer mattress and increased ute driving on a rough driveway contribute."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Aggravated by bending, lifting ladders and tools, prolonged standing, and driving on a rough farm track. Relieved by lying flat, a heat pack, and Nurofen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Back pain functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working as an electrician and pacing himself; avoiding heavy lifting. No time off work yet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Back pain red-flag screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By history, no trauma or fall; saddle anaesthesia; leg weakness or numbness; bowel or bladder incontinence or retention; fevers; night sweats; weight loss; unrelenting nocturnal pain; known cancer; or systemic illness. No red-flag features elicited at this consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and reported mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no limb weakness, paraesthesia, or gait disturbance. By his own report, mobilising okay and able to heel-toe walk, squat, and climb stairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Urinary stream normal; no frequency, urgency, or change in nocturia. Baseline nocturia once nightly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No unexplained weight loss or fevers. Fatigue only in the context of poor sleep from pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Peyronie's curvature and plaque"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports penile curvature about the same over the last few months. History of a palpable plaque at diagnosis approximately 12 months ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Erectile symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild erectile symptoms, saying it takes a bit more effort; no complete erectile dysfunction. Some discomfort with intercourse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
