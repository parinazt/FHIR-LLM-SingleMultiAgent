        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild lumbar paraspinal tenderness; no midline bony tenderness. Reduced flexion and extension due to pain."
      }
    },
