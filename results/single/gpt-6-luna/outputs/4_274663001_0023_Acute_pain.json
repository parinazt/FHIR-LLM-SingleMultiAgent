    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and frustrated; not in obvious distress at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left shoulder inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, swelling, erythema, or wasting. Tender over lateral deltoid insertion and upper trapezius. No bony tenderness over clavicle, AC joint, or humeral head; no warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction to approximately 110 degrees, limited by pain; forward flexion to approximately 150 degrees with pain at end range; external rotation mildly limited by pain; internal rotation painful when reaching behind the back. Passive range slightly greater than active, with pain only at end range and no hard block."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left shoulder strength and special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rotator cuff strength 5-/5, limited by pain but symmetrical, with no focal weakness. Painful arc from 70 to 120 degrees; Hawkins-Kennedy positive; Neer mildly positive; empty can painful with strength preserved; Speed and O'Brien tests equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion, no tenderness, and Spurling test negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Upper limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Upper limb neurovascular examination intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reported red flags and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma beyond the initial lift, fall, or dislocation. No systemic symptoms, fever, weight loss, or night sweats. No chest pain, shortness of breath, or abdominal pain. No numbness, tingling, weakness, or loss of grip. Clinician documented no features of full-thickness tear, dislocation, fracture, septic arthritis, or neuro compromise."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Current left shoulder function and work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working and avoiding lifting; shoulder pain affects some activities of daily living and sleep. Patient wishes to avoid time off work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
