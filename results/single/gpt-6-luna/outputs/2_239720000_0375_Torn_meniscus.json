    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right knee symptom history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent medial joint-line pain, worse at the end of the day and on stairs; occasional catching described as “grabs then lets go.” No true locking, giving way, recent new trauma, redness, warmth, or systemic symptoms. Symptoms began after a twisting work injury approximately 3 months ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right knee and general examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, ambulant, independently mobile, with mild guarding of the right knee and no acute distress. Right knee: mild medial joint-line fullness, no deformity or erythema; medial joint-line and MCL tenderness without increased warmth; full extension and slight reduction in terminal flexion due to pain, with no mechanical block; varus and valgus stress causes medial discomfort without gross laxity; anterior drawer grossly normal; McMurray causes medial discomfort without a definite painful click. Slightly antalgic gait favouring the right side; able to fully weight bear. No features suggesting acute septic arthritis or fracture."
      }
    },
