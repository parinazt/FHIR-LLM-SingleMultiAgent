    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding low back pain, worse over the last 3–4 weeks; localized dull lumbar ache with stiffness, especially on getting up. Worse after sitting more than 30 minutes and first thing in the morning; improves somewhat with gentle movement. Patient thinks a new mattress and prolonged sitting in a recliner may contribute."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "5–6/10 most days, up to 8/10 with prolonged standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Low back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, urinary retention, faecal incontinence, severe night pain waking him, and trauma or fall. No cauda equina features or systemic infective symptoms documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
