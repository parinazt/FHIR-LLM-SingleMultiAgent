        },
        "valueString": "Grossly non-focal; gait normal; speech appropriate to language level."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cardiovascular: no chest pain, dyspnoea, or palpitations. Respiratory: no chronic cough or wheeze. Gastrointestinal: no abdominal pain or change in bowel habit. Patient denies feeling low when asked."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
