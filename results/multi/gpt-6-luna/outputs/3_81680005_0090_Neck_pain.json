        "medicationCodeableConcept": {
          "text": "Loperamide"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Took 2 mg for two doses on day 2 of diarrhoea, with partial relief."
          }
        ],
        "note": [
          {
            "text": "The plan stated that 2 mg as needed for short-term use was acceptable if needed to work, maximum 8 mg/day; stop if blood in stool or fever."
          }
        ]
