      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Low sexual desire with associated distress, consistent with HSDD / female sexual interest–arousal disorder"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 12–18 months ago and now persistent. Rare sexual thoughts; avoids initiating sex and often goes along with sex for her partner's sake, describing it as a chore and feeling as though the switch is off. She usually becomes aroused once engaged and is usually able to orgasm, though it takes longer and feels less intense."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Distress associated with low sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling guilty and 'a bit broken' and describes some strain in the relationship. Initially minimised the concern but acknowledged distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sexual pain and vulvovaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dyspareunia, vaginal dryness, postcoital bleeding, and pelvic pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other gynecologic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Periods regular every 28–32 days with moderate flow. Denies urinary symptoms and abnormal vaginal discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and safety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent low mood outside the sexual domain, general anhedonia, suicidal ideation, and thoughts of self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is somewhat fragmented, approximately 6–7 hours. Patient describes tiredness as 'normal busy mum tiredness.'"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Relationship and sexual safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a stable long-term relationship with a supportive male partner, some tension related to sex, and communication she describes as 'ok' but tends to brush the issue off. No intimate partner violence, coercion, or non-consensual sex disclosed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menopausal and endocrine-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports not pregnant and not menopausal; denies hot flushes, night sweats, hirsutism, acne, galactorrhoea, and virilisation."
      }
    },
