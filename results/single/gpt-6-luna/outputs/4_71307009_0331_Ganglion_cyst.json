    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported right wrist lump and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known right dorsal wrist ganglion diagnosed by a previous GP approximately 6–9 months ago; patient unsure of the timing, saying it may have been earlier this year or last year. Lump fluctuates in size and increases after a big day on the computer. Dull ache with occasional sharp twinge on extension, pain up to 5/10, especially at the end of the day. Interferes with typing and mouse work. Patient wondered whether phone use or coffee made it grow and was reassured that these were not related. No night pain or rest pain. No trauma reported, although patient later said they might have knocked it at the gym. No numbness, tingling, weakness, or dropping objects."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right wrist examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1.5–2 cm soft, fluctuant swelling on the dorsal right wrist over the scapholunate area. Non-erythematous and non-warm, with mild tenderness to palpation and discomfort only at end-range extension. Full flexion and extension with slight pain at terminal extension. Neurovascularly intact: good capillary refill, radial pulse present, sensation intact in median, ulnar, and radial distributions, and normal grip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right wrist associated red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies redness, warmth, fevers, weight loss, and night sweats."
      }
    },
    {
