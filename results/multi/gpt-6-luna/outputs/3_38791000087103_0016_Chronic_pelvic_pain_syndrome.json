    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Chronic pelvic pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for more than 3 years. Pattern largely similar, but bad days have become more frequent over the last 6–9 months. Dull, deep suprapubic and left-greater-than-right lower iliac fossa ache; baseline 2–3/10, flaring to about 7/10, especially around menses and mid-cycle. Worse after long days standing at work and sometimes after intercourse. Episodes last hours to a full day, with partial relief from simple analgesia and heat packs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Post-coital spotting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent small-volume spotting after intercourse for 3–4 months; settles within 24 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
