      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Gynaecological symptoms and menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "LMP about 2 weeks ago; regular 28-day cycles and reports good compliance with COCP. Denies PV bleeding or discharge."
      }
    },
