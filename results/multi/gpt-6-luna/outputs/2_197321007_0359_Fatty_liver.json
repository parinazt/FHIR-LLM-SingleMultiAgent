    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right great toe pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain at the right 1st MTP for 4–5 days, with insidious onset; described as “throbbing,” worse with weight bearing and sheet touch. Pain increased over the last 2 days, then plateaued."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right foot mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to mobilise with a frame but favouring the right foot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right 1st MTP examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild swelling, erythema and warmth; marked tenderness; reduced range of motion due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right foot and joint examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No skin breaks, tophi, streaking or cellulitis. Pulses present, capillary refill under 2 seconds, sensation intact. Other joints with no abnormal findings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General and systems examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Afebrile and systemically well. No stigmata of chronic liver disease. Cardiovascular, respiratory and abdominal examinations grossly within normal limits."
      }
    },
