        "medicationCodeableConcept": {
          "text": "Imiquimod 5% cream (Aldara)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to visible warts at night 3 times per week (e.g. Monday, Wednesday, Friday). Wash off 6–10 hours later. Use for up to 16 weeks or until clearance. If marked irritation occurs, reduce frequency or pause.",
            "route": {
              "text": "topical"
            },
