      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Telehealth appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On time; initially joined with camera off and turned it on after prompting. Visibly anxious and fidgeting, avoided eye contact with the camera, and frequently checked the time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Video examination and mental state findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well groomed and appears stated age; normal colour and work of breathing, speaking in full sentences. Speech normal rate and volume; coherent, logical thought form. Affect anxious and congruent. No obvious tremor at rest or intoxication."
      }
    },
