        "code": {
          "text": "Fatigue and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased fatigue for 3–4 weeks, heavy limbs, and needs daytime naps; still working full time. Sleeps approximately 7 hours. Partner reports no snoring or apnoea. Denies low mood and anhedonia. Appetite is okay. Possible 1–2 kg weight loss over 2 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
