    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash history and pruritus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash began approximately 5/7 ago on bilateral flexor forearms, anterior neck, and a few areas of upper chest. Gradual increase in itch, especially at night and at work; itch severity 6–7/10 and wakes patient from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral flexor forearms with multiple 1–3 cm poorly demarcated erythematous, slightly raised dry patches/thin plaques, excoriated from scratching. Scattered small erythematous papules/patches of similar appearance on anterior neck and upper chest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated skin findings and rash red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blisters, weeping, oral lesions, target lesions, mucosal involvement, palmar or plantar lesions, generalized urticaria, warmth, or features of secondary bacterial infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated systemic and allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, URTI symptoms, shortness of breath, wheeze, facial or tongue swelling, dysphagia, joint pain, and gastrointestinal symptoms. No facial, lip, or tongue oedema on examination; oropharynx clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear bilaterally; no wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing and mildly anxious; cooperative, normal speech rate and volume, mildly anxious and reactive affect, coherent thought process, appropriate thought content, no psychosis, and no suicidal ideation expressed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Stress, anxiety, sleep, and mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports major work stress and conflict with manager over the last 2–3/12, feeling constantly on edge and unable to switch off. Sleep-onset insomnia with work rumination. Appetite okay. No current panic attacks; often jittery with palpitations when stressed. Describes feeling stressed and a bit overwhelmed; denies persistent low mood, anhedonia, hopelessness, and suicidal ideation. Still functioning at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
