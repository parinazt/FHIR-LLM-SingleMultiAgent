        "code": {
          "text": "HEENT and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No meningism; full neck range of motion; sinuses non-tender; tympanic membranes and nose normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
