      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported left-sided weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports left arm not working right, with left arm and left leg weakness. He reports dropping objects and reduced grip in the left hand, and that he cannot lift the left arm above shoulder level. Reports the left leg is wobbly and he holds furniture. Onset unclear: initially said he woke with symptoms this morning, then said it might have been a few days ago, perhaps last week; unable to give a clear last-seen-well time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
