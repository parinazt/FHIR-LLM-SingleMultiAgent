        "code": {
          "text": "Right wrist and hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild swelling from the radial styloid to the base of the thumb, without erythema. Local tenderness over the first dorsal compartment with palpable nodularity along the tendon sheath. Fine crepitus with active thumb movement at the wrist."
      }
    },
