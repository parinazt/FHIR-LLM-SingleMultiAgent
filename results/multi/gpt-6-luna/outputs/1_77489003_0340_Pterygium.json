    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A little growth on the nasal side of the right eye, first noticed a couple of years ago and slowly increasing. More noticeable over the last 6–9 months, with intermittent irritation and scratchiness, especially at the end of a work day and on windy days; mild redness and dryness. Over-the-counter lubricating drops help a little."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient says vision is okay for phone use and driving, but the right eye may be a touch blurrier when tired. Denies diplopia, photophobia, and severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other reported right eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies purulent discharge, trauma, and acute onset."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal fleshy triangular fibrovascular tissue extending from bulbar conjunctiva onto the cornea, approximately 1.5–2 mm from the limbus towards the pupil; not on the visual axis. Mild injection; no ulcer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nasal conjunctival thickening with no corneal involvement; possibly pinguecula versus very early pterygium."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Other eye examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Corneas clear; no foreign body, ciliary flush, or photophobia. PERRL and EOMI. Fundus examination limited by room light; discs appear sharp with no gross haemorrhage."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, palpitations, syncope, weight loss, fevers, and night sweats. Reports sleep is okay and mood is stable."
      }
    },
