    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported intermittent itchy rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent itchy rash on forearms and anterior neck for approximately 2 months; comes and goes, with approximately 4–5 episodes in the past 2 weeks. Flares a few hours after certain meals; patient reports it seems to worsen on nights after pasta or takeaway."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint erythematous macular rash on the left forearm flexor surface; non-vesicular, non-purpuric, and not warm. No angioedema or mucosal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Hand sanitiser sensitivity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "School hand sanitiser stings when the rash is already present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Symptoms of systemic allergic reaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies facial swelling, shortness of breath, wheeze, or throat tightness. No previous anaphylaxis reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding bloating, crampy lower abdominal pain, and variable stool. Patient notes a clearer association with wheat (pasta/bread), onion/garlic, and some fruit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported cognitive and fatigue symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling foggy and wiped out on bad gastrointestinal symptom days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No weight loss, rectal bleeding, nocturnal diarrhoea, or fevers reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Response to dietary modifications"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "After keeping a rough food/symptom diary and reducing pasta, apples, onion, and garlic for 3 weeks, patient reports approximately 30–40% improvement in bloating and fewer rash days."
      }
    },
