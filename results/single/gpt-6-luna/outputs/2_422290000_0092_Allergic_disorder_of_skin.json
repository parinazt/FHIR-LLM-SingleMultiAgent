            }
          ]
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Chronic atopic and irritant dermatitis with pityriasis alba"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bad headache for 3 days in the forehead and both temples. Gradual onset, not thunderclap; constant dull pressure-like ache, sometimes throbbing later in the day, especially after work with noisy children or screens. Wakes with no headache or a mild headache that builds over the day. Severity up to 6/10, currently 3/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea, vomiting, visual changes, aura, weakness, speech or swallowing difficulty, dizziness, fever, or neck stiffness. Not pregnant. No recent head injury. No story of worst headache in her life."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported possible headache contributors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wonders whether excessive phone use/looking or facial cream may be related. Daughter reports patient comes home exhausted from work, does not drink much water, and goes straight to bed with the lights off."
      }
    },
    {
