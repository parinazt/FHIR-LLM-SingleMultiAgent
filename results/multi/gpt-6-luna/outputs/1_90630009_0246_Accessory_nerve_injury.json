    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports severe 'shocking' pain and a deep ache with sharp stabs if moving the wrong way. Mainly over the top of the left shoulder to the mid upper arm, not past the elbow. Severity approximately 7–8/10 at night and 5/10 during the day; wakes him from sleep. Worse lying on the left side, with abduction, overhead work, and lifting tools. Heat pack helps a little; paracetamol does nothing. Onset unclear: reports 1–2 weeks, then says it has been at least a month; timeline is unreliable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left upper outer shoulder numbness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a numb 'dead patch' over the left upper outer shoulder, starting a few days after the pain began."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left arm weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports subjective weakness and difficulty lifting a ladder, compensating with the right side."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated pain and neurologic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies neck pain, shooting pain down the arm, tingling in the fingers, hand weakness, and neck stiffness. No trauma recalled."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Red flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, jaw pain, diaphoresis, fever, weight loss, night sweats, recent neck injury, limb heaviness or clumsiness, gait change, and sphincter disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Telehealth observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice comfortable at rest, with occasional pauses and winces when describing movement. Speech and cognition okay, but vague about dates and contradictory about symptom duration. No audible shortness of breath or cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
