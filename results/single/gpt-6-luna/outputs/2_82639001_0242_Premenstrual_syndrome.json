    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Recent febrile illness symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6 days ago, sudden subjective fevers with sweats, myalgias, mild headache, nasal symptoms, scratchy throat for 2–3 days, and mild dry cough. Fever began just before menses and settled by the second day of bleeding. Fever is now resolved. No thermometer was used."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Current recovery status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels mostly back to normal, with a little tiredness; nasal congestion is the only remaining upper respiratory symptom."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Other symptoms denied during recent illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No urinary symptoms, gastrointestinal symptoms, rash, or rigors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Breathlessness during recent illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath beyond the patient's usual mild asthma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Premenstrual symptoms and cycle pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 7–10 days before menses, increased irritability, tearfulness, feeling unable to cope at school, breast tenderness, bloating, and more migraines; improves by day 1–2 of bleeding. Cycles are regular at 28–30 days. Symptoms have significant functional impact. Mood is okay between cycles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
