        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "1 g by mouth every 6 hours as needed; maximum 4 g per day.",
            "route": {
              "text": "by mouth"
            },
            "asNeededBoolean": true,
            "timing": {
