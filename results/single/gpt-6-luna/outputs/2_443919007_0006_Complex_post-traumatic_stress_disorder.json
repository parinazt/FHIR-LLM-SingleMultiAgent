    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Irritability and anger outbursts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports ongoing increased irritability at home and work, including blowing up at her partner and raising her voice and throwing things at customers twice in the last month. No physical violence. Says she has been 'snappy' and feels 'pissed off all the time'. Symptoms have increased over the last 3–4 months and affect work and home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep disturbance and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleeping 4–5 hours per night with multiple wakings and recurrent nightmares about past trauma. Wakes sweaty with a racing heart."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Trauma-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased startle, hypervigilance, avoidance of crowds, intrusive memories, and emotional numbing, ongoing as per previous consultations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports reduced concentration at work, drifting off and becoming stuck in thoughts. Examination noted some difficulty maintaining focus on longer questions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking 3–4 premix cans most nights and up to approximately 8 on weekends. Reports no morning drinking and no history of withdrawal. Minimises concerns, saying that everyone she knows drinks and that it helps her sleep. Partner is concerned."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cannabis use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports smoking a couple of cones before bed most nights. Says cannabis helps her sleep and minimises concerns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Patient attribution of irritability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks irritability may be related to energy drinks, lights, and music in the shop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies wanting to hurt herself and reports no plan or intent, but describes some thoughts of 'wanting to disappear'. Identifies her partner, siblings, and job as protective factors. No previous suicide attempts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Thoughts of harming others"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies thoughts of harming others but fears 'losing it'; reports verbal outbursts only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and guarded; engages with encouragement and is occasionally tearful when discussing nightmares. Verbal minimisation, with affect appearing more distressed than her words."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Mental status examination: appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appropriate appearance and good hygiene. Tense and fidgety, scanning the room and reluctant to elaborate unless prompted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Mental status examination: speech and affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech normal in rate and volume, becoming louder when describing conflict. Affect irritable and mildly anxious, congruent and reactive."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Mental status examination: thought and perception"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thought form linear and goal directed. Intrusive trauma memories noted; no delusions or hallucinations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Mental status examination: cognition, insight, and judgement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cognition grossly intact, with some difficulty maintaining focus on longer questions. Partial insight: recognises 'something not right' but attributes it mainly to the work environment. Judgement intact regarding safety; acknowledges alcohol and cannabis are not ideal but says she does not know what else to do."
      }
    },
