      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Suspected internal haemorrhoids with prolapse and intermittent bright red rectal bleeding, likely grade II–III"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Constipation and straining, attributed to low fibre, reduced fluid intake, and prolonged toileting"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Prolapsing tissue with bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports lumps coming out of the anus when defecating, present for several months with vague and changing timing. Tissue prolapses with bowel movements and straining; patient manually reduces it in the shower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bright red blood on toilet paper and sometimes in the toilet bowl; not mixed with stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Perianal discomfort and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild to moderate discomfort and perianal itch, worse after multiple wipes or prolonged sitting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually has a bowel movement daily, but sometimes is constipated and on other days has two bowel movements. Reports straining considerably; stool is often hard at first and then softer. Often sits on the toilet for more than 10 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal symptoms and bleeding features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies constant severe anal pain, a tense tender lump at the anal margin, melaena, and clots. Initially said there might be slimy material in stool, then denied mucus. Denies abdominal pain, nocturnal diarrhoea, weight loss, and fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other targeted review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, dizziness, palpitations, urinary symptoms, perianal discharge, and pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Physical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Telehealth consultation only; no physical examination was possible. Haemorrhoids could not be graded and other anorectal or colorectal pathology could not be excluded without an in-person perineal examination and digital rectal examination, with or without anoscopy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Heartburn"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reports recurrent heartburn."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "OTC heartburn tablet; exact name unknown, possibly a PPI or antacid"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Taken as needed; dose and route not stated",
            "asNeededBoolean": true
          }
        ]
      }
    }
  ]
