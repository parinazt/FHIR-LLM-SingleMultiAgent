    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder pain, reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Shoulder has been 'a bit sore for a while now' for approximately 3 months, gradual onset with no clear injury. Dull anterolateral ache with a sharp twinge on some movements. Wakes if she rolls onto the left side; difficulty hanging washing, reaching overhead, and fastening her bra behind her back. No neck pain, radiation past the elbow, pins and needles, or true weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over the greater tuberosity/subacromial area; ACJ non-tender. Active flexion approximately 120° and painful; abduction approximately 100–110° with painful arc approximately 70–120°. Internal rotation limited (cannot reach bra strap); external rotation approximately 45° with mild pain. Passive range of motion near full with end-range pain. Jobe/empty can causes pain with mild weakness compared with right; pain on resisted external rotation. Hawkins and Neer impingement tests positive."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion; no radicular signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Urethral opening lesion, reported history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a 'little red lump' at the urine opening for approximately 6–8 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Urinary symptoms, reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent stinging at the end of urination. Reports two tiny spots of blood on paper last month, with none since. Denies dysuria, frequency, urgency, visible haematuria in the bowl, vaginal bleeding, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "External genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atrophic vulval skin. Small, approximately 5–6 mm, soft red polypoid lesion at the posterior lip of the urethral meatus; mildly tender to palpation, not friable, with no active bleeding or pus. No obvious prolapse."
      }
    },
