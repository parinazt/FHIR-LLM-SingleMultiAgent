    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bilateral ocular discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral ocular discomfort for approximately 2–3 weeks; onset is unclear, described as possibly last week or longer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Character and pattern of eye discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Described as gritty, scratchy and somewhat burning; worse later in the day, especially after prolonged computer use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported eye redness and lash crusting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent mild redness of lid margins and bulbar conjunctiva; some lash crusting on waking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported vision"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vision is mostly fine; occasional transient blur clears with blinking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated eye symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant mucopurulent discharge, diplopia, marked photophobia, acute vision loss, severe eye pain or halos. No significant photophobia, diplopia or acute unilateral symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Self-care and relevant eye exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasionally rinses eyes in the shower and uses OTC lubricating drops of unknown name with partial relief. Does not use contact lenses. Wears eye makeup most workdays and sometimes does not remove it overnight. Reports increased screen time due to workload and wonders whether workplace air conditioning or hand sanitiser transferred to the eyes contributes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Relevant history and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent upper respiratory infection or systemic illness reported. No known autoimmune or significant dermatologic diagnosis. Reports facial flushing with wine but denies known rosacea. Reports skin is sometimes a bit dry, without significant scalp or facial flaking. Denies headache or focal neurologic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reported feeling a bit more tired lately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Video examination was limited. Mild bilateral lid-margin erythema, especially upper lids. Sclerae appeared mildly injected, although the image was intermittently pixelated. No obvious lid swelling or chalazion; crusting was not visible during the examination. Extraocular movements grossly full."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Facial appearance on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild diffuse cheek flushing; no clear papules or pustules seen at the available video resolution."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Partner's observation of eye redness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner briefly agreed that the eyes look a bit red by the end of the day."
      }
    },
