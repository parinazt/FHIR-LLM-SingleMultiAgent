    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Central facial erythema"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Redness of the central cheeks and nose for approximately 12–18 months, worse over the last 6 months; exam showed fixed central erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Facial flushing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent episodes of bright-red flushing triggered by heat, hot drinks, a glass of wine, and work stress; episodes last approximately 30–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Facial burning and stinging"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports burning and stinging, especially after showering and in the air-conditioned office."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Facial examination: telangiectasia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fine telangiectasia on the central cheeks and nose."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Facial papules, pustules, comedones, and scale"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pimples; exam showed no papules, pustules, comedones, or scale."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Possible contributors to facial redness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wonders whether a new natural essential oil moisturiser or too much instant coffee at work may be contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Ocular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild gritty eyes in the evenings for several months. Denies photophobia, blurred vision, and discharge; does not wear contact lenses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral conjunctival injection; visual acuity grossly okay on phone assessment; PERRLA; no obvious lid disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits; no specific values documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Metronidazole 0.75% gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Apply to central face twice daily; uses most days and misses some evening doses.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ],
        "note": [
          {
            "text": "Patient reports it takes the edge off."
          }
        ]
      }
    },
