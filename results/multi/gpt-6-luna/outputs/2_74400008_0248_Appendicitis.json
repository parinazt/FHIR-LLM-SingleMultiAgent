    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "36–48 hours of pain, initially vague and periumbilical, now localised to the RIF/RLQ. Constant ache with sharp twinges on movement or coughing. 7/10 with movement today and approximately 4/10 yesterday. Worse with walking, coughing and speed bumps. Paracetamol 1 g last night provided only mild relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea since yesterday morning; no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked anorexia; patient said she could not look at food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
