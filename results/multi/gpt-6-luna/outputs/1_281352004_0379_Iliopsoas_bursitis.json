    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right groin and anterior hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports aching right groin/anterior hip pain with intermittent sharp twinges. Onset is vague, possibly a few weeks to a couple of months. Baseline severity about 5/10, rising to 7/10 with movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Pain aggravating factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is worse with hip flexion, including lifting the leg into a car, stairs, sit-to-stand, and putting on socks; also worse at the end of the day after standing or bending over low desks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Pain radiation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain occasionally radiates into the anterior right thigh, not below the knee."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Pain relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rest, some stretching, and a heat pack help. Patient is unsure which tablets she has taken, possibly Panadol or the red Nurofen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Functional impact of hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working but avoiding playground duty; finds sitting on the floor with children harder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, night sweats, and weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Trauma history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent trauma recalled."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bowel, bladder, and saddle symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies bowel or bladder change and saddle anaesthesia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports only a mild occasional low back ache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Relevant medical history symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies history of malignancy, tuberculosis, or intravenous drug use. Denies abdominal, urinary, or gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-looking and in no apparent distress at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild antalgic gait favouring the right, especially for the first few steps. Gait is guarded on the right but stable; no foot drop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Lumbar spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lumbar spine non-tender with full range of motion; mild discomfort at extremes. Straight leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Right hip inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No erythema, swelling, or deformity. Marked deep tenderness in the femoral triangle/iliopsoas region just distal to the inguinal ligament. No greater trochanter or lateral hip tenderness; no inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Right hip range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flexion limited by pain to approximately 90–100 degrees, with pain on active and passive movement. Internal rotation mildly limited with discomfort. External rotation and extension near full, with mild pain at extremes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Right hip provocative examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Resisted hip flexion is painful; psoas sign positive. FABER causes mild groin pain without sacroiliac joint pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Left hip examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 throughout. Patellar and ankle reflexes present and symmetrical. Light-touch and pinprick sensation intact, including anterior thigh and medial leg."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-25",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses or organomegaly; no flank tenderness."
      }
    },
    {
