    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Cough and associated respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cough for approximately 4 months, still present but reduced since starting TB tablets; currently productive of yellow sputum. No haemoptysis. No significant shortness of breath at rest; gets puffed when running for the bus. No pleuritic chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Before diagnosis, had fevers, night sweats, and weight loss (reported needing another belt notch). Today reports no fever, though felt hot 2 nights ago. Reports tiredness and slightly improved appetite."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Medication-related symptoms and other reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea if TB tablets are taken on an empty stomach. No vomiting, abdominal pain, dark urine, jaundice, visual change, or paraesthesia. No headache, confusion, neck stiffness, urinary symptoms, joint pain, or back pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin but not wasted; looks tired and in no acute distress, speaking in full sentences. Mild right upper lobe crackles and bronchial breath sounds; remainder of chest clear. No increased work of breathing."
      }
    },
