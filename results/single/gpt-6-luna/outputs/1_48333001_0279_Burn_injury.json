        },
        "valueString": "No axillary or epitrochlear nodes noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Concern about infection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is anxious about infection and requests prophylactic antibiotics."
      }
    },
    {
