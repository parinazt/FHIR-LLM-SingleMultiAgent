        },
        "valueString": "Denies pins and needles, weakness, and pain in other joints."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Longstanding musculoskeletal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mechanical aches in feet and knees after shifts, worse with activity and better with rest. Brief stiffness in feet and knees for a few minutes after sitting; no prolonged morning stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Systemic and other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, chills, rigors, weight loss, night sweats, eye symptoms, jaw pain, headache, visual change, bowel change, and urinary change. Reports feeling otherwise well with appetite okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
