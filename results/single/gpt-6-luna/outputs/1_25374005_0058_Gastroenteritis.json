        "code": {
          "text": "Relevant exposure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent antibiotics, travel, or camping. Several staff at the patient's surgical ward have been ill with gastrointestinal symptoms."
