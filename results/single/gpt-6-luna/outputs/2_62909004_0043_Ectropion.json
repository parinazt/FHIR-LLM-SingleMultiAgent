        "code": {
          "text": "Associated eye symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant pain, photophobia, decreased visual acuity, diplopia, flashes, floaters, or curtain. No trauma, foreign body, or contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left lower lid and conjunctival examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Obvious left lower lid ectropion; punctum not apposed. Mild inferior left conjunctival injection and clear tearing. Mild erythema/dermatitis of the left lower lid from wiping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Eye examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No periorbital swelling, lacrimal sac tenderness, or warmth. Cornea clear on torch examination, with no obvious ulcer or abrasion. PERRL; no RAPD. EOM full and non-painful. Right eye with mild age-related changes only."
      }
    },
