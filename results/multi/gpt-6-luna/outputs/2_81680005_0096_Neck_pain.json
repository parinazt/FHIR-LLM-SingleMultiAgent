        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Mechanical neck pain, postural/muscular, acute on chronic"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy red papular rash for 4 days on the anterior neck and upper chest, with a few spots on the upper back/bra line."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Possible rash triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible trigger: new washing powder and/or new synthetic work blouse. Patient reports the rash started the day she wore the new top, which felt a bit scratchy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated rash symptoms and findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, shortness of breath, facial or tongue swelling, or blisters."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous papules/plaques on the anterior neck and upper chest, with a few on the upper back. No vesicles, weeping, infection, or mucosal/facial involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral lower cervical spine/upper trapezius area ache and stiffness, described as a “knot” feeling. Present for approximately 3 months, worse over the last 2–3 weeks; rated 4–6/10 and worse at the end of the workday."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Neck pain context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Desk job with long hours at a computer; leans forward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated neck pain symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No arm pain, paraesthesia, weakness, headache, trauma, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
