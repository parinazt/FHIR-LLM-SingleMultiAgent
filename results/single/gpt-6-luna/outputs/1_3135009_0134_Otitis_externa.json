    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms for about 10 days, initially itch and mild discomfort; over the last 4–5 days pain increased to a constant dull ache with sharp twinges on pinna movement or chewing. Reports blocked sensation and reduced hearing on the right, with scant clear-to-yellow discharge noticed on pillow, especially in the morning. Sleep disturbed by pain for the past two nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, headache, tinnitus, vertigo, facial weakness, severe deep nocturnal skull pain, recent URTI, significant nasal obstruction, sore throat, other cranial nerve symptoms, weight loss, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported right ear exposures and self-management"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms began after several hot days working on site and sweating under ear muffs. Recently swam in a local lake; water quality uncertain. Has used new, cheaper over-ear hearing protection for the last few weeks; possible irritant effect uncertain. Used cotton buds to clean the ear, now stopped. Took leftover oral amoxicillin for 2 days without benefit."
      }
    },
