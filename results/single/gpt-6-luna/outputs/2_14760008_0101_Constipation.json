        "code": {
          "text": "Gastrointestinal alarm symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No per-rectal bleeding, melaena, mucus, or change in stool calibre reported. No red-flag gastrointestinal symptoms reported."
