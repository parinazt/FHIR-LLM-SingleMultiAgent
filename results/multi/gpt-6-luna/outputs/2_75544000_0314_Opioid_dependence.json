    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep worsening for approximately 3–4 weeks. Difficulty initiating and maintaining sleep; goes to bed 23:00–00:00 and is often awake until 02:00–03:00; wakes 3–4 times; estimates 3–4 hours of broken sleep per night, non-restorative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Daytime effects of poor sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased irritability and daytime fatigue; worried about work safety."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Bedtime anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased anxiety at bedtime and that his 'brain not switching off'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic lower back and right shoulder pain, 4–5/10 at baseline; flares to 7/10 after big days and sometimes wakes him. Pain increased mildly with overtime."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep-related habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses phone in bed; wife watches TV in the bedroom; occasionally naps for 20–30 minutes after work. Increased caffeine, including strong cold brew in the afternoon and occasional energy drink around 15:00–17:00."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep-related breathing and movement symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports snoring 'a bit'; no witnessed apnoea, restless legs symptoms, or parasomnias."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Opioid cravings and use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current cravings and no illicit opioid use reported. No recent missed Suboxone doses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Other substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No benzodiazepine use reported. Alcohol 1–2 standard drinks per week. Rare cannabis use; currently avoiding cannabis."
      }
    },
    {
