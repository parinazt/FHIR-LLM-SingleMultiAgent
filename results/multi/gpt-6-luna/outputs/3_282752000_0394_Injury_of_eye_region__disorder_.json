    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Emergency department and ophthalmology findings on day of injury"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slit lamp: small metallic foreign body removed from the superficial left cornea, with a small residual epithelial defect. Seidel negative. Anterior chamber deep and quiet; pupil round and reactive; no hypopyon. No intraocular foreign body on emergency department ocular ultrasound. Emergency department letter documented no penetrating injury."
      }
