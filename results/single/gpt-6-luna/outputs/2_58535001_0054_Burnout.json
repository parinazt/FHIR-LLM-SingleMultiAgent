      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually 1–2 standard glasses of wine on most days off; sometimes 3–4 after a run of shifts to 'switch off.' No morning use or blackouts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
