        "code": {
          "text": "Vulvovaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4–5 days of vulval/vaginal itch and thick “cottage cheese” discharge; mild external stinging with urination. No odour, PV bleeding, fever, abdominal pain, nausea, vomiting, true dysuria, or urinary frequency."
      }
    },
    {
