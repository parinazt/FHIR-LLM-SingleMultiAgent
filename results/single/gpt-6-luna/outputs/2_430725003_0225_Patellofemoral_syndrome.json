        "code": {
          "text": "Left anterior knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for approximately 3 months; dull ache behind and around the patella. Worse on stairs, especially going down, squatting, kneeling, and sitting cross-legged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
