    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Patient-reported rash and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful blisters began on the face and neck about 1–2 weeks ago, possibly longer, and spread widely. The patient reports multiple sore crusted areas; pain is greater than itch, with stinging on movement or touch. Reports feeling hot and shivery a few days ago, tired and flat. Reports mild discomfort opening the mouth wide; eating is okay and no difficulty swallowing fluids."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry eczematous skin, especially neck, antecubital fossae and hands. Superimposed widespread monomorphic vesicles and punched-out erosions with crusting on an erythematous base over face, neck, upper chest, upper back and proximal arms; some lesions coalesce. Very tender to light touch; patient winces."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Skin lesion findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few small perioral erosions. No classic honey-coloured crust or frank pus; some lesions have mild surrounding erythema, with possible bacterial superinfection. No vesicles on fingertips. No current genital lesions reported; genital examination not performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance and mental status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tired and mildly unwell, not toxic. Alert and orientated; answers questions, but details are variable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild oral mucosal erythema; no widespread ulceration or thrush. Patient was reluctant to open mouth wide."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
