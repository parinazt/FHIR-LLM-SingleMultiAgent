    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding localized lumbar dull ache, worse over the last 3–4 weeks, with stiffness especially on getting up. Pain is 5–6/10 most days and up to 8/10 with prolonged standing. Worse after sitting more than 30 minutes and first thing in the morning; improves somewhat with gentle movement. Paracetamol provides partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No saddle anaesthesia, urinary retention, faecal incontinence, severe night pain waking the patient, specific injury, trauma or fall. No new leg weakness. No focal vertebral point tenderness or systemic infective symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Foot numbness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild chronic numbness in the feet, unchanged from baseline for more than 6 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General weakness and tiredness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels generally weaker and more tired; described as longstanding in the context of cachexia."
      }
    },
    {
