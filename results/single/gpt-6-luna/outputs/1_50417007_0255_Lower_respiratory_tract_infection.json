        "code": {
          "text": "Recent systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Felt hot and cold during the first two days; no fever in the last 48 hours. No rigors or confusion. Appetite decreased; drinking adequately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
