    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder pain and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic gradual left lateral/anterior-lateral shoulder ache for approximately 3–4 weeks, radiating to the upper arm but not past the elbow; described as like having slept awkwardly; pain 3–5/10. Worse with overhead reaching, reaching behind the back, and lying on the left side at night; improved with rest, heat, and Panadol 1 g as needed, which takes the edge off. Activities of daily living mostly okay, avoiding overhead activities, still driving."
      }
    },
