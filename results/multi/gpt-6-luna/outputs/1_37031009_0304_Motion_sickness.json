        "id": "medication-statement-3",
        "status": "unknown",
        "medicationCodeableConcept": {
          "text": "OTC travel sickness medication (identity uncertain)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Patient recalls past use as a child; remembers a product with a boat on the box, but the medicine and effect are uncertain."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hyoscine hydrobromide 300 microgram tablets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet orally 30 minutes before travel; may repeat every 4–6 hours as needed; maximum 4 tablets in 24 hours.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 300,
                  "unit": "microgram"
