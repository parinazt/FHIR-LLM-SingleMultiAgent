        "code": {
          "text": "Historical tree nut allergy reaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tree nuts, type uncertain, caused hives and lip swelling after a mixed nut bar years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Breathlessness and perioral tingling in stressful work context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports shortness of breath and mouth tingling when very anxious during busy work shifts; cause uncertain, possibly panic versus allergy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
