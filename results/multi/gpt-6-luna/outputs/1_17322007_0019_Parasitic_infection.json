        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Headache-associated and neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea, vomiting, visual aura, focal neurological symptoms, speech change, sensory loss, fever, neck stiffness, rash, confusion, seizures, visual field loss, diplopia, jaw claudication, personality or cognitive change, thunderclap onset, and worst-ever headache. No recent head trauma."
      }
    },
    {
