    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Breast ultrasound findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ultrasound about 6 weeks ago: simple cyst in the left upper outer quadrant, anechoic with a thin wall and no solid components; no abnormal axillary nodes; right breast reported as NAD. BI-RADS 2; radiologist recommended no further imaging. No prior breast imaging for comparison."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Breast discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent ache around the left breast cyst, especially premenstrually, settling with simple analgesia and warm packs. Currently described as a mild twinge, not severe."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported breast and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nipple discharge, skin change, new lumps, weight loss, night sweats, and fevers. No current red-flag symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Telehealth general appearance and respiratory observation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, alert, and in no apparent distress. Normal colour with no obvious pallor or jaundice. Speaking in full sentences; no audible wheeze or shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Affect and speech during telehealth consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious and tearful at times when discussing cancer; speech clear and coherent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Breast examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dataAbsentReason": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/data-absent-reason",
              "code": "not-performed"
            }
          ],
          "text": "Breast examination was not possible via video."
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Health anxiety-related behaviours and impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports daily breast palpation, sometimes perceiving the area as bigger but noting it varies with her cycle and how hard she presses; spends hours online reading breast cancer content and has difficulty switching off from worry. Sleep mildly impacted by rumination. No depression features volunteered today; denies suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reports feeling generally tired and raises concern about a possible hormone imbalance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Patient understanding of breast symptom safety net"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient repeated back key warning signs, including a new lump, rapid change, skin pulling, nipple changes, severe pain, or fever, and stated understanding that these should prompt urgent review."
      }
    },
