          "text": "Loperamide"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Took twice early in the illness; helped briefly."
          }
        ],
        "note": [
          {
            "text": "Advised to avoid further loperamide for now because of persistent infective diarrhoea; patient reluctantly agreed."
          }
