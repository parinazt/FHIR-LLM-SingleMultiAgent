    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent weird sensation as if something is stuck in the throat; pain mostly settled, occasional mild scratchy feeling midline just above the sternal notch, pain 1–2/10 and worse later in the day. Swallowing is okay; food goes down fine, though it sometimes feels a bit tight. Voice is mildly hoarse some evenings after work, otherwise normal. Occasional dry throat-clearing cough, especially in the afternoon; no nocturnal cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heartburn a few nights per week, especially after spicy or fatty takeaway meals and late meals; no regurgitation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, chills, weight loss, night sweats, haemoptysis, shortness of breath, chest pain, or appetite change. No progressive dysphagia, unilateral otalgia, neck mass, stridor, drooling, or trismus. No history of choking, foreign-body ingestion, or caustic ingestion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Throat examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral mucosa moist, no ulcers or thrush. Tonsils normal, no erythema or exudate. Uvula midline. Mild posterior pharyngeal cobblestoning; no visible mass or lesion. Voice normal during consultation; no stridor."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cervical lymphadenopathy or palpable neck mass. Thyroid not enlarged, nontender, and without nodules."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Respiratory examination: clear, equal air entry, no wheeze or crackles. Cardiovascular examination: heart sounds dual, no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Neurological screening examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person, place, and time; fluent speech; face symmetrical; power 5/5 in upper and lower limbs; gait normal. No new neurological symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neatly and appropriately dressed; mood described as 'OK'; affect slightly constricted but reactive; thought logical with no psychotic features; insight good."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Mood and safety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as 'pretty stable overall, bit flat some days but coping.' No suicidal ideation, self-harm, hopelessness, or panic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Traumatic brain injury residual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Residual short-term memory issues and fatigue. No seizures and no new neurological symptoms reported."
      }
    },
    {
