      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right upper abdominal/anterior chest wall skin lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 8 x 6 cm, just inferior to the right costal margin; mild patchy erythema, slight oedema, peau d’orange, increased pigmentation, mild thickening and mild superficial tenderness to palpation. No deep induration, warmth, fluctuance or ulceration. Axillary nodes negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported right upper abdominal/chest wall symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swelling, erythema and itch described as like sunburn that will not go away, present for at least weeks and probably months. Puffiness may have increased slightly since the previous review. Occasional superficial burning pain at the end of work shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and examination negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No reported fever, chills, weight loss, night sweats, dysphagia, nausea or vomiting. No cellulitis, ulceration or systemic red flags documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
