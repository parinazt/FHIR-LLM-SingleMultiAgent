    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nasal discharge and congestion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 5–6 days: increased clear-to-yellow nasal discharge and congestion, worse on the left than the right. Worse in the morning and at school, better at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Epistaxis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3 days: small-volume, intermittent anterior bleeding, with streaks of bright red blood in mucus when blowing the nose 1–2 times daily. One brief left-sided drip daily after a hot shower, stopping in under 3 minutes with pressure. No clots, large-volume bleeding, or nocturnal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated nasal and eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sneezing, itchy eyes, and mild postnasal drip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Denied associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies facial pain, severe unilateral obstruction, toothache, fever, systemic symptoms, shortness of breath, chest pain, palpitations, and dizziness."
      }
    },
