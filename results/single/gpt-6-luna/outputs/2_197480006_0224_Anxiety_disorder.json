    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anxiety and worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports excessive worry most days, worse in the evenings and overnight, about many things, especially memory and the possibility that symptoms are due to heart disease or cancer. Reports feeling more on edge over the last few weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep and wakes 1–2 times per night with worry; settles after staff reassurance. No nightmares."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Chest tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent mild chest tightness when anxious, lasting minutes and settling with slow breathing and staff presence. No clear exertional component, radiation, diaphoresis, nausea, vomiting, or collapse. Similar pattern for years and described as unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Palpitations or fluttering"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent fluttering when anxious, lasting minutes and settling with slow breathing and staff presence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mood and enjoyment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood is 'a bit low' some days; still enjoys chats and television. No anhedonia for all activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Memory and word finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports losing words more often and worries she is going downhill quickly. Staff report no acute stepwise change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Health-related reassurance seeking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repeatedly requested nursing staff check blood pressure and pulse during the past week in case of a heart attack; repeatedly sought reassurance about needing further tests."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "RACF staff collateral"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute behavioural change, falls, recent infections, or new medicines. Eating and drinking okay. Short self-limiting anxiety episodes managed with reassurance."
      }
    },
