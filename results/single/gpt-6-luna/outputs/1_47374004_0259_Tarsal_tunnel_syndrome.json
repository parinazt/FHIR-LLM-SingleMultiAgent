    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset yesterday afternoon; central/epigastric, just above the umbilicus; crampy, described as like bad period pain; intermittent waves lasting 10–20 minutes, more noticeable after meals; woke once overnight with discomfort. Severity 6–7/10 at worst, now approximately 4/10. Worse after eating, especially a heavier meal. Some relief from sitting upright, a heat pack, and two 500 mg paracetamol tablets last night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea last night; no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Fever and rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, frequency, or haematuria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels opened this morning with normal stool. No per-rectal blood or mucus, diarrhoea, constipation, or obstipation. No bloating beyond usual post-meal bloating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Gynaecological history and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "LMP approximately two weeks ago; regular cycles. No vaginal bleeding, discharge, or pelvic pain. Denies possible pregnancy, noting her husband had a vasectomy years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported abdominal pain red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sudden-onset tearing pain, chest pain, shortness of breath, dizziness, syncope, jaundice, dark urine, or pale stool. Pain not consistently localised to the right lower or right upper quadrant; remains central/epigastric."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Self-reported temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 36.9,
          "unit": "°C"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth appearance and self-palpation findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No direct examination. Patient spoke in full sentences, sounded comfortable, and was not acutely distressed. No subjective tachycardia or presyncope on standing. Guided self-palpation: no marked focal tenderness, guarding, or rigidity described; discomfort/pressure mainly epigastric."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal pain with movement and function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to mobilise around the house and work today, though uncomfortable; ate very little at lunch. Pain increases slightly with bending but is not clearly localised to one quadrant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left ankle and foot tingling/burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing medial ankle/foot tingling and burning by the end of shifts, consistent with the previous diagnosis. Some improvement with brace and orthotics; still flares when standing at the registers too long. No new weakness or change in baseline paraesthesia pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "stopped",
        "medicationCodeableConcept": {
          "text": "Ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "400 mg as needed for ankle pain; usually 1–2 tablets about 3–4 times per week. In the last 3 days, taking 400 mg once daily due to increased standing at work."
          }
        ],
        "note": [
          {
            "text": "Agreed to cease ibuprofen and other oral NSAIDs for now."
          }
        ]
      }
    },
