      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Low sexual desire with associated distress, consistent with HSDD / female sexual interest–arousal disorder"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset of low sexual desire over approximately 12–18 months, now persistent. Reports rare sexual thoughts, often avoids initiating sex, and sometimes goes along with sex for her partner's sake. Reports distress, guilt, feeling 'a bit broken,' and some relationship strain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sexual arousal and orgasm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually able to become aroused and orgasm once engaged, though orgasm takes longer and feels less intense. No anorgasmia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Pelvic and genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dyspareunia, vaginal dryness, postcoital bleeding, pelvic pain, urinary symptoms, and abnormal vaginal discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Periods regular, every 28–32 days, with moderate flow."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and self-harm screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent low mood outside the sexual domain, general anhedonia, suicidal ideation, and thoughts of self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is somewhat fragmented, approximately 6–7 hours; reports tiredness described as normal busy-parent tiredness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menopausal and androgen-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not pregnant and not menopausal. Denies hot flushes, night sweats, vaginal dryness, hirsutism, acne, galactorrhoea, and virilisation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
