        "medicationCodeableConcept": {
          "text": "Loperamide"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Trial for loose stool/urgency. Start 30–60 minutes before times when toilet access is limited, such as commute or teaching blocks. May repeat up to four times daily; maximum 8 mg in 24 hours, aiming for formed but not hard stool. Stop if no bowel movement for more than 48 hours or significant crampy pain/bloating. Do not use if PR blood, fever, or suspected acute flare without medical review.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
