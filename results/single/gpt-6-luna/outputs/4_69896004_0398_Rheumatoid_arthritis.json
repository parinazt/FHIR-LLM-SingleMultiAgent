        },
        "valueString": "Well appearing; no pallor, jaundice or oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Musculoskeletal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hands: mild bilateral ulnar deviation at MCPs, slight fullness at MCP 2–3 and both wrists, no erythema or warmth, mild tenderness at MCP 2–3, mildly reduced but functional grip. Wrists: reduced range of motion at extremes with mild discomfort. Feet: mild MTP tenderness on squeeze, stable deformity, no obvious swelling. Knees: no effusion, full range of motion, non-tender. Gait normal; mobilises on and off couch independently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
