        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, nausea, vomiting, dizziness, PV bleeding, dysuria and pregnancy. Reports normal LMP about 10 days ago and bowels are okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
