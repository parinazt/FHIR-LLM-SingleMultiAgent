        "status": "final",
        "code": {
          "text": "Bowel movement frequency and stool characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports opening bowels maybe 1–2 times per week, with very large, hard, painful stools that sometimes block the toilet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Stool holding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For several months, patient has increasingly held on to stool because it hurts when it finally comes out and because she dislikes public toilets."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Faecal soiling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daily small-volume soiling in underwear over the last few weeks; patient reports that it just leaks out."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
