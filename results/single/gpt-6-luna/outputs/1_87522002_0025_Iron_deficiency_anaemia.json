    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right great toe pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throbbing and very tender for approximately 4 days; especially painful in closed shoes and better barefoot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Possible preceding toe trauma or footwear irritation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is unsure whether she stubbed the toe on a coffee table the previous week or whether new sandals rubbed it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right great toe examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and swelling at the lateral nail fold with local tenderness; early ingrown nail appearance. Nail plate very short with curved edges."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right great toe examination—negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fluctuance, pus, proximal paronychia, or spreading erythema onto the dorsum. Nail intact; no known foreign body or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right foot perfusion and sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Capillary refill under 2 seconds; sensation intact; dorsalis pedis and posterior tibial pulses palpable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased fatigue for 1–2 months."
      }
    },
    {
