    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent, crampy pain for 3–4 days, mainly around the umbilicus and left iliac fossa; described as like bad period pain, although her period is not due. Severity 3–5/10. No clear food trigger or radiation. Not waking her."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports bloating and lots of gurgling. Bowels usually move daily, now approximately every 2 days, with harder stool. Small bowel motion this morning. Denies blood, mucus, or melena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Nausea, vomiting, and oral intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea yesterday only; no vomiting. Drinking okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, urgency, haematuria, and flank pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Vaginal symptoms and menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies PV bleeding or discharge. LMP approximately 10 days ago; periods regular every 28–30 days and not usually heavy or painful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
