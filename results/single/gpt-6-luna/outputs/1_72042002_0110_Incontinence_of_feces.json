        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Loperamide"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 2 mg 30–60 minutes before times when toilet access is limited, such as a commute or teaching blocks. May repeat up to four times daily; maximum 8 mg in 24 hours. Aim for formed, not hard, stool. Stop if no bowel movement for more than 48 hours or significant crampy pain or bloating. Do not use if PR blood, fever, or suspected acute flare without medical review.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
