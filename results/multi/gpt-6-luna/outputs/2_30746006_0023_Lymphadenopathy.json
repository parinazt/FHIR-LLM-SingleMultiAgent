    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Cervical lymph nodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports neck lymph nodes remain palpable and may be a bit smaller over the last 1–2 weeks. On video, patient points to small, mobile 'beans' along the bilateral anterior cervical chain; size could not be reliably assessed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or night sweats; weight stable and appetite okay. Energy is 'up and down,' attributed by the patient to long days and a recent viral illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Recent upper respiratory tract infections"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports several URTIs over the last 6–8 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current sore throat, dental pain, oral ulcers, skin lesions, new lymph node areas, dysphagia, shortness of breath, or voice change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Cancer-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports being very anxious and scared that the swollen lymph nodes could be cancer, has been searching online about swollen lymph nodes and lymphoma, and asks about PET imaging."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Telehealth appearance and respiratory effort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On video, patient appears well and in no apparent distress, speaks in full sentences, and has no respiratory distress."
      }
    },
    {
