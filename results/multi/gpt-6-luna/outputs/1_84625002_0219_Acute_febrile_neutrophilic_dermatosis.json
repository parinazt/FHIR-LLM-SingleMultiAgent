    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin rash, patient-reported and visualised by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple raised, well-demarcated erythematous violaceous plaques on cheeks, neck, and dorsal forearms; some coalescing. Rash began rapidly over a few days approximately 3–4 weeks ago and is still present. Patient says the lesions look angrier in the evenings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Rash pain and tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain described as burning and tender rather than itchy; tender to touch. Slightly less tender than last week. Paracetamol provides partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Rash surface and associated skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Surface smooth. No reported discharge, vesicles, or crusts. No obvious vesicles, pustules, crusting, or ulceration on video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fatigue and rigors initially; currently feels washed out but a bit better. Appetite decreased a little but drinking okay. Reports no oral ulcers, eye pain, shortness of breath, chest pain, abdominal pain, diarrhoea, or urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Video appearance and respiratory observation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appeared tired but not acutely unwell; speaking in full sentences with no obvious shortness of breath. Pink colour and no cyanosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Facial and oral examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious facial swelling. Lips and oral mucosa appeared normal when patient opened mouth; no conjunctival injection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Skin punch biopsy, forearm, last week"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dense dermal neutrophilic infiltrate with papillary dermal oedema. No leukocytoclastic vasculitis; organisms not seen. Features reported as consistent with acute febrile neutrophilic dermatosis (Sweet syndrome) in the appropriate clinical context."
      }
    },
