    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right shoulder pain and weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports the shoulder is 'just a bit weak and a bit sore'; describes a dull ache at the lateral right shoulder and upper arm, with the arm feeling 'more weak than painful'. Pain increases with reaching overhead or out to the side, and at night, especially lying on the right side, waking her a few times per week. Reports reduced power lifting a jug and shopping, and struggles above shoulder height, using the left hand to assist. Possible overreach into a cupboard; no trauma, fall, or heavy lifting reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Effect of right shoulder symptoms on activities"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dressing, putting on a bra or jumper, washing hair, and hanging washing are slower; avoids overhead tasks but remains independent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance and right shoulder inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Older woman, stoic and under-reporting discomfort, with mild guarding of the right shoulder. Mild supraspinatus and infraspinatus bulk reduction compared with the left; no deformity or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right shoulder palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender at the greater tuberosity and anterolateral shoulder; acromioclavicular joint non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction approximately 70° and flexion approximately 90°, limited by pain and weakness. External rotation is painful. Passive range of motion is near full with mild end-range pain; no capsular pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Shoulder muscle power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right versus left: abduction 3/5 with pain; external rotation 3–4/5 with pain; internal rotation 4/5. Left shoulder power 5/5 throughout."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Shoulder special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Jobe test positive with painful weakness; resisted external rotation positive; Hawkins positive; Neer positive; lift-off mildly weak; O'Brien test equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neurological, vascular, and cervical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; pulses present, capillary refill under 2 seconds, sensation C5–T1 intact, reflexes symmetrical. Neck range of motion full; Spurling test negative; no new focal neurological deficit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Reported neurological symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "History of mild right hand clumsiness after prior stroke. Reports no new neurological symptoms; speech okay, no facial droop, and no leg weakness. No neck pain, radicular symptoms, paraesthesia, weight loss, fevers, night sweats, or cancer history."
      }
    },
