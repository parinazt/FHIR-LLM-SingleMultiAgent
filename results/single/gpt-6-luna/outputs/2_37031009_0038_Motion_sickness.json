      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Upper abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3 weeks: intermittent mild-to-moderate upper abdominal queasy/tight discomfort, mainly epigastric, with nausea and no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Motion-related symptoms and triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms are worse in a car, particularly on rough or unsealed roads, with sweating and feeling unwell after about 20 minutes; sometimes occurs on the school bus. Reading or using a phone in the car worsens symptoms. No clear food trigger. Patient describes this as different from usual vestibular migraine: more stomach turning than spinning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported associated and absent symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No GORD symptoms, change in bowel habit, PR blood, melaena, weight loss, fevers, or urinary symptoms. No new neurological symptoms or hearing loss; tinnitus is stable."
      }
    },
