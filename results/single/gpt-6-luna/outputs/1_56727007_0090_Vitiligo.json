    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported skin changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known vitiligo diagnosed about 8 years ago. Increased white patches over 6–9 months, especially over the last 3 months, involving the hands, perioral area, and a small periocular area. Patches described as completely white and well-defined. No itch or pain. Patches are more obvious with increased sun exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Psychosocial impact and safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very distressed about facial involvement, with reduced confidence and tearful at times. No suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple sharply demarcated depigmented macules and patches on the dorsum of the hands, perioral area, small eyelid patches, and older patches on the ankles and feet. Some follicular repigmentation on older ankle lesions and a few white hairs in lesions. No scale, erythema, or obvious dermatitis."
      }
    },
