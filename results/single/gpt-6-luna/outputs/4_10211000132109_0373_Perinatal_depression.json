    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Risk assessment and supports"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal ideation only, with no plan, and no access to unusual means. Intrusive thoughts about harming baby without plan or intent. Good insight, strong attachment to baby, support from partner and mother, and self-presented. Assessed as low–moderate risk today and suitable for community follow-up."
      }
    },
