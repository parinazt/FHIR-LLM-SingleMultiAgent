        "code": {
          "text": "Weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient estimates mild weight loss of 3–4 kg over approximately 3 months; not objectively recorded. Denies significant unintentional weight loss beyond this mild decrease in intake on work days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
