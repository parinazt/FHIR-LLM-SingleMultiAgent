            }
          ]
        },
        "code": {
          "text": "Anxiety related to choking and allergy concerns, with possible panic component"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent solid-food dysphagia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for approximately 6–9 months. Food feels stuck mid-chest, especially bread and meat; needs sips of water and occasionally regurgitates food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Episodes of food sticking with coughing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two episodes in the past month in which the patient stood up and coughed food back out, thought she was choking but could still breathe; no complete obstruction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Chest tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central chest tightness during food-sticking episodes; settles 10–15 minutes after food passes. Not exertional and not associated with walking uphill."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Retrosternal burning approximately 2–3 times weekly, especially after late takeaway meals; worse with coffee and spicy food, with some relief from Gaviscon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Globus sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional globus sensation, especially at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported egg and tree-nut reactions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since her teens, raw or undercooked egg has caused hives and lip swelling about 30 minutes after exposure. Tree nuts, type uncertain, caused hives and lip swelling after a mixed-nut bar years ago. She currently avoids egg and all nuts. No history of anaphylaxis requiring adrenaline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Recent possible food-associated allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three episodes in the past 6–9 months with certain meals, possibly involving almond milk while eating out: itchy throat, mild perioral tingling, patchy itchy erythematous rash on forearms about one hour later, and feeling a little wheezy with chest tightness. No stridor, collapse, or gastrointestinal symptoms; episodes resolved without medication. Trigger is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Breathlessness and mouth tingling in stressful situations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports shortness of breath and mouth tingling when very anxious during busy work shifts; possible panic versus allergy. No known asthma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Gastrointestinal red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies odynophagia, haematemesis, melaena, rectal bleeding, weight loss, vomiting, nocturnal choking or cough, and progressive voice change. Appetite is okay."
      }
    },
