        },
        "valueQuantity": {
          "value": 37.2,
          "unit": "°C"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Fever and chills"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers or chills."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hydration and urination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinking water and Hydralyte; passing urine regularly, 4–5 times per day, light yellow."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels “washed out”."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Dizziness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dizziness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Other diarrhoea-associated symptoms and risk features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies severe abdominal pain, weight loss, blood or black stool, recent hospitalisation, and immunosuppression. No travel, camping, or sick contacts. Diarrhoea began approximately 24 hours after takeaway chicken burger; completed amoxicillin/clavulanate approximately 2 weeks earlier."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain for approximately 3–4 weeks, right greater than left posterolateral neck extending into the top of the right shoulder. Dull ache, 2–3/10 at baseline and up to 6/10 with laptop work or driving. No trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neck range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Some restriction of right rotation and right lateral flexion, with mild discomfort at end range; otherwise neck range of motion is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies arm weakness, numbness or tingling, headache red flags, gait changes, and bowel or bladder issues. Moves limbs freely; no obvious neurological deficit on screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General appearance and respiratory status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks mildly tired but not toxic; speaking in full sentences, no respiratory distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mucosa, pallor and jaundice"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mucosa moist; no obvious pallor or jaundice."
      }
    },
