    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Current left eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild conjunctival injection. No lid swelling, discharge, or peri-orbital erythema. Pupils equal, round, and reactive; no RAPD. Extraocular movements intact; no diplopia or pain on movement. Fluorescein: small, linear, shallow epithelial defect at the previous foreign-body site; no dendritic pattern, white infiltrate, opacity, or ulcer crater. Seidel negative; tear film adequate. No ciliary flush; anterior chamber appears quiet on pen torch examination; no hypopyon."
      }
    },
