        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Months of tiredness, worse on work days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Trouble getting to sleep, especially after late or night shifts; wakes a few times thinking about work. Gets about 4–5 hours on work days and a bit more on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
