        "status": "final",
        "code": {
          "text": "Functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working, with reduced driving and some home visits. Sleep is poor. Some difficulty with activities of daily living, including hanging washing and carrying shopping."
      }
    },
