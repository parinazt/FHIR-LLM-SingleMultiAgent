    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Cyclical lower abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central cramps, left greater than right, radiating to the lower back and inner thighs. Begins 1–2 days before bleeding, is worst during the first 2 days, then eases. Current worst-day severity 8/10; previously approximately 5–6/10 after laparoscopy. Pain has increased again over the last 6–9 months and interferes with work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Symptoms associated with menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea and loose stools on days 1–2 of bleeding, fatigue, and occasional headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Menarche at 12. Cycle every 28–30 days; bleeding for 5–6 days. Moderate-to-heavy flow during the first 2 days, then light; uses super pads or tampons, changing every 3–4 hours. Denies flooding or large clots."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Negative associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, urinary symptoms, abnormal vaginal discharge, intermenstrual bleeding, postcoital bleeding, or postcoital pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild deep dyspareunia around menses only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood a little flat around the period only; denies persistent depression, anhedonia, or suicidal ideation. Sleep is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Work absence due to pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Missed 2–3 work days in the last 3 months due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, not in acute distress, and ambulant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild suprapubic and left lower quadrant tenderness on deep palpation. No rebound, guarding, masses, or organomegaly."
      }
    },
