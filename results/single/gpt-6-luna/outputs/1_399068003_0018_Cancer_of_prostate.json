        "code": {
          "text": "Stair-climbing and standing tolerance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty climbing two flights of stairs, especially carrying groceries, with multiple stops and significant pain. Difficulty standing to cook for more than 10–15 minutes."
      }
    },
