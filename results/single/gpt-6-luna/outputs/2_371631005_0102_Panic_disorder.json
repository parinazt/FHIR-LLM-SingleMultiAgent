    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent panic episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes continue 1–2 times per week; sudden onset, peak over a few minutes, and last about 5–10 minutes. They are shorter and less intense with breathing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
