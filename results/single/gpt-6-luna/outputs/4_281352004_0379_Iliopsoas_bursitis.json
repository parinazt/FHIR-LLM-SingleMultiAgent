          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses or organomegaly. No flank tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Red-flag and associated symptom screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, night sweats, or weight loss. No recent trauma recalled. No bowel or bladder change or saddle anaesthesia. Mild occasional low-back ache. No abdominal, urinary, or gastrointestinal symptoms. No known history of malignancy, tuberculosis, or intravenous drug use. No clinical features of sepsis currently."
      }
