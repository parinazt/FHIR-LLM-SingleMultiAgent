    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported rash and pruritus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5 days of an itchy red rash on the flexor wrists, scattered forearms, and anterior neck."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported rash-associated symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, blisters, weeping, or pus. No fevers, URTI symptoms, joint pains, or oral or eye symptoms. New strong lavender washing powder and new moisturiser; possible exposure to school cleaners."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vital signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile. No numeric values documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wrists and distal forearms: multiple ill-defined erythematous patches/thin plaques, 1–3 cm, with some excoriations; no vesicles, pustules, crusting, warmth, tenderness, or swelling. A few faint erythematous macules on the anterior neck. No mucosal, palm, sole, or genital involvement; no target lesions. No cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported menstrual symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Period pain has increased over the last few cycles. No intermenstrual bleeding, postcoital bleeding, or new symptom pattern."
      }
    },
    {
