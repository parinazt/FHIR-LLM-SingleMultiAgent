        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Persistent postmenopausal vaginal atrophy"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Throat sensation when swallowing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tightness and dryness low in the throat/upper chest when swallowing saliva and occasionally liquids; present for 3–4 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true odynophagia, no dysphagia with solids, no food sticking, and denies classic globus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Voice quality"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild hoarseness, especially after long retail shifts talking all day; voice mildly husky initially on examination, then improved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Throat and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cough, choking, aspiration, weight loss, fevers, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No typical GORD symptoms; occasional sour taste if lying down soon after dinner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Oropharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear with mild posterior pharyngeal erythema and cobblestoning; no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck and thyroid examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cervical lymphadenopathy; thyroid not enlarged, no nodules, and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Vaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent vaginal dryness and dyspareunia despite using Sylk moisturiser 2–3 times weekly and lubricant as needed; vaginal atrophy known for approximately 18 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly increased urinary frequency; no dysuria, urgency, or incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Postmenopausal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No per-vaginal bleeding."
      }
    },
