        "code": {
          "text": "Calf pain with walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tight calf pain bilaterally, right greater than left, after walking approximately 1–2 blocks on flat ground; settles within a few minutes of rest and has worsened over the last 6–12 months."
      }
    },
