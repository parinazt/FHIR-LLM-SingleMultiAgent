          "text": "Recent fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "High fevers around 39.5 for 3 days, starting 5 days ago; fever then decreased abruptly. Afebrile for more than 48 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
