          "text": "Pupils and extraocular movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal, round, and reactive; no RAPD. Extraocular movements intact; no diplopia or pain on movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left eye fluorescein examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small linear shallow epithelial defect at the previous foreign body site. No dendritic pattern, white infiltrate, opacity, or ulcer crater. Seidel negative; tear film adequate."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
