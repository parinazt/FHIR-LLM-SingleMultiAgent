        "code": {
          "text": "Symptoms since discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since discharge 4 days ago: no fever, rigors, or new rash. Mild fatigue, requiring a nap some days; occasional mild headache later in the day that settles with paracetamol; concentration feels a bit foggy with prolonged study but is improving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
