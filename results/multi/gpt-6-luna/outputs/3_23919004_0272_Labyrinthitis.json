    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vertigo and dizziness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported sudden-onset room-spinning vertigo, worse with head movement, beginning approximately 12/7 ago; now much improved compared with last week. Still has brief dizziness with quick head turns and when getting out of bed. No vertigo at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea and vomiting were associated with the acute vertigo. No further vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported no diplopia, dysarthria, limb weakness or numbness, gait collapse, or new severe headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent left tinnitus and a sensation that the left ear was a bit blocked last week, mostly settled now. Possible mild muffled left hearing during the acute episode, now described as pretty normal. No current otalgia or ear discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, and independently ambulant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ear canals clear and tympanic membranes intact bilaterally, with no erythema or effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cranial nerve examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves grossly intact; face symmetrical and tongue midline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Eye movements and nystagmus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eye movements full. No spontaneous nystagmus in primary gaze. Mild, brief, fatigable horizontal nystagmus on left gaze, with symptoms provoked by rapid head turns to the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Dix-Hallpike test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left-sided Dix-Hallpike reproduced mild, short-lived vertigo; no clear positional nystagmus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Coordination, gait, and balance examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Finger-to-nose and heel-to-shin normal. Gait normal, including tandem gait, which was slow. Romberg negative."
      }
    },
