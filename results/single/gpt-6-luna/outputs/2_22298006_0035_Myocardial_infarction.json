    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Physical examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pale, unwell, mildly sweaty, and prefers supine positioning. JVP elevated to angle of jaw at 45°. Heart sounds dual; no obvious murmur, with limited brief examination in a noisy room. Peripheries cool; capillary refill approximately 3 seconds. No oedema. Chest clear, with no crackles or wheeze. Abdomen soft and non-tender, no mass, bladder not palpable. Neurologically grossly non-focal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
