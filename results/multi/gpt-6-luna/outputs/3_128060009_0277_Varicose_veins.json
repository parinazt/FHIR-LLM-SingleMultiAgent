        "code": {
          "text": "Varicose veins"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prominent tortuous varicose veins along the great saphenous vein territory bilaterally, right greater than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left ankle examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Healed hyperpigmented scar at the medial malleolus, consistent with a previous venous ulcer; mild pitting oedema at the ankle."
      }
    },
