    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 7 days ago; dull, band-like pressure at the temples and forehead, occasionally occipital, non-pulsatile. Severity 4–6/10, worse late in the day after long hot kitchen shifts and screen use late at night. Builds over the day and settles overnight; does not wake the patient in the early morning. Relieved by paracetamol and resting in a dark room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
