        "status": "final",
        "code": {
          "text": "Stress urinary leakage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports ongoing leakage of small volumes with coughing, sneezing, lifting, and laughing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Suprapubic pressure or tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild, intermittent awareness of pressure or tenderness above the pubic bone for about one week; non-radiating with no clear trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, frank haematuria, malodour, urgency, and urge incontinence. Reports frequency about 5–6 times per day, at baseline, and longstanding nocturia 0–1 times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, flank pain, nausea, and vomiting. Reports mild afternoon headaches while avoiding fluids at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended. No tenderness, including on careful superficial and deep suprapubic palpation; patient indicated the suprapubic area, but there was no reproducible tenderness. No masses or organomegaly; bladder not palpable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
