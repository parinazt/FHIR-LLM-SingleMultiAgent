    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Jaw pain and facial swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Jaw pain with bilateral cheek swelling under the ears, starting on the left and becoming bilateral over 3–4 days. Dull ache, worse with chewing, especially sour foods. Facial swelling and jaw pain reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Subjective fevers and chills during the first 1–2 days; paracetamol helps. Decreased energy, mild headache, and decreased appetite."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dental pain, ear pain, sore throat, cough, coryza, shortness of breath, abdominal pain, dysuria, testicular pain, testicular swelling or heaviness, haematuria, flank pain, photophobia, neck stiffness, confusion, focal neurological symptoms, hearing loss, tinnitus, and vertigo."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Oral intake and functional status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eating soft foods only due to pain, with decreased oral intake. Alert, mobilising independently with gait within normal limits, and able to transfer on and off the bed unaided. Speech clear and able to speak in full sentences. Jaw range of motion preserved; discomfort at end range when chewing. Activities of daily living and self-care intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Facial and salivary gland examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral parotid swelling, left greater than right; tender and firm but not hard. Skin intact, with no erythema, obvious warmth, or fluctuance. No submandibular swelling. Stensen ducts mildly erythematous with clear saliva; no pus expressed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Oral, throat, and ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dentition OK; no obvious caries or abscess. Oropharynx clear and tonsils normal. Tympanic membranes intact and non-erythematous."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full neck range of motion; no meningism. Mildly tender, small, mobile bilateral preauricular lymph nodes; no significant cervical lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Respiratory examination: clear to auscultation bilaterally. Cardiovascular examination: heart sounds dual; perfusion good."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, non-tender, and non-distended; no organomegaly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
