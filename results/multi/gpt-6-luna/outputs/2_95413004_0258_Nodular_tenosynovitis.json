        "code": {
          "text": "Right wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain over the right radial styloid; worst 6/10, decreasing to approximately 3–4/10 while wearing the splint."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported right thumb and wrist crepitus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes grating or creaking, especially during the first few thumb movements in the morning and after prolonged typing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Activities that worsen right wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with lifting a kettle, opening jars, picking up shopping, and ulnar deviation with the thumb abducted."
      }
    },
    {
