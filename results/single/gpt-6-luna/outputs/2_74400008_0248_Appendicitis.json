        "code": {
          "text": "Effect of paracetamol on abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Paracetamol 500 mg x 2 taken last night provided only mild pain reduction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
