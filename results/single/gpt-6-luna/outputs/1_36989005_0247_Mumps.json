    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported facial symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swelling under both ears, initially left then bilateral, present for 3–4 days; dull ache, worse with chewing, especially sour foods. Subjective fevers and chills during the first 1–2 days. Reduced energy, mild headache, and reduced appetite. Chewing pain leads to preference for soft foods and reduced oral intake."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported absent symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dental pain, ear pain, sore throat, cough, coryza, shortness of breath, abdominal pain, and dysuria. Denies testicular pain, swelling, or heaviness; haematuria and flank pain; photophobia, neck stiffness, confusion, or focal neurological symptoms; hearing loss, tinnitus, or vertigo."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Immunization and travel history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vaccination history unclear; reports usual childhood vaccines overseas and is unsure whether MMR vaccination is complete. No recent overseas travel in the last 12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Facial and parotid examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral parotid swelling, left greater than right; tender and firm but not hard. Skin intact, with no erythema, obvious warmth, or fluctuance. No submandibular swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Jaw, oral cavity, and dental examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full jaw range of motion and mouth opening; no trismus, with discomfort at end range of chewing. Stensen ducts mildly erythematous with clear saliva and no pus expressed. Dentition okay; no obvious caries or abscess."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Throat, ear, and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear and tonsils normal. Tympanic membranes intact and non-erythematous. Full neck range of motion; no meningism. Mildly tender, small, mobile bilateral preauricular lymph nodes; no significant cervical lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Chest and cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear to auscultation bilaterally. Heart sounds dual; good perfusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, non-tender, and non-distended; no organomegaly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "GCS 15; grossly non-focal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Functional status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, mobilising independently with gait within normal limits, and able to transfer on and off the bed unaided. Speech clear and able to speak in full sentences. Eating soft foods only due to pain. Fatigue reduces tolerance for prolonged standing at work; activities of daily living and self-care remain intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
