      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right prepatellar swelling history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swelling for approximately 3–4 months, worse over the past 4–6 weeks; worse at the end of the workday and reduced on weekends. Works on knees all day and uses knee pads intermittently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain 4–5/10 at rest and 7/10 with kneeling or deep flexion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Systemic symptoms and fever history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, and systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right knee skin and temperature examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Skin intact; no erythema or warmth compared with the left knee. Patient reports it was a little red last week after a big workday."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Localized prepatellar swelling; mild tenderness over the bursa only; no joint effusion. Flexion limited to approximately 100 degrees by discomfort; full extension. Ligaments stable; McMurray test negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Weight bearing and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Weight bearing okay; mildly antalgic on the first steps. Stairs are possible but slow and painful on bad days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Peripheral oedema"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No peripheral oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Foot examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feet quick look: skin intact, mild callus, dorsalis pedis pulses present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Diabetes symptoms and monitoring history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies osmotic symptoms. No home blood glucose measurements; missed previous blood tests."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Work and functional limitation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain with kneeling, squatting, prolonged standing, and stairs when symptoms flare. Still able to work but limited for heavy floor tiling; may need modified duties and rest breaks. Worried about future work capacity."
      }
    },
