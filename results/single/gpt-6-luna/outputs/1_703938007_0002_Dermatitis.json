    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for 5 days; gradual onset itch of the outer left ear followed by dull ache, with occasional sharp stabbing pain when lying on the left side. Pain approximately 4/10 at baseline and up to 6/10 when lying on that side; worse at night and improved with simple analgesia. Aggravated by pinna movement, over-ear headphones, and a tight headband. Relieved by paracetamol, avoiding pressure, and moisturiser on the outer ear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left outer ear itch and skin changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch with dry, flaky, crusty skin. Patient is trying not to scratch. Possible triggers raised by patient include headband, sunscreen, a long day outside, or drying air conditioning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated ear and upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No ear discharge, hearing loss, tinnitus, vertigo, fever, or upper respiratory symptoms. No sinus pain, sore throat, dental pain, or facial weakness."
      }
    },
