      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left lower quadrant abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache for 4–5 days, rated 5–6/10; similar to the last episode but milder, and worse yesterday. No radiation. Worse with movement and when bowels are very full; some relief after a bowel movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bowel habit and stool characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alternating constipation and loose stools over the past week. Stools are sometimes a bit narrower, but this is not persistent. Passing flatus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vomiting. Mild intermittent nausea. Appetite slightly reduced, but still eating. No PR bleeding or melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Possible fever and chills"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible fevers or chills on days 1–2; no temperatures recorded. Now feels 'off' but is coping with activities of daily living."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Urinary and cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, urinary frequency, flank pain, chest pain, or shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended. Local left lower quadrant tenderness, mild to moderate. No guarding or rebound; no generalised peritonism and no palpable mass. Bowel sounds normal."
      }
    },
