        "code": {
          "text": "Anal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Constant, sudden sharp almost tearing pain at the anal margin, ongoing for 5 days after a hard stool and straining; worse when sitting and with bowel movements, approximately 7/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current rectal bleeding; brief spotting of bright red blood on toilet paper on day 1 of the current problem."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Other reported gastrointestinal and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies mucus, melaena, fever, weight loss, night sweats, appetite change, abdominal pain, and urinary symptoms. Bowel habit stable with normal frequency and form."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
