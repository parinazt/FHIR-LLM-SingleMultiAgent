    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue and subjective weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 6–8 weeks of increased fatigue, tiredness, subjective weakness and decreased energy, especially mid-afternoon; describes feeling like “wading through mud” and often nods off on the couch after work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps approximately 6 hours per night; sleep is fragmented, stays up late watching television, wakes early, and feels unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Snoring and witnessed pauses in breathing during sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports loud snoring (“snores like a truck”) and witnessed pauses in breathing during sleep; patient reports some morning headaches."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mood is a little flat and cranky, attributed to tiredness; still enjoys grandchildren and community events. Denies anhedonia and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
