    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Focal seizure-like events"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the past approximately 3 weeks, events have increased mildly; 3 events occurred last week. Described as a weird feeling with jerking of the right arm and face, lasting 30–60 seconds. The patient remains aware and can hear others, but has speech arrest or cannot talk properly. Afterwards he feels tired for a few minutes, without prolonged confusion. Mother reports the events are the same as his usual ones, just somewhat more frequent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
