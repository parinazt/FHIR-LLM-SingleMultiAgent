        "code": {
          "text": "Left shoulder pain, reported history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left lateral/posterior shoulder ache for approximately 5 days; pain 6/10 with movement and 2/10 at rest, waking him 1–2 times nightly. Worse with abduction above approximately 90 degrees, reaching behind the back, overhead work, and lying on the left side. No clear trauma; increased gardening and tightening bolts on a ute, and possibly slept awkwardly in a recliner."
      }
    },
