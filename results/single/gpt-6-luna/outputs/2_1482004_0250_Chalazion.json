        "status": "final",
        "code": {
          "text": "Right upper eyelid lump"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a focal lump at the right upper eyelid margin, about the size of a little pea, present for a week or two or possibly longer; onset is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right upper eyelid lump characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes the lump as firm but not rock hard and not very tender when pressed. It is more annoying or heavy than painful, is not really sore, and feels in the way when reading or watching television."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vision and diplopia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports vision is okay and denies double vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated eye and eyelid symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies significant eye pain, pain with eye movements, photophobia, increased discharge beyond usual morning crusting, and diffuse eyelid redness. Patient reports being able to open and close the eye fully."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies fever and feeling systemically unwell."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Eyelid lesion findings by telehealth description"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Focal right upper lid margin lesion described as non-tender, with no diffuse swelling or discharge and no spread to the cheek or forehead. No visual examination was performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
