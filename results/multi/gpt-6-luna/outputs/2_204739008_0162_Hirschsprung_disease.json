        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for approximately 2 weeks; mainly dry, with a little white sputum in the morning sometimes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Cough timing and sleep impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse at night and on waking; wakes him a few times but he goes back to sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated cough symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blood, shortness of breath, chest pain, wheeze, or current fever. Felt a bit hot during the first couple of days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Respiratory and irritant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-smoker; does not vape; no asthma history. Thinks cough may be from dust at work and reports the house is a bit musty, with an old heater that smells unpleasant. Still working, with no exertional limitation."
      }
    },
