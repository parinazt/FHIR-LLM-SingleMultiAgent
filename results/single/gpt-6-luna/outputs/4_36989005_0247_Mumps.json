        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dental pain, ear pain, sore throat, cough, coryza, shortness of breath, abdominal pain, or dysuria. No testicular pain, swelling, or heaviness; no haematuria or flank pain. No photophobia, neck stiffness, confusion, focal neurological symptoms, hearing loss, tinnitus, or vertigo."
      }
