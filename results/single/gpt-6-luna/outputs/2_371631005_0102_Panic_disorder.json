        "code": {
          "text": "Symptoms during panic episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported heart racing, sweating, mild dizziness, and shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Panic episode context and triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes often occur in the evenings when alone or while thinking about health or a news article; may feel worse after a second instant coffee. Can occur at rest, with no clear exertional link."
      }
    },
