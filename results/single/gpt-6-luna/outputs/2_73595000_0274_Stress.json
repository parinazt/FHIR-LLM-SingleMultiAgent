        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 3–4 nights per week, usually 3–4 standard drinks and sometimes 6–7 on days off; says alcohol is used “to take the edge off.” Aware this is not ideal."
      }
    },
