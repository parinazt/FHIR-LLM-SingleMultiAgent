        "code": {
          "text": "Nasal discharge and congestion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased clear-to-yellow nasal discharge and congestion, left greater than right, for 5–6 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Epistaxis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small-volume intermittent anterior bleeding for 3 days: streaks of bright red blood in mucus when blowing the nose 1–2 times daily, and one brief left-sided drip after a hot shower yesterday. Stopped in less than 3 minutes with pressure. No clots, large-volume bleeding, or nocturnal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated nasal and eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sneezing, itchy eyes, and mild postnasal drip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies facial pain, severe unilateral obstruction, toothache, fever, systemic symptoms, shortness of breath, chest pain, palpitations, and dizziness. No blood into the throat or presyncope."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
