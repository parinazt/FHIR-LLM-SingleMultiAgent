    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acute onset approximately 24 hours ago. Non-bilious, non-bloody vomiting, 5–6 episodes in the first 12 hours, now easing; last small vomit this morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose watery stools began a few hours after nausea; approximately 7–8 episodes in the last 24 hours. No blood or mucus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent crampy lower abdominal pain before bowel movements, settling after bowel movements. No constant severe pain or focal right iliac fossa pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Felt hot and cold overnight; mild headache and myalgias. No temperature documented at that time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Hydration and urine output"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Taking small sips of water and electrolyte drink; passing small volumes of pale yellow urine every 4–5 hours. Mild dry mouth. No dizziness on standing or syncope."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
