          "text": "Bleeding symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rectal bleeding, melena or haematuria; no menstrual clots. No symptoms of cytopenia reported."
      }
    },
    {
