          "text": "Worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased worry about work and the future, including concern about Huntington’s disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and self-harm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports passive thoughts: “wouldn’t matter if I didn’t wake up.” Denies active suicidal ideation, plan, or intent. No self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks tired and mildly slowed; cooperative. Speech soft. Affect constricted. Thought process linear. Hopelessness regarding Huntington’s disease; no psychotic content. No auditory or visual hallucinations. Cognition grossly okay. Insight fair."
      }
    },
