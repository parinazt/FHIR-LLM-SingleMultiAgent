    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful raised red plaques on the face, neck and forearms, appearing rapidly over a few days. Rash remains present and is slightly less tender than last week. Pain is burning and tender rather than itchy; paracetamol gives partial relief. Patient says the lesions look angrier in the evenings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially had rigors and fatigue; currently feels washed out but a bit better. Appetite is slightly decreased but drinking okay. Reports no discharge, vesicles, crusts, oral ulcers, eye pain, shortness of breath, chest pain, abdominal pain, diarrhoea or urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin findings on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple well-demarcated raised erythematous violaceous plaques on the cheeks and dorsal forearms, some coalescing; surface smooth. No obvious vesicles, pustules, crusting or ulceration. Patient reports tenderness to touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance and respiratory findings on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appears tired but not acutely unwell; speaking in full sentences. No obvious shortness of breath. Colour pink; no cyanosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Facial, oral and conjunctival findings on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious facial swelling. Lips and oral mucosa appear normal when patient opens mouth. No conjunctival injection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Skin punch biopsy findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Forearm skin punch biopsy: dense dermal neutrophilic infiltrate with papillary dermal oedema. No leukocytoclastic vasculitis. Organisms not seen. Report states features are consistent with acute febrile neutrophilic dermatosis in the appropriate clinical context."
      }
    },
