    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull anterolateral shoulder ache for about 3 months, gradual onset with no clear injury; occasional sharp twinge with some movements. Wakes when rolling onto the left side and causes difficulty hanging washing, reaching overhead, and fastening bra behind back. No neck pain, radiation past the elbow, pins and needles, or true weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over greater tuberosity/subacromial area; AC joint non-tender. Active flexion about 120 degrees and abduction about 100–110 degrees, both painful; painful arc about 70–120 degrees. Internal rotation limited (cannot reach bra strap); external rotation about 45 degrees with mild pain. Passive range of motion near full with end-range pain. Jobe/empty can causes pain and mild weakness compared with right; pain on resisted external rotation. Hawkins and Neer impingement tests positive."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion; no radicular signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urethral and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a small red lump at the urine opening for about 6–8 weeks and mild intermittent stinging at the end of urination. Reports two tiny spots of blood on paper last month, none since. No dysuria, frequency, urgency, visible haematuria in the toilet bowl, vaginal bleeding, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "External genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atrophic vulval skin. Small approximately 5–6 mm soft red polypoid lesion at the posterior lip of the urethral meatus, mildly tender, not friable, with no active bleeding or pus. Appears like a urethral caruncle. No obvious prolapse."
      }
    },
