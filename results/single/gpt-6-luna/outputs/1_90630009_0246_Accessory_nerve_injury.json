    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain location"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain mainly over the top of the left shoulder, extending to the middle of the upper arm and not past the elbow."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain quality"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Described as shocking and a deep ache, with sharp stabs if moving the wrong way."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain severity and timing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain rated about 7–8/10 at night and 5/10 during the day; wakes the patient from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pain onset and duration history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Onset unclear; initially described as 1–2 weeks, then as ages or at least a month. Timeline is unreliable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Factors aggravating left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse when lying on the left side, with abduction, overhead work, and lifting tools."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Factors relieving left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heat pack helps a little; paracetamol (Panadol) reported to do nothing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left upper outer shoulder sensory change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a numb 'dead patch' over the left upper outer shoulder, starting a few days after the pain began."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Subjective left arm weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports difficulty lifting a ladder and compensating with the right side."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated and denied neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shooting pain down the arm, tingling in the fingers, hand weakness, neck pain, and neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Trauma history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma recalled; wonders whether he slept awkwardly on a lounge or symptoms relate to a new, heavier cordless drill at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Red-flag symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, jaw pain, diaphoresis, fever, weight loss, night sweats, recent neck injury, limb heaviness or clumsiness, gait change, and sphincter disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Telehealth examination: voice and respiratory sounds"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice comfortable at rest, with occasional pauses or winces while describing movement. No audible shortness of breath or cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Telehealth communication and history reliability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech and cognition appeared okay; vague about dates and contradictory about symptom duration. History reliability limited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Chronic back ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Briefly reports chronic back ache, attributed by the patient as probably due to ute seats; deferred for separate review if ongoing."
      }
    },
