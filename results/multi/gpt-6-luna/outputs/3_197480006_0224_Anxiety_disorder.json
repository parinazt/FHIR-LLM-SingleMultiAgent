        "code": {
          "text": "Chest tightness associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clear exertional component, radiation, diaphoresis, nausea, vomiting, or collapse reported. No shortness of breath or pleuritic pain reported."
      }
    },
