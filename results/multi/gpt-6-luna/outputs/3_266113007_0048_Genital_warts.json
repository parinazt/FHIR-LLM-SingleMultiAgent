    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull band-like headache for approximately 3 weeks, frontal and temples with possible occipital involvement; usually 3–4/10, up to 6/10 on bad days. Worse later in the day after long bar shifts or screen use. Sleep helps; Panadol 500 mg, 1–2 tablets as needed, gives partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap onset or 'worst ever' headache. No vomiting; rare mild nausea. No photophobia, phonophobia, aura, visual changes, focal neurological symptoms, speech changes, confusion, fever, neck stiffness, weight loss, night sweats, sinus symptoms, or trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vulval bumps and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports vulval 'little bumps' for 2–3 months, thought possibly related to shaving. Mild itch or irritation after sex or wiping; no significant pain, bleeding, discharge, or systemic symptoms."
      }
    },
