          "text": "Associated symptoms with chest tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased dizziness, clamminess and nausea. No vomiting, marked shortness of breath, or pleuritic or positional features."
      }
    },
