        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior chamber appears deep; no obvious hypopyon on pen torch examination. Pupils equal, round, and reactive to light; no RAPD. Extraocular movements intact; no diplopia or discharge today."
      }
    },
