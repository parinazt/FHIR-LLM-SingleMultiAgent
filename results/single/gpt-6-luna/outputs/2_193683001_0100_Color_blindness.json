          "text": "Irritant contact dermatitis of the forearms, likely occupational"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Congenital red-green colour vision deficiency, stable"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported forearm rash and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash on both forearms for about 10 days; still itchy but a bit better. Worse after work and in the evenings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported rash examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patchy erythematous papular rash over the extensor surfaces of both forearms, right greater than left. Hands and palms spared."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported negative rash and systemic findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, fever, blisters or weeping reported. No obvious vesicles, crust, pus or significant swelling seen; rash appeared non-infected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported potential rash exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works outdoors, pushes sleeves up, has used a new orange heavy-duty degreaser for 2–3 weeks, and reports more sun exposure. Patient thinks the rash may be related to the degreaser or to drinking too much Red Bull; causation is uncertain. Reports the soap really stings if left on."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Rash colour reported by wife"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wife reports the rash looks a bit better and has changed from red to more brown. Patient has congenital red-green colour vision deficiency and has difficulty telling whether the rash is redder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General appearance on limited video examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, not in acute distress, and talking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Colour vision history and current symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long-standing congenital red-green colour vision deficiency; no acute change or new visual symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported tiredness and headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tiredness and headaches after long hot days; a separate appointment was suggested if ongoing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Started after a phone consultation 5 days ago; advised to continue liberally."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected areas twice daily for 5–7 days, then once daily as settling. Maximum 2 weeks without review. Avoid face, groin and broken skin.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "10 mg at night as needed for itch; patient will use only if itch is affecting sleep.",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "when": [
                  "HS"
                ]
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    }
