    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right foot and first metatarsophalangeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild soft tissue swelling and localized erythema at the right first metatarsophalangeal joint; no deformity, skin breaks, ulcers, nail change, or obvious tophi. Tender over the dorsum and medial aspect, with mild warmth compared with the left. No fluctuance or plantar tenderness. Dorsiflexion slightly reduced due to pain; otherwise range of motion preserved, with pain mainly at extremes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Right foot neurovascular examination and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sensation normal; capillary refill under 2 seconds; dorsalis pedis and posterior tibial pulses palpable. Antalgic gait favoring the right, but still weight-bearing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
