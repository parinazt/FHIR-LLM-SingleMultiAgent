        "status": "final",
        "code": {
          "text": "Hand and forearm rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic rash for over 20 years, worse over the last 3–4 months, with burning, itching, cracks, and occasional minor weeping. Patient scratches at night. Flares with dishwashing, lemon dish liquid, and strong soaps; sometimes soaks hands in hot water."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Dorsal hands and wrists examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythema, dryness, lichenification, fissures, and excoriations. No pus or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
