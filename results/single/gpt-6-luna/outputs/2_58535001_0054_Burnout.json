          "text": "Work-related stress"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive exhaustion despite 7–8 hours in bed; sleep is non-restorative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty winding down, especially after late shifts; often scrolls on phone in bed. Early waking with anticipatory anxiety on work days. Sleeps approximately 5–6 hours before shifts and somewhat more on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Work-related emotional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Emotional exhaustion, feeling 'running on empty,' and tearfulness after shifts; increased irritability with colleagues and occasionally patients; reduced sense of accomplishment and interest in nursing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Mood and enjoyment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower mood mainly in relation to work and toward the end of a run of shifts. Still able to enjoy time with partner and friends on days off; no global anhedonia reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced concentration at work; concentration is okay at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Variable appetite, reduced on work days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
