        },
        "valueString": "Approximately 24"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hand rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 6–8 weeks, increased flares of redness, dryness and fissuring over the dorsal hands and fingers, with some small vesicles after long days using bleach or dye at work. Itching and burning are worse at the end of shifts and somewhat better on days off. Fissures are painful and make shampooing and colouring difficult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Transient welts at glove edges"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports transient raised, itchy welts on the wrists and forearms shortly after wet hair or dye exposure, at the glove edges; they settle within 1–2 hours without treatment. No active wheals were present at examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Forearm redness after sun exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports increased stinging and redness on sun-exposed forearms after going out for lunch following use of certain products; possible photo component."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsal hands and fingers with erythematous, dry, lichenified plaques and fine scale, shallow fissures over the MCPs, and mild oedema. A few small clear vesicles on the lateral fingers. Palms with mild erythema and dryness. No warmth or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Wrist and forearm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint post-inflammatory erythema band at the glove line; no active wheals."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Scalp skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythematous scaly plaques on the occipital scalp, consistent with mild psoriasis; reported stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Facial, tongue, and respiratory findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial oedema, tongue swelling, or respiratory distress on examination. Patient reports no shortness of breath, wheeze, facial or tongue swelling, or generalised urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Twice daily as needed for flares; patient reports sometimes using up to 4–5 times daily for a few days when severe",
            "asNeededBoolean": true,
            "route": {
              "text": "topical"
            }
          }
        ],
        "note": [
          {
            "text": "Reported to help; patient sometimes forgets to use it until symptoms are severe."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone, over the counter; strength and formulation not stated"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used intermittently on the face for psoriasis",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene emollient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Mostly at night, when remembered",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone dipropionate 0.05% ointment (Diprosone)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to affected hand areas twice daily for 7 days, then once daily for 7 days, then stop; use on rash only",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Thereafter, for milder flares, use twice daily as needed; maximum 7–10 days per month",
            "asNeededBoolean": true,
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "May use regularly during high-exposure periods",
            "asNeededBoolean": true,
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Daily as needed for itch or urticaria."
          }
        ]
      }
    }
  ]
