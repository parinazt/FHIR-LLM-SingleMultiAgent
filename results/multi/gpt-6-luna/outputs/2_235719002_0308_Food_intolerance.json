    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Intermittent itchy rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports an ongoing intermittent itchy rash on the forearms and anterior neck for approximately 2 months. It comes and goes; in the past 2 weeks there have been approximately 4–5 episodes. Flares occur a few hours after some meals. Patient reports it seems to flare on nights after pasta or takeaway."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint erythematous macular rash on the left forearm flexor surface; non-vesicular, non-purpuric, and without warmth. No angioedema or mucosal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Possible rash irritant exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports school hand sanitiser stings when the rash is already present. Reports no new medicines or soaps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Symptoms of systemic allergic reaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no facial swelling, shortness of breath, wheeze, or throat tightness. No previous anaphylaxis reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports longstanding bloating, crampy lower abdominal pain, and variable stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Food-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a clearer association of symptoms with wheat (pasta and bread), onion/garlic, and some fruit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cognitive and energy symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling foggy and wiped out on bad gut-symptom days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Change in symptoms with dietary modification"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "After approximately 3 weeks of a food/symptom diary and reducing pasta, apples, and onion/garlic, patient reports approximately 30–40% improvement in bloating and fewer rash days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Gastrointestinal red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no weight loss, PR bleeding, nocturnal diarrhoea, or fevers."
      }
    },
