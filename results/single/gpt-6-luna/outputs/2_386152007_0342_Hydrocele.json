    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reasonably comfortable at rest, slightly guarded during lower abdominal/groin examination. Limited eye contact, slow responses; repeats “I'm alright doc”."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, mildly tender suprapubically and in the right inguinal region. No guarding or rebound, no mass, bowel sounds normal. No obvious inguinal hernia on attempted Valsalva."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Scrotal and testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left testis descended, normal size and consistency, non-tender, no mass. Right hemiscrotum enlarged and tense, not erythematous or hot, with mild diffuse tenderness especially superiorly; transilluminates, consistent with hydrocele. Right testis not clearly palpable, but no discrete hard mass felt. No scrotal skin breakdown despite pad use. No obvious inguinal hernia with cough/strain, though examination limited by cooperation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Penile examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uncircumcised; foreskin retractable, glans clean, no lesions or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
