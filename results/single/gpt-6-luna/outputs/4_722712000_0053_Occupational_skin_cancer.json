        "code": {
          "text": "Thicker lesion on right dorsal hand"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 7 mm hyperkeratotic papule, mobile, with mild scale and no clear induration or tenderness."
      }
    },
