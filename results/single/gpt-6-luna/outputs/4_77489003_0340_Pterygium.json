        "status": "final",
        "code": {
          "text": "Right eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal fleshy triangular fibrovascular tissue extending from bulbar conjunctiva onto cornea, approximately 1.5–2 mm from the limbus toward the pupil; not on the visual axis. Mild injection; no ulcer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
