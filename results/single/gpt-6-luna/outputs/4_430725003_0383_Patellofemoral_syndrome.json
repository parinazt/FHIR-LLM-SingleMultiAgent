        "status": "final",
        "code": {
          "text": "Left anterior knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 6–8 months ago, with no injury. Ache behind and around the kneecap, sometimes a sharp jab with squats. Worse on stairs, especially descending, with deep squats, and after sitting more than 30–40 minutes. Better with standing or walking on flat ground."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported knee symptoms and red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true locking, giving way, or major swelling. No fevers, weight loss, or night pain."
      }
    },
