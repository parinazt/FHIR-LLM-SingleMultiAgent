    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low mood and related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since her father's death, reports feeling very low and overwhelmed, tearfulness including bursting into tears at work, decreased motivation and concentration at work, and fatigue. Reports some enjoyment walking the dog with her niece, but says this is rare."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep since her father's death: difficulty getting to sleep, early waking at approximately 4 am, and rumination about her father."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Appetite and weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased appetite with approximately 3 kg weight loss; reports still eating daily."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Grief-related thoughts and experiences"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports intrusive images of her father in hospital, replaying their last phone call, waves of intense yearning, a hollow feeling in her chest, and some guilt about not visiting more."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Panic-like episode"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports one panic-like episode at a school assembly with palpitations and tremor; it settled after breathing outside."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Depression screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Verbal PHQ-9 described as in the moderate depression range; no numerical score documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports fleeting passive thoughts that it would be easier if she did not wake up. Denies active suicidal ideation, plan, and intent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well groomed and cooperative, maintains eye contact, appears tired and intermittently tearful, and is somewhat tense. Speech normal in volume and rate, slightly pressured when discussing work and medication. Mood described as \"really low overwhelmed\"; affect congruent, tearful, and reactive. Thought form logical and goal directed. Thought content preoccupied with her father's death and guilt; no pervasive worthlessness, delusions, or hallucinations reported. Cognition grossly intact; oriented to person, place, and time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Guilt and worthlessness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Some guilt about not visiting her father more; denies pervasive worthlessness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Psychotic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No delusions or hallucinations reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
