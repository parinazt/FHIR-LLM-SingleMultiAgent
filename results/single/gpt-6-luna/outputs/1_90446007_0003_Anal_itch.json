        "code": {
          "text": "Right knee pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic right knee pain for 2–3/7, noticed after getting up from a desk when the knee felt “funny”; mild anterior/medial ache, especially on stairs after sitting then standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right knee pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 3/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right knee function and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full weight-bearing and walking okay; still at work but avoiding the gym. No locking, giving way, catching, or true instability."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right knee trauma and inflammatory features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no trauma, twist, fall, or blow; no swelling, redness, or warmth, and knee looks the same as the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Systemic and cardiopulmonary symptoms with knee complaint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By history, no fever, night sweats, weight loss, night pain, calf pain, shortness of breath, or pleuritic chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Patient-reported right knee examination during telehealth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No video inspection was done. Patient reports knee visually normal with no deformity or obvious effusion; full flexion and extension, near-full squat with mild anterior discomfort, and hopping on the right leg causes ache only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anal itching history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pruritus ani for approximately 6–8/12, fluctuating; itch is worse in the evenings, after bowel movements, with sweating, and with stress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Perianal irritation and skin-care history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports overcleaning with soap, loofah, and fragranced wipes; scratches, especially at night, and sometimes becomes sore. Tried over-the-counter haemorrhoid cream with minimal benefit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated anal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no bleeding on paper, prolapse, mucus, significant pain, perianal discharge, blisters, or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels 1–2 times daily, formed and occasionally slightly loose when anxious; no true diarrhoea, constipation, or straining."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
