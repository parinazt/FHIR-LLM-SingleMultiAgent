    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Pruritic papular rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy papular rash on both forearms and dorsum of hands, with possibly a few spots on the lower legs, for approximately 2 weeks; worse at night. Scattered erythematous excoriated papules and some linear scratch marks. No blisters, weeping, vesicles, pustules, burrows, scale, or obvious infection. No fevers; systemically well."
      }
    },
