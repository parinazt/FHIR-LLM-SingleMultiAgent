        "status": "final",
        "code": {
          "text": "Palpitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief intermittent episodes of fluttering in the chest about once every 1–2 weeks, lasting a few minutes and self-resolving. No presyncope, syncope, or chest pain with episodes. Patient wonders whether stronger coffee may trigger them."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
