    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left scrotal discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports 3–4 days of dull ache/dragging in the left hemiscrotum, worse after standing all day at work. The swelling has been present for months and feels slightly larger and more uncomfortable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left scrotal swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swelling present for months; patient reports it feels slightly larger. Partner describes it as getting bigger and sore."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated scrotal and abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies sudden severe pain, nausea or vomiting, and abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Urinary and genital symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies dysuria, urinary frequency, haematuria, and discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies fevers, rigors, weight loss, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Scrotal symptom context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no trauma and no increase in lifting beyond usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Partner-reported behaviour and gait change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports patient has been “not himself” for 3–4 days, guards his groin, and has been “walking funny” for the last 2 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mood and irritability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling “a bit on edge and cranky,” especially in the evenings after work. Denies low mood and anxiety, and reports no new stressors. Patient thinks this is probably because the scrotum is sore and annoying."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Inguinal and femoral hernia examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable inguinal or femoral hernia on cough. Patient has not noticed an obvious groin lump into the canal or a cough impulse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum enlarged and smooth, without erythema. Fluctuant, non-tender swelling around the left testis that transilluminates strongly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Left testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left testis palpable within the swelling but difficult to delineate fully; feels normal where palpable, with no discrete lump."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Right testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right testis normal on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Other scrotal examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No epididymal tenderness, palpable varicocele, increased warmth, or inguinal lymphadenopathy. No features suggesting acute torsion today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
