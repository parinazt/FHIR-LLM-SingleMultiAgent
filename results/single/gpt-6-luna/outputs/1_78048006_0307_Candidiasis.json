        "code": {
          "text": "Reported oral lesions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "White patches on the tongue and hard palate, described as cottage-cheese-like and removable by scraping; symptoms for 5–6 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
