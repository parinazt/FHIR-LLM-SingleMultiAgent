          "text": "Reported left knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No locking, true giving way, or significant swelling reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
