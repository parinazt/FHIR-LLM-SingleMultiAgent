        "code": {
          "text": "Irritability and anger outbursts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Reports ongoing increased irritability at home and work, raising her voice and throwing things twice in the past month; no physical violence. Describes feeling \"pissed off all the time.\" Symptoms have increased over the last 3–4 months."
      }
    },
    {
