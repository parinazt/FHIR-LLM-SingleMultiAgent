    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Cough history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cough ongoing for about 2 weeks, mainly dry, with occasional small amounts of white sputum in the morning. Worse at night and on waking; wakes him a few times but he goes back to sleep. No blood."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Respiratory symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, chest pain, and wheeze. No fever now; felt a bit hot for the first couple of days and reports that this has resolved. No exertional limitation. Non-smoker, does not vape, no ACE inhibitor use, and no asthma history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Possible cough irritant exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks dust at work may contribute. Reports the house is musty and the old heater smells unpleasant. Clinician assessed occupational and environmental irritants as probably contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "General appearance and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well, talking in full sentences, with occasional dry cough. Chest clear on auscultation with good air entry and no added sounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Throat and nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throat mildly red; nasal mucosa a bit boggy. Otherwise unremarkable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Bowel pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding post-surgical constipation. Usually has one stool daily or every 2 days on Movicol 1–2 sachets. For about 2 weeks, stool every 2–3 days and harder, but still passing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bowel-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No abdominal pain. Denies abdominal distension, severe cramps, vomiting, overflow diarrhoea, and rectal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild stooly feel in the left lower quadrant only; non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Movicol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Usually 1–2 sachets; advised may increase to 2–3 sachets/day short term if more than 2 days without a bowel movement or if stool is hard, then reduce to the usual amount once back to daily soft stool."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Trial 10 mg at night for 7–10 days for possible post-nasal drip; over the counter, and patient advised he can buy it.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    }
