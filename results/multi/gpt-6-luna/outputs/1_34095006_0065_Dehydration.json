        "code": {
          "text": "Back pain associated symptoms and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no radiation to legs, numbness or tingling, weakness, saddle anaesthesia, bowel or bladder incontinence, fevers, rigors, night sweats, or recent viral symptoms."
      }
    },
