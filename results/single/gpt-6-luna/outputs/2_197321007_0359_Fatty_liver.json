        "code": {
          "text": "Right first MTP pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insidious onset 4–5 days ago; throbbing pain, worse with weight bearing and bedsheet touch; pain increased over the last 2 days and then plateaued."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right first MTP examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild swelling, erythema, warmth, marked tenderness, and reduced range of motion due to pain. No breaks, tophi, streaking, or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right foot mobility and neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to mobilise with a frame but favouring the right foot. Pulses present, capillary refill under 2 seconds, and sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Trauma and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma; afebrile and systemically well. No history of septic arthritis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other joints and general examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Other joints with no abnormal findings. No stigmata of chronic liver disease. Cardiovascular, respiratory, and abdominal examinations grossly within normal limits."
      }
