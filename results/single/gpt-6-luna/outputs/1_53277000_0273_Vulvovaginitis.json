          "text": "Vulval itching and soreness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vulval itching and soreness for approximately 1 week, worse at night and after micturition. Scratching has caused excoriation."
      }
    },
