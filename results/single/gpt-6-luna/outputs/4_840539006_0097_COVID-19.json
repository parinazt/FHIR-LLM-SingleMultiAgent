        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies confusion, syncope, seizures, focal neurological symptoms, palpitations, otalgia, dysuria and unilateral leg swelling. Mild headache with viral symptoms only; denies severe headache."
