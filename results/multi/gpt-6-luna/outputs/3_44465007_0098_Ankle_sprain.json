        "code": {
          "text": "Likely grade 1–2 left lateral ankle sprain (ATFL/CFL), day 4 post injury"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left ankle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lateral ankle pain, increased with weight-bearing, especially on stairs and at the end of the day; decreased with elevation and ice"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left ankle swelling and bruising"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports lateral malleolar swelling is still large and approximately unchanged for 2 days, with mild bruising. Examination shows localised swelling and mild ecchymosis over the ATFL/CFL area."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Weight-bearing and walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Can walk short distances but limping; gait is antalgic and without aids."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies numbness or tingling, locking or giving way, calf pain, redness or fever, and midfoot or base of fifth metatarsal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Vital observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left ankle tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tenderness over the ATFL/CFL. No bony tenderness at the posterior edge or tip of the medial or lateral malleoli, base of the fifth metatarsal, navicular, or midfoot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left ankle range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced, especially inversion and plantarflexion; painful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left ankle stability tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior drawer and talar tilt are painful, with no obvious laxity; guarding noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left lower limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; dorsalis pedis and posterior tibial pulses present, capillary refill <2 seconds, sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
