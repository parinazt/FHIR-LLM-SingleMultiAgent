        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Features of torsion, Fournier abscess, or significant prostatitis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No features consistent with torsion, Fournier abscess, or significant prostatitis at present."
      }
