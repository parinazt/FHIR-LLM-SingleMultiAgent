    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic mild anterior/medial ache; began after getting up from a desk and feeling the knee was “funny.” Pain is approximately 3/10, especially on stairs after sitting then standing. Full weight-bearing and walking are okay; avoiding the gym."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right knee associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma, twist, fall, blow, pop, swelling, redness, warmth, locking, giving way, catching, true instability, fever, night sweats, weight loss, night pain, calf pain, shortness of breath, or pleuritic chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right knee appearance and function, reported during teleconsult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the right knee looks visually normal compared with the left, with no deformity or obvious effusion. Full flexion and extension reported; can do a near-full squat with mild anterior discomfort and hop on the right leg with ache only. No video inspection was performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fluctuating pruritus ani for approximately 6–8/12, worse in the evenings, after bowel movements, with sweat and stress. Overcleaning with soap, loofah and fragranced wipes; scratches especially at night and is sometimes sore."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated anal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies bleeding on paper, prolapse, mucus, significant pain, perianal discharge, blisters or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels 1–2 times daily, formed and occasionally slightly loose when anxious. Denies true diarrhoea, constipation or straining."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Demeanour during teleconsult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious but settled; coherent and speaking in full sentences."
      }
    },
