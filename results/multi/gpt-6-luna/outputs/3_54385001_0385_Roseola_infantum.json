      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Recent fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "High fevers of approximately 39.5°C for 3 days, starting 5 days ago; fever then decreased abruptly. Afebrile for more than 48 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
