        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic venous changes with haemosiderin, mild lipodermatosclerosis, and varicosities. Dorsalis pedis and posterior tibial pulses palpable; capillary refill under 2 seconds; no rest pain."
      }
