          "text": "Right dorsal wrist lump"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing lump on the dorsum of the right wrist; fluctuates in size and increases after a big day on the computer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache with occasional sharp twinge on extension; pain up to 5/10, especially at the end of the day. No pain at rest or at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right wrist functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right wrist symptoms interfere with typing and mouse use at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right wrist associated symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no numbness, tingling, weakness, or dropping objects. Denies trauma, though later said she might have knocked the wrist at the gym."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right wrist red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies redness, warmth, fevers, weight loss, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right dorsal wrist examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1.5–2 cm soft, fluctuant, well-circumscribed swelling over the dorsal wrist at the scapholunate area. Non-erythematous and non-warm, with mild tenderness to palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right wrist range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full flexion and extension; slight pain at terminal extension and discomfort at end-range extension."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Right wrist neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; good capillary refill and radial pulse present. Sensation intact in median, ulnar, and radial distributions; normal grip."
      }
