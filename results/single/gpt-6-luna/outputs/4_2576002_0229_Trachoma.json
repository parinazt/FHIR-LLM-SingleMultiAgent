        "code": {
          "text": "Associated symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, palpitations, fevers, night sweats, gastrointestinal symptoms, or neurological symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
