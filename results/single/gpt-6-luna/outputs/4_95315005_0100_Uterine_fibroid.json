          ]
        },
        "code": {
          "text": "Symptomatic uterine fibroid with menorrhagia and dysmenorrhoea; prior diagnosis reportedly made by pelvic ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 3 weeks ago; dull ache across the lumbar area, right greater than left. Baseline pain 4–5/10, up to 7/10 after prolonged sitting or bending to pick things up. Worse at the end of the work day; improved by lying flat and heat pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation to legs, numbness, tingling, weakness, saddle anaesthesia, bladder or bowel issues, night pain waking her from sleep, trauma, falls, motor vehicle accident, fever, weight loss or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Menstrual bleeding and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressively heavier and more painful periods for approximately 12–18 months, with clots for 2–3 days each cycle. Cycles regular every 28–30 days. Bleeding is heavy but not flooding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Menstrual and pelvic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pelvic heaviness described as dragging around menses; occasional low back ache at the same time. Fatigue, especially around periods. No intermenstrual bleeding or postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Focused genitourinary and gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, abnormal vaginal discharge, haematuria, urinary frequency, flank pain, bowel changes or rectal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Focused neurological and constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg weakness, paraesthesia, gait disturbance, fever, chills or weight loss."
      }
    },
