    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Chronic pelvic pain pattern, location, and severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for more than 3 years; dull, deep pelvic ache in the suprapubic area and left greater than right lower iliac fossa. Baseline approximately 2–3/10, flaring to approximately 7/10, especially around menses and mid-cycle. Pain pattern largely similar, with increased frequency of bad days over the last 6–9 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Pelvic pain aggravating factors and episode duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse after long days standing while teaching and sometimes after intercourse. Episodes last hours to a full day; partial relief with simple analgesia and a heat pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Post-coital spotting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent small-volume post-coital spotting for 3–4 months; settles within 24 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Menstrual pattern and cramping"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Regular periods every 28–30 days; slightly more crampy than a few years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Deep ache after intercourse on approximately one-third of occasions; not severe enough to stop intercourse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no fevers, rigors, or feeling systemically unwell. Weight stable by patient report; no anorexia, night sweats, or reported weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vaginal discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No abnormal per-vaginal discharge reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, urinary frequency, or flank pain reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms in patient with IBD"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports IBD currently quiescent, with no new diarrhoea, rectal bleeding, or nocturnal symptoms beyond baseline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other reported red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute severe unilateral pain, shoulder-tip pain, nausea, vomiting, or known history of an abnormal cervical screening test reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Patient-reported impact of pelvic pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain impacts classroom work, particularly on bad days; patient reports being on her feet all day as a primary school teacher."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Telehealth visual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, alert, coherent, and in no distress. Normal colour with no obvious pallor or jaundice. Talking in full sentences with no shortness of breath. Gait briefly seen as normal. No obvious weight loss compared with prior video consultations."
      }
    },
