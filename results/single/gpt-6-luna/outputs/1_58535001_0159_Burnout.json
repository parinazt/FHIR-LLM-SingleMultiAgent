        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Trouble falling asleep, especially after late or night shifts, and wakes a few times thinking about work. Gets approximately 4–5 hours on work days; sleep is a bit better on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Work-related emotional and behavioral concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels over it, is more tearful driving home, and reports being snappy with partner and colleagues and more cynical at work. Still enjoys partner, dog, and television when not exhausted; not going out socially much. Still functioning at work but reports making more little mistakes and double-checking medications more."
      }
    },
