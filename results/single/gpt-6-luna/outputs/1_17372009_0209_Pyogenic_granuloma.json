        "code": {
          "text": "Right index finger lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsolateral aspect just distal to the PIP joint: approximately 5–6 mm red, friable dome-shaped papule on a narrow stalk with a moist surface. Mild bleeding on light contact during examination, settling with direct pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
