    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Naproxen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "500 mg once as a stat dose",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 500,
                  "unit": "mg"
                }
              }
            ]
          },
          {
            "text": "Then 250 mg twice daily with food, for up to 5 days; avoid other NSAIDs. Stop earlier if pain is much better or if any gastrointestinal symptoms occur.",
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 250,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
