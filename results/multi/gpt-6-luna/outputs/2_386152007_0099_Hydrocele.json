    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left scrotal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a dull ache/dragging sensation in the left hemiscrotum for 3–4 days, worse after standing all day. Reports swelling present for months, previously described to him as a fluid sac around the testicle, now feeling slightly larger and more uncomfortable. Denies sudden severe pain, nausea or vomiting, abdominal pain, dysuria, urinary frequency, haematuria, and discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum enlarged and smooth, without erythema. Fluctuant, non-tender swelling around the left testis that transilluminates strongly. Left testis palpable within the swelling but difficult to fully delineate; normal where felt, with no discrete lump. Right testis normal. No epididymal tenderness, varicocele felt, increased warmth, or inguinal lymphadenopathy. No features suggesting acute torsion today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Abdominal and groin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses. No palpable inguinal or femoral hernia on cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported behavioural and mood changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports patient has been “not himself” for 3–4 days and has been guarding his groin and “walking funny” for the last 2 days. Patient reports feeling “a bit on edge and cranky,” especially in the evenings after work, and thinks this is probably because the scrotum is sore and annoying. Denies low mood, anxiety, and new stressors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mental status and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, and coherent. Mood described as “a bit irritable”; affect appropriate. No psychotic features. Calm and cooperative during the consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and is talking clearly. Denies fevers, rigors, weight loss, night sweats, and trauma. Reports no increased lifting beyond usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
