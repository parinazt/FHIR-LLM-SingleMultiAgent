    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported episodes of symptoms possibly associated with hypoglycaemia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the past few weeks to possibly longer, episodes occur a few times per week, especially late morning on work days when breaks or meals are skipped. Symptoms include shakiness, sweating, palpitations, hunger, dizziness, decreased concentration and feeling 'funny in the head'. Symptoms settle after juice or lollies. Hypoglycaemia has not been confirmed by recalled glucose readings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported history and severity of episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "One episode a few months ago required lying down in the lunch room. No recent loss of consciousness, seizures or ambulance attendance. Patient does not recall severe hypoglycaemia requiring IV dextrose or glucagon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Home glucose monitoring history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Has a glucometer at home but does not check often and thinks she is out of strips. Unable to recall blood glucose values; vaguely recalls both high and low readings in the past."
      }
    },
