        "code": {
          "text": "Weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient estimates mild weight loss of 3–4 kg over 3 months; not objectively recorded."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
