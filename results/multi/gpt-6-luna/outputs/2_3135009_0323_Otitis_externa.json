      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ear pain for 3–4 days, getting worse; particularly painful with pinna movement, tragus pressure, lying on the right side, and using earbuds at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right ear blocked sensation and hearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports the right ear feels blocked with decreased hearing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right ear discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scant clear-to-slightly-yellow discharge seen on a cotton bud yesterday."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Peri-auricular itching and flaking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch and flaking behind the ears currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Constitutional and associated symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies upper respiratory symptoms, nasal congestion, tinnitus, vertigo, fever, rigors, facial weakness, severe headache, neck stiffness, trauma, and foreign body in the ear. Otherwise well; denies weight loss, night sweats, and other systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly uncomfortable; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right external ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right pinna and tragus very tender to light touch. Ear canal oedematous, erythematous, moist, with whitish-yellow debris. Tympanic membrane only partly seen; appears intact, with no bulging or obvious middle-ear effusion. No mastoid tenderness or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and scaling of the external canal and conchal bowl; canal patent and tympanic membrane intact. Mild tragal tenderness only on deep palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Peri-auricular skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild scaling and erythema in bilateral post-auricular folds. No cellulitis, perichondritis, or regional lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Cranial nerve examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves II–XII grossly intact."
      }
    },
