    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash under both breasts and in the groin folds, with a few spots under the abdominal apron, present for approximately 5 days. Itchy with slight burning, worse after work when sweaty in tight uniform, and slightly increased over the past 2 days. Patient describes red patches with tiny bumps. Denies pain, discharge, blisters, and pus. No previous recurrent fungal skin infections reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-demarcated erythema in inframammary and groin folds, with some peripheral scale and satellite papules, especially in the groin. Mild inframammary maceration. No pustules, weeping, fissures, cellulitis, or tenderness. No vesicles, urticaria, or widespread rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, malaise, and arthralgia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no right upper quadrant tenderness or organomegaly reported. Examination was limited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
