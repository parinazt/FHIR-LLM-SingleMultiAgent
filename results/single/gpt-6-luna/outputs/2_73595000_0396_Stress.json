    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Itchy rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash began about 5 days ago, gradually increasing in itch, especially at night and at work; itch rated 6–7/10 and wakes the patient from sleep. Rash affects both flexor forearms, anterior neck, and a few areas of upper chest. New 'eco' laundry detergent started about 1 week before onset. No new soaps, perfumes, or cosmetics; no recent gardening, camping, or bushwalking; no known contacts with a similar rash. Childhood eczema, mild, with none recently; no psoriasis and no previous similar adult rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Both flexor forearms have multiple 1–3 cm poorly demarcated erythematous, slightly raised dry patches/thin plaques, excoriated from scratching. Scattered small erythematous papules/patches on anterior neck and upper chest. No vesicles, crusting, weeping, warmth, target lesions, mucosal involvement, palmar or plantar lesions, generalized urticaria, or features of secondary bacterial infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives with rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blisters, weeping, oral lesions, fever, upper respiratory symptoms, shortness of breath, wheeze, facial or tongue swelling, difficulty swallowing, joint pain, or gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing; mildly anxious and frequently referring to written list."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
