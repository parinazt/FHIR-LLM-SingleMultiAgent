        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mood is okay and denies anhedonia and suicidal ideation; describes feeling mainly stressed and worried about her health."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
