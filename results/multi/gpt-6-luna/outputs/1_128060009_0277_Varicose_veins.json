    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right calf pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain over a red, tender cord in the medial right calf began 7 days ago; initially increased over 2–3 days and is now stable or slightly better, especially with elevation and PRN paracetamol. Pain is 6/10 on walking, with mild itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right calf symptom description"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes a “lumpy rope under skin.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobility decreased a little; still walking shorter distances."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right calf examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Firm, tender cord along a varicose vein in the mid-to-distal medial right calf, approximately 7–8 cm long, with an erythematous band approximately 3 cm wide and warmth. Not fluctuant; no pus; skin intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right leg examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prominent tortuous varicose veins along the great saphenous vein territory bilaterally, right greater than left. No palpable extension proximally to the knee or thigh; no groin tenderness. Right and left calf sizes approximately equal; no generalized oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left leg examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Healed hyperpigmented scar at the left medial malleolus, consistent with a previous venous ulcer; mild pitting oedema at the ankle. Chronic venous skin changes bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lower limb pulses and perfusion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsalis pedis pulses diminished bilaterally; posterior tibial pulses hard to palpate. Feet warm; capillary refill approximately 3 seconds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grossly intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
