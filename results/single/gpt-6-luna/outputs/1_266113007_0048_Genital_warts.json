        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to visible warts at night 3 times per week (for example, Monday/Wednesday/Friday); wash off 6–10 hours later. Use for up to 16 weeks or until clearance. If marked irritation occurs, reduce frequency or pause. Avoid sex while the cream is on or while very inflamed.",
            "route": {
              "text": "Topical"
