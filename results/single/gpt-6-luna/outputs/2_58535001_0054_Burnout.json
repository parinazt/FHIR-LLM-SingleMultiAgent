          "text": "Self-harm and thoughts of harming others"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies thoughts of self-harm and thoughts of harming others. No previous suicide attempts reported."
      }
    },
    {
