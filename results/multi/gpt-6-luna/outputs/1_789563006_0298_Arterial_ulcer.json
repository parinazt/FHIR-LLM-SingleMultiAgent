    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right foot ulcer"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ulcer on the right lateral forefoot near the 5th MTP, present for approximately 10–12 weeks after striking the foot on a bed frame; slowly increased in size and depth. Approximately 1.5 x 1.0 cm, extending to the dermis, with punched-out edges, pale base and yellow slough, minimal serous ooze, and surrounding pale, slightly shiny skin. No significant erythema or warmth, malodour, exposed bone or tendon, fluctuance, or tracking cellulitis. Very tender on palpation and cleaning. No other ulcers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp, significant pain, especially at night; worse when the foot is elevated or lying flat and reduced when the foot is dependent. Often dangles the leg off the bed to sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Intermittent claudication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tight pain in both calves, right greater than left, after walking approximately 1–2 blocks on flat ground; settles within a few minutes of rest and has worsened over the last 6–12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Foot temperature and colour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the right foot sometimes feels colder than the left and goes white when elevated on a recliner. On examination, the right foot was cooler and paler than the left when supine."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Foot elevation and dependent colour change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "After 1 minute with legs elevated to 30 degrees, pallor of the right forefoot and toes, followed by dependent rubor on lowering. Milder changes on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Lower limb skin"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin, shiny, hairless skin on shins and feet; thickened nails. No varicose veins or venous stasis."
      }
    },
