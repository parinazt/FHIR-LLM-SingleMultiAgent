        "code": {
          "text": "Cervical spine and upper-limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cervical spine full range of motion without reproduction of pain. Upper-limb neurovascular examination intact."
      }
    },
