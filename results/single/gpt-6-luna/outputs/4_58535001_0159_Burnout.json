        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Work-related emotional and functional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling over work, more tearful driving home, snappy with partner and colleagues, and more cynical at work. Still enjoys partner, dog, and television when not exhausted; going out socially less. Still functioning at work but reports more little mistakes and double-checking medications."
      }
    },
