    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Menstrual pelvic pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cyclical central lower abdominal cramping, greater on the left than the right, radiating to the low back and inner thighs. Begins 1–2 days before bleeding, is worst during the first 2 days, then eases. Current worst-day severity is 8/10; after laparoscopy it was about 5–6/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Symptoms associated with menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea, loose stools on days 1–2 of bleeding, fatigue, and occasional headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and red-flag negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, urinary symptoms, abnormal vaginal discharge, intermenstrual bleeding, postcoital bleeding, and postcoital pain. Reports mild deep dyspareunia around menses only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Menarche at 12 years. Cycles every 28–30 days, bleeding for 5–6 days. Flow moderate to heavy for the first 2 days then light; uses super pads or tampons, changing every 3–4 hours. Denies flooding and large clots. Dysmenorrhoea since teenage years, worsening in her early 20s."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Functional impact of menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain interferes with work; missed 2–3 work days in the last 3 months. Remains active but often needs to lie down on the evening of day 1."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild suprapubic and left lower quadrant tenderness on deep palpation. No rebound, guarding, masses, or organomegaly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no acute distress, ambulant. Pelvic examination deferred by mutual agreement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood a little flat around the period only. Denies persistent depression, anhedonia, and suicidal ideation; sleep is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Previous laboratory results, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports workplace FBC, CMP, TSH, and ferritin results from 6 months ago were normal; copy to be requested."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Cervical screening history, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cervical screening test in 2023 reported as NILM and HPV negative; patient reports next due in 2028."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "400 mg three times daily as needed for period pain; taken from onset of bleeding, not pre-emptively",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 400,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Patient reports some benefit but says the pain still leaves her unable to function for a day or two."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g every 6 hours as needed",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 6,
                "periodUnit": "h"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "The plan states a maximum of 4 g in 24 hours."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "stopped",
        "medicationCodeableConcept": {
          "text": "Levonorgestrel/ethinylestradiol combined oral contraceptive (Levlen)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Previously used for about 2 years with good pain control; stopped about 10 months ago."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Mefenamic acid"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "500 mg orally three times daily, starting 24–48 hours before expected menses; continue for the first 2–3 days of bleeding or until pain settles. Take with food. Avoid taking other NSAIDs concurrently.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 500,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Levonorgestrel/ethinylestradiol combined oral contraceptive (Levlen ED)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Restart and take active pills continuously for 3 months, then take a 4–7 day break if troublesome breakthrough bleeding occurs. Use backup contraception for the first 7 days."
          }
        ]
      }
    }
  ]
