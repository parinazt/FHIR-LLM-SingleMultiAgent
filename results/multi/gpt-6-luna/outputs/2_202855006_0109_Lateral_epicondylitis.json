        "code": {
          "text": "Right elbow provocative maneuvers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain reproduced on resisted wrist extension with elbow extended and forearm pronated; pain on resisted middle-finger extension."
