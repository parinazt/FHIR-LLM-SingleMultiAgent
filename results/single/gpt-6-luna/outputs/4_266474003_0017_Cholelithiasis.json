        "code": {
          "text": "Current symptoms and review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Asymptomatic today; specifically denies current pain, fever, rigors, shortness of breath, chest pain, or vomiting. No weight loss or night sweats."
      }
    },
    {
