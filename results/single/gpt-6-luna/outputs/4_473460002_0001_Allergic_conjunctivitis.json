          "text": "Eye discharge on examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Watery, clear discharge; no mucopurulent discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
