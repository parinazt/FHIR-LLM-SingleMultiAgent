        "dosageInstruction": [
          {
            "text": "400 mg by mouth three times daily as needed with food for up to 5 days; do not take other over-the-counter NSAIDs concurrently",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 400,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Trial NSAID if no contraindication. Discussed gastrointestinal and renal risks; advised to stop and see GP if abdominal pain, black stools, vomiting, or decreased urine output."
