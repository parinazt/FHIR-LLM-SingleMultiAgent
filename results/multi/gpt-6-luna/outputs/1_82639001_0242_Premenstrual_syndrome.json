          "text": "Asthma symptoms and reliever use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent asthma; no nocturnal symptoms. Used salbutamol as needed 2 days ago during a dust storm."
      }
    },
