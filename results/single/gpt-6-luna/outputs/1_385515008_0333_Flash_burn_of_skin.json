    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Burn distribution, appearance, and estimated extent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Forehead, nasal bridge, both malar areas, anterior neck to upper chest involved. Clear T-shirt line and safety-glasses border pattern, appearing consistent with flash burn. Forehead, nose, and neck erythematous, warm, mildly tender, with intact sensation. Bilateral upper cheeks have 2–3 cm healing superficial partial-thickness burns where blisters have ruptured; areas are pink and moist, with no slough or pus. Estimated TBSA approximately 5–6%."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck burn examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No circumferential neck burn; skin soft with no tight eschar."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Burn-related examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No charring; minimal singeing of eyebrows and sideburns. No clinical cellulitis at present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Burn pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 3,
          "unit": "/10"
        },
        "note": [
          {
            "text": "Patient described the pain as more annoying than anything."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Oral function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tightness makes opening the mouth wide uncomfortable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Transient visual symptoms after bright flash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Saw spots for a few minutes after a brief bright flash; this settled. Mild grittiness in both eyes on the first night only, now resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Current ocular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current eye pain, photophobia, blurred vision, foreign-body sensation, or reduced vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No periorbital oedema; lids open fully; no burns at lid margins. Conjunctiva mildly injected, with no chemosis. PERRLA; EOMI; visual acuity grossly normal and able to read poster. No photophobia. Patient declined fluorescein and Wood lamp examination after risks were explained."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Airway and respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No hoarseness, dysphagia, shortness of breath at the time of injury or since, cough, or soot in the mouth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "ENT and airway examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear, with no soot or marked posterior pharyngeal erythema. Voice normal; no stridor. Neck supple; trachea midline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "General and neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, well appearing, speaking full sentences, and in no acute distress. Neurologically grossly non-focal; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Cardiovascular and chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual with no added sounds. Chest clear bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, chills, nausea, or vomiting; patient otherwise feels well."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Electrical incident history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "At work, a tool slipped while isolating a switchboard, causing a brief arc/flash three days before the visit. Patient reports no direct contact with live wires, loss of consciousness, fall, head strike, or clothing ignition; felt intense heat to the face and anterior neck."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Blister history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small blisters developed on both upper cheeks on day one and ruptured spontaneously; now dry and tight."
      }
    },
    {
