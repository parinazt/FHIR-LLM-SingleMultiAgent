        "code": {
          "text": "Throat sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports that her throat feels 'weird, kind of tight' for approximately 3 days. Describes a globus-like tight sensation in the lower throat/upper chest, especially when swallowing saliva, and a need to clear her throat. Reports this feels more like globus than true dysphagia."
      }
    },
