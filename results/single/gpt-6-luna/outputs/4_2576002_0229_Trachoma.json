          "text": "Menstrual and pregnancy history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Menses regular. Reports not pregnant. LMP approximately 10 days before the encounter; uses condoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
