    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Anal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe, sudden-onset constant throbbing anal pain for 3–4 days after hard stool and straining; worse with bowel movements and sitting, described as feeling like sitting on a marble."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small amount of bright red blood on toilet paper and a few spots on stool for 2 days; blood was not mixed with stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Bowel and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of constipation and holding on at work. Denies diarrhoea, mucus, change in stool calibre, abdominal pain, weight loss, or fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vital signs and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right lateral margin has an approximately 1.5–2 cm tense bluish-purple, exquisitely tender swelling, consistent with a thrombosed external haemorrhoid. Skin intact; no ulcer, active bleeding, erythema, or fluctuance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Additional perianal and rectal examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Old small skin tag at 6 o’clock; no fissure seen. Digital rectal examination deferred because it was too tender and there was a clear external cause."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menstrual symptom and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient mentioned heavy periods and tiredness."
      }
    },
