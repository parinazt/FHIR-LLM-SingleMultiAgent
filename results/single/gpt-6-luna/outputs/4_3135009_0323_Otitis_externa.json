        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ear pain for 3–4 days, getting worse; particularly painful with movement of the pinna, pressure on the tragus, lying on the right side, and using earbuds at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ear blocked sensation and reduced hearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels blocked with decreased hearing in the right ear."
      }
    },
    {
