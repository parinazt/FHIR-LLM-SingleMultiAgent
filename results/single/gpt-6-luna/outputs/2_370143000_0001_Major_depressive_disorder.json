        "code": {
          "text": "Bilateral ankle and hand swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports gradually increasing, symmetrical pitting ankle oedema for approximately 5–6 days and mild finger puffiness in the morning for 2–3 days. Oedema is worse in the evening, especially after prolonged sitting, and improves by morning after leg elevation."
      }
    },
    {
