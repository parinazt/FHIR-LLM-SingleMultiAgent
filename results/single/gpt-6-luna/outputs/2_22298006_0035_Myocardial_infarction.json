        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea; no vomiting. No shortness of breath, cough, wheeze, orthopnoea, or leg swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "12-lead ECG"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sinus rhythm approximately 95 beats/min. ST elevation in II, III, and aVF with reciprocal ST depression in I and aVL, consistent with acute inferior STEMI. Pattern with hypotension, elevated JVP, and clear lungs raises concern for right ventricular infarction."
      }
