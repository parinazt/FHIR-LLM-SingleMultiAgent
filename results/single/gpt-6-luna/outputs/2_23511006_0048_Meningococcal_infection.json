        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Last inpatient blood tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "White blood cell count and CRP were trending down; renal function and liver function tests were normal."
      }
    },
    {
