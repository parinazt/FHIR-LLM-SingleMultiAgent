        "code": {
          "text": "Known symptomatic focal-onset epilepsy secondary to tuberous sclerosis, with focal aware motor seizures involving the right arm and face, sometimes with speech arrest; mildly increased frequency over the past 3 weeks, with pattern reported as usual by mother"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
