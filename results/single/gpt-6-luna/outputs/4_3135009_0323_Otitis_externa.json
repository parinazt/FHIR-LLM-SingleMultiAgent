    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly uncomfortable; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right pinna and tragus very tender to light touch. Canal oedematous, erythematous, moist, with whitish-yellow debris. Tympanic membrane only partly seen and appears intact; no bulging or obvious middle-ear effusion. No mastoid tenderness or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and scaling of external canal and conchal bowl; canal patent and tympanic membrane intact. Mild tragal tenderness only on deep palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Peri-auricular skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild scaling and erythema in bilateral post-auricular folds, described as consistent with a seborrhoeic/contact dermatitis mix."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Examination for complications"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cellulitis, perichondritis, or regional lymphadenopathy. Cranial nerves II–XII grossly intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Associated symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies upper respiratory infection symptoms, nasal congestion, tinnitus, vertigo, fevers, rigors, facial weakness, severe headache, neck stiffness, trauma, and foreign body in the ear. Otherwise well; no weight loss, night sweats, or other systemic symptoms."
      }
    },
    {
