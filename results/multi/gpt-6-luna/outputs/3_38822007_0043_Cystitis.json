        "code": {
          "text": "Localised irritant/contact dermatitis versus razor burn or friction dermatitis, suprapubic and upper groin"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
