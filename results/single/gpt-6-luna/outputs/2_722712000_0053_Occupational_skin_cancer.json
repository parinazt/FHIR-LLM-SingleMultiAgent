        "code": {
          "text": "Skin cancer risk assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "High future risk of non-melanoma skin cancer and melanoma; lifelong outdoor work with high ultraviolet exposure."
