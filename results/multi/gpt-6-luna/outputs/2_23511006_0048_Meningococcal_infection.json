        "status": "final",
        "code": {
          "text": "Current symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no fever, rigors, or new rash; no photophobia, neck stiffness, or vomiting; denies hearing loss, tinnitus, imbalance, focal neurological symptoms, seizures, or visual change."
      }
    },
