        "code": {
          "text": "Back and lower limb examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Localised midline and paraspinal tenderness at L3–L5 with no deformity. Lower limb power, sensation, and reflexes grossly intact; straight leg raise negative; gait slightly antalgic."
      }
    },
