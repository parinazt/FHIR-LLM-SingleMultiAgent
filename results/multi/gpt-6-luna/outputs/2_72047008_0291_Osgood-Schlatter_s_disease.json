              "code": "confirmed"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Anterior knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent anterior knee pain, right much greater than left, for approximately 12–18 months. Gradual onset around mid-Year 11 during a growth spurt; localized to the tibial tuberosities and aching. Increased with running, jumping, kneeling, and stairs; settles with rest and overnight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated knee symptoms and injury history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No single injury. No locking or giving way, no true effusion, and no redness or fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vital signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
