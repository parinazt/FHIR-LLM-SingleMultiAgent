        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Occupational standing and walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On her feet more lately, doing double shifts and assisting transfers while walking and standing for long periods on concrete floors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Longstanding mechanical aches and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mechanical aches in feet and knees after shifts, worse with activity and better with rest. Brief stiffness in feet and knees for a few minutes after sitting; no prolonged morning stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
