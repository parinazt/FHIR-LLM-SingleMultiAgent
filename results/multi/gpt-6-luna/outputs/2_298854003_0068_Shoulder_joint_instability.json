    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 6 weeks, the patient reports the left shoulder feels “loose” and “like it’s going to slip,” especially during overhead work lifting plywood sheets."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left shoulder near-subluxation episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two near-subluxation episodes reaching out to the side to grab materials; the patient had to hold the arm and slowly bring it back. No full dislocation reported during these episodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline ache 2–3/10 after long workdays, increasing to 6/10 after a near-subluxation episode; settles with rest and ibuprofen as needed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies night pain, rest pain, neck pain, hand paraesthesia, or hand weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Recent trauma and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent high-energy trauma, fever, weight loss, true locking or catching, or acute loss of range of motion reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Complete left shoulder dislocation history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No complete dislocation requiring reduction in the last 12 months; last complete dislocation was about 3 years ago during social football."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder active elevation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By patient report, able to actively elevate the left arm to above 160°; apprehension or looseness around 90–120° abduction. Functional internal and external rotation were not fully assessable by telehealth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
