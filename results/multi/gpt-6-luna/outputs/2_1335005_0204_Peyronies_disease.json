    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports gradual onset approximately 5–6 days ago, with no clear injury. Mid–lower back pain, central to slightly right-sided, dull and tight/aching, rated 4–5/10 at baseline and up to 7/10 after a big work day. Worse at the end of the day on concrete and first thing in the morning; eases somewhat after moving. Aggravated by bending, lifting ladders and tools, prolonged standing, and driving on a rough farm track. Relieved by lying flat, heat pack, and Nurofen. Patient wonders whether a new firmer mattress and increased ute driving on a rough driveway contributed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain radiation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation to the legs reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Back pain associated red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By history, no trauma or fall, saddle anaesthesia, leg weakness or numbness, bowel or bladder incontinence or retention, fevers, night sweats, unexplained weight loss, unrelenting nocturnal pain, known cancer, or systemic illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
