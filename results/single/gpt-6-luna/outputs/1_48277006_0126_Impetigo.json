    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Large blisters on the trunk and thighs popped, leaving stinging raw patches. Lesions were mildly tender and itchy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Skin symptom onset and progression"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rapid onset over 3–4 days of large thin-walled blisters on the lower abdomen, groin, and proximal thighs; blisters ruptured, leaving red raw patches."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Current skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 8–10 superficial erosions, 0.5–2 cm, on the lower abdomen and proximal thighs; erythematous, some with collarette scale and light honey-colored crust at the edges, with mild surrounding erythema. No increased warmth, induration, or fluctuance. No intact bullae currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Skin finding in phone photo from 2 days earlier"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Large flaccid clear-yellow bullae at the same sites."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
