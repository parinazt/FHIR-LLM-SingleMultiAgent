        "code": {
          "text": "Irritability and anger outbursts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing increased irritability at home and work; reports blowing up at partner and customers, raising her voice and throwing things twice in the last month. No physical violence. Describes feeling “pissed off all the time.” Symptoms have worsened over the last 3–4 months."
      }
    },
