        "code": {
          "text": "Lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset 2 days ago; central across the belt line, aching and stiff, VAS approximately 5–6/10. Worse with bending and standing from sitting; improves somewhat when lying flat."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Lower back pain associated findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation, leg symptoms, trauma, fall, or heavy lifting. No saddle anaesthesia, leg weakness, paraesthesia, gait disturbance, weight loss, night sweats, or reported history of cancer or IV drug use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
