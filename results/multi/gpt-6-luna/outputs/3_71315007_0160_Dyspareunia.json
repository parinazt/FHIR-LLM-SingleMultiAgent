    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Dyspareunia and introital pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports approximately 2 years of painful sex, with superficial burning, sharp stinging pain at the introitus during tampon use and intercourse. Sometimes has throbbing pain for hours afterward. Also reports occasional deep pelvic ache with penetration, especially in certain positions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Current associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no current abdominal pain apart from mild chronic pelvic ache; denies fever, rigors, dysuria, abnormal discharge, and postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period was 7 days ago. Reports regular cycles every 28–30 days with moderate flow and no intermenstrual bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild suprapubic/low pelvic tenderness to deep palpation. No guarding, rebound, or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Labia majora and minora normal; no lesions or fissures. Mild vestibular erythema from 4–8 o'clock, with no discharge. Small crescentic hymenal remnant at the posterior introitus, slightly thicker but non-obstructive and appearing within normal anatomical variation; no active fissure or bleeding, and tissue not rigid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cotton swab test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked allodynia of the vestibule, especially at 5–7 o'clock and just lateral to the urethral meatus; patient withdrew and described sharp burning pain with light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Single-digit pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased pelvic floor tone with marked guarding; difficult to advance finger, and deep palpation was limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Speculum examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speculum examination only partially attempted; patient was very uncomfortable and requested that it stop. Cervix grossly normal from the limited view, with no obvious discharge. No cervical motion tenderness on minimal movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bimanual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not completed because of pain and time constraints."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Impact of painful sex"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports avoiding sex most of the time, with occasional attempts with long-term partner; reports reduced intimacy, guilt about avoiding sex, and anticipatory anxiety before attempts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
