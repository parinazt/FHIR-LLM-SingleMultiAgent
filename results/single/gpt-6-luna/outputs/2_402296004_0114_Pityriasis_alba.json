    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for about 10 days, starting after an upper respiratory illness. Worse in the evenings and when talking a lot at work under air conditioning. Possible triggers reported by the patient include iced coffee and air conditioning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated and absent cough symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sore throat and blocked nose from the preceding illness are mostly resolved. No shortness of breath, wheeze, chest tightness, pleuritic chest pain, fever, chills, or haemoptysis. Appetite is okay; energy is slightly reduced. Continues to attend university and work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Relevant respiratory history and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of asthma or atopy. No smoking or vaping. No recent travel; classmates have had colds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing and comfortable, speaking in full sentences; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry; no wheeze, crackles, or chest wall tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild post-nasal mucus and slightly oedematous nasal mucosa. Throat has no erythema or exudate."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur or oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported facial and arm skin changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hypopigmented patches on the cheeks for about 3–4 months, more obvious after tanning over summer, with a few faint similar patches on the upper arms. Mild intermittent itch, especially after hot showers, and some dryness and flaking. No pain, bleeding, or vesicles. Patient is worried about vitiligo and has been scrubbing the face with exfoliant, which now stings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Facial skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ill-defined hypopigmented macules and patches on both cheeks and lateral jaw, 1–3 cm, with very fine scale on close inspection, indistinct borders, and mildly tanned background skin. No complete depigmentation or erythema; no classic chalk-white vitiligo patches."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Upper arm and trunk skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few faint hypopigmented patches with minimal scale on the upper arms. Trunk clear, with no lesions consistent with tinea versicolor."
      }
    },
