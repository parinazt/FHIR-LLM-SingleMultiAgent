        "code": {
          "text": "Left ocular trauma with possible corneal foreign body; possible non-penetrating versus occult penetrating injury"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left eye injury history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two days ago at work, while drilling overhead into a metal frame and wearing safety glasses, the patient felt something flick into the left eye. Immediate gritty sensation and watering; rinsed with bottled water onsite and showered that night. Metal dust or shavings exposure; no chemical exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left eye reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent foreign-body sensation; mild ache approximately 2/10, tearing, mild photophobia, and vision described as a bit blurry. Patient can still read phone and drive."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies diplopia, severe pain, flashes, curtain, bad headache, nausea, and vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General appearance and vital signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress; vital signs within normal limits (values not stated)."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Left eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild lateral conjunctival injection. No periorbital swelling or discharge. Cornea appears centrally clear by pen torch; possible small metallic foreign body at the superolateral limbus, difficult to exclude. No obvious hypopyon, gross anterior chamber abnormality, globe deformity, or visible penetrating object."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Pupils and extraocular movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal, round, and reactive to light; extraocular movements full and non-painful."
      }
    },
