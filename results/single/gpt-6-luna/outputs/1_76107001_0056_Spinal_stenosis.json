          "text": "Gait and walking examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cautious gait. Symptoms reproduced on a short walk at clinic and improved quickly on leaning forward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
