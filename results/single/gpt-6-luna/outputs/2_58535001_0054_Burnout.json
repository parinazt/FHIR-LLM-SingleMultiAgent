        "code": {
          "text": "Work-related somatic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tension headache and 'nervy stomach' with loose stools on work days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worry the night before shifts with racing thoughts about patient load and fear of errors. No panic attacks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation, including passive thoughts; states she is exhausted and over it but is not going to hurt herself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
