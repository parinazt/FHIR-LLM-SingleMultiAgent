        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual with no murmur. Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Brief genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No costovertebral angle tenderness or obvious external hernia. Testes non-tender with no swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Toenail changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thick yellow-brown discolouration of both great toenails, present for a couple of years and slowly increasing. Distal involvement is approximately 40–50% on the right and 30–40% on the left, with some subungual debris and mild onycholysis; other toenails mildly involved (<20%). Nails described as crumbly and cosmetically embarrassing. No current pain, surrounding redness, swelling, or discharge. No obvious tinea pedis on examination."
      }
    },
