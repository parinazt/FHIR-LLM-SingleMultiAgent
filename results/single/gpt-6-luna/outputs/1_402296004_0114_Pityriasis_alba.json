        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected facial patches twice daily for 5–7 days, then stop. Short course only; use a fingertip unit. Avoid the periocular area.",
