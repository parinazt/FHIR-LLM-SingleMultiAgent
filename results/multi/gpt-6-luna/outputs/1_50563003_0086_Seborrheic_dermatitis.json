        "status": "final",
        "code": {
          "text": "Facial skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous greasy scale in the nasolabial folds, medial cheeks, eyebrows, and peri-auricular areas. No significant telangiectasia or ocular findings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
