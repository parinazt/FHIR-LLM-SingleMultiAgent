    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported vitiligo patches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known vitiligo diagnosed by a dermatologist approximately 8 years ago, previously involving the ankles and feet. White patches have increased over 6–9 months, especially over the last 3 months, and now involve the hands, perioral area, and a small periocular area. Patches described as completely white and well-defined; more noticeable with increased sun exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Symptoms associated with skin patches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No itch or pain."
      }
    },
