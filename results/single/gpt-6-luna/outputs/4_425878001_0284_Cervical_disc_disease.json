    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "General appearance and affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well; anxious."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported right arm sensory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right arm pins-and-needles and cotton-wool sensation in a C6 pattern, from lateral upper arm and forearm to thumb and index finger; initially intermittent, now present most of the day. Worse with neck extension and computer work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported pain and functional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is not major; symptoms are mainly paraesthesia. Patient feels weaker when opening jars but reports no actual loss of function."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported gait and hand symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 2–3 weeks, slight increase in unsteadiness on uneven ground, with no falls. Mildly increased difficulty with buttons but managing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No bowel or bladder symptoms, saddle anaesthesia, trauma, red-flag systemic symptoms, or facial, visual, or speech symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neck range of motion and symptom provocation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced extension and right rotation. Extension and right lateral flexion reproduce right arm symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Gait examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly cautious gait with narrow base; can tandem walk but is a bit wobbly. Similar to previous per notes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Upper limb power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right elbow flexion 4+/5 and wrist extension 4+/5; rest of right upper limb 5/5. Left upper limb 5/5."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lower limb examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower limbs not grossly changed; lower limb sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reflexes and upper motor neuron signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right biceps reflex brisk (3+); knees 3+ bilaterally; other reflexes approximately unchanged. Right Hoffman equivocal, same as old. Plantars flexor. No clonus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Sensation examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced light touch and pin sensation over right lateral forearm and thumb/index finger, in C6 distribution."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Saddle sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No saddle anaesthesia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Comparison with previous GP examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Myelopathic signs essentially stable; new clearer right C6 sensory loss and slight reduction in right elbow and wrist power only."
      }
    },
