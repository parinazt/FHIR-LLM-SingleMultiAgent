        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious deformity or large effusion on video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bilateral knee X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild to moderate tricompartmental osteoarthritis, medial greater than lateral, with joint-space narrowing and small osteophytes. No fracture, chondrocalcinosis, or large effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "DIP and PIP osteoarthritis with osteophytes and joint-space narrowing, especially in the bilateral index and middle fingers. Early mild first CMC osteoarthritis with mild joint-space narrowing and small osteophytes. No erosions or inflammatory features."
      }
    },
    {
