        "code": {
          "text": "Lower back and bilateral hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain; usual intensity 5/10, flares to 7/10. Worse with prolonged standing and walking more than 50–100 m; relieved by sitting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
