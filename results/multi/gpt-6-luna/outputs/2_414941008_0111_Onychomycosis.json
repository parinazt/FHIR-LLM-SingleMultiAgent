    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported toenail changes and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Toenails thick, yellow, and crumbly for approximately 18/12, mainly the big toes. Mild discomfort in shoes and cosmetic bother; reports no pain, discharge, or spreading erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Tinea pedis symptoms and response to OTC cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "History of intermittent tinea pedis; OTC cream helps itch only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Toenail examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Great toenails opaque, yellow, and thickened, with distal crumble/onycholysis involving approximately 40–50% on the right and 30–40% on the left; some second toenails also affected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Periungual and foot examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious periungual erythema or pus; no cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Visible skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small erythematous scaly plaques on the shins, consistent with psoriasis; no cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
