          "text": "Menstrual cycle interval"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cycles currently approximately 35–45 days; previously 60–90 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
