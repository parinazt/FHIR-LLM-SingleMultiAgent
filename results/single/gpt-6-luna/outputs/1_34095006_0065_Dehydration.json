      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for 4 days, mainly central and bilateral across the lower lumbar region, described as a deep ache; worse after long shifts standing and with bending, slightly better lying flat. No specific trauma or heavy lifting beyond usual work duties."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported back pain-associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation to legs, numbness, tingling, weakness, saddle anaesthesia, bowel or bladder incontinence, fever, rigors, night sweats, or recent viral symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache for 2 days, dry mouth, light-headed on standing at work, darker urine today and markedly reduced urine volume today. No dysuria, frequency, urgency, haematuria, flank pain, nausea, vomiting, chest pain, shortness of breath, or palpitations."
      }
    },
