      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Panic episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two mild panic episodes this week while congested and walking to the letterbox; felt somewhat breathless and settled after about 10 minutes with breathing exercises. No syncope or chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Mood and depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as “up and down but mostly ok considering Ive been crook”; some decreased motivation and anhedonia. Denies active suicidal ideation, plan, or intent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep somewhat worse due to congestion; no nightmares."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Brief mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech coherent and normal rate; mood “bit flat and on edge”; affect congruent; thought form logical; no psychosis or suicidal ideation today; good insight; asks reassurance-type questions about chest infection."
      }
