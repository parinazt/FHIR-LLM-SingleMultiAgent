    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vague central/lower abdominal aching for about 3 weeks, worse when twisting in bed and not clearly exertional; no sudden onset or radiation to the back. No vomiting or PR bleeding; bowels somewhat sluggish at baseline. Appetite slightly decreased but still eating most meals. Patient wonders if new margarine is upsetting the stomach."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Intermittent head pressure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief intermittent right frontal/parietal pressure a few times per week, lasting minutes. No visual change, speech disturbance, limb weakness, facial droop, thunderclap onset, or early-morning vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
