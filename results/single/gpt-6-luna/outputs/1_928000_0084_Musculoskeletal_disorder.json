        "code": {
          "text": "Jaw pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for 3–4 weeks, left greater than right in the pre-auricular area; dull ache with a sharp twinge on wide opening or chewing. Pain is 3–4/10 at rest and up to 6/10 with chewing, improved from 8/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
