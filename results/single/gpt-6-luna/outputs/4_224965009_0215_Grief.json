    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported mood and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since her father's death, she reports feeling very low, tearful, with reduced motivation and concentration at work, and fatigue."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty getting to sleep and waking early at approximately 4 am, with rumination about her father and replaying their last phone call; reports intrusive images of him in hospital."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Appetite and reported weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced appetite; reports approximately 3 kg weight loss. Still eating daily."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Interest and enjoyment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports some enjoyment from spending time with her niece and walking the dog, but says this is rare."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Panic-like episode"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "One panic-like episode at a school assembly with palpitations and tremor; settled with breathing outside."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Grief-related feelings and guilt"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports waves of intense yearning and a hollow feeling in her chest, with some guilt about not visiting her father more. Denies pervasive worthlessness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Suicidal ideation and risk assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fleeting passive thoughts that it would be easier not to wake up. No active suicidal ideation, plan, or intent. Protective factors include her mother, sister, employment, and future orientation. Clinician assessed overall suicide risk as low; no history of attempts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Psychotic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No psychotic symptoms reported; no delusions or hallucinations elicited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Verbal PHQ-9 screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Verbal PHQ-9 in the moderate depression range; clinician notes the presentation is more consistent with acute grief and has no current red-flag features for major depressive disorder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
