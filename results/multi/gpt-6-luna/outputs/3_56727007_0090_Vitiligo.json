    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Depigmented skin patches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple sharply demarcated depigmented macules and patches on the dorsum of the hands, peri-oral area (described as a “milk moustache”), small eyelid areas, and older patches on the ankles and feet. No scale or erythema; some follicular repigmentation on older ankle lesions and a few white hairs within lesions. No obvious dermatitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported change in skin patches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased white patches over 6–9 months, especially over the last 3 months, involving the hands, peri-oral area, and a small peri-ocular area. Describes the patches as “completely white” and well-defined, with no itch or pain. Patches have become more obvious with increased sun exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Eye findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eyes grossly okay; no red eye or photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
