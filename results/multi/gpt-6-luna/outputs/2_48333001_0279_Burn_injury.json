        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wound bed pink and moist with early epithelialisation; clean, with no slough or eschar."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
