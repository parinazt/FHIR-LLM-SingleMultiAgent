        },
        "valueString": "Alert and oriented, mildly uncomfortable, not toxic-appearing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing left shoulder stiffness and pain for approximately 8-9 months. Patient cannot lift the arm to comb her hair or hang washing; sleep is disturbed because she cannot lie on the left side. Previously tried physiotherapy, which she says made it worse, and stopped."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Diffuse anterolateral tenderness; global reduction in active and passive range of motion, especially external rotation and abduction, painful at end range; internal rotation also reduced. No focal bony tenderness over clavicle, AC joint, or humeral head. Findings considered consistent with adhesive capsulitis."
      }
    },
