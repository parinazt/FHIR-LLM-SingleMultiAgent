        "code": {
          "text": "Senna use and effect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses senna as needed every 2–3 weeks; it causes cramps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as “bit flat” but stable; denies suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sounds well, speaks in full sentences, no audible shortness of breath, and is coherent."
      }
    },
