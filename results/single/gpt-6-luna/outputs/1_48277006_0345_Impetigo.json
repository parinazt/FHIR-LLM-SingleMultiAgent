        "code": {
          "text": "Skin lesions, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports itchy, not painful lesions on the right shin and left arm for approximately 1–2 weeks, with a feeling that they are spreading. Started as a small red spot on the right shin, then blistered and developed yellow/honey-coloured crust. Three lesions on the right shin and one on the left forearm. Patient reports no pus, only crust."
      }
    },
