    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Weight and muscle change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive weight loss over the last year in the setting of advanced illness; further decreased muscle bulk on inspection. Wife reports clothes are much looser."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very thin, frail, cachectic elderly male; alert and cooperative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding low back pain, worse over the last 3–4 weeks; localized lumbar dull ache with stiffness, especially on getting up. Pain is 5–6/10 most days and up to 8/10 with prolonged standing. Worse after sitting more than 30 minutes and first thing in the morning; improves somewhat with gentle movement. Paracetamol gives partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Possible factors associated with back pain flare"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no specific injury; thinks a new mattress and sitting too long in a recliner may be contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, urinary retention, faecal incontinence, severe night pain waking him, and trauma or fall. No new leg weakness. No focal vertebral point tenderness or systemic infective symptoms documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Back inspection and paraspinal bulk"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alignment okay; no deformity or bruising. Markedly decreased paraspinal bulk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lumbar paraspinal tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild tenderness of lower lumbar paraspinals; no focal bony point tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Back range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flexion and extension decreased due to pain and stiffness; able to flex to mid-shin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Lower limb power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 4+/5 bilaterally and symmetrical; described as sarcopenic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Lower limb reflexes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patellar and ankle reflexes present and symmetrical."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Foot sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sensation to light touch slightly decreased in both feet, unchanged from prior baseline; patient reports mild chronic foot numbness for more than 6 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Straight leg raise"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slow and shuffling, but stable with a single-point stick."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Weakness and tiredness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels generally weaker and more tired; described as longstanding in the context of cachexia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Appetite and food intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor appetite; usually eats one small meal per day plus occasional snacks. Reports early satiety and says, “Food just doesn’t do it.” Cooking smells are off-putting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Nausea and upper gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional mild nausea when the kitchen is steamy. Denies vomiting and dysphagia; no oral ulcers reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels open every 1–2 days; formed stool. Denies rectal bleeding and melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-25",
        "status": "final",
        "code": {
          "text": "Mood and enjoyment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low motivation but continues to enjoy cricket and time with grandchildren. Denies pervasive low mood, anhedonia, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-26",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-26",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no masses or hepatosplenomegaly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-27",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-27",
        "status": "final",
        "code": {
          "text": "Oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral mucosa moist; no mucositis or thrush."
      }
    },
