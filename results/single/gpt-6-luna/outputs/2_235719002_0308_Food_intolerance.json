        "code": {
          "text": "Intermittent itchy rash, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent itchy rash on forearms and anterior neck for approximately 2 months; comes and goes. Flares a few hours after certain meals. Approximately 4–5 episodes in the past 2 weeks."
      }
    },
