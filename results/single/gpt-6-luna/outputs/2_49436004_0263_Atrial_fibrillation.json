    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 7–10 days ago without specific injury; dull ache across the lower back with occasional sharp pain on twisting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Up to 7/10 at worst; currently approximately 4/10 after morning paracetamol."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Low back pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse getting out of bed, standing, walking more than a few minutes, and initially lying down; eased by sitting and leaning forward on the walker. Pain with turning in bed disturbs sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Patient-reported possible contributors to low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wonders whether a new soft mattress or prolonged sitting in a lounge chair may be contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Back pain associated neurologic and bowel/bladder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg radiation, numbness, tingling, weakness, saddle anaesthesia, and bowel or bladder incontinence or retention."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Back pain systemic and trauma red-flag screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent falls or trauma, fevers, chills, night sweats, weight change, or cancer history; no steroid use. No bruising, focal spinal tenderness, or haemodynamic concern documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Baseline cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Exertional shortness of breath after more than 20–30 metres is unchanged from baseline. Baseline cough and shortness of breath; reports being a bit more puffed on very hot days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Cardiac symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, orthopnoea, paroxysmal nocturnal dyspnoea, ankle swelling, presyncope, or syncope. Usual fluttering palpitations are barely noticed, without recent increase or fast heart-rate episodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
