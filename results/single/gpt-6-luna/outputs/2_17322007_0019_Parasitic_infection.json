    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 7 days before the visit; dull, band-like pressure at the temples and forehead, occasionally occipital, non-pulsatile, severity 4–6/10. Worsens late in the day after long hot kitchen shifts and late-night screen use; builds over the day and settles overnight, with no early-morning waking. Relieved by paracetamol 1 g up to twice daily as needed and resting in a dark room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia when very tired. Denies nausea, vomiting, visual aura, focal neurological symptoms, speech change, sensory loss, fever, neck stiffness, rash, confusion, seizures, recent head trauma, thunderclap onset, worst-ever headache, personality or cognitive change, visual field loss, diplopia, and jaw claudication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2–3 weeks, intermittent mild crampy lower abdominal discomfort and bloating; stool frequency increased to 2–3 times daily from baseline once daily. No overt diarrhoea, blood, mucus, weight loss, or nocturnal symptoms. Had 2–3 days of loose stools after travel that self-resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Perianal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent nocturnal perianal itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Travel and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Returned from a 3-week trip to Mumbai and Goa approximately 3 months before the visit; no malaria prophylaxis and no acute febrile illness during the trip or on return. Denies cough, shortness of breath, jaundice, night sweats, urinary symptoms, rigors, and fever."
      }
    },
