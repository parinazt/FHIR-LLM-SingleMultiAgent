    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash and itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported red, mildly itchy spots on the upper chest and dorsal forearms for about 1 week; initially a few dots and now more numerous, remaining above the waist. Itch worse in the evenings and after showering; does not wake the patient at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple small 2–5 mm erythematous, slightly raised papules over the upper anterior chest and shoulders, with scattered papules on the dorsal forearms; some coalescing into small patches. Mild excoriation. No vesicles, pustules, crusting, target lesions, or purpura. Face, palms, soles, and mucosa spared."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Rash-associated symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No weeping or pain. No fever, systemic symptoms, or recent viral illness. Reports a new body wash about 2 weeks ago and wearing a new synthetic high-visibility shirt while sweating at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Respiratory and swelling symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, wheeze, and lip or tongue swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies genital rash, dysuria, and discharge. Reports voiding 5–6 times daily and once overnight, with a slow stream unchanged from usual. Denies haematuria, loin pain, suprapubic pain, or recent UTI; reports no UTI for more than 1 year."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Chest and cardiac examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear. Heart sounds dual with no added sounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Abdominal and flank examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, no mass, no suprapubic distension, and no costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
