    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tight sensation in the throat, particularly in the evenings when lying down, occurring on 4–5 days out of 7; feels as if something is stuck. No true pain, dysphagia to solids or fluids, odynophagia, choking, or regurgitation. Similar globus episodes during stress are documented in the past."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Voice and associated throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent hoarseness, particularly after a full day teaching or yelling. No coryzal symptoms, cough, or fevers. No weight loss or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Premenstrual symptoms and menstrual pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding irritability, marked mood swings, bloating, breast tenderness, and headaches in the week before menses, settling 1–2 days after bleeding starts; essentially well mid-cycle. Regular 28–30-day cycles with 5–6 days of bleeding. One partly completed symptom diary this cycle continues to show a luteal-phase pattern resolving after menses. Physical premenstrual symptoms are milder than mood symptoms and irritability."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Premenstrual mood symptoms and impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "In the week before her period, feels like she is going to snap at everyone, with increased conflict at work and with her partner. No persistent low mood or anhedonia outside the premenstrual week. No suicidal ideation or self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and voice on examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, slightly tense and irritable, speaking in full sentences; voice mildly husky."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Oropharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear; no erythema, exudate, tonsillar enlargement, or ulcers. Uvula central."
      }
    },
    {
