    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep pattern and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worsening sleep for approximately 3–4 weeks. Difficulty initiating and maintaining sleep; goes to bed at 23:00–00:00 and is often awake until 02:00–03:00, wakes 3–4 times, and estimates 3–4 hours of broken sleep nightly. Sleep is non-restorative, with increased irritability and daytime fatigue."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Bedtime anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased anxiety at bedtime; reports that the main sleep difficulty is that his brain is not switching off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Chronic musculoskeletal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic low back and right shoulder pain, 4–5/10 at baseline and flaring to 7/10 after big days. Pain sometimes wakes him and contributes to sleep disruption."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep-related history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports snoring a bit. No witnessed apnoea, restless legs symptoms, or parasomnias."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Caffeine and sleep habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased caffeine, including strong cold brew in the afternoon and occasional energy drink at approximately 15:00–17:00. Uses phone in bed; wife watches television in the bedroom. Occasionally naps for 20–30 minutes after work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Substance use and opioid-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current cravings or illicit opioid use; no recent missed Suboxone doses. No benzodiazepine use. Alcohol 1–2 standard drinks per week. Rare cannabis use, currently avoiding it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telephone assessment for respiratory, overdose, and withdrawal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, confusion, overdose symptoms, or withdrawal symptoms over the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mental status and safety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech clear and oriented; sounds tired but not intoxicated. Denies suicidal ideation and self-harm; no psychotic symptoms."
      }
    },
