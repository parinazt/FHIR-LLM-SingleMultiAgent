        "code": {
          "text": "Low back pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 2 weeks of gradual-onset central low lumbar dull ache, slightly right-sided; can be sharp with bending; up to approximately 6–7/10 if pushed but mostly annoying. Worse after long periods at a desk and lifting shopping. Slight stiffness for the first 10–15 minutes in the morning, then eases. Patient suspects a new office chair or sleeping awkwardly on the couch."
      }
    },
