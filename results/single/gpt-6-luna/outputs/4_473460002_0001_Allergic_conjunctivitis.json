        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No preauricular lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Allergic rhinitis symptoms and nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Seasonal sneezing and rhinorrhoea each spring, worse this week; pale boggy nasal mucosa and clear rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Systemic symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, malaise, upper respiratory symptoms, or sick contacts at home. Throat clear; chest clear with no wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
