    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck and right arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck and right arm pain radiating along the lateral arm to the thumb and index finger for about 4 months. Initially worse, then partially improved, and increased again over the last 2–3 weeks; particularly troublesome at night and keeps the patient awake most nights. Neuropathic quality described as shooting and burning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right hand sensory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pins and needles in the right thumb and index finger with occasional numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right hand dropping objects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports dropping things with the right hand a few times over the last month; describes this as possibly being clumsy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Pain aggravating factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looking down at a phone, hanging washing, and long drives aggravate symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Pain relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heat pack, rest, naproxen, and amitriptyline helped."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported left-sided symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No left-sided symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Red flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies gait disturbance, limb heaviness, saddle symptoms, bowel or bladder incontinence or retention, bilateral symptoms, Lhermitte sign, fine motor decline, weight loss, fevers, night sweats, and trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Comfortable at rest, moves neck cautiously, appears tired, and is in no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right paracervical tenderness greater than left. Reduced extension and right lateral flexion; flexion slightly reduced. Spurling test positive, reproducing right arm pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Upper limb sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced light-touch sensation in the right thumb and index finger; left sensation normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Right upper limb motor examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right elbow flexion 4+/5, wrist extension 4/5, and grip 5/5; patient reports intermittent weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Upper limb reflexes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right biceps and brachioradialis reflexes reduced compared with left; triceps reflexes equal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Upper motor neuron and lower limb examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No upper motor neuron signs. Hoffmann negative. Plantar responses flexor bilaterally. Gait to the door and back normal; lower limb screen grossly normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working, with reduced driving and some home visits. Poor sleep and some difficulty hanging washing and carrying shopping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient mentioned feeling more tired lately."
      }
    },
