    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue and weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased fatigue and weakness for approximately 3–4 weeks, wiped out by the afternoon; ADLs remain okay but are slower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, shortness of breath, palpitations, oedema, weight loss, fevers, night sweats, PR bleeding, melaena, recent travel, or suicidal ideation. Mood is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary incontinence symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mixed incontinence, urge-predominant and stable; urgency with small-volume leakage and some stress leakage, using 3–4 pads per day. Nocturia twice nightly. No retention symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new lower urinary tract symptoms apart from longstanding urgency and incontinence. No dysuria, haematuria, loin pain, or fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
