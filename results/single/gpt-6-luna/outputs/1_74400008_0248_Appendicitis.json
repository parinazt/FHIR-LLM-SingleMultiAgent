    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "36–48 hours of pain, initially vague periumbilical discomfort and now localized to the right iliac fossa/right lower quadrant; constant ache with sharp twinges on movement or coughing. 7/10 on movement today and approximately 4/10 yesterday. Worse with walking, coughing, and speed bumps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea since yesterday morning; no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked anorexia; patient reports she could not look at food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Subjective fever or rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible fever or rigors last night; felt hot and sweaty and used a fan. No temperature recorded."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last bowel motion yesterday morning, normal. No diarrhea, constipation, rectal blood, or mucus; flatus present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, frequency, hematuria, and flank pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gynecologic history and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "LMP approximately 2 weeks ago; regular 28-day cycles; taking COCP with good compliance. No vaginal bleeding or discharge. No history of PID or ovarian cysts and no new sexual partners."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Limited patient-performed abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports maximal tenderness in the right lower quadrant compared with other quadrants. Reports that release after pressing hurts 'really really' badly; possible rebound, uncertain. Hop test not attempted because of pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Movement and general symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports being too sore to stand up straight and feeling sweaty. During the phone consultation she spoke in full sentences and sounded uncomfortable when moving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, syncope, and generalized abdominal distension."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Response to paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Took two 500 mg paracetamol tablets last night; pain decreased only mildly."
      }
    },
