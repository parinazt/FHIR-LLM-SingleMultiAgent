        "code": {
          "text": "Right foot sensory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked allodynia to light touch over the dorsum and lateral foot to just above the ankle; hyperalgesia to pinprick. No proximal sensory loss."
      }
    },
