    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Low back and bilateral hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain, worse with prolonged standing and walking more than 50–100 m; relieved by sitting. Usual pain 5/10, flares to 7/10. Pain increases in cold."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild fatigue; needs daytime rest most days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nocturia 2–3 times and mild hesitancy; denies dysuria, fever, urinary retention, and haematuria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurological and bowel/bladder red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, leg weakness, and bowel or bladder incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Weight and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No noted weight loss; appetite described as average."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin, not cachectic; ambulant and moves cautiously from chair, mildly uncomfortable with position change. Mobilises independently without gait aids, occasionally leans on furniture when pain is bad; no recent falls. Gait cautious, non-antalgic; able to heel and toe walk briefly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry; no added sounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no palpable masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Back and musculoskeletal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild tenderness over lower lumbar spine and bilateral sacroiliac regions. Lumbar flexion and extension mildly reduced due to pain. Straight-leg raise negative bilaterally. Lower-limb power 5/5; sensation intact L2–S1; reflexes 2+ and symmetrical."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Functional limitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty climbing two flights of stairs, especially carrying groceries, with significant pain and multiple stops; difficulty standing to cook for more than 10–15 minutes and walking more than 100 m without rest due to back and hip pain. Independent with showering, dressing, and toileting, though sometimes needs to rest afterward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "PSA"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports PSA went up and then down again; specialists are reportedly happy with it. No recent PSA result available in this system."
      }
    },
    {
