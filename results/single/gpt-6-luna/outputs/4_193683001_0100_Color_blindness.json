    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Forearm rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash on both forearms for about 10 days, still itchy but a bit better. Worse after work and in the evenings. No pain, fever, blisters, or weeping. Soap stings if left on the skin. The patient thinks the rash may be from the new work soap or too much Red Bull. The patient's wife says it has gone from red to more brown and looks a bit better."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Telehealth skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: patchy erythematous papular rash over the extensor surfaces of both forearms, right greater than left. No obvious vesicles, crust, pus, or significant swelling. Hands and palms spared. Appears non-infected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "General appearance during telehealth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, talking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new visual symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Tiredness and headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tiredness and headaches after long hot days; asked to book a separate appointment if ongoing."
      }
    },
    {
