        "code": {
          "text": "Inframammary intertrigo, chronic/recurrent; candidal cause suspected"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Patient-reported inframammary rash and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash under the breasts on and off for months, worse over the last 2–3 weeks; itchy, burning, red and moist, with slight odour when worse. Worse with heat, sweating, wearing a bra all day and gardening; improves when aired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Inframammary skin examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral erythematous, macerated, well-demarcated plaques; possible satellite papules. No obvious ulcer, pus or clear cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and rash distribution"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, rigors, spreading erythema or systemic symptoms. No current groin or perianal rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Patient-reported past medical history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies diabetes, cardiovascular disease and other chronic disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "As needed; dose and route not stated",
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "stopped",
        "medicationCodeableConcept": {
          "text": "Unspecified antifungal from a white tube"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Obtained from usual GP approximately 6 months ago; used for approximately 1 week, then stopped. Rash recurred."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Clotrimazole 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to affected areas twice daily for at least 2 weeks and for a few days after the rash has resolved.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Zinc-based barrier cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer after the antifungal has absorbed, especially on hot days.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    }
