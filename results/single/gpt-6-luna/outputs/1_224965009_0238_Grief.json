          "text": "Appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased appetite."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal ideation: 'better if not here'; no plan or intent. Says he will not act because of his children. No previous attempts."
      }
    },
    {
