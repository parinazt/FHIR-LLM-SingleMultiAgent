      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Muscle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing generalised muscle pain flare; increased pain over the last 2–3 weeks in the neck, shoulders and upper back, with occasional low back pain. Dull ache with intermittent sharp twinges, worse at the end of the workday and after long periods at the computer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep disturbance and night pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep mildly disturbed on some nights due to discomfort; no true persistent night pain regularly waking the patient."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Patient-reported cancer worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very worried that the pain could be bone cancer or hidden cancer; reports repeatedly thinking that cancer may be missed and requests scans or blood tests."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported red-flag and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, weight loss, fever, sweats, systemic symptoms, focal neurological symptoms (including weakness, numbness or sphincter change), chest pain, shortness of breath, abdominal pain, headache or visual change. Appetite okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
