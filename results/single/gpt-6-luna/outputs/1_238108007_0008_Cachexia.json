    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding pain, worse over the last 3–4 weeks; localized dull lumbar ache and stiffness, especially on getting up. Pain is 5–6/10 most days and up to 8/10 with prolonged standing. Worse after sitting more than 30 minutes and first thing in the morning; improves somewhat with gentle movement. No specific injury; patient thinks a new mattress and prolonged sitting in a recliner may contribute. Paracetamol gives partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain red-flag symptoms and trauma"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, urinary retention, faecal incontinence, severe night pain waking him, trauma, or fall. No new leg weakness. No current cauda equina features or systemic infective symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Chronic numbness in feet"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild chronic numbness in feet, unchanged from baseline for more than 6 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Recorded weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 55,
          "unit": "kg"
        },
        "note": [
          {
            "text": "Last recorded 6 weeks before this visit; down from approximately 61 kg about 6 months before this visit. Patient does not want frequent formal weighing."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Appetite and eating"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor appetite, usually one small meal a day with occasional snacks; early satiety. Patient says food 'just doesnt do it' and cooking smells are off-putting. Wife reports clothes are much looser and family is worried he is 'starving himself'. Occasional mild nausea when the kitchen is steamy; no vomiting, dysphagia, oral ulcers, mucositis, or thrush."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels open every 1–2 days with formed stool. Denies rectal bleeding and melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Mood and energy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low motivation and feeling generally weaker and more tired, longstanding in the context of cachexia. Still enjoys cricket and grandchildren; denies pervasive low mood, anhedonia, and suicidal ideation."
      }
    },
    {
