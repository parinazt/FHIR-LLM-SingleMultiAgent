    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Agoraphobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Distress related to separation from partner or home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked distress occurs most days when away from the partner or home. The patient reports feeling physically sick and being unable to focus until the partner returns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxiety the night before the partner goes to work or social activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Checking behavior and worries about partner safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repeatedly checks the partner's location and messages, and worries that something bad will happen and the partner will not come home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Avoidance when alone outside the home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids being alone outside the home; cancels or delays appointments if the partner cannot accompany her and uses grocery delivery."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and nightmares when partner is away"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Has difficulty sleeping when the partner is not in the flat and waits awake until the partner returns. Occasionally has nightmares about the partner going missing or having an accident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Somatic symptoms associated with partner leaving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdominal tightness, nausea, and mild headache when the partner is about to leave; symptoms settle when the partner is home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Agoraphobia-related avoidance and distress"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids public transport and busy indoor spaces alone; can walk a short distance around the block with her partner and has high distress about unfamiliar places alone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Anxiety severity and recent course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms have been worse over the last 2 months, particularly with the partner's office days. Remote work from home suits the patient but allows her to avoid going places."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Caffeine use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 3–4 coffees daily, with increased intake on stressful mornings; the patient feels caffeine makes anxiety worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Alcohol, tobacco, and illicit substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rare alcohol use (1–2 drinks per month); does not smoke and reports no illicit substance use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clear major depressive episode. Denies persistent low mood, hopelessness, anhedonia, suicidal ideation, and thoughts of self-harm; continues to enjoy drawing, shows, and online gaming."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neat with good hygiene, calm but clearly anxious, cooperative, and with good eye contact via camera. Speech normal. Mood described as anxious; affect congruent and reactive. Thought form linear, with content dominated by worries about partner safety and being alone. No suicidal ideation or psychosis. Cognition grossly intact; insight good."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Video examination: respiratory distress and color"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious respiratory distress; color appeared normal on video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Blood pressure, patient-reported prior measurement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports that the last blood pressure measurement, approximately 3 months ago at pathology, was normal."
      }
    },
