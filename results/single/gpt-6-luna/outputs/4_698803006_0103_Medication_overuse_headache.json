    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sumatriptan"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "50 mg as needed for migraine, used approximately 8–10 days per month. Continue at onset; may repeat once after 2 hours; maximum 100 mg in 24 hours. Restrict use to fewer than 10 days per month.",
            "asNeededBoolean": true,
            "route": {
              "text": "oral"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 50,
                  "unit": "mg"
                }
              }
            ]
