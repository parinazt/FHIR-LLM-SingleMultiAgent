    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple rough spots on hands and face for months; mostly asymptomatic until the last few weeks, with intermittent itch and irritation, especially with gloves or a hat. No pain, bleeding, or ulceration."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited examination of face, scalp, neck, forearms, and hands. Fair skin, Fitzpatrick type II. Dozens of 2–6 mm erythematous, rough, scaly macules and papules on dorsal hands, forearms, forehead, temples, and ears, with a sandpaper feel. Lesions non-tender, without induration, ulceration, or bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Thicker right dorsal hand lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 7 mm mobile hyperkeratotic papule with mild scale; no clear induration or tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Examination for other suspicious skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious suspicious pigmented lesions in exposed areas. No lymph node enlargement in preauricular, cervical, or axillary areas."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
