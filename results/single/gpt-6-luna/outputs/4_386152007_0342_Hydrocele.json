        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported scrotal lump change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daughter feels the lump looks a bit bigger again and is concerned pads might be rubbing or squashing things; she also wonders whether frozen dinners upset his stomach this week."
      }
    },
