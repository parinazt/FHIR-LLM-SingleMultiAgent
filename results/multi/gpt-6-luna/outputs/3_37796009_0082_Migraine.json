        "status": "final",
        "code": {
          "text": "Reported headache red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap headache, focal neurological symptoms, visual loss, speech issues, fever, or neck stiffness reported."
      }
    },
    {
