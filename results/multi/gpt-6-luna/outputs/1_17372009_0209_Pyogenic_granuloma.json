      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right index finger lesion appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsolateral aspect just distal to PIPJ; approximately 5–6 mm red, friable dome papule on a narrow stalk with a moist surface."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right index finger lesion bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lesion bleeds on and off, especially with use of the till and handling notes. Mild bleeding on light contact during examination settled with direct pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right index finger lesion onset and reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Noticed approximately 4–5 weeks after a box-cutter nick. Irritating and a nuisance rather than painful; affects cash handling and stock work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
