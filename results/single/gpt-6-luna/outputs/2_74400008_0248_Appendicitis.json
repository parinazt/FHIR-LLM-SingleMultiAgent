        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked anorexia; patient said she could not look at food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
