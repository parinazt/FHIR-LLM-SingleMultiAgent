        "code": {
          "text": "Left-sided low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acute localized left lumbar pain for approximately 10 days after lifting heavy stock boxes at work; initially a sharp twinge, now a constant dull ache with intermittent sharper pain on flexion, twisting, and rolling in bed. No radiation below the knee."
      }
    },
