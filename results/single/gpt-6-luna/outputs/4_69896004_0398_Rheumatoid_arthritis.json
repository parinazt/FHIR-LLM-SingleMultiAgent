        "code": {
          "text": "Cardiopulmonary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear. Heart sounds dual; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
