    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradually increasing knee pain for 12–18 months, right greater than left; dull ache, worse in the evening and after walking or standing, improved by rest and heat; mild to moderate and intermittent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Knee stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Morning stiffness lasts less than 15 minutes; described as 'a bit creaky'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Knee swelling and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent evening knee swelling. No redness, locking, or giving way. No true night or rest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Hand joint pain and bony swellings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain in DIP and PIP joints with bony 'knobbly bits', especially index and middle fingers; worse after gardening or tablet use. Patient is concerned about wearing the joints down to 'bone on bone'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Activities of daily living intact. Reduced long walks and avoids stairs; continues gardening in shorter sessions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telehealth general appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, in no apparent distress on screen, and speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stood and walked into frame; mild antalgic gait favouring the right knee."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visible DIP bony swellings consistent with Heberden's nodes. No obvious erythema visible by video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Knee examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious deformity or large effusion visible by video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Bilateral knee X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild to moderate tricompartmental osteoarthritis, medial greater than lateral, with joint-space narrowing and small osteophytes. No fracture, chondrocalcinosis, or large effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Hand X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "DIP/PIP osteoarthritis with osteophytes and joint-space narrowing, especially in the index and middle fingers bilaterally. Early first CMC osteoarthritis with mild joint-space narrowing and small osteophytes. No erosions or inflammatory features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
