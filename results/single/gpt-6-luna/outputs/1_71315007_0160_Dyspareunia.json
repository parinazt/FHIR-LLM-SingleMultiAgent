        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported deep pelvic discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional deep pelvic ache with penetration, especially in certain positions; mild chronic pelvic ache reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period was 7 days before the note; cycles regular every 28–30 days with moderate flow and no intermenstrual bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported current associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current abdominal pain apart from mild chronic pelvic ache; denies fever, rigors, dysuria, abnormal discharge, and postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Soft, non-distended abdomen with mild suprapubic/low pelvic tenderness on deep palpation; no guarding, rebound, or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal labia majora and minora; no lesions or fissures. Mild vestibular erythema from 4–8 o'clock. No discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Hymenal tissue examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small crescentic hymenal remnant at the posterior introitus, slightly thicker but non-obstructive and appearing within normal anatomical variation; tissue not rigid, with no active fissure or bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Cotton swab test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked vestibular allodynia, especially at 5–7 o'clock and just lateral to the urethral meatus; patient withdrew and described sharp burning pain to light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Single-digit pelvic floor examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased pelvic floor tone and marked guarding; difficult to advance finger. Deep palpation limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
