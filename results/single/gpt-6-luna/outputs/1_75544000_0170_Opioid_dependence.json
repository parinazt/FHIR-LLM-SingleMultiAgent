        "code": {
          "text": "Bilateral epiphora and eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Watery eyes in both eyes for approximately 3 days, feels like crying but is not; worse outdoors and in wind. Mild grittiness. No photophobia, visual loss, eye trauma, purulent discharge, contact lens use, known foreign body exposure, or headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
