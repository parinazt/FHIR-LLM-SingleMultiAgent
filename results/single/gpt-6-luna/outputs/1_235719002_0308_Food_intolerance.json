    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Intermittent itchy rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent itchy rash on the forearms and anterior neck for approximately 2 months; comes and goes, with episodes a few hours after certain meals. Approximately 4–5 episodes in the past 2 weeks. The patient reports it seems to flare on nights after pasta or takeaway. Hand sanitiser stings when the rash is present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported food-associated gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding bloating, crampy lower abdominal pain, and variable stool. The patient notes a clearer association with wheat (pasta and bread), onion/garlic, and some fruit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported cognitive and energy symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "The patient reports feeling foggy and wiped out on bad gut-symptom days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Response to informal dietary modifications"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "After reducing pasta, apples, onion, and garlic for 3 weeks, the patient reports approximately 30–40% improvement in bloating and fewer rash days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Negative associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "The patient denies facial swelling, shortness of breath, wheeze, and throat tightness. No weight loss, rectal bleeding, nocturnal diarrhoea, or fevers reported. No previous anaphylaxis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint erythematous macular rash on the left flexor forearm; non-vesicular and non-purpuric, with no warmth, angioedema, or mucosal involvement."
      }
    },
