    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Rash history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 3–4 weeks of itchy, red, flaky patches around the nostrils, medial eyebrows, and beard line. Worse after hot showers and at the end of the work day. Heat or sweat at work in roof spaces may be a trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Rash-associated symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pustules, pain, weeping, or crusting reported. No systemic symptoms and no new soaps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Facial skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous greasy mild scale around alar folds, brows, glabella, and upper beard line. No pustules or comedones. No rosacea or psoriasis features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
