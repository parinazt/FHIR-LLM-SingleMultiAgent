        "code": {
          "text": "Localized irritant/contact dermatitis versus razor burn or friction dermatitis of suprapubic/upper groin area"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
