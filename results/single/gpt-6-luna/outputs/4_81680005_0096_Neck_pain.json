    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy red papular rash for 4 days on the anterior neck and upper chest, with a few spots on the upper back/bra line. Patient reports it started the day she wore a new synthetic top, which felt scratchy. A new washing powder is also a possible trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rash-associated negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, shortness of breath, facial or tongue swelling, or blisters reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous papules/plaques on the anterior neck and upper chest, with a few on the upper back. No vesicles, weeping, infection, or mucosal/facial involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain for about 3 months, worse over the last 2–3 weeks. Bilateral lower cervical/upper trapezius ache and stiffness with a knot-like feeling, rated 4–6/10, worse at the end of the workday. Patient works long hours at a computer and leans forward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neck pain-associated negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No arm pain, paraesthesia, weakness, headache, trauma, or systemic symptoms reported."
      }
    },
