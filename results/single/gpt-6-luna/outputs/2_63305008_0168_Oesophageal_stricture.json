        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent solid-food dysphagia, especially with meat and bread"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2–3 weeks, eating more slowly and leaving meat; food feels like it sticks halfway down, then is coughed back up with water."
      }
    },
