        "code": {
          "text": "Right shoulder strength testing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Supraspinatus testing reproduces pain; possible slight weakness versus pain inhibition. Infraspinatus and subscapularis strength grossly okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
