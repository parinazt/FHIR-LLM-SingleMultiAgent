        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer perianally once nightly for 2–3 weeks, up to a maximum of 4 weeks, then cease. May use short courses as needed if symptoms recur.",
            "route": {
              "text": "perianal"
            },
