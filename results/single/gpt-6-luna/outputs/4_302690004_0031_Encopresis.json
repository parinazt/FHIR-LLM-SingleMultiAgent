        "dosageInstruction": [
          {
            "text": "Oral disimpaction on days 1–3: take 1 sachet hourly up to a maximum of 8 sachets per day. May space to every 2 hours if cramps or bloating. Aim for large stool output or clear liquid stools.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "h"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "sachet"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
                "value": 8,
                "unit": "sachets"
              },
              "denominator": {
                "value": 1,
                "unit": "day"
              }
            }
          },
          {
            "text": "After disimpaction, take 1–2 sachets daily ongoing; titrate to keep stool soft at least every 1–2 days. Do not stop once better.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ],
        "note": [
          {
            "text": "Prescription printed for sachets to cover 3–5 days of intensive use and at least 1 month of maintenance."
