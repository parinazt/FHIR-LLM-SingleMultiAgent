    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Carpal tunnel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right greater than left symptoms ongoing. Night paraesthesia in the right thumb, index and middle fingers most nights, waking the patient 3–4 times per week. Tingling with typing or phone use for more than 10–15 minutes. Volar right wrist ache in the evening. Mild clumsiness with buttons; no clear dropping of objects."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Focused right wrist and hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thenar wasting or deformity. Sensation to light touch reduced at the tips of the right index and middle fingers compared with the ulnar side. Tinel, Phalen and Durkan tests positive on the right and negative on the left. Thumb abduction 5/5 bilaterally; grip okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
