      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports shortness of breath walking from the lounge to the clothesline (about 20–30 m) and on 5–6 stairs; needs to stop to catch his breath. Wife says he is more short of breath than he lets on."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Shortness of breath at rest"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Orthopnea and paroxysmal nocturnal dyspnea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies orthopnea and paroxysmal nocturnal dyspnea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough, especially at night, described as a bit of a tickle. Denies sputum and haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Chest discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild diffuse anterior chest ache, described as like a pulled muscle from coughing. Denies pleuritic pain, radiation, diaphoresis, nausea, and vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels a bit washed out and naps in the afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Symptoms since hospital discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, chills, and rigors. Appetite slightly decreased but improving; weight stable by report."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Reported leg, calf, and neurologic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg swelling, calf pain, dizziness, syncope, and confusion; wife agrees."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "General appearance and work of breathing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin elderly man, stoic, speaks in full sentences; mildly increased work of breathing when talking for a long time, with no distress at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Chest expansion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symmetric."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vesicular breath sounds, reduced at the bases. Fine end-inspiratory crackles at both bases, left greater than right. No wheeze or focal consolidation signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur. JVP not elevated. No peripheral oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Calf examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Calves soft and non-tender; no erythema or swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
