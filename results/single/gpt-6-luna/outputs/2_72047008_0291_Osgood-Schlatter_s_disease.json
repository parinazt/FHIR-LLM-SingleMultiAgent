        "code": {
          "text": "Intermittent anterior knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 12–18/12 duration; right much worse than left; gradual onset in mid Year 11 during a growth spurt; aching and localized to the tibial tuberosity; increased with running, jumping, kneeling, and stairs; settles with rest and overnight."
      }
    },
