    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported jaw pain and facial swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache with swelling of both cheeks under the ears, progressing from left-sided to bilateral; pain worse with chewing, especially sour foods."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Subjective fevers and chills during the first 1–2 days; decreased energy, mild headache, and decreased appetite."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
