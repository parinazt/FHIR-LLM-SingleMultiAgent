        "code": {
          "text": "Trigger finger, right ring finger (stenosing tenosynovitis)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ring finger symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4–5/12 history of pain and locking, especially in the morning; stiffness lasts 10–15 minutes then eases. Finger catches and clicks/pops, particularly with flexion to extension."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ring finger pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain up to 7/10; patient says it is “only a bit sore”."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Factors aggravating right ring finger symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with long days of paperwork, phone use, and lifting grandchildren."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right ring finger locking and straightening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sometimes needs the left hand to straighten the right ring finger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
