        "medicationCodeableConcept": {
          "text": "Methylprednisolone aceponate 0.1% fatty ointment (Advantan)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer perianally once nightly for 2–3 weeks, up to a maximum of 4 weeks, then cease. May use short courses as needed if symptoms recur.",
            "route": {
              "text": "Topical, perianal"
            },
            "timing": {
