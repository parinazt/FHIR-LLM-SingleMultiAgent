    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic pain for 2–3 days. Began after getting up from a desk and feeling the knee was 'funny'. Mild anterior/medial ache, approximately 3/10, especially on stairs and after sitting then standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right knee function and reported examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full weight bearing and walking are okay; still at work but avoiding the gym. Patient reports full flexion and extension, near-full squat with mild anterior discomfort, and ache only when hopping on the right leg."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right knee appearance and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No video inspection was performed. Patient reports the right knee looks visually normal, with no deformity or obvious effusion and looking the same as the left. Denies trauma, twisting, fall, blow, popping, swelling, redness, warmth, locking, giving way, catching, or true instability."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported systemic and other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, night sweats, weight loss, night pain, calf pain, shortness of breath, and pleuritic chest pain. No systemic symptoms by history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Anal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fluctuating anal itch for approximately 6–8 months, in the evenings and after bowel movements, worse with sweating and stress. Overcleans with soap, loofah, and fragranced wipes; scratches especially at night and is sometimes sore."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Anal symptoms and reported relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies bleeding on paper, prolapse, mucus, significant pain, perianal discharge, blisters, or weeping. Reports no history of psoriasis or eczema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels 1–2 times daily, usually formed and occasionally slightly loose when anxious. Denies true diarrhoea, constipation, and straining."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telehealth presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice coherent; speaking in full sentences; anxious but settled."
      }
    },
