    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Lower-limb pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Femoral pulses palpable bilaterally, left greater than right; no definite bruit (clinic noisy). Popliteal pulses difficult to assess bilaterally. Dorsalis pedis absent on right and very weak on left. Posterior tibial absent on right and weak, possibly monophasic, on left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Right lateral forefoot ulcer dimensions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "component": [
          {
            "code": {
              "text": "Length"
            },
            "valueQuantity": {
              "value": 1.5,
              "unit": "cm"
            }
          },
          {
            "code": {
              "text": "Width"
            },
            "valueQuantity": {
              "value": 1.0,
              "unit": "cm"
            }
          }
        ],
        "note": [
          {
            "text": "Near the fifth metatarsophalangeal joint; depth to dermis. Started approximately 10–12 weeks ago after knocking foot on bed frame and developing a small split; slowly increased in size and depth."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Right lateral forefoot ulcer appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Punched-out edges, pale base with yellow slough, minimal serous ooze, and surrounding pale, slightly shiny skin. No significant erythema or warmth, no malodour, no exposed bone or tendon, no fluctuance, and no tracking cellulitis."
      }
    },
