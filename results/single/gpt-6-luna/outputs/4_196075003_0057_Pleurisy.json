        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea. Denies thunderclap onset or 'worst ever' headache, focal neurological symptoms, visual loss, speech change, collapse, seizure, fever, neck stiffness, photophobia, rash, or morning vomiting. No migraine history reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
