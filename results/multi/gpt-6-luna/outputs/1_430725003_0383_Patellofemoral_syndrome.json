          "text": "Left knee tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Peripatellar and retropatellar tenderness; no medial or lateral joint line tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
