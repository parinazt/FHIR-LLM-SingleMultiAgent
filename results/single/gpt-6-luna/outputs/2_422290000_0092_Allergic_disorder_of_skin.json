        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer once daily to the face only when red or itchy, for up to 7 days only; otherwise use moisturiser and a gentle non-soap cleanser.",
