        "code": {
          "text": "Right foot and toe symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right toes, especially the great and second toes, feel cold and tingle somewhat at night; toes are a little sore after being on them a lot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
