          "text": "Sinus and eye red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No severe unilateral headache, visual symptoms, eye pain, periorbital swelling, fever, epistaxis, or neck stiffness."
      }
    },
    {
