        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and conversant. Cranial nerves II–XII intact; fundi without papilloedema and discs sharp; power 5/5 in all limbs; tone, reflexes, coordination, and gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
