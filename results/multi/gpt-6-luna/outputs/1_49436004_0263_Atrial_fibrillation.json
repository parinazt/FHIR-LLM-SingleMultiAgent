    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 7–10 days ago, with no specific injury. Dull ache across the belt line, occasionally sharp with twisting; worse getting out of bed, standing, and walking for more than a few minutes; eased by sitting and leaning forward on the walker. Pain up to 7/10 at worst and currently approximately 4/10 after morning paracetamol."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain-associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no leg radiation, numbness, tingling, weakness, saddle anaesthesia, bowel or bladder incontinence, or retention. No recent falls; baseline four-wheel walker use unchanged. Sleep somewhat disturbed by pain when turning in bed; pain is initially worse on lying then settles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, chills, night sweats, or reported weight change; appetite is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Cardiorespiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline exertional shortness of breath after more than 20–30 m, unchanged. Baseline cough; no haemoptysis. No chest pain, orthopnoea, paroxysmal nocturnal dyspnoea, or ankle swelling. Usual occasional 'flutter' is barely noticed; no increase in palpitations, recent fast heart-rate episodes, presyncope, or syncope."
      }
    },
