    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Fatigue and exhaustion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports approximately 4–5 months of progressive exhaustion and fatigue despite 7–8 hours in bed; describes feeling “running on empty.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is non-restorative. Reports difficulty switching off, especially after late shifts, and often scrolls on her phone in bed. Sleeps approximately 5–6 hours before shifts and somewhat more on days off; wakes early on work days with anticipatory anxiety."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Work-related mood and emotional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low mood mainly around work and at the end of a run of shifts; tearful after shifts. Reports being able to enjoy time with partner and friends on days off and denies global anhedonia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Irritability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased irritability and being snappy with colleagues, occasionally with patients; finds this distressing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sense of accomplishment and interest in work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports reduced sense of accomplishment (“whatever I do it’s never enough”), reduced interest in nursing, and is contemplating leaving nursing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
