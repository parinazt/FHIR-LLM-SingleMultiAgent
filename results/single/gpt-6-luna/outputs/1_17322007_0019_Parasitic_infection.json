    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset about 7 days ago; dull, band-like pressure at the temples and forehead, occasionally the occiput; non-pulsatile; severity 4–6/10. Worse late in the day after long hot kitchen shifts and late-night screen use, builds over the day and settles overnight, with no early-morning waking. Relieved by paracetamol and rest in a dark room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Headache-associated and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting, visual aura, focal neurological symptoms, speech change, sensory loss, fever, neck stiffness, rash, confusion, seizures, thunderclap onset, worst-ever headache, personality or cognitive change, visual field loss, diplopia, or jaw claudication. No recent head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Abdominal discomfort, bloating, and bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2–3 weeks: intermittent mild crampy lower abdominal discomfort and mild bloating; stool frequency 2–3 times daily, increased from baseline of once daily. No overt diarrhoea, blood, mucus, weight loss, or nocturnal symptoms. Had 2–3 days of loose stools during or after travel, self-resolved."
      }
    },
