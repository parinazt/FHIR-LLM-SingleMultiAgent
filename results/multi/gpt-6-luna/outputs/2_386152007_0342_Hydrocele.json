          "text": "Behaviour and activity change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daughter reports the patient has been more withdrawn, is not watching his usual TV, paces especially in the late afternoon, and is more fidgety for approximately 5–6 days."
      }
    },
