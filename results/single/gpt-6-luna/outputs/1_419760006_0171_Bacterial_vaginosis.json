        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No purulent nasal discharge, facial or tooth pain, anosmia, fever, rigors, cough, shortness of breath, wheeze, or chest pain. Appetite is okay; a little tired due to poor sleep."
      }
    },
