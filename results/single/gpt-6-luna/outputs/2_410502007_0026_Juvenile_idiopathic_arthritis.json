        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent fevers, night sweats, unintentional weight loss or recent infections; weight reported stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
