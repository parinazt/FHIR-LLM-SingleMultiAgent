        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Forefoot ache at night"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sometimes woken by a dull ache in the forefoot, right greater than left; improves when the leg is dangled off the bed. No frank rest pain all night."
      }
    },
    {
