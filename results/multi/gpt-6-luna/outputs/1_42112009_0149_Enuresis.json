          "text": "Neurological symptom screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg weakness, numbness, saddle anaesthesia, and visual change; no other neurological symptoms volunteered."
      }
    },
    {
