        "code": {
          "text": "Right upper quadrant ultrasound finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known cholelithiasis; multiple stones; no common bile duct dilatation and no cholecystitis, as recorded in the EMR."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent colicky, gripping pain in the right upper quadrant and epigastrium radiating to the right scapula; up to 8/10, currently 2–3/10. Patient gives changing estimates of duration, from weeks to months. Possible association with fatty meals, takeaway, or coffee."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea with bad attacks; no current vomiting. No fevers or rigors. No known jaundice. Denies dark urine or pale stool but is unsure. No chest pain or shortness of breath."
      }
    },
