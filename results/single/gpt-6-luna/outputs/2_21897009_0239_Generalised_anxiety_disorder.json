    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported increase in worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 3–4 weeks, the patient reports increased worry and more difficulty keeping worry under control, mainly about health, dementia and cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Health-related worries and checking behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Frequently searches online health and symptom-checker sites, often at night; ruminates about minor bodily symptoms and fears cancer or rapidly worsening dementia. Has made multiple recent practice contacts and attended twice in person in the last month for benign issues; repeatedly sought reassurance and asked whether more tests or scans were needed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels on edge most days, has shoulder and jaw muscle tension, and fatigue by late afternoon. No panic attacks described."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes 1–2 hours to fall asleep and wakes 1–2 times overnight; often uses phone or iPad in bed to read health websites."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent low mood; describes feeling a little flat after poor sleep. Appetite is okay and weight is stable by patient report."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Cognitive and daily function report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient and daughter feel she is slightly more forgetful with dates and misplacing items. Independent in basic ADLs; needs prompting for some IADLs, especially bills, and medications are supplied in a Webster pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported intermittent symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bloating, occasional brief headaches, and prior self-limiting dizziness and indigestion. Brief awareness of heartbeat occurs when anxious. Denies chest pain, shortness of breath, and other palpitations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Targeted systems review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies weight loss, night sweats, fever, rectal bleeding, focal neurological symptoms, recent falls, and urinary symptoms. Bowels reported okay."
      }
    },
