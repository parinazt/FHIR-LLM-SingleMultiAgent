    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Headache characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports gradual onset over 3 days; dull, constant frontal and bitemporal headache, right greater than left, rated 7/10; worse in the evenings and does not wake her from sleep. Patient thinks it may be secondary to eyestrain from television and bright LED supermarket lights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap onset or 'worst ever' headache; no nausea or vomiting, photophobia or phonophobia (reports mild light sensitivity only), or visual aura. No jaw claudication, scalp tenderness, focal neurological symptoms, weakness, facial droop, speech difficulty, confusion, loss of consciousness, seizure, ataxia, neck stiffness, fever, or rigors. No recent head trauma or new medicines."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
