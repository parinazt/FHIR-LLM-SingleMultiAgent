    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Shoulder soreness for about 3 months, gradual onset without clear injury. Dull anterolateral ache with sharp twinges on some movements; wakes when rolling onto the left side and difficulty hanging washing, reaching overhead, and doing bra behind back. No neck pain, radiation past the elbow, pins and needles, or true weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over greater tuberosity/subacromial area; AC joint non-tender. Active flexion about 120 degrees and painful; abduction about 100–110 degrees with painful arc about 70–120 degrees. Internal rotation limited; unable to reach bra strap. External rotation about 45 degrees with mild pain. Passive range of motion near full with end-range pain. Jobe/empty can causes pain with mild weakness compared with right; pain on resisted external rotation. Hawkins and Neer impingement tests positive. Neck full range of motion; no radicular signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Urethral opening symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a small red lump at the urine opening for about 6–8 weeks and mild intermittent stinging at the end of urination. Two tiny spots of blood on paper last month, none since. No dysuria, frequency, urgency, visible haematuria in the bowl, vaginal bleeding, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "External genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atrophic vulval skin. Small approximately 5–6 mm soft red polypoid lesion at the posterior lip of the urethral meatus, mildly tender, not friable, with no active bleeding or pus. Appearance consistent with urethral caruncle. No obvious prolapse."
      }
    },
