    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Low back pain characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Acute left-sided low back pain for approximately 10 days, starting after lifting heavy stock boxes at work. Initially a sharp twinge, now a constant dull ache rated 4/10 at baseline with intermittent sharper pain rated 7–8/10 on flexion, twisting, and rolling in bed. Localised to the left lumbar region with no radiation below the knee."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Back pain effect on function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Pain affects ability to complete full work shifts; patient needs to sit more and avoids heavier lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported low back pain red-flag symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Patient reports no leg weakness, numbness, paraesthesia, saddle anaesthesia, bowel or bladder incontinence or retention, trauma or fall, fever, weight loss, intravenous drug use, or history of malignancy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Back inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "No deformity, bruising, or swelling. Localised tenderness to palpation and increased tone/spasm of the left paraspinal muscles approximately L3–L5. No midline bony tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Back range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Flexion and extension mildly reduced due to pain; left side flexion reproduces pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lower-limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Power 5/5 at hips, knees, and ankles bilaterally. Patellar and Achilles reflexes 2+ and symmetrical. Light-touch and pin sensation intact from L2–S1. Straight-leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mobility and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Mobilises independently and is mildly uncomfortable, especially when moving. Gait normal; heel and toe walking intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
