        "code": {
          "text": "Suspected internal haemorrhoids with prolapse and intermittent bright red rectal bleeding, likely grade II–III (code stated in note: 70153002)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Constipation and straining, associated with low fibre, reduced fluid intake, and prolonged toileting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Prolapsing tissue with bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports lumps coming out during bowel movements and manually reducing the prolapsing tissue in the shower. Present for several months, with timing described vaguely."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bright red blood on toilet paper and sometimes in the toilet bowl; not mixed with stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Perianal discomfort and itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild-to-moderate discomfort and itch, worse after multiple wipes or prolonged sitting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Bowel pattern and stool consistency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually has a bowel movement daily, with variable frequency and sometimes two bowel movements in a day. Sometimes constipated; stool is often hard at the start and then softer. Reports straining and sitting on the toilet for more than 10 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Anal pain and lump findings by history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies constant severe anal pain and denies a history of a tense, tender lump at the anal margin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other reported gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies melaena and clots. Initially said stool might be slimy, then denied mucus in stool. Denies abdominal pain and nocturnal diarrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies weight loss, fevers, shortness of breath, dizziness, and palpitations. Denies urinary symptoms and perianal discharge or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Heartburn"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reported recurrent heartburn."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth examination limitation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Telehealth only; no physical examination was possible. Haemorrhoids could not be graded and other anorectal or colorectal pathology could not be excluded without an in-person examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "History reliability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Clinician described the patient as a poor historian; timing was vague and details changed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Over-the-counter heartburn tablet; exact name unknown, possibly a proton pump inhibitor or antacid"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "As needed; dose and route not stated",
            "asNeededBoolean": true
          }
        ]
      }
    }
