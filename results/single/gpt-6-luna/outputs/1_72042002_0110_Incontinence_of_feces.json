        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Significant health anxiety pattern with reassurance seeking and catastrophising around cancer and stoma; no formal diagnosis reported"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bowel symptoms and faecal incontinence"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported 6–8 months of faecal incontinence, worse over the last 2–3 weeks. Loose stools 3–5 times daily, mostly non-bloody, with mucus sometimes. Urgency with small-volume leakage 2–3 times weekly, sometimes unable to reach the toilet; occasional later seepage and underwear soiling after a bowel movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nocturnal diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies diarrhoea waking her at night; sometimes gets up pre-emptively just in case."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No weight loss, fevers, night sweats, or appetite change. Denies PR bleeding, melaena, severe abdominal pain, nausea, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other reported red-flag symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent antibiotics, travel, or sick contacts. Denies urinary incontinence, saddle anaesthesia, leg weakness, or back trauma."
      }
    },
    {
