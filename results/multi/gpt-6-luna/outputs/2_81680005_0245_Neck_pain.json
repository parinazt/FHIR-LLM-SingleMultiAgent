    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior/medial ache described as \"like bruise under kneecap\"; onset approximately 2–3 weeks ago after lifting boxes and a big weekend. Pain 3–4/10 at baseline, up to 6/10 on stairs, especially going down. Worse with stairs, squatting, and getting up from a chair after prolonged sitting; settles with rest. No night pain and no significant morning stiffness greater than 10 minutes. No clear trauma. No previous similar episode."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left knee swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient unsure; possibly puffy in the evenings"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left knee mechanical symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true locking, giving way, or catching"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left knee weight-bearing and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fully weight-bearing and mobilising unaided"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central/right paracervical ache described as \"tight muscles\" for approximately 6 weeks, with occasional brief sharp twinge on sudden turning. Worse with prolonged desk work, looking down at phone, and driving; better with heat, stretching, ibuprofen, and lying down. Sleep a bit disturbed by waking to change position."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neck pain associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No arm pain, paraesthesia, weakness, clumsiness, gait change, bowel or bladder symptoms, or trauma"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
