        "code": {
          "text": "Heartburn"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild intermittent heartburn over the last few weeks, worse with coffee, spicy food, and lying down at night. Started an over-the-counter antacid yesterday and reports the burning behind her breastbone is a bit better."
      }
    },
    {
