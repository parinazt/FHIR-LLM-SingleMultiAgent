        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear; air entry good."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported right leg symptoms and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports increasing redness and tenderness and yellow ooze from the right shin wound over the last 3–4 days, feeling 'off' and more tired, and walking with a mild limp due to pain. Reports increased pain and swelling in the right leg over the past few days and reduced tolerance for prolonged walking, standing, and heavy work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no rigors, chest pain, shortness of breath, abdominal pain, nausea, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
