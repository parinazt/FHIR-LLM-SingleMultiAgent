        "code": {
          "text": "Throat examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throat mildly red."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal mucosa a bit boggy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bowel habit and stool"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding post-surgical constipation; usually passes stool daily or every 2 days while taking Movicol 1–2 sachets. For approximately 2 weeks has been more backed up, passing stool every 2–3 days; stools are harder but still passing. No pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Reported abdominal and bowel warning symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies abdominal distension, severe cramps, vomiting, overflow diarrhoea, and rectal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with a mild stooly feel in the left lower quadrant only; non-tender."
      }
    },
