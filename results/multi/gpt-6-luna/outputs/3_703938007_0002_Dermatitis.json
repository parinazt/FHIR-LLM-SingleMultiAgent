        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "1 g up to four times daily as needed",
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Plain emollient (e.g., soft white paraffin or sorbolene)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply twice daily and as needed to the peri-auricular area between steroid applications; avoid fragranced products"
          }
        ]
      }
    },
    {
