          "text": "Current hyperglycaemia symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies polyuria, polydipsia, confusion, and visual blurring. Reports no reliable recent weight measurement but clothes are similar."
