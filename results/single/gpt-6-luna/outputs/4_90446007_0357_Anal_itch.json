      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal discomfort and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull, non-colicky abdominal ache for 3–4 days, 3–4/10, periumbilical extending to the lower abdomen and mostly lower / generalized. Worse after large greasy meals and leaning forward; passing wind and an over-the-counter antacid help somewhat. Mild bloating and increased flatus. No nausea or vomiting; bowel motions once daily, formed, with no melaena or rectal bleeding. No dysuria, fever, weight loss, night pain, or appetite change. No recent travel or sick contacts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender throughout, with no guarding, rebound, masses, or organomegaly. Bowel sounds normal. No costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Perianal itching and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe perianal pruritus for approximately 3–4 months, gradually increasing, worse at night and after hot, sweaty shifts, and often wakes the patient scratching. Now some soreness. Reports skin thickening and small spots of blood on paper after scratching. No lumps, prolapse, mucous discharge, incontinence, visible worms, nocturnal crawling sensation, or similar symptoms in household contacts. Bowel motions once daily, formed, sometimes slightly loose after greasy food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diffuse mild circumferential erythema, lichenification, excoriations, and a few superficial linear fissures. No weeping, ulceration, blister, or purulent discharge. Small soft, non-tender skin tag at 6 o’clock. No obvious external haemorrhoids, thrombosis, warts, abscess, or fistula openings. Digital rectal examination deferred."
      }
    },
