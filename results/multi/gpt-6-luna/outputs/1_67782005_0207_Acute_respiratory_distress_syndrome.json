        "status": "final",
        "code": {
          "text": "Chest discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild diffuse anterior chest ache, described as like a pulled muscle from coughing. Denies pleuritic pain, radiation, diaphoresis, nausea, and vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
