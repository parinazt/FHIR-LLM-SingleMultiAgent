        "code": {
          "text": "Focused review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, shortness of breath, palpitations, eye redness, visual change, or urinary symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, mildly irritable but cooperative; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Hydration examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mucous membranes moist; capillary refill under 2 seconds; no postural symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild diffuse lower abdominal tenderness on deep palpation. No guarding, rebound, masses, or organomegaly. Bowel sounds mildly increased. Rectal examination not performed; patient declined."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scalp with erythematous plaques and silvery scale at the frontal hairline and occiput, extending approximately 1–2 cm beyond the hairline. Symmetrical, well-demarcated salmon-pink plaques with silvery scale and some excoriation on elbows and knees, approximately 3–4 cm; body surface area approximately 4–5%. No pustules or erythroderma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Nail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pitting of a few fingernails; no onycholysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-25",
        "status": "final",
        "code": {
          "text": "Musculoskeletal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious joint swelling, erythema, or deformity of hands, wrists, or knees. Full active range of motion; small joints non-tender today."
      }
    },
