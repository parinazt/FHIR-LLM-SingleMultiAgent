    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports red, itchy, watery eyes for approximately 6–7 days, starting on the left and involving the right over 1–2 days. Describes eyes as “scratchy and annoying” and “a bit gritty.” Reports still very red and watery; feels “maybe a tiny bit less gritty” after starting chloramphenicol drops."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Eye discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a small amount of stringy/mucoid watery discharge, especially in the morning; denies thick yellow/green pus. Exam: minimal watery discharge; no purulent crust."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Vision and visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports vision is okay for driving and reading and denies halos. Visual acuity grossly normal with near print in each eye separately; patient reports no difference between left and right."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
