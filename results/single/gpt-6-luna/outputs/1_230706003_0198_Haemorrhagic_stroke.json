    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Other ear and head and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ear normal. No mastoid tenderness or swelling. Oropharynx clear. Dentition reasonable with no obvious caries or tenderness. Mild bilateral TMJ crepitus, non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented; fluent speech; cranial nerves grossly intact, facial symmetry, extraocular movements intact and visual fields full. Mild right arm dysdiadochokinesia and slightly reduced fine finger movements versus left; right upper limb power 4+/5, 5/5 elsewhere. Normal gait; no pronator drift."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Recent stroke symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Residual very mild right arm weakness and slower fine motor function, improving with physiotherapy. Speech normal. No recurrent severe headache, new focal neurology, seizures, or loss of consciousness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
