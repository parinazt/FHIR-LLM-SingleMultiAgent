        "code": {
          "text": "Respiratory and associated symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no shortness of breath, pleuritic chest pain, wheeze, or haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other acute symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no high fevers (maximum 37.8°C at home), rigors, neck stiffness, photophobia, or gastrointestinal or genitourinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Fatigue and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased fatigue; stated that even sending an email is too much. Reports feeling worse for the last 2–3 weeks, even before the upper respiratory symptoms, and that they cannot bounce back from anything."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported ME/CFS symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports baseline fluctuating fatigue, post-exertional malaise, unrefreshing sleep, and brain fog."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
