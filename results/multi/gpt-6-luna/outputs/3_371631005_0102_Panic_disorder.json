    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent panic episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes occur 1–2 times per week, with sudden onset, peak over a few minutes, and last approximately 5–10 minutes. Symptoms include a racing heart, sweating, mild dizziness, and shortness of breath. Episodes often occur in the evenings when alone or when thinking about health or a pregnancy-related article; they can occur at rest, with no clear exertional link."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Response to breathing during episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports slow breathing helps episodes settle more quickly when remembered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
