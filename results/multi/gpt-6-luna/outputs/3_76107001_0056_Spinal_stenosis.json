    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bilateral leg pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported for 6–8 months, from thighs to calves, with worsening over the last 4–6 weeks. Aching and heavy, sometimes burning; described as feeling that the legs are going to give way."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Leg pain triggers, walking tolerance, and relief"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brought on by walking or standing. Can walk approximately 50–100 m on the flat before having to stop. Improves within 2–3 minutes of sitting or leaning forward over a trolley or bench. Can use an exercise bike for a long time with much less pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional tingling in the feet when pain is bad. No true lower back pain today; patient says their back is fine. No pain at rest and no nocturnal pain. Denies saddle symptoms, urinary retention or incontinence, and bowel symptoms. No rapidly increasing weakness, trauma, weight loss, or fevers; no known malignancy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Possible previous scan finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient recalls a possible previous comment that an old scan showed a narrow canal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Gait and walking symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cautious gait. Symptoms reproduced on a short walk at clinic and improved quickly when leaning forward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tone normal. Power 5/5 in all groups. Knee jerks 2+ and ankle jerks 1+, symmetrical. Light-touch and pinprick sensation intact L2–S1. Straight-leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No midline tenderness. Extension reduced due to discomfort; flexion okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Lower limb vascular and calf examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsalis pedis and posterior tibial pulses palpable bilaterally. Feet warm; capillary refill under 2 seconds. No ulcers, oedema, or calf tenderness or swelling."
      }
    },
    {
