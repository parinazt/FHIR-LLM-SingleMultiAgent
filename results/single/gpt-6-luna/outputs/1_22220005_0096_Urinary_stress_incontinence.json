        "code": {
          "text": "Urinary leakage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing small-volume leakage with coughing, sneezing, lifting, and laughing; clear stress pattern. No urgency or urge incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Suprapubic sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports mild, intermittent, non-radiating pressure or tenderness above the pubic bone for approximately one week, with no clear trigger. No suprapubic tenderness was reproduced on superficial or deep palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urinary frequency and nocturia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Frequency approximately 5–6 times daily at baseline, with no increase. Nocturia 0–1 times nightly, longstanding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported urinary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, frank haematuria, malodorous urine, fever, rigors, flank pain, nausea, or vomiting."
      }
    },
    {
