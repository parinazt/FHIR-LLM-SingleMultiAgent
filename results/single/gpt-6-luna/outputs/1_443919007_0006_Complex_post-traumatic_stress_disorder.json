        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Reports reduced concentration at work, drifting off and becoming stuck in thoughts; grossly intact cognition with some difficulty maintaining focus on longer questions."
      }
    },
    {
