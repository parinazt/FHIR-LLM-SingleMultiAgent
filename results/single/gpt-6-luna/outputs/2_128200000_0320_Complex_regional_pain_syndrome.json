    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burning and tingling pain, baseline about 5/10 and up to 8/10 after work shifts; worse after the foot is down for long periods at work and a bit better with elevation and cool packs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right foot skin sensitivity and sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 3–4 weeks, the skin is very tender and feels like it is on fire when brushed, even by a sheet. Cannot keep a sock on for long. Sheet contact sometimes disturbs sleep, 2–3 nights per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported dizziness after morning pregabalin dose"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild wooziness for 30–45 minutes after the morning dose; tolerable, with no falls."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Frustrated but coping; denies low mood and suicidal thoughts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Work function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Working about 20–25 hours per week on her feet; standing on a hard floor all day aggravates symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated symptoms and trauma history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new trauma, fever, back pain, radicular symptoms, or red-flag neurological symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and right foot guarding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and is a bit guarded with the right foot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
