      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Patient-reported abdominal examination by telehealth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Self-palpation: maximum tenderness in the right lower quadrant compared with other quadrants; release after pressing was described as very painful, possible rebound. Patient reported being too sore to stand up straight. Hop test not attempted because of pain. Examination was limited to telehealth."
      }
    },
    {
