    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic right knee pain for 2–3/7. Began after getting up from a desk and feeling the knee was “funny”. Mild anterior/medial ache, especially on stairs after sitting then standing; pain approximately 3/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right knee associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full weight-bearing and walking are okay; avoiding the gym. No trauma, twist, fall, blow, or pop. No swelling, redness, or warmth; patient reports the knee looks the same as the left. No locking, giving way, catching, or true instability. No fever, night sweats, weight loss, night pain, calf pain, shortness of breath, or pleuritic chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right knee function and reported appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On telehealth, no video inspection was done. Patient reports the right knee is visually normal, with no deformity or obvious effusion. Full flexion and extension reported. Can nearly fully squat with mild anterior discomfort and can hop on the right leg with ache only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fluctuating anal itching for approximately 6–8/12, worse in the evenings and after bowel movements, with sweating and stress. Overcleaning with soap, a loofah, and fragranced wipes; scratching, especially at night, sometimes causes soreness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Anal and bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No bleeding on paper, prolapse, mucus, significant pain, perianal discharge, blisters, or weeping. Bowel movements 1–2 times daily, formed, occasionally slightly loose when anxious; no true diarrhoea, constipation, or straining."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Telehealth presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice coherent; speaking in full sentences. Appeared anxious but settled. No systemic symptoms by history."
      }
    },
