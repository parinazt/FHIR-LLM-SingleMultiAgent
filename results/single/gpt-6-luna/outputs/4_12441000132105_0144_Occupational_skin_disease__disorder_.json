              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Localised contact urticaria pattern at glove edge; possible latex or rubber chemical allergy, not confirmed"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
