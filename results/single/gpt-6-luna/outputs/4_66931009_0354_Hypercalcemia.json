        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported symptoms and pertinent negatives related to hypercalcaemia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased thirst and frequency, but no polyuria greater than 3 L/24 hours, confusion, abdominal pain, constipation, nausea, or vomiting. Mild nonspecific fatigue. No reported significant dehydration, arrhythmia, or severe abdominal pain."
      }
