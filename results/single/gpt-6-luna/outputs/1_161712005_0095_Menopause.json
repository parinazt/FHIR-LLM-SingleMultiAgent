        "code": {
          "text": "Sleep disturbance, multifactorial; likely secondary to menopausal vasomotor symptoms, health anxiety, and poor sleep hygiene"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Menopause, postmenopausal for approximately 14 months, with moderate-to-severe vasomotor symptoms"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Genitourinary syndrome of menopause (GSM), including vaginal dryness, dyspareunia, and nocturia; may contribute to recurrent UTIs"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-4",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-4",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Health anxiety / anxiety disorder, longstanding and exacerbated by menopause and chronic poor sleep"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-5",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-5",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Recurrent uncomplicated E. coli UTIs, three in the past 12 months; currently asymptomatic"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep disturbance history and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep for approximately 9–12 months, worse over the last 3–4 months. Difficulty falling asleep, taking 60–90 minutes; wakes 3–4 times on most nights, often drenched in sweat. Averages 4–5 hours of fragmented, unrefreshing sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Vasomotor symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime hot flushes and night sweats, described as a wave of heat from chest to face."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Effects of poor sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased fatigue, irritability, and reduced concentration, especially at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Health-related worries"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked worry that poor sleep may cause a heart attack or cancer; frequent online searching about menopause, obstructive sleep apnoea, and dementia; worried that her brain will shrink and requests a brain scan."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and safety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports not feeling low most days; feels frayed and is more tearful when very tired. Still enjoys work and family; denies anhedonia and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vaginal and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vaginal dryness and dyspareunia for approximately one year. Gets up 1–2 times nightly to urinate. Currently denies dysuria, haematuria, and urgency."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported sleep-disorder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring, witnessed apnoea, or waking choking. Patient denies restless legs symptoms. No red flags for obstructive sleep apnoea or another sleep disorder noted today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period approximately 14 months ago; no postmenopausal vaginal bleeding since."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Sleep-related habits and previous aids"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually goes to bed around 22:30–23:00, reads about symptoms in bed and checks her phone overnight. Drinks 2–3 cups of coffee in the morning only and 1–2 glasses of wine on 3–4 nights per week to wind down. Tried Restavit a few times and felt groggy; has also tried herbal teas and mindfulness apps and reduced coffee after 10 am."
      }
    },
