        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Congenital red-green colour vision deficiency"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Forearm rash on examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: patchy erythematous papular rash over the extensor surfaces of both forearms, right greater than left. No obvious vesicles, crust, pus, or significant swelling. Hands and palms spared. Looks non-infected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Forearm rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash on both forearms for approximately 10 days. Still itchy but a bit better; worse after work and in the evenings. No pain, fever, blisters, or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin stinging with soap"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports that the soap really stings if left on."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported rash color change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wife reports the rash has gone from red to more brown. Patient has congenital red-green colour vision deficiency and struggles to tell whether the rash is redder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "General appearance during telehealth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no apparent distress, talking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long-standing colour vision deficiency; no acute change and no new visual symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Tiredness and headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports tiredness and headaches after long hot days; asked to book a separate appointment if ongoing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected areas twice daily for 5–7 days, then once daily as settling; maximum 2 weeks without review. Avoid face, groin, and broken skin.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "unknown",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "10 mg at night as needed for itch; patient will use only if itch affects sleep.",
            "asNeededBoolean": true,
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
