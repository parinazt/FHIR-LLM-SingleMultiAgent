        "status": "final",
        "code": {
          "text": "Generalised muscle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing flare over the last 2–3 weeks, with increased pain in the neck, shoulders and upper back and occasional low back pain. Dull ache with intermittent sharp twinges; worse at the end of the workday and after long periods at the computer."
      }
    },
