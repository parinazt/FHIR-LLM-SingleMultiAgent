          "text": "Sebaceous (epidermoid) cyst of the upper back"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Upper back lump, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Noticed a little bump approximately 12–18/12 ago; gradual increase in size, now catching on high-visibility clothing and harness at work. Mild discomfort only when leaning on a hard chair or when the tool belt rubs; otherwise no pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Upper back lesion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mid upper back just left of midline, approximately T4–5: approximately 2.2 cm dome-shaped subcutaneous nodule with normal overlying skin and a small central punctum. Firm and mobile over deeper tissues. Non-tender to light palpation, with mild discomfort on deep pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Local lesion findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No surrounding erythema, warmth, induration, fluctuance, or discharge. No ulceration or pigment change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, chills, night sweats, weight loss, or fatigue. No other new or changing skin lesions noticed, no numbness or tingling over the lesion, and no restriction of shoulders or back. No similar lesions previously."
      }
    },
