    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep duration and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports reduced sleep onset and maintenance for approximately 3 months, worse over the last 4–6 weeks. Lies awake for 1–2 hours, wakes 2–3 times nightly, and gets approximately 4–5 hours of broken sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep schedule and sleep environment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bedtime varies from 22:30 to 01:00; gets up at 06:00. Uses screens and watches TV in bed, and sometimes falls asleep on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 3–4 coffees daily, last at approximately 16:00–17:00, and occasional energy drink."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Alcohol intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 1–2 glasses of wine on 3–4 nights per week to wind down; reports sleep remains poor."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Night-time worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports worrying about work at night and that her brain will not switch off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
