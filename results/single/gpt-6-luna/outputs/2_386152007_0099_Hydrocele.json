    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left scrotal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache and dragging in the left hemiscrotum for 3–4 days, worse after standing all day at work. Swelling has been present for months and now feels slightly larger and more uncomfortable. No sudden severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea or vomiting, abdominal pain, dysuria, urinary frequency, haematuria, penile discharge, fevers, rigors, weight loss, and night sweats. No trauma or increase in lifting beyond usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Patient-reported groin and gait changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient noticed no obvious groin lump extending into the canal and no cough impulse. Partner reports he has been guarding the groin and walking differently for the last 2 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Partner-reported change in behavior"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports the patient has been “not himself” for 3–4 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Patient-reported mood and stress"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit on edge and cranky, especially in the evenings after work; thinks this is probably because the scrotum is sore and annoying. Denies low mood and anxiety; reports no new stressors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and interaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well, talks clearly, and was calm and cooperative during the consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Inguinal and femoral hernia examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable inguinal or femoral hernia on cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Left scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum enlarged and smooth, without erythema. Fluctuant, non-tender swelling around the left testis that transilluminates strongly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left testis palpable within the swelling but difficult to delineate fully; feels normal where palpable, with no discrete lump. Right testis normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Additional scrotal and groin examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No epididymal tenderness, palpable varicocele, increased warmth, or inguinal lymphadenopathy. No features suggesting acute torsion today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, and coherent. Mood described as a bit irritable; affect appropriate. No psychotic features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Other examination finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Foreskin retracts; no obvious penile issues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Assessment of associated behavioral change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appears temporally related to increased scrotal discomfort and some sleep disruption. No current evidence of primary psychiatric illness, delirium, substance issue, or systemic infection."
      }
    },
