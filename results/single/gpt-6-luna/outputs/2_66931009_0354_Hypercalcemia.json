      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported rash and pruritus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly itchy red patches on the upper chest and upper back for approximately 10–14 days; intermittent itch worsens with heat and sweat. Over-the-counter aloe provides partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple poorly demarcated erythematous maculopapular patches, 1–3 cm, on the upper anterior chest and upper back, with mild excoriations. No scale, vesicles, target lesions, purpura, or nodules. No facial or oral involvement."
      }
    },
    {
