        "status": "final",
        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress; talkative and tangential, needed refocusing several times"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Neck inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal alignment, no deformity. Increased tone and tenderness to palpation of upper trapezius and paracervical muscles, right greater than left. No midline cervical spine tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
