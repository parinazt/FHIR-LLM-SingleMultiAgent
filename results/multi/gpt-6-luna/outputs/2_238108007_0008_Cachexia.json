        "code": {
          "text": "Back inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alignment normal; no deformity or bruising. Markedly decreased paraspinal muscle bulk and mild lower lumbar paraspinal tenderness. No focal bony point tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
