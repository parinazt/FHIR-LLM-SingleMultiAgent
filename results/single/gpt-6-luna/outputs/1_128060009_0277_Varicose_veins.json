    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right medial calf pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain over a red, tender cord along a known varicose vein; pain was initially increasing over 2–3 days and is now stable or slightly better, especially with elevation and PRN paracetamol. Pain is 6/10 when walking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right medial calf symptom duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms began 7 days ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right calf cord appearance and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes a lumpy rope under the skin. Examination: 7–8 cm firm tender cord in the mid-distal right medial calf along a varicose vein, with an approximately 3 cm band of erythema and warmth. Not fluctuant; no pus; skin intact. No palpable proximal extension to knee or thigh and no groin tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right calf itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Bilateral varicose veins"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prominent tortuous varicose veins along the great saphenous vein territory bilaterally, right greater than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Leg swelling and oedema"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant calf swelling away from the affected area; right and left calf sizes approximately equal, with no generalised oedema. Mild pitting oedema at the left ankle."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left medial malleolus skin"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Healed hyperpigmented scar consistent with a previous venous ulcer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bilateral chronic venous skin changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic venous skin changes bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Peripheral pulses and foot perfusion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsalis pedis pulses diminished bilaterally; posterior tibial pulses hard to palpate. Feet warm; capillary refill approximately 3 seconds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Claudication symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent calf ache on longer walks and walking is limited by leg discomfort; no rest pain. Mobility is somewhat reduced, but the patient continues to walk shorter distances."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Neurological examination of lower limbs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grossly intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Associated and negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever or rigors; no chest pain, shortness of breath, palpitations, or haemoptysis. No current leg wounds, ooze, or spreading cellulitis. No weight loss, night sweats, or anorexia."
      }
    },
