        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tired for 2–3 months; still working part-time and managing activities of daily living, but feels wiped out after work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Morning stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hands and knees stiff for 15–20 minutes most days; improves once moving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Joint symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports joints are currently “not too bad” and no overt swelling. Examination: hands, knees and ankles without synovitis, warmth, effusion or tenderness to palpation; full range of motion and normal gait."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
