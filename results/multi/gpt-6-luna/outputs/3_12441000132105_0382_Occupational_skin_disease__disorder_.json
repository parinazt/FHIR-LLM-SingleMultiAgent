        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Mometasone furoate 0.1% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to hands, wrists, forearms and elbows at night for 7–10 days, then on alternate nights for 1 week, then stop. Maximum once daily; do not use continuously for more than 2 weeks. Avoid face and groin. Continue emollient.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ],
