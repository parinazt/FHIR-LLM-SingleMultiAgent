    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes shoulder as “just a bit weak and a bit sore nothing to fuss about.” Dull ache in the lateral right shoulder and upper arm, increased with reaching overhead or out to the side. Night pain, especially lying on the right side, wakes her a few times per week. No trauma, fall, or heavy lifting; possible overreach into a cupboard."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right arm weakness and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports arm is more weak than painful and reduced power when lifting a jug or shopping; struggles above shoulder height and uses the left hand to assist. Dressing (bra and jumper), washing hair, and hanging washing are slower; avoids overhead tasks but remains independent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Red flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain, radicular symptoms, paraesthesia, weight loss, fevers, night sweats, or cancer history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Older lady, stoic and possibly under-reporting discomfort; mild guarding of the right shoulder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right shoulder inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild reduction in supraspinatus and infraspinatus bulk compared with the left. No deformity or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right shoulder palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender over the greater tuberosity and anterolateral shoulder; acromioclavicular joint non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction approximately 70° and flexion approximately 90°, limited by pain and weakness. External rotation painful. Passive range of motion near full with mild end-range pain; no capsular pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Shoulder power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right versus left: abduction 3/5 with pain; external rotation 3–4/5 with pain; internal rotation 4/5 on the right. Left shoulder power 5/5 throughout."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right shoulder special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Jobe test positive with painful weakness; resisted external rotation positive; Hawkins positive; Neer positive; lift-off mildly weak; O’Brien equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Neurological and vascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; pulses present; capillary refill under 2 seconds; sensation C5–T1 intact; reflexes symmetrical. No new focal neurological deficit."
      }
    },
    {
