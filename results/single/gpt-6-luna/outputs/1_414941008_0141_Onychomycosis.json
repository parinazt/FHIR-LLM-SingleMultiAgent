    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported lower abdominal discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three-day history of lower abdominal discomfort, worse last night; dull ache across the lower abdomen, intermittent, 4–5/10, non-colicky and non-radiating. No clear trigger or relation to meals; patient wonders whether excess coffee or a meat pie eaten two days earlier contributed. Pain did not wake the patient from sleep. Some relief after taking two Panadol last night. Able to work, with some discomfort bending and lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal symptoms and bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels open daily with formed stools. Denies diarrhoea, constipation, PR blood, mucus, melaena, nausea, vomiting, dyspepsia, heartburn and regurgitation. Appetite is okay; denies anorexia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported urinary and genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, urgency, haematuria, flank pain and testicular pain. Denies trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported systemic symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, weight loss and night sweats. Denies recent overseas travel, sick contacts or antibiotics. No previous similar episodes. Reports no history of IBD, IBS, gallstones, renal stones, hernias or abdominal surgery."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported toenail changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thick yellow toenails for a couple of years, slowly increasing and mainly affecting the great toes. Nails are crumbly and cosmetically bothersome. No current pain, redness, swelling or discharge. Intermittently tried over-the-counter athlete's foot cream; has not used nail lacquer. Denies history of psoriasis, dermatitis or nail trauma. Patient thinks changes may be from work showers."
      }
    },
