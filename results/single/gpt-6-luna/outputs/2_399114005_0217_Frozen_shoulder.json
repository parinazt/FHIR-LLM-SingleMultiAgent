    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports gradual-onset headache for 3 days: dull, constant, frontal and bitemporal, right greater than left, severity 7/10, worse in the evenings and not waking her from sleep. No thunderclap onset and not described as the worst ever. Patient thinks it may be due to eyestrain from television and bright LED supermarket lights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting, photophobia or phonophobia; mild light sensitivity reported, no visual aura. No jaw claudication or scalp tenderness. No focal neurological symptoms, weakness, facial droop, speech difficulty, confusion, loss of consciousness, seizure or ataxia. No neck stiffness, fever or rigors. No recent head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Glasgow Coma Scale"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 15
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented. Cranial nerves II–XII grossly intact; visual fields full to confrontation, pupils equal and reactive, extraocular movements intact, no nystagmus. Face symmetrical; speech normal with no dysarthria or aphasia. Motor 5/5 in all limbs except left shoulder movement limited by pain and stiffness; no other focal weakness. Light-touch sensation intact. Finger-to-nose and heel-to-shin intact. Gait normal, no ataxia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neck, scalp, temporal arteries and jaw examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No meningism; full neck flexion without pain. Scalp non-tender; no temporal artery tenderness or thickening. Jaw opening painless."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing left shoulder stiffness and pain for approximately 8–9 months. Patient cannot lift the arm to comb her hair or hang washing; sleep is disturbed because she cannot lie on the left side. Reports previous physiotherapy made it worse and was stopped."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Diffuse anterolateral tenderness. Globally reduced active and passive range of motion, especially external rotation and abduction; internal rotation also reduced. Pain at end range. No focal bony tenderness over clavicle, AC joint or humeral head."
      }
    },
