      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Scalp hair loss history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alopecia of the scalp for approximately 4–5 weeks. First patch on the left parietal scalp, approximately 2 cm; a smaller right occipital patch appeared 1–2 weeks later. Gradual increase in size."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms and hair loss history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, itch, burning, scale, redness, or pustules. Hair loss limited to the scalp; no eyebrow, eyelash, or body hair loss. No systemic symptoms, recent febrile illness, COVID, or weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Scalp examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two discrete non-scarring alopecia patches: left parietal approximately 2.5 cm, smooth with normal colour; right occipital approximately 1.5 cm. No erythema, scale, pustules, or broken hairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Scalp dermatoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief examination showed exclamation mark hairs at the margin of the left patch and yellow dots; no scarring."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eyebrows and eyelashes within normal limits. Nails within normal limits, with no pitting. Thyroid normal. No vitiligo or eczema on exposed skin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General and mood examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, mildly anxious and clock-watching. Mood appropriate; no suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Work stress and headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports high work stress and long shifts. Briefly mentioned frequent stress headaches from work; advised to book a separate longer appointment if ongoing."
      }
