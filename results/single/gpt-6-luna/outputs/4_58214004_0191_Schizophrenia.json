    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Dietary pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports trying to eat better after a television discussion about diabetes; still eats a lot of takeaway, skips breakfast, has reduced soft drinks somewhat (now has them when watching football rather than at breakfast), and mostly eats white bread. No known diabetes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Physical activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No structured exercise; occasional walk to Centrelink and back."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Tobacco use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heavy smoker, approximately 1 pack per day. Patient says smoking calms him down and is not ready to quit; willing to consider having half a pack on some days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported auditory experiences and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports voices are present but like background radio. Describes mood as pretty steady or alright, sometimes a bit flat. Low motivation and mostly stays home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mental state examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Via video: casually dressed and a bit dishevelled; talkative, tangential and cooperative, requiring constant redirection; mildly restricted affect; thought form not grossly disorganised. Reality testing described as okay; no delusions voiced. Insight partial; accepts need for depot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Suicidal, self-harm, and homicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation and self-harm when asked clearly; no suicidal or homicidal ideation documented."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
