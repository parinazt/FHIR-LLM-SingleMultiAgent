    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Midline and paraspinal neck pain extending into the right shoulder, rated 4–7/10; worse at the end of the workday, while sitting at a computer, and while driving. Neck pain interrupts sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Intermittent limb heaviness and altered motor sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a shaky, clumsy, or heavy feeling, right arm greater than left, sometimes involving the right leg. Episodes last minutes to 1 hour and occur several times per day. She remains able to type and lift light objects, but says the limb feels off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Intermittent tingling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tingling in the right forearm and hand, not clearly dermatomal. Denies numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occipital headaches a few times per week since the crash, associated with neck stiffness; no red-flag headache features volunteered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working full-time, but slower with typing and avoiding heavier lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender lower cervical spine and paraspinal muscles with increased trapezius tone. Mildly reduced range of motion in all directions due to pain. No deformity or step."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 throughout with no drift; tone normal; reflexes 2+ and symmetrical with no clonus. Sensation intact to light touch and pinprick; patient reports the right forearm sometimes feels a bit funny, but there is no objective sensory deficit. Coordination normal on finger-to-nose and heel-to-shin testing. Gait, including tandem gait, normal. Hoffmann's and Babinski signs negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cervical myelopathy or focal radiculopathy signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No signs of cervical myelopathy or focal radiculopathy on today's examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Bowel, bladder, and saddle symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia and bowel or bladder change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and walks unaided."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Concern and recall"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Preoccupied with possible nerve damage, repeats questions, and has poor recall of prior advice and medications."
      }
    },
