        "code": {
          "text": "Eye strain and frontal/ocular ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild eye strain and frontal/ocular ache by the end of the workday, about 3–4/7."
      }
    },
    {
