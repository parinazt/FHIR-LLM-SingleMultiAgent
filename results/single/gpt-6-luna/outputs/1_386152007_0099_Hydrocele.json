    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left scrotal symptoms, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left scrotal swelling present for months, previously described as a hydrocele, now feels slightly larger and more uncomfortable. Dull ache/dragging in the left hemiscrotum for 3–4 days, worse after standing all day at work. No sudden severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting, abdominal pain, dysuria, urinary frequency, haematuria, urethral discharge, fever, rigors, weight loss, night sweats, trauma, or increase in lifting beyond usual. Patient noticed no obvious groin lump into the canal or cough impulse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Partner-reported behavioural change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports the patient has been “not himself” for 3–4 days, guarding the groin and walking unusually for 2 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Patient-reported mood and stress"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient feels “a bit on edge and cranky,” especially in the evenings after work. Denies low mood and anxiety; reports no new stressors. Thinks this is probably because the scrotal symptoms are sore and annoying."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance and interaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well, talks clearly, and was calm and cooperative in the consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Inguinal and femoral hernia examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable inguinal or femoral hernia on cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum enlarged and smooth, without erythema. Fluctuant, non-tender swelling around the left testis, strongly transilluminating. Left testis palpable within but difficult to fully delineate; normal where felt, with no discrete lump. Right testis normal. No epididymal tenderness, palpable varicocele, increased warmth, or inguinal lymphadenopathy. No features suggesting acute torsion today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, coherent. Mood described as “a bit irritable”; affect appropriate. No psychotic features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Penile examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Foreskin retracts; no obvious issues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Testicular cancer concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient asked whether he should be worried about cancer; partner is concerned about testicular cancer risk and possible delayed presentation. Clinician assessed risk as still low, noting that the hydrocele obscures examination."
      }
    },
