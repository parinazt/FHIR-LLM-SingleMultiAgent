      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Multifactorial sleep disturbance, likely secondary to menopausal vasomotor symptoms, health anxiety, and poor sleep hygiene"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Menopause, postmenopausal with 14 months of amenorrhoea and moderate-to-severe vasomotor symptoms"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Genitourinary syndrome of menopause (vaginal dryness, dyspareunia, and nocturia; possible contribution to recurrent UTIs)"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-4",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-4",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Health anxiety / anxiety disorder, exacerbated by menopause and chronic poor sleep"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-5",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-5",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Recurrent uncomplicated urinary tract infections in the past 12 months, currently asymptomatic; likely related to genitourinary syndrome of menopause"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep for approximately 9–12 months, worse over the last 3–4 months. Takes 60–90 minutes to fall asleep and wakes 3–4 times per night on most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep duration and quality"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Averaging approximately 4–5 hours of fragmented sleep and feels unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Hot flushes and night sweats"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime hot flushes and night sweats, described as a 'wave of heat chest to face'; often wakes drenched in sweat."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last period approximately 14 months ago; no post-vaginal bleeding since."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Daytime effects of poor sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased fatigue, irritability, and reduced concentration, especially at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep-related health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very worried that poor sleep could cause a heart attack, cancer, or dementia; reports reading that her brain will shrink and requests a brain scan."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
