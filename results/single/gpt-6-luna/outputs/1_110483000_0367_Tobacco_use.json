        "status": "final",
        "code": {
          "text": "Cigarette use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Smokes approximately 20–25 cigarettes per day for approximately 30 years."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
