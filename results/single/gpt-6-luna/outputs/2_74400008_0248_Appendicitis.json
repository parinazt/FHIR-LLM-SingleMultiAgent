    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "36–48 hours of pain, initially vague and periumbilical, now localised to the right iliac fossa/right lower quadrant. Constant ache with sharp twinges on movement or coughing. Pain 7/10 on movement today and about 4/10 yesterday; worse with walking, coughing, and speed bumps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present since yesterday morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denied."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
