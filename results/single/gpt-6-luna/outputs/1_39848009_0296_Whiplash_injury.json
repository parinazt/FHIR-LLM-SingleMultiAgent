        "code": {
          "text": "General appearance and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and walks unaided."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender lower cervical spine and paraspinal muscles, increased trapezius tone, and mildly reduced range of motion in all directions due to pain. No deformity or step."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 throughout with no drift; tone normal; reflexes 2+ and symmetrical with no clonus; sensation intact to light touch and pin, with patient reporting the right forearm sometimes feels a bit funny but no objective deficit; coordination normal on finger-nose-finger and heel-shin testing; gait and tandem gait normal; Hoffmann's and Babinski negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Assessment of cervical myelopathy and focal radiculopathy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No signs of cervical myelopathy or focal radiculopathy today; no evidence of cord or nerve-root compression at present."
      }
    },
