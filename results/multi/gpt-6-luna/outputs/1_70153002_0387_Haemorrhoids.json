          "text": "Anal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe, constant, throbbing anal pain with sudden onset 3–4 days ago after hard stool and straining; worse with bowel movements and sitting, described as “like I’m sitting on a marble.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
