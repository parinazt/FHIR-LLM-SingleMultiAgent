              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Health anxiety with excessive cancer worry, repeated breast checking, and reassurance seeking"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left breast cyst size on ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 9,
          "unit": "mm"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left breast ultrasound findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported simple cyst in the left upper outer quadrant: anechoic with a thin wall and no solid components or internal echoes. No abnormal axillary nodes. Right breast reported as NAD. BI-RADS 2; radiologist recommended no further imaging."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Breast pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent ache around the left breast cyst, especially premenstrually, settling with simple analgesia and warm packs. Currently described as a mild twinge; denies severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Patient-reported breast symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nipple discharge, skin changes, new lumps, weight loss, night sweats, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-reported variation in perceived breast lump size"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports daily palpation and sometimes feels the lump is bigger; acknowledges that perceived size varies with her cycle and how hard she presses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Cancer-related worry and checking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked worry about possible cancer, repeated reassurance-seeking and requests for further imaging, and hours spent reading breast cancer content online. Reports difficulty switching off from worry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep and mood report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep mildly impacted by rumination. No depression features volunteered today; denies suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telehealth visual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, alert, and in no acute distress. Normal colour with no obvious pallor or jaundice. Speaking in full sentences with no audible wheeze or shortness of breath. Affect anxious and tearful at times; speech clear and coherent. Breast examination not possible by video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Fatigue and possible hormone concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reports feeling generally tired and raises a question of possible hormone imbalance."
      }
    },
    {
