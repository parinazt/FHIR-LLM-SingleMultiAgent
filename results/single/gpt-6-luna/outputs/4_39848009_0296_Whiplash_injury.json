        "code": {
          "text": "Subacute whiplash-associated neck pain with muscle spasm, more than 4 weeks after motor vehicle accident"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Nonspecific right-greater-than-left arm and occasional leg sensory/motor complaints, likely post-whiplash sensorimotor disturbance with anxiety; no evidence of cord or root compression at present"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Health anxiety regarding nerve damage, contributing to presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Midline and paraspinal neck pain radiating into the right shoulder, rated 4–7/10; worse at the end of the workday, with sitting at a computer, and with driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Intermittent limb heaviness and subjective shaky or clumsy feeling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right arm more than left arm, and sometimes right leg; episodes last minutes to 1 hour and occur several times daily. Patient remains able to type and lift light things but feels off. Onset timing is unclear and the patient gives changing estimates, possibly the week before the visit or immediately after the motor vehicle accident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Intermittent tingling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tingling in the right forearm and hand, not clearly dermatomal. Patient reports the right forearm sometimes feels a bit funny, with no objective sensory deficit on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Denied neurologic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No numbness, saddle anaesthesia, or bowel or bladder change reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occipital headaches a few times per week since the motor vehicle accident, with neck stiffness; no red-flag headache features volunteered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Functional impact and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Working full-time, slower with typing, avoids heavier lifting, and sleep is broken by neck pain."
      }
    },
