        "code": {
          "text": "Rash around burn dressing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, slightly raised papular rash in the exact shape of the adhesive border; very pruritic, with no vesicles or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
