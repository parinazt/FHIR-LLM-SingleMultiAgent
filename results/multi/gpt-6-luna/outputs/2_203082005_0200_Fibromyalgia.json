        "code": {
          "text": "Bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 3–4 months; previously baseline constipation, now alternating. Constipation with no bowel movement for 2–3 days, hard/lumpy stools and straining, followed by 1–2 days of loose stools, 3–4 times per day, not watery."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Crampy lower abdominal pain, left greater than right, reduced after opening bowels or passing flatus. Bloating and increased wind."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
