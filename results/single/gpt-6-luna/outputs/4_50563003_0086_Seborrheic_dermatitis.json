          "text": "Rash distribution"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scalp, eyebrows, nasolabial folds, peri-auricular areas and hairline; mild involvement of the presternal area and under the breasts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
