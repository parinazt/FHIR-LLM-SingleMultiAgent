        "code": {
          "text": "Possible corneal involvement or other corneal pathology associated with episode of cloudy vision in the left eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bilateral eye discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For a few months: burning and gritty, like sand; worse over the last 1–2 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Blurred vision"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Blurred vision increases later in the day and with reading or watching TV. Patient reports vision is a bit worse than it used to be, possibly due to age."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Episode of cloudy vision and puffy sensation in left eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last night the left eye felt really cloudy and puffy, like there was a film over it; it was slow to clear by this morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Eye tearing and discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Some watery tearing; no purulent discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other eye symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies halos, severe pain, nausea or vomiting, curtain, flashes, and floaters. No trauma, foreign body, or chemical exposure. No contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, facial rash, and joint pains. Reports occasional dry mouth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telephone examination and reported function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Telephone consultation only. Speech clear and mildly slow. Able to read a newspaper with brighter light and more breaks. No reported inability to close eyes."
      }
    },
