        "code": {
          "text": "Neck pain and radiating left arm symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain for approximately 3–4 months, worsening; radiates from the neck to the left shoulder, dorsal forearm, and index and middle fingers. Pain is sharp/electric and intermittent, with paraesthesia in the same distribution."
      }
