    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Cough and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for about 10 days, started after a URTI-type illness; sore throat and blocked nose mostly resolved. Cough worse in the evenings and when talking a lot at work under air conditioning. No shortness of breath, wheeze, chest tightness, pleuritic chest pain, fever, chills, or haemoptysis. Appetite okay; energy slightly decreased."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well and comfortable appearing; speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry; no wheeze or crackles; no chest wall tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild postnasal mucus; nasal mucosa slightly oedematous; throat without erythema or exudate."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur or oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Facial skin symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports hypopigmented facial patches for about 3–4 months, more obvious after tanning over summer, with mild intermittent itch (especially after hot showers), dryness and flaking; no pain, bleeding, or vesicles. Examination: ill-defined hypopigmented macules/patches on both cheeks and lateral jaw, 1–3 cm, with very fine scale on close inspection; borders not sharply demarcated, background mildly tanned, and no complete depigmentation or erythema. No classic chalk-white patches."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Upper arm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few faint hypopigmented patches with minimal scale on the upper arms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
