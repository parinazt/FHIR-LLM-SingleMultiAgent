    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insomnia for approximately 3 months, worse over the last 4–6 weeks. Reduced sleep onset and sleep maintenance; lies awake 1–2 hours, wakes 2–3 times nightly, and gets approximately 4–5 hours of broken sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep schedule and sleep environment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bedtime varies from 22:30 to 01:00; usually gets up at 06:00. Uses screens and watches television in bed; sometimes falls asleep on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Caffeine and alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 3–4 coffees daily, with the last around 16:00–17:00, and occasionally has an energy drink. Drinks 1–2 glasses of wine on 3–4 nights per week to wind down; reports sleep remains poor."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep-related symptoms and breathing history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes with dry mouth and feels unrefreshed; daytime fatigue. Partner reports no snoring; no witnessed apnoea or waking choking. No near-miss driving incidents."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Work-related worry and rumination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worries about work at night and says her brain will not switch off. Reports increased stress and workload and more ruminations; no panic and no suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Migraine frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Migraine frequency increased from approximately 2 days per month to 5–6 days per month over the last 2 months; patient links the increase to poor sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Typical migraine features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Typically unilateral throbbing headache with nausea, photophobia, and phonophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Headache red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap headache, focal neurological symptoms, visual loss, speech issues, fever, or neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Analgesic and triptan use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses triptan approximately 4 days per month and NSAID approximately 8–10 days per month. No opioid use. Clinician documents current analgesic and triptan use within limits and no medication-overuse headache currently."
      }
    },
