          ]
        },
        "code": {
          "text": "External dysuria secondary to vulvovaginal candidiasis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "inactive"
            }
          ]
        },
        "code": {
          "text": "History of bacterial vaginosis; not currently active clinically or on swab"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "External burning when urine contacts vulva"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing; clinician attributed this to inflamed vulval tissue. No suprapubic pain, urgency, or haematuria reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Vulvar itching and burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing; worse at night and after shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Thick white vaginal discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still present, but a bit less than last week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Superficial pain with attempted sex"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Attempted sex 2 nights ago; stopped due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "General appearance and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no suprapubic or loin tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vulvar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, mild oedema, excoriations, and small fissuring at the posterior fourchette. Thick white curdy discharge on vulva/introitus; no fishy odour, ulcers, or vesicles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Speculum examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited examination: erythematous vaginal walls with adherent white plaques; cervix normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "High vaginal swab"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Many budding yeasts and pseudohyphae; Candida albicans, heavy growth, azole sensitive. Lactobacilli present. No trichomonas. Minimal clue cells; whiff test negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Urine dipstick"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Trace white cells only; no nitrites or blood."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Midstream urine culture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant growth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Combined oral contraceptive pill (COCP)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Fluconazole"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "150 mg orally, stat, once",
            "route": {
              "text": "oral"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 150,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Clotrimazole 500 mg pessary"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Insert vaginally tonight, stat",
            "route": {
              "text": "vaginal"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 500,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Clotrimazole 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to external vulva twice daily for up to 7 days",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-4",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-4",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to external vulva twice daily for up to 5 days; not intravaginal",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    }
  ]
