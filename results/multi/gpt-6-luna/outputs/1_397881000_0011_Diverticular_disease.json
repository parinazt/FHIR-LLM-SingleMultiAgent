        "medicationCodeableConcept": {
          "text": "OTC ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "A couple when it is really bad; approximately 2–3 doses per week; dose unclear",
            "asNeededBoolean": true
          }
        ],
        "note": [
          {
            "text": "Advised to reduce or avoid NSAIDs, ideally cease; patient reports they work better than paracetamol."
          }
        ]
      }
    },
