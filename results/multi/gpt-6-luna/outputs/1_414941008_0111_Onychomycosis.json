    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Toenail microscopy and culture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Microscopy positive for hyphae; culture grew T. rubrum"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Toenail symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Toenails thick, yellow, and crumbly for approximately 18 months, mainly the big toes. Mild discomfort in shoes and cosmetic bother; no pain, discharge, or spreading erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Toenail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Video examination: great toenails opaque yellow and thickened, with distal crumbling/onycholysis involving approximately 40–50% on the right and 30–40% on the left; some second toenails also affected. No obvious periungual erythema or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small erythematous scaly plaques on the shins, consistent with psoriasis; no cellulitis. Mild flare on the shins and behind the ears; no ooze or systemic symptoms."
      }
    },
