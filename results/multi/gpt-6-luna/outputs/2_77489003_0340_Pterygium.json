    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right eye reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a small growth on the nasal side of the right eye, first noticed a couple of years ago and slowly increasing. It has been more noticeable over the last 6–9 months, with intermittent irritation and scratchiness, especially at the end of the work day and on windy days; mild redness and dryness. Vision is okay for phone use and driving; says the right eye may be a touch blurrier when tired. Denies diplopia, photophobia, severe pain, purulent discharge, trauma, and acute onset."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal fleshy triangular fibrovascular tissue extends from bulbar conjunctiva onto the cornea, approximately 1.5–2 mm from the limbus towards the pupil; not on the visual axis. Mild injection. No ulcer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nasal conjunctival thickening with no corneal involvement; described as possibly pinguecula versus very early pterygium. Asymptomatic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Ocular examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Corneas clear; no foreign body. No ciliary flush or photophobia. PERRL; EOMI. Fundus examination limited by room light; discs appear sharp; no gross haemorrhage."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, palpitations, syncope, weight loss, fevers, and night sweats. Reports sleep is okay and mood is stable."
      }
    },
