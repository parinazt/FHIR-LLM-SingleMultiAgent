    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Initial gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms began approximately 6 days ago after a night shift. During the first 1–2 days, watery diarrhoea up to approximately 8 times daily, vomiting 3–4 times, and crampy lower abdominal pain. No blood or mucus in stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Current gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 2–3 days, no vomiting; appetite has returned. Now having 2–3 loose stools daily, with no nocturnal diarrhoea, mild bloating and cramps. Hydrating adequately. Last watery stool was yesterday; today stools are loose."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Milk-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Milk in coffee has been associated with increased bloating and urgency over the past few days; after a latte, the patient reports needing to go to the toilet immediately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
