        "code": {
          "text": "Right ring finger pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for 4–5/12; reported as up to 7/10, but also described as “only a bit sore”."
      }
    },
    {
