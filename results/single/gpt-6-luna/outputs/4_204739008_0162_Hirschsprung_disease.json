        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Movicol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "May increase to 2–3 sachets per day short term if more than 2 days without a bowel movement or if stool is hard; reduce back to usual once back to daily soft stool."
