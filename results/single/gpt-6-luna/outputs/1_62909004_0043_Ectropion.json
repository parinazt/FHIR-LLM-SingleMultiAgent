    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Several months of increased watery tearing, left greater than right, worse outdoors and in wind; mild gritty or sandy sensation, especially at the end of the day; occasional mild morning crusting. Clear tearing only. No significant pain, photophobia, reduced visual acuity, diplopia, flashes, floaters, curtain, trauma, foreign body, or contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Obvious left lower eyelid ectropion with punctum not apposed; mild inferior left conjunctival injection and clear tearing; mild left lower eyelid erythema/dermatitis from wiping. No periorbital swelling, lacrimal sac tenderness, or warmth. Cornea clear on torch examination with no obvious ulcer or abrasion. Pupils equal and reactive; no relative afferent pupillary defect. Extraocular movements full and non-painful. Right eye with mild age-related changes only."
      }
    },
