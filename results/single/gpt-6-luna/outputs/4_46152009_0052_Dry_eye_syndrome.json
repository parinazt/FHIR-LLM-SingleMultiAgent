    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bilateral eye discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For a few months: burning and gritty, like sand; worse over the last 1–2 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Blurred vision and left eye cloudiness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Blur increases later in the day and with reading or watching TV. Last night the left eye felt very cloudy and puffy, like there was a film over it; it cleared slowly this morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Eye-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia and some watery tearing. No purulent discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Subjective change in vision"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports vision is a bit worse than it used to be, but says it is probably just old age."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Eye-related red-flag symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No halos, severe pain, nausea or vomiting, curtain, flashes, or floaters. No trauma, foreign body, or chemical exposure. No contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, facial rash, and joint pains. Occasional dry mouth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reading ability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to read a newspaper with brighter light and more breaks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telephone examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech clear and mildly slow. No reported inability to close eyes. Examination by phone only."
      }
    },
