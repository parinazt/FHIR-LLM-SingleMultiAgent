        "code": {
          "text": "Left lower-leg chronic venous changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Haemosiderin changes, mild lipodermatosclerosis and varicosities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left lower-leg ulcer complications and perfusion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No crepitus or necrosis. Dorsalis pedis and posterior tibial pulses palpable; capillary refill under 2 seconds; no rest pain. No acute arterial compromise noted."
      }
    },
