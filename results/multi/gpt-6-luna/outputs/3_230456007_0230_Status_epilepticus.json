          "text": "Generalized tonic-clonic seizures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No generalized tonic-clonic seizures since the admission for convulsive status epilepticus approximately 18 months ago."
      }
    },
    {
