        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient notices she is not as sharp with new information but feels day-to-day functioning is fairly stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
