        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Moderate serous ooze; patient reports no real smell. No foul smell noted on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
