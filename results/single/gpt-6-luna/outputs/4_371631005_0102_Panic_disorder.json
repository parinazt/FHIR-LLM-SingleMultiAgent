    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Mental state examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech normal in rate and volume, coherent. Mood described as “a bit on edge”; anxious, reactive affect. Thought content focused on bodily symptoms, heart worries and the pregnancy article, with somatic preoccupation but intact reality testing. No delusions or hallucinations. Cognition grossly intact; oriented to person, place and time. Insight and judgement good; recognises panic and the possible role of caffeine and worry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Psychiatric history and risk review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No bipolar disorder, psychosis, alcohol issues, previous self-harm or suicidal ideation reported. No current suicidal ideation. Acute self-harm risk assessed as low; protective factors include family, future focus and good insight."
      }
    },
