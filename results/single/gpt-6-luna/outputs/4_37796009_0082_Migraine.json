    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep symptoms and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insomnia for approximately 3 months, worse over the last 4–6 weeks. Reduced sleep onset and maintenance; lies awake 1–2 hours, wakes 2–3 times per night, and gets approximately 4–5 hours of broken sleep. Bedtime varies from 22:30 to 01:00; wakes at 06:00. Uses screens in bed and watches TV; sometimes falls asleep on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep-related habits and concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 3–4 coffees daily, last around 16:00–17:00, and occasionally has an energy drink. Drinks 1–2 glasses of wine 3–4 nights per week to wind down; reports sleep is still poor. Worries about work at night and says her brain will not switch off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep-related breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring; no witnessed apnoea and no waking choking. Patient wakes with dry mouth and feels unrefreshed. Obstructive sleep apnoea considered less likely, with obesity and unrefreshed sleep noted as risk factors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Daytime fatigue and driving safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime fatigue; no near-miss while driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Migraine frequency and typical features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Migraine without aura for several years, previously approximately 2 days per month and now 5–6 days per month over the last 2 months; patient links increased frequency to poor sleep. Typical headache is unilateral and throbbing, with nausea, photophobia and phonophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Migraine red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap headache, focal neurological symptoms, visual loss, speech issues, fever or neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long-standing anxiety; increased stress and workload with more ruminations. No panic and no suicidal ideation. Previously benefited from CBT, which stopped due to work."
      }
    },
