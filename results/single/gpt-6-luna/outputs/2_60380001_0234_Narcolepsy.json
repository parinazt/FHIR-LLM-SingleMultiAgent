              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Probable stress-related insomnia with sleep fragmentation in the context of narcolepsy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Health anxiety, longstanding pattern of catastrophic misinterpretation of benign symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nocturnal awakenings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep fragmentation for approximately 3 months; wakes 4–5 times nightly, often first at 1–2 am and then about hourly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sensation on waking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling jolted awake, as if her body forgot to breathe for a second."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported sleep-disordered breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No witnessed apnoeas, gasping, choking, or morning headaches; partner has not noticed snoring."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Dreams and hypnopompic hallucinations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dreams are more vivid. Occasional brief hypnopompic hallucinations of seeing shadows in the corner for a few seconds, similar to previous experiences but increased in frequency."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Cataplexy symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rare brief knee weakness with laughter, approximately monthly, unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness and naps"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent daytime sleepiness, similar to baseline; takes 1–2 short naps on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sudden sleep attacks while driving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sudden sleep attacks while driving; avoids driving when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep schedule and sleep onset"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually goes to bed at approximately 22:30 and wakes at 05:30 on work days; sleep latency 20–30 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Night-time phone use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scrolls on phone in bed until sleepy and often checks phone after waking overnight, then struggles to return to sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Caffeine and substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 2–3 coffees daily, last usually at 15:00–16:00. Alcohol 0–2 standard drinks per week; denies excess alcohol and illicit substances."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Work stress and worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased work stress over the past 6 months related to short staffing and code blues; ruminates overnight about possible work errors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
