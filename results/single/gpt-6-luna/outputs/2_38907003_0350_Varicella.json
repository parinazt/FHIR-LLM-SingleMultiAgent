    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Flu-like symptoms, headache, fatigue, and low-grade fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported onset about 3 days before the visit; felt flu-like at work with mild headache, fatigue, and low-grade fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash onset and progression"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash started about 36 hours before the visit, beginning on the trunk and spreading to the scalp, face, and proximal limbs; small red spots progressed to vesicles, some now crusted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Rash distribution and morphology"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Generalised polymorphic rash typical of varicella, with multiple erythematous macules, papules, and 2–5 mm vesicles at various stages including crusted lesions; face, scalp, trunk, and proximal limbs involved, densest on trunk; some vesicles umbilicated; distribution not dermatomal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Rash tenderness and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked skin tenderness and stinging, especially on the torso under the bra line; pain 6/10 when clothes rub and stings with light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Rash itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itch is mild."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Skin examination for secondary infection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No honey-coloured crust, obvious cellulitis, or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Findings regarding eczema herpeticum"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No background eczema, confluent erosions, or punched-out erosions, especially periocular; clinician documented no features to suggest eczema herpeticum."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Eye findings and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No eye pain or visual change reported; no periorbital swelling or lid vesicles; conjunctiva clear and extraocular movements intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few small erythematous macules on the soft palate, no significant ulceration; swallowing okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial weakness, confusion, neck stiffness, photophobia, or severe headache reported. Alert and oriented, GCS 15, grossly non-focal neurological examination, and normal gait."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Respiratory symptoms and chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cough, shortness of breath, or pleuritic chest pain reported; chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms and hydration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting currently; tolerating fluids with decreased appetite but eating small meals. Well hydrated on examination."
      }
    },
    {
