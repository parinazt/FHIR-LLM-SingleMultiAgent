        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vital observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Breast skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral inframammary erythematous plaques in the folds, with maceration, superficial fissures, fine scale, a few small satellite papules, and mild odour. No pustules or ulcers. Lesions confined to the folds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Breast examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No masses, nipple change, peau d’orange, or lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Patient-reported concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very anxious about breast cancer or a “flesh-eating bug”; requested blood tests and a scan. Remained somewhat fixated on cancer after reassurance."
      }
    },
