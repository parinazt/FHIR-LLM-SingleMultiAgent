              "code": "414285001"
            }
          ],
          "text": "Food allergy to egg and tree nuts (tree nut type uncertain), with history consistent with IgE-mediated reactions"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
