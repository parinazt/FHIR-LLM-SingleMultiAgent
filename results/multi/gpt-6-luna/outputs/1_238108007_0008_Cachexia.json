        "code": {
          "text": "Weight trend"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Weight was 55 kg 6 weeks ago, down from 61 kg approximately 6 months earlier. Further decrease in muscle bulk noted today; patient has a history of progressive weight loss over the last year."
      }
    },
