        "status": "final",
        "code": {
          "text": "Worry and panic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild worry about Huntington’s progression; no panic symptoms."
      }
    },
    {
