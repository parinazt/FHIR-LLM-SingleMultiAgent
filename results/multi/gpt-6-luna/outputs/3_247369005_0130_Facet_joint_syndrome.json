    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Low back pain, patient report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime pain is a mild ache and about the same; more noticeable at night when trying to get to sleep for the past 3–4 weeks. Localised to the low lumbar area, right greater than left, non-radicular, with an occasional sharp twinge on extension or twisting in bed. Pain increases if sitting too long at a desk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep; wakes 1–2 times to change position, then returns to sleep. Patient reports frustration."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported absence of symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg weakness or numbness, bowel or bladder symptoms, saddle anaesthesia, weight loss, fever, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Local tenderness over lower lumbar facet joints, right greater than left; no midline tenderness. Mildly reduced flexion with ache at end range. Extension and rotation reproduce local pain only, with no radicular symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower-limb power 5/5; reflexes normal; sensation intact; straight leg raise negative bilaterally; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Previous lumbar X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Previous lumbar X-ray reported facet osteoarthritis and no red flags."
      }
    },
