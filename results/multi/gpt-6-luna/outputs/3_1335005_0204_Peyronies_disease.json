        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Penile and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No penile pain at rest, haematuria, dysuria, or discharge."
      }
    },
