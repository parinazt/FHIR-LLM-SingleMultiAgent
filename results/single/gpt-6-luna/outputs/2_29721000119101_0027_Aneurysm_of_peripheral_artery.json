        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to stand and walk a few steps. Gait mildly antalgic, favouring the right leg, but stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
