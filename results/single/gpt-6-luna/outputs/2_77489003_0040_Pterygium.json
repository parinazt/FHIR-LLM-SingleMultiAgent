        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Occupational UV and environmental exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works outdoors most days supervising construction sites, with wind and dust exposure. Historically has had poor eye PPE use, wearing a cap and sometimes sunglasses that are not wraparound. Ongoing high occupational UV exposure was assessed as a risk factor."
      }
    },
