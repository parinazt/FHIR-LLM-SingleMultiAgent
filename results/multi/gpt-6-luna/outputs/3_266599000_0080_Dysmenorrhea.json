    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Cyclical lower abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding cyclical central lower abdominal cramps, more left-sided than right-sided, radiating to the lower back and inner thighs. Begins 1–2 days before bleeding, is worst during the first 2 days of bleeding, then eases. Current worst-day severity 8/10; previously approximately 5–6/10 after laparoscopy. Pain has increased over the last 6–9 months and since stopping the combined oral contraceptive pill approximately 10 months ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms with menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea, loose stools, and fatigue on days 1–2 of bleeding; occasional headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Menstrual cycle and bleeding pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cycles every 28–30 days; bleeding lasts 5–6 days. Flow is moderate to heavy for the first 2 days, then light. Uses super pads or tampons, changing every 3–4 hours. Denies flooding and large clots."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pertinent negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, urinary symptoms, abnormal vaginal discharge, intermenstrual bleeding, and postcoital bleeding. Denied postcoital pain in the initial symptom review; separately reports mild deep dyspareunia around menses only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild deep dyspareunia around menses only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Impact of menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Missed 2–3 days of work in the last 3 months because of pain. Often needs to lie down on the evening of day 1 of bleeding. Reports being 'knocked out for a day or two' by the pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported response to pain-relief measures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ibuprofen taken from onset of bleeding provides some benefit. Heat pack is helpful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mood and sleep around menstruation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood is a little flat around the period only. Denies persistent depression, anhedonia, and suicidal ideation. Sleep is okay."
      }
    },
