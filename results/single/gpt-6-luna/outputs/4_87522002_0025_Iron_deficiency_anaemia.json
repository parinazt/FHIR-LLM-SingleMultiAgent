        "code": {
          "text": "Right great toe pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throbbing and very tender for approximately 4 days; worse in closed shoes and better barefoot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right great toe examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and swelling of the lateral nail fold with local tenderness and early ingrown nail appearance. Nail plate very short with curved edges. No fluctuance, pus, proximal paronychia, or spreading erythema onto the dorsum."
      }
    },
