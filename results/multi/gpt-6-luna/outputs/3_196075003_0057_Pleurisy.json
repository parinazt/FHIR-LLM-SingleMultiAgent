        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache for 4 days, gradual onset, bifrontal and temporal, dull with occasional sharp twinges, 5–7/10, worse in the evening and with screens. Some relief with Panadol. Not thunderclap and not described as the worst ever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
