    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Distress when away from partner or home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked distress most days when away from partner or home; symptoms have been ongoing for more than 12 months and were worse over the last 6–8 months. Symptoms increased over the last 2 months with the partner's office days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Anticipatory anxiety about partner leaving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxiety the night before the partner goes to work or social activities. Patient reports feeling physically sick and unable to focus when the partner is out for the day, until he returns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Worry and checking related to partner's safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repetitively checks the partner's location and messages and worries that something bad will happen and he will not come home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Avoidance when alone outside the home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids being alone outside the home; cancels or delays appointments if the partner cannot accompany her and uses grocery delivery. Avoids public transport and busy indoor spaces alone. Can walk a short distance around the block with her partner; reports high distress about unfamiliar places alone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep disturbance and nightmares when partner is away"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty sleeping when the partner is not in the flat; waits awake until he returns. Occasional nightmares about him going missing or having an accident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Somatic symptoms before partner leaves"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdominal tightness, nausea and mild headache when the partner is about to leave; symptoms settle when he is home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Work and activity pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works part-time remotely from home. Patient reports that remote work suits her but allows her to avoid going places."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Caffeine intake and perceived effects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually drinks about 3–4 coffees per day, with more on stressful days. Increased coffee on the partner's office mornings in an attempt to calm her nerves; feels it makes anxiety worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "News and phone use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports heavy news and phone use and feels this increases jitteriness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent low mood, hopelessness and anhedonia. Continues to enjoy drawing, shows and online gaming."
      }
    },
    {
