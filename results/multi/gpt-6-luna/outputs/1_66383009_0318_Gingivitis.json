    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-reported oral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports hard yellow material along the gums that does not come off with brushing; yellow/brown buildup, especially on the lower front teeth, present for at least a few months and worsening over the last 2–3 months. Reports puffy gums that bleed when brushing, but not otherwise. No pain or toothache, ulcers, facial swelling, or difficulty eating. Partner has sometimes commented on bad breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited examination using a torch: generalised soft plaque and obvious supragingival calculus along the gingival margins, especially lingual lower incisors and buccal upper molars. Gums erythematous and mildly swollen, with slight bleeding on gentle probing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Oral examination—negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious caries, broken teeth, tooth mobility on finger pressure, pus, abscess, sinus, or trismus. Tongue, buccal mucosa, and palate normal; no thrush."
      }
    },
