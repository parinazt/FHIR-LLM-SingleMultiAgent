      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck range of motion and symptom provocation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced neck extension and right rotation. Neck extension and right lateral flexion reproduce right arm symptoms."
      }
    },
    {
