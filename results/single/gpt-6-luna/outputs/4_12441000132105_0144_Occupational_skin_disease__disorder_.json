    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hand rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 6–8 weeks, increased flares of red, dry, fissured hand rash with some small vesicles after long bleach or dye days. Itchy and burning, worse at the end of shifts and somewhat better on days off. Fissure pain makes shampooing and colouring difficult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Transient welts at wrists and forearms after wet hair or dye exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports raised, itchy welts where gloves end, appearing shortly after exposure and settling within 1–2 hours without treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Forearm reaction after product exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased stinging and redness on sun-exposed forearms after certain products when going out for lunch; possible photosensitivity component is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsal hands and fingers with erythematous, dry, lichenified plaques, fine scale, shallow fissures over MCPs, and mild oedema; no warmth or pus. Few small clear vesicles on lateral fingers. Palms with mild erythema and dryness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Wrist and forearm examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint post-inflammatory erythema band at glove line; no active wheals at examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Scalp examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythematous scaly plaques on the occipital scalp, consistent with mild psoriasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Facial, tongue, and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial oedema, tongue swelling, or respiratory distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported systemic allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, wheeze, facial or tongue swelling, and generalised urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Recent personal product changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no new personal products at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Prescribed twice daily as needed for flares; patient reports using it when flares become severe, sometimes 4–5 times daily for a few days.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Over-the-counter hydrocortisone, strength and form not stated"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used intermittently on the face for psoriasis; dose and frequency not stated.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene emollient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Usually applied at night when remembered; frequency otherwise not stated.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone dipropionate 0.05% ointment (Diprosone)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to affected hand areas twice daily for 7 days, then once daily for 7 days, then stop; use on rash only.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05%"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "For subsequent milder flares, use twice daily as needed, maximum 7–10 days per month.",
            "route": {
              "text": "Topical"
            },
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine 10 mg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Once daily as needed for itch or urticaria; may use regularly during high-exposure periods.",
            "route": {
              "text": "Oral"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    }
