        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lungs clear bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no trauma, cannulae or injections to the leg; no fevers, rigors, night sweats, chest pain, shortness of breath, palpitations or haemoptysis. No significant calf swelling away from the affected area and no groin or thigh pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and risk factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no recent surgery, immobilisation, long-haul flights, hormone replacement therapy or known malignancy; no weight loss, night sweats or anorexia. No current leg wounds, ooze or spreading cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Reported exertional calf symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent calf ache on longer walks; no rest pain and no foot ulcers."
      }
    },
