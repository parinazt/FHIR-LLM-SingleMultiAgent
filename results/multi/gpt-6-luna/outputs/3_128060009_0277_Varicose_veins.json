    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right medial calf finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Red, tender, firm cord along a varicose vein in the mid-to-distal medial right calf, approximately 7–8 cm long, with an approximately 3 cm erythematous band; warm and not fluctuant, with no pus and intact skin. Patient describes a “lumpy rope under skin.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right lower limb examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable extension proximally to the knee or thigh; no groin tenderness. Right and left calf sizes approximately equal, with no generalized oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
