        "code": {
          "text": "Vulvovaginitis, likely uncomplicated Candida vulvovaginitis, partially responsive to short topical azole; persistent external itch likely residual inflammation or irritant dermatitis"
        },
        "verificationStatus": {
          "coding": [
            {
