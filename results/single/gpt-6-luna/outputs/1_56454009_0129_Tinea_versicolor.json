    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Skin examination of upper back and shoulders"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple well-demarcated hypopigmented macules and patches with fine scale, some coalescing; scale evoked on examination; no erythema. Findings documented as consistent with tinea versicolor."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
