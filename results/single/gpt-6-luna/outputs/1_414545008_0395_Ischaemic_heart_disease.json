        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest, jaw, or central pressure; no shortness of breath, orthopnoea, or PND; no palpitations, presyncope, or syncope; no speech, vision, or weakness symptoms. Shoulder pain described as clearly movement-related and not exertional. No neck pain, pain radiation past the elbow, paraesthesia, or weakness."
      }
    },
