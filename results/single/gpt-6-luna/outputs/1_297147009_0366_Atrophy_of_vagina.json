    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tight, dry sensation low in the throat/upper chest when swallowing saliva and occasionally liquids for 3–4 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated throat symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild hoarseness, especially after long retail shifts talking all day. No true odynophagia, dysphagia to solids, food sticking, or classic globus sensation. No cough, choking, aspiration, weight loss, fever, or night sweats. No typical GORD; occasional sour taste when lying down soon after dinner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vaginal and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent vaginal dryness and dyspareunia despite vaginal moisturiser use; mild increase in urinary frequency. No dysuria, urgency, incontinence, or post-vaginal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Oropharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear with mild posterior pharyngeal erythema and cobblestoning; no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
