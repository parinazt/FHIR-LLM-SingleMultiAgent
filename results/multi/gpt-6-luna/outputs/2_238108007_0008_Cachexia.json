      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Weight and muscle loss"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive weight loss over the last year per history; wife reports clothes are much looser. Patient is not keen on regular weighing. Very thin and frail, with further decreased muscle bulk on inspection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Appetite and food intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor appetite, usually one small meal per day with occasional snacks. Reports early satiety, that food 'just doesnt do it', and that the smell of cooking is off-putting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nausea and gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional mild nausea when the kitchen is steamy. No vomiting, dysphagia or oral ulcers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels open every 1–2 days with formed stool. No PR bleeding or melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
