        "valueString": "Looks well; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pinna with mild erythema and fine scale in the conchal bowl and post-auricular skin; mild tenderness of pinna and tragus. No swelling, cellulitis, or fluctuance. External auditory canal with mild erythema and scant dry scale; no oedema, debris, pus, moist crust, or odour. Tympanic membrane intact with normal landmarks and light reflex; no bulging, retraction, or effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mastoid and post-auricular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No mastoid tenderness or post-auricular swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Skin examination of hands"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild xerosis and faint erythema on the dorsum of the hands; no weeping, lichenification, or bacterial features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Skin examination of feet"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild interdigital scaling; no maceration, fissures, erythema suggesting secondary infection, or onychomycosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Lymph node examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pre-auricular, post-auricular, or cervical lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Dermatitis history and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent atopic/contact-type dermatitis of the hands and peri-auricular area, with itch. Flares with frequent handwashing and cleaning products at work. No vesicles, grouped blisters, or punched-out erosions. No widespread rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Tinea pedis history and treatment response"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Recurrent tinea pedis for years, worse in summer and with closed shoes. Currently mild interdigital scaling while using terbinafine 1% cream once daily for 1 week of a planned 2–4-week course; assessed as appearing to respond. No nail involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Focused neurological and skin review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No headaches or visual disturbance; no fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Apply to external pinna and peri-auricular area twice daily for 5 days; instructed to continue a thin layer twice daily on the outer pinna and just at the canal entrance only, for a total course of up to 7–10 days, then stop.",
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g up to three times daily as needed; patient reports using approximately twice daily. Plan states paracetamol 1 g up to four times daily as needed.",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Apply once daily to affected areas. Has used for 1 week; plan is to continue for a minimum of 2 weeks and for 1 week after resolution.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
