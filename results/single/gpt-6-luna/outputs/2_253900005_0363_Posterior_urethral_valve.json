    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported rash and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1 week of red, mildly itchy spots on the upper chest and dorsal forearms, initially a few dots and now more numerous; remains limited to the upper chest/shoulders and extensor forearms, not below the waist. Itching is worse in the evenings and after showering and does not wake the patient at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple small 2–5 mm erythematous, slightly raised papules over the upper anterior chest and shoulders, with scattered lesions on the dorsal forearms; some coalescing into small patches, with mild excoriation. No vesicles, pustules, crusting, target lesions, or purpura. Face, palms, soles, and mucosa spared."
      }
    },
