    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urethral discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three days of whitish urethral discharge, initially scant and now increased, especially in the mornings; described as not really pus. Mild dried whitish discharge was seen at the meatus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left testicular and hemiscrotal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three days of insidious-onset, constant dull left testicular/hemiscrotal pain, rated 4–5/10; worse standing or walking and better lying down and with supportive underwear. Patient describes pain tracking along the tube at the back, like the epididymis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild dysuria. No frank haematuria or other lower urinary tract symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pertinent reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, rigors, flank pain, nausea, vomiting, testicular lump, trauma, sudden onset or severe pain, weight loss, night sweats, abdominal pain, change in bowel habit, back pain, or flank pain."
      }
    },
