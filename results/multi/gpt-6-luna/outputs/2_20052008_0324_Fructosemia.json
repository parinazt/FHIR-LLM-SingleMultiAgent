    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for approximately 10 days, initially on the flexor forearms and now with a few patches on the anterior neck and upper chest. Mild-to-moderate itch, worse in the evening. No blistering, weeping, pus, or mucosal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flexor forearms: scattered erythematous patches/thin plaques, 1–3 cm, with mild dry scale and some excoriations; no vesicles, pustules, or infection. Few small erythematous papules/patches on the anterior neck and upper chest. No target lesions or urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 weeks, loose stools on 3–4 days per week, up to 3–4 times per day, with bloating and crampy lower abdominal pain. No rectal blood or mucus, weight loss, fever, or nocturnal diarrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild bloating and mild LLQ greater than RLQ tenderness. No peritonism or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mood screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes feeling 'just exam stress'; no red-flag mood symptoms on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply thinly to affected areas twice daily for 5–7 days, then as needed in short courses",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
