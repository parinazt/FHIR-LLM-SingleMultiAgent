        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild fatigue, attributed by the patient to long hours onsite and hot weather."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports probable unintentional weight loss of a couple of kilos over 6–12 months; clothes are a little looser."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Alcohol consumption"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports about 3–4 mid-strength beers most nights and up to 6–8 on weekends; no spirits. Says he has cut back from previous heavy daily drinking. Agreed to trial complete abstinence for at least 4 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Symptoms relevant to liver disease"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies jaundice, abdominal pain or distension, nausea, vomiting, gastrointestinal bleeding, confusion, fever, night sweats, pruritus, melaena, rectal blood, and dark urine. Bowel motions normal. No easy bruising, epistaxis, or gum bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Sleep and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Light sleep; partner reports snoring, with no witnessed apnoea. Patient feels rested most mornings. Mood described as pretty good; denies depression, anhedonia, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-looking, alert and conversant, in no acute distress; no asterixis. No scleral icterus. Heart sounds dual, no murmur or oedema; lungs clear. Abdomen soft and non-tender; liver edge just palpable at the right costal margin, smooth and non-tender; no obvious ascites or splenomegaly. No jaundice, spider naevi, palmar erythema, or bruising. Alert and oriented to person, place and time; grossly non-focal neurological examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Alcohol withdrawal history and risk assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Withdrawal pattern assessed as suggesting moderate dependence risk. No morning drinking, shakes, or blackouts; reports previous short abstinent periods without significant withdrawal."
      }
    },
