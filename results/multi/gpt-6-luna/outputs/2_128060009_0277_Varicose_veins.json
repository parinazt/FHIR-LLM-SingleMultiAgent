    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right medial calf finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over a varicose vein at the mid-distal third of the right medial calf, a 7–8 cm firm, tender cord with an approximately 3 cm band of erythema and warmth. Not fluctuant; no pus; skin intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right leg examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable extension proximally to the knee or thigh; no groin tenderness. Calf size approximately equal to left; no generalized oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Varicose veins"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prominent tortuous varicose veins along the great saphenous vein territory bilaterally, right greater than left."
      }
    },
    {
