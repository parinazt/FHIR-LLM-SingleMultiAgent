        "code": {
          "text": "Erythematotelangiectatic rosacea – mild response to topical metronidazole, with persistent erythema and flushing"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Mild ocular rosacea"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Facial redness and flushing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports central cheek and nose redness for approximately 12–18 months, worse over the last 6 months. Intermittent episodes become bright red with heat, hot drinks, a glass of wine, or work stress and last approximately 30–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Facial burning and stinging"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports burning and stinging, especially after showering and in the air-conditioned office."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Facial lesions, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pimples or zits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Facial examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central fixed erythema of cheeks and nose with fine telangiectasia. No papules, pustules, comedones, or scale."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports mild gritty eyes in the evenings for several months. Denies photophobia, blurred vision, and discharge. Does not wear contact lenses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral conjunctival injection. Visual acuity grossly okay on phone assessment; pupils PERRLA; no obvious lid disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Metronidazole 0.75% gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Apply to central face twice daily; patient uses it most days and misses some evening doses.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
