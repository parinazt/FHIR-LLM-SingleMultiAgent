        "code": {
          "text": "Reported left knee bump or bone position concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the bump is on the side and that the front bone seems off to the side; worried about bone cancer or the bone growing wrong."
