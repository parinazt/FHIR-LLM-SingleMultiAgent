        "code": {
          "text": "Mood, appetite and weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent low mood; reports feeling 'a bit flat' after poor sleep. Appetite is okay and weight is stable by patient report."
      }
    },
    {
