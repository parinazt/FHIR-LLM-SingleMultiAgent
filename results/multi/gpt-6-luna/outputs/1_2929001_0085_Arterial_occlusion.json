    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Mottled discoloration of lower legs and feet"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports mottled rash on both lower legs and toes for approximately 10–14 days. Examination shows mottled purplish net-like discoloration of both shins and dorsum of feet, right greater than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right toe symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot toes, especially the great and second toes, feel cold and tingle somewhat at night; toes are a little sore if the patient has been on them a lot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Walking-related calf and foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right calf/foot pain when walking approximately 150–200 m to the mailbox; needs to stop, and pain settles within a few minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nocturnal forefoot ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sometimes woken by a dull ache in the forefoot, right greater than left; improves when the leg is dangled off the bed. No frank rest pain all night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported lower-limb symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sudden severe pain, trauma, or known ulcers; patient admits he does not look at his feet much. No fevers, rigors, or sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No itch. Patient thinks the rash may be related to new washing powder or bore water, but timing is unclear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin elderly male, no acute distress at rest; walks slowly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur. No obvious carotid bruits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased air entry bilaterally with scattered expiratory wheeze; no crackles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no mass or obvious abdominal aortic aneurysm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right toe appearance and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right great and second toes are violaceous distally and cool to touch; right foot is colder than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Right great toe lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Early shallow fissure at the tip of the right great toe; no purulence or surrounding cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Lower-limb pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Femoral pulses palpable bilaterally. Popliteal pulse faint on the right and weak on the left. Dorsalis pedis pulse not palpable on the right and very weak on the left. Posterior tibial pulses not palpable bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Toe capillary refill"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 4–5 seconds on the right and 3–4 seconds on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Toe sensation and motor function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Light touch reduced over toes, right greater than left. Ankle and toe movements intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Right leg elevation and dependency response"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pallor of the right leg in less than 30 seconds on elevation, with reactive rubor on dependency."
