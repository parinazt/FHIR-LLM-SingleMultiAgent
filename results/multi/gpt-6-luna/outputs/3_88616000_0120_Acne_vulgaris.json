        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to all affected areas, not spot only; use on alternate nights for 1 week, then nightly as tolerated",
