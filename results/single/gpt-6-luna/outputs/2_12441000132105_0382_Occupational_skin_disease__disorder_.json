        "medicationCodeableConcept": {
          "text": "Mometasone furoate 0.1% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to hands, wrists, forearms, and elbows nightly for 7–10 days, then on alternate nights for 1 week, then stop. Maximum once daily; do not use on face or groin; not more than 2 weeks continuously. Continue emollient.",
