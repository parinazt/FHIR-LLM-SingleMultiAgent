          "text": "Time to first cigarette after waking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually within 10–15 minutes of waking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
