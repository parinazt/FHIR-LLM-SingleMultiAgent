        "code": {
          "text": "Previous mycology testing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No previous mycology testing reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "For feet: using approximately once daily for approximately 2 weeks; often forgets twice-daily use, especially on night shifts.",
            "route": {
              "text": "topical"
            }
          },
          {
            "text": "For groin itch: using the same cream as needed.",
            "asNeededBoolean": true,
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply twice daily to toe webs and 1–2 cm margin for a minimum of 14 days, then once daily for 1 week after clear.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
