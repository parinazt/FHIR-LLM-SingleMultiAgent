        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious facial swelling. Lips and oral mucosa appeared normal when the patient opened her mouth; no conjunctival injection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Skin punch biopsy, forearm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dense dermal neutrophilic infiltrate with papillary dermal oedema; no leukocytoclastic vasculitis and organisms not seen. Features consistent with acute febrile neutrophilic dermatosis (Sweet syndrome) in the appropriate clinical context."
      }
