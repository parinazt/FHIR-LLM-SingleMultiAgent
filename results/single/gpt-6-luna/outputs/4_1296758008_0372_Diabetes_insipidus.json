        "code": {
          "text": "Increased urination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased urination for 2–3 days, described as 'weeing heaps'; passing large volumes of clear urine estimated at 300–350 mL hourly over the last 24 hours, including 3–4 hours overnight."
      }
    },
    {
