      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Irritability and anger episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports ongoing increased irritability at home and work, blowing up at partner and customers, raising her voice and throwing things twice last month. Reports no physical violence. Symptoms increased over the last 3–4 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports decreased concentration at work, drifting off and getting stuck in thoughts. Grossly intact cognition on examination, with some difficulty maintaining focus on longer questions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Sleep and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleeping 4–5 hours per night with multiple wakings and recurrent nightmares about past trauma. Wakes sweaty with heart racing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Startle response and hypervigilance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased startle and hypervigilance and avoiding crowds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Intrusive memories and emotional numbing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports ongoing intrusive memories and emotional numbing, as in previous consultations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking 3–4 premix cans most nights and up to approximately 8 on weekends; denies morning drinking. Partner is concerned. Reports increased alcohol use and no history of withdrawal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cannabis use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports smoking a couple of cones before bed most nights. Reports increased cannabis use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes mood as “pissed off all the time.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and guarded; engages with encouragement and is occasionally tearful when discussing nightmares. Appropriate appearance and good hygiene. Tense, fidgety and scanning the room; reluctant to elaborate unless prompted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Irritable and mildly anxious affect, congruent and reactive; affect appeared more distressed than her words."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Speech and thought form"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech normal in rate and volume, becoming louder when describing conflict. Thought form linear and goal directed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Thought content and perceptual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intrusive trauma memories reported. No delusions or hallucinations reported or elicited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies wanting to hurt herself; reports some thoughts of “wanting to disappear.” No plan or intent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
