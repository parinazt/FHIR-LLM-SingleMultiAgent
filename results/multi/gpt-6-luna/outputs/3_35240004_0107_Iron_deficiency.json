        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked fatigue; patient feels wiped out by mid-afternoon, or knackered by 3 pm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
