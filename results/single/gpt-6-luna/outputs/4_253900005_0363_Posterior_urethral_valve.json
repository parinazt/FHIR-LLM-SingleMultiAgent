    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported rash and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Red, mildly itchy spots for about one week, beginning on an uncertain Tuesday or Wednesday. Started as a few dots and became more numerous, limited to the upper chest, shoulders, and extensor forearms, not below the waist. Itch is worse in the evenings and after showering and does not wake the patient at night. No vesicles, weeping, or pain. New body wash started about two weeks ago; also wears a new inexpensive synthetic hi-vis work shirt and reports heavy sweating while working in hot roof spaces."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple 2–5 mm erythematous, slightly raised papules over the upper anterior chest and shoulders, with scattered papules on the dorsal forearms; some coalescing into small patches. Mild excoriation. No vesicles, pustules, crusting, target lesions, or purpura. Face, palms, soles, and mucosa spared."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, wheeze, lip or tongue swelling, fever, systemic symptoms, or recent viral illness. No genital rash, dysuria, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported voiding pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voids 5–6 times daily and once overnight. Stream is slow but unchanged from usual. No current dysuria, haematuria, loin pain, or suprapubic pain. No UTI in more than one year."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported fluid intake and urinary holding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking a lot of coffee and energy drinks, probably not enough water, and often holding urine at work because leaving to use the toilet is difficult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and communication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, talkative and tangential at times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Chest and cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear. Heart sounds dual with no added sounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Abdominal and costovertebral angle examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, no mass or suprapubic distension, and no costovertebral angle tenderness."
      }
    },
