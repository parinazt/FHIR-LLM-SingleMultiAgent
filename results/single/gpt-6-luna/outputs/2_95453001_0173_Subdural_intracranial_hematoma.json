    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull left-sided headache, rated 2–3/10; worse when overtired. No sudden severe headache, early-morning vomiting, or nocturnal headache waking him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Cognitive concerns and function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daughter has described him as more forgetful; patient reports misplacing items and occasionally repeating questions, but feels he has always been absent-minded. No getting lost in familiar places; continues basic routines. Some delay recalling exact dates. During the phone consult he recounted his hospital stay and daily routine consistently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Gait and balance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling wobbly, especially on first standing or in dim light, and needing furniture support indoors. One near-fall in the last two weeks while turning quickly in the kitchen; caught himself on a bench. No further actual falls since discharge. Gait could not be observed by telephone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent with basic self-care but slower; sits for showers because of fear of falling. Manages simple meals. Has stopped ladder work, roof work, and garden work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Instrumental activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not driving as advised by hospital. Relies on daughter for shopping and transport to appointments. Daughter has arranged direct debit for bills; patient is not managing complex finances himself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; wakes two to three times overnight thinking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies low mood; acknowledges frustration about reduced independence. Suicidal ideation denied."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional fuzzy vision when tired. Denies diplopia, acute visual loss, and new visual loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Speech and swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysarthria, dysphasia, and swallowing issues. Speech fluent on the phone, with no word-finding difficulty noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Seizure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of seizures before or after the subdural haematoma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neurological symptoms by patient report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies facial asymmetry, limb weakness, or numbness when asked directly. No new focal weakness reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mental status during telephone consult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and conversant; oriented in conversation to person, place, and time. Engaged and polite; coherent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Respiratory status during telephone consult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with no audible shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Subdural haematoma imaging result"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Per hospital discharge summary, CT brain approximately six weeks before this consult: post burr-hole evacuation of left fronto-parietal chronic subdural haematoma, small residual collection, minimal midline shift, no acute haemorrhage, and no hydrocephalus. No repeat imaging since."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new severe headache, rapid increase in confusion, new focal weakness, new incontinence, acute visual loss, or repeated vomiting reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Functional and housing concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lives alone in public housing, has limited finances, and is anxious about a potential move or rent change. Daughter is main support and is concerned about him living alone and housing stability."
      }
    },
    {
