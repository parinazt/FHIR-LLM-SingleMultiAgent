        },
        "valueString": "Tachycardic with dual heart sounds and no murmur. Peripheral extremities warm; capillary refill under 2 seconds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
