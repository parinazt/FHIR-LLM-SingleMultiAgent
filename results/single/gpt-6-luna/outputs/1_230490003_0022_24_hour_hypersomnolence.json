    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 2 weeks ago; central low lumbar pain, slightly to the right. Dull ache, sometimes sharp with bending; up to approximately 6–7/10 when provoked, but mostly described as annoying. Worse after prolonged desk sitting and lifting shopping. Mild stiffness for the first 10–15 minutes in the morning, then eases. Patient suspects a new office chair or sleeping awkwardly on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Back pain associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg pain, pins and needles, weakness, bowel or bladder change, saddle numbness, fever, weight loss, night sweats, and trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild right lumbar paraspinal tenderness; no midline tenderness. Slightly reduced flexion with pain, but able to move in all directions. Straight leg raise negative bilaterally. Lower limb power, reflexes, and sensation grossly normal; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness and hypersomnolence symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding excessive sleepiness; patient says she could nap almost any time or anywhere. Patient reports that her partner says she nods off on the couch and at work. She feels unrefreshed on waking. Partner is worried about her daytime sleepiness and driving; patient feels the concern may be overstated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sleep pattern and sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually in bed around 10–11 pm and gets up around 6–6:30 am. Reports kicking during sleep, disturbing her partner; prior sleep study approximately 2 years ago reportedly showed periodic limb movements. Partner reports no snoring or apnoeas. Denies cataplexy, sleep paralysis, and hallucinations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Drowsiness while driving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drives short distances and reports feeling drowsy often and having zoned out at red lights. Denies actually falling asleep while driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mood and related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low motivation, fatigue, poor concentration, and feeling foggy. Denies current suicidal ideation."
      }
    },
    {
