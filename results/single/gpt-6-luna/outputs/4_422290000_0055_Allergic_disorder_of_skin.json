        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "2 sprays in each nostril every morning for 1–2 weeks, then decrease to 1 spray in each nostril every morning for maintenance as tolerated",
            "route": {
              "text": "intranasal"
            }
          }
        ]
