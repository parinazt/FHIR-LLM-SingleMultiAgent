        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks the infection is due to 'chemicals at work' and that the water at home 'smells funny' and is 'probably poisoned it'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
