    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sudden nausea followed by 5–6 episodes of non-bilious, non-bloody vomiting in the first 12 hours. Vomiting was easing; the last small vomit was this morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose watery stools, approximately 7–8 episodes in the last 24 hours; no blood or mucus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent crampy lower abdominal pain before bowel movements, settling afterward. No constant severe pain or focal right iliac fossa pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Felt hot and cold overnight; mild headache and myalgias. No documented temperature at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Fluid intake and urine output"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Taking small sips of water and electrolyte drink. Passing small volumes of pale yellow urine every 4–5 hours. Mild dry mouth; no dizziness on standing or syncope."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Oral intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Minimal solid food today due to nausea; fluids tolerated in sips."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gastroenteritis exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works in childcare; approximately half the room had gastroenteritis this week, including several children and one colleague with nausea, vomiting, and diarrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
