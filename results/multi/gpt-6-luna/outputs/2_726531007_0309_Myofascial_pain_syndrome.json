        "code": {
          "text": "Health-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very health anxious, tense and fidgety; repeatedly expressed worry about bone or hidden cancer and concern that cancer might be missed. Reports extensive internet searching and requested further tests."
      }
    },
