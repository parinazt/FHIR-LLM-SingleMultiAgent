        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Localized contact urticaria pattern at glove edge; possible latex or rubber chemical allergy, not yet confirmed"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
