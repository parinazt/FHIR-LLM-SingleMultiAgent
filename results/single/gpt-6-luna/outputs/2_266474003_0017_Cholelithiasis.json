    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Prior right upper quadrant ultrasound findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple gallstones; largest 9 mm. Gallbladder wall normal. No common bile duct dilatation; common bile duct 5 mm. No pericholecystic fluid. No intrahepatic duct dilatation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "History of upper abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent right upper quadrant/epigastric colicky pain for 6 months, sometimes radiating to the right shoulder; up to 7/10, usually lasting 30–60 minutes, with two episodes lasting 2–3 hours. Mostly in the evenings and after fatty meals; approximately 3–4 episodes per month. One nocturnal episode last week settled with ibuprofen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Symptoms accompanying severe pain episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea with severe episodes. Denies vomiting, fever, rigors, jaundice, dark urine, pale stool, rectal bleeding, and melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
