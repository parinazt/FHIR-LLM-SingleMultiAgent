    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 4–5 hours of broken sleep, waking repeatedly because of right ear pain. No difficulty falling asleep. Sleep disturbance ongoing in association with ear pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Mood and sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies low mood, racing thoughts, and early waking independent of ear pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp pain, described as like someone jabbing a match in the ear, when lying on the right side. Settles on turning over or rubbing the ear, then recurs when lying on it again. Ongoing approximately 3–4 months and getting worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right upper ear lump"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a small painful lump on the upper right ear for approximately 6 months. Worse with pressure on the pillow and sometimes crusty. No discharge or bleeding other than when cracking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
