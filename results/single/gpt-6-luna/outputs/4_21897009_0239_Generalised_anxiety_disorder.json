    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Patient-reported anxiety and health worries"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 3–4 weeks, the patient reports increased worry and more difficulty controlling it, mainly concerning her health, dementia and cancer. She searches health websites most nights and ruminates over minor bodily symptoms, fearing cancer or rapidly worsening dementia. She has had multiple recent phone contacts with the practice and two face-to-face visits in the last month for benign issues, and repeatedly asked whether more tests or scans were needed today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Anxiety-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels on edge most days; muscle tension in shoulders and jaw; fatigue by late afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
