          "text": "Sexual arousal and orgasm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Once engaged, patient is usually able to orgasm, though it takes longer and feels less intense. Denies anorgasmia."
      }
    },
