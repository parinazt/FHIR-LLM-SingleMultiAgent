          "text": "Pain at rest"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pain at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Perineal ache after intercourse or ejaculation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild ache after, rated 2/10; described as like being kicked there, but not bad."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies sores, ulcers, discharge, dysuria, haematuria, and haematospermia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Erectile function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For about 12 months, gradual difficulty getting and keeping an erection, worse with stress. Some reduction in morning erections, which are still present but not as strong as they used to be."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
