        "status": "final",
        "code": {
          "text": "ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Congested nasal mucosa, boggy turbinates, clear rhinorrhoea, mild oropharyngeal injection without exudate. Tympanic membranes normal. No cervical lymphadenopathy."
      }
    },
    {
