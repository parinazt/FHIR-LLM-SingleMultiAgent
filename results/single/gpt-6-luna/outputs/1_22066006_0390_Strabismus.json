          "reference": "Patient/patient-1"
        },
        "valueString": "No nystagmus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Undilated direct fundoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Discs with sharp margins and normal colour; no papilloedema; maculae appear normal; no obvious retinal lesions."
