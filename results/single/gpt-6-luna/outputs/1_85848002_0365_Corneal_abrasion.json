        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Instill in the left eye four times daily until pain-free for 24–48 hours, then stop. Total course not more than 5–7 days unless reviewed.",
