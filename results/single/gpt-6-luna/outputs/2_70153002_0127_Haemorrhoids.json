            }
          ]
        },
        "code": {
          "text": "Inflammatory bowel disease considered less likely"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-7",
