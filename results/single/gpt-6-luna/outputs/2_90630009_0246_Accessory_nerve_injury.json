    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe shocking, deep aching pain with sharp stabs on certain movements, mainly over the top of the left shoulder to the mid upper arm and not past the elbow. Onset is unclear and timeline unreliable: reported as 1–2 weeks and also as at least a month. Severity approximately 7–8/10 at night and 5/10 during the day; wakes the patient from sleep. Worse when lying on the left side, with abduction, overhead work, and lifting tools. Heat pack helps somewhat; Panadol reported to have no effect."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left upper outer shoulder numbness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a numb “dead patch” over the left upper outer shoulder, starting a few days after the pain began."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Subjective left arm weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports subjective weakness and difficulty lifting a ladder, compensating with the right side."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies neck pain, shooting pain down the arm, tingling fingers, hand weakness, neck stiffness, chest pain, shortness of breath, jaw pain, diaphoresis, fever, weight loss, night sweats, recent neck injury, limb heaviness or clumsiness, gait change, and sphincter disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Telehealth observational findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Phone consultation only; no observations recorded. Voice comfortable at rest with occasional pauses or winces when describing movement. Speech and cognition okay; vague about dates and contradictory about duration. No audible shortness of breath or cough."
      }
    },
    {
