    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing generalized muscle pain flare over the last 2–3 weeks, involving the neck, shoulders, upper back, and occasionally the low back. Dull ache with intermittent sharp twinges; worse at the end of the workday and after long periods at the computer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep and night pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep mildly disturbed on some nights due to discomfort; no true persistent night pain regularly waking the patient."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported red-flag and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma, weight loss, fever, sweats, systemic symptoms, focal neurological symptoms including weakness, numbness, or sphincter change, chest pain, shortness of breath, abdominal pain, headache, and visual change. Appetite is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Patient-reported ergonomic and dietary concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks a new ergonomic chair might be making the pain worse; pain increased after it was installed. Reports increased coffee intake of 3–4 cups daily and worries that coffee is inflaming the muscles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, well appearing, in no distress, and mobilises freely."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly reduced rotation range of motion, limited by discomfort."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Muscle and spinal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Palpable taut bands and trigger points in upper trapezius and cervical/thoracic paraspinal muscles reproduce typical pain. No midline spinal tenderness. Thoracic/lumbar paraspinal localised myofascial tenderness; no bony tenderness or step."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion with mild discomfort at extremes; strength 5/5."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 in all limbs, normal tone, normal symmetrical reflexes, intact light-touch and pin sensation, and no focal deficit."
      }
    },
