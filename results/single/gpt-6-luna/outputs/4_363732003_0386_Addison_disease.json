        "code": {
          "text": "Orthostatic, cardiovascular, and respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dizziness on standing, syncope, presyncope, confusion, leg swelling, shortness of breath, chest pain, palpitations, and cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent febrile illness, surgery, major stressor, or trauma. Thirst and urination unchanged; denies polyuria, polydipsia, visual change, new headaches, seizures, focal neurological symptoms, myalgia, acute back pain, dysuria, and heat or cold intolerance beyond baseline. No significant change in menopausal-type symptoms; occasional mild hot flushes as previously attributed to hypogonadism from hypopituitarism. No known diabetes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
