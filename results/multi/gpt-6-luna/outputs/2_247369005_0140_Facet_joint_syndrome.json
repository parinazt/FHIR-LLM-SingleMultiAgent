        "status": "final",
        "code": {
          "text": "Lumbar back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent pain localized to the lumbar region, with a gradual-onset current flare for approximately 3 weeks and no trauma. Pain is 4/10 at baseline and up to 7/10 after prolonged sitting or driving. Exacerbated by extension and twisting; improved with heat pack, gentle stretches, and distraction. No radiation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported spinal red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies leg weakness, numbness or paraesthesia, saddle anaesthesia, bowel or bladder symptoms, fever, weight loss, and night sweats."
      }
    },
    {
