          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, redness, warmth, fevers, systemic symptoms, paraesthesia, neck pain, or elbow pain."
      }
    },
