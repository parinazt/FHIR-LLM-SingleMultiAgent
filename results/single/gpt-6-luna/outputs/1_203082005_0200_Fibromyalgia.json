    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowel symptoms for a few months. Baseline constipation, now alternating: no bowel movement for 2–3 days with hard/lumpy stool and straining, followed by 1–2 days of loose stool, 3–4 times daily and not watery. No nocturnal diarrhoea, PR blood, or melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Crampy lower abdominal pain, left greater than right, decreases after opening bowels or passing flatus. No weight loss, fevers, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Abdominal bloating and wind"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bloating and increased wind."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Urinary frequency for approximately 6 weeks, every 1–2 hours compared with previously every 3–4 hours; small volumes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Urinary urgency and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Urgency present. No dysuria, haematuria, flank pain, or fevers. No incontinence or retention symptoms."
      }
    },
