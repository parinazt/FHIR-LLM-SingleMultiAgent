    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Facial and anterior neck skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burn involves forehead, nasal bridge, both malar areas and anterior neck to upper chest, with a clear T-shirt line and safety-glasses border pattern consistent with flash burn. Forehead, nose and neck erythematous, warm and mildly tender, with intact sensation. Both upper cheeks have 2–3 cm healing superficial partial-thickness areas where blisters ruptured; now pink and moist, with no slough or pus. Skin soft; no circumferential neck burn, tight eschar, or clinical cellulitis. No charring; minimal singeing of eyebrows and sideburns. Estimated TBSA approximately 5–6%; supervisor separately estimated approximately 5%."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Burn-related symptoms and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Immediately after the injury, redness and tightness over cheeks, nose, forehead and anterior neck. Small blisters appeared on both upper cheeks on day 1 and popped spontaneously; now dry and tight with mild pain, approximately 3/10. Tightness when opening mouth wide and discomfort when shaving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief bright flash with spots in vision for a few minutes, then settled. Mild grittiness in both eyes on the first night, now resolved. Currently denies eye pain, photophobia, blurred vision, foreign-body sensation and decreased vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No periorbital oedema; lids open fully with no burns at lid margins. Conjunctiva mildly injected, no chemosis. PERRLA, EOMI, visual acuity grossly normal and able to read a poster. No photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Airway and respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hoarseness, dysphagia, shortness of breath at the time of injury or since, cough, and soot in the mouth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Airway and ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear, no soot or marked posterior pharyngeal erythema. Voice normal, no stridor. Neck supple and trachea midline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, chills, nausea and vomiting; reports feeling otherwise well."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General and cardiopulmonary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, well appearing, speaking in full sentences, no acute distress. Heart sounds dual with no added sounds. Chest clear bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grossly non-focal neurological examination; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Electrical incident history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "At work, a tool slipped while isolating a switchboard, causing a brief arc/flash 3 days ago. Patient reports no direct contact with live wires, loss of consciousness, fall, head strike or clothing ignition; felt intense heat to face and anterior neck."
      }
    },
