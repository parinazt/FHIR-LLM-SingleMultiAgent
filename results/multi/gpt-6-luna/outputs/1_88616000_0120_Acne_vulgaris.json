        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "At night; currently used about 5 nights per week. Plan to increase to nightly as tolerated: alternate nights for 1 week, then nightly."
          }
        ]
      }
