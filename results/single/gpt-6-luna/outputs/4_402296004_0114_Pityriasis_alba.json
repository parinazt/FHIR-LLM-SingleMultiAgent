        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected facial patches twice daily for 5–7 days, then stop. Avoid the periocular area. Use a fingertip unit; continue emollients ongoing.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
