        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heavy bleeding for the first 2–3 days, changing tampons approximately hourly. Cycle every 28–32 days, lasting 6–7 days. Denies intermenstrual bleeding and postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
