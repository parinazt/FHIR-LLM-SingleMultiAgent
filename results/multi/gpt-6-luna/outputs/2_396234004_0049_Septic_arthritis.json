    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left ear sore for 3/7, described as a dull ache with occasional sharp pain when chewing. Reduced hearing on the left and a blocked sensation. No discharge, tinnitus, vertigo, or URTI symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left external auditory canal mildly erythematous, with no oedema or debris. Tympanic membrane intact and slightly dull, with no bulge. Right ear NAD. No mastoid tenderness or lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible mild night sweats; no clear fevers. Patient reports feeling washed out and sleeping poorly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left knee symptoms and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left knee pain for 5–6/7, now severe; increased pain with weight-bearing and stairs. Difficulty getting on and off the couch; almost fell. Unable to fully weight-bear. No trauma. Patient reports no history of gout or inflammatory arthritis. Wife reports he has been much less mobile this week and will not complain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Obvious left knee effusion; warm and erythematous compared with the right. Very tender to palpation, especially medially and suprapatellarly. Markedly reduced range of motion, flexion approximately 45 degrees with almost no full extension. Passive movement painful. Unable to weight-bear without support. Distal neurovascularly intact. Other joints NAD."
      }
    },
