        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Pregabalin"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Start 75 mg at night for 3–5 days, then increase to 75 mg twice daily if tolerated and symptoms persist. Warned about sedation/dizziness; use caution driving and at work.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 75,
                  "unit": "mg"
                }
              }
            ]
          },
          {
            "text": "After the initial 3–5 days, increase to 75 mg twice daily only if tolerated and symptoms persist.",
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
