        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Good air entry bilaterally; vesicular breath sounds; faint scattered bibasal crackles, right greater than left. No focal coarse crepitations, wheeze, or percussion dullness."
      }
    },
