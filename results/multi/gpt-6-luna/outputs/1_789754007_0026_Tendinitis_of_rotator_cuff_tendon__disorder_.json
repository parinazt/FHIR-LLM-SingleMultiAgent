          "text": "Left shoulder active range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abduction to approximately 110° limited by pain; forward flexion approximately 130°; internal rotation to L5; external rotation mildly reduced."
      }
    },
    {
