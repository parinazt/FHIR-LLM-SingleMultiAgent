        "code": {
          "text": "Electrocardiogram"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "12-lead ECG today: sinus rhythm approximately 60 bpm; old Q waves consistent with previous MI; no acute ischaemia; no VT; QTc okay, not clearly increased."
      }
