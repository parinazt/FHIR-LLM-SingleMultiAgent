    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right posterior neck/upper shoulder pain for 5–6 days; insidious onset after a long day at a computer, possibly related to a new chair or sleeping awkwardly. Dull ache, 4–5/10, constant, with a sharp twinge when turning the head to the right or reversing a car. Worse at the end of the day and better in the morning and after a hot shower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Red flag symptom screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma; no arm pain, radicular symptoms, paraesthesia, or weakness; no headache, visual symptoms, dizziness, or facial symptoms; no chest pain, shortness of breath, or jaw/arm pain; no fever, weight loss, night sweats, or recent infection; no bowel/bladder change, gait issue, or fine motor clumsiness. No history of malignancy, inflammatory arthritis, or osteoporosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Telephone functional screen: neck range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck range of motion reduced on right rotation due to pain; flexion and extension okay but pulls a bit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Telephone functional screen: arm function and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Can lift arms above head, grip, type, and carry shopping. No dermatomal numbness or shooting arm pain reported."
      }
    },
