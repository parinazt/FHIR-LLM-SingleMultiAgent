        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Intermittent episodes of palpitations and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes occur 1–2 times per week, with sudden onset, peak over a few minutes, and last approximately 5–10 minutes. Symptoms include a racing heart, sweating, mild dizziness, and shortness of breath. Often occur in the evenings when alone or when thinking about health or an article about pregnant women and panic. Can occur at rest; no clear exertional link."
      }
    },
