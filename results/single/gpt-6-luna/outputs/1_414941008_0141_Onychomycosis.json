        "code": {
          "text": "Brief genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No costovertebral angle tenderness. No obvious external hernia. Testes non-tender with no swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Toenail and foot examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Both great toenails yellow-brown and thickened with distal involvement of approximately 40–50% on the right and 30–40% on the left. Some subungual debris and mild onycholysis. Other toenails mildly affected, less than 20%. No surrounding erythema, warmth or swelling. No obvious tinea pedis today."
      }
