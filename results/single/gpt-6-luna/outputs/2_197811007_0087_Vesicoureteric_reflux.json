        "code": {
          "text": "Rash and pruritus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for 5 days on both flexor forearms and a few spots on the anterior neck. Pruritus is worse at night and kept the patient awake. No previous similar rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, slightly raised papules and thin plaques on both flexor forearms, with some excoriations; sharp cut-off at the T-shirt line. A few similar papules on the anterior neck above the collar. No vesicles, crust, pustules, target lesions, or urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
