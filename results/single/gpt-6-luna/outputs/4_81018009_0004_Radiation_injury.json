        "code": {
          "text": "Reported pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional superficial burning pain at the end of work shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
