        "code": {
          "text": "Dizziness, nausea and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit off, dizzy, nauseated and fatigued. Intermittent lightheadedness, mild nausea and fatigue over 2–3 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
