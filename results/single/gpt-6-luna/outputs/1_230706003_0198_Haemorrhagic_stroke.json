        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, weight loss, night sweats, facial weakness, visual change, speech disturbance, new limb weakness, gait change, sudden severe headache, jaw claudication, scalp tenderness, temporal pain, sore throat, dental abscess symptoms, sinus symptoms, or recent upper respiratory infection."
      }
    },
