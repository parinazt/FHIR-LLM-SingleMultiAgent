    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Nocturnal enuresis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes in a wet bed 4–5 nights per week, with large volumes, usually around 3–5 am. Enuresis has occurred intermittently for about 1 year and is now most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Daytime urinary frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voids every 1–2 hours during the day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Voiding symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels like he is never properly empty; hesitancy, weak stream, straining, post-void dribbling, and occasional small-volume leakage if he holds urine too long. Symptoms ongoing about 6–8 months and worse over the last 3 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urinary symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, haematuria, fever, flank pain, and suprapubic pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurological symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neurological symptoms volunteered; specifically denies leg weakness, numbness, saddle anaesthesia, and visual change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Bladder diary: daytime voids"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three-day diary: 8–11 voids per day, mostly 150–250 mL, with a couple of voids up to about 350 mL."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Bladder diary: nocturnal voids and bedwetting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three-day diary: 0–1 nocturnal voids, but wet bed on 2 of 3 nights, with large volumes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Fluid and caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks about 2–2.5 L daily, including 3 coffees; last coffee is usually around 6–7 pm. Evening fluid restriction made little difference."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft; no palpable bladder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "External genitalia and testes normal; no obvious meatal stenosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower-limb screen grossly normal for power, reflexes, and sensation; gait normal. No back tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
