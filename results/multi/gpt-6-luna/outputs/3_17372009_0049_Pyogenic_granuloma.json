        "code": {
          "text": "Local tenderness at right index finger lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild local tenderness only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, systemic symptoms, spreading redness, or pus reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right index finger lesion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "5–6 mm bright red friable vascular papule on the dorsal right index finger near the PIP joint, with a narrow base approximately 1–2 mm and a small collarette of scale. Bleeds on light touch but stops with pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right index finger surrounding examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No surrounding erythema, warmth, induration, fluctuance, or discharge. Full range of motion; joint non-tender and no swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
