        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline burning and tingling pain approximately 5/10, increasing to 8/10 after work shifts; worse when the foot is down for long periods at work and somewhat better with elevation and cool packs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right foot skin sensitivity and allodynia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 3–4 weeks, skin is very tender and feels as if it is on fire when brushed, even by a sheet; unable to keep a sock on for long. Marked allodynia to light touch over the dorsum and lateral foot to just above the ankle."
      }
    },
