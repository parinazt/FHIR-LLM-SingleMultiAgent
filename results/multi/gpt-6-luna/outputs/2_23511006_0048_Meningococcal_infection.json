        "status": "final",
        "code": {
          "text": "Symptoms at illness onset"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 9 days ago: high fevers, severe headache, neck stiffness, photophobia, nausea and vomiting, and purple spots on legs and trunk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Current symptoms since discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since discharge 4 days ago: mild fatigue, needing a nap some days; occasional mild headache later in the day that settles with paracetamol; concentration feels a bit foggy with prolonged study but is improving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
