          "text": "Reported neurologic red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No numbness, saddle anesthesia, or bowel or bladder change reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
