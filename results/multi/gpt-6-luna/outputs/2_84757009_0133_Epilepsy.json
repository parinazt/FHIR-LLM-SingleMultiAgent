    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported focal events"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 3/52, events described as a weird feeling with jerking of the right arm and face, lasting 30–60 seconds. Patient remains aware and hears others; speech arrest or difficulty talking occurs. Post-event tiredness lasts a few minutes, without prolonged confusion. Mother reports these are the same as his usual events, just somewhat more frequent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Recent event frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three events last week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Last generalized tonic-clonic event"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 8/12 ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated event findings denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No loss of consciousness, generalized tonic-clonic activity, tongue bite, incontinence, or injury reported with the recent events."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Possible event triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep for approximately 1/12 due to worry; increased energy drink consumption, 2–3 cans/day, with a new brand."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Persistent neurological symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No persistent weakness, speech change, or vision loss reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Other acute symptoms and events denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new severe headache, fever, neck stiffness, or recent head trauma reported. No alcohol or illicit drug use reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Patient-reported health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is very anxious and scared that the events mean his brain is getting worse, and worries about a brain tumour or something serious and about status epilepticus going unnoticed. Repeatedly asked for MRI every few months. No suicidal ideation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth communication and brief screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Phone consultation only; no examination or vital signs obtained, and events were not directly witnessed. Patient spoke in full sentences, was mildly anxious, oriented, and chatting appropriately. No obvious dysarthria, word-finding problem, or confusion on brief phone screen."
      }
    },
    {
