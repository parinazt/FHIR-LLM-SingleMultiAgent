    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported behavioural change and sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 5–6 days, daughter reports he has been more withdrawn, not watching his usual TV, pacing and more fidgety especially in the late afternoon. Sleep is poorer, with waking and getting up overnight and increased grunting vocalisations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported lower abdominal and groin discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittently clutches lower abdomen/groin. When prompted about pain, patient said, “it's just a bit sore, nothing really, I don't want to be a bother” and “I've put up with worse”; clinician notes he tends to minimise pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Oral intake, hydration, urine output and bowel pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral intake reduced for 3 days but drinking adequately. Urine and bowel movements reported as usual. Carer reports formed bowel motions 1–2 times per day, with no diarrhoea or constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known fever, vomiting, change in bowel habit, visible haematuria or trauma. Carer reports no obvious dysuria, usual urine volume and colour, and no foul urine odour. No cough, shortness of breath, wheeze, new focal neurological symptoms, new rash or pressure areas. Daughter thinks the scrotal lump looks bigger again and is concerned continence pads may rub or compress it; daughter also wonders whether frozen dinners this week upset his stomach."
      }
    },
