          "text": "Systemic symptoms associated with rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, rigors, malaise, or arthralgia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
