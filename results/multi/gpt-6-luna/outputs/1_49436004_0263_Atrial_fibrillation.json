    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds I and II; irregularly irregular rhythm, rate approximately 80. No murmur, rub, or gallop. JVP not raised; no oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Barrel chest, decreased air entry bilaterally, scattered end-expiratory wheeze, and no crackles; described as consistent with baseline COPD."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Back and musculoskeletal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild thoracolumbar kyphosis. Local tenderness over lower lumbar paraspinals, right greater than left; no focal midline spinous tenderness. Flexion, extension, and lateral flexion reduced due to pain but possible. Straight leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Short-distance gait with four-wheel walker is antalgic but stable; no foot drop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 from L2–S1. Light-touch sensation intact; reflexes symmetrical; plantar responses flexor; no saddle anaesthesia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
