        "code": {
          "text": "Left pinna and periauricular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and fine scale of the conchal bowl and postauricular skin; mild tenderness of the pinna and tragus. No swelling, cellulitis, or fluctuance."
