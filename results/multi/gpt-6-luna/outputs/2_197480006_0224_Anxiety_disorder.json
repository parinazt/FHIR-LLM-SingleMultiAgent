    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Chest tightness and fluttering"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports intermittent mild chest tightness and fluttering when anxious, lasting a few minutes and settling with slow breathing and staff presence. Similar pattern for years and reported unchanged. No clear exertional component, radiation, diaphoresis, nausea, vomiting or collapse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Worry and anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling more on edge over the last few weeks and worrying about everything, especially memory and whether symptoms could be due to heart disease or cancer. Excessive worry most days, worse in the evenings and overnight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep and wakes 1–2 times per night with worry; settles after staff reassurance. No nightmares."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mood and enjoyment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling a bit low some days and still enjoys chats and television; no anhedonia for all activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies suicidal ideation today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Memory and word finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports losing words more often and worries she is going downhill quickly. Staff report no acute stepwise change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reassurance seeking about health"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repeatedly requested nursing staff check blood pressure and pulse during the past week in case of a heart attack; frequent reassurance seeking about health concerns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Other health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient expressed concern that the water smelled funny and might affect her nerves, and that an extra cup of tea at night might not be good for her heart. Reported googling chest tightness and reading that it could indicate cancer or a heart problem."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "RACF staff report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "RN reports no acute behavioural change and no falls. Short self-limiting anxiety episodes managed with reassurance. Eating and drinking okay. No recent infections or new medications."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Elderly woman, neatly dressed, mildly anxious, cooperative and engaging; pleasant with frequent reassurance seeking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmurs or rubs. JVP not elevated. No oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Alertness and orientation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person and place; unsure of exact date, stating “November sometime.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Speech and brief neurological screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech coherent. No focal deficit on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Affect and thought content"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Affect anxious and reactive; prominent health worries and catastrophic interpretation of benign symptoms. No delusions or hallucinations. Thought form mostly linear, with some tangentiality, returning to health worries."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Insight and judgement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partial insight: recognises anxiety but is concerned that something serious could be missed. Judgement fair for simple decisions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Prior cardiac investigations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Note reports a previously normal ECG and cardiology review approximately five years ago, and a normal stress test approximately five years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-25",
        "status": "final",
        "code": {
          "text": "Current examination and observations reassuring for acute illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Clinician documented no red flags for an acute organic cause of anxiety today; examination and observations were reassuring."
      }
    },
