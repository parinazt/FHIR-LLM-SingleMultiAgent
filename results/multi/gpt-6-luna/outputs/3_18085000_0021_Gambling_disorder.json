        "code": {
          "text": "Suicidal thoughts and intent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current suicidal ideation or plan. Reports occasional thoughts that it would be easier to disappear, but denies intent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
