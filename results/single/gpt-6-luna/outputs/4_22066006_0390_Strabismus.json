        "status": "final",
        "code": {
          "text": "Intermittent outward drift of the right eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing intermittent outward drift, more noticeable when tired or focusing at distance; notices it more in photos and when reading stories to children."
      }
    },
    {
