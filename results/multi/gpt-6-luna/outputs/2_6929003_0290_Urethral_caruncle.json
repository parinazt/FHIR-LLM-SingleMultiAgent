    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Shoulder has been a bit sore for about 3 months, gradual onset with no clear injury. Dull anterolateral ache with a sharp twinge on some movements. Wakes if she rolls onto the left side; difficulty hanging washing, reaching overhead, and doing her bra behind her back. No neck pain, radiation past the elbow, pins and needles, or true weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over greater tuberosity/subacromial area; AC joint non-tender. Active flexion approximately 120 degrees with pain; abduction approximately 100–110 degrees with painful arc approximately 70–120 degrees. Internal rotation limited (cannot reach bra strap); external rotation approximately 45 degrees with mild pain. Passive range of motion near full with end-range pain. Jobe/empty-can causes pain with mild weakness versus right; pain on resisted external rotation; Hawkins and Neer tests positive. Neck has full range of motion and no radicular signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Urinary and urethral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a little red lump at the urine opening for approximately 6–8 weeks and mild intermittent stinging at the end of urination. Reports two tiny spots of blood on paper last month, none since. No dysuria, frequency, urgency, visible blood in the toilet bowl, vaginal bleeding, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "External genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atrophic vulval skin. Small approximately 5–6 mm soft red polypoid lesion at the posterior lip of the urethral meatus, mildly tender to palpation, not friable, with no active bleeding or pus. No obvious prolapse."
      }
    },
