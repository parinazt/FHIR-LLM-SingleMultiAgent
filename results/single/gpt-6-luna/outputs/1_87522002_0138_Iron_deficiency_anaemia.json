          "text": "Response to self-care for cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over-the-counter lozenges and honey tea provided minimal benefit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
