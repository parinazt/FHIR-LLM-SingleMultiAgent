    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash appearance on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple well-demarcated raised erythematous violaceous plaques on cheeks and dorsal forearms, some coalescing; surface smooth. No obvious vesicles, pustules, crusting, or ulceration. No obvious facial swelling; lips and oral mucosa appear normal when mouth opened; no conjunctival injection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash began rapidly over a few days and remains present, slightly less tender than last week. Patient reports plaques look angrier in the evenings. Pain is burning and tender rather than itchy; paracetamol gives partial relief. No discharge, vesicles, or crusts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported systemic and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially had rigors and fatigue; recently feels washed out but a bit better. Appetite slightly decreased but drinking okay. Denies oral ulcers, eye pain, shortness of breath, chest pain, abdominal pain, diarrhoea, and urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance and respiratory findings on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appears tired but not acutely unwell; speaking in full sentences, no obvious shortness of breath, colour pink, no cyanosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Skin punch biopsy, forearm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dense dermal neutrophilic infiltrate with papillary dermal oedema. No leukocytoclastic vasculitis; organisms not seen. Features consistent with acute febrile neutrophilic dermatosis in the appropriate clinical context."
      }
    },
