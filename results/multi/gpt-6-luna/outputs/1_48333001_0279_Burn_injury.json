    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right forearm burn wound size and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right volar mid-distal forearm burn, approximately 6 x 8 cm, non-circumferential. ED note reports <2% TBSA. Wound bed pink and moist with early epithelialisation and brisk capillary refill. Mild serous ooze; no pus, malodour, warmth, or tenderness. Rim of 0.5–1 cm erythema, stable compared with PN photo 3 days earlier. Clean pink moist wound with no slough, eschar, or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash around right forearm burn dressing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports increased itch around the adhesive border over the last 2–3 days. Rash is in the exact shape of the adhesive border, erythematous, slightly raised and papular, and very pruritic. No vesicles or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported systemic and wound symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the burn itself is less painful; no fevers, rigors, or sweats; no spreading erythema up the arm; and no increased exudate. Reports a small amount of clear serous ooze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right wrist and elbow range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full wrist and elbow range of motion, with mild tightness at end-range flexion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
