    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported mood and depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 weeks: low mood, feeling flat and teary, poor sleep with early waking, decreased appetite while still eating two meals per day, low energy while continuing housework, and anhedonia. Stopped attending the seniors exercise group because of worry that something bad will happen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Health-related worries and checking behavior"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked worry about the femoral hernia, with repeated online searching and fixation on strangulation or cancer; repeatedly asks whether cancer could have been missed or more tests are needed. Checks and pokes the area multiple times daily, which increases the ache. Mood symptoms are mostly around health concerns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right groin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent right groin discomfort, worse when standing and settling with rest. Lump remains reducible when lying down."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported absence of hernia-related red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No severe abdominal pain, constant pain, abdominal distension, nausea or vomiting, constipation, difficulty passing wind, rectal bleeding, or fever. Bowels are okay and passing wind."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Anxiety-associated symptoms and cardiopulmonary review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No panic attacks. Reports heart racing when reading online. No chest pain, shortness of breath, or presyncope."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Suicidal ideation and future orientation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation and self-harm: says, “I don’t want to die, I’m just scared I might.” Future-focused, talking about Christmas, seeing grandchildren, and the surgical appointment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telephone mental status and observed presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with no audible shortness of breath. Thoughts coherent, speech normal, mood described as “worried and low,” affect congruent, and slight tremor in voice. No cognitive concerns apparent in conversation. Telephone examination was limited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Prior CT finding reported in previous notes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "CT in the emergency department approximately 3 months ago showed a small right femoral hernia, reducible and non-obstructing, per previous notes."
      }
    },
