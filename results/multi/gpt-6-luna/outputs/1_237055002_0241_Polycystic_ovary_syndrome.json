    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash under both breasts and in the groin folds, with a few spots under the abdominal apron. Present for approximately 5 days and slightly increased over the past 2 days. Itchy with slight burning, worse after work when sweaty in tight uniform. Patient describes red patches with tiny bumps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Possible rash triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible new washing powder; possible mango intake, but timing is unclear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Rash-associated symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, discharge, blisters, or pus. No fever, rigors, malaise, or arthralgia. No previous recurrent fungal skin infections reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-demarcated erythema in the inframammary and groin folds, with some peripheral scale and satellite papules, especially in the groin. Mild inframammary maceration. No pustules, weeping, fissures, cellulitis, or tenderness. No vesicles, urticaria, or widespread rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender. No right upper quadrant tenderness or organomegaly noted on limited examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Brief foot examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Skin intact; no ulcers or obvious infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported mood and energy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling stressed and tired. Denies low mood, anhedonia, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reported symptoms associated with known fatty liver"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies right upper quadrant pain, jaundice, and generalized pruritus."
      }
    },
