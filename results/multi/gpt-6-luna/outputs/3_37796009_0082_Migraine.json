    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insomnia for approximately 3 months, worse over the last 4–6 weeks. Reduced sleep onset and maintenance; lies awake for 1–2 hours, wakes 2–3 times per night, and gets approximately 4–5 hours of broken sleep. Bedtime varies from 2230 to 0100; wakes at 0600. Uses screens and watches TV in bed and sometimes falls asleep on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes with dry mouth and feeling unrefreshed; daytime fatigue. No near-miss driving reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep-disordered breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring. No witnessed apnoea or waking choking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Caffeine and alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 3–4 coffees daily, last at approximately 1600–1700, and occasionally has an energy drink. Drinks 1–2 glasses of wine 3–4 nights per week to wind down; reports sleep is still poor."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Worry at night"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worries about work at night and reports that her brain will not switch off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Headache frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headaches previously approximately 2 days per month; now 5–6 days per month over the last 2 months. Patient links increased frequency to poor sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Headache characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Typical headache is unilateral and throbbing, with nausea, photophobia, and phonophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
