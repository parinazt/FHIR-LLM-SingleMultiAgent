          {
            "code": {
              "text": "Approximately 18 months ago"
            },
            "valueString": "Sudden worsening of shuffling and balance over a day; did not return to previous baseline. Observed overnight in Newcastle emergency department; possible CT brain, report not available."
          },
          {
            "code": {
              "text": "Approximately 9 months ago"
            },
            "valueString": "Slurred speech and right hand not doing what he wanted for a few minutes; self-resolved, no emergency department visit."
          },
          {
            "code": {
              "text": "Approximately 3 months ago"
            },
            "valueString": "Woke with right leg weakness and needed a walker for about a week; improved but not back to baseline."
