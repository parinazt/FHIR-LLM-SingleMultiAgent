          "unit": "kg/m2"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right helix and upper antihelix examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6–7 mm firm, tender, dome-shaped nodule with superficial central erosion and slight scale/crust, mild surrounding erythema, and very focal tenderness to light pressure. No fluctuation or warmth. No obvious rolled edge or pearly lesion, but crust partly obscures the lesion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Regional nodes and ear canals/tympanic membranes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pre- or post-auricular nodes. Ear canals and tympanic membranes normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Brief examination of face, scalp, and dorsal hands"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious other suspicious lesions seen on brief examination; this was not a full skin check."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Skin cancer history and sun exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports heavy lifetime sun exposure, including years of driving with the window down and ears burning frequently. No known past skin cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.02% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to the lesion once daily for up to 2 weeks, then stop. For inflammation only, not definitive treatment.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "1 g up to four times daily as needed for nocturnal pain; maximum 4 g in 24 hours.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 4,
