        "code": {
          "text": "Fatigue and weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling weak and tired all the time for approximately 3–4 weeks. Fatigue occurs most days and is worse in the afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps 7–8 hours; sleep is non-refreshing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no shortness of breath, chest pain, palpitations, fever, night sweats, or weight loss. No red-flag symptoms reported in the history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Diet, hydration, caffeine, and activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diet described as poor, with increased toast and decreased vegetables. Drinks 3–4 coffees daily, has minimal water intake, and is very sedentary."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No menorrhagia reported. Mirena IUD in situ; periods are lighter."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel habits and constipation symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding constipation, worse over the last 2–3 months. Bowel movements approximately 1–2 times per week; Bristol stool types 1–2, marked straining, and incomplete evacuation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Bloating"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bloating, reduced after bowel movements."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
