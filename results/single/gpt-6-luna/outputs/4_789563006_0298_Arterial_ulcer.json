        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, systemic symptoms, and spreading redness. No current clinical evidence of infection noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
