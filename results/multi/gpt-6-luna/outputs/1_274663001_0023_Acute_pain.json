    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports pain remains about 7/10, described as a deep ache over the lateral/posterior left shoulder. Worse with overhead movement and reaching behind the back; sleep is disturbed, especially when lying on the left side. Patient says there has been no improvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation below the elbow or neck pain. No trauma beyond the initial lift, fall, or dislocation. No systemic symptoms, fever, weight loss, or night sweats. No chest pain, shortness of breath, or abdominal pain. No numbness, tingling, weakness, or loss of grip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reports getting really tired all the time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and frustrated; not in obvious distress at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left shoulder inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, swelling, erythema, or wasting. Tender over lateral deltoid insertion and upper trapezius. No bony tenderness over clavicle, AC joint, or humeral head; no warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction to about 110°, limited by pain; forward flexion to about 150°, painful at end range. External rotation mildly limited by pain; internal rotation painful when reaching behind the back. Passive range slightly greater than active, with pain only at end range and no hard block."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left shoulder strength and special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rotator cuff strength 5-/5, limited by pain but symmetrical; no focal weakness. Painful arc from 70–120°. Hawkins-Kennedy positive; Neer mildly positive; empty can painful with strength preserved. Speed and O'Brien tests equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full cervical range of motion, no tenderness, and Spurling test negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Upper limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Upper limb neurovascular examination intact."
      }
    },
