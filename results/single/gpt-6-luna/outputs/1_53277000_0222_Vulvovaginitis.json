          "text": "Vaginal discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially white and described as cottage-cheese-like; now much improved and minimal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Vulvovaginal burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burning at the introitus, largely settled."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vaginal odour or post-vaginal bleeding. Denies dysuria, urinary frequency, pelvic pain, abdominal pain, fever, rigors, and dyspareunia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Perianal itch and evidence of worms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No perianal itch on waking; no worms seen in stool or around the anus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no masses or suprapubic tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema of labia majora and minora with excoriations from scratching. No fissures, ulcers, vesicles, or suspicious lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema from scratching; no worms, ova, burrows, or haemorrhoids."
      }
    },
