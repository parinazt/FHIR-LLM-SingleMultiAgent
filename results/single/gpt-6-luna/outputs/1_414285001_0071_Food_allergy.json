    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent solid-food dysphagia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for approximately 6–9 months. Food feels stuck mid-chest, especially bread and meat; needs sips of water and occasionally regurgitates food back up. Two episodes in the past month required standing and coughing food back out; patient thought she was choking but could still breathe. No complete obstruction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Chest tightness associated with swallowing episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central chest tightness during swallowing episodes, settling 10–15 minutes after food passes. Not exertional and not associated with walking uphill."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Retrosternal burning approximately 2–3 times per week, especially after late takeaway meals; worse with coffee and spicy food, with some relief from Gaviscon. Occasional globus sensation, especially at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported food-associated allergic-type episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "In the past 6–9 months, three episodes after certain meals, possibly including almond milk while eating out: itchy throat, mild perioral tingling, and patchy erythematous itchy rash on forearms about 1 hour later. Felt a little wheezy with chest tightness. No stridor, collapse, or gastrointestinal symptoms. Episodes resolved without medication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Historical egg allergy reaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Raw or undercooked egg has caused hives and lip swelling approximately 30 minutes after exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
