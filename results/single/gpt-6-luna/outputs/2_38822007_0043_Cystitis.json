        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Localised irritant/contact dermatitis versus shaving irritation or friction dermatitis of suprapubic and upper groin area"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dysuria described as burning when urinating, increased frequency every 1–2 hours, urgency with small volumes, and suprapubic discomfort."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Urinary and systemic symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No haematuria, incontinence, flank pain, fever, chills, or rigors; no nausea or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Rash symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two-day history of erythematous rash over suprapubic area and groin along underwear line, described as stingy with mild itch and worse after hot showers. Began after a change in washing powder about one week earlier; pubic area shaved with a disposable razor three days earlier. Rash is localised, with no mucosal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Video skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief, limited video view showed poorly demarcated erythema over the suprapubic area along the underwear/shaving zone. No vesicles, obvious pustules, ulcers, or cellulitis seen on video; assessment limited by camera and lighting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-performed abdominal and flank examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reported mild suprapubic tenderness on self-palpation and no costovertebral angle tenderness on self-percussion. Full abdominal examination was not possible by telehealth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, chills, rigors, or weight loss reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gynaecological symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No abnormal vaginal discharge, odour, itch, bleeding, postcoital bleeding, or deep dyspareunia reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, orientated, well appearing, speaking in full sentences; appeared adequately hydrated, with no obvious pallor or jaundice."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Intermittent headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly mentioned intermittent tension-type headaches on night shifts; not explored fully during this consultation."
      }
    },
