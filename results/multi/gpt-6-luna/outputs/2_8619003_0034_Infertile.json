        "status": "final",
        "code": {
          "text": "Penile pain with intercourse and ejaculation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 8–9 months: pulling, burning pain in the penile shaft toward the tip with penetration and ejaculation, especially right when finishing. No pain at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Perineal ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild ache after intercourse, rated 2/10 and described as feeling like being kicked there; patient says it is not bad."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Genitourinary symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sores, ulcers, discharge, dysuria, haematuria, and haematospermia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Erectile function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual erectile difficulty for approximately 12 months, with difficulty getting and keeping an erection; worse with stress. Some morning erections remain but are not as strong as previously."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Time trying to conceive and pregnancy history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Trying to conceive with wife for approximately 18 months with regular unprotected sex and no pregnancies. They use apps to time ovulation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
