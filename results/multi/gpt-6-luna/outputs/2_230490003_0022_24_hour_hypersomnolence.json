    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central low lumbar pain, slightly to the right, for about 2 weeks; gradual onset, dull ache that can be sharp with bending. Up to about 6–7/10 if pushed, but mostly described as annoying. Worse after long periods at a desk and lifting shopping; slightly stiff for the first 10–15 minutes in the morning, then eases. Patient thinks it may relate to a new office chair or sleeping awkwardly on the couch. Still working part-time and avoiding heavier jobs at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg pain, pins and needles, weakness, bowel or bladder change, saddle numbness, fevers, weight loss, night sweats, or trauma."
      }
    },
