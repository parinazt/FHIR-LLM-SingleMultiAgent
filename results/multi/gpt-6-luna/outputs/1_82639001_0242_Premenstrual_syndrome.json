    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Acute illness symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 6 days ago, sudden subjective fevers with sweats, myalgias, and mild headache; fever began just before menses and settled by day 2 of bleeding. Fever last week is now resolved. No thermometer was used. Nasal symptoms and scratchy throat lasted 2–3 days and have resolved; mild dry cough was reported. Today feels mostly back to normal, just a bit tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Symptoms denied during acute illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath beyond usual mild asthma, urinary symptoms, gastrointestinal symptoms, rash, or rigors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Premenstrual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding symptoms 7–10 days before menses: increased irritability, tearfulness, feeling unable to cope at school, breast tenderness, bloating, and more migraines. Symptoms improve by day 1–2 of bleeding. Regular 28–30-day cycles. Significant functional impact at school. Mood is okay between periods. No suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Migraine history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Migraine without aura, 1–2 times per month, clustering in the premenstrual week. No red flags reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
