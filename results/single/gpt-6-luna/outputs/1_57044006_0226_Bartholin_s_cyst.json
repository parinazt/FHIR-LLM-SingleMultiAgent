        "code": {
          "text": "Cough and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for 7 days; began with a sore throat, now resolved. Mild coryza and intermittent headache. Sleep broken by cough, especially at night. Denies shortness of breath, chest pain, wheeze, fever, and haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Cough risk history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-smoker; vapes on weekends. No weight loss, night sweats, TB contact, recent overseas travel, asthma/COPD, or CCF reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
