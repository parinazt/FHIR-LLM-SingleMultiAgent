    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Past intermittent flexural dermatitis during teenage years"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "inactive"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports dysuria described as burning when urinating, increased frequency every 1–2 hours, urgency, small-volume voids, and suprapubic discomfort."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Negative urinary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies haematuria, incontinence, flank pain, fever, chills, rigors, nausea, and vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a stingy, mildly itchy rash over the suprapubic area and groin along the underwear line; worse after a hot shower. Reports no mucosal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Video skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief, camera- and lighting-limited view showed poorly demarcated erythema over the suprapubic area along the underwear/shaving zone. No obvious vesicles, pustules, ulcers, or cellulitis visible."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient self-examination of abdomen and flanks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reported mild suprapubic tenderness on self-palpation and no costovertebral angle tenderness on self-percussion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On video, alert, oriented, well appearing, speaking in full sentences; hydration appeared adequate. Pink colour with no obvious pallor or jaundice."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gynaecological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies abnormal vaginal discharge, odour, itch, postcoital bleeding, and deep dyspareunia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Briefly reports intermittent headaches on night shifts; not explored fully during this consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Pregnancy possibility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports possible pregnancy but considers the likelihood low; no pregnancy test documented."
      }
    },
    {
