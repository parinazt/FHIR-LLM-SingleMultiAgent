        "code": {
          "text": "Occupational hand dermatitis, assessed as mixed irritant and probable allergic contact dermatitis related to hairdressing chemicals and occlusive glove use; mild-to-moderate flare, not infected"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
