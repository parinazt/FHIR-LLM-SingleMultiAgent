        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert; mobilising independently with normal gait; able to transfer on and off bed unaided; GCS 15 and grossly non-focal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Oral intake and speech"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech clear in full sentences; eating soft foods only because of pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Parotid and facial examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral parotid swelling, left greater than right; tender and firm but not hard. Skin intact, with no erythema, obvious warmth, or fluctuance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Jaw, oral cavity, and dental examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No submandibular swelling. Full jaw range of motion and mouth opening; no trismus, with discomfort at end range of chewing. Stensen ducts mildly erythematous with clear saliva and no pus expressed. Dentition okay; no obvious caries or abscess. Oropharynx clear and tonsils normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Ear and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tympanic membranes intact and non-erythematous. Full neck range of motion; no meningism. Mildly tender, small, mobile bilateral preauricular lymph nodes; no significant cervical lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
