        "code": {
          "text": "Trigger finger of right ring finger (stenosing tenosynovitis)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ring finger pain, locking, stiffness and clicking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms for 4–5/12. Worse in the morning, with stiffness for 10–15 minutes that then eases. Pain up to 7/10, although the patient describes it as “only a bit sore”. Clicking/popping and locking, sometimes needing the left hand to straighten the finger. Worse after long days of paperwork or phone use and when lifting grandchildren."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and injury history for right ring finger"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, numbness or tingling, weakness, fevers, or spreading redness reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Focused examination of right ring finger"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild volar fullness at the MCP/A1 pulley with a palpable tender nodule. No erythema or warmth. Partial fist only; triggering from flexion to extension, requiring assistance on 2 of 3 attempts. Passive range of motion full and mildly tender. Palpable/audible click."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other focused hand and neurological examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact. Grip slightly decreased due to pain. No carpal tunnel syndrome signs. Other small joints of hands, wrists and elbows with no abnormality detected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Vital signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vital signs stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right hand X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fracture or dislocation. Mild interphalangeal osteoarthritis only; no erosions."
      }
    },
