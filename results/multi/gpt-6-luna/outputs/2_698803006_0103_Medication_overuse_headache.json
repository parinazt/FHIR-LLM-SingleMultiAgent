    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Headache history and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of migraine since late teens, previously 1–2 episodes per month. Over the last 4–5 months, headaches have occurred most days. Current pattern is a dull, band-like baseline ache most days with superimposed typical migraine 1–2 times per week. Headache is reported on at least 15 days per month. The migraine character is otherwise unchanged, with increased frequency and background daily pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Migraine features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Historically right-sided throbbing headache associated with photophobia and nausea, relieved by sumatriptan."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Headache response to analgesia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache improves for a few hours after tablets, then returns as the medication wears off, sometimes worse, typically 4–6 hours after a dose."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Timing of headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes with a mild headache several mornings per week; after taking analgesia mid-morning, it improves and returns in the late afternoon or evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap onset, worst-ever headache, focal neurological symptoms, speech disturbance, limb weakness, visual loss, fever, neck stiffness, head trauma, seizures, personality change, weight loss, or nocturnal headache waking her."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps 6–7 hours per night, often broken by young children."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Mood and psychological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels 'a bit worn down' by constant pain. Denies pervasive low mood, anhedonia, anxiety attacks, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, well, not in acute distress, and conversant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves II–XII intact. Power 5/5 in all limbs. Tone, reflexes, coordination, and gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
