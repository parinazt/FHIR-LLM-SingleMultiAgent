      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime pain is about the same, a mild ache increased by sitting too long at a desk. For 3–4 weeks, more aware of pain at night when trying to sleep. Localized to the low lumbar region, right greater than left, non-radicular; dull ache with occasional sharp twinge on extension or twisting in bed. Daytime pain described as a bit worse at night lately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep; wakes 1–2 times to change position, then returns to sleep. Reports frustration; mood is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Possible contributors to sleep and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "New firmer mattress approximately 2 months ago; drinks two late-evening coffees."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurologic and cauda equina symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg weakness, numbness, bowel or bladder symptoms, and saddle anesthesia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Systemic red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies weight loss, fever, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Localized tenderness over lower lumbar facet joints, right greater than left; no midline tenderness. Mildly reduced flexion with end-range ache. Extension and rotation reproduce local pain only, with no radicular symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Lower limb neurologic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower limb power 5/5, reflexes normal, sensation intact, straight leg raise negative bilaterally, and gait normal."
      }
    },
