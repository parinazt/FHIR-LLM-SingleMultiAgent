    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Nasal and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms for about 4 days: frequent sneezing, blocked nose, clear rhinorrhoea, mild itchy eyes, and mild frontal pressure when bending forward. No purulent nasal discharge, facial or tooth pain, or anosmia. Symptoms slightly increased at work and decreased away from the office; patient thought possible triggers were workplace air conditioning or jasmine outside her unit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors; appetite okay. A little tired, attributed to poor sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Respiratory and chest symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cough, shortness of breath, wheeze, or chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nasal and oropharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal mucosa boggy; turbinates congested, pale pink, and swollen, with clear rhinorrhoea. No purulent nasal discharge or sinus tenderness. Mild post-nasal drip; no tonsillar exudate or marked erythema. Tympanic membranes normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry; no wheeze or crackles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
