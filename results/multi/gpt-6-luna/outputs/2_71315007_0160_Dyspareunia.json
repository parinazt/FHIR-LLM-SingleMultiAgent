        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-looking; appeared clearly time-pressured and was checking her phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild suprapubic/low pelvic tenderness on deep palpation. No guarding, rebound, or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Labia majora and minora normal; no lesions or fissures. Mild vestibular erythema from 4 to 8 o'clock. No discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Hymenal tissue examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small crescentic hymenal remnant at the posterior introitus, slightly thicker but non-obstructive and appearing within normal anatomical variation. No active fissure or bleeding; tissue not rigid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Cotton swab test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked allodynia of the vestibule, especially at 5–7 o'clock and just lateral to the urethral meatus. Patient withdrew and described sharp burning pain with light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Single-digit pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased pelvic floor tone with marked guarding. Finger advancement was difficult and deep palpation was limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Speculum examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speculum examination was only partially attempted; patient was very uncomfortable and requested that it stop. Cervix appeared grossly normal from the limited view. No obvious discharge. No cervical motion tenderness on minimal movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Bimanual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not completed because of pain and time constraints."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Urine pregnancy test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dataAbsentReason": {
          "text": "Not performed; patient declined, stating she was confident she was not pregnant, uses condoms, and had just finished her menstrual period."
        }
      }
    },
