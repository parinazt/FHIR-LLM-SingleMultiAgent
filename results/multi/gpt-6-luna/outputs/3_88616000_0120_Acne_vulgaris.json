          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Acne vulgaris – mild, improving on topical treatment; mainly post-inflammatory erythema/macules with early superficial scarring"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Polycystic ovary syndrome (PCOS) – stable, with mild cycle irregularity"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Acne lesions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports fewer new pimples; occasional small pustule around the period. Examination: few closed comedones and small inflammatory papules on the face, with a few papules on the upper back. No nodules or cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Post-inflammatory marks and scarring"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple erythematous/light-brown macules on the face and macules on the upper back; mild early shallow atrophic scars on both cheeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Patient concern about skin marks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worried that the red marks and small scars may be permanent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Adapalene-associated skin effects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Experienced dryness and peeling during the first 2 weeks of adapalene use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-perceived acne triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thinks chocolate, coffee during exam time, and cheap chemist sunscreen may flare acne."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Body image and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A bit self-conscious and avoids photos on bad days, but continues university and work. Denies low mood and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menstrual cycle interval"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cycles currently approximately every 35–45 days; previously every 60–90 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Historical ovarian ultrasound finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports polycystic ovaries on ultrasound at the time of prior PCOS diagnosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Historical androgen finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports elevated androgens in the past."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Hirsutism and virilisation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No increased hirsutism reported; no obvious hirsutism or virilisation on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Infection on examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No infection noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Body mass index"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 23 kg/m²."
      }
    },
    {
