    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Dyspareunia and pain pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dyspareunia on approximately 9–10 of 12 attempts, now occurring on most attempts. Superficial and deep pain: sharp burning at the entrance followed by a deeper ache; worse with initial penetration and certain positions. Pain can linger for minutes to hours after sex."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies postcoital bleeding, dysuria, urinary frequency, abnormal vaginal discharge, odour, itch, fever, systemic symptoms, bowel change, rectal bleeding, severe dysmenorrhoea, and urinary incontinence. No cyclical pelvic pain outside menses and no previous dyspareunia in earlier relationships."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Patient-reported possible onset context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wonders whether symptoms began after antibiotics for a chest infection last year and whether vaginal flora may be involved; no clear history of thrush and currently asymptomatic for thrush-type symptoms. Patient thinks prolonged standing at work and abdominal clenching may contribute."
      }
    },
