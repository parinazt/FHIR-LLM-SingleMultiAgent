        "code": {
          "text": "Left shoulder inspection and tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No erythema or obvious warmth. Local tenderness over the greater tuberosity/subacromial area. AC joint non-tender."
      }
    },
    {
