    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported rash and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash for 4 days: itchy red papular rash on anterior neck and upper chest, with a few spots on upper back/bra line. Patient reports it started the day she wore a new top, which felt scratchy. No fever, shortness of breath, facial or tongue swelling, or blisters."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous papules/plaques on anterior neck and upper chest, with a few on upper back. No vesicles, weeping, infection, or mucosal/facial involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain for approximately 3 months, worse over the last 2–3 weeks. Bilateral lower cervical/upper trapezius aching and stiffness with a 'knot' feeling, rated 4–6/10 and worse at the end of the workday. Desk job with long hours at a computer and forward-leaning posture. No arm pain, paraesthesia, weakness, headache, trauma, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender paracervical/upper trapezius muscles; no midline cervical spine tenderness. Range of motion reduced only at extremes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Upper limb neurological and gait examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Upper limb power 5/5, reflexes normal, sensation intact, Spurling test negative, and gait normal."
      }
    },
