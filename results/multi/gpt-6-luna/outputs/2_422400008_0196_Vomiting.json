    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Weakness and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling weak and tired for approximately 5 days, feeling wiped out and drained, with reduced energy and difficulty getting through the workday."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea began 5 days ago; vomiting for 4 days, peaking over 2 days at 5–6 episodes per day, initially food then bile. Vomiting is now largely settled; last episode was yesterday morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Oral intake and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced oral intake and appetite during the recent illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy epigastric pain occurred only during vomiting and has now resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools 1–2 times per day during the worst of the illness; now back to usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Postural symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels shaky, especially on standing, and light-headed when moving quickly from sitting to standing. Mild dizziness on standing during examination; symptoms improve with a pause."
      }
    },
