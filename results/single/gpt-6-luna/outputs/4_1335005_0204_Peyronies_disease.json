    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Back pain onset and duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 5–6 days ago; no clear injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain location and radiation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central mid–lower back, slightly right-sided; no radiation to the legs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Back pain character and severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull, tight ache; 4–5/10 at baseline, up to 7/10 after a big work day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Back pain timing and aggravating factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse at the end of the day on concrete and first thing in the morning; aggravated by bending, lifting, ladders, tools, prolonged standing, driving on a rough farm track, and possibly a new firmer mattress and increased ute driving on a rough driveway."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Back pain relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eases somewhat after moving; relieved by lying flat, a heat pack, and Nurofen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Back pain functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working and pacing himself, avoiding heavy lifting; no time off work yet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By history, no trauma or fall; no saddle anaesthesia, leg weakness or numbness; no bowel or bladder incontinence or retention; no fevers, night sweats, weight loss, unrelenting nocturnal pain, known cancer, or systemic illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported mobility and neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mobilising okay and being able to heel-toe walk, squat, and climb stairs; no limb weakness, paraesthesia, or gait disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported fatigue and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fatigue only in the context of poor sleep due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Urinary stream normal; no frequency or urgency; nocturia unchanged from baseline of once nightly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Peyronie's curvature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Curvature about the same over the last few months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Erectile function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erectile symptoms described as taking a bit more effort; no complete erectile dysfunction; some discomfort with intercourse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Penile and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No penile pain at rest, haematuria, dysuria, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Telehealth examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Physical examination not possible today; telehealth only. Speech coherent and engaged, asking appropriate questions, and in no distress over the phone."
      }
    },
    {
