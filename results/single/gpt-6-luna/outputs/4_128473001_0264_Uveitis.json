        "code": {
          "text": "Visual acuity, left eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6/18, improving to approximately 6/12 with pinhole on an in-room Snellen chart."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
