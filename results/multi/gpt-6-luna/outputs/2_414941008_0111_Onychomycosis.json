        "status": "final",
        "code": {
          "text": "Current skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild flare on the shins and behind the ears; no ooze or systemic symptoms."
      }
    },
