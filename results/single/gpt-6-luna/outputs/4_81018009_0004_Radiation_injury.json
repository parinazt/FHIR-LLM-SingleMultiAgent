        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, chills, weight loss, or night sweats. No dysphagia, nausea, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Occupational radiation exposure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of occupational diagnostic radiation exposure, with no radiotherapy. The affected area corresponds to where the patient rests cassettes/portable equipment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right upper abdominal/chest wall skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 8 x 6 cm area just inferior to the right costal margin with mild patchy erythema, slight oedema, peau d’orange, increased pigmentation, mild thickening, and mild superficial tenderness to palpation. No deep induration, warmth, fluctuance, or ulceration."
      }
    },
