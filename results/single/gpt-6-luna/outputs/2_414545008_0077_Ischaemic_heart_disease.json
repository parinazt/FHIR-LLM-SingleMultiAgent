        "status": "final",
        "code": {
          "text": "Exertional chest discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent chest tightness across the chest with increased exertion, such as hurrying for the bus; occurs at a predictable threshold and settles within a few minutes of rest. No rest pain, radiation, diaphoresis, syncope, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild exertional shortness of breath, unchanged and settling quickly with rest. No orthopnoea or paroxysmal nocturnal dyspnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
