    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue and weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased fatigue for approximately 3–4 weeks; feels “wiped out by arvo.” Activities of daily living remain possible but are slower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, shortness of breath, palpitations, oedema, weight loss, fevers, night sweats, PR bleeding, melaena, or recent travel. Mood okay; no suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mixed urinary incontinence, urgency-predominant: urgency with small-volume leakage and some stress leakage; uses 3–4 pads/day. Nocturia twice nightly. No retention symptoms, dysuria, haematuria, loin pain, or fever. No new lower urinary tract symptoms apart from longstanding urgency/incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels variable, with a mix of loose and formed stools; no current PR blood. History of faecal impaction twice, noted as last 12/12 in the source note."
      }
    },
