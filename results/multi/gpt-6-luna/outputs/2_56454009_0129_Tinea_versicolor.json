        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent frontal/retro-orbital headache for approximately 1–2 weeks, possibly longer. Pressing, band-like; worse at the end of shifts and with bright lights or screens. Partially improves with over-the-counter analgesia; dose uncertain. Mild nausea and photophobia when severe."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Headache-associated negative symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap headache, headache waking from sleep, or recent head trauma. No vomiting, focal neurological symptoms, speech change, limb weakness or tingling, neck stiffness, or fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep, meals, and caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleeping 5–6 hours, skipping meals, and high coffee and energy drink intake."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin concern reported by patient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports white patches on the upper back and shoulders for approximately 1–2 years, worse in summer, with mild itching when sweating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance and mental status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no apparent distress, alert; GCS 15."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves II–XII intact. Power 5/5 in upper and lower limbs. Tone, sensation, coordination, and gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "HEENT and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No meningism; full neck range of motion. Sinuses non-tender. Tympanic membranes and nose normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Fundoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited fundoscopy; discs sharp, no obvious papilloedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Upper back and shoulder skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple well-demarcated hypopigmented macules and patches with fine scale, some coalescing; evoked scale present, no erythema."
      }
