        "code": {
          "text": "Allergic contact / atopic-type hand dermatitis, occupationally aggravated, mild to moderate"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported nasal and eye symptoms and associated negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 weeks: sneezing, nasal blockage, clear rhinorrhoea, itchy nose and eyes; worse in the morning and at school. No fever, facial pain, purulent discharge, cough, shortness of breath, or wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep affected by nasal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep mildly affected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "General and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no distress. Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal mucosa pale and boggy, with clear discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild conjunctival injection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hand dermatitis history and reported triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known allergic/irritant dermatitis; flare for 1–2 weeks since cleaning roster change at school. Worse with wipes and sprays, better on weekends. No patch testing done."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, scaly plaques on the dorsum and between the fingers, with mild lichenification and excoriations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Hand examination negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vesicles, crusting, pustules, or spreading erythema. No systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Other concerns reported but not addressed at this visit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fatigue, right shoulder pain, mole on back, plantar foot pain, and bloating; contraception review also requested."
      }
    },
    {
