        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, urinary frequency, or haematuria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels opened this morning with normal stool. No PR blood or mucus, diarrhoea, constipation, or obstipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Abdominal distension"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No bloating beyond usual post-meal bloating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gynaecological symptoms and pregnancy history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "LMP about 2 weeks ago; regular cycles. No PV bleeding, discharge, or pelvic pain. Pregnancy queried/denied; patient reports her husband had a vasectomy years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Abdominal pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sudden-onset tearing pain, chest pain, shortness of breath, dizziness, syncope, jaundice, dark urine, or pale stool. Pain remains central / epigastric and has not consistently localised to the right lower or right upper quadrant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Functional impact of abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to work today but uncomfortable; ate very little at lunch. Pain increases slightly with bending but is not clearly localised to one quadrant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
