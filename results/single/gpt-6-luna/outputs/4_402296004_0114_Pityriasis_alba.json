        "code": {
          "text": "Upper arm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few faint hypopigmented patches on the upper arms with minimal scale."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
