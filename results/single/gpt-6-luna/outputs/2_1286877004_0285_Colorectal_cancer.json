      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Spironolactone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Oncology letter from 3 weeks earlier lists 50 mg once daily; patient-described regimen was uncertain and possibly 50–100 mg once daily. Current regimen to be confirmed."
          }
        ]
      }
    },
    {
