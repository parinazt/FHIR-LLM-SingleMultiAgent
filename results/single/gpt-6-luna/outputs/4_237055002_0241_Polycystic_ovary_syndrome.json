    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash with slight burning under both breasts and in the groin folds, with a few spots under the abdominal apron. Onset approximately 5 days ago; slightly increased over the past 2 days and worse after work when sweaty in tight uniform. Patient describes red patches with tiny bumps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Possible rash triggers reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible new washing powder and possible mango intake; timing of the possible triggers is unclear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-demarcated erythema in inframammary and groin folds, some peripheral scale and satellite papules especially in the groin; mild inframammary maceration."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated rash symptoms and examination negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, discharge, blisters or pus reported. No pustules, weeping, fissures, cellulitis, tenderness, vesicles, urticaria or widespread rash on examination."
      }
    },
