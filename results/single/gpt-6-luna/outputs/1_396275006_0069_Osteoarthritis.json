    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 3 months of central/paraspinal lumbar ache with deep stiffness, more noticeable over the last 4–6 weeks. Baseline pain 3/10, flaring to 6/10. Worse with standing and walking; better with sitting and stretching. Morning stiffness lasts about 10 minutes and then eases. Cutting back on longer walks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clear injury. No leg radiation, pins and needles, weakness, saddle numbness, bladder or bowel issues, fever, weight loss, night sweats, or pain waking her from sleep. No trauma, cancer history, systemic symptoms, neurological deficit, or sphincter disturbance elicited."
      }
    },
