        "status": "final",
        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No redness or swelling, Achilles pain, neurological symptoms, or systemic symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
