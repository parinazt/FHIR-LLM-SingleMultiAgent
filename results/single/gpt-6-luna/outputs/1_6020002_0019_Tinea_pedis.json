        "code": {
          "text": "Foot burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild burning at the end of a shift in boots."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Groin itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild groin itch, described as nowhere near as bad as the toe symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Foot examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: bilateral 4th–5th toe web spaces with white macerated skin, mild scaling and slight erythema at the edges; no obvious fissures, weeping or pus. Nails visible on video appeared okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-reported foot symptoms and associated findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Interdigital symptoms affect both feet, right worse than left. Patient reports no spread up the foot, nail changes, breaks or ulcers, discharge, or malodour."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Systemic and leg symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no fevers, rigors, red tracking, or calf pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and in no apparent distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Foot sweating and footwear"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very sweaty feet; wears heavy steel-cap boots for 12–14 hours daily and synthetic work socks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Using approximately once daily for approximately 2 weeks on the feet; often forgets twice-daily use, especially on night shifts.",
            "route": {
              "text": "topical"
            }
          },
          {
            "text": "Using the same cream as needed for groin itch.",
            "route": {
              "text": "topical"
            },
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply twice daily to toe webs and a 1–2 cm margin for a minimum of 14 days, then once daily for 1 week after clear.",
            "route": {
              "text": "topical"
            }
          },
          {
            "text": "Apply once daily to the groin for 2–4 weeks.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    }
