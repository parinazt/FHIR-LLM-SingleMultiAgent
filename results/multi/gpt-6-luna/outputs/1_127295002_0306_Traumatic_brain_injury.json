    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Throat sensation and discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a persistent 'weird' sensation as if something is stuck in the throat; throat pain has mostly settled and is now 1–2/10. Occasional mild scratchy feeling midline just above the sternal notch, not increasing. Symptoms began about 3 weeks ago with an initial URTI; pain is worse later in the day and better in the morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports swallowing is okay and food goes down fine; occasionally feels a little tight. Denies dysphagia to solids or fluids and denies odynophagia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Voice and throat clearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports mild hoarseness some evenings after work; otherwise voice is normal. Occasional dry throat-clearing cough, especially in the afternoon/evening; no nocturnal cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heartburn a few nights per week, especially after spicy or fatty takeaway meals and late meals. Denies regurgitation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Constitutional and respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, chills, weight loss, night sweats, haemoptysis, shortness of breath, chest pain, and appetite change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Throat red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies progressive dysphagia, unilateral otalgia, neck mass, stridor, drooling, and trismus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Oral and pharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral mucosa moist, with no ulcers or thrush. Tonsils normal, with no erythema or exudate. Uvula midline. Mild posterior pharyngeal cobblestoning; no visible mass or lesion."
      }
    },
    {
