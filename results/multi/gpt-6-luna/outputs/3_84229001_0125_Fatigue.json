        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports non-restorative sleep, sleeping 6–7 hours most nights and waking once. No difficulty initiating sleep. No loud snoring reported, no witnessed apnoea, and no morning headaches."
      }
    },
