    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry eczematous skin, especially neck, antecubital fossae, and hands. Superimposed widespread monomorphic vesicles and punched-out erosions with crusting on an erythematous base over face, neck, upper chest, upper back, and proximal arms, some coalescing. Very tender to light touch; patient winces. No vesicles on fingertips. No classic honey-coloured crust or frank pus; some lesions have mild surrounding erythema, with possible bacterial superinfection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Perioral and oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few small perioral erosions; no obvious large intraoral ulcers, although patient reluctant to open mouth wide. Oral mucosa mildly erythematous, without widespread ulceration or thrush."
      }
    },
