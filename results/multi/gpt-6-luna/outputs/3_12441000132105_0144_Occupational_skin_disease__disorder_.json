        "code": {
          "text": "Occupational hand dermatitis, likely mixed irritant and probable allergic contact dermatitis from hairdressing chemicals and occlusive glove use; mild-to-moderate flare, not infected"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
