    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Nasal and eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two days of bouts of sneezing, clear rhinorrhoea, nasal blockage, and mild nasal and eye itch. Symptoms worse working front of house in a busy cafe."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nasal symptoms and treatment reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Took over-the-counter loratadine yesterday with minimal benefit; using saline nasal spray. COVID vaccination up to date including booster. Rapid antigen test this morning negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sudden onset at about 3 am today: nausea, four episodes of non-bloody, non-bilious vomiting, then three episodes of watery brown diarrhoea. Mild crampy central and left lower quadrant pain before bowel movements, settling afterwards. Last vomit about five hours ago; tolerating small sips of water and oral rehydration solution. No solids since yesterday's breakfast. Ate leftover chicken pasta yesterday; possible foodborne exposure. Has staff meals daily."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported lightheadedness and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels washed out and slightly lightheaded on standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Pertinent reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sore throat, cough, shortness of breath, wheeze, sinus pain, fever, myalgia, headache, anosmia, ageusia, severe or localised abdominal pain, guarding, distension, jaundice, chest pain, rash, urinary symptoms, vaginal bleeding, and vaginal discharge. No blood or mucus reported in stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Relevant reported history and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent antibiotics, travel, or known sick contacts. Last menstrual period 10 days ago and regular. No significant gastrointestinal history, inflammatory bowel disease, coeliac disease, or gastrointestinal surgery. No asthma or eczema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
