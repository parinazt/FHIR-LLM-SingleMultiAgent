        "code": {
          "text": "Right great and second toe appearance and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right great and second toes violaceous distally and cool to touch; right foot colder than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
