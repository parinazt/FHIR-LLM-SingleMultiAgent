    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right shoulder pain and reported functional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache over the lateral right shoulder and upper arm, increased by reaching overhead or out to the side. Night pain, especially lying on the right side, wakes her a few times per week. She feels the arm is more weak than painful, has reduced power lifting a jug and shopping, struggles above shoulder height, and uses the left hand to assist. Dressing, putting on a bra or jumper, washing hair, and hanging washing are slower; she avoids overhead tasks but remains independent. Patient describes the shoulder as just a bit weak and a bit sore; daughter is concerned about hanging washing and lifting a kettle."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right shoulder onset and trauma history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insidious symptoms for 3–4 months. No trauma, fall, or heavy lifting. Possible overreach into a cupboard and slept in a recliner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Older lady, stoic and under-reporting discomfort, with mild guarding of the right shoulder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right shoulder inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild supraspinatus and infraspinatus bulk reduction compared with the left. No deformity or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right shoulder palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender over the greater tuberosity and anterolateral shoulder. Acromioclavicular joint non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right shoulder active range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abduction approximately 70° and flexion approximately 90°, limited by pain and weakness. External rotation painful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right shoulder passive range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Near full, with mild end-range pain. No capsular pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right shoulder power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right abduction 3/5 with pain; external rotation 3–4/5 with pain; internal rotation 4/5. Left shoulder power 5/5 throughout."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Right shoulder special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Jobe test positive, painful and weak; resisted external rotation positive; Hawkins positive; Neer positive; lift-off mildly weak; O’Brien test equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Neurological and neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; pulses present; capillary refill under 2 seconds; sensation C5–T1 intact; reflexes symmetrical. Neck range of motion full; Spurling test negative; no new focal neurological deficit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Relevant negative symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain, radicular symptoms, paraesthesia, weight loss, fevers, night sweats, or cancer history. No new neurological symptoms; speech reported as okay, with no facial droop or leg weakness. History of left MCA ischaemic CVA in 2018 with good recovery and mild right-hand clumsiness."
      }
    },
