        "medicationCodeableConcept": {
          "text": "Sorbolene"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Using sorbolene; continue liberally."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected areas twice daily for 5–7 days, then once daily as settling; maximum 2 weeks without review. Avoid face, groin, and broken skin.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
