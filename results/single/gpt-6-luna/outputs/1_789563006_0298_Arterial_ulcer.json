    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General appearance and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well perfused and sitting comfortably; winced during right foot examination. Afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right foot ulcer history and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right lateral forefoot ulcer began about 10–12 weeks ago after the foot was knocked on a bed frame, causing a small split; it has slowly increased in size and depth and is not healing. Sharp, significant pain, especially at night and worse with elevation while lying flat; often dangles the leg off the bed to sleep, and pain decreases when the foot is dependent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Claudication symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Can walk about 1–2 blocks on flat ground before tight calf pain in both legs, right greater than left, settles within a few minutes of rest. Worsening over the last 6–12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported foot temperature and colour change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot sometimes feels colder than left and goes white when elevated on a recliner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported infection symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no fevers, rigors, systemic symptoms, or spreading redness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Diabetes symptoms and home glucose monitoring"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Checks fasting blood glucose every few days, usually 7–10 (unit not stated). No recent hypoglycaemia. Some tingling in toes; denies complete numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Current cardiac symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current chest pain, orthopnoea, or paroxysmal nocturnal dyspnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dual heart sounds, no added sounds. No oedema. Carotids without bruits. Abdomen soft and non-tender, no masses, no palpable abdominal aortic aneurysm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lower limb skin and perfusion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot cooler and paler than left when supine. With 30° elevation for 1 minute, pallor of right forefoot and toes followed by dependent rubor on lowering; milder changes on left. Thin, shiny, hairless skin on shins and feet; thickened nails. No varicose veins or venous stasis. Distal feet cool bilaterally, right colder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Toe capillary refill"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Delayed: greater than 3 seconds in right toes and about 2–3 seconds in left toes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Lower limb pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Femoral pulses palpable bilaterally, left greater than right; no definite bruit (clinic noisy). Popliteal pulses difficult to palpate bilaterally. Dorsalis pedis absent on right and very weak on left. Posterior tibial absent on right and weak, possibly monophasic, on left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Right lateral forefoot ulcer examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ulcer near the right fifth metatarsophalangeal joint, approximately 1.5 × 1.0 cm, extending to dermis, punched-out edges, pale base with yellow slough, minimal serous ooze, surrounding skin pale and slightly shiny. No significant erythema or warmth, no malodour, no exposed bone or tendon, no fluctuance or tracking cellulitis. Very tender to palpation and cleaning. No other ulcers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Foot neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Light touch mildly decreased in toes bilaterally. Monofilament decreased at several plantar sites bilaterally. Vibration decreased at great toes."
      }
    },
