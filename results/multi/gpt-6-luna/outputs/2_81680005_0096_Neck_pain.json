        "status": "final",
        "code": {
          "text": "Patient concern about neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is worried she is “wrecking my spine sitting at the computer all day”."
      }
    },
