        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Boggy congested turbinates, pale pink and swollen nasal mucosa, and clear rhinorrhoea. No purulent nasal discharge or sinus tenderness."
      }
    },
    {
