        "code": {
          "text": "Pupil examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal, round, and reactive. Slight consensual discomfort in the left eye when light is directed into the right eye. No relative afferent pupillary defect."
      }
    },
