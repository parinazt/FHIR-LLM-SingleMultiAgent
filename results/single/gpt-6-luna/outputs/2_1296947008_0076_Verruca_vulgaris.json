        "medicationCodeableConcept": {
          "text": "Salicylic acid wart paint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue nightly on the right thumb and start nightly on the left index: soak for 5–10 minutes, pare with an emery board, protect normal skin, apply paint, and occlude. Continue up to a total of 3 months before considering treatment a failure.",
            "route": {
              "text": "topical"
            },
