    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Headache symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache for 4 days; gradual onset, bifrontal/temporal, dull with occasional sharp twinges, severity 5–7/10, worse in the afternoon and with screens. Some relief with Panadol. Mild nausea. No migraine history. Not thunderclap and not described as the worst ever. Denies focal neurological symptoms, visual loss, speech change, collapse, seizure, fever, neck stiffness, photophobia, rash, or morning vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
