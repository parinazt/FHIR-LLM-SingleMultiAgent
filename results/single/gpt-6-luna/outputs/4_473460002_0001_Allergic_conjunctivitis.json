        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing bilateral red, itchy eyes with watery discharge, worse at school and outdoors, especially on windy days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
