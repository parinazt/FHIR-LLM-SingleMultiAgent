          "text": "Exertional shortness of breath and reduced exercise tolerance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased shortness of breath on stairs and reduced exercise tolerance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
