          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild tenderness of right lumbar paraspinal muscles; no midline tenderness. Slightly reduced flexion with pain, but able to move in all directions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
