    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Mental state and health-related worries"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious affect, focused on \"missing something serious\" and repeatedly asking for reassurance. Worried shortness of breath could be cancer or a blood clot in the lungs; asked whether more tests such as CT should be done. Has been asking nurses to check oxygen saturation most days. Staff report frequent reassurance seeking. Patient remained somewhat anxious after accepting the plan."
      }
