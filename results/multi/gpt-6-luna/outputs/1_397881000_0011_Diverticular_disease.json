    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent low lower back pain for approximately 3–4 weeks, worse over the last 5 days. Dull ache across the small of the back, usually 4–5/10 and up to 7/10 when standing or walking. Possible association with recent garage clean-out or a new mattress is uncertain. Worse with bending, lifting, and prolonged sitting; improved by recliner rest. No leg radiation, paraesthesia, weakness, saddle anaesthesia, or bowel/bladder symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal alignment. Mild bilateral lumbar paraspinal tenderness to palpation; no midline tenderness. Reduced flexion and extension. Straight leg raise negative bilaterally. Lower limb neurological examination intact; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Constipation and lower abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing constipation and lower abdominal discomfort, described as sometimes feeling 'crook in the guts'. Bowel motion every 2–3 days, often with straining. Diet low in fibre. No rectal bleeding, melaena, weight loss, change in stool calibre, fevers, or acute left iliac fossa pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, with mild diffuse lower abdominal discomfort on deep palpation. No focal left iliac fossa tenderness, guarding, or mass. Bowel sounds normal."
      }
    },
    {
