    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for 5 days. Gradual onset itch of the outer left ear followed by a dull ache, with occasional sharp stabbing pain when lying on the left side. Pain is approximately 4/10 at baseline and up to 6/10 when lying on that side; worse at night and improved with simple analgesia. Aggravated by pinna movement, over-ear headphones, and a tight headband. Relieved by paracetamol and avoiding pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
