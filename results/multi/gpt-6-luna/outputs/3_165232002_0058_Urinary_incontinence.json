        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels variable, with a mix of loose and formed stools. No current PR blood. History of faecal impaction twice in the last 12 months."
      }
    },
