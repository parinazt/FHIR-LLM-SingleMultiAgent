    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported bilateral knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding knee pain for years, described as a dull ache in the medial and anterior knees. Over approximately the last 6–9 months, intermittent giving way in both knees, right more than left, especially when descending steps or rising from a chair. Pain is worse after walking more than 10–15 minutes, on stairs, and with prolonged standing such as cooking; eased by rest and sitting. Occasional night pain, not waking her most nights. Stiff after sitting more than 20–30 minutes and on waking, loosening after a few minutes of movement. Reports end-of-day puffiness and marked crepitus ('crack and grind all the time')."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported falls and knee instability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 3–4 near falls in the last 2 months, with no definite complete falls and no head strike. Uses a banister on stairs and no walking aid. Denies true locking and episodes of giving way with sharp severe pain. Denies dizziness, syncope, chest pain, palpitations, or new neurological symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported hand symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent hand pain and stiffness, especially at the DIP and PIP joints with heavy use; reports bony nodules at the fingertips. No acute flare today."
      }
    },
