    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for 5 days; dull ache, with occasional sharp stabbing pain when lying on the left side. Pain is about 4/10 at baseline and up to 6/10 when lying on that side; worse at night and improved with simple analgesia. Aggravated by pinna movement, over-ear headphones, and a tight headband; relieved by paracetamol and avoiding pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Ear and skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch and dry, flaky, crusty skin around the left ear. No ear discharge, hearing loss, tinnitus, vertigo, or fever; no upper respiratory symptoms. No vesicles, grouped blisters, or punched-out erosions. Mild itch between the toes; no widespread rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
