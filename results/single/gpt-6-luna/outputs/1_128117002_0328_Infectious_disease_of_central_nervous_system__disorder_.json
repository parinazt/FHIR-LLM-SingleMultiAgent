        "status": "final",
        "code": {
          "text": "Tinnitus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing high-pitched ringing in both ears, worse at night and more noticeable over the last 1–2 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild daily holocephalic headache, rated 3–4/10; worse with bright light and improved by paracetamol."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Visual acuity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6/9 in both eyes uncorrected, improving to 6/6 with pinhole."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Visual field and fundoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visual fields grossly full; optic discs sharp with no papilloedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "GCS 15, alert and oriented to person, place and time; speech normal. Pupils equal and reactive, extraocular movements intact, no diplopia. Cranial nerves V and VII normal; remaining cranial nerves grossly normal. Motor strength 5/5 in all limbs, tone and bulk within normal limits, gait including tandem normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Hearing examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced finger rub bilaterally; Weber central; Rinne air conduction greater than bone conduction on both sides; possible high-frequency hearing loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Meningeal signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck supple; Kernig and Brudzinski signs negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, anxious but coherent, and in no acute distress. External ears, canals and tympanic membranes normal with no effusion. No conjunctival injection. Brief cardiovascular, respiratory and abdominal examinations unremarkable; no rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neurological and infectious red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, neck stiffness, confusion, focal weakness, seizures, severe photophobia, vomiting, diplopia, slurred speech, unsteady gait, incontinence, rash, recent falls or head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Sleep and anxiety impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep reduced due to worry; working reduced hours. Marked worry about relapse or brain cancer, repeated requests for further tests and heavy internet searching about illness."
      }
