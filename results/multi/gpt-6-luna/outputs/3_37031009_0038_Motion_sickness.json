          "text": "Mild epigastric discomfort, possibly functional or secondary to autonomic nausea"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
