    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left knee pain and functional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left knee pain for 5–6/7, now severe; increased pain with weight-bearing and stairs. Difficulty getting on and off the couch; almost fell. Unable to fully weight-bear. No trauma. Feels washed out and has poor sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Obvious effusion; warm and erythematous compared with the right knee; very tender, especially medially and suprapatellarly. Markedly reduced range of motion, with flexion approximately 45° and almost no full extension. Passive movement painful. Unable to weight-bear without support."
      }
    },
