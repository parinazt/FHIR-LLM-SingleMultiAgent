          "text": "Fatigue and reduced energy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling weak, tired, drained, and wiped out for approximately 5 days; reduced energy and work productivity, with fatigue by mid-afternoon."
      }
