            }
          ]
        },
        "code": {
          "text": "Polycystic ovary syndrome (PCOS), stable with mild cycle irregularity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Mild body image impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Acne symptom course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acne since late teens, worse over the last 2–3 years; fewer new pimples now, mostly flat red/brown marks, with an occasional small pustule around the period. No painful nodules or cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Facial skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few closed comedones and small inflammatory papules; no nodules or cysts. Multiple erythematous/light-brown macules post-inflammation and mild early shallow atrophic scars on both cheeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Upper back skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few papules and macules; no infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Body mass index"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 23 kg/m2."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual cycle interval"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Currently approximately 35–45 days; previously 60–90 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "PCOS diagnostic history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "PCOS diagnosed at age 19; history of oligo-ovulation, polycystic ovaries on ultrasound, and elevated androgens."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Hirsutism and virilisation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No increased hirsutism reported; no obvious hirsutism or virilisation on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Psychological impact and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A bit self-conscious and avoids photos on bad days, but continues university and work. Denies low mood and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Adapalene use and tolerability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially used nightly, with dryness and peeling during the first 2 weeks; reduced to alternate nights and now uses most nights, approximately 5 of 7. Tolerating now."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sexual activity and pregnancy plans"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not sexually active currently; no pregnancy plans in the next 12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "History relevant to hormonal treatment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of VTE, migraine with aura, or smoking. Previously experienced weight gain and mood problems on the pill at age 19."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Patient preference regarding systemic acne treatment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reluctant to take tablets; has declined antibiotics in the past and strongly prefers no tablets today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Apply nightly; currently used approximately 5 nights per week.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Benzoyl peroxide 2.5% wash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Use most mornings.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to all affected areas, not only individual spots. Use on alternate nights for 1 week, then increase to nightly as tolerated.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Benzoyl peroxide 2.5% wash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue use in the morning; avoid over-washing.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    }
  ]
