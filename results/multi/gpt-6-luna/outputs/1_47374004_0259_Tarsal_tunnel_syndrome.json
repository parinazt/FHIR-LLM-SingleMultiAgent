          "reference": "Patient/patient-1"
        },
        "valueString": "No subjective tachycardia or presyncope on standing reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left ankle and foot tingling and burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing medial ankle/foot tingling and burning by the end of a work shift, consistent with the previously diagnosed pattern. Some improvement with brace and orthotics; still flares when standing at registers for too long. No new weakness or change in baseline paraesthesia pattern."
      }
    },
