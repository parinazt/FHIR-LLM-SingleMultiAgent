    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Low mood for approximately 2–3 months; decreased motivation and interest in gardening and RSL; early morning waking at 0400–0500 with no difficulty getting to sleep; decreased appetite; patient-reported possible 2–3 kg weight loss; low energy; poor concentration and losing his train of thought."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Suicidal ideation and passive death thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports passive thoughts that it would not matter if he did not wake up. Denies active suicidal ideation or plan; states he would not do anything because of his grandchildren."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neatly dressed and well groomed; mildly impatient and pushes for specific medications and investigations. Speech normal. Mood described as “flat/over it”; affect mildly constricted but reactive. Thought process linear. No psychosis. Cognition grossly intact and oriented. Insight and judgement fair."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Skin examination, face and scalp"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple erythematous, rough, scaly macules/papules, 3–8 mm, over vertex scalp, frontal scalp, temples and upper forehead, consistent with actinic keratoses. Marked background solar damage. No obvious ulceration, induration or horn lesions. Examination was limited to face/scalp and was not a full skin check."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported skin lesion history and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of sun exposure and sunspots on scalp/face; rough scaly spots present for ages and mildly itchy. Reports no bleeding, ulceration or rapid change. Previous cryotherapy approximately 12 months ago. No known history of melanoma per patient."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
