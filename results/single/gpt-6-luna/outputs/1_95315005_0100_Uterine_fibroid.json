        "status": "final",
        "code": {
          "text": "Medication and follow-up adherence"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports poor adherence: often misses medication, GP follow-up, and imaging because she forgets and work gets busy. Reports running out of period tablets a few weeks ago and not continuing them."
      }
    },
