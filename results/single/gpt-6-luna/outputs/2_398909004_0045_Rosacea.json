        "code": {
          "text": "Erythematotelangiectatic rosacea, with persistent erythema and flushing; mild response to topical metronidazole"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Mild ocular rosacea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Facial redness and flushing history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central cheeks and nose red for approximately 12–18 months, worse over the last 6 months; flushing is triggered by heat, hot drinks, a glass of wine, and work stress and lasts approximately 30–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Facial burning and stinging"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burning and stinging, especially after showering and in the air-conditioned office."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Patient-reported pimples"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pimples or zits; says the face just goes bright red."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild gritty eyes in the evenings for several months. No photophobia, blurred vision, or discharge. Does not wear contact lenses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Facial examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central fixed erythema of cheeks and nose with fine telangiectasia; no papules, pustules, comedones, or scale."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral conjunctival injection; visual acuity grossly okay on phone; PERRLA; no obvious lid disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Metronidazole 0.75% gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Apply to central face twice daily; patient uses most days and sometimes misses evening doses.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ],
        "note": [
          {
            "text": "Started approximately 3 weeks ago by another GP. Patient feels it takes the edge off."
          }
        ]
      }
    },
    {
