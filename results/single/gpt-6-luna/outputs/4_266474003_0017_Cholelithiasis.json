        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Historical episodes of upper abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Six-month history of intermittent right upper quadrant and epigastric colicky pain, described as like a bad stitch, sometimes radiating to the right shoulder. Up to 7/10; usually lasts 30–60 minutes, with two episodes lasting 2–3 hours. Occurs approximately 3–4 times per month, mostly in the evenings after fatty meals. Nausea with more severe episodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated and denied symptoms with pain episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vomiting, fever, rigors, jaundice, dark urine, pale stool, PR bleeding, or melaena reported with the episodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
