    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Prolapsing tissue with bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports lumps coming out during bowel movements and straining, present for several months with timing uncertain; manually reduces the tissue in the shower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bright red blood on toilet paper and sometimes in the toilet bowl; blood is not mixed with stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Perianal discomfort and itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild to moderate discomfort and perianal itch, worse after repeated wiping or prolonged sitting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anal pain and perianal lump"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies constant severe anal pain and history of a tense, tender lump at the anal margin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Stool characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies melaena and clots. Initially said stool might be slimy, then denied mucus in stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel habit and straining"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually has a daily bowel movement, but pattern varies; sometimes constipated and on other days has two bowel movements. Reports straining considerably; stool is often hard initially and then softer. Often sits on the toilet for more than 10 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies abdominal pain, nocturnal diarrhoea, weight loss, and fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Symptoms potentially associated with significant anaemia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, dizziness, and palpitations. Severe fatigue was listed in the safety-net advice, not reported as a current symptom."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Perianal discharge and infection symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies perianal discharge, pus, and systemic fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Physical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No physical examination was possible during the telehealth consultation; haemorrhoids could not be graded and other anorectal or colorectal pathology could not be excluded."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Heartburn"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reported recurrent heartburn."
      }
    },
