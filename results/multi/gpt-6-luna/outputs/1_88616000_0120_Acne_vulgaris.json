        "code": {
          "text": "Hirsutism and virilisation findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious hirsutism or virilisation on examination; patient reports no increased hirsutism."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Topical treatment-associated skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dryness and peeling during the first 2 weeks of adapalene use; reduced use to alternate nights. Tolerating treatment now."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Patient-reported possible acne triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks chocolate, coffee during exam time, and 'cheap chemist sunscreen' may worsen acne."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Body image and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A bit self-conscious and avoids photos on bad days, but continues university and work. Denies low mood and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
