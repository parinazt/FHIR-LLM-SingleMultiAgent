          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep, with difficulty falling asleep and early waking at 3–4 am while ruminating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
