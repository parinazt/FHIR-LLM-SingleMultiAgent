          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pale oedematous mucosa; bilateral polypoid tissue in the middle meatus, right greater than left; narrowed nasal passages; clear/mucoid discharge only."
      }
    },
