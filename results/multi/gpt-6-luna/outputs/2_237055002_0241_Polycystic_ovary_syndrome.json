    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Clotrimazole 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected areas twice daily for at least 2 weeks; continue for 3–5 days after the rash clears.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to itchy inflamed areas once daily for a maximum of 5–7 days, then stop. Avoid broken skin.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
