        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Somatic symptoms associated with partner leaving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports abdominal tightness, nausea, and mild headache when her partner is about to leave; symptoms settle when he is home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Jitteriness associated with caffeine and news or phone use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports that increased coffee intake on her partner's office mornings feels as though it worsens anxiety; heavy news and phone use also feel as though they increase jitteriness. Reports approximately 3–4 coffees daily, more on stress days."
      }
    },
