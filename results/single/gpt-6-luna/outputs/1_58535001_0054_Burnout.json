    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Body mass index"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 23; patient estimate."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Fatigue, sleep, and work-related exhaustion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive exhaustion for approximately 4–5 months. Reports fatigue despite 7–8 hours in bed and non-restorative sleep. Actual sleep is approximately 5–6 hours before shifts and somewhat longer on days off; difficulty switching off after late shifts, often scrolling on phone in bed, and early waking on work days with anticipatory anxiety. Reports feeling emotionally exhausted and 'running on empty,' with tearfulness after shifts. Increased sick leave over the last 6 weeks: four separate days off and leaving early twice; reports absenteeism feels like her only coping strategy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mood, interest, and work functioning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Low mood mainly around work and at the end of runs of shifts. Retains ability to enjoy time with partner and friends on days off; no global anhedonia. Reduced concentration at work, concentration okay at home. Reduced interest in nursing and contemplating leaving. Reports reduced sense of accomplishment, feeling that whatever she does is never enough. Increased irritability and snappiness with colleagues, occasionally with patients, which she finds distressing. Preserved function at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Work-related anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports anticipatory worry the night before shifts, racing thoughts about patient load, and fear of errors. No panic attacks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Headache and gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tension headache, 'nervy stomach,' and loose stools on work days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Appetite and reported weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Variable appetite, reduced on work days. Reports estimated mild weight loss of 3–4 kg over 3 months, not objectively recorded. Denies significant unintentional weight loss beyond reduced intake on work days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Safety and suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation, including passive thoughts; states she is exhausted and over it but is not going to hurt herself. Denies thoughts of self-harm and harming others. No previous suicide attempts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Alcohol, caffeine, and other substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alcohol: 1–2 standard glasses of wine on most days off, sometimes 3–4 after a run of shifts to 'switch off'; no morning use or blackouts. Caffeine: 5–6 coffees per night on night shifts and 2–3 per day otherwise. Denies illicit substances and non-prescribed medications."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General and mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well groomed, appears tired and mildly tense, intermittently impatient and checking phone for work messages. Alert and oriented to person, place, and time. Speech normal in rate and volume, somewhat pressured when discussing work. Mood described as 'exhausted and over it'; affect congruent, with brief tearfulness when describing feeling she is failing patients. Thought form coherent and logical. No delusions, hallucinations, or thought disorder. No psychomotor retardation or agitation. Insight good and judgement intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Focused physical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurological examination grossly normal. Abdomen soft and non-tender with no masses. Thyroid without goitre; no tremor. Rest of examination unremarkable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Targeted review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, night sweats, chest pain, shortness of breath, and palpitations. No classical thyroid symptoms: denies heat or cold intolerance and tremor; bowel changes limited to work-related loose stools. No menstrual issues volunteered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Workplace context and stressors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works as a registered nurse on a busy public hospital medical ward. Reports chronic understaffing, increased acuity, frequent double shifts and overtime, KPI pressure, and moral distress about not providing care to her own standard. Work symptoms partially remit on days off."
      }
    }
  ]
