    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 3 weeks ago; dull ache across the lumbar area, right greater than left. Pain approximately 4–5/10 at baseline and up to 7/10 after prolonged sitting or bending to pick things up. Worse at the end of the work day with prolonged sitting; improved by lying flat and a heat pack. Patient thinks it might be related to a new mattress and sitting posture at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Back pain-associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation to the legs, numbness, tingling, weakness, saddle anaesthesia, bladder or bowel issues, or night pain waking her from sleep. No trauma, falls, or motor vehicle accident. No fevers, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Periods heavier and more painful for approximately 12–18 months, with clots for 2–3 days each cycle. Cycles regular at 28–30 days. No intermenstrual bleeding or postcoital bleeding. Bleeding is heavy but not flooding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Pelvic heaviness and cyclical low back ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports occasional pelvic heaviness described as a dragging sensation around menses and occasional low back ache at the same time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels fatigued, especially around periods. No previous FBE or iron studies reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Gynaecological and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute severe pelvic pain, dysuria, abnormal PV discharge, haematuria, urinary frequency, or flank pain. Not sexually active currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels normal; no PR bleeding, fevers, chills, or weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg weakness, paraesthesia, or gait disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no acute distress, mobilising independently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Spinal alignment normal with no deformity. Mild tenderness to palpation of bilateral lumbar paraspinals; no midline bony tenderness. Flexion and extension mildly reduced by pain at end range; lateral flexion and rotation near full. Straight leg raise negative bilaterally. FABER causes mild low back discomfort with no groin pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 in all groups. Reflexes normal and symmetrical. Sensation intact L2–S1. Gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, non-tender, and non-distended, with no masses or organomegaly. No suprapubic or costovertebral angle tenderness. No obvious abdominal mass, though palpation was limited by body habitus."
      }
    },
