    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still short of breath at rest and more aware of faster breathing while sitting watching TV. Productive cough with yellow sputum, reduced volume compared with earlier in the week; no haemoptysis. Wheeze and chest tightness, especially at night. Salbutamol puffer used 3–4 times daily with some relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported systemic and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Felt hot and cold during the first 2 days; no fever in the last 48 hours and no rigors or confusion. No pleuritic chest pain. Reduced appetite; drinking adequately. No ankle swelling; weight subjectively stable. No orthopnoea or paroxysmal nocturnal dyspnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance and mental status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Elderly male sitting upright, speaking full sentences, mildly short of breath at rest and appears tired; not toxic. Alert and oriented to person, place, and time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly increased work of breathing with mild accessory muscle use; no cyanosis. Chest expansion slightly reduced but symmetrical. Resonant percussion. Widespread bilateral expiratory wheeze, coarse crackles and rhonchi in the right middle and lower zones, partly clearing with cough. No focal bronchial breath sounds and no pleural rub."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dual heart sounds with no added sounds. No oedema. JVP not elevated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Assessment of severe pneumonia, sepsis, and congestive cardiac failure red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious red flag for severe pneumonia, sepsis, or congestive cardiac failure today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Patient-reported activity and possible fan effect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stopped usual short walks to avoid worsening the infection and now feels more breathless. Thinks the fan at night may be making the chest worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Patient understanding of plan"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient repeated back the plan to finish antibiotics, take an additional 3 days of steroids, return in two days, and go to hospital if substantially more breathless. Appeared reliable with medicines and follow-up."
      }
    },
