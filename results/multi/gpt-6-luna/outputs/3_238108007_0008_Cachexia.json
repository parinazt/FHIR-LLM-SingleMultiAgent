          "text": "Dexamethasone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "2 mg by mouth each morning for 5 days. If clear benefit, consider continuing at the lowest effective dose for up to approximately 2 weeks, then aim to cease.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
