      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right wrist lump examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Soft, fluctuant, well-circumscribed swelling on the dorsal right wrist over the scapholunate area; non-erythematous and not warm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right wrist pain and lump history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lump fluctuates in size and reportedly increases after a big day on the computer. Dull ache with occasional sharp twinge on extension; pain up to 5/10, especially at the end of the day. Interferes with typing and mouse work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right wrist tenderness and range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild tenderness to palpation. Full flexion and extension, with slight pain at terminal extension and discomfort only at end-range extension."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right wrist neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; good capillary refill, radial pulse present, sensation intact in median, ulnar and radial distributions, and normal grip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left wrist examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Associated symptoms and reported red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies night pain, rest pain, redness, warmth, fevers, weight loss, night sweats, numbness, tingling, weakness, or dropping objects. No definite trauma reported, though the patient later said they might have knocked the wrist at the gym."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "History reliability during consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor historian regarding timelines and prior treatment; contradicted self about imaging and allergy history and required repeated clarification. Engaged once information was simplified."
      }
