        "status": "final",
        "code": {
          "text": "Examination of lesions on exposed skin"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dozens of 2–6 mm erythematous, rough, scaly macules and papules on the dorsal hands, forearms, forehead, temples, and ears; sandpaper-like feel, non-tender, with no induration, ulceration, or bleeding."
      }
    },
