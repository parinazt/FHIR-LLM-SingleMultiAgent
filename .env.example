# Provider credentials. Fill in only the provider(s) you use.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Number of full passes over the input dataset.
NUM_OF_EXECUTION=5

# Allowed values: single-agent | multiagent
MODE=single-agent

# Maximum generations per agent, including its first response.
MAX_ATTEMPTS=3

# Use the first 10 notes sorted by filename; false uses the full dataset.
DEVELOPMENT=true
