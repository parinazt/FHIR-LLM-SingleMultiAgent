    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Rash, reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash for approximately 5 days under both breasts and in the groin folds, with a few spots under the abdominal apron. Itchy with slight burning, worse after work when sweaty in tight uniform; slightly increased over the past 2 days. Described as red patches with tiny bumps. No pain, discharge, blisters, or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-demarcated erythema in inframammary and groin folds, with some peripheral scale and satellite papules, especially in the groin. Mild inframammary maceration. No pustules, weeping, fissures, cellulitis, or tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other rash findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vesicles, urticaria, or widespread rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
