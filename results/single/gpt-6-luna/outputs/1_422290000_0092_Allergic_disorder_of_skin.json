          "text": "Facial skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint hypopigmented, slightly scaly patches on the cheeks, described as looking like pityriasis alba and not inflamed. No infection."
      }
    },
