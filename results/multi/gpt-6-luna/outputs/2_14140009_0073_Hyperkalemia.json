    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent mechanical low back pain, worsened over the last 5–6 days after helping with wood; possible twisting. Dull central ache, possibly extending into both buttocks, with no clear leg radiation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain severity and modifiers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5/10 at baseline, up to 7/10 with bending or twisting; worse in the evenings and eased by curling up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Low back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, leg weakness, foot drop, bladder or bowel incontinence, fever, night sweats, weight loss, recent infection, intravenous drug use, and cancer history. Denies trauma or fall."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Mobility and low back stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobilises short distances at home and uses a single-point stick outdoors; reports more stiffness in the morning."
      }
    },
    {
