        "code": {
          "text": "Back and right leg pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline pain approximately 4/10, burning from right buttock to lateral calf; intermittent pins and needles in right foot. Pain has increased to 6/10 in the evenings over the last few days; patient thinks coughing jars the back."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
