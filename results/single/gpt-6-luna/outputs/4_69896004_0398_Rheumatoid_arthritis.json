        "code": {
          "text": "Seropositive rheumatoid arthritis, longstanding, clinically stable with low-to-moderate activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Morning stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 45–60 minutes most days; eases with movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Joint pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache in hands, wrists and balls of feet; 5/10 when bad. Reports that cold, damp weather makes the joints more uncomfortable. No flare today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Functional status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works three days per week doing typing and phones. Some difficulty opening jars and hanging washing; takes her time. No recent falls."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No weight loss, night sweats, fevers, rash, visual change, shortness of breath, cough, mouth ulcers, hair loss, nausea, vomiting, PR bleeding, melaena, recent infections, dental work or hospital attendance. Mild fatigue; patient thinks it is just getting older. Mild occasional indigestion, especially after servo food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
