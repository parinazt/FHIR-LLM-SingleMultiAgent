        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Methylprednisolone aceponate 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply once daily to affected areas of hands only for up to 7 days, then as needed for flares. Avoid face and eyelids.",
            "route": {
              "text": "topical"
            },
            "timing": {
