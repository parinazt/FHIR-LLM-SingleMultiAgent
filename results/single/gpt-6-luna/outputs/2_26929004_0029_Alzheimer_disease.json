        "code": {
          "text": "Behavioral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased evening agitation, restlessness, irritability, and some suspiciousness, including saying that belongings are being moved. No aggression and no clear hallucinations; occasionally misreads shadows."
      }
    },
