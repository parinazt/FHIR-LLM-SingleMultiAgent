        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports months of tiredness, worse on work days; attributes it possibly to night shifts or getting older."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Trouble falling asleep, especially after late or night shifts, and wakes a few times thinking about work. Gets approximately 4–5 hours of sleep on work days; sleep is a bit better on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Work-related emotional and behavioral concerns reported by patient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels over it; more tearful driving home, snappy with partner and colleagues, and more cynical at work. Still enjoys partner, dog, and TV when not exhausted; not going out much socially. Still functioning at work but reports making more little mistakes and double-checking medications more."
      }
    },
