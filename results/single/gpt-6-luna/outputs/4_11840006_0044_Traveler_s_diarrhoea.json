    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset 2 days ago; central across the belt line, aching and stiff, VAS approximately 5–6/10. Worse with bending and standing from sitting; improves somewhat when lying flat. Non-radiating, with no leg symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain red flags and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no trauma, fall, or heavy lifting; no saddle anaesthesia, leg weakness, paraesthesia, gait disturbance, weight loss, night sweats, cancer history, IV drug use, significant trauma, or features of spinal infection, fracture, cancer, or disc compression with nerve involvement. Passing urine normally; no incontinence, retention, or change in bowel control."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Diarrhoea, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools began about 24 hours after returning from Bali 5 days ago; currently 4–5 watery bowel movements per day. No blood or mucus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Abdominal pain associated with bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy lower abdominal pain before stool, relieved after stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no vomiting, fevers, or rigors; reports home temperature as “36-something.” No recent antibiotics or IBD."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hydration and urine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinking water and pharmacy ORS; passing light-yellow urine every 3–4 hours. Reports no postural dizziness or palpitations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Urinary and loin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no dysuria or loin pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telehealth general appearance and respiratory status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited phone examination: alert and coherent, speaking in full sentences, sounds comfortable, and reports no shortness of breath. By history, no features of severe dehydration or systemic toxicity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Health-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very anxious and repeatedly worried about cancer and spinal infection, requested a scan, and expressed concern about parasites and a “superbug” after searching online."
      }
    },
