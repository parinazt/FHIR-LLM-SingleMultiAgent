    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin, casually dressed, mildly dishevelled; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Depressive symptoms and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling really hopeless and helpless, useless, and that there is no point; ongoing low mood, anhedonia, poor motivation, low energy, and poor concentration at work and home. Duration is vague, described as bad for ages and perhaps worse over the last few weeks. Struggling to get out of bed and missing work shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; stays up late on the phone, sometimes awake until 4 a.m., and wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Appetite and reported weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appetite erratic, sometimes eating nothing all day and then bingeing on junk food at night. Possible slight weight loss, uncertain; no recent weight recorded in the electronic medical record."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Guilt and self-worth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels guilty and like a burden to her sister; prominent hopelessness and reports that nothing she tries makes a difference."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Suicidal ideation and intent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal ideation: says it would not matter if she did not wake up. No active plan or intent today. Assessed suicide risk as low to moderate today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Self-harm history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports past superficial cutting, last more than six months ago; chart reportedly similar. No recent self-harm disclosed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Protective support and help-seeking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Identifies her sister as a support and says she would tell her or return for help if suicidal ideation worsened."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Psychotic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies voices, paranoia, and thought interference; no delusions or hallucinations noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking a fair bit after shifts, with minimal drinking on some nights and heavy drinking on others; sometimes cannot remember getting home. Previous AUDIT-C in chart was high risk. Denies morning drinking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Cannabis and stimulant use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent cannabis use to relax and occasional weekend use of party substances, likely cocaine or MDMA; last use approximately one to two weeks ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Nicotine use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vapes nicotine daily."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced eye contact, fidgety, cooperative and vague historian with inconsistent dates. Speech normal in rate and volume, slightly slowed. Mood described as hopeless and 'just over it'; affect constricted and congruent, intermittently tearful. Thought form linear and ruminative, with no formal thought disorder. Cognition grossly intact to person, place, and time, with patchy recent recall. Insight partial; acknowledges depression and impact of substances but minimizes risk. Judgment questioned in relation to substances and work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Physical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No focal neurological signs; chest clear; heart sounds dual. No signs of acute intoxication or withdrawal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Social context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lives in a share house, sometimes with her older sister; relationship supportive but strained. Casual bar work with variable shifts and recent missed shifts; possible job risk and financial stress. Single, with a breakup approximately six months ago."
      }
    },
    {
