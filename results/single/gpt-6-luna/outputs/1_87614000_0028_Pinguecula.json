        "code": {
          "text": "Reported symptoms associated with elevated blood pressure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, palpitations, neurological symptoms, visual change, and severe headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported right eye lesion and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Yellow bump on the nasal side of the right eye, present for at least 1 year and more noticeable over the last few months. Mild intermittent irritation, especially on windy or dusty days at work. Denies significant pain, photophobia, discharge, or change in visual acuity. Patient thinks it may be related to increased blood pressure or chemicals leaking from new high-visibility work glasses. Optometrist reportedly described it 1–2 years ago as a 'sun thing' and nothing to worry about."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported snoring and sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports occasional snoring. No witnessed apnoeas and no marked daytime somnolence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
