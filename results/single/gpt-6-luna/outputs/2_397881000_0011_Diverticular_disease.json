    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent low back pain for approximately 3–4 weeks, worse over the last 5 days. Dull ache across the lower back, usually 4–5/10 and up to 7/10 with standing or walking. Possibly related to recent garage clean-out or a new mattress. Worse with bending, lifting, and prolonged sitting; improved by recliner and rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Back pain-associated neurologic and bowel/bladder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg radiation, paraesthesia, weakness, saddle anaesthesia, or bowel/bladder symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal alignment; mild bilateral lumbar paraspinal tenderness; no midline tenderness; reduced flexion and extension; straight-leg raise negative bilaterally; lower-limb neurology intact; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowel movement every 2–3 days, often with straining. Ongoing constipation and lower abdominal discomfort; occasionally feels 'crook in the guts'. Diet low in fibre."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gastrointestinal associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rectal bleeding, melaena, weight loss, change in stool calibre, fevers, or acute left iliac fossa pain reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild diffuse lower abdominal discomfort on deep palpation; no focal left iliac fossa tenderness, guarding, or mass; bowel sounds normal."
      }
    },
