    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Knee pain somewhat better than last week; anteromedial pain, worse at the end of the day after being on her feet. Occasional mild giving way down stairs. No locking, true instability, night pain, fever, or systemic symptoms. Fully weight-bearing and working full time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No swelling, deformity, or erythema. Mild medial joint-line tenderness; no warmth or effusion. Flexion approximately 130° and extension 0°, with mild pain only at end flexion. McMurray caused mild medial discomfort without a click; Thessaly at 20° mildly uncomfortable. Lachman, anterior/posterior drawer, and varus/valgus testing stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly antalgic after repeated squat; otherwise steady."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing itchy, dry, cracked skin on the backs of the hands and fingers, worse after busy days with frequent wet work, shampoos, colours, and bleach. Sleep occasionally disturbed by itch. No rash elsewhere, weeping, or pustules."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, mildly scaly plaques with fine fissuring over the dorsum of both hands, especially the right, and the knuckles. Palms largely spared. No vesicles, exudate, crust, pustules, nail changes, or lymphangitis."
      }
    },
