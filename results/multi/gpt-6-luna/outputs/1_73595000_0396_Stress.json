        "status": "final",
        "code": {
          "text": "Skin examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vesicles, crusting, weeping, warmth, target lesions, mucosal involvement, palmar or plantar lesions, generalised urticaria, or features of secondary bacterial infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
