        "code": {
          "text": "Medication overuse headache due to frequent simple analgesic and triptan use on a background of migraine without aura"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "High-frequency migraine without aura, suboptimally controlled in the setting of medication overuse headache"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache frequency and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of migraine since late teens, previously 1–2 episodes per month. Over the last 4–5 months, headaches occur most days, with a baseline dull band-like ache and superimposed typical migraine 1–2 times per week. Headaches improve for a few hours after analgesics and return, sometimes worse, typically 4–6 hours after a dose. Mild headache on waking several mornings per week; analgesia mid-morning improves it, but it returns late afternoon or evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Migraine characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usual migraine is right-sided and throbbing, associated with photophobia and nausea, and previously relieved by sumatriptan. Character otherwise unchanged, with increased frequency and background daily pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported headache red flags and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies thunderclap onset, worst-ever headache, focal neurological symptoms, speech disturbance, limb weakness, visual loss, fever, neck stiffness, head trauma, seizures, personality change, weight loss, and nocturnal headache waking her."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Mood and psychological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels a bit worn down by constant pain. Denies pervasive low mood, anhedonia, anxiety attacks, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
