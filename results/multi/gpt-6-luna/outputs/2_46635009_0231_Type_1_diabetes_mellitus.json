    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mid to lower lumbar pain for 10/7, right greater than left; dull ache with a sharp twinge on flexion or lifting. Insidious onset, with no trauma or single heavy lift. Worse at the end of the teaching day or when marking at a table; better lying flat and with heat. A firmer mattress introduced about 3/52 ago and increased gardening may have triggered it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red flags with low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radicular symptoms, neurological symptoms, bowel or bladder change, night pain, weight loss, or fevers. No history of cancer. No urinary symptoms or CVA pain."
      }
    },
