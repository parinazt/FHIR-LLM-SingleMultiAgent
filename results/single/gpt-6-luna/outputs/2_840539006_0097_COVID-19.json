      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice strong; speaking in full sentences without pausing for breath. Occasional short cough paroxysms. No audible wheeze or stridor and no respiratory distress on conversation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported respiratory and chest symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath at rest, orthopnoea, paroxysmal nocturnal dyspnoea, wheeze, chest tightness, stridor, pleuritic chest pain, other chest pain, and haemoptysis. Denies difficulty breathing at rest, blue lips or face, severe pleuritic pain, and unilateral leg swelling. No reported oxygen saturation readings of 94% or lower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Other reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies confusion, syncope, vomiting, diarrhoea, abdominal pain, dysuria, palpitations, focal neurological symptoms, seizures, and otalgia. Reports no depressive symptoms or suicidal ideation. Oral intake slightly reduced; still eating and drinking. Mild headache with viral symptoms."
      }
    },
