        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stools slightly looser for 3 days but still formed, 1–2 per day. No per-rectal blood or melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
