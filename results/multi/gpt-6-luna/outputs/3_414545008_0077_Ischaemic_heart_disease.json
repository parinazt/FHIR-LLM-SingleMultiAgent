      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Exertional chest discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports stable, occasional tightness across the chest with increased exertion, such as hurrying for the bus; predictable exertional threshold and relieved by rest within a few minutes. Denies rest pain, radiation, diaphoresis, syncope, and vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild exertional shortness of breath, stable and settles quickly with rest; patient reports going more slowly these days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Palpitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent brief episodes described as fluttering in the chest about once every 1–2 weeks, lasting a few minutes and self-resolving. Denies presyncope, syncope, and chest pain with the episodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
