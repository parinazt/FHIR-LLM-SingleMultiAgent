    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain characteristics and severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent mechanical low back pain, worsened over the last 5–6 days after helping with wood and possibly twisting. Dull central low back ache, sometimes into both buttocks without clear leg radiation. Approximately 5/10 at baseline and up to 7/10 with bending or twisting; worse in the evenings and eased by curling up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, leg weakness, foot drop, bladder or bowel incontinence, fever, night sweats, weight loss, recent infection, intravenous drug use, and cancer history. No trauma or fall reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mobility and back examination by telehealth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobilises short distances at home and uses a single-point stick outdoors; reports more stiffness in the morning. On video, able to stand and turn slowly and independently, with grimacing on lumbar flexion and extension. Short gait with stick was slightly stooped, slow, and steady, with no obvious foot drop. Moved both legs against gravity and could heel-toe stand with chair support; no obvious focal weakness. Patient reports sensation is normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported potassium peak during prior admission"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Potassium peak 6.3 during prior admission; unit not stated. Settled with insulin, dextrose, and fluids; ACE inhibitor held per discharge summary."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Last known eGFR at discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 45 at discharge; unit not stated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent nurse report of potassium"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Clinic nurse reportedly said potassium was 'a bit up again' about 10 days ago; no value available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Current symptoms in the context of hyperkalaemia risk"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling 'a bit sluggish' and describes 'old man weakness'; denies palpitations, chest pain, presyncope, frank muscle weakness, and shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported potassium intake and dietary changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased fresh fruit since admission, including bananas most mornings, and use of a 'low salt' substitute from town, likely potassium chloride based."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Community nurse blood glucose readings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Blood glucose checked by community nurse 2–3 times per week, often 14–15 and sometimes 8–9; units not stated. Patient has no own glucometer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Current symptoms related to diabetes or HHS"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies polyuria, polydipsia, confusion, and visual blurring. No reliable weight available; clothes reportedly similar."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance on telehealth examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sitting in a chair at home, appears mildly overweight, speaks in full sentences, with no respiratory distress; colour described as okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Other reported concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic right shoulder pain when reaching up; thickened toenails that are hard to cut; intermittent itchy rash on the shins; hearing concerns."
      }
    },
