      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Patient-reported prior pelvic ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient recalls an ultrasound approximately 10–11 months ago showing a single intramural fibroid approximately 4.5 cm. No follow-up imaging since."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual pattern and bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Regular cycles every 28–30 days, bleeding for 6–7 days with the first 2–3 days heavy. Uses super pads, changing every 2–3 hours on heavy days; occasional small clots. Bleeding may be a bit heavier this year, but she remains able to work and has had no days off. No flooding through clothes or nocturnal sheet soaking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Pelvic and menstrual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild dysmenorrhoea on days 1–2. Reports some pelvic fullness, especially around her period, but no constant pain. Denies dyspareunia, dysuria, increased urinary frequency or urgency, change in bowel habit, intermenstrual bleeding, and postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Symptoms potentially associated with anaemia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known history of anaemia. Denies shortness of breath, unusual exertional fatigue, and dizziness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Vaginal and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies abnormal vaginal discharge, fever, night sweats, and weight loss."
      }
    },
    {
