        "code": {
          "text": "Lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 3 weeks ago; dull ache across the lumbar area, right greater than left. Pain 4–5/10 at baseline, up to 7/10 after prolonged sitting or bending to pick things up. Worse at the end of the work day and with prolonged sitting; better lying flat and with a heat pack."
      }
