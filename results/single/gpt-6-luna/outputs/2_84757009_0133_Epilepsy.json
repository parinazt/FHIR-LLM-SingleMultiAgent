    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported seizure episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of focal-onset epilepsy since childhood, sometimes generalising. Over approximately 3 weeks, three events last week described as a weird feeling and jerking in the right arm and face, lasting 30–60 seconds, with awareness and hearing others, speech arrest or difficulty talking, and tiredness for a few minutes afterward without prolonged confusion. Mother reports these are the same as usual events, just somewhat more frequent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Most recent generalized tonic-clonic seizure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 8/12 ago, as stated in the note."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated seizure findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No loss of consciousness, generalized tonic-clonic activity during the recent events, tongue bite, incontinence, or injury reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported seizure triggers and medication timing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep for approximately 1/12 due to worry and increased energy drink intake of 2–3 cans per day were reported. Medications unchanged per patient and mother; occasional evening dose is 1–2 hours late."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported neurological and acute red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No persistent weakness, speech change, or vision loss; no new severe headache, fever, neck stiffness, or recent head trauma reported. No alcohol or illicit drug use reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Telehealth brief communication and mental status screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On phone, speaking in full sentences and mildly anxious; oriented and chatting appropriately. No obvious dysarthria, word-finding problem, or confusion on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Health anxiety and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding health anxiety about the brain, with frequent online searching about seizures, cancer, and stroke; repeatedly asked for MRI every few months. No suicidal ideation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Tuberous sclerosis stability by history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic condition described as appearing stable by history, with no new focal neurological deficit or raised intracranial pressure symptoms reported."
      }
    },
