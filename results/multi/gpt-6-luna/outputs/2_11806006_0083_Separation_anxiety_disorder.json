      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neat, good hygiene, seated at desk. Calm but clearly anxious and cooperative, with good eye contact via camera. Speech normal. Mood described as “anxious”; affect congruent and reactive. Thought form linear; thought content dominated by worries about partner safety and being alone. No psychosis observed. Cognition grossly intact; good insight."
      }
    },
