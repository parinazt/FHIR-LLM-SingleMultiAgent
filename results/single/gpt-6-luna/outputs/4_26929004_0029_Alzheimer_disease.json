        "code": {
          "text": "Sleep pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fragmented sleep; gets up 1–2 times nightly and wanders to the kitchen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
