          "text": "Functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working full-time, slower with typing, and avoiding heavier lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
