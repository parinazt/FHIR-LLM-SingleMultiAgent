          "text": "Reported severe or associated symptoms and events"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no recent loss of consciousness, seizures, or ambulance attendance. Does not recall a clear history of severe hypoglycaemia requiring IV dextrose or glucagon."
      }
