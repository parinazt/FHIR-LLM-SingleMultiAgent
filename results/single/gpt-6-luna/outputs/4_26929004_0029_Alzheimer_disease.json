    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported cognitive and functional changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Husband reports gradual decline over 6–9 months, with increased repetition, sometimes unsure of the day or date, prompting needed for medications and meals, and help needed with finances and complex instrumental activities of daily living. Basic activities of daily living remain okay. Patient notices she is not as sharp with new information but feels day-to-day fairly stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Behavioural symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Evening agitation, restlessness, irritability, and some suspiciousness, including concern that others are moving her things. No aggression or clear hallucinations; occasionally misreads shadows."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
