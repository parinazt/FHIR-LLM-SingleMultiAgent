        "code": {
          "text": "Muscle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing generalized muscle pain flare for 2–3 weeks, affecting the neck, shoulders, and upper back, with occasional low back pain. Dull ache with intermittent sharp twinges, worse at the end of the workday and after long periods at the computer."
      }
