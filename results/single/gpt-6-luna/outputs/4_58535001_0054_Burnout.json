    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports progressive exhaustion over approximately 4–5 months and fatigue despite 7–8 hours in bed; sleep is non-restorative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty winding down after late shifts, often scrolling on phone in bed; anticipatory waking on work days. Reports approximately 5–6 hours of sleep before shifts and somewhat more on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Emotional exhaustion and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes feeling 'running on empty' and 'exhausted and over it'; lower mood mainly around work and at the end of a run of shifts. Tearful after shifts and briefly tearful during the consultation when describing feeling she is failing patients. Retains enjoyment of time with partner and friends on days off; no global anhedonia reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Irritability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased irritability and being snappy with colleagues, occasionally with patients; this is distressing to her."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Work-related interest and sense of accomplishment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports decreased sense of accomplishment ('whatever I do it's never enough'), decreased interest in nursing, and contemplating leaving nursing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Work-related concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports reduced concentration at work; concentration is okay at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anticipatory work anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports anticipatory worry the night before shifts, racing thoughts about patient load, and fear of errors. Denies panic attacks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
