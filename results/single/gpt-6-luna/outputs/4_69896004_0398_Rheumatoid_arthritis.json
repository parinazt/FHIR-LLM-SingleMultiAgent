          "text": "Red-flag symptom screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute monoarthritis, severe night pain, new neurological symptoms, bowel or bladder change, or systemic symptoms as described in the review of systems."
      }
    },
