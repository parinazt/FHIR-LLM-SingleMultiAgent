          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly antalgic after repeated squat; otherwise steady."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Hand skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing itchy, dry, cracked skin on the dorsum of the hands and fingers, worse after busy days with frequent wet work involving shampoos, colours, and bleach. Itch occasionally disturbs sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, mildly scaly plaques with fine fissuring over the dorsum of both hands, especially the right, and the knuckles. Palms largely spared."
      }
    },
