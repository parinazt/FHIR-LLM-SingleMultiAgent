        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Increased worry and health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 weeks, patient reports increased worry and more difficulty keeping worry under control, mainly about health, dementia and cancer. Reports frequent internet searching about health and repeated requests for reassurance and further tests or scans."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Anxiety-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling on edge most days, muscle tension in shoulders and jaw, and fatigue by late afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
