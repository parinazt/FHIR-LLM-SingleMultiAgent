        "code": {
          "text": "Right thumb subungual lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported still present and maybe a bit smaller after 4 weeks of OTC salicylic acid paint. Examination: verrucous lesion at distal nail bed, approximately 3–4 mm, with mild hyperkeratosis. No erythema, warmth, or pus; nail plate intact."
      }
    },
