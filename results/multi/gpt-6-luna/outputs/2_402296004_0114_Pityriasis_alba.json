        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected facial patches twice daily for 5–7 days, then stop. Avoid periocular area.",
            "route": {
              "text": "topical"
            },
            "timing": {
