    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left ear pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for 5 days. Gradual onset itch of the outer left ear followed by dull ache, with occasional sharp stabbing pain when lying on the left side. Pain approximately 4/10 at baseline and up to 6/10 lying on that side; worse at night and better with simple analgesia. Mild itch and dry flaky crusty skin. Aggravated by pinna movement, over-ear headphones, and tight headband; relieved by paracetamol, avoiding pressure, and moisturiser on the outer ear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported negative ear and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No ear discharge, hearing loss, tinnitus, vertigo, or fever; no upper respiratory symptoms, sinus pain, sore throat, dental pain, or facial weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pinna with mild erythema and fine scale in the conchal bowl and post-auricular skin; mild tenderness of pinna and tragus. No swelling, cellulitis, or fluctuance. External auditory canal with mild erythema and scant dry scale; no oedema, debris, pus, moist crust, or odour. Tympanic membrane intact with normal landmarks and light reflex; no bulging, retraction, or effusion. No mastoid tenderness or post-auricular swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild xerosis and faint erythema on the dorsum; no weeping, lichenification, or bacterial features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Foot skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild interdigital scaling; no maceration, fissures, erythema suggesting secondary infection, or onychomycosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Lymph node examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pre-auricular, post-auricular, or cervical lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reported dermatitis and tinea symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent atopic/contact-type dermatitis of hands and peri-auricular area, with flares associated with frequent handwashing and cleaning products at work. Itch around the ear; trying not to scratch. No vesicles, grouped blisters, or punched-out erosions. Recurrent tinea pedis for years, worse in summer and closed shoes; currently mild interdigital scaling. No nail involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms and pertinent history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No widespread rash, headache, or visual disturbance. No diabetes or immunosuppression. No regular systemic medicines."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Twice daily to external pinna and peri-auricular area for 5 days."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g up to three times daily as needed; currently using approximately twice daily.",
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Once daily to affected areas; currently used for 1 week of a planned 2–4-week course."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer twice daily to the outer pinna and just at the canal entrance only; total course up to 7–10 days, then stop to avoid skin atrophy, especially on thin skin."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "1 g up to four times daily as needed for pain.",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue once daily to affected areas for a minimum of 2 weeks and for 1 week after resolution."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-4",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-4",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Plain emollient, e.g. soft white paraffin or sorbolene"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply twice daily and as needed to peri-auricular area between steroid applications; avoid fragranced products."
          }
        ]
      }
    }
