    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bad headache for 3 days, on both sides of the forehead and temples. Gradual onset, not thunderclap. Constant dull pressure, sometimes throbbing later in the day, especially after work with noisy children or screens. Wakes with no headache or a mild headache that builds during the day. Severity up to 6/10, 3/10 at the time of assessment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and headache red-flag history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea, vomiting, visual changes, aura, weakness, speech or swallowing difficulties, dizziness, fever, and neck stiffness. Reports no recent head injury and no 'worst in my life' headache. States she is not pregnant."
      }
    },
    {
