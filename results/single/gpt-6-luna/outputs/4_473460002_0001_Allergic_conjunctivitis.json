        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Lubricating saline eye drops"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue as needed, up to hourly.",
            "route": {
              "text": "Ophthalmic"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "h"
              }
            }
          }
        ]
