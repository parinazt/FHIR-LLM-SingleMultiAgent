    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain somewhat improved compared with last week; anteromedial pain, worse at the end of the day when on her feet. Occasional mild giving way on stairs. No locking, true instability, night pain, or fever. Fully weight-bearing and working full time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No swelling, deformity, or erythema. Mild medial joint-line tenderness; no warmth or effusion. Flexion approximately 130 degrees and extension 0 degrees, with mild pain only at end flexion. McMurray caused mild medial discomfort without a click; Thessaly at 20 degrees was mildly uncomfortable. Lachman, anterior and posterior drawer, and varus and valgus testing stable. Slightly antalgic gait after repeated squat; otherwise steady."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Hand skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing itchy, dry, cracked skin on the dorsum of the hands and fingers, worse after busy days involving frequent wet work, shampoos, colours, and bleach. Sleep is occasionally disturbed by itch. No rash elsewhere, weeping, or pustules."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, mildly scaly plaques with fine fissuring over the dorsum of both hands, especially the right, and the knuckles. Palms largely spared. No vesicles, exudate, crust, pustules, nail changes, or lymphangitis."
      }
    },
