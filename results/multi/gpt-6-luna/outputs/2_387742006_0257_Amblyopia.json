        "code": {
          "text": "Visual symptoms and ocular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports more glare in the afternoon in the lounge. Denies sudden vision loss, curtain, pain, or redness. No change in flashes or floaters. No new diplopia beyond baseline turn in the left eye."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
