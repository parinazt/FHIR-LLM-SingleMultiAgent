        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels weak and tired all the time for approximately 3–4 weeks; fatigue most days, worse in the afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps 7–8 hours; sleep is non-refreshing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, chest pain, palpitations, fever, night sweats, and weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Diet, hydration, caffeine, and activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diet described as poor, with increased toast and decreased vegetables; drinks 3–4 coffees daily, minimal water, and is very sedentary."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No menorrhagia; Mirena in situ and periods are lighter."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel movements and constipation symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding constipation, worse for the last 2–3 months. Bowel movements approximately 1–2 times per week; Bristol stool type 1–2, marked straining, and incomplete evacuation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Abdominal bloating"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bloating, reduced after bowel movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Gastrointestinal alarm symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies per-rectal bleeding, melaena, mucus, or change in stool calibre; no red-flag gastrointestinal symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as 'bit flat' but stable on sertraline; denies suicidal ideation. No acute risk today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sounds well, speaks in full sentences, no audible shortness of breath, and is coherent."
      }
    },
