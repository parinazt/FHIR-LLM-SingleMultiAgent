        "code": {
          "text": "Suicidal thoughts and safety assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal thoughts: 'be easier if I didnt wake up sometimes.' Denies active suicidal ideation, plan, or intent. Identifies family as protective; employment and future goals also noted as protective factors."
      }
    },
