        "code": {
          "text": "Left shoulder instability symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 6 weeks, the patient reports the left shoulder feels 'loose' and 'like its going to slip,' especially with overhead work lifting plywood sheets."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
