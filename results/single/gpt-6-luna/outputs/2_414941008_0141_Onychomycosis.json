          "text": "Systemic symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, weight loss, night sweats, and anorexia; appetite is okay. No recent overseas travel, sick contacts, antibiotic use, or previous similar episodes reported."
      }
    },
