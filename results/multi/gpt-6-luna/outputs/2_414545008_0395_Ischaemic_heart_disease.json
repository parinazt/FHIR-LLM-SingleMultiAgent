          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left lateral/posterior shoulder ache for approximately 5 days; pain 6/10 with movement and 2/10 at rest. Wakes patient 1–2 times per night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
