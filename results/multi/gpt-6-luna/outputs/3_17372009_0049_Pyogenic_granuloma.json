        "status": "final",
        "code": {
          "text": "Other skin and regional lymph node examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No similar lesions on brief check of exposed skin. No palpable regional lymph nodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Impact of right index finger lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Frequent bleeding and dressing changes at school are stressful; patient is worried about the lesion's appearance and parents thinking it is contagious."
