        },
        "valueString": "Negative on both sides."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower limb power, reflexes, and sensation grossly normal; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding hypersomnolence. Patient says she could nap pretty much any time or anywhere. Partner reportedly says she nods off on the couch and at work; patient minimises the concern. Patient feels drowsy a lot, has zoned out at red lights, and denies actually falling asleep while driving. Partner, not present, is reportedly worried about her daytime sleepiness and driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sleep pattern and restorative quality"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually in bed around 10–11 pm and gets up around 6–6:30 am; wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Kicking during sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports kicking in sleep; partner is disturbed by it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Sleep-related symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Per patient, partner reports no snoring or apnoeas. Patient denies cataplexy, sleep paralysis, and hallucinations."
      }
    },
    {
