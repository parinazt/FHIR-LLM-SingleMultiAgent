        "code": {
          "text": "General appearance and affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well and talkative; anxious when discussing fertility. Patient reports being quite distressed and pretty down on himself about fertility and sexual function."
      }
    },
