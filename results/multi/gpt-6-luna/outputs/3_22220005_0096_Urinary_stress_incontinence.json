        "code": {
          "text": "Pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "External genitalia normal. Mild vaginal atrophic change; no discharge and no obvious pelvic organ prolapse on Valsalva. Bimanual examination: uterus and adnexae non-tender, with no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
