        "code": {
          "text": "Suspected left plantar fasciitis (\"policeman's heel\")"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left heel pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 3–4 weeks of pain in the anteromedial left calcaneus, described as like standing on a stone. Worst with the first steps in the morning and after long periods sitting in a patrol car; eases after 10–15 minutes of walking, then becomes a dull ache by the end of the shift. Worse with long shifts, foot patrol, and heavy boots. No specific injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No redness or swelling, Achilles pain, neurological symptoms, or systemic symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vital signs and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vital signs stable; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild antalgic gait initially, improving quickly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Focused left heel examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Focal tenderness at the anteromedial calcaneal tuberosity and plantar fascia origin. No Achilles or posterior heel tenderness, swelling, or erythema. Windlass test reproduces pain. Calcaneal squeeze is non-tender. Neurovascularly intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Weight status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Overweight."
      }
    }
  ]
