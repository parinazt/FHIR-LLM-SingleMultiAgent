    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Naproxen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "500 mg once, then 250 mg twice daily with food for up to 5 days. Avoid other NSAIDs; take with food and fluids. Stop earlier if pain is much better or if any gastrointestinal symptoms occur."
          }
        ]
      }
    }
