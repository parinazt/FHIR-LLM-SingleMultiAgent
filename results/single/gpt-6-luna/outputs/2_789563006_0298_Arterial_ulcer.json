    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right lateral forefoot ulcer near the fifth metatarsophalangeal joint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1.5 × 1.0 cm; depth to dermis; punched-out edges; pale base with yellow slough and minimal serous ooze; surrounding skin pale and slightly shiny; very tender to palpation and cleaning; no exposed bone or tendon, fluctuance, or tracking cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right foot ulcer duration and progression"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Started approximately 10–12 weeks ago after knocking the foot on a bed frame; slowly increasing in size and depth; not healing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp and significant, especially at night and worse with elevation when lying flat; often dangles the leg off the bed to sleep; pain decreases when the foot is dependent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Claudication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral tight calf pain, right greater than left, after walking approximately 1–2 blocks on flat ground; settles within a few minutes of rest; worsening over the last 6–12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Patient-reported right foot temperature and colour changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot feels colder than the left at times and turns white when elevated on a recliner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Lower limb colour with elevation and dependency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "At 30° elevation for 1 minute, right forefoot and toes became pale, followed by dependent rubor on lowering; milder changes on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Lower limb skin and distal temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Skin thin, shiny and hairless on shins and feet; nails thickened; distal feet cool bilaterally, right colder. No varicose veins or venous stasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Capillary refill"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Delayed greater than 3 seconds in right toes; approximately 2–3 seconds on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Lower limb pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Femoral pulses palpable bilaterally, left greater than right; no definite bruit (noisy clinic). Popliteal pulses difficult to assess bilaterally. Dorsalis pedis absent on the right and very weak on the left. Posterior tibial absent on the right and weak, possibly monophasic, on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Foot sensory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Light touch mildly decreased in toes bilaterally; monofilament decreased at several plantar sites bilaterally; vibration decreased at great toes. Patient reports some toe tingling and denies complete numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Clinical signs of infection at presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, rigors, systemic symptoms, spreading redness, significant erythema, warmth, malodour, or clinical evidence of infection; no pus reported."
      }
    },
    {
