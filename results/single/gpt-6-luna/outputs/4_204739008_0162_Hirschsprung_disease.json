        "dosageInstruction": [
          {
            "text": "10 mg at night for 7–10 days as a trial for possible post-nasal drip; advised to try the first dose before driving because it may cause some drowsiness.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
