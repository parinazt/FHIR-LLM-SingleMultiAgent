    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset over 3 days; dull, constant, frontal and bitemporal, right greater than left; worse in the evenings and does not wake the patient from sleep. Patient rates pain 7/10. No thunderclap onset and not described as the worst ever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting, photophobia or phonophobia; mild light sensitivity only; no visual aura, jaw claudication, scalp tenderness, focal neurological symptoms, weakness, facial droop, speech difficulty, confusion, loss of consciousness, seizure, or ataxia. No neck stiffness, fever, or rigors. Patient thinks headache may be secondary to eyestrain from television and bright LED supermarket lights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left shoulder pain and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing left shoulder stiffness and pain for approximately 8–9 months. Patient cannot lift the arm to comb hair or hang washing; sleep is disturbed because the patient cannot lie on the left side. Shoulder was initially very painful and is now mainly stiff."
      }
    },
