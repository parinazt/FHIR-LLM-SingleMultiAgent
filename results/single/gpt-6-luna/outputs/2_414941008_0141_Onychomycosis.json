    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild generalised lower abdominal tenderness, left greater than right. No rebound, guarding, rigidity, focal right or left iliac fossa peritonism, epigastric or right upper quadrant tenderness, masses, or organomegaly. Bowel sounds normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
