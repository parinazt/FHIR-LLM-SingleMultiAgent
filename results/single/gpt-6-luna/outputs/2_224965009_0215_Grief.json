        "code": {
          "text": "Reported mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feeling very low and overwhelmed; mood described as really low."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Grief-related thoughts and feelings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grief occurs in reactive waves of intense yearning with a hollow feeling in the chest. Reports some guilt about not visiting her father more, but no pervasive worthlessness. Rumination about her father and replaying their last phone call, with intrusive images of him in hospital."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
