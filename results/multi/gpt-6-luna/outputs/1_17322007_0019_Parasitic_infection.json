        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 2–3 weeks: intermittent mild crampy lower abdominal discomfort and mild bloating; stool frequency 2–3 times daily, increased from baseline once daily. No overt diarrhoea, blood, mucus, weight loss, or nocturnal symptoms."
      }
    },
