    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Scrotal pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset left greater than right dull ache with intermittent sharp twinges for 3–4 days, worse over the last 24 hours and worse standing or walking at the end of the work day. Better lying down and with tight briefs/scrotal support, with only partial relief. Feels the left testis is bigger and heavy. Pain about 5–6/10 while walking; able to walk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated reported symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild urethral itch earlier in the week. No dysuria, frequency, haematuria, or obstructive urinary symptoms. No fever or rigors; felt a bit off yesterday, with no temperature taken. No nausea, vomiting, abdominal pain, or flank pain. No sudden onset severe pain and no pain waking him from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sexual history relevant to current presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heterosexual and sexually active; new partner approximately 2 months ago, condoms used inconsistently. No known STI and no previous STI screen for approximately 2–3 years. No insertive anal sex."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing; mildly irritable and requesting a quick prescription and tests."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal and flank examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, no masses, and no costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum mildly swollen with erythema compared with the right. Left epididymis tender and thickened; left testis non-tender with no discrete mass. Right testis and epididymis normal. Cremasteric reflex present bilaterally. Scrotal elevation gives partial relief. No palpable inguinal hernia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
