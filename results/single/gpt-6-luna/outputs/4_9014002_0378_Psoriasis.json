    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools for 7 days; initially 4–5 times daily, now 3–4 times daily; watery to mushy and brown. No mucus or rectal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy lower abdominal pain that decreases after bowel movements. Mild nausea during the first 2 days only; no vomiting. Appetite slightly reduced; fluids adequate. No nocturnal symptoms, incontinence, or weight loss. No reported fever or rigors; temperature not checked by the patient."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported food exposure and patient's attribution"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ate takeaway chicken and coleslaw the night before symptoms; patient said it tasted 'a bit off' and was convinced it caused the diarrhoea. No recent travel or sick contacts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Relevant gastrointestinal history and investigations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent antibiotics or hospital admission. No history of IBD, coeliac disease or colorectal cancer in first-degree relatives. Stool tests had not yet been done; stool culture form had been provided at a prior telehealth visit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild diffuse lower abdominal tenderness on deep palpation; no guarding, rebound, masses or organomegaly. Bowel sounds mildly increased. Rectal examination not performed because the patient declined."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General examination and hydration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, mildly irritable but cooperative, and in no acute distress. Mucous membranes moist, capillary refill under 2 seconds, and no postural symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Psoriasis skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scalp erythematous plaques with silvery scale at the frontal hairline and occiput, extending about 1–2 cm beyond the hairline. Symmetrical, well-demarcated salmon-pink plaques with silvery scale and some excoriation on elbows and knees, about 3–4 cm; body surface area about 4–5%. No pustules or erythroderma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Nail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pitting in a few fingernails; no onycholysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Musculoskeletal symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional morning finger stiffness lasting 10–15 minutes. No persistent joint swelling, dactylitis, heel pain or clear inflammatory back features elicited. No obvious joint swelling, erythema or deformity in hands, wrists or knees; full active range of motion and small joints non-tender today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Psoriasis course and treatment history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Plaque psoriasis for more than 10 years, affecting scalp, elbows and knees. Intermittent mid-potency topical steroids and coal tar have provided partial control; flare with increased plaques and worse scalp itch over the last 2–3 months. No previous systemic treatment or phototherapy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Smoking and alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Does not smoke. Drinks 2–3 glasses of wine most nights and said it helps with sleep; clinician assessed intake as above NHMRC recommendations. Denies morning drinking and withdrawal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Mood and psychosocial findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Self-conscious at work and described mood as 'a bit fed up'; denies suicidal ideation. Affect appropriate though frustrated; insight intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and focused systems review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, shortness of breath, palpitations, eye redness, visual change or urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Recent blood tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent blood tests in the system for more than 12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Diet and lifestyle"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports high intake of takeaway and convenience foods, difficulty exercising due to fatigue and limited time, and wonders whether gluten intolerance is present; no formal elimination trial."
      }
    },
