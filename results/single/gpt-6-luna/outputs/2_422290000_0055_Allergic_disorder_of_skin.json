              {
                "doseQuantity": {
                  "value": 2,
                  "unit": "sprays in each nostril"
                }
              }
            ]
          },
          {
            "text": "Then reduce to 1 spray in each nostril every morning for maintenance, as tolerated",
            "route": {
              "text": "intranasal"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
