        "status": "final",
        "code": {
          "text": "Medication adherence"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor PPI adherence: patient reports forgetting esomeprazole before breakfast and having run out of reflux tablets before entering the facility. RACF medication administration record notes frequent refusals or delays of morning medicines. Patient and staff report reluctance to attend previous appointments."
      }
    },
