    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Facial and anterior neck skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Forehead, nasal bridge, both malar areas, anterior neck to upper chest involved, with a clear T-shirt line and safety-glasses border pattern. Forehead, nose and neck erythematous, warm, mildly tender, with intact sensation. Both upper cheeks have 2–3 cm areas of healing superficial partial-thickness skin injury where blisters ruptured; areas are pink and moist, with no slough or pus. Skin is soft with no circumferential neck involvement or tight eschar. No charring; minimal singeing of eyebrows and sideburns. No clinical cellulitis at examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Estimated total body surface area involved"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5–6% TBSA; supervisor addendum estimates approximately 5%."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Burn-related pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 3/10; described as more annoying than anything."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Facial and mouth-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports tightness when opening the mouth wide and discomfort with shaving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "After the bright flash, saw spots for a few minutes, then they settled. Mild grittiness in both eyes occurred on the first night and has resolved. Currently denies eye pain, photophobia, blurred vision, foreign-body sensation, or decreased vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No periorbital oedema; lids open fully and no burns at lid margins. Mild conjunctival injection, no chemosis. PERRLA, EOMI, visual acuity grossly normal and able to read a poster. No photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Airway and respiratory symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hoarseness, dysphagia, shortness of breath at the time of injury or since, cough, and soot in the mouth. Oropharynx clear with no soot or marked posterior pharyngeal erythema. Voice normal; no stridor. Neck supple, trachea midline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Other reported systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, chills, nausea, and vomiting; reports feeling otherwise well."
      }
    },
