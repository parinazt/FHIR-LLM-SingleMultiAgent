    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tightness low in the throat/upper chest when swallowing saliva, occasionally liquids, for 3–4 months; throat feels dry when swallowing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated throat symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild hoarseness, especially after long retail shifts talking all day; voice mildly husky initially on examination, then improved. No true odynophagia, no dysphagia to solids, no food sticking, and denies classic globus. No cough, choking or aspiration, weight loss, fevers or night sweats. No typical GORD; occasional sour taste when lying down soon after dinner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Oropharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear, with mild posterior pharyngeal erythema and cobblestoning; no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Neck and thyroid examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No lymphadenopathy. Thyroid not enlarged, no nodules, and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent vaginal dryness and dyspareunia despite Sylk 2–3 times weekly and lubricant as needed; mild increased urinary frequency. No dysuria, urgency, incontinence or postmenopausal vaginal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
