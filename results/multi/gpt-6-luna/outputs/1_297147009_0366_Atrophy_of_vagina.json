    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Throat discomfort when swallowing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tightness and dryness in the low throat/upper chest when swallowing saliva, occasionally liquids, for 3–4 months"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated throat symptoms and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild hoarseness, especially after long shifts talking. No true odynophagia, dysphagia to solids, food sticking, classic globus, cough, choking or aspiration, weight loss, fevers or night sweats. Occasionally has a sour taste when lying down soon after dinner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent vaginal dryness and dyspareunia despite vaginal moisturiser and lubricant use"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly increased urinary frequency; no dysuria, urgency or incontinence"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
