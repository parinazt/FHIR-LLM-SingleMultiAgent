    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Mid-to-lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "New gradual central to slightly right-sided mid-to-lower back pain for approximately 5–6 days, with no clear injury and no radiation to the legs. Described as a dull, tight ache: 4–5/10 at baseline and up to 7/10 after a big work day. Worse at the end of the day on concrete, first thing in the morning, with bending, lifting ladders or tools, prolonged standing, driving on a rough farm track, and possibly a new firmer mattress and increased ute driving on a rough driveway. Eases somewhat after moving; lying flat, heat pack, and Nurofen relieve it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain red-flag symptoms and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By history, denies trauma or fall; saddle anaesthesia; leg weakness or numbness; bowel or bladder incontinence or urinary retention; fevers; night sweats; weight loss; unrelenting nocturnal pain; known cancer; or systemic illness. Also denies limb paraesthesia and gait disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Back pain function and reported mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working and pacing himself, avoiding heavy lifting, with no time off work yet. Reports being able to mobilise, heel-toe walk, squat, and climb stairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Peyronie's disease and erectile symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports Peyronie's disease diagnosed approximately 12 months ago with curvature and a palpable plaque. Curvature has been about the same over the last few months. Reports mild erectile symptoms, described as taking a bit more effort, without complete erectile dysfunction; some discomfort with intercourse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Penile and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies penile pain at rest, haematuria, dysuria, or discharge. Reports normal urinary stream, no frequency or urgency, and no change in baseline nocturia of once nightly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies unexplained weight loss and fevers. Reports fatigue only in association with poor sleep due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telehealth examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Telehealth consultation by phone; no physical examination was possible. Speech was coherent and engaged, with appropriate questions and no distress apparent over the phone."
      }
    },
    {
