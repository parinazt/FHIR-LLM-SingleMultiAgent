    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Sofradex ear drops (dexamethasone 0.05%, framycetin 0.5%, gramicidin 0.005%)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Instil 3 drops into the right ear three times daily for 7 days.",
            "route": {
              "text": "ear"
            },
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d",
                "boundsDuration": {
                  "value": 7,
                  "unit": "days"
                }
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 3,
                  "unit": "drops"
                }
              }
            ]
          },
          {
            "text": "May use in the left ear twice daily for 3–5 days if it becomes painful, provided there is no trauma or possible perforation.",
            "route": {
              "text": "ear"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 3,
