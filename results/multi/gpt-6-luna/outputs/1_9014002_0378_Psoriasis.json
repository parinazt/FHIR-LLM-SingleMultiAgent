    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported 7 days of loose stools. Initially 4–5 times daily, now 3–4 times daily; watery to mushy and brown. No mucus or PR bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy lower abdominal pain, decreased after bowel movements."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea during the first 2 days only; no vomiting. Appetite slightly decreased; fluids reported as adequate. No nocturnal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported fever or rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no fever or rigors; temperature had not been checked before the visit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Other reported diarrhoea-associated findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent travel, sick contacts, recent antibiotics, or hospital admission. No incontinence or weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild diffuse lower abdominal tenderness on deep palpation. No guarding, rebound, masses, or organomegaly. Bowel sounds mildly increased."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "General appearance and hydration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, mildly irritable but cooperative, and in no acute distress. Mucous membranes moist; capillary refill under 2 seconds; no postural symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Scalp skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous plaques with silvery scale at the frontal hairline and occiput, extending approximately 1–2 cm beyond the hairline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Elbow and knee skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symmetrical, well-demarcated salmon-pink plaques with silvery scale and some excoriation, approximately 3–4 cm, on elbows and knees. Estimated BSA 4–5%. No pustules or erythroderma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Nail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pitting of a few fingernails; no onycholysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Musculoskeletal symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports occasional morning finger stiffness lasting 10–15 minutes. No persistent joint swelling, dactylitis, heel pain, or clear inflammatory back features elicited. No obvious joint swelling, erythema, or deformity in hands, wrists, or knees; full active range of motion and small joints non-tender today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Cardiopulmonary, eye, and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no chest pain, shortness of breath, palpitations, eye redness, visual change, or urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
