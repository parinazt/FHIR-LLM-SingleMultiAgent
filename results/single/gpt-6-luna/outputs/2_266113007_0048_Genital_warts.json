    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Headache history and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull band-like frontal and temporal headache, sometimes occipital, for about 3 weeks; 3–4/10, up to 6/10 on bad days. Worse later in the day after long bar shifts or screen use. Sleep helps; Panadol 500 mg, 1–2 tablets as needed, provides partial relief. No thunderclap or worst-ever headache; no vomiting, photophobia, phonophobia, aura, visual change, focal neurological symptoms, speech change, confusion, fever, neck stiffness, weight loss, night sweats, sinus symptoms, or trauma. Rare mild nausea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neurological and fundoscopic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-focal neurological examination; cranial nerves intact, gait and coordination normal, no meningism, and no papilloedema on fundoscopy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vulval and pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple 2–4 mm soft, skin-coloured/verrucous papules, approximately 6–8, on the labia minora and posterior introitus; non-tender, with no ulceration, vesicles, or discharge. Vagina and cervix normal. No inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vulval symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports vulval bumps for 2–3 months, thought to be from shaving, with mild itch/irritation after sex or wiping. No significant pain, bleeding, discharge, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sexual history and HPV vaccination history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "One male partner for about 8 months; condoms mostly not used. No STI screen for a few years. HPV vaccination status uncertain; patient recalls receiving some injections in high school."
      }
    },
    {
