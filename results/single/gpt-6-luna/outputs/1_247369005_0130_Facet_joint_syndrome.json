    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Low back pain pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime pain is approximately unchanged and a mild ache, increased by sitting too long at a desk. During the past 3–4 weeks, pain has been more noticeable at night when trying to sleep. Pain is localized to the low lumbar area, right greater than left, and is non-radicular. Dull ache with occasional sharp twinge on extension or twisting in bed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep; wakes 1–2 times to change position, then returns to sleep. Mood reported as okay; patient is frustrated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Possible contributors to sleep and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "New firmer mattress approximately 2 months ago; drinks two coffees late in the evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurologic and other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg weakness or numbness, bowel or bladder symptoms, saddle anaesthesia, weight loss, fever, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Lumbar back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Localized tenderness over lower lumbar facet joints, right greater than left; no midline tenderness. Mildly reduced flexion with end-range ache. Extension and rotation reproduce local pain only, with no radicular symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lower-limb neurologic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower-limb power 5/5; reflexes normal; sensation intact; straight-leg raise negative bilaterally; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Previous lumbar X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Facet osteoarthritis; no red flags reported. No investigations performed today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Red-flag safety-net symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient was warned to seek urgent review or attend the emergency department for leg weakness or numbness, saddle anaesthesia, bowel or bladder change, fever, weight loss, or constant unrelenting night pain."
