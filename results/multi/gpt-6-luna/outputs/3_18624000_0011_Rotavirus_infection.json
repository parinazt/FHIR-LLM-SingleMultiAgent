        },
        "valueString": "Mild headache and myalgias reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Subjective fever and chills"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Felt hot and cold overnight; no documented temperature at that time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Fluid intake and urine output"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Taking small sips of water and electrolyte drink; passing small volumes of pale yellow urine every 4–5 hours. Mild dry mouth. No dizziness on standing or syncope."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
