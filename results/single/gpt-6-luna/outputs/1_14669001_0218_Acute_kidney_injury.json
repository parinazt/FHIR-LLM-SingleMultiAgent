          "text": "Urinary symptoms and urine appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria and haematuria. Urine colour unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
