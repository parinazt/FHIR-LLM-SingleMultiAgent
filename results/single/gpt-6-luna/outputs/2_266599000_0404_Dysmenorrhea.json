        "code": {
          "text": "Adenomyosis with secondary dysmenorrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "code": {
          "text": "Previous iron deficiency associated with heavy menses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash distribution and skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple ill-defined erythematous patches/thin plaques, 1–3 cm, on wrists and distal forearms, with some excoriations; a few faint erythematous macules on the anterior neck. No vesicles, pustules, crusting, warmth, tenderness, or swelling; no mucosal, palm, sole, or genital involvement and no target lesions. No cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rash itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for approximately 5 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rash pain, blistering, weeping, or pus; no fever, upper respiratory symptoms, joint pains, or oral or eye symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vital signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Dysmenorrhoea history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Period pain increased over the last few cycles; pattern described as stable, with no intermenstrual or postcoital bleeding and no new pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Mefenamic acid"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "500 mg three times daily as needed for the first 2–3 days of menses",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 500,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Advised to use mefenamic acid as the main NSAID."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "200–400 mg three times daily as needed; often taken with mefenamic acid",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 200,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "The reported dose range is 200–400 mg. Advised to avoid taking ibuprofen together with mefenamic acid."
          }
        ]
      }
    },
