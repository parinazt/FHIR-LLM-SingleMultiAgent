        "code": {
          "text": "Initial systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately three days before assessment, felt fluey at work with mild headache, fatigue and low-grade fever."
      }
    },
    {
