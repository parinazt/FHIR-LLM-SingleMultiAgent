        "code": {
          "text": "C6>±C7 cervical radiculopathy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Symptoms for approximately 4 months, with persisting neuropathic pain and objective reduced sensation and mild reduced motor strength in the right upper limb; no myelopathy signs currently."
          }
        ]
      }
    },
