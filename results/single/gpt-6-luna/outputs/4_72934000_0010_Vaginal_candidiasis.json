        "status": "final",
        "code": {
          "text": "General appearance and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and is afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no suprapubic or loin tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Vulvar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vulva erythematous with mild oedema, excoriations, and small fissuring at the posterior fourchette. Thick white curdy discharge on vulva/introitus; no fishy odour, ulcers, or vesicles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Speculum examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited examination: erythematous vaginal walls with adherent white plaques; cervix normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "High vaginal swab microscopy and culture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Many budding yeasts and pseudohyphae; Candida albicans, heavy growth, azole sensitive. Lactobacilli present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "High vaginal swab findings for other organisms and bacterial vaginosis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trichomonas. Minimal clue cells and whiff test negative; no current bacterial vaginosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
