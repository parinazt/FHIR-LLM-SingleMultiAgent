        "status": "final",
        "code": {
          "text": "Lower urinary tract symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worsening over the last 3–4 months: hesitancy, straining, weak stream, prolonged time to empty, and feeling incompletely emptied after urination. Frequency every 1–2 hours and nocturia 2–3 times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Urinary dribbling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small-volume dribbling for about 3 weeks, especially after voiding and sometimes without urge; reports damp underwear despite having just urinated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Lower abdominal pressure/fullness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild; worse when holding on."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, visible blood in urine, fevers, rigors, flank pain, nausea or vomiting, and severe suprapubic pain. Reports never having had acute urinary retention requiring catheterization. No known neurological issues; no red-flag neurological symptoms volunteered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
