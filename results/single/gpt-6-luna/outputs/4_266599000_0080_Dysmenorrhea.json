          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Endometriosis, confirmed by laparoscopy approximately 3 years ago"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Cyclical lower abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central cramps, left greater than right, radiating to the low back and inner thighs. Begins 1–2 days before bleeding, is worst during the first 2 days, then eases."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Menstrual pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Currently 8/10 on the worst days; previously approximately 5–6/10 after laparoscopy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms with menses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea, loose stools on days 1–2, fatigue, and occasional headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, urinary symptoms, abnormal vaginal discharge, intermenstrual bleeding, postcoital bleeding, and postcoital pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual cycle pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Menarche at 12 years. Cycles every 28–30 days; bleeding for 5–6 days. Moderate-to-heavy flow for the first 2 days, then light; uses super pads or tampons, changing every 3–4 hours. Denies flooding and large clots."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Dysmenorrhoea history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dysmenorrhoea since the teenage years, worsening in the early 20s and prompting workup and diagnosis of endometriosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Deep dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild deep dyspareunia around menses only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
