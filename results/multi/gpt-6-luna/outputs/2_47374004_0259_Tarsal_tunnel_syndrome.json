    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset yesterday afternoon; intermittent crampy central/epigastric pain just above the umbilicus in waves lasting 10–20 minutes, more noticeable after meals and woke the patient once overnight. Pain was 6–7/10 at worst and is now approximately 4/10. Worse after eating, especially a heavier meal; partially relieved by sitting upright, a heat pack, and paracetamol. Pain increases slightly with bending but is not clearly localised to one quadrant."
      }
    },
