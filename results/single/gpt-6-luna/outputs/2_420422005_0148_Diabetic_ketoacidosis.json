    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported lower back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing approximately 10 days: dull mid-lumbar ache rated 4–5/10, worse after long shifts stacking boxes and better with rest and a heat pack. No radiation, pins and needles, weakness, saddle anaesthesia, or bowel or bladder symptoms. Patient wondered whether it might relate to a new mattress or twisting while loading a truck. No trauma, fall, or single heavy lift reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported symptoms over the last 2–3 days"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels very washed out and unwell, very thirsty, and urinating frequently including nocturia 4–5 times. Mild nausea and poor appetite since a mild gastroenteritis approximately 1 week ago; no vomiting. Vague upper abdominal discomfort without focal severe pain. Headache yesterday and feels a bit foggy. Partner reports he has been a bit slower than usual at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported relevant negative symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, cough, and dysuria. No known recent infection or previous diabetic ketoacidosis reported. No insulin use reported. Drinks alcohol rarely and is a non-smoker."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
