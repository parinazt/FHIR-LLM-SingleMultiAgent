    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right shoulder pain and weakness, reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insidious dull ache in the lateral right shoulder and upper arm with weakness for 3–4/12 as documented. Pain increases with reaching overhead or out to the side, such as doing dishes or washing. Night pain, especially lying on the right side, wakes her a few times per week. Patient describes the arm as more weak than painful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right arm functional impact, reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced power lifting a jug; struggles with shopping and lifting above shoulder height, and uses the left hand to assist. Dressing, putting on a bra or jumper, washing hair, and hanging washing are slower; avoids overhead tasks but remains independent with activities of daily living. Daughter is concerned about hanging washing and lifting a kettle."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right shoulder symptom-associated history and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, fall, or heavy lifting reported; possible overreach into a cupboard. No neck pain, radicular symptoms, or paraesthesia. No weight loss, fevers, night sweats, or cancer history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Older woman; stoic and under-reporting discomfort, with mild guarding of the right shoulder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right shoulder inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild reduction in supraspinatus and infraspinatus bulk compared with the left. No deformity or erythema. Tender over the greater tuberosity and anterolateral shoulder; acromioclavicular joint non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right shoulder active range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abduction approximately 70° and flexion approximately 90°, limited by pain and weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right shoulder passive range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Near full, with mild end-range pain and no capsular pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Shoulder strength"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right abduction 3/5 with pain; right external rotation 3–4/5 with pain; right internal rotation 4/5. Left strength 5/5 throughout."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right shoulder special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Jobe test positive with pain and weakness; external rotation resistance test positive; Hawkins test positive; Neer test positive; lift-off mildly weak; O'Brien test equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Neurological, vascular, and cervical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; pulses present, capillary refill under 2 seconds, sensation intact C5–T1, reflexes symmetrical, full neck range of motion, and Spurling test negative. No new focal neurological deficit. No new speech change, facial droop, or leg weakness reported."
      }
