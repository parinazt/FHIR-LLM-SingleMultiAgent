    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Shoulder has been a bit sore for about 3 months, gradual onset with no clear injury. Dull anterolateral ache with a sharp twinge on some movements. Wakes if she rolls onto the left side; trouble hanging washing, reaching overhead, and doing her bra behind her back. No neck pain, radiation past the elbow, pins and needles, or true weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Urinary and urethral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a little red lump at the urine opening for about 6–8 weeks and mild intermittent stinging at the end of urination. Had two tiny spots of blood on paper last month, none since. No dysuria, frequency, urgency, visible haematuria in the bowl, vaginal bleeding, or discharge."
      }
    },
