          ]
        },
        "code": {
          "text": "Right lateral epicondylitis / common extensor tendinopathy, chronic and stable; work-related overuse contributing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right lateral elbow pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for approximately 5–6 months; plateaued over the last 4–6 weeks. Worse with lifting and twisting, checkout work, and handling a kettle or saucepan."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent night pain and brief morning stiffness. No trauma, locking, giving way, paraesthesia, or neck or shoulder symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right elbow inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No swelling, redness, or warmth. Focal tenderness over the lateral epicondyle/common extensor origin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right elbow range of motion and provocative testing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion. Pain at end-range wrist extension with the elbow extended; pain with resisted wrist extension and middle-finger extension."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right upper limb power, sensation, and pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power, sensation, and pulses normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right elbow ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Common extensor tendinopathy with a small intrasubstance tear measuring less than 3 mm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right elbow ultrasound negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No effusion, erosions, or features of inflammatory arthropathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Topical diclofenac gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply over the lateral elbow four times daily as needed",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "asNeededBoolean": true
          }
        ]
      }
    }
  ]
