        "status": "final",
        "code": {
          "text": "Scalp examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild diffuse flake."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Cluster headache course and current symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known episodic cluster headaches diagnosed by neurology. Last bout started approximately 10 weeks ago and has been quiescent for 3 weeks. No current headache. Reports good control with sumatriptan and home oxygen. No medication-overuse headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
