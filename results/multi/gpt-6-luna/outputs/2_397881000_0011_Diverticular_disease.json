        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal alignment; mild bilateral lumbar paraspinal tenderness to palpation; no midline tenderness; decreased flexion and extension."
      }
    },
