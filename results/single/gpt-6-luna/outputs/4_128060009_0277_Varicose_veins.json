      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Reported associated and risk symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, night sweats, chest pain, shortness of breath, palpitations, haemoptysis, significant calf swelling away from the affected area, groin or thigh pain, and rest pain. No current leg wounds, ooze, or spreading cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Recent provoking factors and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no trauma, cannulae, or injections to the leg; no recent surgery, immobilisation, long-haul flights, hormone replacement therapy, known malignancy, weight loss, night sweats, or anorexia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobility reduced somewhat; still walking shorter distances. Walks to local shops most days, limited by leg discomfort."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "History of intermittent calf ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent calf ache on longer walks; no rest pain or foot ulcers."
      }
