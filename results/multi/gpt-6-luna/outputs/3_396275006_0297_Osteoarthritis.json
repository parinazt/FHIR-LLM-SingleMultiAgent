          "text": "Overweight by history (BMI approximately 29–30 at last face-to-face visit 6 months ago)"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
