        "code": {
          "text": "Acute left shoulder pain, likely rotator cuff tendinopathy/impingement pattern after lifting at work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No improvement; pain approximately 7/10, described as a deep ache in the lateral/posterior left shoulder. Worse with overhead movement and reaching behind the back. Sleep disturbed, especially when lying on the left side. No radiation below the elbow and no neck pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
