    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth appearance and self-palpation findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No direct examination performed. Patient was speaking in full sentences and sounded comfortable, not acutely distressed. On guided self-palpation, patient described no marked focal tenderness, guarding, or rigidity; discomfort was mainly epigastric."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
