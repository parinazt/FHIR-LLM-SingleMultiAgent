        "code": {
          "text": "Upper back skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few papules and macules on the upper back. No infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
