    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Weakness and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feeling really weak, tired, drained and wiped out for about 5 days; struggles to get through workday and fatigues by mid-afternoon. Able to complete basic ADLs more slowly than usual and needs rests."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea began about 5 days ago; vomiting occurred over about 4 days, peaked over 2 days at 5–6 times per day (food then bile), and was largely settled at the visit; last vomited yesterday morning. No haematemesis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Oral intake and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced oral intake and reduced appetite during recent vomiting illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
