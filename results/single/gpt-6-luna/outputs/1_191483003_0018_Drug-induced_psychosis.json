        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Recent psychotic episode"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately two weeks before review, experienced acute agitation, visual and auditory hallucinations, and paranoia after heavy stimulant use (\"speed, maybe something else mixed in\"). Observed in the emergency department without formal admission; symptoms settled over approximately 24–36 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Current psychotic symptoms and thinking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies current auditory or visual hallucinations and paranoia; no thought disorder reported, and describes thinking as \"pretty clear now.\""
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
