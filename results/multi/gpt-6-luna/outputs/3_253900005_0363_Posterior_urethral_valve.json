        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear. Heart sounds dual, with no added sounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no mass or suprapubic distension. No costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Reported fluid intake and voiding behavior"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking lots of coffee and energy drinks and probably not enough water. Often holds urine at work."
      }
