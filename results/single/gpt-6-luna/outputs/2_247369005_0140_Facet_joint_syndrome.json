        "code": {
          "text": "Lumbar facet joint syndrome / facet joint osteoarthritis, chronic, with current mild-to-moderate flare"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Lumbar back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent pain localised to the lumbar region without radiation. Current flare began gradually about 3 weeks ago without trauma. Pain 4/10 at baseline and up to 7/10 after prolonged sitting or driving; worsened by extension and twisting, improved by heat, gentle stretches and distraction. Often more noticeable at night when quiet. Still managing activities of daily living, with more breaks at work. Paracetamol provides partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Denied spinal red-flag, radicular and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg weakness, numbness or paraesthesia, saddle anaesthesia, bowel or bladder symptoms, fever, weight loss and night sweats. No reported radiation or neurological symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Telehealth general appearance and respiratory observation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no apparent distress, speaking in full sentences. No obvious pallor or cyanosis. Respiratory rate visually normal; no audible wheeze or cough."
      }
    },
