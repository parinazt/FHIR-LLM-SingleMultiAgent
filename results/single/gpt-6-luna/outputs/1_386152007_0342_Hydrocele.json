    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent behavioural and sleep changes reported by daughter"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over approximately 5–6 days, more withdrawn, no longer watching usual TV, pacing and increasingly fidgety especially in the late afternoon; poorer sleep, up and down overnight with more grunting vocalisations. Daughter reports he is not himself and that something is bothering him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported pain and discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittently clutches lower abdomen/groin. When prompted about pain, patient said it was 'just a bit sore', 'nothing really', did not want to be a bother, and had 'put up with worse'; noted to tend to minimise symptoms. Daughter reports behaviour may be more reliable than his verbal report."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Oral intake, hydration, urination and bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral intake decreased over the last 3 days, but drinking remains adequate. Passing urine and bowel motions as usual. Carer reports formed bowel motions 1–2 times per day, with no diarrhoea or constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known fever, vomiting, change in bowel habit, visible haematuria or trauma. Daughter feels the scrotal lump looks a bit bigger again and is concerned continence pads may be rubbing or compressing it. Daughter queried whether frozen dinners this week may be upsetting his stomach."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Genitourinary symptoms reported by carer"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious dysuria; continence pads have usual urine volume and colour, with no foul odour."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Respiratory, neurological and skin symptoms reported by carer"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cough, shortness of breath, wheeze, new focal neurological symptoms, new rashes or pressure areas reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance and interaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Afebrile and reasonably comfortable at rest; slightly guarded during lower abdominal/groin examination, with limited eye contact and slow responses. Repeated, 'I'm alright doc.'"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur or peripheral oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, mildly tender suprapubically and in the right inguinal region; no guarding or rebound, no mass, and bowel sounds normal. No obvious inguinal hernia on attempted Valsalva."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Left testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left testis descended, normal size and consistency, non-tender, with no mass."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Right scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right hemiscrotum enlarged and tense, not erythematous or hot, with mild diffuse tenderness, especially superiorly; transilluminates, consistent with hydrocele. Testis difficult to palpate clearly, with no discrete hard mass felt. No scrotal skin breakdown despite pad use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Inguinal and genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious inguinal hernia with cough or strain, although examination limited by cooperation. Penis uncircumcised; foreskin retractable, glans clean, with no lesions or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Musculoskeletal and mobility examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Back and hips non-tender with good passive range of motion. Mobilises short distances with a four-wheeled walker and supervision."
      }
    },
