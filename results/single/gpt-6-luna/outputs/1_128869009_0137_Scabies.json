      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Itchy rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for approximately 3–4 weeks, worse at night, especially after late shifts. Began on wrists and hands and spread between fingers, around the waistline/lower abdomen, and to the inner thighs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Papules and excoriations on wrists, interdigital spaces, lateral fingers, periumbilical/waistband area, inner thighs, and anterior axillary folds. A few linear burrows between fingers. No features of crusted scabies."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Superficial skin lesions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few small superficial pustules and crusted lesions on shins and forearms, consistent with mild secondary infection. No significant surrounding cellulitis; non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
