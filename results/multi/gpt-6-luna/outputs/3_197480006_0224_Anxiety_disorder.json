    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Anxiety and worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling more on edge over the last few weeks and worrying about many things most days, especially in the evenings and overnight; prominent worries about memory, heart symptoms, and cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep and wakes 1–2 times per night with worry; settles after staff reassurance. Denies nightmares."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Chest tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent mild chest tightness when anxious, lasting minutes and settling with slow breathing and staff presence; reports a similar pattern for years."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
