    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Chronic pelvic pain characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull, deep pelvic ache in the suprapubic area and left greater than right lower iliac fossa; present for more than 3 years."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Pelvic pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline approximately 2–3/10, flaring to approximately 7/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Change in pelvic pain frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain pattern largely similar, but bad days have become more frequent over the last 6–9 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pelvic pain triggers, duration, and relief"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse around menses and mid-cycle, after long days standing while teaching, and sometimes after intercourse. Episodes last hours to a full day, with partial relief from simple analgesia and a heat pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Post-coital spotting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent small-volume post-coital spotting for 3–4 months; settles within 24 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Menstrual pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Regular periods every 28–30 days, slightly more crampy than a few years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Deep ache after intercourse on approximately one-third of occasions; not severe enough to stop intercourse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported systemic and pelvic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, feeling systemically unwell, and abnormal vaginal discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Bowel symptoms with inflammatory bowel disease"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports inflammatory bowel disease currently quiescent, with no new diarrhoea, rectal bleeding, or nocturnal symptoms beyond baseline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Weight stable by patient report; no obvious weight loss compared with prior video consultations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other reported red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sudden severe unilateral pain, shoulder-tip pain, dysuria, urinary frequency, flank pain, nausea, vomiting, anorexia, night sweats, and weight loss. No history of abnormal cervical screening test reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Copper intrauterine device history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Copper IUD in situ for approximately 8 years, replaced once at the 5-year mark; approximately 8 years of continuous use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Previous pelvic ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pelvic ultrasound approximately 18 months ago was reportedly unremarkable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Previous pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last in-person pelvic examination and cervical screening test approximately 2 years ago were reported as normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Cervical screening test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Result rechecked in file: 19/10/2023, NILM and HPV negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Previous sexually transmitted infection screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chlamydia and gonorrhoea screening negative at the time the IUD was checked; patient reports no new partners."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "General appearance on video examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, alert, coherent, and in no distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
