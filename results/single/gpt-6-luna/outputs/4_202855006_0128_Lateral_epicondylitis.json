          "text": "Right lateral elbow pain duration and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5–6 months; plateau over the last 4–6 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
