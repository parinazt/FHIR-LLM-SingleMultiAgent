        "code": {
          "text": "Right lower leg tightness and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the skin feels \"tight\" on standing. Initially no itch; now mild itch at the edges only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
