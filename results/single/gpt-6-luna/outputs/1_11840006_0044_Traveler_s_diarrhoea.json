    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset over 2 days; central across the belt line, aching and stiff, approximately 5–6/10. Worse with bending and standing from sitting; improves somewhat lying flat. No radiation or leg symptoms. Began after a day of increased toilet trips; patient wondered whether straining contributed. Recent poor mattress and prolonged plane sitting were discussed as possible triggers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain red flags and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, fall, or heavy lifting. Denies saddle anaesthesia, leg weakness, paraesthesia, gait disturbance, weight loss, night sweats, cancer history, IV drug use, or significant trauma. Reports no urinary incontinence, retention, or change in bowel control."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Loose stools after travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools began about 24 hours after returning from Bali 5 days ago. Currently 4–5 watery bowel movements per day. No blood or mucus reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Abdominal pain associated with bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy lower abdominal pain before a stool, relieved afterwards."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies vomiting, fever, and rigors. Reports no fever; home temperature described as \"36-something\". No sick contacts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hydration and urinary output by history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinking water and pharmacy oral rehydration solution. Passing urine every 3–4 hours; urine light yellow. Denies postural dizziness and palpitations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telehealth examination and general appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited phone examination: alert and coherent, speaking in full sentences, sounds comfortable, and no shortness of breath. By history, no neurological red flags, features of severe dehydration, or systemic toxicity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Medication response for low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports using ibuprofen 200 mg x2 as needed, with some relief, and using a heat pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
