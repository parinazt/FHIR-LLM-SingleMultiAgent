    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ear pain for 3–4 days, getting worse; especially painful with pinna movement, tragal pressure, lying on the right side, and using earbuds at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right ear blocked sensation and reduced hearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the right ear feels blocked with reduced hearing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right ear discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scant clear to slightly yellow discharge noted on a cotton bud the day before."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Ear itching and flaking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch and flaking behind the ears currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right external ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right pinna and tragus very tender to light touch. Canal oedematous, erythematous, moist, with whitish-yellow debris. Tympanic membrane only partly visualised and appears intact; no bulging or obvious middle-ear effusion. No mastoid tenderness or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and scaling of the external canal and conchal bowl, consistent with dermatitis; canal patent and tympanic membrane intact. Mild tragal tenderness only on deep palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Peri-auricular skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild scaling and erythema in bilateral post-auricular folds, consistent with a seborrhoeic/contact dermatitis mix."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General and neurological examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Afebrile and mildly uncomfortable, not in acute distress. No cellulitis, perichondritis, or regional lymphadenopathy. Cranial nerves II–XII grossly intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Patient-denied symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies upper respiratory symptoms, nasal congestion, tinnitus, vertigo, fever, rigors, facial weakness, severe headache, neck stiffness, trauma, or foreign body in the ear. Reports no weight loss, night sweats, or other systemic symptoms. No diabetes, immunosuppression, or recent systemic antibiotics."
      }
    },
