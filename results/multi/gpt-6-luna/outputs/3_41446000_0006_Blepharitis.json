        "status": "final",
        "code": {
          "text": "Eyelid examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral erythematous lid margins, collarettes/crusts at lash bases, mild thickening, and a few misdirected lashes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Meibomian gland and tear film examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Plugging/inspissation of meibomian glands, turbid secretions on pressure, mild tenderness, and frothy tear film."
      }
    },
    {
