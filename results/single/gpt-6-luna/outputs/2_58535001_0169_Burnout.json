    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low mood and reduced interest or motivation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports ongoing low mood for a few weeks to months, feeling flat and tired, difficulty getting motivated for shifts, spending days off in bed doom scrolling, and cancelling social activities. Describes reduced sense of accomplishment and guilt about not caring enough for patients."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Fatigue and emotional exhaustion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports marked fatigue and emotional exhaustion. Feels numb at work, irritable with colleagues and partner, and over it with work; says she feels like she does not make a difference."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleeping all the time but not feeling refreshed. Difficulty getting to sleep because of racing work thoughts and worries about mistakes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious especially before shifts and reports muscle tension. No clear panic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Suicidal ideation and self-harm history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies active suicidal ideation, plan, or intent and denies homicidal ideation. Reports wishing she could pause everything and disappear. No past self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a couple of glasses of wine most nights and more on big days; estimated as likely 2–3 standard drinks most nights, with more on weekends. Documented as above NHMRC recommendations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Diet and caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports poor diet, described as toast and coffee, and high coffee intake on shift."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Occupational context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works full-time as a registered nurse on a medical ward with chronic short staffing, frequent double shifts, and pressure to do extra shifts. Considering reducing hours but worried about finances and letting the team down."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Phone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences; no audible shortness of breath or wheeze. Sounds tired and mildly flat. No acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mental state examination: speech and thought"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech normal rate and volume, a bit monotonous. Thought form coherent, but history fragmented with poor recall of dates and medications."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mental state examination: mood and affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as flat and tired; affect restricted and congruent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mental state examination: psychotic symptoms and insight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No psychotic symptoms. Insight fair regarding work stress and burnout."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Acute risk assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No plan or intent. Protective factors documented as partner, job, and sense of responsibility. Assessed as low acute risk with increased background mental health risk."
      }
    },
