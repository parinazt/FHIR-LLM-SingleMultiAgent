    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Allergic contact / atopic-type hand dermatitis, occupationally aggravated; mild to moderate"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nasal and eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 weeks: sneezing, nasal blockage, clear rhinorrhoea, and itchy nose and eyes; worse in the morning and at school. Sleep mildly affected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated respiratory and sinus symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, facial pain, purulent nasal discharge, cough, shortness of breath, or wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "ENT and chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no distress. Nasal mucosa pale and boggy with clear discharge. Mild conjunctival injection. Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Hand dermatitis history and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hand dermatitis flare for 1–2 weeks since a cleaning roster change at school; worse with wipes and sprays and better on weekends. No systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, scaly plaques on the dorsum and between the fingers, with mild lichenification and excoriations. No vesicles, crusting, pustules, or spreading erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "10 mg orally as needed; can use daily during flares",
            "asNeededBoolean": true,
            "route": {
              "text": "oral"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Patient reports partial relief."
          }
        ]
      }
    },
