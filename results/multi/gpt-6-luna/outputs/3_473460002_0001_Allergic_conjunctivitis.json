    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing bilateral red, itchy eyes with watery discharge, worse at school and outdoors, especially on windy days. No purulent discharge, morning lid sticking, significant pain, photophobia, decreased vision, foreign-body sensation, or trauma. No contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Seasonal nasal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sneezing and rhinorrhoea each spring, worse this week; high pollen reported in the media. Uses loratadine intermittently, not regularly. No asthma or eczema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
