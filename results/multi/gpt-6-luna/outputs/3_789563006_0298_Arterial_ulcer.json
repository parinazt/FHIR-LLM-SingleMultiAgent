    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Walking tolerance and exertional calf pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Can walk approximately 1–2 blocks on flat ground, then develops tight pain in both calves, right greater than left; settles within a few minutes of rest. Worsening over the last 6–12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp, significant pain, especially at night; worse with elevation when lying flat. Patient often has to dangle the leg off the bed to sleep, and pain decreases when the foot is dependent. Ulcer is very tender to palpation and cleaning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Patient-reported right foot temperature and colour changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot feels colder than the left at times and goes white when elevated on a recliner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right and left foot colour changes with elevation and dependency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot cooler and paler than left when supine. Elevation to 30 degrees for 1 minute caused pallor of the right forefoot and toes, followed by dependent rubor on lowering. Milder changes on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Lower-limb skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Skin thin and shiny, with hairless shins and feet and thickened nails. No varicose veins or venous stasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
