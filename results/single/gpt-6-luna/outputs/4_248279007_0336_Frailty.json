        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scattered erythematous excoriated papules on forearms and hands with some linear scratch marks; legs dry with a few similar lesions. No vesicles, pustules, burrows, scale, or obvious infection."
      }
    },
    {
