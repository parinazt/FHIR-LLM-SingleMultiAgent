        },
        "valueString": "Abdomen soft and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Vulval lump history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left vulval lump for 4–5 days, increasing in size and painful when walking or sitting. Patient describes it as “like a marble in there.” No discharge or “pimple head.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left posterolateral introitus: approximately 2–2.5 cm fluctuant, tender swelling at typical Bartholin site. Skin intact, non-erythematous, no pointing, no cellulitis. No abnormal vaginal discharge or inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
