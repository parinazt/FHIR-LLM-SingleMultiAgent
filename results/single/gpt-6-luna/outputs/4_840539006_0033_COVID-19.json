        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath at rest or on mild exertion, chest pain including pleuritic chest pain, confusion, dizziness, palpitations, nausea, vomiting, and diarrhea. Reports no loss of taste or smell."
      }
    },
    {
