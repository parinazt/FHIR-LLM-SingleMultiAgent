        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Increase to 1 g every 6 hours regularly (maximum 4 g in 24 hours) for 5–7 days, then as needed",
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
