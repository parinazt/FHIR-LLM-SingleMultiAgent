    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right index finger lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsolateral aspect just distal to PIPJ: approximately 5–6 mm red, friable dome-shaped papule on a narrow stalk with a moist surface. Mild bleeding on light contact during examination, settling with direct pressure. No surrounding erythema, warmth, induration, or pus. No pigment or atypical borders noted; no nodes or systemic symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right index finger lesion bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported intermittent bleeding, especially with using the till and handling notes; recurrent minor-trauma bleeding affects work function."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand function and range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grip strength within normal limits bilaterally; able to make a full fist and open the hand against resistance. Fine motor function intact. Full active and passive range of motion at right index PIP, DIP, and MCP joints without pain. Sensation intact; capillary refill normal; hand function preserved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
