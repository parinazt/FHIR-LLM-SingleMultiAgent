    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over greater tuberosity/subacromial area; ACJ non-tender. Active flexion about 120° and painful; abduction about 100–110° with painful arc about 70–120°. Internal rotation limited (cannot reach bra strap); external rotation about 45° with mild pain. Passive range of motion near full with end-range pain. Jobe/empty can causes pain with mild weakness versus right. Pain on resisted external rotation. Hawkins and Neer impingement tests positive. Neck full range of motion with no radicular signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "External genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atrophic vulval skin. Small, about 5–6 mm, soft red polypoid lesion at the posterior lip of the urethral meatus, mildly tender to palpation, not friable, with no active bleeding or pus. Appearance described as a urethral caruncle. No obvious prolapse."
      }
    },
