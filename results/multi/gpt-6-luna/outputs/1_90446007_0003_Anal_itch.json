    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic right knee pain for 2–3 days, beginning after getting up from a desk and feeling that the knee felt “funny.” Mild anterior/medial ache, about 3/10, especially on stairs and after sitting then standing. Full weight-bearing and walking are okay; still at work but avoiding the gym."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right knee reported findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On telehealth, no video inspection was done. Patient reports the right knee looks normal, with no deformity or obvious effusion. Reports full flexion and extension, near-full squat with mild anterior discomfort, and right-leg hopping causes ache only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right knee associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no trauma, twist, fall, blow, or pop; no swelling, redness, warmth, locking, giving way, catching, or true instability. Denies fever, night sweats, weight loss, night pain, calf pain, shortness of breath, and pleuritic chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anal itching and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fluctuating anal itching for approximately 6–8 months, worse in the evenings, after bowel movements, with sweating, and with stress. Overcleaning with soap, a loofah, and fragranced wipes; scratches especially at night and is sometimes sore. Reports no bleeding on paper, prolapse, mucus, significant pain, perianal discharge, blisters, or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels 1–2 times daily, usually formed and occasionally slightly loose when anxious. Reports no true diarrhoea, constipation, or straining."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Mental state and health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On telehealth, voice coherent and speaking in full sentences; anxious but settled. Expressed worries about “bone cancer,” “blood clot,” and “anal cancer,” and requested multiple tests."
      }
    },
