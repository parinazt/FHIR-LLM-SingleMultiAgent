    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported episodic symptoms suggestive of hypoglycaemia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the past few weeks to possibly longer, episodes a few times per week, especially late morning on work days when breaks or meals are skipped. Reports shakiness, sweating, palpitations, hunger, dizziness, reduced concentration and feeling 'funny in the head'. Symptoms settle after juice or lollies. These episodes are reported symptoms; hypoglycaemia has not been confirmed by recorded blood glucose values."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported severe-event history associated with suspected hypoglycaemia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "One episode a few months ago when the patient had to lie down in the lunch room. Reports no recent loss of consciousness, seizures or ambulance attendance, and no known episode requiring IV dextrose or glucagon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Focused review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, focal neurological symptoms, current polyuria or polydipsia, abdominal pain, vomiting, and known unintentional weight loss."
      }
    },
