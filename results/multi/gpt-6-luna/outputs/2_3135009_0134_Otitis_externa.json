          "text": "Right ear blocked sensation and hearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a blocked sensation and decreased hearing on the right side."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
