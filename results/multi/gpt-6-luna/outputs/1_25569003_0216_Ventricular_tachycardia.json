    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic gradual ache for approximately 3–4 weeks, lateral/anterior-lateral shoulder radiating to upper arm but not past the elbow; described as feeling like sleeping awkwardly; severity 3–5/10. Worse with overhead reaching, reaching behind the back, and lying on the left side at night; better with rest and heat. Paracetamol 1 g as needed takes the edge off. Mostly able to manage ADLs but avoiding overhead activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Shoulder and arm neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true weakness, numbness, or tingling reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Cardiac and respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, jaw or arm exertional pain, shortness of breath, presyncope, syncope, and palpitations. Mild stable dyspnoea on hills for more than 12 months, unchanged. No PND or orthopnoea."
      }
    },
