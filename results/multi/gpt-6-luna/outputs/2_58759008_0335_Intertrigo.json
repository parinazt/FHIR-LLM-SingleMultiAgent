        "code": {
          "text": "Inframammary intertrigo, chronic/recurrent; possible candidal"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
