        "code": {
          "text": "Somatic and cognitive symptoms associated with anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels on edge and has shoulder/neck tension, headaches, fatigue, and decreased concentration; reports that her mind goes blank in staff meetings."
      }
