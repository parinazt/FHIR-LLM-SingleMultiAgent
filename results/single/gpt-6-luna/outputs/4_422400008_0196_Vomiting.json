        "code": {
          "text": "Headache and visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache today, similar to usual baseline intermittent frontal headaches. No persistent visual loss or diplopia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
