    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bilateral eye discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For a few months, both eyes have felt burning and gritty, “like sand”; worse over the last 1–2 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Blurred vision"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased blurring later in the day and with reading or watching TV."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left eye cloudy and puffy sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last night the left eye felt “really cloudy and puffy, like there was a film over it”; it was slow to clear this morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Eye tearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Some watery tearing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vision change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient says vision is “a bit worse than it used to be” but thinks it is probably just old age."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Visual function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to read a newspaper with brighter light and more breaks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated eye and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No halos, severe pain, nausea or vomiting, or purulent discharge. No curtain, flashes, or floaters. Denies fever, facial rash, and joint pains. Occasional dry mouth."
      }
    },
