        "code": {
          "text": "Right forearm burn dimensions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6 × 8 cm on the volar mid-distal forearm; non-circumferential."
      }
    },
