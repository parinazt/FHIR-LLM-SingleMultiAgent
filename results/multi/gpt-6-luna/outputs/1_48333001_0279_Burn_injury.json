        },
        "valueString": "Patient is anxious about infection and requests prophylactic antibiotics."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Panadol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g twice daily as needed; not used in the last 2 days",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Advised may use up to four times daily as needed, especially before dressing changes."
          }
        ]
      }
    },
