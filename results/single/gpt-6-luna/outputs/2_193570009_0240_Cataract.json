    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right dorsal forearm skin lesion, reported history and characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small, approximately pea-sized, dry scaly patch noticed about 3–4 weeks ago, gradually becoming rougher to touch and more visible; described as a bit pink and rough, with no reported colour change. No pain, itch, bleeding, ulceration, rapid growth, preceding trauma, or bite. Patient reports it has been stable over the past few weeks. Sorbolene may have helped slightly. No fevers, weight loss, night sweats, or malaise."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Eye symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild glare, especially with night driving, and mild distance blur, stable. No sudden decrease in vision, severe eye pain, marked redness, purulent discharge, or curtain over vision."
      }
    },
