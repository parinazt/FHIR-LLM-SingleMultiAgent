    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache for 3 days, bilateral frontal, described as a dull, constant tight band around the forehead and behind the eyes. Severity 5/10, decreasing to 2–3/10 with Panadol. Worse at the end of the day, with screen work, and when skipping meals. Patient attributes it to too much coffee on late shifts and air conditioning blowing on her face all day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia only when very tired. No nausea or vomiting, visual loss, focal neurological symptoms, speech problems, confusion, fever, neck stiffness, scalp tenderness, jaw claudication, thunderclap onset, worst-ever headache, nocturnal waking, or trauma. No known cancer, weight loss, or pregnancy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vulval symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vulval itch and soreness for approximately 1 week, worse at night and after micturition. White, clumpy discharge without malodour. Mild superficial dyspareunia when symptoms are active. Scratching has caused excoriation. Reports recurrent thrush after antibiotics or when blood sugars are 'a bit off'; no swab history reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated vulvovaginal symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deep pelvic pain, abdominal pain, fever, dysuria, urgency, intermenstrual bleeding, or postcoital bleeding. No features of PID, STI, or bacterial vaginosis reported."
      }
    },
