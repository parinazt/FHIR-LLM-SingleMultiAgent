    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Diarrhoea history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools for 7 days: initially 4–5 times daily, now 3–4 times daily, watery to mushy and brown. No mucus or rectal bleeding. Mild crampy lower abdominal pain improves after a bowel movement; no nocturnal symptoms. No vomiting; mild nausea during the first 2 days only. Appetite slightly reduced; fluid intake adequate. No recent travel, sick contacts, antibiotics or hospital admission. No incontinence or weight loss. No fevers or rigors reported; temperature not checked at home. Patient associates onset with takeaway chicken and coleslaw eaten the night before symptoms began."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild diffuse lower abdominal tenderness on deep palpation. No guarding, rebound, masses or organomegaly. Bowel sounds mildly increased. Rectal examination not performed; patient declined."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Hydration and general examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, mildly irritable but cooperative, and in no acute distress. Mucous membranes moist, capillary refill under 2 seconds, and no postural symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Psoriasis skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scalp with erythematous plaques and silvery scale at the frontal hairline and occiput, extending approximately 1–2 cm beyond the hairline. Symmetrical, well-demarcated salmon-pink plaques with silvery scale and some excoriation on elbows and knees, approximately 3–4 cm; body surface area approximately 4–5%. No pustules or erythroderma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Nail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pitting of a few fingernails; no onycholysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Musculoskeletal symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional morning finger stiffness lasting 10–15 minutes. No persistent joint swelling, dactylitis or heel pain; no clear inflammatory back features elicited. No obvious joint swelling, erythema or deformity of hands, wrists or knees; full active range of motion and small joints non-tender today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
