      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right foot temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Warmer to touch than the left foot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Right foot sensory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked allodynia to light touch over the dorsum and lateral foot to just above the ankle; hyperalgesia to pinprick."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
