          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a small amount to the vestibule once nightly.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          },
          {
            "text": "Apply a small amount to the vestibule up to 30 minutes before potential triggers. It may sting initially; wash off if significant irritation occurs. If used before intercourse, use a condom to avoid partner numbness.",
