          "text": "Headache-associated symptoms and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea. No focal neurological symptoms, visual loss, speech change, collapse, seizure, fever, neck stiffness, photophobia, rash, or morning vomiting."
      }
    },
