      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vertigo and dizziness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sudden onset of room-spinning vertigo approximately 12 days ago, worse with head movement and associated with nausea and vomiting. Markedly improved compared with last week. Still has brief dizziness with quick head turns and when getting out of bed. No vertigo at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No further vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neurologic symptoms reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies diplopia, dysarthria, limb weakness or numbness, gait collapse, and new severe headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent left tinnitus last week and left ear felt somewhat blocked; mostly settled now. No current otalgia or ear discharge. Possible mild left muffled hearing during acute illness, now described as pretty normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, ambulant independently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ear canals clear and tympanic membranes intact bilaterally; no erythema or effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
