        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Patient-reported acne course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acne since late teens, worse over the last 2–3 years. Since starting topical treatment, fewer new pimples; mostly flat red/brown marks, with an occasional small pustule around the period."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Facial acne findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few closed comedones and few small inflammatory papules on the face. No nodules or cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Post-inflammatory facial marks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple erythematous/light-brown macules on the face, described as post-inflammatory."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Facial scarring"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Early shallow atrophic scars on both cheeks; mild."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
