          "text": "Previous cardiac investigations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prior normal ECG and cardiology review are noted in the file from approximately five years ago; prior normal stress test also reported. No known ischaemic heart disease diagnosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-26",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-26",
