      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anxiety and sleep symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling on edge all the time for the last few months (approximately 3–4 months), worse over the last few weeks, with worry about work and money. Difficulty getting to sleep with racing thoughts; sleeps approximately 5–6 hours and does not feel rested. Uses phone late at night and thinks this may not help."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Physical symptoms associated with anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports palpitations, chest tightness, a knot in the stomach, and some nausea when anxious. Denies shortness of breath and panic attacks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mood is a bit low but still enjoys time with his children and fishing when not too tired. Denies anhedonia, hopelessness, suicidal ideation, and self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Caffeine consumption"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking two coffees and 2–3 energy drinks per day; says this is probably too much."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Alcohol consumption"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mainly weekend alcohol use, 4–6 standard drinks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Drug use and smoking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no drug use and that he does not smoke."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well, somewhat tense and fidgety. Speech normal; thoughts coherent. Anxious but appropriate, with good insight and judgement. No psychotic features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right scrotal swelling, reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports right scrotal swelling for approximately 6–8 months, slowly increasing in size. Painless but feels heavy by the end of the workday. Reports that it transilluminates with a phone torch and is worried it might be cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Scrotal symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies scrotal redness, fever, urinary symptoms, weight loss, and night sweats. Reports no STI concerns and no known history of undescended testes or groin surgery."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right hemiscrotum enlarged and non-erythematous, with soft, fluctuant, non-tender swelling around the testis. Right testis palpable with normal consistency and no discrete hard mass felt. Left testis within normal limits. Right side transilluminates. No cough impulse, obvious inguinal hernia, or inguinal lymph nodes. Penis unremarkable."
      }
    },
