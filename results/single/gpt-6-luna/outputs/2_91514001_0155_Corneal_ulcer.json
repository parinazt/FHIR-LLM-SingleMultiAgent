        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Contact lens use and associated exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses monthly soft contact lenses sometimes for work or social activities. Reports sometimes sleeping in lenses after late shifts and showering in them; reports no swimming in lenses."
      }
