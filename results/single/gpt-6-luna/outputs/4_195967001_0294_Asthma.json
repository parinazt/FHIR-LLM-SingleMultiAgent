        "code": {
          "text": "Asthma control symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Asthma has been up and down for a few months. Uses salbutamol most school days, often after playground duty; some days twice. Wakes with tight chest and cough about 2–3 nights per week. Shortness of breath and wheeze walking uphill to carpark, settling within a few minutes."
      }
    },
