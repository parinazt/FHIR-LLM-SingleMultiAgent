        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Psychological state during consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well and talkative; anxious when discussing fertility. Patient reports being quite distressed, with performance anxiety and feeling pretty down on himself."
      }
