        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.02% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply thinly to the lesion once daily for up to 2 weeks, then stop.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
