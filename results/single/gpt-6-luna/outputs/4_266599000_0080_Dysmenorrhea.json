        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Restart combined oral contraceptive. Take active pills continuously for 3 months, then take a 4–7 day break if breakthrough bleeding is troublesome. Use backup contraception for the first 7 days."
