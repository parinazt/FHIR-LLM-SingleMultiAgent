        "code": {
          "text": "Neurogenic claudication, likely secondary to lumbar spinal canal stenosis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bilateral leg pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral aching/heavy pain, sometimes burning, from thighs to calves for 6–8 months, increased over the last 4–6 weeks. Patient describes legs as feeling like they are going to give way. Occasional tingling in the feet when pain is bad."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Leg pain triggers and relief"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is brought on by walking or standing. Can walk approximately 50–100 m on flat ground before needing to stop. Pain improves within 2–3 minutes of sitting or leaning forward over a trolley or bench. Can use an exercise bike for a long time with much less pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Back pain and pain at rest or night"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true low back pain today; patient says back is fine. No rest pain and no nocturnal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported red flag symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No saddle symptoms, urinary retention or incontinence, bowel symptoms, rapidly increasing weakness, trauma, weight loss, or fevers. No known malignancy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported past medical history and prior scan comment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant past medical history volunteered. Possible prior comment of a narrow canal on an old scan."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported absence of diabetes and vascular history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known diabetes, ischaemic heart disease, stroke, deep vein thrombosis, or peripheral arterial disease."
      }
    },
