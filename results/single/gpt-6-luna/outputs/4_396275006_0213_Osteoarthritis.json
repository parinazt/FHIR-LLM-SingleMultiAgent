      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Body mass index"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 30–32; described as overweight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gait and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slight antalgic gait, short stride and slow pace; cautious turning and mild varus knees. Mobile but cautious; no walking aid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral bony enlargement and slight varus; small effusions bilaterally, right greater than left. Mild bilateral medial joint-line tenderness. No erythema or warmth. No obvious ligament laxity on valgus or varus stress at 0° and 30°. Flexion to approximately 110° with end-range pain; extension near full; marked crepitus through range. McMurray negative for click or locking, with some medial discomfort only. No posterior tenderness or calf swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Several Heberden nodes at DIP joints and some PIP nodes, with mild tenderness. No synovial thickening or warmth. Deformity not noted; range of motion preserved with slight end-range discomfort."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 in major muscle groups; light-touch sensation intact; reflexes normal; no focal deficit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Falls risk"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Assessed as increased falls risk related to knee osteoarthritis and deconditioning. No actual falls reported; no neurological cause evident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Dizziness, syncope, and cardiac symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dizziness, syncope, chest pain, and palpitations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Trauma, infection, and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent trauma, infection, or systemic symptoms. Denies fevers, weight loss, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Inflammatory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies rash, eye inflammation, and inflammatory back pain. No inflammatory arthritis was identified in the assessment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Neurological and sphincter symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies bowel or bladder incontinence, saddle anaesthesia, peripheral paraesthesia, and focal weakness; reports subjective wobbly knees."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Knee locking and acute injury features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies true locking and discrete trauma. No gross ligament laxity on examination; no red flags for acute internal derangement were assessed."
      }
    },
