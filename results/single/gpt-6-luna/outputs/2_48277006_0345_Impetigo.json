          "text": "Reported skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lesions are itchy and not painful; patient thinks they are spreading."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Lesion onset and progression"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vague onset approximately 1–2 weeks ago. Started as a small red spot on the right shin, then blistered and developed yellow/honey-coloured crust."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three lesions on the right anterior shin, 0.5–1.5 cm, and one similar approximately 1 cm lesion on the left dorsal forearm. Erythematous bases with honey-coloured crust; superficial and mildly excoriated. No pus reported. No surrounding cellulitis, abscess, or bullae."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lesions non-tender. No face or oral lesions and no lymphadenopathy. Rest of examination unremarkable."
      }
    },
