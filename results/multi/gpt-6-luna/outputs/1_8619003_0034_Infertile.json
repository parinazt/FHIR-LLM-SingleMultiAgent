        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Trying to conceive"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient and wife have been trying for a baby for about 18 months with regular unprotected sex and no pregnancies. They use apps to time ovulation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
