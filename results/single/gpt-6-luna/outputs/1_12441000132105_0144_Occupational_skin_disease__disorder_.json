    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported hand rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 6–8 weeks, increased flares of red, dry, fissured hands and fingers, with some small vesicles, typically after long bleach or dye days. Itching and burning worsen toward the end of the shift and are somewhat better on days off. Fissure pain makes shampooing and colouring difficult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported transient welts at glove edges"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Transient raised, itchy welts on wrists and forearms shortly after wet hair or dye exposure where gloves end; settle within 1–2 hours without treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported forearm reaction to products and sun exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased stinging and redness on sun-exposed forearms when going out for lunch after certain products; possible photo component."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsal hands and fingers with erythematous, dry, lichenified plaques, fine scale, shallow fissures over MCPs, mild oedema, and a few small clear vesicles on lateral fingers. Palms with mild erythema and dryness. No warmth or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Wrist and forearm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint post-inflammatory erythema band at glove line; no active wheals."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Scalp skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythematous, scaly occipital plaques consistent with psoriasis; mild scalp scale reported as stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported absence of systemic allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, wheeze, facial or tongue swelling, or generalized urticaria reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Examination for facial, tongue, or respiratory signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial oedema, tongue swelling, or respiratory distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Twice daily as needed for flares; patient reports it helps but may forget until symptoms are severe, then uses it up to 4–5 times daily for a few days.",
            "asNeededBoolean": true,
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Over-the-counter hydrocortisone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used intermittently on the face for psoriasis.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone dipropionate 0.05% ointment (Diprosone)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to affected hand areas twice daily for 7 days, then once daily for 7 days, then stop; use on rash only.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          },
          {
            "text": "After the twice-daily phase, apply to affected hand areas once daily for 7 days, then stop; use on rash only.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05%"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "For milder flares after the current course, apply twice daily as needed; maximum 7–10 days per month.",
            "asNeededBoolean": true,
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "10 mg by mouth daily as needed for itch or urticaria; may use regularly during high-exposure periods.",
            "asNeededBoolean": true,
            "route": {
              "text": "Oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
