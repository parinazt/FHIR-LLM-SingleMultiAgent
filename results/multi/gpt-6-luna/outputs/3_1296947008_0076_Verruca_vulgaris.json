        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Salicylic acid wart paint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue on the right thumb and start on the left index finger nightly. Soak 5–10 minutes, pare with emery board, protect normal skin, apply paint, and occlude. Continue nightly up to a total of 3/12 before considering treatment failure.",
            "route": {
              "text": "topical"
            },
