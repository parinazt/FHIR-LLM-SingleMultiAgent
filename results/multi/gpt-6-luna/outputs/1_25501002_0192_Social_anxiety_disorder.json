        "code": {
          "text": "Social and performance-related anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports symptoms for more than 2 years in most social or performance contexts involving perceived scrutiny, including anticipatory anxiety for days, fear of saying something stupid or being judged, and often leaving events early or switching off the camera to calm down."
      }
    },
