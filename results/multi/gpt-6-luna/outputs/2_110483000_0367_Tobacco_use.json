        },
        "code": {
          "text": "Tobacco use disorder with high nicotine dependence"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mild anxiety, usually manageable; increased over the past 4-6 weeks, especially at work on a noisy site with overtime. Patient says he feels \"a bit more on edge than usual\" and describes feeling \"pretty steady just cranky and anxious\"."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Restlessness and concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels restless and keyed up, with mildly reduced concentration at work, especially in the late afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep onset delay of 30-60 minutes; occasional early waking 1-2 times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies panic, chest pain, shortness of breath, palpitations, weight loss, fevers, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and self-harm symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as pretty steady, cranky and anxious; denies anhedonia, suicidal ideation, and thoughts of self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Alcohol and other drug use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 2-3 beers most nights, stable for years; denies other drug use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Cigarette smoking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Smokes approximately 20-25 cigarettes per day for approximately 30 years. First cigarette is within 10-15 minutes of waking. Reports anxiety is worse when longer between cigarettes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Nicotine withdrawal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "When cutting down, reports irritability, anxiety, reduced concentration, and being snappy. Previous cold-turkey quit attempt lasted approximately 1 week and was followed by relapse with irritability and poor sleep. Nicotine patch alone approximately 5 years ago helped somewhat, but cravings persisted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
