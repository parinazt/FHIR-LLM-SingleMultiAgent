        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, mildly agitated, speaking in full sentences, and in no acute distress. Irritated and argumentative during the consultation, raising his voice at times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right shin wound and surrounding findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Superficial laceration on the anterior right shin approximately 5 cm below the knee, about 2.5 cm long. Surrounding erythema extends approximately 3–4 cm beyond the wound; area is warm and tender with mild induration. Small amount of purulent exudate on the dressing. No fluctuance, crepitus, necrosis, bullae, or lymphangitic streaking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right inguinal node"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild right inguinal node tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right calf and distal neurovascular findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Calf soft and non-tender, with no asymmetrical swelling. Pulses intact, capillary refill less than 2 seconds, and sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
