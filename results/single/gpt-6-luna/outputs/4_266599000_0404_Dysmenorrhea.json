        "code": {
          "text": "History of iron deficiency associated with heavy menses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported rash and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5 days of an itchy red rash on the flexor wrists, scattered forearms, and anterior neck."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported rash-associated symptoms and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, blisters, weeping, or pus. No fever, upper respiratory symptoms, joint pains, or oral or eye symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination: wrists and distal forearms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple ill-defined erythematous patches or thin plaques, 1–3 cm, with some excoriations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Skin examination: anterior neck"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few faint erythematous macules."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Skin examination: additional findings and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vesicles, pustules, crusting, warmth, tenderness, or swelling; no cellulitis. No mucosal, palm, sole, or genital involvement. No target lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Period pain has increased over the last few cycles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual bleeding and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No intermenstrual bleeding or postcoital bleeding; no new pattern reported. Adenomyosis symptoms described as stable."
      }
    },
    {
