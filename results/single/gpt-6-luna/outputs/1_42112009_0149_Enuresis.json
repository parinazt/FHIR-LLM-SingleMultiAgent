        "code": {
          "text": "Suspected non-neurogenic lower urinary tract dysfunction with possible functional outlet issue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nocturnal enuresis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Waking up in a wet bed 4–5 nights a week, with large volumes, usually around 3–5 am. Enuresis has occurred on and off for about 1 year and is now present most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Daytime lower urinary tract symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime urination every 1–2 hours; feels like he is never properly empty. Hesitancy, weak stream, straining, post-void dribbling, and an occasional small leak if he holds urine too long. Symptoms ongoing about 6–8 months and worse over the last 3 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, haematuria, fevers, flank pain, or suprapubic pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neurological symptoms volunteered; specifically denies leg weakness, numbness, saddle anaesthesia, and visual change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bladder diary: daytime voids"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three days of diary completed: 8–11 voids per day, mostly 150–250 mL, with a couple of voids up to about 350 mL."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bladder diary: nocturnal voiding and enuresis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "0–1 nocturnal voids, but wet bed on 2 of 3 diary nights, with large volumes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Fluid and caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinking about 2–2.5 L daily, including 3 coffees; last coffee or fluid intake around 6–7 pm. Tried evening fluid restriction with little change."
      }
    },
    {
