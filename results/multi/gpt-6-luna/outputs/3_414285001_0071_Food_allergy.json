              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Anxiety symptoms related to choking and allergy concerns; some episodes may be anxiety versus allergy"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent solid-food dysphagia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent solid-food dysphagia for approximately 6–9 months. Food feels stuck mid-chest, especially bread and meat; needs sips of water and occasionally regurgitates food back up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Episodes of food sticking and coughing food back out"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two episodes in the past month; had to stand and cough food back out and thought she was choking, but could still breathe. No complete obstruction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Chest tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central chest tightness during episodes of food sticking; settles 10–15 minutes after food passes. Not exertional and not associated with walking hills."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Retrosternal burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occurs approximately 2–3 times per week, especially after late takeaway meals; worse with coffee and spicy food, with some relief from Gaviscon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Globus sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional globus sensation, especially at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Food-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three episodes in the past 6–9 months after certain meals, possibly involving almond milk while eating out: itchy throat, mild perioral tingling, and patchy erythematous itchy rash on the forearms approximately 1 hour later. Felt a little wheezy with chest tightness. No stridor, collapse, or gastrointestinal symptoms. Symptoms resolved without medication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Historical reaction to egg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Raw or undercooked egg has caused hives and lip swelling approximately 30 minutes after exposure since her teens."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Historical reaction to tree nuts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tree nuts, type uncertain, in a mixed nut bar years ago caused hives and lip swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Shortness of breath and mouth tingling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports shortness of breath and mouth tingling when very anxious during busy work shifts; whether these episodes are related to panic or allergy is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and swallowing symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies odynophagia, haematemesis, melaena, PR bleeding, vomiting, and nocturnal choking cough. No weight loss; appetite is okay. No progressive voice change."
      }
    },
    {
