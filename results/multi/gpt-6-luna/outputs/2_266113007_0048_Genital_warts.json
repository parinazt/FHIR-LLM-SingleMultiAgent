          "text": "Fundoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No abnormality detected; no papilloedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Vulval symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vulval bumps for 2–3 months. Mild itch or irritation after sex or wiping. No significant pain, bleeding, discharge, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Vulval examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6–8 soft, skin-coloured/verrucous papules, 2–4 mm, on the labia minora and posterior introitus; non-tender. No ulceration or vesicles."
      }
    },
    {
