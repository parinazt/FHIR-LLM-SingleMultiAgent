      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Intermittent panic episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes 1–2 times per week, with sudden onset, peaking over a few minutes and lasting approximately 5–10 minutes; shorter and less intense with slow breathing. Often occur in the evenings when alone or when thinking about health concerns. Can occur at rest; no clear exertional link."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Symptoms during panic episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported heart racing, sweating, mild dizziness, and shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain or radiation, syncope, nausea, vomiting, and infective symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
