          "text": "Associated headache symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies focal neurologic symptoms, visual loss, speech change, collapse, seizure, fever, neck stiffness, photophobia, rash, and morning vomiting."
      }
    },
