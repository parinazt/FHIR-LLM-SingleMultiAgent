        "code": {
          "text": "Flu-like symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Day 6 of illness; initially had fevers, chills, myalgias, headache, dry cough, sore throat, and marked fatigue. Slightly better on days 3–4, then increased cough over the last 48 hours; still febrile and very fatigued."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased over the last 48 hours; initially dry, now producing a small amount of yellow sputum. No haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
