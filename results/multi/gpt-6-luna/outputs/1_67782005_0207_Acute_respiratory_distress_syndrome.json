        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a dry cough, especially at night, described as a bit of a tickle. Denies sputum and haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
