      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling \"really hopeless and helpless like whats the point\" and \"useless\"; ongoing low mood, anhedonia, poor motivation, reduced energy and poor concentration at work and home. Describes symptoms as having been bad for ages, possibly worse over the last few weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; stays up late on phone, sometimes awake until 4 am, and wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Appetite and weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appetite is erratic: sometimes eats nothing all day, then binges on junk food at night. Possible slight weight loss, uncertain; no recent weight recorded in the EMR."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Guilt and self-worth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels guilty and like a burden to her sister; reports prominent hopelessness and that nothing she tries makes a difference."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and self-harm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports passive suicidal ideation: \"wouldnt matter if I didnt wake up.\" No active plan or intent today. Reports past superficial cutting, last more than 6 months ago; no recent self-harm disclosed. Identifies her sister as support and says she would tell her or return if suicidal thoughts worsened."
      }
    },
