    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diarrhoea for 4 days, approximately 4–6 loose/watery bowel movements per day, small-to-moderate volume; no nocturnal symptoms; no blood or mucus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy lower abdominal pain before bowel movements, settling afterwards. Denies severe abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant nausea or vomiting; mild nausea on day 1 only. Denies persistent vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Home temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 37.2,
          "unit": "°C"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Hydration and urine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels washed out but is drinking water and Hydralyte; passing urine regularly, 4–5 times per day, light yellow. Denies dizziness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Diarrhoea exposure and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms began approximately 24 hours after eating a takeaway chicken burger. No travel, camping, or sick contacts. Denies fever or chills, weight loss, blood or black stool, recent hospitalisation, and immunosuppression."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain for approximately 3–4 weeks, right greater than left posterolateral neck extending into the top of the right shoulder; dull ache 2–3/10 at baseline and up to 6/10 with laptop work or driving. No trauma. Paracetamol 1 g as needed provides some relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neck pain associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies arm weakness, numbness or tingling, headache red flags, gait change, and bowel or bladder issues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Video general appearance and respiratory observation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly tired but not toxic; speaking in full sentences, no apparent respiratory distress. Mucosa moist; no obvious pallor or jaundice."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination by patient self-palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild diffuse lower abdominal tenderness only; no focal severe pain. Able to hop on the spot without worsening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neck range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Some restriction of right rotation and right lateral flexion, with mild discomfort at end range; otherwise range of motion okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
