        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left lower quadrant abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache for 4–5 days, rated 5–6/10; similar to the last episode but milder, worse the day before presentation, with no radiation. Worse with movement and when bowels are very full; some relief after bowel movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alternating constipation and loose stools over the week. Stools are sometimes a bit narrower, but this is not persistent. Passing flatus. No vomiting, rectal bleeding, or melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nausea and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent nausea. Appetite decreased a little, but still eating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Possible fever and chills"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible fevers or chills on days 1–2; no temperatures recorded. Now feels 'off' but is coping with activities of daily living."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, urinary frequency, flank pain, chest pain, or shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Focused abdominal and flank examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild-to-moderate localized left lower quadrant tenderness. No guarding, rebound, generalized peritonism, or palpable mass. Bowel sounds normal. No costovertebral angle tenderness."
      }
