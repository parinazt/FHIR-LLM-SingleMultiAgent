      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very thin, frail, cachectic elderly male, alert and cooperative; reduced muscle bulk on inspection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lumbar back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alignment normal; no deformity or bruising; markedly reduced paraspinal bulk. Mild lower lumbar paraspinal tenderness, no focal bony point tenderness. Flexion and extension reduced due to pain and stiffness; able to flex to mid-shin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower limb power approximately 4+/5 symmetrically in the context of sarcopenia. Patellar and ankle reflexes present and symmetrical. Slightly reduced light-touch sensation in both feet, same as prior. Straight leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Gait and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slow, shuffling gait, stable with a single-point stick. Mobilizes short distances with stick."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
