        },
        "valueString": "Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Previous cardiac investigations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Previous ECG and cardiology review approximately 5 years ago; previous normal stress test; no known ischaemic heart disease diagnosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Caffeine-related concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wondered whether an extra evening cup of tea was affecting her heart; advised that caffeine can increase jitters and affect sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Concern about water"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient said the water smelled funny and wondered whether it was affecting her nerves; reassured that RACF water supply is treated and safe."
      }
    },
