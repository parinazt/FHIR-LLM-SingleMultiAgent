    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right calf pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful tender cord over a known varicose vein; pain 6/10 on walking. Pain initially increased over 2–3 days and is now stable or slightly better, especially with elevation and as-needed paracetamol."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right calf symptom description"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes a lumpy rope under the skin and mild itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right medial calf examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "7–8 cm firm tender cord along a varicose vein in the mid-distal medial calf, with an approximately 3 cm erythematous band and warmth. Not fluctuant; no pus; skin intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Bilateral lower limb varicose veins"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prominent tortuous varicose veins along the great saphenous vein territory bilaterally, right greater than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Extent of right calf cord"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable extension proximally to the knee or thigh; no groin tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
