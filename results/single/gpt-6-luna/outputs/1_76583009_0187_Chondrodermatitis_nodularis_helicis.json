          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Sleep disturbance (maintenance insomnia) secondary to painful right ear lesion; not primary insomnia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Right helix nodular lesion; chondrodermatitis nodularis helicis is most likely, but non-melanoma skin cancer (SCC/BCC) needs exclusion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports about 4–5 hours of broken sleep, waking repeatedly due to right ear pain. No difficulty falling asleep. Denies low mood, racing thoughts, or early waking independent of the ear pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp pain when lying on the right side, described as like someone jabbing a match in the ear; ongoing approximately 3–4 months and worsening. Settles when he turns over or rubs the ear, then recurs when lying on it again."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right upper ear lump, reported history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small painful lump on the upper right ear for approximately 6 months, worse with pressure on a pillow and sometimes crusty."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated ear and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hearing loss, tinnitus, vertigo, and fevers. No ear discharge; no bleeding other than when the lesion cracks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
