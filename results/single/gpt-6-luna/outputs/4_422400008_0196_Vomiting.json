    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Weakness and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports about 5 days of reduced energy, feeling wiped out, and difficulty getting through the workday; remains at work with reduced productivity and fatigue by mid-afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea began about 5 days ago; vomiting was 4 days ago, peaked over 2 days, and occurred 5–6 times daily at worst, initially food then bile. Last vomited yesterday morning; now largely settled."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Oral intake and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced oral intake and appetite during the vomiting illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Epigastric pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy epigastric pain only during vomiting; now resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stool 1–2 times daily during the worst of the illness; now back to usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal and systemic negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No haematemesis, melena, or rectal bleeding; no recent travel or sick contacts; no fevers, rigors, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Postural symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels drained and shaky, especially on standing; light-headed on rapid sit-to-stand. Brief visual fuzziness occurs only on standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
