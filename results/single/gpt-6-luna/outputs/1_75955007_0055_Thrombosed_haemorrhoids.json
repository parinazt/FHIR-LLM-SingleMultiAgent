        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right lateral anal margin has an approximately 1.5–2 cm tense bluish, exquisitely tender swelling, consistent with thrombosed external haemorrhoid/perianal haematoma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
