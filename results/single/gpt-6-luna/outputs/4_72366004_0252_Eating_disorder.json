        "code": {
          "text": "Binge eating symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased binge episodes most nights over the last 4 weeks, particularly after late shifts; often eats large takeaway meals until uncomfortably full and then feels guilt and 'gross'. Reports this has worsened since being off lisdexamfetamine."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
