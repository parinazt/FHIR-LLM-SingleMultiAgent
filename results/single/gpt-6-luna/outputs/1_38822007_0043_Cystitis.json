        },
        "dosage": [
          {
            "text": "Self-use of leftover cream on groin; application amount and frequency not stated.",
            "route": {
              "text": "Topical"
            }
          }
        ],
        "note": [
          {
            "text": "Minimal benefit reported. Advised to cease use on the groin."
          }
        ]
      }
    },
