        "code": {
          "text": "Reported elevated blood pressure readings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "First noticed at a work screening approximately 3 weeks ago, with readings in the 160s/100s. Home, chemist, and work readings over the following 2 weeks were mostly 145–160/90–100."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
