    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Subjective fever, chills and night sweats"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2–3 days: feels feverish with chills and hot-and-cold episodes overnight, waking with a soaked shirt. Home thermometer was flat; no home temperature reading available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Aches and malaise"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling achy and washed out."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Frontal headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Appetite and gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased appetite and some nausea; denies vomiting, diarrhoea and abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right popliteal region pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over approximately one week, increased pain behind the right knee at the site of the known aneurysm. Dull baseline pain with occasional sharp stabbing pain on walking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported right popliteal region swelling and warmth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks the area might be a bit puffier than usual and feels warmer than the other leg; both findings are uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath on exertion over the past few days, described as puffing more when going up stairs. Denies chest pain, orthopnoea and paroxysmal nocturnal dyspnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
