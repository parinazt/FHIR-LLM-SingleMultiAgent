        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for about 3 weeks; dry with scant clear sputum; worse at night and when lying flat."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated cough symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild longstanding exertional dyspnoea. No fever, rigors, night sweats, haemoptysis, pleuritic chest pain, known wheeze, or asthma/COPD history. No known URTI contacts or recent travel. COVID and influenza vaccinations up to date. Never smoker."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Retrosternal burning and sour taste, especially when lying down; symptoms not clearly exertional."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
