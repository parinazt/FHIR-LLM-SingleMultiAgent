          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies facial weakness, confusion, neck stiffness, photophobia, and severe headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
