    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools for 7 days; initially 4–5 times daily, now 3–4 times daily. Watery to mushy and brown, with no mucus or rectal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild crampy lower abdominal pain, decreased after bowel movements."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea only during the first 2 days; no vomiting. Appetite slightly decreased; fluids are tolerated. No nocturnal symptoms, incontinence, or reported weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported fever and rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors reported; patient had not checked temperature before the visit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Exposure history related to diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent travel, sick contacts, recent antibiotics, or hospitalisation reported. Patient reports eating takeaway chicken and coleslaw the night before symptoms began; she felt it tasted a bit off and is convinced it caused the diarrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Psoriasis-related skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "History of plaque psoriasis for more than 10 years. Flare over the last 2–3 months with increased plaques and worse scalp itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Joint symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional morning finger stiffness lasting 10–15 minutes. No persistent joint swelling, dactylitis, heel pain, or clear inflammatory back features elicited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling 'a bit fed up' and self-conscious at work. Suicidal ideation denied."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports drinking 2–3 glasses of wine most nights and says it helps her sleep. No morning drinking or withdrawal symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
