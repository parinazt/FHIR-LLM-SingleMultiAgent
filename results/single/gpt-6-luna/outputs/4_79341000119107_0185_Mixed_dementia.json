    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Persecutory belief"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 4–6 weeks, the patient has increasingly believed that a man enters the house at night and moves her belongings; she has also called her daughter overnight about people in the backyard looking through the windows. The patient says the belief feels real, though she acknowledges it may be her mind playing tricks. Doors are locked; the daughter attended and saw no person, and there was no evidence of entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
