        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Work-related stressors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes chronic understaffing, increased acuity, frequent double shifts and overtime, KPI pressure, and moral distress about not providing care to her own standard. Reports work symptoms partially remit on days off and function is preserved at home."
      }
    },
