    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported symptoms and infection-related findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itching and red blotchy rash around the adhesive border for the last 2–3 days. Burn itself is less painful. Patient reports no fever, rigors, or sweats; no spreading erythema up the arm; and no increased exudate, with only a small amount of clear serous ooze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right forearm burn wound examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6 x 8 cm on the volar mid-distal forearm; non-circumferential. Wound bed pink and moist with early epithelialisation and brisk capillary refill. Mild serous ooze; no pus, malodour, warmth, or tenderness. No slough, eschar, or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Periwound erythema"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rim of erythema 0.5–1 cm; stable compared with the practice nurse photograph from 3 days earlier."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Rash around burn dressing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, slightly raised papular rash in the exact shape of the adhesive border; very pruritic. No vesicles or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right wrist and elbow range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full wrist and elbow range of motion, with mild tightness at end-range flexion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right axillary and epitrochlear lymph nodes"
        },
        "subject": {
