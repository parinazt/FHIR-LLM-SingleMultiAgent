    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "5–6 days of right posterior neck/upper shoulder pain; dull ache, 4–5/10, constant, with a sharp twinge on turning the head right or reversing the car. Insidious onset after a long day at the computer and possibly a new chair or sleeping awkwardly. Worse at the end of the day and better in the morning and after a hot shower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Red-flag and associated symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma; no arm pain, radicular symptoms, paraesthesia, or weakness; no headache, visual symptoms, dizziness, or facial symptoms; no chest pain, shortness of breath, or jaw/arm pain; no fever, weight loss, night sweats, or recent infection; no bowel/bladder change, gait issue, or fine motor clumsiness. No history of malignancy, inflammatory arthritis, or osteoporosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Neck range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Telefunctional screen: right rotation reduced due to pain; flexion and extension okay but cause a slight pulling sensation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Upper limb function and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to lift arms above head, grip, type, and carry shopping. No dermatomal numbness or shooting arm pain reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
