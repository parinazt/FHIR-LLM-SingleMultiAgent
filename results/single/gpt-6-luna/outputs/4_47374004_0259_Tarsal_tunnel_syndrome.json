    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Epigastric / central abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset yesterday afternoon; central / just above the umbilicus, crampy, described as like bad period pain in the abdomen. Intermittent waves lasting 10–20 minutes, more noticeable after meals, and woke once overnight with discomfort. Severity 6–7/10 at worst and about 4/10 at the time of consult. Worse with eating, especially a heavier meal; partially relieved by sitting upright, a heat pack, and two 500 mg paracetamol tablets last night. Pain increased slightly with bending but was not clearly localised to one quadrant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea last night; no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported home temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 36.9,
          "unit": "°C",
          "system": "http://unitsofmeasure.org",
          "code": "Cel"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Abdominal self-palpation findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On guided self-palpation, no marked focal tenderness, guarding, or rigidity described; mainly epigastric discomfort / pressure. No direct examination was performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Gastrointestinal, urinary, and abdominal red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors; no urinary symptoms, dysuria, frequency, or haematuria. Bowels opened this morning with normal stool; no rectal blood or mucus, diarrhoea, constipation, or obstipation. No bloating beyond usual post-meal bloating. No jaundice, dark urine, or pale stool. Pain not consistently localised to the right iliac fossa or right upper quadrant. No sudden-onset tearing pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other reported red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, shortness of breath, dizziness, syncope, subjective tachycardia, or presyncope on standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menstrual and pelvic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period approximately two weeks ago; regular cycles. No vaginal bleeding, discharge, or pelvic pain. Patient denies possible pregnancy and reports her husband had a vasectomy years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance and function during telehealth consult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences, sounded comfortable and not acutely distressed. Able to mobilise around the house and work that day, though uncomfortable; ate very little at lunch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left ankle / foot tingling and burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing medial ankle / foot tingling and burning by the end of a shift, consistent with the previous pattern. Some improvement with brace and orthotics but still flares when on registers too long. No new weakness and no change in baseline paraesthesia pattern."
      }
    },
    {
