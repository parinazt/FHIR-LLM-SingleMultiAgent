        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sick contacts or recent hospitalisation. Denies palpitations and syncope. Staff report no confusion; conversation coherent. GI/GU otherwise unremarkable; patient describes CKD as stable."
      }
    },
