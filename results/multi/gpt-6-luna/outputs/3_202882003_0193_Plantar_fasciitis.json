    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Right foot and heel examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Localized tenderness to palpation at the medial calcaneal tuberosity and proximal plantar fascia, especially the anteromedial aspect. No swelling, warmth, or erythema. Achilles tendon non-tender. Arches mildly decreased, consistent with pes planus. Foot neurovascular examination normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
