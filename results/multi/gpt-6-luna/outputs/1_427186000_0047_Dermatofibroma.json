        "code": {
          "text": "Right foot lesion tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly tender with direct pressure simulating shoe contact; non-tender to light palpation. Patient reports mild tenderness only when a shoe rubs the lesion and no pain at rest."
      }
    },
