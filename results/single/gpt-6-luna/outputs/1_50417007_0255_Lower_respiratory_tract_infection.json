          "reference": "Patient/patient-1"
        },
        "valueString": "Reports wheeze and chest tightness, especially at night; salbutamol puffer 3–4 times daily provides some relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
