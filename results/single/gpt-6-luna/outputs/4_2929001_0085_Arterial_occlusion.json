    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Mottled rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mottled rash on both lower legs and toes for approximately 10–14 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right toe symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right foot toes, especially the great and second toes, feel cold and tingle at night; a little sore after being on them a lot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Exertional right calf and foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain when walking approximately 150–200 m to the mailbox; needs to stop, and pain settles within a few minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nocturnal forefoot ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sometimes woken by a dull ache in the forefoot, right greater than left, improving when the leg is dangled off the bed. No frank rest pain all night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported limb and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sudden severe pain, trauma, known ulcers, fever, rigors, and sweats. Patient acknowledges he does not look at his feet much."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Possible rash exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks rash may be from new washing powder or bore water; timing is unclear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cardiorespiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain or new shortness of breath; baseline dyspnoea on exertion at approximately 100 m. No PND or orthopnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Neurological review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new focal change; vision is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Renal and skin review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No change in urine, no macroscopic haematuria, and no itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "General appearance and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin elderly male, not in acute distress at rest; walks slowly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual, no murmur; no obvious carotid bruits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced air entry bilaterally with scattered expiratory wheeze; no crackles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no mass or obvious abdominal aortic aneurysm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Lower limb skin and toe examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mottled purplish net-like discolouration of shins and dorsum of both feet, right greater than left, with livedo pattern. Right great and second toes violaceous distally and cool to touch. Early shallow fissure at tip of right great toe, without purulence or surrounding cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Lower limb temperature and pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feet cool, right colder. Femoral pulses palpable bilaterally; popliteal faint on right and weak on left; dorsalis pedis not palpable on right and very weak on left; posterior tibial pulses not palpable bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Toe capillary refill"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 4–5 seconds on the right and 3–4 seconds on the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Lower limb sensory and motor examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Light touch reduced over toes, right greater than left; ankle and toe movements intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Buerger test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right leg pallor in less than 30 seconds on elevation, with reactive rubor on dependency."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Lower limb examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant oedema or calf tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
