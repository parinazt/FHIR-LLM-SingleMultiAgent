        "status": "final",
        "code": {
          "text": "Sleep-related breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring or witnessed apnoea. Patient reports no waking with choking, but wakes with dry mouth and feeling unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
