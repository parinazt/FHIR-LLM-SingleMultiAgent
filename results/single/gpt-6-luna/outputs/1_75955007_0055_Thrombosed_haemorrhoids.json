        "code": {
          "text": "Perianal examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Overlying skin intact; no ulceration, necrosis, or discharge. No surrounding erythema or induration and no features of perianal abscess or cellulitis. No other fissures, warts, or lesions."
      }
    },
