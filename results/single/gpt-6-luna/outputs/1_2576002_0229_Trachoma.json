          "text": "Menstrual and pregnancy history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Menses regular; not pregnant. Last menstrual period approximately 10 days ago; uses condoms."
      }
    },
    {
