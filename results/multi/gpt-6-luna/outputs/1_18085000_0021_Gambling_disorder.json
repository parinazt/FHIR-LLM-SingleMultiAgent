    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Gambling pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Electronic gaming machine gambling most days, mainly at own venue and sometimes at a nearby club; some late-night online sports betting. Ongoing for at least 12 months and worse after COVID reopening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gambling preoccupation and control"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports thinking about which machine is due even at dinner with mother. Plans to spend $50 and be home by 9 pm but stays for hours and spends a few hundred dollars."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Recent gambling expenditure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately $1200 over three nights in the last week"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Gambling-related consequences"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Behind on credit card and Afterpay payments; has a small personal loan. Reports increased conflict with ex-partner about child support, mother raising concerns about money, and stopping gym and fishing activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes mood as flat and stressed about gambling losses and debt; also describes feeling stressed and a bit ashamed. No persistent low mood or anhedonia outside the gambling context."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and intent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current suicidal ideation or plan. Occasionally feels it would be easier to disappear, but denies intent. Identifies daughter and closeness to mother as protective."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxiety is mostly related to money worries; no panic reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep; stays on phone and bets late at night until 2–3 am. Reports insomnia after losses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 3–4 beers after late shifts and 6–7 beers on pay nights. Denies morning drinking and blackouts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
