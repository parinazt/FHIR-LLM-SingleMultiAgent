    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports intermittent dull abdominal pain for 3–4 days, periumbilical and extending to the lower abdomen, mostly lower and somewhat generalized; severity 3–4/10, not colicky. Worse after large greasy meals and when leaning forward; passing wind and an over-the-counter antacid help somewhat. No radiation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bloating and increased flatus. No nausea or vomiting. Bowel movements once daily, formed; sometimes slightly loose after greasy food. No melaena, rectal bleeding, or incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Abdominal and systemic red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies dysuria, fever, weight loss, night pain, appetite change, recent travel, sick contacts, persistent vomiting, haematemesis, severe localised pain, jaundice, urinary symptoms, and trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Perianal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports severe perianal itching for approximately 3–4 months, gradually increasing, worse at night and after hot, sweaty work shifts, often waking him scratching. Now some soreness. Cold showers provide brief relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Perianal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports skin thickening and small spots of blood on toilet paper after scratching. Denies lumps, prolapse, mucous discharge, visible worms, nocturnal crawling sensation, similar symptoms in household members, anal sex, and known warts, fissure, or fistula. Denies fever, weight loss, and night sweats."
      }
    },
