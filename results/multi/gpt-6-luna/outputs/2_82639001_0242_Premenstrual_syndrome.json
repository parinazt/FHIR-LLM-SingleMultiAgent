    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sudden subjective fevers began approximately 6 days ago, just before menses, and settled by day 2 of bleeding; fever is now resolved. No temperature was measured."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sweats and myalgias during the febrile illness; mild headache. Today feels mostly back to normal, just a bit tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal symptoms and scratchy throat for 2–3 days, now gone; mild dry cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath beyond usual mild asthma; no urinary symptoms, gastrointestinal symptoms, rash, or rigors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Premenstrual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding symptoms increase 7–10 days before menses: irritability, tearfulness, feeling “not coping at school,” breast tenderness, bloating, and more migraines. Symptoms improve by day 1–2 of bleeding; inter-cycle mood is okay. Reports significant functional impact at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Menstrual cycle pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cycles regular, every 28–30 days. Last menstrual period began 5 days ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
