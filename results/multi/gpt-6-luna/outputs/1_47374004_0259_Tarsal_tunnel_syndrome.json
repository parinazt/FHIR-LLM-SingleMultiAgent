    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset yesterday afternoon; intermittent crampy epigastric/central abdominal pain just above the umbilicus, occurring in waves lasting 10–20 minutes and more noticeable after meals. Woke once overnight with discomfort. Worse after eating, especially a heavier meal. Partially relieved by sitting upright, a heat pack, and paracetamol. At worst 6–7/10; currently approximately 4/10. Pain increases slightly with bending and is not clearly localized to one quadrant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea last night; no vomiting reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Fever and rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
