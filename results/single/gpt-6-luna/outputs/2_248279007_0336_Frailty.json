    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported rash and pruritus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy papular rash on both forearms and dorsum of hands, with possibly a few spots on the lower legs, for approximately 2 weeks; worse at night. Patient reports scratching drives her mad. No blisters or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers; systemically well. No new prescription medicines. Increased use of cheap washing powder and soap from Woolies. Very dry skin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Forearms and hands: scattered erythematous excoriated papules and some linear scratch marks. No vesicles, pustules, burrows, or scale. Legs dry with a few similar lesions. No obvious infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
