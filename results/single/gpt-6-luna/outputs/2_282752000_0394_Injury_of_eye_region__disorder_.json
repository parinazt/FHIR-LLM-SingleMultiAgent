        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior chamber appears quiet on pen torch examination; no hypopyon or ciliary flush."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
