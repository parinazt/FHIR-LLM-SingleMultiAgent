        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds I and II; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person, place, and time; coherent speech; no focal deficit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Reported hearing change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports longstanding bilateral hearing loss and that hearing has 'gone down another notch'; television is louder and husband is complaining. Feels hearing is worse with the current head cold and more blocked when the nose is congested. No unilateral symptoms or sudden loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Reported associated hearing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies vertigo, new tinnitus, ear fullness, and otalgia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Bedside hearing assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Conversational voice heard at 1–2 m with hearing aids in; occasional repetition needed, especially with corridor noise. Whisper test less reliable because of anxiety and background noise. Overall picture consistent with known bilateral sensorineural hearing loss; no obvious asymmetry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Anxiety and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels more on edge when unable to hear and fears going deaf and not managing at home. Sleep mildly disrupted by cough and worry; still sleeping approximately 6 hours per night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neatly dressed with good eye contact; mildly anxious affect; health-focused thought content; no suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
