    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Interdigital toe symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Maceration between the fourth and fifth toes bilaterally, right greater than left. Itch has decreased but persists. Mild burning at the end of shifts in boots."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Footwear and sweating history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wears heavy steel-capped boots for 12–14 hours daily; feet are very sweaty; wears synthetic work socks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported negative foot findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No spread up the foot, no patient-reported nail changes, breaks or ulcers, discharge, or malodour."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported systemic and leg symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors, red tracking, or calf pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Groin itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild groin itch, described as nowhere near as bad as the toe symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Known diabetes mellitus history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No diabetes mellitus known."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance on video examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Foot examination on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: white macerated skin in the fourth–fifth toe web spaces bilaterally, with mild scaling and slight erythema at the edges. No obvious fissures, weeping, or pus. Nails visible on video appear okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
