            }
          ]
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Asthma, currently poorly controlled"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Collapse episode"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Collapsed at work after feeling chest tightness and lightheaded while on playground duty at school. Next recalled being on the ground with colleagues around. Witnesses reported no convulsions, incontinence, or tongue bite. Came to quickly, reportedly in less than 1 minute; no post-ictal state, but felt shaky. No previous syncope."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and relevant negatives with collapse"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpitations, chest pain, focal neurological symptoms, or headache reported. No known cardiac history. Not pregnant by history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Asthma symptoms over the last 1–2 weeks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased wheeze and shortness of breath on stairs and while reading in class; night cough 3–4 times per week; uses short-acting bronchodilator most days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Chest tightness and asthma symptoms on day of collapse"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild chest tightness in the morning. Took salbutamol 2 puffs approximately 1 hour before the event with partial relief. Patient reported the collapse did not feel like typical severe asthma; colleagues reported no audible wheeze. No rash, swelling, or gastrointestinal symptoms."
      }
    },
