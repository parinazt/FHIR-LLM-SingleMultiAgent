    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 3 weeks ago; dull ache across the lumbar area, right greater than left. Baseline pain 4–5/10, up to 7/10 after prolonged sitting or bending to pick things up; worse at the end of the workday with prolonged sitting; improved by lying flat and heat pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain associated symptoms and red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation to legs, numbness, tingling, weakness, saddle anaesthesia, bladder or bowel issues, night pain waking her from sleep, trauma, falls, or motor vehicle accident. No fevers, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Periods described as heavier and more painful; note records duration as approximately 12–18/12, with clots for 2–3 days each cycle. Cycles regular every 28–30 days. No intermenstrual bleeding or postcoital bleeding. Bleeding is heavy but not flooding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pelvic pressure and cyclical low back ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pelvic heaviness described as a dragging sensation around menses, with occasional low back ache at the same time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels fatigued, especially around periods. No previous FBE or iron studies."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Gynaecological and abdominal symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute severe pelvic pain, dysuria, abnormal vaginal discharge, haematuria, urinary frequency, flank pain, or gastrointestinal symptoms; bowels normal and no PR bleeding. No dizziness, palpitations, or syncope reported."
      }
    },
