        "code": {
          "text": "Right lower leg warmth and tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports local warmth and mild tenderness to palpation. Examination found mild warmth and mild tenderness to palpation."
      }
    },
    {
