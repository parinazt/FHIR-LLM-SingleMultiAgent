    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports being more puffed walking to the dining room over the last few months, with no clear acute change in the last few days. Shortness of breath mainly on exertion, for example after approximately 30–40 m along the corridor, and settles within a few minutes of rest. No shortness of breath at rest. Described as mild and stable over several months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated reported symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, palpitations, cough, fever, calf pain or swelling, pleuritic pain, haemoptysis, and paroxysmal nocturnal dyspnoea. Sleeps on two pillows \"just in case\". Eating and drinking okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
