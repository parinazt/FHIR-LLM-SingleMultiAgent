    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Epigastric / central abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset yesterday afternoon; central / just above the umbilicus, crampy like bad period pain, intermittent waves lasting 10–20 minutes and more noticeable after meals. Woke once overnight with discomfort. Severity 6–7/10 at worst, now about 4/10. Worse after eating, especially a heavier meal; partially relieved by sitting upright, a heat pack, and paracetamol."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea last night; no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Fever and rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
