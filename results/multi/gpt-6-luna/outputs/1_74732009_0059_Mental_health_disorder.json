    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anxiety and low mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a long history of on-and-off anxiety and low moods; anxiety has increased over the past 6 months, especially at work. Describes being on edge all day and wiped out afterward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep with reduced sleep onset and waking at 3–4 am with mind racing about school; approximately 4–5 hours of broken sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and social functioning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes mood as “up and down,” with irritability and tearfulness at home; avoids friends because she feels too drained."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Brief periods of increased energy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports brief 1–2 day spells of feeling “pumped and super productive” with decreased need for sleep, while still functioning; reports no risky behavior."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Perceptual experiences"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies auditory or visual hallucinations. Occasionally feels staff are “talking about me,” but recognizes this is likely anxiety."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sensory sensitivities and episodes when overwhelmed"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sensitivity to noise and lights, a need for routines, and “meltdowns” at home when overwhelmed involving pacing, raised voice, and slamming doors; reports no violence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Suicidal and self-harm thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies current or past suicidal thoughts or self-harm; says, “I’m not suicidal just exhausted.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Alcohol, drug, and caffeine use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no drug use and alcohol intake of 0–2 standard drinks per week. Reports 4–5 coffees per day and wonders whether coffee and LED lights contribute to symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Work functioning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worried about her job and reports it is becoming harder to cope; occasional sick days due to anxiety and sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Appearance and behavior on examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well kempt and mildly restless."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Mental state examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious affect; mood described as “tired and stressed.” Thought process logical but circumstantial. No psychosis or suicidal or homicidal ideation. Insight okay; judgment intact."
      }
    },
