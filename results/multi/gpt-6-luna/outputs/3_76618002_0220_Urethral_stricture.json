    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urinary leakage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 3 weeks, small-volume dribbling, especially post-void and sometimes without urge; reports damp underwear despite having just urinated and uses tissue in underwear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Voiding symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of weak stream. Worsening over the last 3–4 months: hesitancy, straining, weak stream, prolonged time to empty, and feeling of incomplete emptying."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary frequency and nocturia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Urinary frequency every 1–2 hours; nocturia 2–3 times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Lower abdominal pressure/fullness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild lower abdominal pressure/fullness, worse when holding on."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, visible blood, fevers, rigors, flank pain, nausea, vomiting, and severe suprapubic pain. Reports no history of acute urinary retention requiring catheterization."
      }
    },
