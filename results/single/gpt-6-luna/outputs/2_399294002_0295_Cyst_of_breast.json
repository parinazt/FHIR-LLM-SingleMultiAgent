        "code": {
          "text": "Telehealth general appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, alert, and in no apparent distress. Colour normal, with no obvious pallor or jaundice."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
