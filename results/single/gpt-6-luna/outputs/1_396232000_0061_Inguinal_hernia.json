    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported right groin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent right groin bulge for 6–7 months, more obvious with lifting and coughing at work and reduced when lying flat. Mild ache only; no sharp pain. Over the last 2–3 weeks, the patient feels the lump may have increased in size after long days at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal and hernia red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No episodes of severe pain, irreducible lump, vomiting, abdominal distension, or fevers. Bowels open daily; no rectal bleeding or constipation; passing flatus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right groin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small-to-moderate right inguinal bulge while standing, increased with cough and Valsalva; soft, fully reducible, and non-tender, with no erythema or warmth. No clinical features of incarceration or strangulation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, non-tender, and non-distended; bowel sounds normal; no masses or organomegaly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left groin, testes, scrotum, and inguinal lymph nodes examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No left groin hernia. Testes normal to palpation and non-tender; no scrotal swelling or inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance and observed affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, anxious but cooperative, and looks well."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported health concern and checking related to hernia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very worried about strangulation and cancer, repeatedly checks the area multiple times per day, avoids some activities, and reports extensive internet searching and repeated reassurance-seeking that affect quality of life and work confidence."
      }
    },
