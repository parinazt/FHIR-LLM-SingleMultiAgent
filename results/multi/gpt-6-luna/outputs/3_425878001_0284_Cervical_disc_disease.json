        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly cautious gait with narrow base; able to tandem walk but somewhat wobbly. Described as similar to previous."
      }
    },
