    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Lower abdominal discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three-day history of intermittent dull ache across the lower abdomen, rated 4–5/10, worse last night; non-colicky and non-radiating. No clear trigger or relation to meals. Patient wondered whether too many coffees or a meat pie eaten two days earlier contributed. Pain does not wake him from sleep. Two Panadol last night gave some relief. Able to work, though uncomfortable bending and lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels opening daily with formed stools. Denies diarrhoea, constipation, per-rectal blood or mucus, melaena, nausea, vomiting, dyspepsia, heartburn, and regurgitation. Appetite is okay; denies anorexia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary and genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, urgency, haematuria, flank pain, and testicular pain. Denies trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Systemic symptoms and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, weight loss, and night sweats. No recent overseas travel, sick contacts, or antibiotic use. No previous similar episodes. Reports no history of IBD, IBS, gallstones, renal stones, hernias, or abdominal surgery."
      }
    },
