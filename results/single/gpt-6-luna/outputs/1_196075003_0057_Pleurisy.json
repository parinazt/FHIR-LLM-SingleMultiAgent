        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep due to chest pain and stress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Pleuritic chest pain and associated respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left-sided sharp pleuritic pain for about 10 days, worse with deep inspiration, coughing, or laughing; slightly decreased since ED assessment but still up to 6/10. Reports dry cough without sputum or haemoptysis and mild, stable dyspnoea on hills. No orthopnoea, paroxysmal nocturnal dyspnoea, or oedema. Patient reports CTPA at Wagga ED was negative for PE and showed inflammation; records not yet received."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
