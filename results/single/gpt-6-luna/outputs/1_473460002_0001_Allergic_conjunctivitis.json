        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported eye symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No purulent discharge, lids stuck in the morning, significant pain, photophobia, reduced vision, foreign-body sensation, trauma, or contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lids normal with no crusting. Bilateral diffuse conjunctival injection, more palpebral, with marked chemosis especially inferiorly. Watery clear discharge; no mucopurulent discharge. Cornea clear with no fluorescein staining or foreign body. PERRL, no RAPD, EOMI without pain. No preauricular lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported seasonal nasal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sneezing and rhinorrhoea each spring, worse this week; high pollen reported in the media."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
