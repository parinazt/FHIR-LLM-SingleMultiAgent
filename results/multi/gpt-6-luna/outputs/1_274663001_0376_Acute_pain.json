        "status": "final",
        "code": {
          "text": "Left-sided low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acute, approximately 10/7 duration; onset after lifting heavy stock boxes at work. Initially a sharp twinge, now a constant dull ache, baseline 4/10 with intermittent sharper pain 7–8/10 on flexion, twisting, or rolling in bed. Localised to the left lumbar region, with no radiation below the knee."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
