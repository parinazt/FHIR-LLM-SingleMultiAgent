        "code": {
          "text": "Avoidance of being alone outside the home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids being alone outside home; may cancel or delay appointments if her partner cannot accompany her, uses grocery delivery, avoids public transport and busy indoor spaces alone, and can walk a short distance around the block with her partner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports difficulty sleeping when her partner is not in the flat and staying awake until he returns; occasional nightmares about him going missing or having an accident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
