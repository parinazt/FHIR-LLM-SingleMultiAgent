    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right foot examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild localised soft-tissue swelling and erythema at the first MTP, with mild warmth compared with the left. Tender over the dorsum and medial aspect. No deformity, skin breaks, ulcers, nail changes, obvious tophi, fluctuance, or plantar tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right first MTP range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsiflexion slightly reduced due to pain; otherwise range of motion preserved, with pain mainly at the extremes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right foot neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sensation normal; capillary refill under 2 seconds; dorsalis pedis and posterior tibial pulses palpable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
