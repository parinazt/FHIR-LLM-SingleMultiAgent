    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Dyspareunia and associated pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports approximately 2 years of painful sex, with superficial burning, sharp stinging pain at the introitus during tampon use and intercourse; sometimes throbbing pain for hours afterward; occasional deep pelvic ache, especially in certain positions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sexual activity and anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids sex most of the time but still occasionally attempts intercourse with her long-term partner. Reports guilt about avoiding sex and anticipatory anxiety before attempts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period was 7 days ago; cycles regular every 28–30 days with moderate flow; no intermenstrual bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Current associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current abdominal pain apart from mild chronic pelvic ache; denies fevers, rigors, dysuria, abnormal discharge, and postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-looking but clearly time-pressured and checking phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild suprapubic/low pelvic tenderness to deep palpation; no guarding, rebound, or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Labia majora and minora normal; no lesions or fissures. Mild vestibular erythema from 4 to 8 o'clock; no discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Hymenal tissue examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small crescentic hymenal remnant at the posterior introitus, slightly thicker but non-obstructive and appearing within normal anatomical variation; no active fissure or bleeding; tissue not rigid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Cotton swab test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked allodynia of the vestibule, especially at 5–7 o'clock and just lateral to the urethral meatus; patient withdrew and described sharp burning pain to light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Single-digit pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased pelvic floor tone with marked guarding; advancing the finger was difficult, and deep palpation was limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Speculum examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Only partially attempted; patient was very uncomfortable and requested that the examination stop. Limited view; cervix grossly normal from what was seen, with no obvious discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Cervical motion tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cervical motion tenderness on minimal movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Bimanual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not completed due to pain and time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Urine beta-hCG"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Offered; patient declined, stating she was confident she was not pregnant, was using condoms, and had just finished menses. No test result obtained."
      }
    },
