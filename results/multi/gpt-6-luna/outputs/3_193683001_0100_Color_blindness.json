        "status": "final",
        "code": {
          "text": "Forearm rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports rash on both forearms for approximately 10 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash is still itchy but a bit better; worse after work and in the evenings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pain, fevers, blisters, or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Stinging with soap"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient says the soap really stings if left on."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported rash colour change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient has difficulty telling whether the rash is redder because of congenital red-green colour vision deficiency; wife says it has gone from red to more brown."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Forearm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: patchy erythematous papular rash over the extensor surfaces of both forearms, right greater than left. No obvious vesicles, crust, pus, or significant swelling. Hands and palms spared. Looks non-infected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, talking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new visual symptoms; congenital red-green colour vision deficiency reported as stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Tiredness and headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports tiredness and headaches after long hot days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
