        "medicationCodeableConcept": {
          "text": "Ferro-grad C 325 mg (105 mg elemental iron plus vitamin C)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take one tablet by mouth each morning. Take away from tea, coffee, and dairy where possible; may take with a small amount of food if gastrointestinal upset occurs. If daily dosing is poorly tolerated, may trial alternate-day dosing and inform the clinician. Continue at least 3 months after haemoglobin normalises, then for a further 3 months to replenish stores; total approximately 3–6 months depending on results.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "when": [
