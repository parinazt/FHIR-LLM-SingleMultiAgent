    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right groin and anterior hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports aching right groin/anterior hip pain with intermittent sharp twinges. Onset uncertain, possibly a few weeks to a couple of months. Pain is approximately 5/10 at baseline and up to 7/10 with movement. Worse with hip flexion, including lifting the leg into a car, stairs, sit-to-stand, and putting on socks; also worse at the end of the day after standing or bending over low desks. Occasional radiation into the anterior right thigh, not below the knee. Improved with rest, some stretching, and a heat pack; patient is unsure which tablets help."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Functional effect of right hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working; avoiding playground duty and finds sitting on the floor with children harder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, night sweats, weight loss, recalled recent trauma, bowel or bladder change, saddle anaesthesia, abdominal symptoms, urinary symptoms, or gastrointestinal symptoms. Mild occasional low-back ache. No history of malignancy, TB, or IV drug use reported."
      }
    },
    {
