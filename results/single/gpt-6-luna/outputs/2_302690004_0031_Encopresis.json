    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bowel movement frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Opening bowels maybe 1–2 times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Stool characteristics and defecation symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very large, hard stools that are painful to pass and sometimes block the toilet; increased stool holding for several months because it hurts when stool finally comes out and because the patient dislikes public toilets."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Faecal soiling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daily small-volume soiling in underwear over the last few weeks; described as skid marks and stool leaking out."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels bloated and incompletely emptied, with dull lower abdominal discomfort."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Relevant reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rectal bleeding, melena, fever, nausea or vomiting, urinary symptoms, saddle anaesthesia, or leg weakness. Weight stable."
      }
    },
    {
