    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing midline and paraspinal neck pain extending into the right shoulder, rated 4–7/10. Worse at the end of the workday, with computer sitting, and while driving. Broken sleep due to neck pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Intermittent limb heaviness and shaky or clumsy feeling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent subjective heaviness and shaky or clumsy feeling, right arm greater than left and sometimes right leg. Episodes last minutes to 1 hour and occur several times per day. Onset is unclear; patient gives changing accounts of whether symptoms began last week or immediately after the crash. She remains able to type and lift light things but says the limbs feel off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Intermittent tingling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tingling in the right forearm and hand, not clearly dermatomal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sensory and bowel or bladder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no numbness, saddle anaesthesia, or bowel or bladder change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occipital headaches a few times per week since the crash, with neck stiffness. No red-flag headache features volunteered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Function and work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working full-time, typing more slowly, and avoiding heavier lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cervical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tenderness over the lower C-spine and paraspinal muscles, with increased trapezius tone. Mildly reduced range of motion in all directions due to pain. No deformity or step."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 throughout with no drift. Tone normal. Reflexes 2+ and symmetrical; no clonus. Sensation intact to light touch and pin; patient reports the right forearm sometimes feels a bit funny, with no objective sensory deficit. Coordination normal on finger-to-nose and heel-to-shin testing. Gait, including tandem gait, normal. Hoffmann's and Babinski negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Mobility and general appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and walks unaided."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Recall and questions during visit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Preoccupied with concern about nerve damage, repeats questions, and has poor recall of prior advice and medicines."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Loss of consciousness after crash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No loss of consciousness."
      }
    },
