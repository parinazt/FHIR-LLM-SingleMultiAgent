    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General and abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Afebrile, well appearing, in no acute distress, walking easily and conversant. Abdomen soft and non-tender, with no suprapubic or flank tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Penile and meatal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal external penile appearance. Mild dried whitish discharge at the meatus and slight meatal erythema. No ulcers, vesicles, or warts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Scrotal, testicular, and epididymal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild left hemiscrotal swelling and warmth compared with the right. Left epididymis feels thickened and is tender, especially at the head/body; left posterior testis/epididymal region is tender. Right testis and epididymis normal and non-tender. No obvious masses. Cremasteric reflex present bilaterally; no high-riding testis or horizontal lie."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Spermatic cord, perineal, and inguinal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild left spermatic cord tenderness. No varicocele or obvious hernia. Perineum intact, without erythema or induration. No inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Digital rectal and prostate examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prostate mildly enlarged and smooth, non-tender, without bogginess or marked tenderness. No perianal or rectal tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Immediate response after ceftriaxone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ceftriaxone was tolerated, with no immediate reaction observed during approximately 15 minutes of observation."
      }
    },
