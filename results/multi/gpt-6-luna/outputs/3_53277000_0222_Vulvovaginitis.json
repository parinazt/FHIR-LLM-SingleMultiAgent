              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Likely residual vulvar inflammation or irritant dermatitis"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Vulvovaginal itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for approximately 1 week; worse at night, especially on going to bed. External itch remains severe despite improvement in discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Vaginal discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially white and described as cottage-cheese-like; now minimal and much improved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vulvar burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burning at the introitus, largely settled."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vaginal odor and bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No odor; no per-vaginal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Perianal itch and visible worms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No perianal itch on waking; no worms seen in stool or around the anus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
