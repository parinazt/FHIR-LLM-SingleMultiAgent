    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported fatigue and weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feeling weak and tired for approximately 3–4 weeks; wiped out by afternoon. Activities of daily living remain manageable but are slower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, shortness of breath, palpitations, oedema, weight loss, fevers, night sweats, PR bleeding, melaena, or recent travel. Mood okay; no suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding urgency and incontinence, with small-volume urgency leaks and some stress leaks; uses 3–4 pads daily. No new lower urinary tract symptoms apart from longstanding urgency/incontinence. No dysuria, haematuria, loin pain, or fevers. No retention symptoms. Nocturia twice nightly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels variable, with a mixture of loose and formed stools. No current PR blood. History of two faecal impactions. Currently no features of impaction."
      }
    },
