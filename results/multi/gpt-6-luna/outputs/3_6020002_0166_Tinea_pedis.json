          "text": "Toenail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nails thickened and yellow distally, consistent with onychomycosis; unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
