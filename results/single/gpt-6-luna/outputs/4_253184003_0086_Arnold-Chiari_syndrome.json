      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neurologic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented; speech normal; cranial nerves II–XII grossly intact. Normal tone and bulk, power 5/5 in all limbs, no pronator drift. Reflexes 2+ throughout, plantars flexor, no clonus. Light touch and pinprick intact; vibration and proprioception grossly intact. Finger-nose-finger normal; heel-shin mildly slow on the right only, normal on the left. Rapid alternating movements show very mild right-hand clumsiness compared with the left, but are functional."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
