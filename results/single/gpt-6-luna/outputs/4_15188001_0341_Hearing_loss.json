        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pharyngeal erythema; no exudate, tonsils not enlarged, uvula central."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
