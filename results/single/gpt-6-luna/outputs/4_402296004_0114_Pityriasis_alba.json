      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported facial skin patches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hypopigmented patches on the cheeks for approximately 3–4 months, more noticeable after tanning over summer. Mild intermittent itch, especially after hot showers, with some dryness and flakiness; no pain, bleeding, or vesicles. Scrubbing with exfoliant has caused stinging."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Facial skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ill-defined hypopigmented macules and patches on both cheeks and lateral jaw, 1–3 cm, with very fine scale on close inspection and non-sharply demarcated borders against mildly tanned skin. No complete depigmentation or erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
