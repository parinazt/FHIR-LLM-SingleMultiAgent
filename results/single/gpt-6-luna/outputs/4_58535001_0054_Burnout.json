      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 1–2 standard glasses of wine on most days off, sometimes 3–4 after a run of shifts to 'switch off'; denies morning use and blackouts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Caffeine use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 5–6 coffees per night on night shifts and 2–3 coffees per day otherwise."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
