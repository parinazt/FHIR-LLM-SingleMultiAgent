        "code": {
          "text": "Sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports gradually reduced sexual desire for approximately 12–18 months, now persistent; rare sexual thoughts and often avoids initiating sex. She says the switch feels off and sex can feel like a chore. Reports distress, guilt, and feeling 'a bit broken'."
      }
    },
    {
