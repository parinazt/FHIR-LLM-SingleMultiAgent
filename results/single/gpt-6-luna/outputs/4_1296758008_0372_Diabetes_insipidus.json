          "text": "Thirst and fluid intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels thirsty and reports drinking approximately 4–5 L of water per day, similar to previous poor control of diabetes insipidus but somewhat increased over the last few days."
      }
    },
