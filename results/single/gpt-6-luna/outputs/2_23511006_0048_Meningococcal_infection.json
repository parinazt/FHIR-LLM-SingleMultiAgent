    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Symptoms at onset of meningococcal illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 9 days before the encounter: high fevers, severe headache, neck stiffness, photophobia, nausea and vomiting, and purple spots on the legs and trunk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Current post-discharge symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since discharge 4 days ago: no fever, rigors, or new rash. Mild fatigue, requiring a nap some days; occasional mild headache later in the day that settles with paracetamol; concentration feels a bit foggy with prolonged study but is improving. No photophobia, neck stiffness, or vomiting. Denies hearing loss, tinnitus, imbalance, focal neurological symptoms, seizures, and visual change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mood and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly anxious about recurrence and contagion; sleeping slightly lighter. No nightmares and no suicidal thoughts."
      }
    },
