    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Behaviour and activity change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Per daughter, more withdrawn, no longer watching usual TV, pacing especially in the late afternoon, and more fidgety for approximately 5–6 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported lower abdominal and groin discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittently clutching lower abdomen/groin. When prompted about pain, patient said it was 'just a bit sore' and 'nothing really'; tends to minimise pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep disturbance and vocalisations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Per daughter, sleep has been poorer, with the patient up and down overnight and making more grunting vocalisations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Oral intake and hydration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral intake decreased over the last 3 days; still drinking adequately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel and urinary pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passing urine and bowel motions as usual. Carer reports usual urine volume and colour, no foul odour; bowels 1–2 times per week, formed, without diarrhoea or constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported absence of associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known fever, vomiting, change in bowel habit, visible haematuria or trauma. Carer reports no obvious dysuria, cough, shortness of breath, wheeze, new focal neurological symptoms, new rash or pressure areas."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Carer-observed scrotal size change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daughter feels the scrotal lump looks a bit bigger again and is concerned continence pads may be rubbing or squashing the area."
      }
    },
