    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Possible anxiety/panic component to episodes of shortness of breath and perioral tingling, versus allergy"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent solid-food dysphagia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent difficulty swallowing solid food for approximately 6–9 months. Food feels stuck mid-chest, especially bread and meat; needs sips of water and occasionally regurgitates food back up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Episodes of food sticking and choking sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two episodes in the past month in which the patient stood up and coughed food back out, feeling as though choking; she could still breathe and had no complete obstruction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Chest tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central chest tightness during swallowing episodes, settling 10–15 minutes after food passes. Not exertional and not associated with walking uphill."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Retrosternal burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Retrosternal burning approximately 2–3 times per week, especially after late takeaway meals after shifts; worse with coffee and spicy food, with some relief from Gaviscon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Globus sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional globus sensation, especially at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent symptoms after meals with possible food exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three episodes in the past 6–9 months after certain meals, possibly involving almond milk while eating out: itchy throat, mild perioral tingling, and patchy itchy erythematous rash on the forearms about one hour later. The patient felt a little wheezy with chest tightness. No stridor, collapse, or gastrointestinal symptoms; episodes resolved without medication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Historical symptoms after egg exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Raw or undercooked egg has caused hives and lip swelling approximately 30 minutes after exposure since the patient’s teens."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Historical symptoms after tree nut exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tree nuts, type uncertain, in a mixed-nut bar years ago caused hives and lip swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "History of anaphylaxis requiring adrenaline"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of anaphylaxis requiring adrenaline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Breathlessness and perioral tingling in stressful situations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports shortness of breath and tingling around the mouth when very anxious during busy work shifts; whether these symptoms reflect panic or allergy is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and swallowing negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies painful swallowing, haematemesis, melaena, rectal bleeding, weight loss, vomiting, nocturnal choking cough, and progressive voice change. Appetite is okay."
      }
    },
