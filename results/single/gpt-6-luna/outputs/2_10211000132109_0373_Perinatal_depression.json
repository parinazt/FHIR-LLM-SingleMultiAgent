          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced sleep; baby wakes 2–3 times, after which patient experiences racing thoughts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
