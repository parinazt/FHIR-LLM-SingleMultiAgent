        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bleeding from right index finger lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Recurrent bleeding with minor trauma, especially at work; patient reports it is still bleeding a lot. Onset approximately 5–6 weeks ago after a paper cut; red lump developed over approximately 2 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
