        "code": {
          "text": "Reported red-flag and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no trauma, weight loss, fever, sweats, systemic symptoms, focal neurological symptoms including weakness, numbness or sphincter change, chest pain, shortness of breath, abdominal pain, headache, or visual change; appetite is okay"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
