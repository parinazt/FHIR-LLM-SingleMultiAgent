        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Fluticasone furoate 27.5 mcg nasal spray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "2 sprays in each nostril every morning for 1 week, then 1–2 sprays in each nostril every morning through allergy season",
            "route": {
              "text": "intranasal"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
