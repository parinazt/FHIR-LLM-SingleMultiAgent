        "code": {
          "text": "Reported associated symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, urinary frequency, haematuria, or obstructive urinary symptoms. No reported fever or rigors; patient felt a little off the previous day, with no temperature taken then. No nausea, vomiting, abdominal pain, or flank pain. No trauma or heavy direct impact. No sudden severe onset or pain waking him from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sexual history relevant to current presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heterosexual and sexually active; new partner approximately 2 months ago, condoms used inconsistently. No known STI and no previous STI screen for approximately 2–3 years. No insertive anal sex."
      }
    },
