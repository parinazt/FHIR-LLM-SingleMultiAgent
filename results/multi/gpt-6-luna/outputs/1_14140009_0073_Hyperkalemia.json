    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent pain, worsened 5–6 days ago after helping with wood and possibly twisting. Dull central low back ache, possibly into both buttocks, with no clear leg radiation. Approximately 5/10 at baseline and up to 7/10 with bending or twisting; worse in the evenings and eased by curling up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain associated negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma or fall, saddle anaesthesia, leg weakness, foot drop, bladder or bowel incontinence, fever, night sweats, weight loss, recent infection, IV drug use, and cancer history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Low back pain relief with paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports using paracetamol 1 g twice daily now and then, with partial relief."
      }
    },
    {
