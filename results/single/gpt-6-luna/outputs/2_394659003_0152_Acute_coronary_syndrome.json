        "code": {
          "text": "Reported intermittent lightheadedness, nausea, fatigue, and palpitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2–3 days: intermittent lightheadedness, mild nausea, fatigue, and occasional brief fluttery palpitations. Symptoms were worse with exertion and improved with rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
