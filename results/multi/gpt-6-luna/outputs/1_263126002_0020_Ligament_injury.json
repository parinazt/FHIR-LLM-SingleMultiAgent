        "status": "final",
        "code": {
          "text": "Right ankle inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild diffuse swelling around the lateral malleolus with faint resolving bruising. Skin intact; no erythema or deformity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right ankle tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender over ATFL and mildly over CFL; minimal tenderness over the tip/posterior edge of the lateral malleolus. No bony tenderness at the medial malleolus, base of the 5th metatarsal, or navicular; no syndesmosis or midfoot tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right ankle range of motion and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsiflexion and plantarflexion mildly limited at end range by pain. Inversion reproduces lateral pain; eversion causes minimal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right ankle power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4+/5 in all planes, limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right ankle stability tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior drawer painful with no obvious laxity compared with the left. Talar tilt mildly painful with no clear laxity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Weight-bearing ability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to weight bear immediately after injury and able to weight bear for more than 4 steps in the room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Right lower limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; dorsalis pedis and posterior tibial pulses palpable; capillary refill under 2 seconds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
