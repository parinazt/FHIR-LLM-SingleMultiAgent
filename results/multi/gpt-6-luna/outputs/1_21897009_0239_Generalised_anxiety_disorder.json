        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes 1–2 hours to fall asleep and wakes 1–2 times overnight; often uses phone or iPad in bed reading health websites."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
