          "text": "Fluticasone propionate 50 mcg/spray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "2 sprays in each nostril every morning for 1–2 weeks",
            "route": {
              "text": "intranasal"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
