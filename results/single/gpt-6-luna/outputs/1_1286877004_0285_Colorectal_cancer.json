    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Ascites drainage pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports draining about 2 to 3 litres every second day for comfort through a tunnelled peritoneal drain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal distension"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen distends between drains and improves after drainage; reports it is currently pretty big again but not as bad as when very tight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath when ascites is tense; no acute shortness of breath at rest and speaking in full sentences during the call."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Light-headedness during drainage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit woozy when the fluid is drained quickly; wife is trying to drain it slowly over a couple of hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Weight and muscle loss"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive weight and muscle loss noted; patient says his arms are getting skinny."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels moving daily and softer. No rectal bleeding, vomiting, colicky pain, or absolute constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Negative symptoms relevant to acute infection or abdominal complication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors, new focal severe abdominal pain, or confusion. No features consistent with acute peritonitis or obstruction by history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice strong; not breathless during the call and no slurring."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Patient concern about protein loss"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is worried that protein is being lost through the drain and asked whether he should increase protein shakes or eggs."
      }
    },
