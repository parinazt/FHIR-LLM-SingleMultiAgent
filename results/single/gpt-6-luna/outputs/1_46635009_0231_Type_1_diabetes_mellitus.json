    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported low back pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for 10 days in the mid-to-lower lumbar region, right greater than left; dull ache with a sharp twinge on flexion or lifting. Insidious onset without trauma or a single heavy lift. Worse at the end of the teaching day and when marking at a table; better lying flat and with heat. No radicular symptoms, neurological symptoms, bowel or bladder change, night pain, weight loss, fevers, urinary symptoms, or CVA pain. No history of cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gait normal. Straight leg raise negative bilaterally. Mild right paraspinal tenderness at L3–5; no midline tenderness. Lower-limb power, sensation, and reflexes normal. No saddle anaesthesia or CVA tenderness."
      }
    },
