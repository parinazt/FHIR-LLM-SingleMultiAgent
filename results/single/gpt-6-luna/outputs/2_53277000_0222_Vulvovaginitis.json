    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vulvovaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports ongoing vulval and vaginal itch for about one week, worse at night and especially when going to bed. Discharge initially white and described as cottage-cheese-like; it is now much improved and minimal. Burning at the introitus has largely settled. Persistent itch is external."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies vaginal odor, vaginal bleeding, perianal itch on waking, seeing worms in stool or around the anus, dysuria, urinary frequency, pelvic pain, abdominal pain, fever, rigors, and dyspareunia. Reports no gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no masses or suprapubic tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema of labia majora and minora with excoriations from scratching. No fissures, ulcers, vesicles, or suspicious lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema from scratching. No worms, ova, burrows, or haemorrhoids."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Prior vaginal examination, reported by patient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports that an examination three days earlier showed white discharge and was assessed as thrush. Speculum examination was deferred today; no bimanual examination was performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "completed",
        "medicationCodeableConcept": {
          "text": "Clotrimazole 2% vaginal cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Intravaginally for 3 nights; completed, with last dose the night before this encounter.",
            "route": {
              "text": "vaginal"
            }
          }
        ]
      }
    },
