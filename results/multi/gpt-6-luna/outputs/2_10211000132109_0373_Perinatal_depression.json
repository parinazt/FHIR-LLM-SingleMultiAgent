        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Panic attacks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports panic attacks 2–3 times per week, lasting 10–15 minutes and resolving spontaneously. Symptoms include palpitations, shortness of breath, tremor, and fear that she will lose control and do something stupid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
