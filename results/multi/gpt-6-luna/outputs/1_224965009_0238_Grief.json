    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Energy and function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no energy and being unable to do his normal job for approximately 3 months; function has markedly decreased since his wife died 5 months ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Motivation and interests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports decreased motivation and no interest in fishing or seeing mates; now mostly sits, drinks, and watches TV."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mood and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low mood most days, anhedonia, poor concentration, fatigue, and guilt about his wife's death."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports difficulty initiating sleep and early waking at 3–4 am; sleeps approximately 4–5 hours. Uses beer to sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased appetite."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal ideation: “better if not here.” Denies plan or intent and says he will not act because of his children."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
