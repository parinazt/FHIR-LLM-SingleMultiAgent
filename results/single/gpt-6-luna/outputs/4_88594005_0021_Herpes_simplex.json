        "code": {
          "text": "Neurological symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No headache, confusion, seizures or neck stiffness reported. Non-focal examination, normal speech and no meningism."
      }
    },
