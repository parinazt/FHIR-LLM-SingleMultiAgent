        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Upper back and shoulders with multiple well-demarcated hypopigmented macules and patches with fine scale, some coalescing; evoked scale present; no erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
