    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bad headache for 3 days, on both sides of the forehead and temples. Gradual onset, not thunderclap. Constant dull pressure-like ache, sometimes throbbing later in the day, especially after work with noisy children or screens. Wakes with no headache or a mild headache that builds over the day. Severity up to 6/10, 3/10 now."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag symptoms with headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea, vomiting, visual changes, aura, weakness, speech or swallowing issues, dizziness, fever, neck stiffness, or 'worst in my life' headache. No recent head injury. Patient reports not pregnant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported possible headache contributors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks phone use or looking at screens, or facial cream, may be related. Daughter reports patient comes home exhausted from work, does not drink much water, and goes straight to bed with the lights off."
      }
    },
    {
