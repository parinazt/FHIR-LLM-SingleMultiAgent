    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull left-sided headache, 2–3/10, described as a nuisance and worse when overtired. No sudden severe headache, early-morning vomiting, or headache waking him at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported cognitive changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daughter has reportedly said he is a bit more forgetful; he misplaces items and repeats questions. Patient feels he has always been absent-minded. He is not getting lost in familiar places and continues basic routines, with some delay recalling exact dates."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Informal cognition and orientation by telephone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and conversant; oriented in conversation to person, place, and time. Able to recount hospital stay and current daily routine; some delay recalling exact dates, but overall story consistent. Formal cognitive screening not yet performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Gait and balance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels a bit wobbly, especially on first standing or in dim light. Reports furniture-walking indoors and unsteadiness when turning quickly; gait and balance could not be observed during the telephone consult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Near-fall"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "One near-fall in the kitchen in the last 2 weeks while turning quickly; caught himself on a bench. No further actual falls since hospital discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent with basic self-care but slower; sits for showers because of fear of falling. Manages simple meals. Has stopped ladder work, roof work, and garden work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Instrumental activities of daily living and driving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not driving as advised by hospital. Relies on daughter for shopping and transport to appointments; daughter brings groceries and frozen meals weekly and has arranged direct debit for bills. Patient is not managing complex finances himself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; wakes 2–3 times overnight thinking. Denies nocturnal headache waking him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies low mood; acknowledges frustration about decreased independence and says he will 'just get on with it'. Denies suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional eyes feeling a bit fuzzy when tired. Denies diplopia and acute visual loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Speech and swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysarthria, dysphasia, and swallowing issues. Speech fluent on the telephone with no word-finding difficulty reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Seizure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of seizures before or after the subdural haematoma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies facial asymmetry, limb weakness, or numbness when asked directly. No new severe headache, rapid increase in confusion, new focal weakness, new incontinence, or acute visual loss reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory status during telephone consult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with no audible shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "CT brain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hospital discharge summary reports CT brain approximately 6 weeks ago: post burr-hole evacuation of left fronto-parietal chronic subdural haematoma, small residual collection, minimal midline shift, no acute haemorrhage, and no hydrocephalus. No repeat imaging since."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Social and support circumstances"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lives alone in a public housing flat. Daughter is the main support, lives approximately 30 minutes away, checks weekly, and assists with shopping and transport. No formal home care package or My Aged Care services currently in place."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Reported environmental concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wondered whether an old mattress and water tasting different might be contributing to symptoms; reassured these were unlikely to be secondary to the subdural haematoma."
      }
    },
    {
