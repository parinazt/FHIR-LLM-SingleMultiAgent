    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Watery eyes and eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports both eyes watering for approximately 3 days, described as feeling like crying but not; worse outdoors and in wind. Mild grittiness. Denies photophobia, visual loss, eye trauma, purulent discharge, and contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral conjunctival injection and profuse tearing. Pupils 4–5 mm, equal and reactive; no miosis or ciliary flush. No corneal opacity. Visual acuity approximately 6/9 OU, uncorrected. Gross examination including lid eversion: no foreign body seen, eyelid oedema, or purulent discharge. Extraocular movements full and non-painful. No photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased sweating, loose stools, abdominal cramps, yawning, rhinorrhoea, teary eyes, poor sleep, feeling wired, decreased appetite, and strong opioid craving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
