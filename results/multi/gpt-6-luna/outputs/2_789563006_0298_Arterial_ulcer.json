        "status": "final",
        "code": {
          "text": "Foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp, significant right foot pain, especially at night; worse when lying flat with the foot elevated and reduced when the foot is dependent. Often has to dangle the leg off the bed to sleep."
      }
    },
    {
