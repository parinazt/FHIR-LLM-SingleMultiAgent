        "code": {
          "text": "Sleep-related screen use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses screens in bed nightly and checks work emails."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Pre-sleep thoughts and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports pre-sleep rumination, replaying work matters and difficulty switching off. Mood described as okay, but tired and a bit snappy. Denies low mood, anhedonia, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Sleep-related symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies snoring, apnoeas, restless legs symptoms, parasomnias, and narcolepsy symptoms. No alcohol use for sleep; no benzodiazepine or sedative use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Right shoulder symptom"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right shoulder ache for months, worse after long shifts. No injury reported; still working. No red-flag symptoms on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks tired but well. BMI within normal limits. Cardiovascular, respiratory, and abdominal examination grossly NAD. Mood congruent; no psychosis."
      }
