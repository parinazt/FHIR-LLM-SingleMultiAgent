        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for approximately 3 days; initially dry, now productive of small amounts of clear-white sputum. Worse overnight and with talking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Other reported viral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild sore throat, headache, myalgias, fatigue, and minimal nasal symptoms. Reports reduced sense of smell compared with baseline, but smell is still present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Rapid antigen test for COVID-19"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a positive result with a faint visible line; test was performed last night, approximately 48 hours into symptoms. No PCR test yet."
      }
    },
