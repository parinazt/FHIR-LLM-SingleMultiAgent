    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Skin rash examination via video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple well-demarcated raised erythematous violaceous plaques on cheeks and dorsal forearms, some coalescing; surface smooth. No obvious vesicles, pustules, crusting, ulceration, or facial swelling. Patient reports tenderness to touch and burning/tender pain rather than itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rash symptom course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful raised red plaques on face, neck, and forearms appeared rapidly over a few days and remained present at consultation; slightly less tender than the prior week. Patient reports the lesions look angrier in the evenings. Paracetamol gives partial relief."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported fever and rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially had fevers at home up to 38.8 with rigors; temperatures during the last few days were below 37.8."
      }
    },
