    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Oral lesions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 5–6 days: white patches on tongue and hard palate, described as like cottage cheese, that can be scraped off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Oral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild burning, especially with hot or spicy foods; mostly annoying and not really painful. Altered taste described as food tasting a bit funny or cottony."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Swallowing and chest symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysphagia, odynophagia, difficulty swallowing solids or liquids, food sticking, retrosternal pain, and chest pain on swallowing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Systemic and respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, feeling systemically unwell, shortness of breath, cough, and new weight loss; appetite is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Other oral findings reported absent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fixed white patches or lumps; lesions wipe off. Denies oral ulceration or bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
