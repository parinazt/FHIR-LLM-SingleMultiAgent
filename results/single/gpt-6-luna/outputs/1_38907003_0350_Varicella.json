        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Assessment for eczema herpeticum"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No features to suggest eczema herpeticum: no background eczema, lesions discrete rather than confluent erosions, and no punched-out erosions, especially periocular."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Varicella exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works in childcare; several children recently had varicella, including one sent home with chickenpox the previous week."
      }
    },
