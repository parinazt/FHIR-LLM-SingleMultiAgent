        "status": "final",
        "code": {
          "text": "Avoidance when alone outside home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient avoids being alone outside the home, cancels or delays appointments if her partner cannot accompany her, and uses grocery delivery."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Agoraphobic avoidance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient avoids public transport and busy indoor spaces alone. She can walk a short distance around the block with her partner and reports high distress about unfamiliar places alone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports difficulty sleeping when her partner is not in the flat, staying awake until he returns, and occasional nightmares about him going missing or having an accident."
      }
    },
    {
