    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves II–XII grossly intact; visual fields full to confrontation, pupils equal and reactive to light, extraocular movements intact, no nystagmus. Face symmetrical; speech normal with no dysarthria or aphasia. Motor strength 5/5 in all limbs except left shoulder movement limited by pain and stiffness; no other focal weakness. Light-touch sensation intact. Finger-to-nose and heel-to-shin intact. Gait normal; no ataxia. No meningism; full, painless neck flexion."
      }
    },
