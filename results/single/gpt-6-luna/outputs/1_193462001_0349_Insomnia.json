    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Difficulty initiating sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes 60–90 minutes to fall asleep; reported insomnia for approximately 9–10 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep maintenance and duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes 2–3 times; estimates 4–5 hours of broken sleep on work days and 6 hours on days off if she pushes it. Sleep is worse with shift changes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep diary bed and wake times"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over 2 weeks: bedtime 2200–0100 and wake time 0500–1100, dependent on shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep diary sleep latency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "45–90 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
