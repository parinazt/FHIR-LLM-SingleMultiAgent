    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Shocking pain and deep ache over the top of the left shoulder to the mid upper arm, with sharp stabs if he moves the wrong way; does not extend past the elbow."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left shoulder and upper arm pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 7–8/10 at night and 5/10 during the day; wakes him from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Pain onset and duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Onset unclear; initially described as 1–2 weeks, then as 'ages, at least a month'; timeline reported as unreliable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Left shoulder pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse lying on the left side, with abduction, overhead work and lifting tools. Heat pack helps a little; Panadol does nothing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Focal numbness over left upper outer shoulder"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes a 'dead patch' of numbness over the left upper outer shoulder, beginning a few days after the pain started."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Subjective left arm weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports struggling to lift a ladder and compensating with the right side."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Possible contributors to shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma recalled; wonders whether he slept 'funny on lounge' and reports using a new, heavier cordless drill at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Negative symptoms: neck and distal upper limb"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies neck pain, shooting pain down the arm, tingling in the fingers, hand weakness and neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Red flag screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, jaw pain, diaphoresis, fever, weight loss, night sweats, recent neck injury, limb heaviness or clumsiness, gait change, and sphincter disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Telehealth examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No observations obtained. Voice comfortable at rest, with occasional pauses or winces when describing movement. Speech and cognition okay; vague about dates and contradictory about duration. No audible shortness of breath or cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
