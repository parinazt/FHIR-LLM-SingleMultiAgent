        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tension headache."
      }
    },
    {
