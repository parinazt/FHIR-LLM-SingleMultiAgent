        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves II–XII grossly intact; normal facial movement and sensation; limb power 5/5; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Occupational and psychosocial impact of eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly self-conscious at work; colleagues have commented that her eye looks tired, and she is worried children may comment. Reports some reduced confidence and reluctance to take time off for specialist appointments."
      }
