        "code": {
          "text": "Left ear itching and skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch with dry, flaky, crusty skin around the left ear. Patient is trying not to scratch."
      }
    },
    {
