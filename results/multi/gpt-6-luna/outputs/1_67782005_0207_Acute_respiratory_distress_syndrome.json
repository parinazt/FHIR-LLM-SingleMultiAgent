        "code": {
          "text": "General appearance and work of breathing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin elderly man, speaks in full sentences, with mildly increased work of breathing when talking for a long time. No distress at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
