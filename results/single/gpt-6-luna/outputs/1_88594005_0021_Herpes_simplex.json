    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Patient-reported rash history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor historian. Rash began as little clear blisters on the face and neck about 1–2 weeks ago, possibly longer, then spread widely."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash pain and itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is greater than itch; stings with movement or touch. Very sore."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Recent systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Felt hot and shivery a few days ago, without a documented temperature at that time; feels tired and flat."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry eczematous skin, especially neck, antecubital fossae, and hands. Superimposed widespread monomorphic vesicles and punched-out erosions with crusting and erythematous base over face, neck, upper chest, upper back, proximal arms, and trunk; some lesions coalescing. Very tender to light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Skin examination findings regarding possible secondary infection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No classic honey-coloured crust or frank pus. Some lesions have mild surrounding erythema; possible bacterial superinfection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few small peri-oral erosions. No vesicles on fingertips. No current genital lesions reported; no genital examination today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Oral findings and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild discomfort opening mouth wide; eating okay and no dysphagia to fluids. Oral mucosa mildly erythematous, with no widespread ulceration or thrush. No obvious large intraoral ulcers; patient reluctant to open mouth wide."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Eye symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No visual change, eye pain, or discharge. Eyes clear, with no conjunctival injection or periocular vesicles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No headache, confusion, seizures, or neck stiffness. Alert and orientated; speech normal, non-focal examination, and no meningism."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
