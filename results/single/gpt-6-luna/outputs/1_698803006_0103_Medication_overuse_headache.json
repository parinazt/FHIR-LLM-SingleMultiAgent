      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Propranolol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "10 mg orally twice daily for 1 week, then increase to 20 mg twice daily if tolerated. Continue for at least 6–8 weeks before judging full effect.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Naproxen MR"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "750 mg orally in the morning with food for 5 days in week 1, then for 3 days in week 2, then stop. Avoid concurrent use of other NSAIDs.",
            "route": {
              "text": "oral"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 750,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Sumatriptan"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue 50 mg at migraine onset; may repeat once after 2 hours. Maximum 100 mg in 24 hours. Restrict use to fewer than 10 days per month.",
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 50,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
