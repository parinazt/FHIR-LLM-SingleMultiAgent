    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 2–3/52, eating more slowly and leaving meat. Intermittent solid dysphagia, especially with meat and bread; feels food sticks halfway down and coughs it back up with water. Occasional regurgitation of undigested food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported absence of acute swallowing red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No complete obstruction; handling saliva, with no drooling. No odynophagia or chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
