        },
        "valueString": "Patient reports “sugars up & down”."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For months, gritty and burning sensation in both eyes, worse in the morning, with crusting of the lids and mild redness. Also reports eyes are “a bit crusty”. History of recurrent “styes”."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No polyuria, polydipsia, weight loss, chest pain, or shortness of breath. No photophobia, decreased visual acuity, foreign-body sensation, purulent discharge, or severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Eyelid examination, both eyes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous lid margins, collarettes/crusts at lash bases, mild thickening, and a few misdirected lashes bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Meibomian glands and tear film"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Meibomian gland plugging/inspissation, turbid secretions on pressure, mild T, and frothy tear film."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right upper eyelid nodule"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4–5 mm firm, non-tender nodule away from the lid margin, consistent with chalazion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild conjunctival injection bilaterally. Cornea clear on torch examination with no obvious ulcer. Pupils equal, round and reactive to light; extraocular movements intact. No cellulitis."
      }
    },
