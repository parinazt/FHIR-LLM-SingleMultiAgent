    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Shoulder has been a bit sore for about 3 months, gradual onset with no clear injury. Dull anterolateral ache with a sharp twinge on some movements. Wakes if she rolls onto the left side; trouble hanging washing, reaching overhead, and doing her bra behind her back. No neck pain, radiation past the elbow, pins and needles, or true weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over greater tuberosity/subacromial area; AC joint non-tender. Active flexion approximately 120° and painful; abduction approximately 100–110° with painful arc approximately 70–120°. Internal rotation limited (cannot reach bra strap); external rotation approximately 45° with mild pain. Passive range of motion near full with end-range pain. Jobe/empty can causes pain with mild weakness versus right; pain on resisted external rotation. Hawkins and Neer impingement tests positive. Neck full range of motion, no radicular signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urethral and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a little red lump at the urine opening for approximately 6–8 weeks and mild intermittent stinging at the end of urination. Two tiny spots of blood on paper last month, none since. No dysuria, frequency, urgency, visible haematuria in the bowl, vaginal bleeding, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "External genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atrophic vulval skin. Small approximately 5–6 mm soft red polypoid lesion at the posterior lip of the urethral meatus, mildly tender to palpation, not friable, with no active bleeding or pus. No obvious prolapse."
      }
    },
