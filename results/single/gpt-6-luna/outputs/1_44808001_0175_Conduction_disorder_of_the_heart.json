    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash for approximately 4–5 days. Small red maculopapular spots on both forearms and dorsum of hands, with a few spots on the shins; mildly itchy, not painful, with no blisters, weeping, or peeling. Non-purpuric and non-blistering by description. No rash on face or trunk and no mucosal involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and exposure history for rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, chills, arthralgia, eye symptoms, or mouth ulcers. No shortness of breath, wheeze, throat tightness, lip or tongue swelling, or generalised urticaria. No new soaps or similar products. More gardening the previous week, in short sleeves, with possible fertiliser contact. No previous similar rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Usual home blood pressure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually approximately 120–130/70–80 mmHg per patient; not measured today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences; no audible shortness of breath or wheeze. Alert and coherent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
