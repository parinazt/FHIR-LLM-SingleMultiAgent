    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported URTI symptoms and associated negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "URTI symptoms for approximately 5 days: initially scratchy throat, now nasal congestion, rhinorrhoea, mild dry cough and feeling a bit washed out. Afebrile at home; eating and drinking okay. Denies shortness of breath, chest pain, wheeze, facial pain, purulent sputum, gastrointestinal symptoms, haemoptysis, confusion, ear pain or discharge, sinus tenderness, severe headache, photophobia and neck stiffness. Possible triggers queried: new scented washing powder or air conditioning at shops."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported hearing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding bilateral sensorineural hearing loss with behind-the-ear hearing aids; reports hearing has gone down another notch and television volume is louder, with husband complaining. Hearing feels worse and more blocked when nose is congested with the current head cold. No unilateral symptoms, sudden loss, vertigo, new tinnitus, ear fullness or otalgia. Sometimes forgets to wear hearing aids because they whistle with grandchildren. No recent ear wax removal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported anxiety and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels more on edge when unable to hear and fears going deaf and not managing at home. Sleep mildly disrupted by cough and worry, still approximately 6 hours per night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; no acute distress."
      }
    },
    {
