        },
        "valueString": "Denies current pregnancy; last menstrual period approximately 3 weeks before the consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
