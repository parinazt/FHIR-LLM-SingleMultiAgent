        "code": {
          "text": "Gait and balance examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal gait base and arm swing. Slight wobble on first tandem gait attempt, then able to perform; Romberg negative."
      }
    },
