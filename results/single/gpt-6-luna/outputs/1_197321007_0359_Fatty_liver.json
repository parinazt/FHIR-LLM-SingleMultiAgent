        "status": "final",
        "code": {
          "text": "Systemic symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma or wound reported; afebrile and systemically well. No stigmata of chronic liver disease. Cardiovascular, respiratory, and abdominal examinations grossly within normal limits."
