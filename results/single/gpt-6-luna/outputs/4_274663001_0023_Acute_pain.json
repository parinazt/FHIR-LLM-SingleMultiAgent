        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "400 mg twice daily when remembered",
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 400,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Increase to regular dosing of 1 g every 6 hours, maximum 4 g in 24 hours, for 5–7 days, then as needed.",
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
                "value": 4,
                "unit": "g"
              },
              "denominator": {
                "value": 24,
                "unit": "h"
              }
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Naproxen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 500 mg as a stat dose, then 250 mg twice daily with food, for up to 5 days. Avoid other NSAIDs; take with food and fluids. Stop earlier if pain is much better or if any gastrointestinal symptoms occur.",
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 500,
                  "unit": "mg"
                }
              }
            ]
          },
          {
            "text": "After the stat dose, take 250 mg twice daily with food for up to 5 days.",
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 250,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
