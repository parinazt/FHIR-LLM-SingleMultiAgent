    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right dorsal forearm skin patch, reported appearance and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a small, dry, scaly patch about the size of a pea on the dorsal right forearm, present for approximately 3–4 weeks. It has gradually become rougher to touch and more visible in the mirror; colour is unchanged and described as “just a bit pink and rough.” No preceding trauma or bite. Sorbolene used intermittently may have helped slightly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Symptoms associated with right dorsal forearm skin patch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pain, itch, bleeding, ulceration, or rapid growth. From history, the lesion is described as superficial, non-tender, non-bleeding, and stable over the past few weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no fevers, weight loss, night sweats, or malaise."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports mild glare, especially with night driving, and mild distance blur, stable. No sudden decrease in vision, severe eye pain, marked redness, purulent discharge, or curtain over vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Direct visual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Telehealth by phone only; lesion and eyes could not be inspected directly."
      }
    },
