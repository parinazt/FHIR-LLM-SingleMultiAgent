        "status": "final",
        "code": {
          "text": "Telephone assessment findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with no increased work of breathing over the phone. Patient describes small-volume, intermittent anterior bleeding that settles with simple pressure. No facial or periorbital swelling or visual change."
