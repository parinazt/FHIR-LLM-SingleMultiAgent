    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right index finger lesion history and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lesion noticed approximately 4–5 weeks after a box-cutter nick. Patient describes a small red lump that bleeds easily with minor trauma, particularly while handling notes at the till. Irritating and a nuisance rather than painful, but interrupts work to apply bandages. Patient thinks frequent alcohol-based hand rub use and cheap workplace bandages may be aggravating it. No fever, spreading redness, reduced hand range of motion, or other skin lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right index finger lesion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsolateral right index finger just distal to the PIP joint: approximately 5–6 mm red, friable dome-shaped papule on a narrow stalk with a moist surface. Mild bleeding on light contact during examination, settling with direct pressure. No surrounding erythema, warmth, induration, or pus. Assessment documents no pigment, atypical borders, nodes, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand function and right index finger examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grip strength within normal limits bilaterally. Able to make a full fist and open the hand against resistance. Fine motor function intact; able to finger-tap, count coins, and simulate till use without difficulty. Full active and passive range of motion at the right index PIP, DIP, and MCP joints without pain. Sensation intact; capillary refill normal; hand function preserved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Gait and posture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent gait with normal pattern and stable stance; able to fully weight bear. No issues noted during brief observation walking to the door."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
