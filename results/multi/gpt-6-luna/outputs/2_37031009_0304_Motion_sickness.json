    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hyoscine hydrobromide 300 microgram tablets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet by mouth 30 minutes before travel; may repeat every 4–6 hours as needed; maximum 4 tablets in 24 hours",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "tablet"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "ePrescription: 20 tablets, 0 repeats."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Promethazine 25 mg tablets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Backup option if hyoscine is ineffective or poorly tolerated: take 1 tablet by mouth 1–2 hours before travel as needed for motion sickness; may repeat every 6–8 hours; maximum 4 tablets in 24 hours",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "tablet"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "ePrescription: 10 tablets, 0 repeats. Advised to use only when a passenger; do not drive or operate machinery if taken."
          }
        ]
      }
