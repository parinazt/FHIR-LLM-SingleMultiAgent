    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance and interaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, talkative, and tangential at times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Rash history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1 week of red, mildly itchy spots on the upper chest and dorsal forearms. Started as a few spots and became more numerous, remaining on the upper chest, shoulders and extensor forearms, not below the waist. Itch is worse in the evenings and after showering and does not wake the patient at night. No vesicles, weeping or pain. New body wash about 2 weeks ago; recently began wearing a cheap synthetic high-visibility work shirt and reports heavy sweating while working in hot roof spaces."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple small 2–5 mm erythematous, slightly raised papules over the upper anterior chest and shoulders, with scattered papules on the dorsal forearms; some coalesce into small patches. Mild excoriation. No vesicles, pustules, crusting, target lesions or purpura. Face, palms, soles and mucosa spared."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated rash symptoms and systemic features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, wheeze, lip or tongue swelling, fever, systemic symptoms, recent viral illness, genital rash, dysuria or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Abdominal and renal angle examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, no mass or suprapubic distension, and no costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Voiding history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voids 5–6 times per day and once overnight. Slow stream, unchanged and described as the same as always."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Urinary symptoms and infection history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current dysuria, haematuria, loin pain or suprapubic pain. No UTI in more than 1 year."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Fluid intake and urinary holding history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks a lot of coffee and energy drinks, probably not enough water, and often holds urine at work."
      }
    },
