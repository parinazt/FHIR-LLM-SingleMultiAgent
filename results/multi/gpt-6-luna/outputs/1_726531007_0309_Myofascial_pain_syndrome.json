        "status": "final",
        "code": {
          "text": "Muscle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing generalized muscle pain flare; pain for the last 2–3 weeks in the neck, shoulders, upper back, and occasionally the lower back. Dull ache with intermittent sharp twinges, worse at the end of the workday and after long periods at the computer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
