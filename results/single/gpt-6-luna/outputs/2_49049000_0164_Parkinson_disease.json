        "code": {
          "text": "Erectile dysfunction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for a couple of years; not a priority for the patient today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hypomimic with reduced blink; soft, slow but coherent speech; cogwheel rigidity at wrists, right greater than left; bradykinesia on finger tapping and rapid alternating movements. Gait stooped and shuffling with reduced arm swing, right greater than left; turns en bloc; no freezing in corridor. Postural stability mildly reduced on pull test, recovers in 2–3 steps with no fall."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person, place, and time; no acute distress. Abdomen soft and non-tender with no masses."
      }
    },
