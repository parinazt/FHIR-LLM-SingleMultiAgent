        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last bowel motion yesterday morning, normal. Denies diarrhoea, constipation, rectal blood or mucus. Passing flatus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
