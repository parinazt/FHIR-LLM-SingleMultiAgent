        "code": {
          "text": "Increased falls risk related to knee osteoarthritis and deconditioning; no actual falls reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Longstanding bilateral knee pain for years, dull ache at the medial and anterior knees. Worse with walking for more than 10–15 minutes, stairs, and prolonged standing; eased by rest and sitting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Knee instability and giving way"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Intermittent subjective giving way of both knees, right worse than left, for approximately 6–9 months, especially when descending steps or getting up from a chair. Reports feeling wobbly, as if the knees may buckle."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Near falls and falls"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Reports 3–4 near falls in the last 2 months. No definite complete falls and no head strike."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Knee stiffness, swelling, and crepitus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Stiffness after sitting more than 20–30 minutes and on waking, loosening after a few minutes of movement. Knees feel puffy at the end of the day. Reports marked ongoing crackling and grinding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Knee night pain and mechanical symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Occasional night pain, not waking the patient most nights. Denies true locking and episodes of giving way with sharp severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hand symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Intermittent hand pain and stiffness, especially at the DIP and PIP joints with heavy use. Reports bony nodules at the fingertips; no acute flare today."
      }
    },
