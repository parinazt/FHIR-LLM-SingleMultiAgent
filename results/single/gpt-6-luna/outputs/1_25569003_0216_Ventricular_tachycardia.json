    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder pain, reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic, gradual ache for approximately 3–4 weeks, lateral/anterior-lateral shoulder radiating to the upper arm but not past the elbow; described as like having slept awkwardly, rated 3–5/10. Worse with overhead reaching, reaching behind the back, and lying on the left side at night; better with rest and heat. ADLs mostly okay, avoiding overhead activities, still driving. Panadol 1 g as needed takes the edge off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Tender over greater tuberosity/subacromial area. Active abduction limited to approximately 90–100 degrees with pain; flexion limited above shoulder height; reduced internal rotation and difficulty reaching behind the back. Passive range slightly greater but painful in the mid-arc. Painful arc positive at 70–120 degrees; Hawkins and Neer positive. Jobe mildly painful, power approximately normal; external rotation power preserved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No reported true weakness, numbness, or tingling. Distal neurovascular examination intact. Neck full range of motion and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Cardiac symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, jaw or arm exertional pain, palpitations, presyncope, and syncope. No recent ICD shocks noticed. No paroxysmal nocturnal dyspnoea or orthopnoea. Mild stable dyspnoea on hills for more than 12 months, unchanged. No recent admissions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Patient concern about shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient was worried the shoulder pain might be putting extra strain on the heart; reassured that the pattern was musculoskeletal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported possible medication effects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild hand tremor and photosensitivity reported while taking amiodarone; no visual symptoms, weight change, or cough."
      }
    },
