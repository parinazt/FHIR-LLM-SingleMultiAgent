        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual-onset dull ache across the lumbar area, right greater than left, for approximately 3 weeks. Worse at the end of the work day, after prolonged sitting, and when bending to pick things up; improved by lying flat and using a heat pack."
      }
    },
