        "code": {
          "text": "Weakness and fatigue associated with recent gastro-like illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Weakness, fatigue, and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For about 5 days, decreased energy and feeling wiped out; feels drained and shaky, especially on standing. Remains at work but has reduced productivity and fatigues by mid-afternoon. Completes basic ADLs more slowly than usual and needs rests."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea began about 5 days ago. Vomiting peaked over 2 days, at worst 5–6 times per day, initially food then bile; now largely settled, with last vomiting yesterday morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Oral intake, appetite, abdominal pain, and stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased oral intake and appetite. Mild crampy epigastric pain only during vomiting, now resolved. Loose stool 1–2 times per day during the worst illness, now back to usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal and infectious negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No haematemesis, melena, or PR bleeding. No recent travel or sick contacts. No fevers, rigors, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Headache and visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache today, similar to usual baseline intermittent frontal headaches. Brief visual fuzziness only on standing. No persistent visual loss or diplopia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Pregnancy possibility as reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports regular menses, last menstrual period about 2 weeks ago, prior tubal ligation, and zero chance of pregnancy. Declined beta-hCG after discussion."
      }
    },
