    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lids normal with no crusting. Bilateral diffuse conjunctival injection, more palpebral, with marked chemosis especially inferiorly. Watery clear discharge; no mucopurulent discharge. Cornea clear with no fluorescein staining and no foreign body. PERRL, no RAPD, EOMI, no pain. No preauricular lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pale boggy nasal mucosa with clear rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
