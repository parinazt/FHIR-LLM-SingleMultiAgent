        "code": {
          "text": "Associated ear symptoms and possible exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No ear discharge, tinnitus, vertigo, or upper respiratory tract symptoms. Possible mild night sweats, with no clear fevers. Using cotton buds; possible dirty water exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left external auditory canal mildly erythematous without oedema or debris. Tympanic membrane intact, slightly dull, and not bulging. No mastoid tenderness or lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
