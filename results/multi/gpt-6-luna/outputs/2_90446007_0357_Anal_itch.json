        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "OTC antacid from chemist (unspecified)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Reported using it for abdominal discomfort; it helps a little. Dose and frequency not stated."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Methylprednisolone aceponate 0.1% fatty ointment (Advantan)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer perianally once nightly for 2–3 weeks, up to a maximum of 4 weeks, then cease. May use short courses as needed if symptoms recur.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
