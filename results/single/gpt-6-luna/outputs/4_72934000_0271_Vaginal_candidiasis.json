        "code": {
          "text": "Vulval examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythema, mild oedema, excoriations, and small fissures at the posterior fourchette; no ulcers, vesicles, or suspicious lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Vaginal and pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thick white curdy discharge adherent to vaginal walls, non-offensive. Cervix normal; no cervical motion tenderness or adnexal tenderness. Uterus normal size and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
