        },
        "valueString": "Abdomen soft and non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Health-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is very anxious about cancer, systemic candida, and a hidden STI; expressed fear that symptoms could be cancer. Health-related worry and catastrophising noted in the context of housing and work stress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sleep disturbance and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent sleep disturbance; current thrush noted to cause itch, discomfort, decreased sleep, and increased anxiety. No permanent impairment noted."
      }
    },
