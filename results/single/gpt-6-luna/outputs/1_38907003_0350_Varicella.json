    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Prodromal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 3 days ago, felt flu-like at work with mild headache, fatigue, and low-grade fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash history and distribution"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash began about 36 hours ago. Small red spots progressed to vesicles, some now crusted; spread from trunk to scalp, face, and proximal limbs. Generalised distribution, not dermatomal; densest on the trunk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Polymorphic rash with multiple erythematous macules, papules, and vesicles measuring 2–5 mm, in various stages including crusted lesions; some vesicles umbilicated. Marked tenderness to light touch. No honey-coloured crust, obvious cellulitis, or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin tenderness and pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Skin described as burning and stinging, especially on the torso under the bra line; pain rated 6/10 when clothes rub. Tenderness is more prominent than itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itch is mild."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Eye symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No eye pain or visual change. No periorbital swelling or eyelid vesicles; conjunctiva clear and extraocular movements intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few small erythematous macules on the soft palate; no significant ulceration. Swallowing okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Neurological symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No confusion, neck stiffness, photophobia, or severe headache. Neurologically grossly non-focal; GCS 15 and gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory symptoms and chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No cough, shortness of breath, or pleuritic chest pain. Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and appetite symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting currently; tolerating fluids. Reduced appetite but eating small meals. No abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No genitourinary symptoms or joint pains."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "General appearance and hydration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, mildly anxious, well hydrated, and in no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
