        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; guarding the left arm slightly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left shoulder inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious deformity; possibly very slight anterolateral fullness compared with the right. No erythema or warmth. Tender over the greater tuberosity/subacromial area; acromioclavicular joint not tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left shoulder active range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abduction to approximately 110 degrees, limited by pain; forward flexion approximately 130 degrees; internal rotation to L5; external rotation mildly reduced."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left shoulder passive range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly better than active range of motion but painful at end range; not globally stiff."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left shoulder strength and provocative tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain and slight weakness with resisted abduction and external rotation; internal rotation preserved. Painful arc positive; Jobe test reproduces pain; Neer and Hawkins tests positive. No instability signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
