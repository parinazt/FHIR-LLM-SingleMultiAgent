    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Headache characteristics and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual-onset dull, constant frontal and bitemporal headache, right greater than left, rated 7/10; worse in the evenings and does not wake the patient from sleep. No thunderclap onset or worst-ever headache. No nausea, vomiting, photophobia or phonophobia; mild light sensitivity only and no visual aura. No jaw claudication, scalp tenderness, focal neurological symptoms, weakness, facial droop, speech difficulty, confusion, loss of consciousness, seizure, ataxia, neck stiffness, fever or rigors. Patient thinks it may be related to eyestrain from TV and bright LED supermarket lights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented. Cranial nerves II–XII grossly intact; visual fields full to confrontation, pupils equal and reactive, extraocular movements intact, no nystagmus. Face symmetrical and speech normal, with no dysarthria or aphasia. Motor power 5/5 in all limbs except left shoulder movement limited by pain and stiffness; no other focal weakness. Light-touch sensation intact, finger–nose and heel–shin testing intact, gait normal, and no ataxia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Head and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scalp non-tender; no temporal artery tenderness or thickening. Jaw opening painless. No meningism; full neck flexion without pain. Ears and oropharynx noted as NAD."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left shoulder symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing left shoulder stiffness and pain, present for approximately 8–9 months. Unable to lift arm to comb hair or hang washing; sleep disturbed because unable to lie on the left side. No deformity or swelling. Diffuse anterolateral tenderness; globally reduced active and passive range of motion, especially external rotation and abduction, with internal rotation also reduced. Pain at end range. No focal bony tenderness over clavicle, AC joint or humeral head."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General, cardiovascular and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, mildly uncomfortable, not toxic; anxious and impatient. Heart sounds dual with no added sounds; lungs clear."
      }
