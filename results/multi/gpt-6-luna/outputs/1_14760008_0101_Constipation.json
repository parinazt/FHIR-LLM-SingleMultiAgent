        "status": "final",
        "code": {
          "text": "Weakness and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling “weak and tired all the time” for approximately 3–4 weeks; fatigue most days, worse in the afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-refreshing sleep, 7–8 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, chest pain, palpitations, fever, night sweats, and weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Diet, fluid intake, caffeine intake, and activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports poor diet with increased toast and reduced vegetables, 3–4 coffees per day, minimal water, and very sedentary activity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No menorrhagia; Mirena in situ and periods are lighter."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding constipation, worse over the last 2–3 months; bowel movements approximately 1–2 times per week, Bristol stool type 1–2, with marked straining and incomplete evacuation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Abdominal bloating"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bloating, reduced after bowel movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies rectal bleeding, melaena, mucus, and change in stool calibre."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
