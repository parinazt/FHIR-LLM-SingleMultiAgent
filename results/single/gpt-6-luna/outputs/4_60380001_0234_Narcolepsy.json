    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Nocturnal sleep fragmentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 3 months, wakes 4–5 times per night, often first at 1–2 am and then about hourly; reports feeling jolted awake as if her body forgot to breathe for a second."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported sleep-related breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies witnessed apnoeas, gasping, choking, and morning headaches; partner has not noticed snoring."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vivid dreams and hypnopompic hallucinations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dreams are more vivid; occasional brief hypnopompic hallucinations described as seeing shadows in the corner for a few seconds, similar to previous experiences but increased in frequency."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Cataplexy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rare brief knee weakness with laughter, approximately monthly; unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness and naps"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent daytime sleepiness, similar to baseline; takes 1–2 short naps on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep attacks while driving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sudden sleep attacks while driving; avoids driving when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bedtime approximately 22:30; uses phone in bed until sleepy, with sleep latency 20–30 minutes. Wakes at 05:30 on work days. Often checks phone during overnight waking and then struggles to return to sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 2–3 coffees per day; last coffee usually at 15:00–16:00."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Alcohol and substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 0–2 standard alcoholic drinks per week, no excess alcohol, and no illicit drug use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Stress and health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased work stress over the past 6 months, ruminating overnight about work errors. Worried about serious illness, including heart failure, sleep apnoea, brain tumour, and early dementia; has googled extensively."
      }
    },
    {
