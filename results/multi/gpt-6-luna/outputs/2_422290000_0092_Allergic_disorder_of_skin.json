        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bad headache for 3 days, in the forehead and both temples. Gradual onset, not thunderclap; constant dull pressure, sometimes throbbing later in the day, especially after work with noisy children or screens. Wakes with no headache or a mild headache, which builds over the day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Headache severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Up to 6/10; 3/10 at the time of assessment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea, vomiting, visual changes, aura, weakness, speech or swallowing problems, dizziness, fever, and neck stiffness. Reports no recent head injury and no 'worst in my life' headache. Reports not pregnant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves grossly intact; normal gait; moving all limbs with strength 5/5; sensation and coordination normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
