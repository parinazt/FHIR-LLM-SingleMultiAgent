    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented. Cranial nerves II-XII grossly intact; visual fields full to confrontation, pupils equal and reactive, extraocular movements intact, no nystagmus. Face symmetric; speech normal without dysarthria or aphasia. Motor strength 5/5 in all limbs except left shoulder movement limited by pain and stiffness; no other focal weakness. Light-touch sensation intact; finger-nose and heel-shin coordination intact; gait normal with no ataxia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Head, temporal arteries, jaw, and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scalp non-tender; no temporal artery tenderness or thickening. Jaw opening painless. No meningism; full neck flexion, painless."
      }
    },
