    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Progressive skin and oral mucosal pigmentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual increased pigmentation over approximately 3–4 months. Reported over dorsal hands, knuckles, elbows, palmar creases, and old shin scars; brown macular patches on gums and inside cheeks. Examination showed subtle generalized bronzing compared with a prior identification photo and more marked hyperpigmentation at the reported sites. Oral examination showed brown macular pigmentation along gingival margins and buccal mucosa, without ulceration or leukoplakia."
      }
    },
