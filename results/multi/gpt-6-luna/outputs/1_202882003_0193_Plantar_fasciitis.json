          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit feverish over the last few days, with fluctuating low-grade fevers mainly in the evenings; onset 3 days ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Upper respiratory and constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild scratchy sore throat for 2 days, dry cough for 2 days, generalized myalgias, fatigue, and mildly decreased appetite; still eating solids and drinking fluids."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Respiratory and associated symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, pleuritic chest pain, chest tightness, wheeze, rigors, confusion, chronic cough, and exertional shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysphagia, sinus pain, otalgia, dysuria, urinary frequency, flank pain, nausea, vomiting, diarrhea, abdominal pain, rash, severe headache, photophobia, neck stiffness, focal neurological symptoms, and severe localizing abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right heel pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain at the anteromedial right heel, worst with the first steps in the morning and after sitting; eases as the day goes on and returns after long shifts on her feet. Reports difficulty walking first thing and after work breaks; describes it as a bit sore at the end of the day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right heel symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma, numbness, weakness, and night pain waking her from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
