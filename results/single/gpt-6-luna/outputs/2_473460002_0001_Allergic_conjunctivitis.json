    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing bilateral red, itchy eyes with watery discharge, worse at school and outdoors, especially on windy days. Denies purulent discharge, eyelids stuck in the morning, significant pain, photophobia, decreased vision, foreign-body sensation, trauma, and contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visual acuity 6/6 OU with pinhole. Lids normal, no crusting. Bilateral diffuse conjunctival injection, more palpebral, with marked chemosis especially inferiorly. Clear watery discharge; no mucopurulent discharge. Cornea clear with no fluorescein staining and no foreign body. PERRL, no RAPD, EOMI without pain. No preauricular lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported seasonal nasal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Seasonal sneezing and rhinorrhoea each spring, worse this week; uses loratadine intermittently. Reports high pollen levels in the media."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pale, boggy nasal mucosa with clear rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Throat and chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throat clear; chest clear with no wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, malaise, upper respiratory tract symptoms, and sick contacts at home. Denies asthma and eczema. Reports feeling tired all the time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, frustrated, and in no acute distress. Argumentative and repeatedly requesting antibiotics; became mildly confrontational when antibiotics were declined."
      }
    },
    {
