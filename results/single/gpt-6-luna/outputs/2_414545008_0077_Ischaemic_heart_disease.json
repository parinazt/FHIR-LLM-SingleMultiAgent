        "code": {
          "text": "Ankle swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild, stable evening ankle swelling, described as baseline; examination noted no peripheral oedema and mild venous stasis changes at the ankles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Intermittent claudication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Calf tightness after walking about 150–200 metres on flat ground, relieved by rest within a few minutes and unchanged since the last review. No rest pain, nocturnal foot pain, non-healing ulcers, colour change, or acute limb symptoms."
      }
    },
    {
