    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gait and mobility examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slight antalgic gait with short stride and slow pace; no walking aid. Cautious turning and mild varus knees."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Bilateral knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral bony enlargement and slight varus; no erythema. Small effusions in both knees, right greater than left. Mild bilateral medial joint-line tenderness; no warmth. No obvious ligament laxity with valgus or varus stress at 0° and 30°. Flexion to approximately 110° with end-range pain; extension near full; marked crepitus through range. McMurray negative for click or locking, with some medial discomfort only. No posterior tenderness or calf swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Several Heberden nodes at DIP joints and some PIP nodes, with mild tenderness. No synovial thickening or warmth. No deformity; range of motion preserved, with slight discomfort at end range."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lower-limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 in major muscle groups; light-touch sensation intact; reflexes normal; no focal deficit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
