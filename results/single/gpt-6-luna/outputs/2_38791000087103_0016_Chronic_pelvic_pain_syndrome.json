    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Chronic pelvic pain pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pelvic pain for more than 3 years. Pattern largely similar, with increased frequency of bad days over the last 6–9 months. Dull, deep pelvic ache in the suprapubic area and left greater than right lower iliac fossa. Baseline pain approximately 2–3/10, flaring to approximately 7/10, especially around menses and mid-cycle. Worse after long days standing while teaching and sometimes after intercourse. Episodes last hours to a full day, with partial relief from simple analgesia and a heat pack."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Postcoital spotting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent small-volume postcoital spotting approximately 3–4 times per month; settles within 24 hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Menstrual pattern and cramps"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Periods regular every 28–30 days; slightly more crampy than a few years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
