    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 7 days ago; dull, band-like pressure at the temples and forehead, occasionally occipital, non-pulsatile, severity 4–6/10. Worse late in the day after long hot kitchen shifts and screen use late at night; builds over the day and settles overnight; does not wake the patient in the early morning. Relieved by paracetamol 1 g up to twice daily as needed and resting in a dark room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Headache-associated and neurologic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea, vomiting, visual aura, focal neurologic symptoms, speech change, sensory loss, fever, neck stiffness, rash, confusion, seizures, and recent head trauma. Denies thunderclap onset, worst-ever headache, personality or cognitive change, visual field loss, diplopia, and jaw claudication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 2–3 weeks, intermittent mild crampy lower abdominal discomfort and bloating, with stool frequency 2–3 times daily compared with baseline once daily. No overt diarrhea, blood, mucus, weight loss, or nocturnal symptoms. Had 2–3 days of loose stools during or after travel that self-resolved."
      }
    },
