    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for 5 days. Gradual onset of outer left ear itch followed by dull ache, with occasional sharp stabbing pain when lying on the left side. Pain approximately 4/10 at baseline and up to 6/10 when lying on that side; worse at night and improved with simple analgesia. Aggravated by pinna movement, over-ear headphones, and a tight headband; relieved by paracetamol and avoiding pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated left ear symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild itch and dry, flaky, crusty skin. No ear discharge, hearing loss, tinnitus, vertigo, fever, or upper respiratory symptoms."
      }
    },
