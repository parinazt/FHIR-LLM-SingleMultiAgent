        "gender": "female"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Low sexual desire with associated distress, consistent with HSDD / female sexual interest–arousal disorder"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset of low sexual desire for approximately 12–18 months, now persistent. Rare sexual thoughts; avoids initiating sex and often goes along with sex for her partner's sake. Describes sex as feeling like a chore and says the switch is off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Distress associated with low sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially minimises the concern but reports distress, guilt, feeling a bit broken, and some strain in the relationship."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sexual arousal and orgasm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually able to become aroused once engaged and usually able to orgasm, though orgasm takes longer and feels less intense. No anorgasmia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sexual and pelvic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dyspareunia, vaginal dryness, postcoital bleeding, and pelvic pain. Periods regular every 28–32 days with moderate flow. Denies urinary symptoms and abnormal vaginal discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent low mood outside the sexual domain, general anhedonia, suicidal ideation, and thoughts of self-harm. No major depressive features reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports work stress, fragmented sleep of approximately 6–7 hours, and tiredness described as normal busy-mum tiredness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Relationship context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stable long-term relationship with a male partner described as generally supportive. Some tension about sex; partner is sometimes frustrated but overall understanding. Communication is described as okay, though the patient tends to brush concerns off. No intimate partner violence disclosed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Pregnancy and menopausal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports not pregnant and not menopausal. Denies hot flushes and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Symptoms potentially associated with endocrine conditions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hirsutism, acne, galactorrhoea, and virilisation. No history of thyroid disease, diabetes, or other endocrine issues reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Weight concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is concerned about having put on some weight around the middle since having children and wonders whether this is related to libido."
      }
    },
