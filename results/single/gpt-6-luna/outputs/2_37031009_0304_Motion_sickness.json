    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Possible underlying migraine tendency; personal headache pattern unclear"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Travel-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea, mild spinning or lightheaded sensation, and cold sweats occur during travel, especially as a passenger in a car on winding roads. Symptoms are worse when reading or using a phone in the moving vehicle, and improve when looking at the horizon, sitting in the front passenger seat, or when the vehicle stops. The patient reports a clear association with motion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Motion-related vomiting and nausea during air travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Has vomited in a car a couple of times; timing is uncertain, possibly last month or the time before. Flights sometimes cause nausea, especially during takeoff or landing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vertigo and symptoms at rest or with positional changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No symptoms at rest and no persistent vertigo at rest. Denies true room-spinning sensation at rest and symptoms when rolling over in bed or with quick head turns. Patient was asymptomatic at rest during the call."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported negative neurologic, auditory, and other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hearing loss, tinnitus, aural fullness, ear pain, ear discharge, focal weakness, numbness, paraesthesia, facial droop, diplopia, visual loss, dysarthria, dysphagia, gait disturbance, blackout episodes, seizures, sudden severe headache, chest pain, shortness of breath, palpitations, syncope, fever, recent upper respiratory symptoms, sinus symptoms, and recent head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Headache history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports past severe headaches in high school and intermittent 'bad headaches' with nausea; unable to describe the pattern, and migraine pattern is unclear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Audio-only telehealth examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vitals available. Speaking in full sentences with strong voice; affect appropriate and coherent; speech fluent without slurring. No audible cough or wheeze and no shortness of breath noted over the phone."
      }
    },
    {
