      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash distribution and appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple 1–3 cm poorly demarcated, erythematous, slightly raised, dry patches/thin plaques with excoriations on both flexor forearms; scattered small erythematous papules/patches on the anterior neck and upper chest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash onset and itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash onset approximately 5/7 ago; gradual increase in itch, especially at night and at work. Itch rated 6–7/10 and wakes the patient from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies blisters, weeping, oral lesions, fever, URTI symptoms, shortness of breath, wheeze, facial or tongue swelling, difficulty swallowing, joint pain, and gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
