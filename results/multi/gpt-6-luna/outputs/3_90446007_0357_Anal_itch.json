    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender throughout. No guarding, rebound, masses, or organomegaly. Bowel sounds normal. No costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diffuse mild circumferential erythema, lichenification, excoriations, and a few superficial linear fissures. No weeping, ulceration, blister, or purulent discharge. Small soft, non-tender skin tag at 6 o’clock. No obvious external haemorrhoids, thrombosis, warts, abscess, or fistula openings. Digital rectal examination deferred."
      }
    },
    {
