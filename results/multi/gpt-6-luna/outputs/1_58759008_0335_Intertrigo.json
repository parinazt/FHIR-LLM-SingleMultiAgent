        "code": {
          "text": "Chronic/recurrent inframammary intertrigo, possibly candidal"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash under breasts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On and off for months, worse over the last 2–3 weeks; itchy, burning, red and moist. Worse with heat, sweating, wearing a bra all day and gardening; better when aired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Odour associated with rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slight odour when the rash is bad."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and rash elsewhere"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, rigors, spreading erythema, pus or systemic symptoms. No groin or perianal rash currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Inframammary skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: bilateral inframammary folds with erythematous, macerated, well-demarcated plaques; possible satellite papules. No obvious ulcer, pus or clear cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, speaking in full sentences."
      }
    },
    {
