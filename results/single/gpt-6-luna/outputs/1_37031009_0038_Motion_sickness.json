    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Intermittent upper abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3 weeks: intermittent mild-to-moderate queasy/tight upper abdominal sensation, mainly epigastric, with nausea and no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Motion-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms worsen in a car, especially on rough or unsealed roads, with sweating and feeling 'crook in the guts' after about 20 minutes; sometimes occurs on the school bus. Reading or using a phone in the car worsens symptoms. No clear food trigger. Patient describes this as different from usual vestibular migraine, with stomach turning rather than spinning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and other reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No gastro-oesophageal reflux symptoms, change in bowel habit, rectal bleeding, melaena, weight loss, fevers, or urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vestibular migraine symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vertigo 1–2 times per month, mild and stable. No new neurological symptoms or hearing loss; tinnitus stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no apparent distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft, mildly tender in the epigastrium only. No guarding, rebound, right upper quadrant tenderness, or masses. Bowel sounds normal."
      }
    },
    {
