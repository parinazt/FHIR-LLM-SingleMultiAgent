    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash and itch, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash onset approximately 5/7 ago. Sites: bilateral flexor forearms, anterior neck and a few lesions on the upper chest. Itch gradually increased, especially at night and at work; itch severity 6–7/10 and waking the patient from sleep. New “eco” laundry detergent started approximately 1 week before onset. No new soaps, perfumes or cosmetics; no recent gardening, camping or bushwalking; no known contacts with a similar rash. Childhood mild eczema, none recent; no psoriasis or previous similar adult rash. Patient wondered whether “funny smelling water at home” was causing the rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral flexor forearms: multiple 1–3 cm poorly demarcated erythematous, slightly raised dry patches/thin plaques, excoriated from scratching. Anterior neck and upper chest: scattered small erythematous papules/patches of similar appearance. No vesicles, crusting, weeping or warmth; no target lesions, mucosal involvement, palmar or plantar lesions, generalized urticaria, or features of secondary bacterial infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blisters, weeping, oral lesions, fever, upper respiratory symptoms, shortness of breath, wheeze, facial or tongue swelling, difficulty swallowing, joint pain or gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Anxiety, stress and sleep symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports major work stress and conflict with manager over the last 2–3/12, feeling “constantly on edge” and unable to switch off. Sleep-onset insomnia with rumination about work. Appetite okay. No current panic attacks; often feels jittery with palpitations when stressed. Describes mood as “stressed and a bit overwhelmed”; denies persistent low mood, anhedonia, hopelessness and suicidal ideation. Still functioning at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Alcohol use, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alcohol most nights, approximately 2–3 glasses of wine, up to 1 bottle on weekends. Patient says it “helps me relax.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cannabis and other substance use, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vapes cannabis a couple of nights per week for sleep. No other illicit drugs reported. Patient described alcohol and cannabis as the “only thing that works” and was receptive but defensive during discussion of possible effects on anxiety and sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance and mental state examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, mildly anxious and frequently referring to written list. Cooperative; speech normal rate and volume; affect mildly anxious and reactive; thought process coherent; thought content appropriate; no psychosis or suicidal ideation expressed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
