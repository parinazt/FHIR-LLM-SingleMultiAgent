    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash and associated skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash present for approximately 3–4 weeks: rapidly appeared over a few days; multiple painful, tender/burning raised red plaques on the face, neck, and forearms. Patient reports plaques look angrier in the evenings. Slightly less tender than the previous week. Paracetamol gives partial relief. No discharge, vesicles, or crusting reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports fatigue and slightly reduced appetite but is drinking adequately. Denies oral ulcers, eye pain, shortness of breath, chest pain, abdominal pain, diarrhoea, and urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported fever and temperature trend"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially reported fevers at home up to 38.8 with rigors. Temperatures were below 37.8 over the last few days; patient feels washed out but somewhat better."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Skin punch biopsy, forearm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dense dermal neutrophilic infiltrate with papillary dermal oedema. No leukocytoclastic vasculitis; organisms not seen. Features consistent with acute febrile neutrophilic dermatosis (Sweet syndrome) in the appropriate clinical context."
      }
    },
