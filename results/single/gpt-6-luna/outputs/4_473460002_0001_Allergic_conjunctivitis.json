          "text": "Reported fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling tired all the time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, frustrated, and not in acute distress. Argumentative and repeatedly requested antibiotics; became mildly confrontational when antibiotics were declined."
      }
