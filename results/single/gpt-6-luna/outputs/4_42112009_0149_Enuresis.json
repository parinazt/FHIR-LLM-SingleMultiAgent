        "code": {
          "text": "Urine dipstick"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "At the previous visit: dipstick clear, negative for blood, leukocyte esterase, nitrite, and glucose; specific gravity 1.020."
      }
