        "code": {
          "text": "Sleep-disordered breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring, witnessed apnoea, or waking choking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Restless legs symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No restless legs symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
