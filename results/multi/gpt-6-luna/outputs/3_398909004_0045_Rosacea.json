          "text": "Metronidazole 0.75% gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue applying to central face twice daily; aim for a total 8–12 week course, then may step down to as needed.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
