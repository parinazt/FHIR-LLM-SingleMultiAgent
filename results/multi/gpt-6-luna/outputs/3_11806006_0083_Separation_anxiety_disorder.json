          "text": "Anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports anticipatory anxiety the night before her partner goes to work or social activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Worry about partner's safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports repetitive checking of her partner's location and messages, and worries that something bad will happen and he will not come home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Avoidance and difficulty going out alone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient avoids being alone outside home, may cancel or delay appointments if her partner cannot accompany her, uses grocery delivery, and avoids public transport and busy indoor spaces alone. She can walk a short distance around the block with her partner and reports high distress about unfamiliar places alone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports difficulty sleeping when her partner is not in the flat, staying awake until he returns, and occasional nightmares about him going missing or having an accident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Somatic symptoms associated with partner leaving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports abdominal tightness, nausea, and mild headache when her partner is about to leave; these settle when he returns home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
