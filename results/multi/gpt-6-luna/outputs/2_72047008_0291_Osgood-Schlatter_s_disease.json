        "code": {
          "text": "Osgood-Schlatter disease (traction apophysitis of the tibial tuberosity), right greater than left"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
