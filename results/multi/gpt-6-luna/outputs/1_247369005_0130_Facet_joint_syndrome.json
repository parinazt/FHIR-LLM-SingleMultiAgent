        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Local tenderness over lower lumbar facet joints, right greater than left; no midline tenderness. Mildly decreased flexion with ache at end range. Extension and rotation reproduce local pain only, with no radicular symptoms."
      }
    },
