    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well, alert, talking normally, and in no acute distress. No petechiae or purpura visible. Neck supple with full range of motion and no meningism. Oriented; cranial nerves grossly intact; power 5/5 in all limbs; sensation intact to light touch; gait normal; hearing grossly normal to conversation. No focal deficits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Blood culture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Blood cultures grew Neisseria meningitidis, serogroup B. Reported sensitive to penicillin, ceftriaxone, cefotaxime, ciprofloxacin, and rifampicin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cerebrospinal fluid findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "High protein, low glucose, neutrophilic pleocytosis; culture grew the same organism as the blood cultures (Neisseria meningitidis serogroup B)."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "CT brain before lumbar puncture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No mass, bleed, or hydrocephalus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
