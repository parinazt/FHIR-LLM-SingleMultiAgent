        "code": {
          "text": "Left submandibular duct sialolithiasis, uncomplicated"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Health anxiety / excessive illness worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent left submandibular swelling and discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 1 week: intermittent left submandibular swelling described as tight/achy, especially with meals and worse with sour or large meals. No constant pain; episodes settle in approximately 30–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, dysphagia, shortness of breath, trismus, dental pain, foul taste, and dry mouth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Neck and salivary ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4 mm echogenic focus in the distal left Wharton's duct with posterior acoustic shadowing, consistent with sialolithiasis; mild proximal duct dilatation; no mass or abnormal lymph nodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Blood test results"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "FBC, U&E, LFT and CRP all normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "General observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left submandibular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild fullness only; non-tender, not hot, no erythema, and no lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Oral examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Good teeth and no oral lesions. Left Wharton's duct orifice mildly prominent; clear saliva expressed, with reduced volume compared with the right; no pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Concern about salivary gland cancer"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is very focused on cancer and reports that Google says the swelling may be salivary gland cancer."
      }
    },
    {
