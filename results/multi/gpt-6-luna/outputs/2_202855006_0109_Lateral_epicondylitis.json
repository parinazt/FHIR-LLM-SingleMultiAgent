        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no apparent distress; moves right arm somewhat cautiously."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
