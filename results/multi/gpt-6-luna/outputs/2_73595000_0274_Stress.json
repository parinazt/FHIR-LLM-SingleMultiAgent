    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Fatigue and concern about iron"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports being very fatigued and wonders if her iron is low again; history of borderline ferritin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal thoughts most days, including feeling she is a burden and others would be better off without her. Denies plan, intent, or preparation; reports no past attempts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks tired, in scrubs, tearful but cooperative. Speech normal. Mood described as “stressed, guilty”; affect low but reactive. Thought content includes worthlessness, feeling a burden, and passive death wishes only. Thought process logical. No psychotic features or mania."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Alcohol consumption"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 3–4 nights per week, usually 3–4 standard drinks; sometimes 6–7 on days off. Says she drinks to take the edge off."
      }
    },
