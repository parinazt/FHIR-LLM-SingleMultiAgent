        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild grittiness in both eyes on the first night, now resolved. Currently denies eye pain, photophobia, blurred vision, foreign body sensation, or decreased vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
