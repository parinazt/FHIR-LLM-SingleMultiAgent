        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Salicylic acid wart paint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue on the right thumb and start on the left index. Soak for 5–10 minutes, pare with an emery board, protect normal skin, paint, and occlude. Continue nightly up to a total of 3/12 before calling failure.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
