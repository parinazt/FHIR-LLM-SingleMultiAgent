    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported blood-injection-injury phobia symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports marked anxiety around blood tests, injections, seeing blood, and even talking about needles; nearly faints when needles are mentioned, with sweating, nausea, light-headedness, and feeling she may pass out. Often needs to sit or leave the room, especially during vaccination clinics. No recent actual loss of consciousness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Avoidance of blood testing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoiding her own care; requested fasting blood tests have not been completed. The patient is uncertain of the timing of the request."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes mood as a bit low but better than last year; during examination described it as a bit flat but okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Energy is okay, with some decreased interest. Informal screening noted depressive symptoms as mild with function preserved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps 5–7 hours, with broken sleep and early waking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies current suicidal ideation; states she gets sad but is not going to do anything. One past episode of passive suicidal ideation; no suicide attempts reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Homicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No homicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mental state examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, well-looking, mildly anxious, cooperative, neat, and with good hygiene. Engaged and became tense, wringing hands when discussing needles. Occasionally tangential and vague about details. Speech normal in rate and volume, with slight hesitancy when recalling history. Affect constricted but reactive and congruent. Thought form largely linear. Prominent anticipatory anxiety about blood and needles. No delusions or hallucinations. Insight and judgment reasonable; recognizes the fear is excessive and interferes with care."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Situational anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Informal screening described anxiety as highly situational and related to the blood-injection-injury phobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Reported caffeine intake and perceived anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased coffee and cola intake and feels this may be contributing to increased anxiety. Expressed concern that cola is thinning her blood and increasing fainting risk; was reassured this is not the case."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
