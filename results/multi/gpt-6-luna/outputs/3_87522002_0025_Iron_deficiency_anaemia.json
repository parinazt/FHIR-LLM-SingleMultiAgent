    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right great toe symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right hallux pain for approximately 3–4 days, described as throbbing and very tender, especially in closed shoes and better barefoot. Insidious onset after a long day on her feet. Possible stubbing on a coffee table the previous week or rubbing from new sandals; uncertain. No known foreign body or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right great toe examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and swelling of the lateral nail fold with local tenderness to palpation and early ingrown nail appearance. Nail plate very short with curved edges. No fluctuance, pus, proximal paronychia, or spreading erythema onto the dorsum."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right foot neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Capillary refill under 2 seconds. Sensation intact. Dorsalis pedis and posterior tibial pulses palpable."
      }
    },
    {
