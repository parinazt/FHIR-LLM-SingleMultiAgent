    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Metformin"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "500 mg three times daily; often takes only twice daily and frequently misses the lunchtime dose at work. Advised to aim for at least twice daily with breakfast and dinner, and take the lunch dose if able."
          }
        ]
      }
    },
