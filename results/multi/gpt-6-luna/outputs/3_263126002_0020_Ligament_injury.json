        "code": {
          "text": "Right ankle strength"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 4+/5 in all planes, limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right ankle stability tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior drawer painful, with no obvious laxity compared with the left. Talar tilt mildly painful, with no clear laxity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Right ankle neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; dorsalis pedis and posterior tibial pulses palpable; capillary refill under 2 seconds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
