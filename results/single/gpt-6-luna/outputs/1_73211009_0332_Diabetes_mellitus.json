    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue and reduced energy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 6–8 weeks of increased fatigue, feeling as if wading through mud, and reduced energy, especially mid-afternoon; often nods off on the couch after work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep and sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps about 6 hours nightly with fragmented sleep, stays up late watching TV and has early starts, and wakes unrefreshed. Partner reports loud snoring and witnessed pauses in breathing; patient reports some morning headaches."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Weight history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports weight stable, possibly with a gain of a couple of kilograms since NAIDOC."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood a bit flat and irritable, attributed to tiredness; still enjoys grandchildren and community events; denies anhedonia and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
