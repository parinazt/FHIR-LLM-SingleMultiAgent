      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported nasal and upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 days: sneezing, nasal blockage, clear rhinorrhoea, and mild frontal pressure. Denies anosmia, purulent nasal discharge, facial swelling, and dental pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported post-pneumonia respiratory and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Respiratory symptoms improving; minimal non-productive cough. Denies shortness of breath at rest and pleuritic chest pain. Afebrile by home readings. Feels somewhat washed out and attributes this to poor sleep rather than systemic illness. Appetite reasonable; reports that everything tastes off since taking antibiotics."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Post-sepsis symptom screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Consciousness clear with no confusion. Denies presyncope, new severe headache, dizziness, and reduced urine output; reports passing normal urine volumes. Denies dysuria, rash, mottling, and new wounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported hospital symptoms and patient's view of recent illness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hospital discharge summary reportedly recorded fever and confusion during the recent admission. Patient disputes the sepsis diagnosis and describes the illness as a bad flu and dehydration."
      }
    },
