        "code": {
          "text": "Lower back and bilateral hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain, usually 5/10 and flaring to 7/10; worse with prolonged standing and walking more than 50–100 m, relieved by sitting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
