          "text": "Reported additional symptoms and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies haemoptysis, confusion, ear pain or discharge, sinus tenderness, severe headache, photophobia, and neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Possible symptom triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient queried whether symptoms may have been triggered by new scented washing powder or air conditioning at shops."
      }
    },
    {
