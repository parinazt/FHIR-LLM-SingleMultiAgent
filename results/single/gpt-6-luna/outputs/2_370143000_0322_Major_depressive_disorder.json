    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling really hopeless and helpless, useless, and like there is no point; ongoing low mood, anhedonia, poor motivation, reduced energy, poor concentration at work and home, guilt, and feeling a burden to her sister. Symptoms have been bad for a long time and may have worsened over the last few weeks; timeline is vague. Struggling to get out of bed and missing work shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; stays up late on phone and is sometimes awake until 4 am; wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Appetite and weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appetite is erratic, sometimes eating nothing all day then bingeing on junk food at night. Possible slight weight loss, uncertain; no recent weight recorded in the medical record."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and intent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal ideation: says it would not matter if she did not wake up. No active plan or intent today. No recent self-harm disclosed. Identifies her sister as support and says she would tell her or return if suicidal ideation worsened."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Self-harm history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Past superficial cutting, last more than 6 months ago per patient; chart contains a similar history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Psychotic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies voices, paranoia, and thought interference. No delusions or hallucinations reported or observed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin, casually dressed, mildly dishevelled, and in no acute distress; reduced eye contact and fidgety. Cooperative but vague historian with inconsistent dates. Speech normal in rate and volume, slightly slowed. Mood described as hopeless and 'just over it'; affect constricted, congruent, intermittently tearful. Thought form linear and ruminative, with no flight of ideas or derailment. Low self-worth, guilt, hopelessness, and passive suicidal ideation without plan; no delusions. Cognition grossly intact to person, place, and time, with patchy recent recall. Partial insight; acknowledges depression and impact of substances but minimises risk. Judgement concerning substance use and work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Physical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No focal neurological signs. Chest clear; heart sounds dual. No signs of acute intoxication or withdrawal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking 'a fair bit' after shifts, with minimal drinking on some nights and 'heaps' on others, sometimes unable to remember getting home. Previous AUDIT-C was high risk in chart. Denies morning drinking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Other substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports intermittent cannabis use to chill and occasional weekend party drugs, likely cocaine or MDMA; last use approximately 1–2 weeks ago. Vapes nicotine daily."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Suicide risk assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Assessed as low-to-moderate suicide risk today: passive suicidal ideation and multiple risk factors, but no plan or intent; supportive sister and willingness to follow up."
      }
    },
