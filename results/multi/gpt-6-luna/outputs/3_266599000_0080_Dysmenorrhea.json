        "valueString": "Well, in no apparent distress, and ambulant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Soft, non-distended abdomen with mild suprapubic and left lower quadrant tenderness on deep palpation. No rebound, guarding, masses, or organomegaly."
      }
    },
