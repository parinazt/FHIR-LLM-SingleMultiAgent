        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported ocular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral watering/epiphora for about 3 days, described as feeling like crying without crying; worse outdoors and in wind. Mild grittiness. Denies photophobia, visual loss, eye trauma, purulent discharge, contact lens use, known foreign body exposure, and headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported withdrawal-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased sweating, loose stools, abdominal cramps, yawning, rhinorrhoea, teary eyes, poor sleep, feeling wired, decreased appetite, and strong opioid craving."
      }
    },
