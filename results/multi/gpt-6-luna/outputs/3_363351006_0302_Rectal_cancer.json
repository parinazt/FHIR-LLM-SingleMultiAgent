        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cough for approximately 2–3 weeks, gradually worsening; mostly dry with occasional small amounts of clear/white sputum. Worse at night and on waking, disturbing sleep most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated respiratory and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath on exertion, described as puffing a bit more when walking to the letterbox. Denies pleuritic chest pain, wheeze, fever, chills, rigors, recent upper respiratory tract infection, orthopnoea, paroxysmal nocturnal dyspnoea, and leg swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
