        "code": {
          "text": "Worry and checking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports repeatedly checking her partner's location and messages, and worries that something bad will happen and he will not come home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
