        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Nicotine withdrawal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "When cutting down, reports irritability, anxiety, reduced concentration, and being snappy. Anxiety is worse when longer between cigarettes."
      }
    },
    {
