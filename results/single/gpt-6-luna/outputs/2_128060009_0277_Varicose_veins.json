    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right calf symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Red, tender cord over a known varicose vein, described as a lumpy rope under the skin; pain to 6/10 on walking with mild itch. Symptoms began 7/7 ago, initially increased over 2–3/7 and are now stable or slightly better, especially with elevation and PRN Panadol."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms and relevant history for right calf complaint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, cannulae or injections to the leg; no fevers, rigors, night sweats, chest pain, shortness of breath, palpitations or haemoptysis. No significant calf swelling away from the affected area and no groin or thigh pain. Mobility is slightly reduced, but she continues walking shorter distances."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right lower limb varicose veins and calf examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prominent tortuous varicose veins along the great saphenous vein territory bilaterally, right greater than left. Right medial calf, mid-to-distal third: 7–8 cm firm tender cord along a varicose vein, erythema band approximately 3 cm, warm, not fluctuant, no pus, skin intact. No palpable proximal extension to knee or thigh and no groin tenderness. Calf size approximately equal bilaterally; no generalised oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left lower leg and chronic venous skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Healed hyperpigmented scar at the left medial malleolus consistent with previous venous ulcer; mild pitting oedema at the ankle. Chronic venous skin changes bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Peripheral pulses and perfusion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsalis pedis pulses diminished bilaterally; posterior tibial pulses hard to palpate. Feet warm, capillary refill approximately 3 seconds. No rest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
