          "text": "Concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports decreased concentration at work, drifting off and getting stuck in thoughts; gross cognition intact, with some difficulty maintaining focus on longer questions."
      }
    },
