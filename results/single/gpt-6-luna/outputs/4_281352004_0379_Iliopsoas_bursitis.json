    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right groin and anterior hip pain, reported symptom"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vague onset, possibly a few weeks to a couple of months. Aching with intermittent sharp twinges, especially with hip flexion such as lifting the leg into a car, stairs, sit-to-stand, and putting on socks. Worse at the end of the day after standing or bending over low desks. Occasionally radiates into the anterior right thigh, not below the knee. Baseline severity about 5/10, up to 7/10 with movement. Some relief with rest, stretching, or heat pack; unsure which tablets may help. Still working but avoiding playground duty and finds sitting on the floor with children harder."
      }
    },
