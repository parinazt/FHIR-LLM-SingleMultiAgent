        "code": {
          "text": "Throat and nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throat mildly red; nasal mucosa a bit boggy; otherwise unremarkable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Bowel movement frequency and stool consistency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually has 1 stool daily or every 2 days on Movicol 1–2 sachets. For approximately 2 weeks, stool every 2–3 days and harder than usual, but still passing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No abdominal pain, distension, severe cramps, vomiting, overflow diarrhoea, or PR bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with mild stooly feel in the LLQ only; non-tender."
      }
    },
