        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right hemiscrotum enlarged and tense, not erythematous or hot, with mild diffuse tenderness, especially superiorly; transilluminates. Right testis difficult to palpate clearly; no discrete hard mass felt."
      }
    },
