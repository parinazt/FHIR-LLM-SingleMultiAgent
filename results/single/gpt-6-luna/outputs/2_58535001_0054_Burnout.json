    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person, place, and time. Well groomed, appears tired and mildly tense, intermittently impatient and checking phone regarding work messages. Speech normal in rate and volume, slightly pressured when discussing work. Mood described as 'exhausted and over it'; affect congruent with brief tearfulness when describing feeling of failing patients. Thought form coherent and logical; no delusions, hallucinations, or thought disorder. No suicidal ideation. Insight good and judgment intact. No psychomotor retardation or agitation on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
