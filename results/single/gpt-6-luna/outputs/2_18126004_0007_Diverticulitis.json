    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "LLQ abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull LLQ ache for 4–5 days, rated 5–6/10; similar to the last episode but milder, worse the day before review, and does not radiate. Worse with movement and when bowels are very full; some relief after a bowel movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bowel habit and stool features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alternating constipation and loose stools over one week. Stools are sometimes a bit narrower, but this is not persistent. Passing flatus. Denies PR bleeding and melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent nausea; no vomiting. Appetite slightly decreased but still eating. Possible fever and chills on days 1–2, with no temperatures recorded. Now feels 'off' but is coping with activities of daily living."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, flank pain, chest pain, and shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended. Local LLQ tenderness, mild to moderate. No guarding, rebound, generalised peritonism, or palpable mass. Bowel sounds normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
