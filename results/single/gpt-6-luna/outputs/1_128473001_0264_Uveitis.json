        "status": "final",
        "code": {
          "text": "Undilated fundoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited undilated examination. Discs sharp in both eyes; no obvious haemorrhage or exudates; maculae grossly normal; no clear retinal detachment."
      }
    },
