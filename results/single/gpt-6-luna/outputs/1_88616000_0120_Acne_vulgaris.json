    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Facial acne examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few closed comedones and few small inflammatory papules; no nodules or cysts. Multiple erythematous/light-brown post-inflammatory macules and mild early shallow atrophic scars on both cheeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Upper back acne examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few papules and macules on the upper back; no infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Hirsutism and virilisation examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious hirsutism or virilisation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual cycle frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cycles currently approximately every 35–45 days; previously every 60–90 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Acne symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acne since late teens, worse over the last 2–3 years, affecting the face and sometimes the upper back. Fewer new pimples with topical treatment; occasional small pustule around menstruation. No painful nodules or cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Patient-reported acne marks and scarring concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Main concern is red marks and small scars on the cheeks and jaw; worried they may be permanent and reluctant to take strong tablets."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Topical adapalene tolerability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially used nightly and developed dryness/peeling during the first 2 weeks, then reduced use to alternate nights. Now tolerating treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and body image"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A bit self-conscious and avoids photos on bad acne days, but continues university and work. Denies low mood and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "PCOS history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "PCOS diagnosed at age 19 with oligo-ovulation, polycystic ovaries on ultrasound, and increased androgens in the past."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Current sexual activity and pregnancy plans"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not sexually active currently; no pregnancy plans in the next 12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used at night approximately 5 nights per week.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Benzoyl peroxide 2.5% wash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used in the morning.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to all affected areas, not only individual spots. Use on alternate nights for 1 week, then nightly as tolerated.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
