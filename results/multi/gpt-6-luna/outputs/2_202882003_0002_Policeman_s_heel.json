    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left heel pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for about 3–4 weeks at the anteromedial calcaneus, described as like standing on a stone. Worse with the first steps in the morning, after long periods sitting in a patrol car, long shifts, foot patrol, and heavy boots. Eases after 10–15 minutes of walking, then becomes a dull ache by the end of the shift. No specific injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
