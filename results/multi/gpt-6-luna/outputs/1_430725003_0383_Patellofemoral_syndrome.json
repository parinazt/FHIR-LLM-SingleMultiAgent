    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left anterior knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset approximately 6–8 months ago, without injury; aching behind and around the kneecap, sometimes a sharp jab with squats. Worse on stairs, especially descending, deep squats, and sitting more than 30–40 minutes. Better with standing or walking on flat ground."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left knee locking, giving way, swelling, and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true locking, giving way, or big swelling; no fevers, weight loss, or night pain reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
