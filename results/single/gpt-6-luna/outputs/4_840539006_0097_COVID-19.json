        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath at rest, orthopnoea, PND, chest tightness, pleuritic chest pain, haemoptysis and stridor; denies blue lips or face."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
