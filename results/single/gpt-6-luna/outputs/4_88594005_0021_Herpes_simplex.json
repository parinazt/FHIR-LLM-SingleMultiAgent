        "code": {
          "text": "Eye findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No visual change, eye pain or discharge reported. Eyes clear, with no conjunctival injection or periocular vesicles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
