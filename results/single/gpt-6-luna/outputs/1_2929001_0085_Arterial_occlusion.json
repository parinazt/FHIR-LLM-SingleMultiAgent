        "code": {
          "text": "Right great toe lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Early shallow fissure at the tip of the right great toe; no purulence or surrounding cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
