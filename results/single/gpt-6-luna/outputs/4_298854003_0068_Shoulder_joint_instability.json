        "code": {
          "text": "Recurrent left shoulder instability, likely atraumatic/multidirectional; currently symptomatic with increased near-subluxation episodes associated with manual overhead work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder instability symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known recurrent atraumatic left shoulder instability since the late teens, with multiple subluxation or near-subluxation events."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Near-subluxation episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 6 weeks, two near-subluxation episodes while reaching out to the side to grab materials; patient had to hold the arm and slowly bring it back. No complete dislocation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline ache 2–3/10 after long workdays, up to 6/10 after a near-subluxation episode; settles with rest and ibuprofen as needed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Left shoulder pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No night pain, rest pain, neck pain, hand paraesthesia, or hand weakness reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Red flag and trauma screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent high-energy trauma, fevers, weight loss, true locking or catching, or acute loss of range of motion. No complete dislocation requiring reduction in the last 12 months; last complete dislocation was approximately 3 years ago during social football."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder active elevation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports active elevation to more than 160 degrees, with apprehension or looseness around the mid-range of abduction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder functional internal and external rotation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Functional internal and external rotation were not fully assessable by telehealth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left shoulder strength and stability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gross functional strength preserved for light activities by patient report, without subjective weakness; patient reports reduced control/stability and a wobbly feeling, especially overhead and with the arm abducted and externally rotated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left hand grip and sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grip reported as okay and hand sensation reported as normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Left shoulder appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No visible deformity, swelling, redness, or bruising reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neck movement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain with self-movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Telehealth general appearance and respiratory status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, speaking in full sentences; no audible shortness of breath or distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Work and activity limitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Continuing full-time work with self-modified duties, less overhead lifting, and more breaks; avoiding overhead lifting of plywood and other heavy or awkward loads where possible. Avoiding football and gym overhead press. Activities of daily living are okay, but patient is cautious with sport and heavy loads."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Telehealth consultation engagement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Talkative and tangential, requiring repeated redirection; cooperative and engaged with the plan, and verbalised understanding of rehabilitation focus and work modifications."
      }
    },
