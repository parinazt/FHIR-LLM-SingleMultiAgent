    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Cognitive and functional changes reported by husband"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual decline over 6–9 months with increased repetition, sometimes unsure of day or date, needs prompting for medications and meals, and needs help with finances and complex instrumental activities of daily living. Basic activities of daily living remain intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
