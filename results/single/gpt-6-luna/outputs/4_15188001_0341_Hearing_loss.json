        "status": "final",
        "code": {
          "text": "Bedside hearing assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Conversational voice at 1–2 m with hearing aids in; occasional repetition needed, especially with corridor noise. Whisper test less reliable due to anxiety and background noise. Overall picture consistent with known bilateral sensorineural hearing loss; no obvious asymmetry."
      }
    },
