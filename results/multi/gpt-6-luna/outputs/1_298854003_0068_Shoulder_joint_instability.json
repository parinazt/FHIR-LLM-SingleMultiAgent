        "code": {
          "text": "Near-subluxation episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two near-subluxation episodes while reaching out to the side to grab materials; the patient had to hold the arm and slowly bring it back. No complete dislocation reported during these episodes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
