    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left breast ultrasound finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ultrasound approximately 6 weeks ago showed a simple anechoic cyst in the left upper outer quadrant with a thin wall and no solid components; no abnormal axillary nodes. Right breast reported as having no abnormality."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left breast cyst size"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueQuantity": {
          "value": 9,
          "unit": "mm"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left breast ultrasound BI-RADS category"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "BI-RADS 2"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Left breast discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports intermittent mild ache or twinge around the area, especially premenstrually; it settles with simple analgesia and warm packs. Patient denies current severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Breast and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies nipple discharge, skin change, new lumps, weight loss, night sweats, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Patient-reported change in perceived breast lump"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports daily palpation and sometimes feels the area is bigger; patient notes that its perceived size varies with the menstrual cycle and how hard she presses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Cancer-related worry and checking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports marked worry that the breast cyst could be cancer, repeated reassurance-seeking about further tests, and spending hours online reading about breast cancer and cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep and mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is mildly impacted by rumination. No depressive features were volunteered today; no suicidal ideation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reports feeling generally tired and wonders whether this may relate to a hormone imbalance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, alert, and in no apparent distress; normal colour with no obvious pallor or jaundice."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Respiratory appearance on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with no audible wheeze or shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Affect and speech on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious and tearful at times when discussing cancer; speech clear and coherent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Breast examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Breast examination was not possible by video."
      }
    },
