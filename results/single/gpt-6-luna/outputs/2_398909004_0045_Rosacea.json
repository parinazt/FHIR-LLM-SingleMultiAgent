          "text": "Metronidazole 0.75% gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue applying to central face twice daily, aiming for a total course of 8–12 weeks; may then step down to as needed.",
