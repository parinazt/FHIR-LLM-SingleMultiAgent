        },
        "valueString": "No scalp, temporal, or sinus tenderness. No visual complaints."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and dryness on the dorsum of the hands and between the fingers; no fissuring, ooze, or crusts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
