        "code": {
          "text": "Right lateral epicondylitis / common extensor tendinopathy, chronic and stable; work-related overuse contributing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right lateral elbow pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for approximately 5–6 months, plateaued over the last 4–6 weeks. Worse with lifting and twisting, including checkout work and handling a kettle or saucepan. Intermittent night pain and brief morning stiffness. No trauma, locking, giving way, paraesthesia, or neck/shoulder symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right elbow examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No swelling, redness, or warmth. Focal tenderness at the lateral epicondyle/common extensor origin. Full range of motion; pain at end-range wrist extension with elbow extended. Pain with resisted wrist extension and middle-finger extension. Power, sensation, and pulses normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right elbow ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Common extensor tendinopathy with a small intrasubstance tear less than 3 mm. No effusion, erosions, or features of inflammatory arthropathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Topical diclofenac gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply over the lateral elbow four times daily as needed",
            "route": {
              "text": "topical"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    }
