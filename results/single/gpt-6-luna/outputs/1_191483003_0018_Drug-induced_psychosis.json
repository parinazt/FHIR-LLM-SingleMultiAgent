          "text": "Mood, sleep, and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports stress about work and money but says he is not depressed. Sleeping 7–8 hours; appetite is okay."
      }
    },
    {
