        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower-limb power, reflexes, and sensation grossly normal; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding hypersomnolence; patient says she could nap pretty much any time, anywhere. Partner reportedly says she nods off on the couch and at work. Patient minimises the concern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Sleep schedule and restorative quality"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually in bed around 10–11 pm and gets up at 6–6:30 am; wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reported periodic limb movements during sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a sleep study approximately 2 years ago with a private sleep specialist in Sydney identifying periodic limb movements; no records available in the current practice and no treatment. Patient reports kicking during sleep, disturbing her partner."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Sleep-related negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring or apnoeas. Patient denies cataplexy, sleep paralysis, and hallucinations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Sleepiness while driving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drives short distances and reports feeling drowsy a lot and zoning out at red lights; denies actually falling asleep while driving. Partner, not present, is reportedly worried about daytime sleepiness and driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Mood and cognitive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low motivation, fatigue, poor concentration, and feeling foggy. Denies current suicidal ideation."
      }
    },
