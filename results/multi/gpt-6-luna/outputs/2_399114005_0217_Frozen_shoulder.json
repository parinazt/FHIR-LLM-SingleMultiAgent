        },
        "valueString": "Heart sounds dual with no added sounds. Lungs clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Left shoulder examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or swelling. Diffuse anterolateral tenderness. Globally decreased active and passive range of motion, especially external rotation and abduction; painful at end range. Internal rotation also decreased. No focal bony tenderness over the clavicle, ACJ, or humeral head."
      }
    },
