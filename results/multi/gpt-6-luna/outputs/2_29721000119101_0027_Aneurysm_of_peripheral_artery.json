    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Subjective fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling feverish for 2–3 days; home thermometer was described as “flat”; no home temperature reading reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Chills and night sweats"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports chills and feeling “hot and cold all night” for 2–3 days, waking with a soaked shirt. Wife reports he has been sweaty for the last 2 nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Aches and fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling “achy and washed out.” Wife reports he has been “off his food” and “not himself.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Frontal headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Appetite and nausea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased appetite and some nausea; denies vomiting and diarrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right posterior knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over approximately the last week, reports increased ache behind the right knee at the site of a known popliteal aneurysm. Describes dull baseline pain with occasional sharp stabbing pain on walking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right leg swelling and warmth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks the area behind the right knee might be a bit puffier than usual and feels warmer than the other leg. No obvious redness reported; denies trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath on exertion over the past few days; reports “puffing more coming up the stairs.” Denies chest pain, orthopnoea, paroxysmal nocturnal dyspnoea, cough, sore throat, and rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Urinary and flank symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, and flank pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Potential exposure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies recent dental work, skin infections, and sick contacts. Patient wondered whether symptoms might relate to “dodgy mince” or tank water that had been tasting “a bit funny”; gastrointestinal symptoms described as minimal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and orientation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On limited video examination, alert and orientated; appears unwell but not toxic. Face slightly flushed, with no obvious pallor or cyanosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Respiratory rate"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visually estimated at approximately 18–20 breaths per minute on video; unlaboured. No audible wheeze or cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Speech and apparent confusion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech coherent; no obvious confusion on video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Mobility and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to stand and walk a few steps; gait mildly antalgic, favouring the right leg, but stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Video appearance of right leg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Area behind right knee appears slightly fuller than the left on camera. Size, pulsatility, and warmth difficult to assess because of poor lighting and video quality. No obvious erythema or skin breakdown seen."
      }
    },
