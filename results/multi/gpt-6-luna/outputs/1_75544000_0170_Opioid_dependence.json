        "status": "final",
        "code": {
          "text": "Associated withdrawal symptoms reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased sweating, loose stools, abdominal cramps, yawning, rhinorrhoea, teary eyes, poor sleep, feeling “wired”, decreased appetite, and a strong craving for opioids."
      }
    },
    {
