          ]
        },
        "code": {
          "text": "Inframammary intertrigo, chronic and recurrent, mild-to-moderate; possible candidal etiology"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Patient-reported inframammary rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash under the breasts on and off for months, worse over the last 2–3 weeks; itchy, burning, red and moist, with slight odour when worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported rash triggers and alleviating factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with heat, sweating, wearing a bra all day, and gardening; improves when the area is aired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, rigors, spreading erythema, pus, or systemic symptoms. No groin or perianal rash currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General appearance on limited video examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, in no acute distress, speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Inframammary skin examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral inframammary folds with erythematous, macerated, well-demarcated plaques and possible satellite papules. No obvious ulcer, pus, or clear cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "As needed; dose and route not stated",
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "stopped",
        "medicationCodeableConcept": {
          "text": "Unspecified antifungal cream (described as a white tube)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Used for about 1 week approximately 6 months ago, then stopped; the rash recurred."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Clotrimazole 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to affected areas twice daily for at least 2 weeks and for a few days after the rash has resolved.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
