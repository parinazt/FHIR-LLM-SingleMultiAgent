          "text": "Reported right leg symptoms and function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased pain and swelling in the right leg over the past few days, mild limp due to pain, and reduced tolerance for prolonged walking, standing, and heavy work."
      }
    },
