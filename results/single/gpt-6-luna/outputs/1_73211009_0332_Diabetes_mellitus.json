        "code": {
          "text": "Diabetes symptoms and home blood glucose"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies increased polyuria or polydipsia beyond baseline and denies hypoglycaemia. Checks blood glucose infrequently, about twice weekly; usual fasting readings 7–10. No insulin use."
      }
    },
