    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right hip and groin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No erythema, swelling, or deformity. Marked deep femoral triangle/iliopsoas-region tenderness just distal to the inguinal ligament. No greater trochanter or lateral hip tenderness and no inguinal lymphadenopathy. Flexion limited by pain to approximately 90–100 degrees, with pain on active and passive movement. Internal rotation mildly limited with discomfort; external rotation and extension nearly full, with mild pain at extremes. Resisted hip flexion painful; psoas sign positive. FABER causes mild groin pain without SI joint pain."
      }
    },
