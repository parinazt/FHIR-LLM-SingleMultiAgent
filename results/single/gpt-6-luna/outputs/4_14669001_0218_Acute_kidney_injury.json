    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports being more tired over the last few days and needing more rests; still doing activities around the house and yard."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Oral intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eating a bit less but still having 2–3 small feeds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Ascites and abdominal tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports abdomen is still large from fluid and may be a touch tighter than last month, though he is unsure and thinks he may be overthinking it. No sudden large increase in girth. Abdomen described as tight but not really painful; no suggestion of severe tenderness or rebound."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Ankle swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ankles are about the same as usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Urine output"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels he may be urinating less, especially in the mornings, but is not measuring output and is definitely not anuric; output is not objectively known and is clearly greater than complete oliguria by history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria and haematuria; urine colour unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Fluid intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking approximately 1.5 L/day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Respiratory and chest symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clear shortness of breath or chest pain; no breathlessness at rest. Speaking in full sentences by phone, with no audible shortness of breath or cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers or rigors, black or bloody stools, haematemesis, new bruising, and epistaxis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Confusion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no new confusion; wife says he is about the same and is keeping an eye on him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
