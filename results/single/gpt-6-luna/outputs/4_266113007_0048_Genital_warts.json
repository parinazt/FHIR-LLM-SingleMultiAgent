        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Imiquimod 5% cream (Aldara)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to visible warts at night 3 times per week (e.g. Monday, Wednesday, Friday); wash off 6–10 hours later. Use up to 16 weeks or until clearance. If marked irritation occurs, reduce frequency or pause.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "wk"
              }
            }
