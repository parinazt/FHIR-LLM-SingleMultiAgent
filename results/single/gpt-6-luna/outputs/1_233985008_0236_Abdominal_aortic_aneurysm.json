        "status": "final",
        "code": {
          "text": "Current abdominal aortic aneurysm symptoms and stability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known aneurysm; no acute severe abdominal or back pain and no collapse. Haemodynamically stable. No sudden severe pain, hypotension or collapse reported today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
