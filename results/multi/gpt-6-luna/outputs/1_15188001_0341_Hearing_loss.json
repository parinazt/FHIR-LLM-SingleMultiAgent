        "code": {
          "text": "Reported possible upper respiratory symptom triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient queried whether new scented washing powder or air conditioning at shops may be a trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported hearing change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding bilateral hearing loss with hearing aids; patient says hearing has gone down another notch and the television is louder. Feels hearing is worse with the current head cold and more blocked when the nose is congested."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported hearing-associated negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies unilateral symptoms, sudden hearing loss, vertigo, new tinnitus, ear fullness, and otalgia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported hearing aid use and maintenance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses bilateral behind-the-ear hearing aids; last audiology approximately 2 years ago. Cleans the aids herself, sometimes forgets to wear them because they whistle with grandchildren, and has had no recent ear wax removal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bedside hearing assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Conversational voice heard at 1–2 m with hearing aids in; occasional repetition needed, especially with corridor noise. Whisper test less reliable due to anxiety and background noise. Overall picture consistent with known bilateral sensorineural hearing loss, with no obvious asymmetry."
      }
    },
