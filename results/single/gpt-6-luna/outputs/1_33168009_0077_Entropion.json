        "code": {
          "text": "Vision reported by telephone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vision reported as unchanged from baseline; can read paper with glasses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies pus, photophobia, significant or acute reduced vision, severe pain, trauma, contact lens use, flashes or curtain, and systemic symptoms. Reports no lid swelling or discharge."
      }
    },
    {
