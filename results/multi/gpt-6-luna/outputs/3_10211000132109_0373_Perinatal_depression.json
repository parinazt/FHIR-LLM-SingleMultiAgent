        "status": "final",
        "code": {
          "text": "Intrusive thoughts and images of harming baby"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports intrusive, ego-dystonic images of harming the baby, including on stairs and smothering. Patient is very distressed by the images, states “I’d never do it,” has no plan or intent to harm the baby, and avoids being alone with the baby."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
