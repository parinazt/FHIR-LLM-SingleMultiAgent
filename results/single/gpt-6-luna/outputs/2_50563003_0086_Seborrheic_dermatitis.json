        "medicationCodeableConcept": {
          "text": "Ketoconazole 2% shampoo"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Use twice weekly; leave on for 3–5 minutes, then rinse. Use gentle non-perfumed shampoo on other days.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
