        "code": {
          "text": "Pityriasis alba of the face with mild dermatitis and post-inflammatory hypopigmentation"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for approximately 10 days, still less than 2 weeks in duration. Began after a URTI-type illness; worse in the evenings and when talking a lot at work under air conditioning. Patient is unsure whether iced coffee or air conditioning is a trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated respiratory and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, wheeze, chest tightness, pleuritic chest pain, fever, chills, or haemoptysis. Appetite is okay; energy is slightly decreased. Patient continues attending university and work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Recent upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sore throat and blocked nose after a URTI-type illness, mostly resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Facial skin symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hypopigmented patches on the cheeks for approximately 3–4 months, more obvious after tanning over summer. Mild intermittent itch, especially after hot showers, with some dryness and flaking. No pain, bleeding, or vesicles. Patient is worried about vitiligo and has been scrubbing the face with exfoliant, which now stings."
      }
