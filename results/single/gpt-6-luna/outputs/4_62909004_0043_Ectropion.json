    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Several months of increased clear tearing, left greater than right, worse outdoors and in wind; mild gritty/sandy sensation, especially at the end of the day; occasional mild morning crusting. No significant pain, photophobia, decreased visual acuity, diplopia, flashes, floaters, curtain, trauma, foreign body, or contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Obvious left lower lid ectropion with punctum not apposed; mild inferior left conjunctival injection and clear tearing; mild erythema/dermatitis of the left lower lid from wiping. No periorbital swelling, lacrimal sac tenderness, or warmth. Cornea clear on torch examination with no obvious ulcer or abrasion. PERRL, no RAPD, extraocular movements full and non-painful. Right eye with mild age-related changes only. No red flag features today; no evidence of keratitis, dacryocystitis, or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
