        "code": {
          "text": "Cardiovascular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no chest pain, tightness, jaw pain, or arm pain. Reports no shortness of breath at rest, orthopnoea, paroxysmal nocturnal dyspnoea, or ankle swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bilateral calf discomfort with walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Calf discomfort in both legs after approximately 2 blocks of walking, relieved by rest; described as 'same as always.' No rest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Foot symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no foot ulcers, skin breakdown, or colour change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no recent TIA symptoms, unilateral weakness, facial droop, speech disturbance, visual loss, or acute imbalance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline mild exertional dyspnoea, stable. No cough, increased sputum, fever, or infective symptoms. No recent exacerbations or hospitalisations in the last 12 months. Uses salbutamol once or twice a week, mainly with exertion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Nocturnal breathing symptom"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps in a recliner because the bed is 'no good for my back'; denies nocturnal shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and orientated, speaking in full sentences, looks well, and has no acute distress. Mild tobacco odour; somewhat impatient on the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no added sounds or murmur. JVP not elevated. No peripheral oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Peripheral vascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Radial and femoral pulses palpable. Dorsalis pedis and posterior tibial pulses decreased but present bilaterally. Feet warm; capillary refill approximately 3 seconds. No ulcers, gangrene, or tissue loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest mildly hyperinflated. Decreased breath sounds with scattered expiratory wheeze bilaterally. No crackles or accessory muscle use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Neurological screening examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Face symmetrical, speech fluent, power 5/5 in upper and lower limbs, and gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Smoking status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Current smoker, 5–8 cigarettes per day; long-term history, previously up to 20 cigarettes per day. Says he has cut down and is not ready to quit."
