        "code": {
          "text": "Focused skin examination of thighs and buttocks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mostly post-inflammatory marks with a few faint follicular papules. No pustules or boils, no cellulitis, and no groin or genital involvement."
