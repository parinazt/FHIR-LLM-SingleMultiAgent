        "medicationCodeableConcept": {
          "text": "Ferro-grad C 325 mg (105 mg elemental iron + vitamin C)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet orally each morning. Take away from tea, coffee, and dairy where possible; may take with a small amount of food if gastrointestinal upset occurs. If daily dosing is poorly tolerated, may trial alternate-day dosing and inform the clinician. Continue for at least 3 months after haemoglobin normalises, then a further 3 months to replenish stores; total duration approximately 3–6 months depending on results.",
            "route": {
              "text": "oral"
            },
            "timing": {
