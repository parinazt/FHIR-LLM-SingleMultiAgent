    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported rash and pruritus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly itchy red patches on the upper chest and upper back for approximately 10–14 days. Mild intermittent pruritus is worse with heat and sweat; over-the-counter aloe provides partial relief. New scented laundry detergent started approximately 3 weeks ago; patient also reports dry, dusty air conditioning at work as a possible trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple poorly demarcated erythematous maculopapular patches, 1–3 cm, on the upper anterior chest and upper back, with mild excoriations. No scale, vesicles, target lesions, purpura, or nodules. No facial or oral involvement. Appearance described as consistent with mild irritant/contact or heat dermatitis; not consistent with SJS, TEN, vasculitis, or malignant rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
