    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 2 weeks, gradual onset, central low lumbar and slightly right-sided; dull ache, sometimes sharp with bending; up to approximately 6–7/10 if pushed, usually described as annoying. Worse after long periods at a desk and lifting shopping. Stiff for the first 10–15 minutes in the morning, then eases. Patient suspects a new office chair or sleeping awkwardly on a couch. Still working part-time and avoiding heavier jobs at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain associated negative symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg pain, pins and needles, weakness, bowel or bladder change, saddle numbness, fevers, weight loss, night sweats, and trauma."
      }
    },
