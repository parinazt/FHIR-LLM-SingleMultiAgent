    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Upper abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3 weeks: intermittent mild-to-moderate upper abdominal queasy/tight discomfort, mainly epigastric, with nausea and no vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Motion-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms are worse in a car, especially on rough or unsealed roads; reports feeling sweaty and “crook in the guts” after 20 minutes on dirt roads. Symptoms sometimes occur on the school bus and are worse when reading or using a phone in the car. No clear food trigger. Patient describes this as different from usual vestibular migraine: more like the stomach turning, not spinning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No GORD symptoms, change in bowel habit, rectal blood, melaena, weight loss, fevers, or urinary symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vertigo and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vertigo is stable, mild, and occurs 1–2 times per month. Tinnitus is stable. No new neurological symptoms or hearing loss."
      }
    },
