    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks tired but comfortable"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central low lumbar pain, slightly to the right, gradual onset about 2 weeks ago. Dull ache, sometimes sharp with bending; up to approximately 6–7/10 when pushed, but mostly annoying. Worse after long periods at a desk and lifting shopping. Slight morning stiffness for 10–15 minutes that eases. Patient thinks it may relate to a new office chair or sleeping awkwardly on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Back pain-associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg pain, pins and needles, weakness, bowel or bladder changes, saddle numbness, fevers, weight loss, night sweats, and trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild right lumbar paraspinal tenderness; no midline tenderness. Slightly reduced flexion with pain, but able to move in all directions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Lower limb neurological and gait examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Straight leg raise negative bilaterally. Lower limb power, reflexes, and sensation grossly normal. Gait okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding hypersomnolence. Patient says, “I could nap pretty much any time, anywhere,” and feels drowsy a lot. Partner reportedly says she nods off on the couch and at work and is worried about the daytime sleepiness; patient minimizes the concern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sleep pattern and refreshment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually in bed around 10–11 pm and gets up around 6–6:30 am; wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported periodic limb movements during sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a sleep study with a private sleep specialist about 2 years ago identified periodic limb movements; records are not available. Reports kicking during sleep, which disturbs her partner. Not on treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Other sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reportedly reports no snoring or apnoeas. Patient denies cataplexy, sleep paralysis, and hallucinations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Drowsiness while driving"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drives short distances and admits feeling drowsy a lot; has zoned out at red lights but denies actually falling asleep while driving. Partner is concerned about driving risk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Mood and cognitive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low motivation, fatigue, poor concentration, and feeling “foggy.” Denies current suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Functional impact of back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working part-time and avoiding heavier jobs at home."
      }
    },
