        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Air entry clear bilaterally with no added sounds. Mildly increased respiratory rate, no respiratory distress, no obvious Kussmaul breathing; patient reports breathing a bit deeper."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
