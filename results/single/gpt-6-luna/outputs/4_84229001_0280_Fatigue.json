    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased tiredness for approximately 3–4 months, most days, more wiped out than usual, dragging herself through the day and often needing to lie down after work. Worse after late or long shifts, especially nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep pattern and sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps 5–6 hours on work nights and 7–8 hours on days off. Trouble winding down after night shifts and uses phone in bed. No known snoring or apnoeas (lives alone); denies waking short of breath and morning headaches."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild tension-type headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Postural light-headedness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional postural light-headedness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported cardiopulmonary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath at rest, chest pain, palpitations, oedema, fevers, night sweats, rigors, cough, and haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Weight change and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Weight described as stable, possibly down 1–2 kg; attributes this to skipped meals."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Mood and anhedonia symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels a bit flat and snappy after night shifts. Denies persistent low mood, anhedonia, and suicidal ideation. Still enjoys social time when not too tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Work and physical activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works full time as a registered nurse on a rotating roster with frequent overtime and double shifts. Exercise has decreased from four times weekly to 1–2 times weekly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "High caffeine intake from coffee and energy drinks during night shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Relevant reported medical history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports pulmonary tuberculosis approximately five years ago overseas and completing six months of treatment; no issues or respiratory symptoms since. Reports low iron in the past. No known diabetes, thyroid disease, HIV, hepatitis, or autoimmune disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
