        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest expansion symmetrical. Clear vesicular breath sounds; no wheeze, crackles, or rubs. Percussion resonant."
      }
    },
    {
