          "text": "Gastrointestinal symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nocturnal diarrhoea, PR blood, melaena, weight loss, fevers, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
