    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for approximately 10 days, initially on the flexor forearms and now with a few patches on the anterior neck and upper chest; mild-to-moderate itch, worse in the evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Rash associated findings and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blistering, weeping, pus, or mucosal involvement. No new medications. Reports a new natural laundry liquid about 2 weeks ago and burning inexpensive incense at home. No history of eczema or psoriasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Forearm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Scattered 1–3 cm erythematous patches/thin plaques on flexor forearms with mild dry scale and some excoriations; no vesicles, pustules, or signs of infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anterior neck and upper chest skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few small erythematous papules/patches; no target lesions or urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3–4 weeks, loose stools on 3–4 days per week, up to 3–4 times daily, with bloating and crampy lower abdominal pain, after increased intake of apples, fruit juice, muesli bars, and other fructose-containing foods. Patient reports symptoms settle when eating better."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Bowel symptom red flags and relevant history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rectal blood or mucus, weight loss, fever, or nocturnal diarrhoea. No recent antibiotics or travel."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild bloating and mild left lower quadrant greater than right lower quadrant tenderness; no peritonism or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Brief mental health screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes feeling 'just exam stress'; no red-flag mood symptoms on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply thinly to affected areas twice daily for 5–7 days, then as needed in short courses.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
    {
