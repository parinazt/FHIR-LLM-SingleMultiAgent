    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck and right arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain radiating down the right lateral arm to the thumb and index finger for approximately 4 months. Initially worse, then partially decreased, now increased again over the last 2–3 weeks, especially at night and keeping her awake most nights. Shooting and burning neuropathic pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right hand sensory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pins and needles in the right thumb and index finger, with occasional numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right hand functional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports dropping things with the right hand a few times over the last month and intermittent subjective weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Aggravated by looking down at phone, hanging washing, and long drives. Heat pack, rest, naproxen, and amitriptyline helped. Patient stopped all medications 2 weeks ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Associated symptom and red flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No left-sided symptoms, gait disturbance, limb heaviness, saddle symptoms, bowel or bladder incontinence or retention, bilateral symptoms, Lhermitte symptom, fine motor decline, weight loss, fevers, night sweats, or trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
