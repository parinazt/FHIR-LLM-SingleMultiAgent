    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Rash symptoms and history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for 4 days: red papular rash on anterior neck and upper chest, with a few spots on upper back/bra line. Patient reports it started the day she wore a new top, which felt scratchy. Possible triggers noted: new washing powder and new synthetic work blouse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Rash-associated negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, shortness of breath, facial or tongue swelling, or blisters. Examination: no vesicles, weeping, infection, or mucosal/facial involvement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous papules/plaques on anterior neck and upper chest, with a few on upper back."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neck pain for approximately 3 months, worse over the last 2–3 weeks. Bilateral lower cervical spine/upper trapezius ache and stiffness with a 'knot' feeling, rated 4–6/10 and worse at the end of the workday. Works long hours at a computer and leans forward."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Neck pain associated negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No arm pain, paraesthesia, weakness, headache, trauma, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Cervical and upper trapezius examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender paracervical and upper trapezius muscles; no midline cervical spine tenderness. Range of motion decreased only at extremes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Upper limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Upper limb power 5/5, reflexes normal, sensation intact."
      }
    },
