      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left lower leg pain and tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports tight, severe pain in the left shin/calf after approximately 20–30 minutes of fast walking, heavy work, or stairs. It settles after approximately 15 minutes of rest and leg elevation. No pain at rest currently, but reports a little tightness after a busy week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies numbness, weakness, colour change, fever, trauma, redness, and wounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Left lower leg and neurologic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Walking well in the room. No obvious swelling, erythema, or deformity at rest. Compartments soft; mild tenderness over the anterior tibial area only. Full ankle and toe range of motion, power 5/5, sensation intact, dorsalis pedis and posterior tibial pulses palpable, capillary refill under 2 seconds. Neurologic examination grossly non-focal. No features of acute compartment syndrome currently."
      }
    },
