    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Atraumatic anterior/medial ache, onset 2–3 days ago after getting up from a desk; especially painful on stairs after sitting then standing, approximately 3/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right knee function and reported examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full weight bearing and walking okay; avoiding gym. Patient reports full flexion/extension, near-full squat with mild anterior discomfort, and ache only when hopping on the right leg. Knee reported visually normal without deformity or obvious effusion; no video inspection was performed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated and denied right knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma, twisting, fall, blow, pop, swelling, redness, warmth, locking, giving way, catching, true instability, fever, night sweats, weight loss, night pain, calf pain, shortness of breath, and pleuritic chest pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fluctuating pruritus ani for approximately 6–8 months, worse in the evenings, after bowel movements, with sweating and stress. Reports overcleaning with soap, loofah and fragranced wipes; scratches especially at night and is sometimes sore. OTC haemorrhoid cream provided minimal benefit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated and denied anal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies blood on toilet paper, prolapse, mucus, significant pain, perianal discharge, blisters or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels 1–2 times daily, usually formed and occasionally slightly loose when anxious. Denies true diarrhoea, constipation or straining."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
