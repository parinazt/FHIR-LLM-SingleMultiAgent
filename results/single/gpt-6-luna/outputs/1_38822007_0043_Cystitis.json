            }
          ]
        },
        "code": {
          "text": "History of intermittent flexural dermatitis in teenage years"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dysuria described as burning with urination; increased frequency every 1–2 hours; urgency with small volumes; suprapubic discomfort. Symptoms reported for 3–4 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Urinary and systemic symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, chills or rigors, flank pain, nausea or vomiting, haematuria, or incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Rash history and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2 days, erythematous rash over suprapubic area and groin along underwear line, described as stingy with mild itch and worse after hot showers. Began after a change in washing powder about 1 week ago; pubic area shaved with a disposable razor 3 days ago. Patient strongly links symptoms to detergent and 'chlorine' in hospital water."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Video skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief, limited video view showed poorly demarcated erythema over suprapubic area along underwear/shaving zone. No obvious vesicles, pustules, ulcers, or cellulitis seen on video; examination limited by camera and lighting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-performed abdominal and flank examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient self-palpated mild suprapubic tenderness. Patient-performed flank percussion elicited no costovertebral angle tenderness. Clinician unable to perform a full abdominal examination by telehealth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported gynecological and mucosal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vaginal discharge, odour, or itch; no postcoital bleeding, abnormal vaginal bleeding, or deep dyspareunia. No mucosal involvement reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, chills, rigors, or weight loss. Appeared well and adequately hydrated on video, alert and oriented, speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Menstrual and pregnancy information"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "LMP reported as 10/7 ago; regular periods while taking COCP. Patient is not trying to conceive; pregnancy considered low likelihood."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Intermittent headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reported intermittent tension-type headaches on night shifts; not explored fully during this consultation."
      }
    },
    {
