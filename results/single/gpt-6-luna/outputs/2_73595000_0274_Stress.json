    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low mood and related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased tearfulness, withdrawal, low motivation, fatigue, and feeling useless on days off when too tired to see people. Reports feeling like a burden to others."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep, worse after late and night shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Weight change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports some weight loss, a few kilograms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and safety assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal thoughts most days, including thoughts that others would be better off without her. Denies plan, intent, and preparatory behavior. No past suicide attempts. Says she would call her mother or go to the ED if she felt unsafe."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks tired, in scrubs, tearful but cooperative. Speech normal. Mood described as “stressed, guilty”; affect low but reactive. Thought content includes worthlessness, feeling a burden, and passive death wishes only. Thought process logical. No psychotic features."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Manic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No mania reported."
      }
    },
    {
