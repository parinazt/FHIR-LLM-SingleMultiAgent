          "text": "Negative associated ear and related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No otorrhoea, marked hearing loss, vertigo, tinnitus, fever, recent upper respiratory infection, dental pain, jaw trauma, or recent flying, diving, or swimming."
      }
    },
