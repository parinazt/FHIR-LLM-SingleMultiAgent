    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent viral illness and current symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Seen 5 days ago with fever, myalgia, and headache; COVID and influenza swab negative at that time. Now afebrile and much better, with tiredness and a mild dry cough. Denies shortness of breath, chest pain, dysuria, abdominal pain, flank pain, and rash. Eating and drinking adequately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menstrual cycle and cyclical symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Regular 28-day cycles with 5–6 days of moderate bleeding. For 7–10 days before menses: marked irritability, mood swings, increased anxiety, feeling unable to cope, bloating, breast tenderness, and headaches. Symptoms resolve 2–3 days after bleeding starts; feels generally well mid-cycle. Symptoms affect interactions with partner and make work harder, but patient continues working full-time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mental health symptoms and safety screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No low mood outside the premenstrual week. No suicidal ideation or self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Physical examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well. Throat with mild erythema and no exudate. Chest clear; heart sounds dual. Abdomen soft and non-tender; no costovertebral angle tenderness. Neurological examination NAD; alert and oriented."
      }
