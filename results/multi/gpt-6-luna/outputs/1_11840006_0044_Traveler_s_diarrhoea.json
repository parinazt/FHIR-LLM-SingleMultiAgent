    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual-onset central low back pain across the belt line for 2 days, aching and stiff, VAS approximately 5–6/10. Worse with bending and standing from sitting; improves somewhat when lying flat. Non-radiating, with no leg symptoms. Patient reported onset after travel involving a poor mattress and prolonged plane sitting; possible strain related to increased toilet trips was discussed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain associated red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma, fall, heavy lifting, saddle anaesthesia, leg weakness, paraesthesia, gait disturbance, weight loss, night sweats, cancer history, IV drug use, and significant trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Bowel and bladder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passing urine normally. Denies urinary incontinence, retention, change in bowel control, dysuria, and loin pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools began approximately 24 hours after returning from Bali 5 days ago; currently 4–5 watery bowel movements per day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Stool-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies blood or mucus in stool. Reports mild crampy lower abdominal pain before a stool, relieved afterward. Denies vomiting, fever, and rigors."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported home temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports home temperature was \"36-something\"; exact temperature not specified."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Hydration and urinary output"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinking water and pharmacy oral rehydration solution; passing light-yellow urine every 3–4 hours. Denies postural dizziness and palpitations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Diarrhoea-associated history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports eating street food and drinking iced drinks during the Bali trip. Denies recent antibiotics and reports no sick contacts at home or work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth presentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and coherent, speaking in full sentences; sounds comfortable with no shortness of breath. Reports no fever. By history, no neurological red flags, features of severe dehydration, or systemic toxicity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Health-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is very anxious and repeatedly asks whether symptoms could indicate cancer or spinal infection and whether a scan is needed; expresses concern about parasites and a \"superbug\" after travel and requested stool and blood tests."
      }
    },
    {
