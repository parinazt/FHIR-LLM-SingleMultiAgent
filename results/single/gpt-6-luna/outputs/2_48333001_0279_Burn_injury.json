        "status": "final",
        "code": {
          "text": "Right forearm burn size and location"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6 x 8 cm on the volar mid-distal right forearm; non-circumferential."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Burn wound appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wound bed pink and moist with early epithelialisation and brisk capillary refill. Clean, with no slough, eschar, or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Burn wound exudate and local findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild serous ooze; patient reports a small amount of clear serous fluid and no increased exudate. No pus, malodour, warmth, or tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Erythema at burn margin"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A 0.5–1 cm rim of erythema, stable compared with the practice nurse photograph from 3 days earlier."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Rash around dressing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, slightly raised papular, very pruritic rash in the exact shape of the adhesive border. No vesicles or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Patient-reported itch and burn pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased itch around the adhesive border over the last 2–3 days; burn itself is less painful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Patient-reported systemic and spreading infection symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, rigors, sweats, or spreading erythema up the arm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Wrist and elbow range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full wrist and elbow range of motion; mild tightness at end-range flexion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Axillary and epitrochlear nodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No axillary or epitrochlear nodes noted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Patient concern about infection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient anxious about infection and requested a strong cream and antibiotics."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Panadol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g twice daily as needed",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Patient reports not using it in the last 2 days."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to peri-wound rash only twice daily for up to 5 days; avoid on the open burn.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
