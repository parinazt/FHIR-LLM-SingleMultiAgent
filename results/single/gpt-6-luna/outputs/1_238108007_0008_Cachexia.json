              }
            },
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Dexamethasone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Trial for appetite and energy: 2 mg orally in the morning for 5 days. Phone or nurse review after 5 days; if clear benefit, consider continuing at the lowest effective dose for up to approximately 2 weeks, then aim to cease.",
            "route": {
              "text": "oral"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 2,
                  "unit": "mg"
                }
              }
            ],
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "boundsDuration": {
                  "value": 5,
                  "unit": "days",
                  "code": "d",
                  "system": "http://unitsofmeasure.org"
                },
                "when": [
                  "MORN"
                ]
              }
            }
          }
        ],
        "note": [
          {
            "text": "Potential adverse effects discussed: mood change, insomnia, reflux, fluid retention, and increased blood glucose. Benefit is usually short term."
          }
        ]
      }
