    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported symptoms and collateral history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "For 2–3 days: increased fatigue, feels “washed out”, mild nausea and more unsteady on feet. No vomiting, diarrhoea, chest pain or shortness of breath. Reduced urine volume and darker urine over 1–2 days; RN reports reduced urine output versus baseline and that he is more tired and “just not himself”. No frank confusion, but wife reports he has been slower on the phone for the last 2 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Looks tired, in bed. Alert and oriented x3, mild psychomotor slowing, no focal neurology and no asterixis. Chest clear. Heart sounds dual, no murmur. JVP not clearly raised. Abdomen soft and non-tender, no CVA tenderness. Mild chronic bilateral ankle oedema. Mucous membranes slightly dry; borderline hypovolaemic versus euvolaemic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
