        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to the lesion once daily for 7–10 days, then stop. Avoid broken skin.",
            "route": {
              "text": "topical"
            },
