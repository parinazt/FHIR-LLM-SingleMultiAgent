    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Suprapubic and groin rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a 2-day history of an erythematous rash along the suprapubic and groin underwear line, with stinging and mild itch. Worse after hot showers and following long shifts in tight synthetic scrubs; began after changing washing powder and shaving the pubic area."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Dysuria"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports 3–4 days of burning when urinating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary frequency and urgency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports increased frequency, urinating every 1–2 hours, urgency, and small volumes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Suprapubic discomfort and tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports suprapubic discomfort. On self-palpation, patient reports mild suprapubic tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Urinary and systemic symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies haematuria, incontinence, fever, chills, rigors, flank pain, nausea, and vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Gynaecological symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies vaginal discharge, odour, itch, abnormal bleeding, postcoital bleeding, and deep dyspareunia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Patient appearance and general examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, well appearing, and speaking in full sentences. Colour pink with no obvious pallor or jaundice. Hydration appears adequate."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Flank percussion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient-performed flank percussion; patient reports no costovertebral angle tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Suprapubic skin appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief video view showed poorly demarcated erythema in the suprapubic area along the underwear/shaving zone. No vesicles, obvious pustules, ulcers, or cellulitis seen on video; assessment limited by camera and lighting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mucosal involvement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No mucosal involvement reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
