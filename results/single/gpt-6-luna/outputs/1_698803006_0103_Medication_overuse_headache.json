        },
        "code": {
          "text": "Medication overuse headache secondary to frequent simple analgesic and triptan use on a background of migraine without aura"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "High-frequency migraine without aura, suboptimally controlled"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache history and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of migraine since late teens, previously 1–2 episodes per month, right-sided and throbbing with photophobia and nausea, relieved by sumatriptan. Over the last 4–5 months headaches have increased to most days, with a baseline dull band-like ache most days and superimposed typical migraine 1–2 times per week. Migraine character otherwise unchanged, with increased frequency and background daily pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Headache recurrence as analgesic effect wears off"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache improves for a few hours after tablets, then returns, sometimes worse, typically 4–6 hours after a dose."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Morning and later-day headache pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes with a mild headache several mornings per week; takes analgesia mid-morning with improvement, followed by headache returning in the late afternoon or evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Headache red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies thunderclap onset, worst-ever headache, focal neurologic symptoms, speech disturbance, limb weakness, visual loss, fever, neck stiffness, head trauma, seizures, personality change, weight loss, and nocturnal headache waking her."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and psychosocial context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels a bit worn down by constant pain. Denies pervasive low mood, anhedonia, anxiety attacks, and suicidal ideation. Reports work and parenting demands; sleep is 6–7 hours per night and often broken by young children."
      }
    },
