        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest expansion symmetrical. Vesicular breath sounds, decreased at the bases, with fine end-inspiratory crackles at both bases, left greater than right. No wheeze or focal signs of consolidation."
      }
    },
