          "text": "Reported symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sudden increase in calf pain, marked swelling, skin discolouration, shortness of breath, pleuritic chest pain, haemoptysis, dizziness, syncope, palpitations, fevers, or rigors."
