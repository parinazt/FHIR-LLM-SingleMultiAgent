        "code": {
          "text": "Emergency department day-0 eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small superficial metallic foreign body removed from the left cornea, with a small residual epithelial defect. Seidel test negative; no penetrating injury. Anterior chamber deep and quiet, pupil round and reactive, and no hypopyon."
      }
