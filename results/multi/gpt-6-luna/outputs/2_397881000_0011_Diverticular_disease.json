    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent low back pain for approximately 3–4 weeks, worse over the last 5 days. Dull ache across the small of the back; usual severity 4–5/10, up to 7/10 with standing or walking. Possibly related to recent garage clean-out or a new mattress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Low back pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with bending, lifting, and prolonged sitting; improved by recliner rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Associated neurological and bowel/bladder symptoms with back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg radiation, paraesthesia, weakness, saddle anaesthesia, or bowel/bladder symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Constipation and lower abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing constipation and lower abdominal discomfort; sometimes feels 'crook in the guts'. Bowel movement every 2–3 days, often straining. Reports a low-fibre diet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No PR bleeding, melaena, weight loss, change in stool calibre, fevers, or acute left iliac fossa pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
