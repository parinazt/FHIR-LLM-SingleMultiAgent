        "code": {
          "text": "Clinical course of urosepsis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Clinically improving; afebrile since last night. CRP and white cell count are decreasing."
      }
