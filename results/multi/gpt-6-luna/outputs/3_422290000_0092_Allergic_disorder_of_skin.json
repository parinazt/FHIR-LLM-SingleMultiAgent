    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bad headache for 3 days, across the forehead and both temples. Gradual onset, not thunderclap; constant dull pressure, sometimes throbbing later in the day, especially after work with noisy children or screens. Wakes with no headache or a mild headache, which builds over the day. Severity up to 6/10; 3/10 now."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives with headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea, vomiting, visual changes, aura, weakness, speech or swallowing issues, dizziness, fever, or neck stiffness. No recent head injury. Patient does not describe it as the worst headache of her life."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported response to analgesia for headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports taking paracetamol 1 g up to three times daily herself and ibuprofen 400 mg once yesterday; these helped a bit."
      }
    },
