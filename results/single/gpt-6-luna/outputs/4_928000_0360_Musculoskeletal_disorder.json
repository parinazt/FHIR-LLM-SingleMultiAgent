          "text": "Observed health-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visibly anxious, frequently checking phone notes and Google, and repeatedly asking about cancer, hidden bone infection, and whether MRI or CT is needed."
      }
    },
