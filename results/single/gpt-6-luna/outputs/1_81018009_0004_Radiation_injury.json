        "status": "final",
        "code": {
          "text": "Occupational radiation exposure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of occupational diagnostic radiation exposure; no radiotherapy. The affected area corresponds to where the patient rests cassettes or portable equipment."
      }
    },
