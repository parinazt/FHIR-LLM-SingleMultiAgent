    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Swallowing difficulty"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports approximately 6–8 weeks of dysphagia, mainly with solids such as meat and bread, more than liquids. Food feels as though it sticks halfway, around the mid sternum. Occurs most days now; needs to sip water to get food down and occasionally has to stop and wait. No complete blockage so far."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No coughing or choking, no sensation of food going down the wrong way, and no odynophagia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Heartburn"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional retrosternal heartburn a few times per week, worse after a large tea at night and partly relieved by over-the-counter Quick-Eze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Weight and appetite"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no weight loss; appetite is OK. Avoiding steak and eating more slowly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
