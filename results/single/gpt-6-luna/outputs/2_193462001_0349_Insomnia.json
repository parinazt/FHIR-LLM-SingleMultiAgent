      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Sleep onset and sleep pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insomnia for approximately 9–10 months. Takes 60–90 minutes to fall asleep, wakes 2–3 times, and reports feeling like she is running on empty. Estimates 4–5 hours of broken sleep on work days and up to 6 hours on days off. Sleep is worse with shift changes."
      }
    },
