        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood OK; patient feels frustrated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Lumbar back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Localized tenderness over lower lumbar facet joints, right greater than left; no midline tenderness. Flexion mildly reduced at end range with ache. Extension and rotation reproduce localized pain only, with no radicular symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
