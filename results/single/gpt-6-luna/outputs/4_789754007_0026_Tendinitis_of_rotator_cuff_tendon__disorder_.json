    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradually increasing over approximately 3–4 weeks; baseline pain approximately 3–4/10, up to 7/10 with overhead activity. Worse with overhead reaching and reaching behind the back; night pain when lying on the left side, waking the patient a few times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left shoulder functional limitation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty hanging washing and some client transfers; still working full time and swapping heavier jobs with colleagues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
