    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull band-like headache at the forehead and temples, sometimes occipital, for approximately 3 weeks. Worse later in the day after long bar shifts or screen use. Usually 3–4/10, up to 6/10 on bad days. Sleep helps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap or worst-ever headache; no vomiting, photophobia, phonophobia, aura, visual change, focal neurological symptoms, speech change, confusion, fever, neck stiffness, weight loss, night sweats, sinus symptoms, or trauma. Rare mild nausea."
      }
    },
