    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and functional status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain, trauma, or neck manipulation. No Lhermitte phenomenon, new headache, occipital headache, or cough/Valsalva headache. No visual change, diplopia, dysarthria, dysphagia, or facial weakness. No limb weakness; walking and stairs are okay. Sensory symptoms essentially absent except for longstanding positional pins and needles in the hands. No bladder or bowel issues or saddle anaesthesia. No recent infection, weight loss, or sweats. Driving is okay with no near misses."
      }
    },
