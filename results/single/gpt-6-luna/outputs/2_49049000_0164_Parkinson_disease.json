        "code": {
          "text": "Psychosis-related reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No command hallucinations, thought disorder, or suicidal ideation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Constipation symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowel movement every 2–3 days, hard stools and some straining. No rectal bleeding or weight loss reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
