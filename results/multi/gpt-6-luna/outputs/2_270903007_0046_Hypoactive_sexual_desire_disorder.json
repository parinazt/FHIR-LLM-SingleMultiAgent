    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low sexual desire"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports gradually developing low sexual desire for approximately 12–18 months, now persistent. She reports rare sexual thoughts, often avoids initiating sex, and often goes along with sex for her partner's sake; sex feels more like a chore. She reports distress, guilt, feeling 'a bit broken,' and some relationship strain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sexual arousal and orgasm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Once engaged, patient is usually able to become aroused and orgasm, though orgasm takes longer and feels less intense. She reports no anorgasmia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Gynecologic and sexual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies dyspareunia, vaginal dryness, postcoital bleeding, and pelvic pain. Periods are regular every 28–32 days with moderate flow. Patient denies urinary symptoms and abnormal vaginal discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mood and sleep symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies persistent low mood outside the sexual domain and denies general anhedonia. Reports some work stress, fragmented sleep of approximately 6–7 hours, and tiredness described as 'normal busy mum tiredness.' Denies suicidal ideation and thoughts of self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Weight change concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports having put on 'a bit' of weight around the middle since having children and wonders whether this is related to libido."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Menopausal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports she is not menopausal and denies hot flushes and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Androgen-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No hirsutism, acne, galactorrhoea, or virilisation reported. Examination noted no excess facial or body hair and no significant acne."
      }
    },
    {
