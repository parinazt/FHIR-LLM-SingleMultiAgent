        "code": {
          "text": "Reported anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased worry over the last 3–4 weeks and more trouble keeping it under control, mainly about health, dementia and cancer. Feels on edge most days and has muscle tension in shoulders and jaw. Reports fatigue by late afternoon and rumination about minor bodily symptoms."
      }
    },
