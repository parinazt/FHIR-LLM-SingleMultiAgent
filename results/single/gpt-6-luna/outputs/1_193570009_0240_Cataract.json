    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Localised dry rough patch on right dorsal forearm; likely benign lesion. Differential includes actinic keratosis (solar keratosis), mild dermatitis/eczema, seborrhoeic keratosis, and less likely early non-melanoma skin cancer based on history only."
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Mild age-related cataracts of both eyes, with stable symptoms and not yet functionally disabling."
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported right forearm skin patch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small, pea-sized dry scaly patch on the dorsal right forearm, noticed about 3–4 weeks ago with gradual onset. It is a little rougher to touch and more visible in the mirror; colour is unchanged and described as a bit pink. Reported stable over the past few weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and features of right forearm skin patch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, itch, bleeding, ulceration, or rapid growth. No preceding trauma or bite."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, weight loss, night sweats, or malaise."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported skin cancer risk and skin history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports lots of sun exposure in younger years; now wears a hat and uses some sunscreen, not always reapplied. Reports previous spots frozen by a GP years ago, likely actinic keratoses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Cataract-related visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild glare, especially with night driving, and mild distance blur; symptoms are stable. Not yet functionally disabling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported ocular red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sudden decrease in vision, severe eye pain, marked redness, purulent discharge, or curtain over vision."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Direct examination during telehealth encounter"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Phone-only consultation with no video; the skin lesion and eyes could not be directly inspected. Skin cancer exclusion was limited by the lack of direct examination."
      }
    },
    {
