    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull ache for 3–4 days, periumbilical to lower abdomen and mostly generalised; severity 3–4/10, not colicky, with no radiation. Worse after large greasy meals and when leaning forward; passing wind and an over-the-counter antacid help somewhat."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bloating and increased flatus. No nausea or vomiting. Bowel motions once daily, formed; no melaena or rectal bleeding. No dysuria, fever, weight loss, night pain, appetite change, recent travel, or sick contacts. Patient wonders whether a kebab the previous week or energy drinks may be contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Denied abdominal red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Specifically denies persistent vomiting, haematemesis, rectal bleeding, melaena, severe localised pain, jaundice, urinary symptoms, trauma, and unintentional weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Perianal itching and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe perianal itching for approximately 3–4 months, gradually increasing, worse at night and after hot sweaty shifts and often wakes the patient scratching. Now some soreness; reports skin thickening and small spots of blood on paper after scratching. No lumps or prolapse, mucous discharge, visible worms, nocturnal crawling sensation, similar symptoms in household, or systemic symptoms including fever, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel habit and perianal symptom context"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowel motions once daily, formed and sometimes slightly loose after greasy food; no incontinence. Itching is exacerbated by sweating at work, synthetic underwear, long hours, stress, frequent wiping with dry toilet paper, and occasional supermarket wet wipes. Cold shower gives brief relief."
      }
    },
