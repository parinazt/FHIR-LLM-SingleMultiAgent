        "code": {
          "text": "Bilateral lower leg and foot skin discoloration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mottled purplish net-like discolouration over shins and dorsum of both feet, right greater than left, with a livedo pattern; reported for approximately 10–14 days."
