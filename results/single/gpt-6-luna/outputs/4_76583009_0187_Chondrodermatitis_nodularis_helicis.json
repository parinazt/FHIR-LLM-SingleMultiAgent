    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports poor sleep with repeated waking and approximately 4–5 hours of broken sleep. No difficulty getting to sleep. Sleep disruption is associated with right ear pain at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp pain when lying on the right side, described as like someone jabbing a match in the ear. Improves when he turns over or rubs it, then recurs when lying on it again. Ongoing approximately 3–4 months and getting worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right external ear lesion, patient-reported history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small painful lump on the upper right ear for approximately 6 months; worse with pressure from a pillow and sometimes crusty."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right external ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6–7 mm firm, tender, dome-shaped nodule on the helix/upper antihelix with superficial central erosion and slight scale/crust, mild surrounding erythema, and very focal tenderness to light pressure. No fluctuation or warmth. No obvious rolled edge or pearly lesion, but crust partly obscures the lesion. No pre- or post-auricular nodes. Canals and tympanic membranes normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated symptoms and sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies low mood, racing thoughts, and early waking independent of the ear pain. Denies ear discharge, bleeding other than cracking, hearing loss, tinnitus, vertigo, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Skin history and limited skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports heavy lifetime sun exposure, including years driving with the window down and frequent ear sunburns. No known past skin cancer. Brief look at face, scalp, and dorsal hands found no obvious other suspicious lesions; this was not a full skin check."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.02% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to the lesion once daily for up to 2 weeks, then stop. For inflammation only; not definitive treatment.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "boundsDuration": {
                  "value": 2,
                  "unit": "weeks",
                  "system": "http://unitsofmeasure.org",
                  "code": "wk"
                }
              }
            }
          }
        ]
      }
    },
