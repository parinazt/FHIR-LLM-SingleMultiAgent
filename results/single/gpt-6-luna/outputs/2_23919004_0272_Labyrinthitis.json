        "code": {
          "text": "Ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ear canals clear; tympanic membranes intact bilaterally, with no erythema or effusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cranial nerve and eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves grossly intact; face symmetrical and tongue midline. Eye movements full; no spontaneous nystagmus in primary gaze. Mild brief fatigable horizontal nystagmus on left gaze; symptoms provoked with rapid head turns to the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
