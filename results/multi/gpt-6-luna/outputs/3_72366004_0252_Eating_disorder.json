          "text": "Medication adherence"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports often forgetting lisdexamfetamine, especially on days off. Ran out a few weeks ago and has occasionally borrowed tablets from a friend to get through late work shifts."
      }
    },
