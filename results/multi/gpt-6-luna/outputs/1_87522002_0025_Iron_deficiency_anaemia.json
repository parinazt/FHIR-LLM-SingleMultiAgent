          "text": "Reported toe-related findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known foreign body and no discharge. No fever, rigors, or systemic upset. No calf pain, other joint symptoms, or rash."
      }
    },
