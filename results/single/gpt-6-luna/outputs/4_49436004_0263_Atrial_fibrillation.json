    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower back pain for approximately 7–10 days, gradual onset without specific injury; dull ache across the belt line, occasionally sharp with twisting. Up to 7/10 at worst and currently approximately 4/10 after morning paracetamol. Worse getting out of bed, standing and walking for more than a few minutes; eases sitting and leaning forward on walker. Sleep somewhat disturbed by pain when turning in bed; initially worse lying down, then settles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Back pain red-flag and associated neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies leg pain radiation, numbness, tingling, weakness, saddle anaesthesia, bowel or bladder incontinence or retention. No recent falls; baseline four-wheeled walker use unchanged. No trauma, new focal neurological deficit or pain-related gait change beyond the antalgic gait described on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Constitutional and malignancy red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, chills, night sweats or weight change; appetite okay. No cancer history or steroid use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Cardiorespiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline exertional shortness of breath after more than 20–30 m, unchanged; baseline cough. No chest pain, increased palpitations beyond usual barely noticed flutter, presyncope, syncope, orthopnoea, paroxysmal nocturnal dyspnoea, ankle swelling or haemoptysis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "General appearance and orientation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and orientated, comfortable at rest, moves carefully."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Irregularly irregular rhythm, rate approximately 80; no murmur, rub or gallop. JVP not raised; no oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Barrel chest, reduced air entry bilaterally, scattered end-expiratory wheeze, no crackles; described as consistent with baseline COPD."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Back and musculoskeletal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild thoracolumbar kyphosis; local tenderness over lower lumbar paraspinals, right greater than left; no focal midline spinous tenderness. Flexion, extension and lateral flexion reduced due to pain but achievable. Straight leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 at L2–S1; light-touch sensation intact; reflexes symmetrical; plantars flexor; no saddle anaesthesia or foot drop. Short-distance gait with four-wheeled walker is antalgic but stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
