        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline mild left arm weakness only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-26",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-26",
        "status": "final",
        "code": {
          "text": "Acute limb ischaemia findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No features of acute limb ischaemia today: no sudden severe pain, motor loss, or profound sensory loss."
