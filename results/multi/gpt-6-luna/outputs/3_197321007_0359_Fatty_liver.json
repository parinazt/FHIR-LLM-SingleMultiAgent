    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right first MTP pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insidious onset over 4–5 days; throbbing, worse with weight bearing and sheet touch. Pain increased over the last 2 days then plateaued."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right first MTP examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild swelling, erythema, warmth and marked tenderness; reduced range of motion due to pain. No skin breaks, tophi, streaking or cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right foot perfusion and sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pulses present; capillary refill less than 2 seconds; sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to mobilise with a frame, favouring the right foot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other reported and examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, wound, or fever reported; systemically well. Other joints NAD. No stigmata of chronic liver disease. CVS, respiratory and abdominal examinations grossly within normal limits."
      }
