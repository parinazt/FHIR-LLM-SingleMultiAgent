        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain with intercourse, reduced with supermarket lubricant."
      }
    },
    {
