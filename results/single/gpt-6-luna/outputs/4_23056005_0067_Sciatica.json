        "code": {
          "text": "Back and lower limb symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new weakness; chronic mild right leg weakness unchanged. No recent falls, saddle anaesthesia, bladder or bowel incontinence or retention, or progressive bilateral leg weakness. Walks approximately 200–300 m before needing to rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
