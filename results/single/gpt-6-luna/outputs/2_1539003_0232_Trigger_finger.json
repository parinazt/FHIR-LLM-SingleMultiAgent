        "code": {
          "text": "Right ring finger pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for 4–5/12; reaches 7/10, though the patient describes it as “only a bit sore.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ring finger locking and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Catching or locking, especially in the morning; stiff for 10–15 minutes, then eases. Sometimes needs the left hand to straighten the finger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
