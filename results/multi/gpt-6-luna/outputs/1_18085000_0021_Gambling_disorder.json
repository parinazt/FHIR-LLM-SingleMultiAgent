        "code": {
          "text": "Other drug use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no other drugs"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "History of impulsive reactions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports past impulsive behavior, including smashing a glass after a major workplace conflict, and says he reacts strongly when people upset him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tangential but cooperative; mildly fidgety. Speech increased when discussing gambling. Affect congruent with mood. No psychosis. Insight fair regarding gambling; judgment impaired around chasing losses."
      }
    },
