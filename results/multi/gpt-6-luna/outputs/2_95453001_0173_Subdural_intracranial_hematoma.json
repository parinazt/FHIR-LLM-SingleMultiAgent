          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Falls risk and functional decline post-subdural haematoma"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
