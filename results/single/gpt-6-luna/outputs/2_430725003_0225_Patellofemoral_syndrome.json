        "code": {
          "text": "Left knee inspection and range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or obvious effusion. Full range of motion with pain at end-range flexion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left knee palpation and patellar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Peripatellar tenderness, especially at the medial and lateral facets; no joint-line tenderness. Pain with patellar compression and medial/lateral glide; mild crepitus. Patellar grind positive, reproducing typical pain; no patellar apprehension."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
