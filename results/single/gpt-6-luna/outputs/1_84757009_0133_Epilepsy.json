    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported focal seizure events"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the past approximately 3 weeks, focal events have become mildly more frequent; 3 events last week. Patient describes a weird feeling and jerking in the right arm and face, lasting 30–60 seconds. He remains aware and hears others; speech is arrested or difficult during the event. He feels tired for a few minutes afterwards, without prolonged confusion. Mother reports these are the same as his usual events, just somewhat more frequent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported seizure history and associated features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long history of epilepsy since childhood, focal onset and sometimes generalising. Last generalised tonic-clonic seizure was reported as approximately 8/12 ago (as documented). No loss of consciousness, generalised tonic-clonic activity during the recent events, tongue bite, incontinence, or injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported possible seizure triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep for approximately 1 month due to worry about his brain. Increased energy drink consumption, 2–3 cans per day, with a new brand."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported neurological and other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No persistent weakness, speech change, or vision loss; no new severe headache, fever, neck stiffness, or recent head trauma. No alcohol or illicit drug use reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Medication adherence and timing reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Medications unchanged per patient and mother. An occasional evening dose is 1–2 hours late. Mother manages a Webster pack and believes adherence is greater than 95%."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Health anxiety and expressed concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient was very anxious and scared that the events meant his brain was getting worse, and worried about an unnoticed status epilepticus. Longstanding health anxiety about the brain, frequent googling about seizures, cancer, and stroke, and repeatedly requesting MRI every few months. Mother reports multiple prior GP or ED attendances for minor symptoms. No suicidal ideation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Telehealth phone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences and mildly anxious; oriented and chatting appropriately. No obvious dysarthria, word-finding problem, or confusion on brief phone screen. Phone consultation only; no examination or vital signs obtained."
      }
    },
