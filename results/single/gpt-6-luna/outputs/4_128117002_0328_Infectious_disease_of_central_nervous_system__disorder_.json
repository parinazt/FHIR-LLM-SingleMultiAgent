          "text": "Neurological red flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denied fever, neck stiffness, confusion, focal weakness, seizures, severe photophobia, vomiting, diplopia, slurred speech, unsteady gait, incontinence, rash, recent falls, and head trauma."
      }
