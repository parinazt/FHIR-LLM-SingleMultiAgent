    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Intermittent panic episodes and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes 1–2 times per week, with sudden onset, peaking over a few minutes and lasting about 5–10 minutes. Symptoms include heart racing, sweating, mild dizziness and shortness of breath. Often occurs in the evenings when alone or while thinking about health or an article about pregnant women and panic. Can occur at rest; no clear exertional link. Episodes are shorter and less intense with slow breathing when remembered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied during episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No chest pain, radiation, syncope, nausea, vomiting or infective symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Social activity avoidance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Continues to avoid large group activities because she feels too many people are looking at her."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Concern about palpitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worries that fast heartbeats might indicate a heart problem, comparing them with symptoms described in an article about pregnant women and panic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Caffeine use and perceived trigger"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels worse after a second instant coffee. Has reduced intake from 3–4 to 1–2 cups per day and feels this already helps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cardiorespiratory review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No exertional chest pain, orthopnoea, paroxysmal nocturnal dyspnoea or leg swelling. Walks slowly with a four-wheeled walker; no new shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
