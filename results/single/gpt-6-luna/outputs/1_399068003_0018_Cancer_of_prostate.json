        "code": {
          "text": "Mobility and walking tolerance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobilises independently without gait aids; occasionally leans on furniture when pain is bad. Walking more than 100 m without rest is difficult due to back and hip pain. No recent falls."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
