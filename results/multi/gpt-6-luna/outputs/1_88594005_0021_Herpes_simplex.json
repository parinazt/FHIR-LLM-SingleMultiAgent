          "text": "Rash onset and spread"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the rash began as little clear blisters on the face and neck about 1–2 weeks ago, possibly longer, then spread everywhere."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash pain and itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the rash is very sore, with pain greater than itch; it stings when moving or touching it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
