        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools began approximately 24 hours after returning from Bali 5 days ago; currently 4–5 watery bowel movements per day."
      }
    },
    {
