        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue, up to 1 g four times daily; maximum 4 g in 24 hours. Advised to take more regularly for a few days, then as needed for pain.",
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ],
            "timing": {
              "repeat": {
                "frequency": 4,
                "period": 1,
