        "code": {
          "text": "Reported intermittent right eye outward drift"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing intermittent outward drift, especially when tired or focusing at distance; noticed more in photographs and while reading stories to children."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Eye strain and ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal/ocular ache and eye strain by the end of the workday, for approximately 3–4 days per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Diplopia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually absent; very occasional brief double vision when very fatigued, resolving with blinking or refocusing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Change in eye symptoms since last review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute change; symptoms reported as stable over the last 6 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reported visual and ocular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies vision loss, halos, flashes, visual field loss, redness, discharge, and photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported headache and neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies headache waking from sleep, vomiting, focal neurological symptoms, limb weakness, and speech disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "External eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal; no ptosis, periorbital swelling, conjunctival injection, or discharge; corneas clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Pupil examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal, round, and reactive to light; no relative afferent pupillary defect."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Extraocular movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full in all directions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Cover-uncover test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent right exodeviation on distant target, small-to-moderate angle, appearing comitant and more evident with fatigue during examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Alternate cover test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Suggests alternating exotropia, with right exotropia more common; refixation movements symmetric, with no obvious paralytic pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
