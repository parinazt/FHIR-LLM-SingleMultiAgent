        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as \"a bit cranky\"; denies low mood, anhedonia, and anxiety"
      }
    },
    {
