        "code": {
          "text": "Scrotal pain and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain absent most of the time; occasional dragging, heavy sensation after a long day at work. Denies sudden severe testicular pain, dysuria, haematuria, urethral discharge, fevers, rigors, nausea, vomiting, and abdominal pain."
      }
    },
    {
