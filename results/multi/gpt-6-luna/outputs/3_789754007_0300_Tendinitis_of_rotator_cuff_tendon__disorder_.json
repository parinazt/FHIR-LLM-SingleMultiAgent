        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache at the lateral right shoulder, 3–4/10 at rest and up to 6/10 with overhead activity; worse after heavy or manual handling at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right shoulder stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mainly stiff in the morning and after sitting or driving; morning stiffness lasts about 20–30 minutes and eases with gentle movement. Reports that the shoulder feels very stiff on waking and can seize up after sitting at the nurses’ station for a while."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right shoulder sleep-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wakes if lying on the right side for too long."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right shoulder activity limitation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hanging washing and reaching to top cupboards are difficult; avoiding overhead activities at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right shoulder examination: appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, muscle wasting, or swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right shoulder tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tenderness to palpation at the greater tuberosity and anterolateral shoulder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction painful from 70–120°, near full otherwise. External rotation mildly reduced compared with the left, with end-range pain. Internal rotation to mid-thoracic spine with mild discomfort. Passive range of motion slightly greater than active, with no global loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right shoulder strength"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pain-limited reduction in abduction and external-rotation power; otherwise 5/5."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
