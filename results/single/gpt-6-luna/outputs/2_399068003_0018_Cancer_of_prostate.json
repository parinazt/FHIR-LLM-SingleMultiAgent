          "reference": "Patient/patient-1"
        },
        "valueString": "Cautious, non-antalgic gait; able to walk briefly on heels and toes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
