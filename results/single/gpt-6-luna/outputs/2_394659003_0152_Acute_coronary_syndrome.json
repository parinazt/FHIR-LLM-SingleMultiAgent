        "code": {
          "text": "Reported exertional chest tightness episode"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "The previous afternoon, while walking the dog, gradual-onset central dull pressure and slight heaviness extending into the left upper arm lasted approximately 15–20 minutes and resolved with rest. Associated increased dizziness, clamminess, and nausea. No vomiting, marked shortness of breath, or pleuritic or positional features."
      }
    },
