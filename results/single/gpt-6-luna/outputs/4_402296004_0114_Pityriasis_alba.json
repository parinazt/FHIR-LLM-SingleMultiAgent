        "code": {
          "text": "Reported cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for approximately 10 days, starting after an URTI-type illness; worse in the evenings and when talking a lot at work under air conditioning. Patient wonders whether iced coffee and air conditioning are triggers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated cough symptoms and reported general symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sore throat and blocked nose with the preceding URTI-type illness have mostly resolved. No shortness of breath, wheeze, chest tightness, pleuritic chest pain, fever, chills, or haemoptysis. Appetite is okay; energy is somewhat reduced. Still attending university and work."
      }
