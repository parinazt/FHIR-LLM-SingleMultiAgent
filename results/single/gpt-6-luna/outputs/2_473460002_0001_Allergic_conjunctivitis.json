          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Olopatadine 0.1% eye drops"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Instil 1 drop in both eyes twice daily during the symptomatic period; may take 1–2 days for maximum effect.",
            "route": {
              "text": "ophthalmic"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "drop"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Fluticasone furoate 27.5 mcg nasal spray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Use 2 sprays in each nostril each morning for 1 week, then 1–2 sprays in each nostril each morning through the allergy season.",
            "route": {
              "text": "intranasal"
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 2,
                  "unit": "sprays"
                }
              }
            ]
          }
        ]
