        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull band-like headache for approximately 3 weeks, frontal and temporal, sometimes occipital. Worse later in the day after long bar shifts or screen use. Severity 3–4/10, up to 6/10 on bad days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Headache associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap onset or 'worst ever' headache. No vomiting; rare mild nausea. No photophobia, phonophobia, aura, visual changes, focal neurological symptoms, speech changes, or confusion. Sleep helps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other headache-related symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, neck stiffness, weight loss, night sweats, sinus symptoms, or trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
