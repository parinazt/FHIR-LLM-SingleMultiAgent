          "reference": "Patient/patient-1"
        },
        "valueString": "Oral intake and appetite slightly decreased, but still eating and drinking and able to get food down. Denies vomiting, diarrhoea and abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neurological and other screened symptoms"
