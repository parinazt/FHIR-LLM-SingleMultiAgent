    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported lower abdominal discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for 3 days, worse last night; dull ache across the lower abdomen, intermittent, non-colicky, non-radiating, rated 4-5/10. No clear trigger or relation to meals. The patient wonders whether it was related to too many coffees or a meat pie eaten 2 days earlier. Pain did not wake him from sleep. Two Panadol tablets last night provided some relief. He was able to work but was a little uncomfortable bending and lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dyspepsia, heartburn, regurgitation, nausea, vomiting, diarrhoea, constipation, rectal blood or mucus, and melaena. Bowels open daily with formed stools; appetite is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated urinary and genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, urgency, haematuria, flank pain, and testicular pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Constitutional and exposure history relevant to abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, weight loss, night sweats, and anorexia. No recent overseas travel, sick contacts, or antibiotic use. No previous similar episodes."
      }
    },
