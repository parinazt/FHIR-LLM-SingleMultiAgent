          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Pelvic floor muscle overactivity contributing to penetration pain"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain with intercourse on approximately 9–10 of 12 attempts. Superficial and deep pain: sharp, burning pain at the entrance followed by a deeper ache; worse with initial penetration and in certain positions. Pain may linger for minutes to hours after sex."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Intercourse since last review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stopped penetrative intercourse as advised and continues non-penetrative intimacy. Tried intercourse once with water-based lubricant and stopped early due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies postcoital bleeding, dysuria, urinary frequency, abnormal vaginal discharge, vaginal odor, and itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, systemic symptoms, bowel change, rectal bleeding, severe dysmenorrhoea, urinary incontinence, and cyclical pelvic pain outside menses. Reports regular cycles every 28–30 days, lasting 7 days, with moderate flow and manageable dysmenorrhoea on days 1–2."
      }
    },
    {
