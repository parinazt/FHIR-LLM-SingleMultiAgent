    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a gradual-onset, dull, constant frontal and bitemporal headache for 3 days, right greater than left, severity 7/10. Worse in the evenings and does not wake her from sleep. Patient thinks it may be due to eyestrain from TV and bright supermarket LED lights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap onset or worst-ever headache. No nausea or vomiting, photophobia or phonophobia; reports mild light sensitivity only and no visual aura. No jaw claudication or scalp tenderness. No focal neurological symptoms, weakness, facial droop, speech difficulty, confusion, loss of consciousness, seizure or ataxia. No neck stiffness, fever or rigors. No recent head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Paracetamol response for headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports taking paracetamol 500 mg, 1–2 tablets as needed, maximum 3 times daily, with partial relief."
      }
    },
