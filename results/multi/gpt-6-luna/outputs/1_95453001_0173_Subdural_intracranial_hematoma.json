        "code": {
          "text": "Activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent with basic self-care but slower; sits for showering due to fear of falling. Manages simple meals."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
