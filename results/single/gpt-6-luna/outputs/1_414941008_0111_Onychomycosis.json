    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Toenail appearance on video examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Great toenails opaque yellow and thickened, with distal crumbling and onycholysis involving approximately 40–50% of the right great toenail and 30–40% of the left; some second toenails also affected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Periungual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious periungual erythema or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Toenail symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Toenail changes present for approximately 18 months, mainly affecting the big toes. Mild discomfort in shoes and cosmetic bother; no pain, discharge, or spreading erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Nail microscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hyphae present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Nail fungal culture"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Trichophyton rubrum."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small erythematous scaly plaques on the shins, consistent with psoriasis; mild flare also reported behind the ears. No cellulitis, ooze, or systemic symptoms."
      }
    },
