    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue and weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling weak and tired for approximately 3–4 weeks, wiped out by the afternoon; activities of daily living remain manageable but are slower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Pertinent associated symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, palpitations, oedema, weight loss, fevers, night sweats, PR bleeding, and melaena. No recent travel."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood reported as okay; denies suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding urgency-predominant mixed urinary incontinence, with urgency and small-volume leakage as well as some stress leakage; uses 3–4 pads per day. Nocturia twice nightly. No retention symptoms. No new lower urinary tract symptoms apart from longstanding urgency/incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
