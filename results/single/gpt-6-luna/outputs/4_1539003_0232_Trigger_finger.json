        "code": {
          "text": "Right ring finger examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild volar fullness at MCP/A1 pulley and a palpable tender nodule. No erythema or warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right ring finger range of motion and triggering"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partial fist only; triggering from flexion to extension, requiring assistance on 2/3 attempts. Passive range of motion full and mildly tender. Palpable/audible click."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
