    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports poor sleep with approximately 4–5 hours of broken sleep and repeated waking due to right ear pain. No difficulty falling asleep. Denies low mood, racing thoughts, or early waking independent of the ear pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp pain at night when lying on the right side, described as like someone jabbing a match in the ear. Settles when he turns over or rubs it, then recurs when lying on the right side again. Ongoing approximately 3–4 months and worsening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right external ear lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a small painful lump on the upper right ear for approximately 6 months, worse with pressure on the pillow and sometimes crusty. Examination: approximately 6–7 mm firm, tender, dome-shaped nodule on the helix/upper antihelix, with superficial central erosion and slight scale/crust, mild surrounding erythema, and very focal tenderness to light pressure. No fluctuation or warmth. No obvious rolled edge or pearly lesion, though crust partly obscures the lesion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right ear and regional examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No discharge or bleeding other than cracking. No pre- or post-auricular nodes. Ear canals and tympanic membranes normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hearing loss, tinnitus, vertigo, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other visible skin lesions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief examination of the face, scalp, and dorsal hands showed no obvious other suspicious lesions; this was not a full skin check."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.02% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to the lesion once daily for up to 2 weeks, then stop.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
    },
