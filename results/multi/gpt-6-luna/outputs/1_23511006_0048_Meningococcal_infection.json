        "code": {
          "text": "Symptoms at onset"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "At onset approximately 9 days ago: high fevers, severe headache, neck stiffness, photophobia, nausea and vomiting, and purple spots on legs and trunk."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
