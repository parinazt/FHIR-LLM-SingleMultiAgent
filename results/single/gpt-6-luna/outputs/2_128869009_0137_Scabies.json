    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Itchy rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for approximately 3–4 weeks, worse at night; started on wrists and hands and now involves between the fingers, around the waistline/lower abdomen, and inner thighs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Papules and excoriations on wrists, interdigital spaces, lateral fingers, periumbilical/waistband area, inner thighs, and anterior axillary folds; a few linear burrows between fingers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Superficial skin lesions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few small superficial pustules and crusting on shins and forearms, consistent with mild secondary infection; no significant surrounding cellulitis and lesions are non-tender. No features of crusted scabies."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General appearance and review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well. No fever or feeling unwell. No shortness of breath, chest pain, joint symptoms, or sore throat. Chest, cardiovascular, joint, and throat examinations unremarkable."
      }
    },
