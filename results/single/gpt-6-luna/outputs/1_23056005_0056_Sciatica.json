        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported bilateral leg and foot weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive over 10–14 days; right greater than left. Reports right foot slapping when walking fast and left ankle not lifting properly, especially on stairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Near-falls"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two near-falls this week; patient reports feet do not pick up properly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Walking distance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Can walk approximately 50–100 m; walking is better when leaning on a trolley."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Radiating pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right buttock to posterolateral thigh, lateral calf, and dorsum of foot; burning/electric; 4–5/10 at baseline and up to 8/10 after a shift. Background right sciatica for approximately 6–8 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported tingling and numbness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right L5 distribution, with milder symptoms in the left L5 distribution."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Red-flag symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No bladder or bowel symptoms, saddle anaesthesia, fever, weight loss, or trauma. No saddle sensory loss on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Antalgic gait, decreased right foot clearance, mild right foot slap, and cautious turns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Lower-limb muscle power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hip flexion 5/5 bilaterally; knee extension 5/5 bilaterally; plantar flexion 5/5 bilaterally; ankle dorsiflexion right 4-/5 and left 4/5; extensor hallucis longus right 4-/5 and left 4/5."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Lower-limb reflexes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Knee jerks 2+ bilaterally; ankle jerk right 1+ and left 2+; plantar responses downgoing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Lower-limb sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced light touch and pinprick in right L5 distribution; mildly reduced sensation in left L5 distribution."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Straight-leg raise"
