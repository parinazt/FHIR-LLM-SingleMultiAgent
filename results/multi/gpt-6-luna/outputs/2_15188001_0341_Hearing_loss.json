          "text": "Upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms for approximately 5 days: initially scratchy throat, now nasal congestion, rhinorrhoea, mild dry cough, and feeling a bit washed out."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported respiratory and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no shortness of breath, chest pain, wheeze, facial pain, purulent sputum, or gastrointestinal symptoms. Afebrile at home; eating and drinking well."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
