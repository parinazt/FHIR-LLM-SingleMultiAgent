        "code": {
          "text": "Patient-reported ocular red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies sudden decrease in vision, severe eye pain, marked redness, purulent discharge, or a curtain over vision."
      }
