        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent frontal/retro-orbital headache for approximately 1–2 weeks, possibly longer; pressing, band-like quality, worse toward the end of shifts and with bright lights or screens; partially improves with over-the-counter analgesia, dose uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea and photophobia when the headache is bad."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Negative headache-associated and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap headache, headache waking from sleep, recent head trauma, vomiting, focal neurological symptoms, speech change, limb weakness or tingling, neck stiffness, or fever."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
