        },
        "valueString": "Since discharge, home blood pressures described by wife as “pretty good” using a pharmacy machine; no numerical readings supplied."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Post-stroke symptoms and function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recurrent severe headache, new focal neurological symptoms, seizures, or loss of consciousness. Residual mild right arm weakness and slower fine motor function are improving with physiotherapy. Speech normal; independent with most activities of daily living."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Targeted review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, weight loss, night sweats, facial weakness, visual change, speech disturbance, new limb weakness, gait change, sudden severe headache, jaw claudication, scalp tenderness, temporal pain, sore throat, dental abscess symptoms, or sinus symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Mood and adjustment since stroke"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wife reports occasional low mood and irritability since stroke. Patient says, “I’m fine just a bit cranky.”"
      }
    },
