        "code": {
          "text": "Right thumb and wrist symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grating or creaking, especially on the first few thumb movements in the morning and after prolonged typing; worse with lifting a kettle, opening jars, picking up shopping, and ulnar deviation with the thumb abducted"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
