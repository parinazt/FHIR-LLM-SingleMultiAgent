        "medicationCodeableConcept": {
          "text": "Lignocaine 2% gel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a small amount to the vestibule once nightly and up to 30 minutes before potential triggers. May sting initially; wash off if significant irritation. If using before intercourse, use a condom to avoid partner numbness.",
            "route": {
              "text": "topical"
            },
            "timing": {
