        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small, shallow linear epithelial defect at the previous foreign-body site. No dendritic pattern, white infiltrate, opacity, or ulcer crater. Seidel test negative; tear film adequate."
      }
    },
