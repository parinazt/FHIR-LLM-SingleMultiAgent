    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left visual acuity, Snellen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "6/18, improving to approximately 6/12 with pinhole"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset of intermittent blurry vision for approximately 3 weeks, left greater than right; worse at the end of the day and feels like straining the left eye. Right eye described as okay but possibly not as sharp as before. Blurring is noticeable when reading at work, viewing a smartboard from the back of the room, watching television, reading medication labels, and seeing signs while driving, especially at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Eye discomfort and light sensitivity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild left photophobia; needs to squint outdoors. Occasional dull ache around the left eye, not severe; no sharp pain. Slight consensual discomfort in the left eye when light is shone in the right eye."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Patient-reported ocular negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No eye discharge, gritty sensation, or itch. No flashes, floaters, curtain, or visual field loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Eye inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild ciliary flush around the left limbus. No obvious discharge or lid swelling. Right eye white and quiet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Pupils and relative afferent pupillary defect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal, round, and reactive. No relative afferent pupillary defect."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Extraocular movements and diplopia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Extraocular movements full; no diplopia."
      }
    },
    {
