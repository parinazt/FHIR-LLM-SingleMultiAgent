    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Difficulty initiating sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty falling asleep for approximately 9–10 months; usual sleep latency reported as 60–90 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep duration and awakenings on work days"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 4–5 hours of broken sleep on work days, with 2–3 awakenings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep duration on days off"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6 hours if the patient 'really pushes it'; sleeps in late on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep diary schedule"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over 2 weeks, bedtime ranged from 22:00 to 01:00 and wake time from 05:00 to 11:00, depending on shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep diary latency, awakenings, total sleep time, and efficiency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep latency 45–90 minutes; waking while asleep for 40–60 minutes; total sleep time 4–6 hours; sleep efficiency approximately 65–70%."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
