        "code": {
          "text": "Right wrist and hand inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild swelling from the radial styloid to the base of the thumb, without erythema. Local tenderness in the first dorsal compartment with palpable nodularity along the tendon sheath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
