    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Eye symptoms, left"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Much improved; now only a bit irritating after being really scratchy earlier in the week. No increased pain, photophobia, or decrease in vision from usual. Blurry without glasses is unchanged from usual. No mucopurulent discharge; watery tearing only. No foreign body since the original event. No contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "External eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right eye: no abnormality detected. Left eye: mild lateral conjunctival injection; no eyelid oedema, periorbital erythema, or tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left corneal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central cornea clear; faint inferolateral linear haze consistent with healing abrasion. No obvious foreign body, ulcer, or infiltrate seen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Pupils and eye movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal and reactive; no RAPD. Extraocular movements intact; no pain on movement."
      }
    },
