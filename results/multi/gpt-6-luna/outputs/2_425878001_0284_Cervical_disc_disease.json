        },
        "valueString": "Well, anxious."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Right arm numbness and tingling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased right arm numbness/tingling for 10–14 days. Described as pins and needles/cotton wool in a C6 pattern, extending from the lateral upper arm/forearm to the thumb and index finger. Initially intermittent, now present most of the day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right arm symptom triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms worsen with neck extension and computer work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Pain and perceived weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is not major; symptoms are mainly paraesthesia. Patient feels weaker when opening jars but reports no actual loss of function."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Balance and hand function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 2–3 weeks, reports slightly increased unsteadiness on uneven ground and mildly increased difficulty with buttons, but is managing. No falls."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
