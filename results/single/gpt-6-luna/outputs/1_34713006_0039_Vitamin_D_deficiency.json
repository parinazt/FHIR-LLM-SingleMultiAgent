    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Dry cough and associated reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for about 7 days, worse in the evening and when supine; no sputum, haemoptysis, shortness of breath at rest, wheeze, chest pain, pleuritic pain, fever or rigors. Mild increased fatigue; still mobilising with baseline four-wheeled walker and oral intake is okay. Nasal dryness and nocturnal throat tickle. No orthopnoea or paroxysmal nocturnal dyspnoea; leg oedema about the same as usual, no noticed weight gain, and nocturia unchanged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
