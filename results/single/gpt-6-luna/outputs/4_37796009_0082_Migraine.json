        "code": {
          "text": "General appearance and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tired but not in acute distress; anxious and repeatedly checking watch. Obese body habitus. Neurological examination grossly non-focal; speech normal. Mild neck and upper trapezius tightness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Analgesic and triptan use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses triptan approximately 4 days per month and NSAID approximately 8–10 days per month. Clinician documents use within limits and no medication-overuse headache currently."
      }
    },
