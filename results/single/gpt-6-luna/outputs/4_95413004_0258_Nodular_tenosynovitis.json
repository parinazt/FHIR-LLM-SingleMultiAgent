    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right radial wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain over the right radial styloid, worst 6/10 and decreasing to approximately 3–4/10 in the splint. Worse with lifting a kettle, opening jars, picking up shopping, and ulnar deviation with the thumb abducted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported right thumb and wrist creaking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grating or creaking, especially with the first few thumb movements in the morning and after prolonged typing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
