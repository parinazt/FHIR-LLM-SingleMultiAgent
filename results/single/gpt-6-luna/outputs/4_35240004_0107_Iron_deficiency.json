      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bilateral exertional leg pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Crampy, heavy ache in both calves, possibly extending to the thighs, right greater than left. Occurs after a few minutes of walking, for example walking from the train to school, and eases after a few minutes of rest. No nocturnal or rest pain reported. Onset unclear; patient alternates between saying last week and a few months ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
