        "medicationCodeableConcept": {
          "text": "Hyoscine hydrobromide 300 microgram tablets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet 30 minutes before travel; may repeat every 4–6 hours as needed; maximum 4 tablets in 24 hours.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "doseAndRate": [
