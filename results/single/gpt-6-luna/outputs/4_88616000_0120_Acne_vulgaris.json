    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Polycystic ovary syndrome (PCOS), stable with mild cycle irregularity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Acne course and symptoms reported at follow-up"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acne since late teens, worse over the last 2–3 years; fewer new pimples after starting topical treatment about 8 weeks ago. Occasional small pustule around periods. No painful nodules or cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Adapalene adherence and initial skin effects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses adapalene most nights, approximately 5 of 7 nights. Initially used it nightly and had dryness and peeling during the first 2 weeks, then reduced to alternate nights. Tolerating it now."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Acne-related marks and scarring"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mostly flat red/brown marks remain. Multiple erythematous/light-brown post-inflammatory macules and mild early shallow atrophic scars on both cheeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Facial acne examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few closed comedones and a few small inflammatory papules. No nodules or cysts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Upper back acne examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Few papules and macules on the upper back. No infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Body mass index"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 23"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "PCOS menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cycles approximately every 35–45 days, previously every 60–90 days. PCOS diagnosed at age 19; history of oligo-ovulation, polycystic ovaries on ultrasound, and elevated androgens."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Hirsutism and virilisation examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No increased hirsutism reported; no obvious hirsutism or virilisation on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Psychosocial impact and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A bit self-conscious and avoids photos on bad days, but continues university and work. Denies low mood and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Acne triggers perceived by patient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks chocolate, coffee during exam time, and inexpensive chemist sunscreen may flare acne."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Sexual activity and pregnancy plans"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not sexually active currently. No pregnancy plans in the next 12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Relevant history for hormonal treatment discussion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of VTE, migraine with aura, or smoking. Previously experienced weight gain and mood problems on the pill at age 19."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "At night, currently used approximately 5 nights per week."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Benzoyl peroxide 2.5% wash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "In the morning; patient uses it most mornings."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to all affected areas, not only individual spots. Increase as tolerated: use on alternate nights for 1 week, then nightly."
          }
        ]
      }
    }
  ]
