        "code": {
          "text": "Nausea associated with travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild nausea occurs in motion, especially in cars and boats; symptoms are not present at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Motion-associated spinning or lightheaded sensation and cold sweats"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a mild spinning or lightheaded sensation and cold sweats as a passenger in a car, especially on winding roads."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Travel symptom triggers and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms worsen when reading or using a phone in a moving vehicle, and improve when looking at the horizon, sitting in the front passenger seat, or when the vehicle stops."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vomiting during car travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports vomiting in a car a couple of times; timing is uncertain, possibly last month or the time before."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Nausea during flights"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flights sometimes cause nausea, especially during takeoff or landing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vertigo at rest and with positional changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent vertigo or true room-spinning at rest and denies vertigo when rolling over in bed or with quick head turns; currently asymptomatic at rest during the call."
