    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Neurological and fundoscopic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurological examination non-focal; cranial nerves intact; gait and coordination normal; no meningism; fundoscopy with no papilloedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vulval symptoms and examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports vulval bumps for 2–3 months, thought to be from shaving, with mild itch or irritation after sex or wiping. Examination: approximately 6–8 soft, skin-coloured/verrucous papules, 2–4 mm, on the labia minora and posterior introitus; non-tender, with no ulceration, vesicles, or discharge. Vagina and cervix normal; no inguinal lymphadenopathy. No significant pain or bleeding, and no systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sexual history and preventive care history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "One male partner for approximately 8 months; condoms mostly not used. No STI screen for a few years. HPV vaccination status uncertain; recalls receiving some vaccinations in high school."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Menstrual history and urine pregnancy test decision"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period approximately 2 weeks ago; no missed period. Urine HCG was offered and declined today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Relevant past medical history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No significant past medical history; no history of migraines, seizures, or clotting disorder."
      }
    },
