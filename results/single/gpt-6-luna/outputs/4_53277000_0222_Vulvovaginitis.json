        "status": "final",
        "code": {
          "text": "Vulvovaginal itch"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for approximately one week, worse at night, especially when going to bed; persistent external itch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vaginal discharge and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially white, cottage-cheese-like discharge, now much improved and minimal. Burning at the introitus has largely settled. No odour or post-vaginal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Patient-reported associated symptoms and negative findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies perianal itch on waking, worms seen in stool or around the anus, dysuria, urinary frequency, pelvic pain, abdominal pain, fever, rigors, and dyspareunia. Reports no gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no masses or suprapubic tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema of the labia majora and minora with excoriations from scratching. No fissures, ulcers, vesicles, or suspicious lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema from scratching; no worms, ova, burrows, or haemorrhoids."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
