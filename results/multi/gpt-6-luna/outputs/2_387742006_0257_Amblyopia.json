        "code": {
          "text": "Near visual acuity with current glasses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "In poor conditions: right approximately 6/12; left counting fingers at 1–2 m (known); binocular approximately 6/9."
      }
    },
    {
