    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Knee symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradually increasing bilateral knee pain over 12–18 months, right worse than left; dull ache, worse in the evening and after walking or standing, improved by rest and heat. Morning stiffness lasts less than 15 minutes. Intermittent evening knee swelling. No redness, locking, or giving way. No true night or rest pain. Long walks reduced and stairs avoided, but activities of daily living remain intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Hand symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain in DIP and PIP joints with bony knobbly areas, especially index and middle fingers; worse after gardening and tablet use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, weight loss, or night sweats reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General appearance on telehealth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress on screen, speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stood and walked into frame; mild antalgic gait favouring the right knee."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hand examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visible DIP bony swellings consistent with Heberden's nodes. No obvious erythema via video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
