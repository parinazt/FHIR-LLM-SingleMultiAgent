        "valueString": "Cardiovascular, respiratory, and ENT examinations unremarkable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g up to every 6 hours as needed; currently 2–3 doses most days",
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "g"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Withdrawal plan: limit to a maximum of 1 g twice daily on no more than 10 days per month in week 1."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "400 mg up to three times daily as needed; often 1–2 doses per day",
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 400,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Plan is to cease routine use; use only if absolutely necessary and not daily."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sumatriptan"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "50 mg as needed for migraine; used approximately 8–10 days per month",
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 50,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    },
