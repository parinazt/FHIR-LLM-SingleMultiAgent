    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Left scrotal transillumination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Positive at the last visit; not repeated today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Scrotal ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Moderate simple left hydrocele, with anechoic fluid around the left testis. Left testis normal size and echotexture, with no focal lesion and normal Doppler flow; epididymis unremarkable. Right testis and epididymis normal. No evidence of inguinal hernia or torsion. Report impression: simple left hydrocele; no sonographic evidence of testicular neoplasm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Recall and historian characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty recalling timelines and childhood history; gave contradictory accounts of when the swelling was first noticed ('maybe ages ago or maybe this month'). Vague recollection of a childhood issue described as 'hernia or something with the balls'; no records available and unable to name hospital or surgeon. Patient appeared reassured, but retention of detail was limited and key points were repeated."
      }
    },
    {
