    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Hand rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased flares over the last 6–8 weeks: dorsal hands and fingers become red, dry, fissured, and develop some small vesicles at the end of long bleach or dye days. Itching and burning are worse at the end of a shift and somewhat better on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Transient wrist and forearm welts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports transient raised, itchy welts at the wrists and forearms shortly after wet hair or dye exposure, where the gloves end; they settle within 1–2 hours without treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Forearm symptoms after product exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased stinging and redness on sun-exposed forearms after going out for lunch following use of certain products; possible photo component is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Pain and functional impact of hand fissures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports pain from fissures; shampooing and colouring are difficult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Dorsal hands and fingers examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Erythematous, dry, lichenified plaques with fine scale and shallow fissures over the MCPs; mild oedema; no warmth or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lateral finger examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "A few small clear vesicles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Palm examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and dryness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Wrist and forearm examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint post-inflammatory erythema band at the glove line; no active wheals."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Scalp examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythematous scaly plaques on the occipital scalp."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Facial, tongue, and respiratory findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial oedema, tongue swelling, or respiratory distress on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Reported systemic allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, wheeze, facial or tongue swelling, and generalized urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Usually twice daily as needed for flares; when severe, uses up to 4–5 times daily for a few days",
            "asNeededBoolean": true,
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "OTC hydrocortisone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used intermittently on the face for psoriasis",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene emollient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Applied mostly at night, when remembered",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone dipropionate 0.05% ointment (Diprosone)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply to affected hand areas twice daily for 7 days, then once daily for 7 days, then stop; use on rash only",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05%"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "For milder flares, apply twice daily as needed; maximum 7–10 days per month",
            "asNeededBoolean": true,
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    }
