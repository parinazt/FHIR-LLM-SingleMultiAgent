        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, swelling, erythema, or wasting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left shoulder palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender over the lateral deltoid insertion and upper trapezius. No bony tenderness over the clavicle, ACJ, or humeral head; no warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction to approximately 110°, limited by pain; forward flexion to approximately 150°, with pain at end range; external rotation mildly limited by pain; internal rotation painful when reaching behind the back. Passive range slightly greater than active, with pain only at end range and no hard block."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Left shoulder strength"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rotator cuff strength 5-/5, limited by pain but symmetrical; no focal weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Left shoulder special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful arc from 70–120°; Hawkins-Kennedy positive; Neer mildly positive; empty can painful with strength preserved; Speed and O'Brien equivocal."
      }
    },
