        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic for years, increased over the last 6–9 months with extra aged-care shifts and manual handling. Aching, sometimes sharp with bending or lifting; worse at the end of the day and after double shifts. Baseline 3–4/10, flares to 7/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain associated symptoms and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation below the buttocks and no neurological symptoms. Denies bowel or bladder symptoms, weight loss, fevers, night pain, trauma, or cancer history. No injury reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
