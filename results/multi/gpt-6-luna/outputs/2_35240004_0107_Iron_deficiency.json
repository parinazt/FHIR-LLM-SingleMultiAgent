          "text": "Ferro-grad C 325 mg (105 mg elemental iron + vitamin C)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet orally in the morning. If daily dosing is poorly tolerated, may trial alternate-day dosing and let the clinician know. Continue for at least 3 months after haemoglobin normalises, then a further 3 months to replenish stores; total approximately 3–6 months depending on results.",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
