    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right elbow pain, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain at the outer right elbow has persisted for approximately 9–10/12, intermittently and worse over the last 2–3/12. Local ache with sharp pain on lifting and gripping. Worse when scanning groceries, lifting bags, pouring a kettle, and gripping a steering wheel, especially with the forearm pronated. Improved with rest; occasional ibuprofen use. Occasional night pain when rolling onto that side, waking the patient a few times per week. Mild morning stiffness that settles quickly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right hand grip and functional impact, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Subjective decreased grip; occasionally drops heavier items. Pain increases during long, busy checkout shifts, requiring hand-swapping and brief breaks. Avoids heavy housework and gardening; activities of daily living are okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Relevant symptom negatives, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, locking, giving way, redness, warmth, or obvious swelling of the right elbow. No weight loss, fevers, night sweats, neck pain, paraesthesia, true weakness (weakness described as pain-limited), other joint pain, morning stiffness lasting more than 30 minutes, rash, or psoriasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no acute distress; moves the right arm somewhat cautiously."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right elbow examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity or visible swelling. Local tenderness over the right lateral epicondyle/common extensor origin; no medial epicondyle or olecranon tenderness and no warmth. Full flexion, extension, pronation, and supination. Pain reproduced on resisted wrist extension with the elbow extended and forearm pronated, and on resisted middle-finger extension. Right grip slightly decreased compared with the left due to pain. Neurovascularly intact; radial pulse present; no Tinel sign at the cubital tunnel. Brief cervical screen normal."
      }
    },
    {
