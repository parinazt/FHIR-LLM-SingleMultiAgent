    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent central low back ache, worsened over the last 5–6 days after helping grandkids with wood; patient thought he might have twisted. Pain is approximately 5/10 at baseline and up to 7/10 with bending or twisting, worse in the evenings and eased by curling up. May extend into both buttocks; no clear leg radiation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, leg weakness, foot drop, bladder or bowel incontinence, fever, night sweats, weight loss, recent infection, IV drug use, or cancer history. No trauma or fall reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mobility and morning stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobilises short distances at home and uses a single-point stick outdoors; reports being more stiff in the morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Prior potassium result"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Potassium previously peaked at 6.3 (unit not stated) and reportedly settled with insulin, dextrose, and fluids."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Estimated glomerular filtration rate"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 45 at hospital discharge; unit not stated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent potassium report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 10 days ago, the local clinic nurse reportedly told the patient his potassium was 'a bit up again'; no result value was available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Current symptoms with reported potassium concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels 'a bit sluggish'. Denies palpitations, chest pain, presyncope, frank muscle weakness, and shortness of breath; describes 'just old man weakness'."
      }
    },
    {
