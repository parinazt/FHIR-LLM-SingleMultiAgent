        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Mometasone 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply once daily to red or itchy hand areas only for up to 7 days, then stop; otherwise use moisturiser only. Avoid continuous daily steroid use.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
