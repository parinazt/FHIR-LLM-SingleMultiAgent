          "text": "Social anxiety disorder, chronic, currently exacerbated"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Social anxiety symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Social anxiety symptoms have been present for more than 2 years in most social or performance contexts involving perceived scrutiny. Over the last 3–4 months, avoidance has increased: often joins team video meetings with camera off or audio only, avoids monthly in-person office days, and skips social events including birthdays, drinks, and small dinners."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Anxiety associated with social events"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "When required to attend social events, reports anticipatory anxiety for days, and during events experiences palpitations, sweating, tremor, nausea, mind going blank, and strong fear of saying something stupid or being judged. Often leaves early or switches the camera off to calm down."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is disturbed before social events, with sleep latency increasing to 2–3 hours the night before; otherwise sleep is reasonable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "GAD-7 screening estimate"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 11–12 based on verbal answers; estimated in the moderate range."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "PHQ-9 screening estimate and depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Verbal screen: no anhedonia, significant low mood, guilt, psychomotor change, appetite change, or suicidal ideation; overall minimal depressive symptoms currently. Patient says she is not depressed, enjoys reading, walking, and TV, and reports energy is okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased work stress and isolation and has turned down promotion opportunities involving presentations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Safety and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no suicidal ideation, self-harm history, or suicide attempts. No aggression or psychotic symptoms reported."
      }
    },
    {
