        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "COVID primary course and one booster; unsure when the booster was given and unsure of last influenza vaccination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Diet and exercise"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes eating too much toast and not enough vegetables. Walks the dog for about 20 minutes most days and avoids heavier exercise because of concern about her back."
      }
    },
