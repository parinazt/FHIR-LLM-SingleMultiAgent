          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple sharply demarcated depigmented macules and patches on the dorsum of the hands, perioral area (described as a “milk moustache”), small eyelid patches, and older patches on the ankles and feet. Some follicular repigmentation on older ankle lesions and a few white hairs within lesions. No scale, erythema, or obvious dermatitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eyes grossly okay; no red eye or photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Thyroid examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thyroid not enlarged."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
