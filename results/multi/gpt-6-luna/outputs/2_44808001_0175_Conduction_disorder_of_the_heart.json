    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported rash for approximately 4–5 days: small red maculopapular spots on both forearms and the backs of the hands, with a few spots on the shins. Mildly itchy; no pain, blisters, weeping, or peeling. No rash on the face or trunk and no mucosal involvement. Described as non-purpuric, non-blistering, and non-painful."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated systemic, mucosal, and allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no fever, chills, arthralgia, eye symptoms, or mouth ulcers. No shortness of breath, wheeze, throat tightness, lip or tongue swelling, or generalized urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Cardiac symptoms and fluid status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no increase in palpitations, no presyncope or syncope, no chest pain, no increase in shortness of breath, no orthopnoea or PND, and no new oedema. Weight stable per patient."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
