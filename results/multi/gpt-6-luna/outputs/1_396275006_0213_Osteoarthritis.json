    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bilateral knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding pain for years, described as a dull ache in the medial and anterior knees. Worse with walking for more than 10–15 minutes, stairs, and prolonged standing; eased by rest and sitting. Occasional night pain, not waking her most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Bilateral knee stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stiff after sitting for more than 20–30 minutes and on waking; loosens after a few minutes of moving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Bilateral knee instability and near falls"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent subjective giving way in both knees for approximately 6–9 months, right greater than left, especially going down steps and getting up from a chair. Reports 3–4 near falls in the last 2 months, with no definite complete fall or head strike. Feels knees are wobbly and may buckle. Denies true locking and episodes of giving way with sharp severe pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Bilateral knee swelling and crepitus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports knees feel puffy at the end of the day and describes marked crepitus as “crack and grind all the time.” Denies redness and warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Bilateral knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bony enlargement and slight varus bilaterally; small effusions, right greater than left; mild bilateral medial joint-line tenderness. No erythema or warmth. No obvious ligament laxity on valgus or varus stress at 0° and 30°. Flexion to approximately 110° with end-range pain; extension near full; marked crepitus through range. McMurray negative for click or locking, with some medial discomfort only. No posterior tenderness or calf swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Gait and mobility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly antalgic gait with short stride and slow pace; cautious turning and mild varus knees. No walking aid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Hand pain and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent hand pain and stiffness, especially at the DIP and PIP joints with heavy use. No acute flare today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Several Heberden nodes at the DIP joints and some PIP nodes, with mild tenderness. No synovial thickening or warmth. Range of motion preserved, with slight discomfort at end range."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 in major muscle groups; light-touch sensation intact; reflexes normal; no focal deficit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Dizziness, syncope, and cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dizziness, syncope, chest pain, and palpitations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Trauma, infection, and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies recent trauma, infection, fevers, weight loss, and night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Inflammatory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies rash, eye inflammation, and inflammatory back pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Bowel, bladder, and neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies bowel or bladder incontinence, saddle anaesthesia, peripheral paraesthesia, and focal weakness apart from subjective “wobbly knees.”"
      }
    },
    {
