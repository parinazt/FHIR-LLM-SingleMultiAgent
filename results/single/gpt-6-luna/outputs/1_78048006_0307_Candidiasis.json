        "code": {
          "text": "Reported oral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild burning, especially with hot or spicy foods; mostly annoying and not really painful. Altered taste described as food tasting a bit funny or cottony."
      }
    },
    {
