        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Passive suicidal ideation: patient sometimes wishes they would not wake up. No plan or intent; no previous attempts reported."
      }
    },
