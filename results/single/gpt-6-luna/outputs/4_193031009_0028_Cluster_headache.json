        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply twice daily to red or itchy areas of the face for a maximum of 5–7 days, then stop; short bursts as needed for future flares.",
            "route": {
              "text": "topical"
            },
            "timing": {
              "repeat": {
