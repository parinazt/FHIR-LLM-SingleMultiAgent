    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported nasal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two days of bouts of sneezing, clear rhinorrhoea, nasal blockage, and mild itchy nose and eyes. Symptoms worse at work in a busy cafe. No sore throat, cough, shortness of breath, wheeze, sinus pain, fever, myalgia, headache, anosmia, or ageusia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sudden onset at approximately 3 am today of nausea, followed by four episodes of non-bloody, non-bilious vomiting and three episodes of watery brown diarrhoea. Mild crampy central and left lower quadrant pain before bowel movements, settling afterwards. Feels washed out and slightly light-headed on standing. Tolerating small sips of water and oral rehydration solution; last vomited approximately five hours ago. No solids since yesterday's breakfast. No recent antibiotics, travel, or known sick contacts; eats staff meals daily. Ate leftover chicken pasta yesterday; possible foodborne exposure. No urinary symptoms, vaginal bleeding, or vaginal discharge. LMP 10 days ago; cycles regular. No severe or localised abdominal pain, guarding, distension, jaundice, chest pain, shortness of breath, or rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
