        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply once daily to affected areas for a minimum of 2 weeks and continue for 1 week after resolution"
          }
        ]
      }
