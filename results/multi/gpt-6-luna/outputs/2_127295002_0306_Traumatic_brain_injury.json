    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Throat sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent sensation that the throat feels “weird,” like something is stuck there; throat pain mostly settled. Occasional mild scratchy feeling midline just above the sternal notch, not increasing. Symptoms began about 3 weeks ago with initial URTI."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Throat pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain rated 1–2/10, worse later in the day and better in the morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swallowing is okay; denies dysphagia to solids or fluids and denies odynophagia. Reports food goes down fine but the throat sometimes feels a bit tight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Voice"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly hoarse some evenings after work; otherwise normal. Voice was normal during consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cough and throat clearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional dry throat-clearing cough, especially in the afternoon; denies nocturnal cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heartburn a few nights per week, especially after spicy or fatty takeaway meals and late meals. Denies regurgitation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Constitutional and respiratory symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, chills, weight loss, night sweats, haemoptysis, shortness of breath, chest pain, or appetite change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Throat and neck red-flag symptom review"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies progressive dysphagia, unilateral otalgia, neck mass, stridor, drooling, and trismus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Energy drink intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Currently drinks about 3–4 cans of energy drink per day while working on site."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Alcohol intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports about 8–10 standard drinks per week, mainly weekend beer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Smoking and illicit drug history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-smoker; denies illicit drug use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Throat and neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral mucosa moist with no ulcers or thrush. Tonsils normal with no erythema or exudate; uvula midline. Mild posterior pharyngeal cobblestoning; no visible mass or lesion. No cervical lymphadenopathy; thyroid not enlarged or tender and no nodules. No palpable neck mass."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with equal air entry; no wheeze or crackles. No stridor."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Neurological screening examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person, place, and time; speech fluent, face symmetrical, power 5/5 in upper and lower limbs, gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Cognitive and neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports residual short-term memory issues and fatigue following traumatic brain injury. Denies seizures and new neurological symptoms today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Mood and mental status findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as “pretty stable overall, bit flat some days but coping”; during examination mood described as “OK,” with slightly constricted but reactive affect. Thought logical; no psychotic features. Insight good. Denies suicidal ideation, self-harm, hopelessness, and panic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is fragmented; stays up late on screens and has an irregular schedule. Often falls asleep on the couch half sitting up while watching TV."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-25",
        "status": "final",
        "code": {
          "text": "General appearance and interaction"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no acute distress, talkative, coherent, and engages well. Neatly and appropriately dressed."
      }
    },
