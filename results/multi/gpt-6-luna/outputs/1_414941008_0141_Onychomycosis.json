    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Lower abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower abdominal discomfort for 3 days, worse last night; dull ache across the lower abdomen, intermittent, non-colicky, non-radiating, rated 4–5/10. No clear trigger or relation to meals. Some relief after taking 2 Panadol. Not waking the patient from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated abdominal and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports daily formed bowel motions. Denies diarrhoea, constipation, PR blood, mucus, melaena, nausea, vomiting, dysuria, urinary frequency, urgency, haematuria, flank pain, testicular pain, fever, rigors, weight loss, night sweats, and anorexia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild generalised lower abdominal tenderness, left greater than right. No rebound, guarding, rigidity, focal RIF or LIF peritonism, epigastric or RUQ tenderness, masses, or organomegaly. Bowel sounds normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, comfortable, not toxic, and not jaundiced."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cardiovascular and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur. Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Brief genitourinary examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No CVA tenderness or obvious external hernia. Testes non-tender with no swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Toenail changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports thick yellow toenails for a couple of years, slowly increasing and mainly affecting the great toes; nails are crumbly and cosmetically bothersome. No current pain, redness, swelling, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Toenail examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral hallux nails yellow-brown and thickened with distal involvement of approximately 40–50% on the right and 30–40% on the left. Some subungual debris and mild onycholysis; other toenails mildly involved (<20%). No surrounding erythema, warmth, or swelling. No obvious tinea pedis today."
      }
    },
    {
