        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right radial wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain over the right radial styloid, worst 6/10 and reducing to approximately 3–4/10 in the splint."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right wrist and thumb pain triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is worse with lifting a kettle, opening jars, picking up shopping, and ulnar deviation with the thumb abducted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right thumb movement creaking and grating"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes grating or creaking, especially during the first few thumb movements in the morning and after long periods of typing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and trauma"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma, redness, warmth, fever, systemic symptoms, paraesthesia, and neck or elbow pain."
      }
    },
    {
