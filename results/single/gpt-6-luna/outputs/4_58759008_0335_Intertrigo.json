          ]
        },
        "code": {
          "text": "Chronic recurrent inframammary intertrigo, mild to moderate, possibly candidal"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Patient-reported inframammary rash symptoms and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash on and off for months, worse over the last 2–3 weeks; itchy, burning, red, and moist, with slight odour when worse. Increased with heat, sweating, wearing a bra all day, and gardening; improves when aired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Inframammary skin examination by video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral inframammary folds with erythematous, macerated, well-demarcated plaques; possible satellite papules. No obvious ulcer, pus, or clear cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and rash elsewhere"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, rigors, spreading erythema, pus, or systemic symptoms. No groin or perianal rash currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General appearance during telehealth examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-reported history of chronic conditions"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient denies diabetes mellitus, cardiovascular disease, or other chronic disease."
      }
    },
