    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Sleep history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Insomnia for approximately 3 months, worse over the last 4–6 weeks. Reduced sleep onset and maintenance; lies awake 1–2 hours, wakes 2–3 times nightly, and gets approximately 4–5 hours of broken sleep. Bedtime varies from 22:30 to 01:00; wakes at 06:00. Uses screens in bed and watches TV; sometimes falls asleep on the couch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Sleep-related habits and concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Drinks 3–4 coffees daily, last at approximately 16:00–17:00, and occasional energy drinks. Drinks 1–2 glasses of wine 3–4 nights per week to wind down; reports sleep remains poor. Worries about work at night and says her brain will not switch off. Wakes with dry mouth and feels unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported sleep-disordered breathing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner reports no snoring; no witnessed apnoea or waking choking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Daytime fatigue and driving safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daytime fatigue; no near-miss driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Migraine history and frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Migraine without aura for several years; previously approximately 2 days per month, now 5–6 days per month over the last 2 months. Patient links increased frequency to poor sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Typical migraine features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Unilateral throbbing headache with nausea, photophobia, and phonophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Migraine red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No thunderclap headache, focal neurological symptoms, visual loss, speech issues, fever, or neck stiffness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Analgesic and triptan use frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses triptan approximately 4 days per month and NSAID approximately 8–10 days per month. No opioids. Clinician documents use within limits and no medication-overuse headache currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Long-standing anxiety; increased stress, workload, and ruminations. No panic and no suicidal ideation. Previously benefited from CBT, stopped because of work."
      }
    },
