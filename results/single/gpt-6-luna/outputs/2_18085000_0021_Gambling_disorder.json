      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Psychiatric history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports past psychiatric contact in his 20s after a major workplace conflict in which he smashed a glass. Was told he had a personality disorder, 'kind of borderline'; describes impulsivity and reacting strongly when people upset him. Participated in DBT groups and stopped. No current psychiatrist, no current medications, and no past psychiatric admissions reported."
      }
    },
