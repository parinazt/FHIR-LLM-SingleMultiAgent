        },
        "valueString": "No weight loss or night sweats; reports being tired all the time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Right upper quadrant ultrasound findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prior ultrasound report reviewed from a phone image: multiple gallstones, largest 9 mm; gallbladder wall normal; no pericholecystic fluid; common bile duct 5 mm with no dilatation; no intrahepatic duct dilatation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
