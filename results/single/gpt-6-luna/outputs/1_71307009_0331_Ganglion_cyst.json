        "code": {
          "text": "Right dorsal wrist swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1.5–2 cm, soft, fluctuant, well-circumscribed swelling over the scapholunate area on the dorsum of the right wrist. The patient reports that the lump fluctuates in size."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache with occasional sharp twinge on extension, up to 5/10, worse at the end of the day and after a big day on the computer. Interferes with typing and mouse work. No pain at rest or at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right wrist examination: range of motion and local findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full flexion and extension, with slight pain and discomfort only at terminal extension; mild tenderness to palpation. No erythema or warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right wrist neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; good capillary refill, radial pulse present, sensation intact in median, ulnar, and radial distributions, and normal grip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported right wrist-associated symptoms and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies numbness, tingling, weakness, dropping objects, fever, weight loss, and night sweats. Denies trauma but later said she might have knocked the wrist at the gym."
