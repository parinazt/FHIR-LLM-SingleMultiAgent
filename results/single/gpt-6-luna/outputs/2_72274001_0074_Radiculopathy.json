        },
        "dosageInstruction": [
          {
            "text": "Start 10 mg at night for 7 nights, then increase to 20 mg at night if pain persists and the medicine is tolerated.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
