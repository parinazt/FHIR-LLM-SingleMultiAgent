        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partial fist only. Triggers from flexion to extension and needs assistance on 2 of 3 attempts. Passive range of motion full and mildly tender. Palpable or audible click."
      }
