          ],
          "text": "Chronic social anxiety disorder, currently exacerbated"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Social and work-related avoidance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increasing avoidance over the last 3–4 months: often keeps the camera off or joins work video meetings by audio only, avoids monthly in-person office days, and skips social events including birthdays, drinks, and small dinners. Reports increased work stress and isolation and turning down promotion opportunities involving presentations."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Anxiety symptoms associated with social or performance situations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports anticipatory anxiety for days before social events, with palpitations, sweating, tremor, nausea, mind going blank, and strong fear of saying something stupid or being judged during events. Often leaves early or switches the camera off to calm down. Reports symptoms for more than two years in most social or performance contexts involving perceived scrutiny."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is disturbed before social events, with sleep latency increased to 2–3 hours the night before; otherwise sleep is described as reasonable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "GAD-7 screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Verbal estimate, time limited: approximately 11–12, described as in the moderate range."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "PHQ-9 screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Verbal screening: reports no anhedonia, significant low mood, guilt, psychomotor change, appetite change, or suicidal ideation; overall described as minimal depressive symptoms currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Mood and interest"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient says she is not depressed and feels frustrated with herself. Reports enjoying reading, walking, and TV; energy and appetite are okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Safety and mental health symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no suicidal ideation, self-harm history, or suicide attempts. No aggression or psychotic symptoms reported. Note records good insight and some family support by phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 3–4 coffees by midday, with more on busy or stressful days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Alcohol and illicit substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 1–2 standard drinks on weekends, rarely more, and denies binge drinking. Reports no illicit substance use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Telehealth behavior"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Joined on time with camera initially off and turned it on after prompting. Visibly anxious and fidgeting, avoided eye contact with the camera, spoke slightly pressured, and frequently checked the time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Video examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well groomed and appeared stated age. Color normal; work of breathing normal and speaking in full sentences. Speech normal rate and volume, coherent; thought form logical. Affect anxious and congruent. No obvious tremor at rest or intoxication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
