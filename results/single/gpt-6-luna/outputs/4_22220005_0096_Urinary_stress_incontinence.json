          "text": "Urinary leakage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent leakage of small volumes with coughing, sneezing, lifting, and laughing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Lower urinary tract symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Stress-pattern leakage only. No urgency or urge incontinence. Frequency approximately 5–6 times daily, at baseline. Nocturia 0–1 times nightly, longstanding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported suprapubic pressure or tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild, intermittent awareness of pressure or tenderness above the pubic bone for approximately one week; non-radiating with no clear trigger."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Urinary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria, frank haematuria, malodour, fever, rigors, flank pain, nausea, or vomiting."
      }
    },
    {
