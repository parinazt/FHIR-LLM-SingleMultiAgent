          "value": 25,
          "unit": "kg/m2"
        },
        "note": [
          {
            "text": "Approximately."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Knee inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No erythema or effusion. Prominent tibial tuberosities, right greater than left; mild soft tissue swelling over the right tibial tubercle. Localized tenderness to palpation of both tibial tuberosities, right greater than left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Knee range of motion and provocative examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion; mild discomfort at end-range flexion and with resisted extension on the right. Ligaments stable; Lachman, drawer, varus, and valgus tests negative. Meniscal tests and patellar apprehension test negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gait and lower-limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gait essentially normal, with slight antalgic gait after repeated squats. No lower-limb neurovascular deficit."
      }
    },
