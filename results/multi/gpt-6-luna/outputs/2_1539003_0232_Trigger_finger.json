        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ring finger locking and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Finger catches/locks, especially in the morning; stiffness lasts 10–15 minutes then eases. Sometimes needs the left hand to straighten it."
      }
    },
    {
