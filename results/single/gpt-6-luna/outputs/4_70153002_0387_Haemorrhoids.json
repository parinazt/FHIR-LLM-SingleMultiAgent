    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Anal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe, constant, throbbing pain for 3–4 days, with sudden onset after hard stool and straining; worse with bowel movements and sitting. Described as feeling like sitting on a marble."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Rectal bleeding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small amount of bright red blood on toilet paper and a few spots on stool for 2 days only; blood was not mixed with stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right lateral margin: approximately 1.5–2 cm tense bluish-purple, exquisitely tender swelling, consistent with thrombosed external haemorrhoid. Skin intact; no ulcer, active bleeding, erythema, or fluctuance. Old small skin tag at 6 o’clock. No fissure seen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Digital rectal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Deferred because the examination was too tender, with a clear external cause and no red flags."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Vital signs and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Associated gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a long history of constipation and holding on at work. Denies diarrhoea, mucus, change in stool calibre, abdominal pain, weight loss, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
