    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports intermittent dull left-sided headache, 2–3/10, more of a nuisance and worse when overtired. Denies sudden severe headache, early-morning vomiting, and headache waking him at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Memory and cognition"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Daughter has reportedly said he is a bit more forgetful; he misplaces items and repeats questions. Patient feels he has always been absent-minded. He is not getting lost in familiar places and continues basic routines. Some delay recalling exact dates."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Gait and balance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit wobbly, especially on first standing or in dim light. Reports furniture-walking indoors and unsteadiness on quick turns. One near-fall while turning quickly in the kitchen in the past 2 weeks; caught himself on a bench. Denies further actual falls since discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent with basic self-care but slower; sits for showering due to fear of falling. Manages simple meals. Has stopped ladder work, roof work, and garden work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Instrumental activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not driving as advised by hospital. Relies on daughter for shopping and transport to appointments. Daughter has arranged direct debit for bills; patient is not managing complex finances himself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; wakes 2–3 times overnight thinking. Denies nocturnal headache waking him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies low mood. Acknowledges frustration about decreased independence. Suicidal ideation denied."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies diplopia and acute visual loss. Occasionally reports eyes feeling a bit fuzzy when tired, possibly due to strain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Speech and swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysarthria, dysphasia, and swallowing issues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Seizure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No seizure history before or after the subdural haematoma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "New neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "When asked directly, denies facial asymmetry, limb weakness, and numbness. Specifically denies new focal weakness, new incontinence, acute visual loss, and rapid increase in confusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Telephone consultation mental status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and conversant; oriented in conversation to person, place, and time. Engaged, polite, and coherent. Able to recount the hospital stay and current daily routine; story overall consistent, with some delay recalling exact dates."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Speech on telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech fluent, with no word-finding difficulty over the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory status on telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences; no audible shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "CT brain report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hospital discharge summary reports CT brain approximately 6 weeks ago: “Post burr hole evacuation L fronto-parietal chronic SDH small residual collection minimal midline shift no acute haemorrhage no hydrocephalus”. No repeat imaging since."
      }
    },
