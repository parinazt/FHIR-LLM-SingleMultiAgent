        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Days 1–3: 1 sachet hourly up to a maximum of 8 sachets per day; may space to 2-hourly if cramps or bloating. Aim for large stool output or clear liquid stools.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "h"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "sachet"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
                "value": 8,
                "unit": "sachets"
              },
              "denominator": {
                "value": 1,
                "unit": "day"
              }
            }
          },
          {
            "text": "Then take 1–2 sachets daily ongoing; titrate to keep soft stool at least every 1–2 days. Do not stop once better.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
