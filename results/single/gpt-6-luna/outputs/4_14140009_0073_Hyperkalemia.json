    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent mechanical low back pain worsened over the last 5–6 days after helping grandkids with wood; dull central ache, possibly into both buttocks, with no clear leg radiation. Pain about 5/10 at baseline and up to 7/10 with bending or twisting; worse in the evenings and eased curled up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma or fall, saddle anaesthesia, leg weakness, foot drop, bladder or bowel incontinence, fever, night sweats, weight loss, recent infection, intravenous drug use, and cancer history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mobility and low back examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mobilises short distances at home and uses a single-point stick outdoors; stiffer in the morning. On video, able to stand and turn slowly and independently, with grimacing on lumbar flexion and extension. Short, slightly stooped, slow but steady gait with stick; no obvious foot drop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Lower-limb gross neurological findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Moves both legs against gravity and can heel- and toe-stand with chair support; no obvious focal weakness. Patient reports sensation is normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Previous potassium"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Previous peak potassium was 6.3 during admission about 3 months ago; it settled with insulin, dextrose, and fluids. Unit not stated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent potassium report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Local clinic nurse reportedly said potassium was 'a bit up again' about 10 days ago; no result value available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Kidney function at hospital discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "eGFR approximately 45 at discharge about 3 months ago; unit not stated."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Symptoms in the setting of hyperkalaemia risk"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling 'a bit sluggish'. Denies palpitations, chest pain, presyncope, frank muscle weakness, and shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Potassium intake and dietary history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased fresh fruit intake since admission, including bananas most mornings, and use of a 'low salt' substitute described as likely potassium chloride based. Limited access to fresh food and increased tinned and processed food."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Community blood glucose readings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Community nurse checks blood glucose 2–3 times per week; readings often 14–15 and sometimes 8–9. Units not stated. Patient has no own glucometer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
