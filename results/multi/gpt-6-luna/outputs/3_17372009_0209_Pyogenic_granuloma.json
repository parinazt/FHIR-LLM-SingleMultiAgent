        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right index finger lesion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsolateral aspect just distal to the PIP joint: approximately 5–6 mm red, friable dome-shaped papule on a narrow stalk with a moist surface. Mild bleeding on light contact during examination, settling with direct pressure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right index finger lesion-associated findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No surrounding erythema, warmth, induration, or pus. No pigment or atypical borders noted; no nodes or systemic symptoms reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right index finger range of motion and neurovascular findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full active and passive range of motion at the PIP, DIP, and MCP joints without pain. Sensation intact; capillary refill normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Hand function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Grip strength within normal limits bilaterally; able to make a full fist and open the hand against resistance. Fine motor function intact; able to fast finger tap, count coins, and simulate till use without difficulty."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Gait and stance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent gait with normal pattern and stable stance; able to fully weight bear. No issues noted while walking to the door."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right index finger lesion symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports an intermittent bleeding lump noticed approximately 4–5 weeks after a box-cutter nick. It bleeds especially when using the till or handling notes and is irritating and a nuisance rather than painful; it affects work tasks and requires stopping to apply bandages. Patient reports no fevers, spreading redness, reduced hand range of motion, or other skin lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reported being 'a bit tired lately'; fatigue was not further assessed today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Immediate post-vaccination observation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No immediate adverse reaction during 10 minutes of observation after vaccination."
      }
    },
