    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp pain at night when lying on the right side, described as like someone jabbing a match in the ear; settles when he turns over or rubs it and recurs when he lies on it again. Ongoing approximately 3–4 months and getting worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports approximately 4–5 hours of broken sleep and repeated waking due to right ear pain. No difficulty getting to sleep. Denies low mood, racing thoughts, and early waking independent of the ear pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right upper ear lump"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small painful lump on the upper right ear, present for approximately 6 months; worse with pressure from the pillow and sometimes crusty. No discharge or bleeding other than cracking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right ear associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hearing loss, tinnitus, vertigo, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sun exposure and skin cancer history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports heavy lifetime sun exposure, including years of driving with the window down and frequent ear sunburn. No known past skin cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right helix and upper antihelix examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6–7 mm firm, tender, dome-shaped nodule with superficial central erosion and slight scale/crust, mild surrounding erythema, and very focal tenderness to light pressure. No fluctuation or warmth. No obvious rolled edge or pearly lesion, though crust partly obscures the lesion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
