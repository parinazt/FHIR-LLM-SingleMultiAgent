    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported occupational hand rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 6–8 weeks, increasing flares of redness, dryness, fissures and some small vesicles on the dorsal hands and fingers, especially at the end of long bleach or dye workdays. Itching and burning worsen at the end of shifts and are somewhat better on days off. Fissures are painful and make shampooing and colouring difficult."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported transient welts at glove edges"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Raised, itchy welts occur at the wrists and forearms shortly after wet hair or dye exposure where the gloves end, and settle within 1–2 hours without treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported forearm reaction after product exposure and sun exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased stinging and redness on sun-exposed forearms when going out for lunch after using certain products; a photo component is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Hand skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsal hands and fingers with erythematous, dry, lichenified plaques, fine scale, shallow fissures over the MCP joints and mild oedema; a few small clear vesicles on the lateral fingers. Palms with mild erythema and dryness. No warmth or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Wrist and forearm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Faint post-inflammatory erythema in a band at the glove line; no active wheals at examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Scalp skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythematous scaly plaques on the occipital scalp, consistent with psoriasis; mild scalp scale reported as stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Facial, oral and respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial oedema, tongue swelling or respiratory distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Reported absence of systemic allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, wheeze, facial or tongue swelling, and generalized urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reported exposure and skin-care practices"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually wears powdered latex gloves, with hands damp underneath; nitrile gloves are available but are perceived as inconvenient when busy. Frequent handwashing with standard liquid soap and hot water. Uses sorbolene emollient mostly at night when remembered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Previously instructed to use twice daily as needed for flares; reports using up to 4–5 times daily for a few days when the rash becomes severe. Helps, but use is delayed until the rash is severe.",
            "route": {
              "text": "topical"
            },
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Over-the-counter hydrocortisone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used intermittently on the face for psoriasis"
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene emollient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Applied mostly at night when remembered",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone dipropionate 0.05% ointment (Diprosone)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply twice daily to affected hand areas for 7 days, then once daily for 7 days, then stop. Use on rash only.",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.05%"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "After the current flare treatment, use for milder flares twice daily as needed, maximum 7–10 days per month.",
            "route": {
              "text": "topical"
            },
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-3",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-3",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine 10 mg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "For itch or urticaria; may use regularly during periods of high exposure.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
