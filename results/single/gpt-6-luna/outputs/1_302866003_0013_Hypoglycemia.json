    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "unknown",
        "medicationCodeableConcept": {
          "text": "Unspecified oral diabetes tablets (patient-reported; one may possibly be a sulfonylurea)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Patient reports having run out of diabetes tablets; last script from another GP was possibly 3 months ago or longer. Unable to identify medicines or doses. Patient thinks one medicine may cause low blood sugar if meals are missed. Previous regimen and current use are unclear."
          }
        ]
      }
