        "code": {
          "text": "Suicidal thoughts and self-harm"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies wanting to hurt herself and denies suicidal intent; reports some thoughts of “wanting to disappear.” No plan or intent reported. No previous attempts."
      }
    },
    {
