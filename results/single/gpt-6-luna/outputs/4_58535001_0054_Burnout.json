        "code": {
          "text": "Work attendance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased sick leave over the last 6 weeks: four separate days off and leaving early twice. Describes absenteeism as her only coping strategy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
