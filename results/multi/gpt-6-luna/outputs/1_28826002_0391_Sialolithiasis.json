    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent left submandibular swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for 1 week; described as tight/achy, especially with meals and worse with sour or large meals. No constant pain; settles after approximately 30–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fevers, rigors, dysphagia, shortness of breath, trismus, dental pain, foul taste, and dry mouth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Neck and salivary ultrasound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4 mm echogenic focus in the distal left Wharton's duct with posterior acoustic shadowing, consistent with sialolithiasis; mild proximal duct dilatation; no mass or abnormal lymph nodes."
      }
    },
