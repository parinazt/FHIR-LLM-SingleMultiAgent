        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg weakness or numbness, bowel or bladder symptoms, or saddle anaesthesia. No weight loss, fever, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
