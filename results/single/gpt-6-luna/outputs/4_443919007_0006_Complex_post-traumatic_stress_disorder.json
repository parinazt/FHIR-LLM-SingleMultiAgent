    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Irritability and anger outbursts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing increased irritability at home and work, including blowing up at partner and customers, raising voice, and throwing things twice last month. No physical violence. Symptoms have worsened over the last 3–4 months and are impacting work and home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports decreased concentration, drifting off at work and becoming stuck in thoughts. Some difficulty maintaining focus on longer questions during assessment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Sleep and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleeps 4–5 hours per night with multiple wakings. Recurrent nightmares about past trauma; wakes sweaty with heart racing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Trauma-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased startle, hypervigilance, avoiding crowds, intrusive memories, and ongoing emotional numbing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports drinking 3–4 premix cans most nights, up to approximately 8 on weekends; denies morning drinking. Partner is concerned. Patient minimises use and says alcohol helps with sleep. No history of withdrawal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cannabis use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports smoking a couple of cones before bed most nights. Patient says cannabis helps with sleep and is not ready to set a firm reduction target."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation and says she does not want to hurt herself; reports some thoughts of wanting to disappear, with no plan or intent. Protective factors stated: partner, siblings, and job."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Thoughts of harming others"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies thoughts of harming others; fears losing control verbally only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, guarded, and engages with encouragement; occasionally tearful when discussing nightmares. Appropriate appearance and good hygiene. Tense, fidgety, scanning the room, and reluctant to elaborate unless prompted. Speech normal in rate and volume, becoming louder when describing conflict. Mood: “pissed off all the time.” Affect irritable and mildly anxious, congruent and reactive. Thought form linear and goal-directed. Intrusive trauma memories; no delusions. No hallucinations. Cognition grossly intact. Insight partial; judgement intact regarding safety."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Past psychiatric history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no history of mania, psychosis, or previous suicide attempts."
      }
    },
