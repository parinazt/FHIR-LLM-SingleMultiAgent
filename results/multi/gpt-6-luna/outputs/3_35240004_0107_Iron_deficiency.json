    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Bilateral leg pain on walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes a crampy, heavy ache in both calves, possibly extending to the thighs, right worse than left. Occurs after a few minutes of walking and eases after a few minutes of rest; no nocturnal pain. Onset unclear: patient alternately reports last week or a few months ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
