    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported rash and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash for approximately 10 days, starting on the flexor forearms and later appearing as a few patches on the anterior neck and upper chest. Itching is mild to moderate and worse in the evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Rash-associated findings and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blistering, weeping, pus, or mucosal involvement reported. No history of eczema or psoriasis. No new medications. New natural laundry liquid used for approximately 2 weeks; burns inexpensive incense at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flexor forearms with scattered erythematous patches/thin plaques 1–3 cm, mild dry scale and some excoriations; no vesicles, pustules, or infection. A few small erythematous papules/patches on the anterior neck and upper chest. No target lesions or urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose stools on 3–4 days per week, up to 3–4 times per day, for 3–4 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Bloating and abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bloating and crampy lower abdominal pain. Patient reports symptoms probably settle when eating better."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Bowel symptom red-flag negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rectal blood or mucus, weight loss, fever, or nocturnal diarrhoea reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Recent diet"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diet adherence has been poor recently, with increased apples, fruit juice, and muesli bars."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft with mild bloating and mild left-lower-quadrant greater than right-lower-quadrant tenderness. No peritonism or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Stress and mood screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes feeling 'just exam stress'. No red-flag mood symptoms on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Diet adherence barriers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Exam stress and reduced finances are affecting diet adherence. Cost and time are barriers to dietitian support; patient will self-manage for now."
      }
    },
    {
