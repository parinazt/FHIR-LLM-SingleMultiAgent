        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies clear shortness of breath, chest pain, fever or rigors, black or bloody stools, haematemesis, new bruising, epistaxis, and new confusion. No breathlessness at rest. Wife says he is about the same and is keeping an eye on him."
      }
    },
