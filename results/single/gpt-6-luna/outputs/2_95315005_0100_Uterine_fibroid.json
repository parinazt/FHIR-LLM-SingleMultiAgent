    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain duration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 3 weeks; gradual onset."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain characteristics and severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache across the lumbar area, right greater than left; 4–5/10 at baseline and up to 7/10 after prolonged sitting or bending to pick things up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Low back pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse at the end of a work day involving prolonged sitting; improved by lying flat and using a heat pack. The patient thinks a new mattress or sitting posture at work might contribute."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Low back pain associated and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg radiation, numbness, tingling, weakness, saddle anaesthesia, bladder or bowel issues, night pain waking her from sleep, trauma, falls, motor vehicle accident, fever, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Periods have been heavier and more painful for approximately 12–18 months, with clots for 2–3 days each cycle. Cycles are regular, every 28–30 days. No intermenstrual bleeding or postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Pelvic symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pelvic heaviness described as a dragging sensation around menses; occasional low back ache at the same time. No acute severe pelvic pain, dysuria, abnormal vaginal discharge, or current sexual activity. Bleeding is heavy but not flooding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels fatigued, especially around periods; no previous full blood examination or iron studies reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Uterine fibroid history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a uterine fibroid diagnosed on pelvic ultrasound elsewhere approximately 2 years ago (around 2023), described to her as about the size of a plum."
      }
    },
