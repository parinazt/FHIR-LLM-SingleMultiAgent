        "code": {
          "text": "Nicotine withdrawal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports anxiety worsens when longer between cigarettes. When cutting down, reports irritability, anxiety, decreased concentration, and being snappy."
      }
    },
