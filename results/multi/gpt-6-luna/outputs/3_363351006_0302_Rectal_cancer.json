        },
        "valueString": "Appetite not great on and off since cancer treatment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal discomfort and bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing intermittent lower abdominal discomfort and looser stools, described as having been present for ages."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies persistent vomiting and marked abdominal distension; still passing flatus and stool. Denies significant rectal bleeding, but reports sometimes having a little blood on the paper."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
