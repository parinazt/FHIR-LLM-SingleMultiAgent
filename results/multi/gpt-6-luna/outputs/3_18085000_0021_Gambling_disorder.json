    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported gambling pattern and related effects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports gambling on electronic gaming machines most days, mainly at his workplace venue and sometimes at a nearby club, with some late-night online sports betting. Ongoing for at least 12 months and worse since venues reopened after COVID. Reports preoccupation with which machine is due, including at dinner with his mother; difficulty controlling gambling, staying for hours despite planning to leave with $50 by 9 pm, and spending a few hundred dollars. Reports spending approximately $1,200 over three nights last week. Reports credit card and Afterpay debt, a small personal loan, increased conflict with his ex-partner about child support, and reduced gym and fishing activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and depressive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling flat and stressed in relation to gambling losses and debt. No persistent low mood or anhedonia outside the gambling context."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
