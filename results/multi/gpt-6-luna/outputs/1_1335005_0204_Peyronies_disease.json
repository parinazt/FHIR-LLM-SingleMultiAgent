    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "New gradual mid-to-lower central back pain, slightly right-sided, for approximately 5–6 days, with no clear injury or leg radiation. Dull, tight ache rated 4–5/10 at baseline and up to 7/10 after a large work day. Worse at the end of the day on concrete, first thing in the morning, and with bending, lifting ladders or tools, prolonged standing, and driving on a rough farm track. Eases somewhat after moving; lying flat, heat pack, and ibuprofen provide relief. Patient wonders whether a new firmer mattress and increased ute driving on a rough driveway contributed. Ibuprofen 400 mg twice daily as needed for the last 3 days has provided partial relief. Still working and pacing himself, avoiding heavy lifting; no time off work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "By history, no trauma or fall; no saddle anaesthesia, leg weakness, numbness, or paraesthesia; no bowel or bladder incontinence or urinary retention; no fevers, night sweats, unexplained weight loss, or unrelenting nocturnal pain; no known cancer or systemic illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Neurological and mobility symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no limb weakness, paraesthesia, or gait disturbance. By his own report, he is mobilising okay and can heel-toe walk, squat, and climb stairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Urinary stream normal; no frequency or urgency; no change in baseline nocturia of once nightly. No dysuria, haematuria, or discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Constitutional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No unexplained weight loss or fevers. Reports fatigue only in the context of poor sleep from pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Penile curvature and plaque"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports penile curvature is about the same over the last few months. History of a palpable plaque."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Erectile symptoms and intercourse discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports mild erectile symptoms: it takes a bit more effort. No complete erectile dysfunction. Reports some discomfort with intercourse and no penile pain at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
