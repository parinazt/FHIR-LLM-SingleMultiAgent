      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Recent temperature trend and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Initially had fevers and rigors with fatigue. In the last few days temperatures have been below 37.8; feels washed out but somewhat better."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Rash and skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rapid-onset painful raised red plaques on the face, neck and forearms, present for approximately 3–4 weeks. Multiple well-demarcated raised erythematous violaceous plaques on cheeks, neck and dorsal forearms, some coalescing; surface smooth. Still present, slightly less tender than last week. Patient describes them as looking angrier in the evenings. Pain is burning/tender rather than itchy; tender to touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
