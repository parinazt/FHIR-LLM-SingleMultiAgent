        "code": {
          "text": "Other focused review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No haemoptysis, new focal neurologic deficit, pain-unrelated gait change, urinary retention or incontinence, or constitutional symptoms. Appetite is okay."
      }
    },
