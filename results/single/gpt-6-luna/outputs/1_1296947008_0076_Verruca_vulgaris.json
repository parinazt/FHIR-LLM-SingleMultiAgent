        "code": {
          "text": "Right thumb subungual lesion examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Subungual/verrucous lesion approximately 3–4 mm at the distal nail bed, with mild hyperkeratosis. No erythema, warmth or pus; nail plate intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
