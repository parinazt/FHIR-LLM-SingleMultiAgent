        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Panic attacks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Panic attacks 2–3 times per week, lasting 10–15 minutes and resolving spontaneously; palpitations, shortness of breath, tremor, and fear she will lose control and do something stupid."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
