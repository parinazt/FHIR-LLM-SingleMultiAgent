    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding intermittent mechanical low back pain, worsened over the last 5–6 days after helping grandchildren with wood and possibly twisting awkwardly. Dull central low back ache, sometimes into both buttocks, with no clear leg radiation. Pain about 5/10 at baseline and up to 7/10 with bending or twisting; worse in the evenings and eased by curling up. No trauma or fall."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain red-flag screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies saddle anaesthesia, leg weakness, foot drop, bladder or bowel incontinence, fever, night sweats, weight loss, recent infection, IV drug use, and cancer history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
