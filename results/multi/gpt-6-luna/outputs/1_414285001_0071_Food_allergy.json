    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Intermittent solid-food dysphagia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported for approximately 6–9 months. Food feels stuck mid-chest, especially bread and meat; needs sips of water and occasionally regurgitates food back up."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Episodes of food sticking with coughing or regurgitation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two episodes in the past month in which the patient had to stand and cough food back out. She thought she was choking but could still breathe; no complete obstruction."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Central chest tightness during food-sticking episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occurs during episodes and settles 10–15 minutes after food passes. Not exertional and not associated with walking uphill."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Retrosternal burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occurs approximately 2–3 times per week, especially after late takeaway meals and worsened by coffee and spicy food; some relief with Gaviscon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Globus sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional, especially at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Egg-associated allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Since her teens, raw or undercooked egg has caused hives and lip swelling approximately 30 minutes after exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Tree-nut-associated allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Years ago, an unspecified tree nut in a mixed-nut bar was associated with hives and lip swelling; the specific nut is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Recent food-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three episodes in the past 6–9 months after certain meals, possibly involving almond milk when eating out: itchy throat, mild perioral tingling, and patchy erythematous itchy rash on the forearms about one hour later. Patient felt a little wheezy with chest tightness. No stridor, collapse, or gastrointestinal symptoms; episodes resolved without medication."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
