        "code": {
          "text": "Right ankle weight bearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to weight bear for more than 4 steps in the room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Right ankle neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; dorsalis pedis and posterior tibial pulses palpable; capillary refill under 2 seconds."
      }
    },
    {
