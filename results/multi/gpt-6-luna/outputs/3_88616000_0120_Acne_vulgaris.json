          "text": "Adapalene 0.1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "At night, actually used about 5 nights per week",
            "route": {
              "text": "topical"
            }
          }
        ]
      }
    },
