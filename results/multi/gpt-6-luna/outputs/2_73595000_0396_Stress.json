        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing; mildly anxious and frequently referring to written list."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleep-onset insomnia with rumination about work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Stress and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes feeling “stressed and abit overwhelmed” and reports high work stress over the last 2–3/12, feeling “constantly on edge” and unable to switch off. Denies persistent low mood, anhedonia, hopelessness, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
