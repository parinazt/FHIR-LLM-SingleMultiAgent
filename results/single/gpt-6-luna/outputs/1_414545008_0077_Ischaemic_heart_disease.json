        "code": {
          "text": "Palpitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief self-resolving episodes of fluttering in the chest about once every 1–2 weeks, lasting a few minutes. No presyncope, syncope, or chest pain with the episodes. No recent hospital admissions."
      }
    },
    {
