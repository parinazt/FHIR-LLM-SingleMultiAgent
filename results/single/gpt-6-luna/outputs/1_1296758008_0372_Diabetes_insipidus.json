        "status": "final",
        "code": {
          "text": "Increased urination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased urination for 2–3 days, describing “weeing heaps.” Over the last 24 hours, estimates passing large volumes of clear urine, approximately 300–350 mL hourly, including for 3–4 hours overnight; measured at home in a jug."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Thirst and fluid intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels thirsty and reports drinking approximately 4–5 L/day, similar to previous poor control of diabetes insipidus but slightly increased over the last few days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, haematuria, suprapubic pain, flank or loin pain, and fever, nausea, vomiting, or rigors. Reports no difficulty starting the stream, feels the bladder empties fully each time, and reports no dribbling."
      }
    },
