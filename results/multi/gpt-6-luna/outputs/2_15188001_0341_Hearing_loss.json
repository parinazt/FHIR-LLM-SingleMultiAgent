        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well; no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild mucosal oedema and clear rhinorrhoea; no sinus tenderness to palpation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Throat examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild pharyngeal erythema; no exudate; tonsils not enlarged; uvula central."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small amount of dry cerumen bilaterally, non-occlusive. No canal erythema or discharge. Tympanic membranes intact with normal light reflex; no bulging, retraction, effusion, or perforation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Neck examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild small anterior cervical nodes, non-tender; no significant lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Clear with good air entry; no wheeze or crackles; no increased work of breathing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
