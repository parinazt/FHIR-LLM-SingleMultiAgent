        "code": {
          "text": "Calf tightness with walking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports calf tightness after walking approximately 150–200 m on flat ground, relieved by rest within a few minutes; unchanged versus last review."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Peripheral limb symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies rest pain, nocturnal foot pain, non-healing ulcers, colour change, or acute limb symptoms. Reports feet get a bit cold while watching TV at night and wears thick socks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Early morning tiredness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild early morning tiredness only. Sleeps 6–7 hours and wakes once to void. Denies gastrointestinal upset, fever, and weight loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Focused review of systems"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies cough, wheeze, pleuritic pain, focal weakness, speech change, new claudication pattern, rest pain, ulceration, haematuria, abdominal pain, nausea, vomiting, and PR bleeding. Reports mood is okay and coping."
      }
    },
    {
