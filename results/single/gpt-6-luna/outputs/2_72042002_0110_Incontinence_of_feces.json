          "text": "Obstetric history relevant to bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two spontaneous vaginal deliveries; last delivery 9 years ago. Patient does not recall major tears."
      }
    },
