        "code": {
          "text": "General appearance and communication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and is talking clearly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, and coherent. Mood described as “a bit irritable”; affect appropriate. No psychotic features. Calm and cooperative in consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
