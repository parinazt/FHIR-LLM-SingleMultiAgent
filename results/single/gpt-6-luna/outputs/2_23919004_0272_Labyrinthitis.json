        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vertigo and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported sudden-onset room-spinning vertigo, worse with head movement, associated with nausea and vomiting. Markedly improved; no further vomiting. Still has brief dizziness with quick head turns and when getting out of bed. No vertigo at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent left tinnitus and a sensation of left ear blockage during the preceding week, mostly settled. Mild left hearing muffling during the acute episode, now described as pretty normal. No current otalgia or ear discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported neurologic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies diplopia, dysarthria, limb weakness, limb numbness, gait collapse, or new severe headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
