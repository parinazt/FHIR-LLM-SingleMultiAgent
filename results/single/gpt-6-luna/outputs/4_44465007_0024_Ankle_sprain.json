      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right ankle pain and swelling, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Twisted the right ankle stepping off a kerb approximately 2 weeks ago. Still feels unwell by the end of the day; swelling occurs in the evening and pain increases with prolonged weight-bearing. No limp in the morning; slows down by the evening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported ankle and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No locking, catching, or giving way; no numbness or tingling; no calf pain, shortness of breath, fever, or redness. No previous significant ankle injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right ankle appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild lateral swelling; resolving bruising over and inferior to the lateral malleolus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right ankle tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tenderness over the ATFL greater than the CFL region. No bony tenderness at the posterior edge or tip of either malleolus, base of the fifth metatarsal, or navicular."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right ankle range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Inversion reduced due to pain; plantarflexion and dorsiflexion near full."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right ankle weight-bearing ability"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to weight-bear for more than 4 steps unaided."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right ankle stability tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior drawer negative/about equal to the left. Talar tilt not clearly increased."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right lower-limb neurovascular and calf examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact. Calf soft and non-tender; no cords."
      }
    },
