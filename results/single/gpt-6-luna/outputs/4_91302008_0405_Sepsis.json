        "code": {
          "text": "ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal mucosa mildly erythematous and oedematous with clear rhinorrhoea; no sinus tenderness. Oropharynx mildly erythematous with no exudate. Neck supple with no significant cervical lymphadenopathy."
      }
    },
    {
