    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right elbow pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain at the outer right elbow for approximately 9–10 months, intermittent and persisting, worse over the last 2–3 months. Local ache with sharp pain on lifting and gripping. Worse when scanning groceries, lifting bags, pouring a kettle, and gripping a steering wheel, especially with the forearm pronated. Improved with rest. Occasional night pain when rolling onto that side, waking the patient a few times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right elbow morning stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild morning stiffness that settles quickly"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right hand grip function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports subjectively decreased grip and occasionally drops heavier items. At work, pain increases on long busy shifts; needs to swap hands and take brief breaks. Avoids heavy housework and gardening; activities of daily living are okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, locking, giving way, redness, warmth, or obvious swelling reported. No weight loss, fevers, night sweats, neck pain, paraesthesia, true weakness (weakness is pain-limited only), other joint pain, morning stiffness lasting more than 30 minutes, rash, or psoriasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
