        },
        "valueString": "Alert, mildly agitated, speaking in full sentences, and in no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right shin wound history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right shin wound after knocking it on a metal platform at work approximately 10 days ago. Initially a small laceration cleaned with tap water and some methylated spirits. Redness, tenderness, and yellow discharge increased over the last 3–4 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right anterior shin wound examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Superficial laceration approximately 2.5 cm, about 5 cm below the knee, with surrounding erythema extending approximately 3–4 cm beyond the wound, warmth, tenderness, mild induration, and a small amount of purulent exudate on the dressing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right leg examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fluctuance, crepitus, necrosis, bullae, or lymphangitic streaking. Mild right inguinal node tenderness. Calf soft and non-tender, with no asymmetrical swelling; pulses intact, capillary refill under 2 seconds, and sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported symptoms and functional effect of right leg wound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient feels off and more tired, walks with a mild limp due to pain, and reports increased pain and swelling over the past few days with reduced tolerance for prolonged walking, standing, and heavy work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dual heart sounds; no murmur."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Systemic symptoms and toxicity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No rigors, chest pain, shortness of breath, abdominal pain, nausea, or vomiting. No clinical features of systemic toxicity or SIRS currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Exposure history relevant to wound"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent overseas travel, animal or human bite, or fresh or salt water exposure. Patient showers daily and occasionally hoses the leg at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Temporary work capacity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Temporary reduced capacity for prolonged standing, walking, heavy outdoor work, or physically demanding work until the infection is resolved; not assessed as permanent incapacity."
      }
    },
