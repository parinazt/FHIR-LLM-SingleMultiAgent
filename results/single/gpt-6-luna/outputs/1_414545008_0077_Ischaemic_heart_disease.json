        "status": "final",
        "code": {
          "text": "Exertional chest discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tightness across the chest with increased exertion, at a predictable threshold (for example, hurrying for the bus), relieved by rest within a few minutes; stable exertional symptoms. No rest pain, radiation, diaphoresis, syncope, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild exertional shortness of breath, unchanged and settling quickly with rest. No orthopnoea or paroxysmal nocturnal dyspnoea."
      }
    },
    {
