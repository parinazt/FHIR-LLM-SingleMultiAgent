        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Paracetamol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "1 g three times daily most days",
            "timing": {
              "repeat": {
                "frequency": 3,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
