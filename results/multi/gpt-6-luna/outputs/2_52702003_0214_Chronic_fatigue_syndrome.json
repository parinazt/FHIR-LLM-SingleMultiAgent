          "text": "Upper respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Four days of symptoms: sore throat initially, now decreased; blocked nose; clear-to-yellow rhinorrhoea; dry-to-slightly productive cough; mild frontal headache; myalgias; increased fatigue."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
