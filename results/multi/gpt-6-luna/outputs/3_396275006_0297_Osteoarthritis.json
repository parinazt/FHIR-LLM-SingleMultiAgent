        "code": {
          "text": "Osteoarthritis of the hands, involving DIP and PIP joints with early mild first CMC osteoarthritis, confirmed clinically and on X-ray"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
