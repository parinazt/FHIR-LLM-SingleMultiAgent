    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Telehealth general and left knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and well-looking, mildly distressed by pain. Antalgic gait favouring the left, weight-bearing preserved, no collapse. Mild left knee swelling compared with right, no obvious erythema. Active flexion and extension present; pain near terminal extension, near-full extension achieved with effort, guarded, no clear mechanical block. Patient indicates medial joint-line tenderness. Calves appear symmetrical with no obvious swelling on video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported red-flag symptoms and injury features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, night sweats, weight loss, marked redness, severe warmth, calf pain or swelling, and high-impact injury. No major trauma reported."
      }
    },
