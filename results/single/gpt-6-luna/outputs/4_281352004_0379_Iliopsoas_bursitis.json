    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance, BMI, and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-looking, no acute distress at rest. BMI approximately 26. Mild antalgic gait favouring the right, especially for the first few steps; gait is stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Lumbar spine and straight-leg raise examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lumbar spine non-tender with full range of motion and mild discomfort at extremes. Straight-leg raise negative bilaterally."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right hip inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No erythema, swelling, or deformity. Marked deep femoral triangle / iliopsoas-region tenderness just distal to the inguinal ligament. No greater trochanter or lateral hip tenderness and no inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right hip range of motion and provocative testing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flexion limited by pain to approximately 90–100 degrees with pain on active and passive movement. Internal rotation mildly limited with discomfort. External rotation and extension near full, with mild pain at extremes. Resisted hip flexion painful with positive psoas sign. FABER produces mild groin pain without sacroiliac joint pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left hip examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion; non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Lower-limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 throughout. Patellar and ankle reflexes present and symmetrical. Light-touch and pinprick sensation intact, including anterior thigh and medial leg. No foot drop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
