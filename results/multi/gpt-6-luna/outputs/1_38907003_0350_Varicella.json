          "text": "Gastrointestinal and oral intake symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea and vomiting; currently tolerating fluids. Decreased appetite but eating small meals. Denies abdominal pain."
      }
    },
