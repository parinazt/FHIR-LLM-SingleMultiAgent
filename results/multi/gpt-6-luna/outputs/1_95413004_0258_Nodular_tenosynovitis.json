    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Right wrist pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing pain over the right radial styloid, worst 6/10 and decreasing to approximately 3–4/10 in the splint. Worse with lifting a kettle, opening jars, picking up shopping, and ulnar deviation with the thumb abducted."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right wrist and thumb creaking sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient describes grating or creaking, especially on the first few thumb movements in the morning and after long periods of typing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated symptoms and trauma"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, redness, warmth, fever, systemic symptoms, paraesthesia, neck pain, or elbow pain reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right wrist and hand examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild soft tissue swelling from the radial styloid to the base of the thumb; no erythema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right first dorsal compartment examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Local tenderness to palpation with palpable nodularity along the tendon sheath. Fine crepitus felt on active thumb movement at the wrist."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right wrist range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wrist range of motion near full, with mild pain on ulnar deviation. Thumb abduction and extension limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
