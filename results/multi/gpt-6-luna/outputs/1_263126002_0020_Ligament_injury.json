        "code": {
          "text": "Right knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No effusion, full range of motion, no joint-line tenderness, and ligaments stable. Knee currently asymptomatic."
      }
    },
