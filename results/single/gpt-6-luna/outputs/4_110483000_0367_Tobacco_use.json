        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mild anxiety usually manageable; for the past 4–6 weeks feels more wound up, especially at work on a noisy site with overtime; describes being more on edge than usual, restless and keyed up, with mildly reduced concentration at work especially late afternoon."
      }
    },
    {
