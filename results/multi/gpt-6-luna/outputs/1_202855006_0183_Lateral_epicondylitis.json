        "code": {
          "text": "Dry cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry, non-productive cough for approximately 3 weeks after an upper respiratory tract infection; worse in the evening and when talking. No haemoptysis, shortness of breath, chest pain, fever, weight loss, or night sweats."
      }
    },
