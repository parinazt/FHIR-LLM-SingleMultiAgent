        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left eye watering and irritation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased clear tearing, left greater than right, over the last few months; worse outdoors and in wind. Mild gritty/sandy feeling, especially at the end of the day. Occasional mild crusting in the morning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
