          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Likely viral conjunctivitis, bilateral, left greater than right; likely adenovirus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Five-day history of red, gritty eyes, left greater than right, with watery/mucoid discharge on waking and mildly stuck eyelids that open with warm water. Mild itch. No significant pain or reduced vision; transient blur when eyes are watery. Mild photophobia outdoors; no pain with light."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Recent illness and exposure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Recent URTI about one week ago, now largely resolved. Works in childcare and reports multiple children with colds and gunky eyes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Relevant ocular history and exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No contact lens use, trauma, foreign body, or history of ocular HSV."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Observations within normal limits; afebrile."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Visual acuity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6/6 in both eyes on near chart."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Conjunctival and ocular discharge examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left conjunctiva diffusely injected, including tarsal and bulbar conjunctiva; right eye mildly injected laterally. No ciliary flush. Thin watery/mucoid film in both eyes, more on the left; no purulent discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Corneal and fluorescein examination, left eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cornea clear; fluorescein examination showed no ulcer or dendritic pattern. Tear film intact; no foreign body seen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Pupillary and extraocular movement examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pupils equal and reactive; no RAPD. Extraocular movements full; no pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left preauricular lymph node"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly tender left preauricular node."
      }
    },
