        "code": {
          "text": "Eye symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No purulent discharge, morning lid sticking, significant pain, photophobia, reduced vision, foreign-body sensation, trauma, or contact lens use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Eyelid examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lids normal; no crusting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
