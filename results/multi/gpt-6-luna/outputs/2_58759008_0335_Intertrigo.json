    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported inframammary rash symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash under the breasts on and off for months, worse over the last 2–3 weeks; itchy, burning, red and moist, with slight odour when bad. Worse with heat, sweating, wearing a bra all day and gardening; improves when aired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Inframammary skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: bilateral inframammary folds with erythematous, macerated, well-demarcated plaques; possible satellite papules. No obvious ulcer, pus or clear cellulitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, rigors, spreading erythema, pus or systemic symptoms. No groin or perianal rash currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no apparent distress, speaking in full sentences."
      }
    },
