        "code": {
          "text": "Reported neurologic and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No numbness or tingling, weakness, fevers, or spreading redness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
