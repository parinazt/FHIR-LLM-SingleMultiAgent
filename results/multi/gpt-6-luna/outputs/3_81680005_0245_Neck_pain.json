    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left knee pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior/medial ache described as feeling like a bruise under the kneecap; onset approximately 2–3 weeks after lifting boxes and a busy weekend. Pain 3–4/10 at baseline, up to 6/10 on stairs, especially descending. Worse with stairs, squatting, and rising from a chair after prolonged sitting; settles with rest. No night pain and no significant morning stiffness over 10 minutes. No clear trauma or previous similar episode."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left knee associated symptoms and function"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is unsure whether there is swelling, describing it as possibly puffy in the evenings. No true locking, giving way, or catching. Fully weight-bearing and mobilising unaided."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central/right paracervical ache described as tight muscles, present for approximately 6 weeks, with occasional brief sharp twinge on sudden turning. Worse with prolonged desk work, looking down at a phone, and driving; better with heat, stretching, ibuprofen, and lying down. Sleep is a little disturbed by waking to change position."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Neck-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No arm pain, paraesthesia, weakness, clumsiness, gait change, bowel or bladder symptoms, or trauma reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient described mood as 'a bit cranky'; denies low mood, anhedonia, and anxiety."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress; talkative and tangential, requiring refocusing several times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal alignment with no deformity. Increased tone and tenderness to palpation of upper trapezius and paracervical muscles, right greater than left. No midline cervical spine tenderness. Rotation mildly reduced bilaterally; pain at end range. Flexion and extension near full."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Upper limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Power 5/5 in all myotomes; light-touch sensation intact; biceps, triceps, and brachioradialis reflexes 2+ and symmetrical. Spurling test negative. Gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Left knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious swelling, erythema, deformity, or effusion. Mild tenderness at the medial patellar margin and medial patellofemoral joint. Full range of motion with mild anterior pain on deep flexion. McMurray test negative; ligaments stable to varus and valgus stress. Patellar grind reproduces symptoms. Normal gait; able to perform partial squat with anterior knee pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Peripheral stigmata of inflammatory arthritis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No peripheral stigmata of inflammatory arthritis."
      }
    },
