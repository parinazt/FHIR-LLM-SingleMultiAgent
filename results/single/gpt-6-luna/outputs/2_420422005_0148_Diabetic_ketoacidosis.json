        },
        "valueString": "Abdomen soft with mild generalised upper abdominal tenderness; no guarding or rebound."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
