    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported oedema and associated features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral pitting ankle oedema for approximately 5–6 days, gradually increasing; mild finger puffiness in the mornings for 2–3 days. Worse in the evening, especially after prolonged sitting, and better in the morning after leg elevation. Patient reports that pressing the oedema leaves a dent for a few seconds. No erythema, warmth, focal pain, skin colour change, or ulcers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, orthopnoea, paroxysmal nocturnal dyspnoea, chest pain, palpitations, syncope, acute cough, and wheeze. Uses one pillow."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported thromboembolic and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies calf pain, unilateral swelling, recent travel, immobility, fever, night sweats, weight loss, dysuria, haematuria, and frothy urine. Clothing size unchanged. Urinary frequency stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly reduced appetite, attributed by the patient to depression; eating approximately two small meals daily. Denies nausea, vomiting, abdominal pain, or change in bowel habits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Mood and mental health symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes mood as flat but not catastrophic, with fragmented sleep and early-morning awakening, reduced interest and activity, and mildly reduced appetite. Denies suicidal ideation and recent self-harm; states she is not planning anything."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Cognition and communication during telephone consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Coherent and oriented to date and setting; recalled medications accurately and engaged in complex discussion. Some short-term memory issues reported. No new confusion beyond baseline reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
