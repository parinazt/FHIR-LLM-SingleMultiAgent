    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported oral symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a hard stone-like deposit on the teeth near the gum and a yellow deposit on the lower teeth for approximately 3–4 months, slowly worsening. Gums described as red and a bit puffy, with bleeding when brushing. No pain. Family notices bad breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported oral and systemic negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No reported fever, facial swelling, swallowing difficulty, or loose teeth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Oral examination: lips and mucosa"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lips and mucosa intact; no ulcers or thrush."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Oral examination: gums"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Generalised red, mildly swollen gums, especially lower anterior gums; bleeding on gentle probing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Oral examination: dental calculus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Clear yellow-brown calculus along gingival margins, especially lingual lower incisors and around upper molars."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Oral examination: other dental and periodontal findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious caries, loose teeth on finger pressure, pus, or gingival recession. No cervical lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Oral hygiene and dietary habits"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brushes once daily, quickly; rarely flosses. Drinks lots of sweet tea, cordial, and soft drink, including at night. Has not seen a dentist for more than 5 years due to cost."
      }
    },
