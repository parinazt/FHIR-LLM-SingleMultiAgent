    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Dyspareunia and pelvic pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports approximately 2 years of superficial burning, sharp stinging pain at the introitus with tampon use and intercourse; sometimes throbbing pain for hours afterward. Sometimes has a deep pelvic ache with penetration, especially in certain positions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Intercourse avoidance and anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids sex most of the time, with occasional attempts with her long-term partner. Reports anticipatory anxiety before attempts and concern that she may never have 'normal sex'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Patient concern about hymenal tissue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is concerned that a thick area of tissue at the front of the vaginal opening is leftover hymen that did not break properly and may need removal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period was 7 days ago. Cycles are regular, every 28–30 days, with moderate flow. No intermenstrual bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Current associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild chronic pelvic ache. Denies current abdominal pain apart from this ache, fever, rigors, dysuria, abnormal discharge, and postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sexual trauma history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sexual trauma."
      }
    },
