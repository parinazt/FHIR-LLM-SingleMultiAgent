        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing for approximately 2 weeks; mainly dry. Worse at night and on waking, waking him a few times but he goes back to sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sputum"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sometimes a small amount of white sputum in the morning; no blood."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Respiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies shortness of breath, chest pain, and wheeze. No exertional limitation; still working."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever now; felt a bit hot during the first couple of days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well, talking in full sentences, with an occasional dry cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear on auscultation, good air entry, no added sounds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Throat examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Throat mildly red."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal mucosa a bit boggy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Bowel frequency and stool consistency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually has 1 stool daily or every 2 days on Movicol 1–2 sachets. Over the last approximately 2 weeks, stool every 2–3 days and harder, but still passing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies abdominal pain, distension, severe cramps, vomiting, overflow diarrhoea, and rectal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended, with a mild stooly feel in the left lower quadrant only; non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Movicol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Regularly, 1–2 sachets"
          }
        ],
        "note": [
          {
            "text": "Advised that he may increase to 2–3 sachets/day short term if more than 2 days without a bowel movement or if stool is hard, then reduce to his usual amount once back to daily soft stool."
          }
        ]
      }
    },
