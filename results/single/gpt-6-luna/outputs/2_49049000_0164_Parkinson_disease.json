          "text": "Recent Parkinson disease motor symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 4 weeks, increased slowness and stiffness, more difficulty getting out of a chair, and shuffling gait."
      }
