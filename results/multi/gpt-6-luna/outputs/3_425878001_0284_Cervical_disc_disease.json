    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right arm numbness and tingling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 10–14 days; described as “pins and needles” and “cotton wool” in a C6 pattern extending from the lateral upper arm and forearm to the thumb and index finger. Initially intermittent, now present most of the day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Factors aggravating right arm symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with neck extension and computer work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Pain and perceived right arm weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain is not a major symptom; mainly paraesthesia. Feels weaker when opening jars, but reports no actual loss of function."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported balance and hand dexterity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 2–3 weeks, slightly more unsteady on uneven ground, with no falls. Mildly increased difficulty with buttons but still managing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No bowel or bladder symptoms, saddle anaesthesia, trauma, systemic red-flag symptoms, or facial, visual, or speech symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
