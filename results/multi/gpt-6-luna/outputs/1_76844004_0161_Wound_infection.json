    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right shin wound examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Superficial laceration on the anterior right shin, approximately 5 cm below the knee and 2.5 cm long. Surrounding erythema extends approximately 3–4 cm beyond the wound; area is warm and tender with mild induration. Small amount of purulent exudate on the dressing. No fluctuance, crepitus, necrosis, bullae, or lymphangitic streaking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right lower limb examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild right inguinal node tenderness. Calf soft and non-tender, with no asymmetric swelling. Pulses intact, capillary refill less than 2 seconds, and sensation intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
