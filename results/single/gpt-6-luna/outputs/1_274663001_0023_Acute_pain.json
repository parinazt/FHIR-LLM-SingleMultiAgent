        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No improvement; approximately 7/10, described as a deep ache in the lateral/posterior left shoulder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Left shoulder pain aggravating factors and impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with overhead movement and reaching behind the back; sleep is disturbed, especially lying on the left side. Some activities of daily living are affected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported shoulder-related symptoms and red-flag negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation below the elbow, neck pain, new numbness, tingling, weakness, or loss of grip. No trauma beyond the initial lift, fall, or dislocation. No fever, weight loss, or night sweats."
      }
    },
