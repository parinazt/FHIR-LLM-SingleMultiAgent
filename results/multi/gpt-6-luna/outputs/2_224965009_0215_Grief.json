        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Temazepam"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "10 mg nocte as needed for sleep; maximum 5 nights only",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ],
            "patientInstruction": "Do not drive if drowsy. No alcohol. Stop once sleep is slightly better."
          }
        ],
        "dispenseRequest": {
          "numberOfRepeatsAllowed": 0
        }
