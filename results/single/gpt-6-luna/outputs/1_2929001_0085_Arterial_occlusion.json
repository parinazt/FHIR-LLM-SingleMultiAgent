        "status": "final",
        "code": {
          "text": "Exertional right calf and foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain walking approximately 150–200 m to the mailbox, requiring a stop; settles within a few minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
