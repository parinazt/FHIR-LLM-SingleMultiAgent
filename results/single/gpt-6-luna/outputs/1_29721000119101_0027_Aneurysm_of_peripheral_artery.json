    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported fever, chills and night sweats"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 2–3 days, felt feverish with chills and hot-and-cold episodes overnight; woke with a soaked shirt. Home thermometer was not registering a temperature, so no home temperature measurements were available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported general symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling achy and washed out, with reduced appetite and some nausea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reported gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Some nausea; denies vomiting, diarrhoea and abdominal pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right popliteal region symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over approximately one week, reports increased ache behind the right knee at the known popliteal aneurysm, dull at baseline with occasional sharp stabbing pain on walking. Thinks it may be somewhat more swollen and warmer than the other leg."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath on exertion over the past few days; reports puffing more when going up stairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, orthopnoea, paroxysmal nocturnal dyspnoea, cough, sore throat and rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency and flank pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported recent exposures and possible source"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies recent dental work, skin infections and sick contacts. Patient wondered whether symptoms could relate to questionable mince or tank water that had been tasting unusual; gastrointestinal symptoms were minimal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Wife's report of patient's recent condition"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wife reports he has been off his food and sweaty for the last two nights and has not been himself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Telehealth general appearance and mental status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On limited video examination, alert and oriented; appeared unwell but not toxic, and spoke in full sentences. No obvious pallor or cyanosis; face slightly flushed. Speech coherent with no obvious confusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Observed respiratory effort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Respiratory rate visually estimated at approximately 18–20 per minute; breathing unlaboured, with no audible wheeze or cough. Assessment limited by video."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Observed mobility and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to stand and walk a few steps. Gait mildly antalgic, favouring the right leg, but stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Telehealth appearance of right popliteal region and leg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Behind the right knee appeared slightly fuller than the left on camera. Size, pulsatility and warmth were difficult to assess due to poor lighting and video quality. No obvious erythema or skin breakdown seen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Vital signs and palpation unavailable"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No blood pressure, heart rate, oxygen saturation or measured temperature available. Palpation of the aneurysm was not possible by telehealth."
      }
    },
