    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cover-uncover test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent right exodeviation on distant target, small-to-moderate angle, appearing comitant and more evident with fatigue during examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Alternate cover test"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Suggests alternating exotropia, with right exotropia more common; refixation movements symmetric, with no obvious paralytic pattern."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Nystagmus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not present."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Undilated direct fundoscopy"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Optic discs with sharp margins and normal colour; no papilloedema. Maculae appear normal; no obvious retinal lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cranial nerves II-XII grossly intact; facial movement and sensation normal; limb power 5/5; gait normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Intermittent outward drift of right eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing intermittent outward drift, especially when tired or focusing at distance; noticed more in photos and when reading stories to children. No acute change since last review approximately 6 weeks ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Eye strain and frontal/ocular ache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild ache by the end of the workday, reported approximately 3-4/7; patient describes it as mild and tolerable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Diplopia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Absent most of the time; very occasional brief double vision when very fatigued, resolving with blinking or refocusing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Reported visual and ocular symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies vision loss, halos, flashes, visual field loss, eye redness, discharge, and photophobia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Reported headache and neurological red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies headache waking her from sleep, vomiting, focal neurological symptoms, limb weakness, and speech disturbance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-22",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-22",
        "status": "final",
        "code": {
          "text": "Occupational and psychosocial impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mildly self-conscious at work; colleagues have said her eye looks tired, and she worries children may comment. Reports some reduced confidence and reluctance to take time off for specialist appointments."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-23",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-23",
        "status": "final",
        "code": {
          "text": "Patient's view of possible contributors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wonders whether extensive iPad use for programming or new stronger overhead lighting made the eye lazy. Slightly reduced device use without change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-24",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-24",
        "status": "final",
        "code": {
          "text": "Childhood strabismus history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No known childhood strabismus; parents never mentioned patching or glasses as a child."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-25",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-25",
        "status": "final",
        "code": {
          "text": "Intermittent neck and shoulder tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Briefly mentioned intermittent nonspecific neck/shoulder tightness at the end of the day, described as likely postural/occupational."
      }
    },
