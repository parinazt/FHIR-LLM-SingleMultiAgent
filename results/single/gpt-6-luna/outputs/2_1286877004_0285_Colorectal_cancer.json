    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Ascites drainage pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports draining about 2 to 3 litres every second day through the tunnelled peritoneal drain. Reports being told by the oncology nurse that up to 4 litres a day may be drained if needed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal distension associated with ascites"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen distends between drains and improves after drainage. Today describes abdomen as pretty big again, but not as bad as when it is really tight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Breathlessness associated with tense ascites"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild shortness of breath when ascites is tense. No acute shortness of breath at rest; speaking in full sentences on the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Light-headedness during ascites drainage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit woozy when the whole volume is drained quickly. Wife reports they are now trying to drain it slowly over a couple of hours, though it can be difficult not to let it run out quickly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms and obstruction-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels moving daily and are softer. No PR bleeding, vomiting, colicky pain, or absolute constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Infection, abdominal pain, and confusion symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors, no new focal severe abdominal pain, and no confusion reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Weight and muscle loss"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive weight and muscle loss reported/assessed, likely related to cancer, protein loss in ascites, and decreased oral intake."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice strong; not breathless during the call and no slurring. No observations recorded because the consultation was by phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right shoulder soreness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports right shoulder soreness when pruning roses; deferred for a separate review."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Toenail concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a 'funny toenail'; not assessed during this consultation."
      }
    },
    {
