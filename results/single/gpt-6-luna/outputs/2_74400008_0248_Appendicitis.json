        "code": {
          "text": "Possible fever or rigors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible fever or rigors last night; patient felt hot and sweaty and used a fan. No temperature recorded."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
