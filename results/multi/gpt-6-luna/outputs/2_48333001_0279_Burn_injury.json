        "code": {
          "text": "Burn-related symptoms and reported exudate"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burn is less painful. Patient reports no increase in exudate and reports a small amount of clear serous fluid only."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported systemic and spreading infection symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no fevers, rigors, sweats, or spreading erythema up the arm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
