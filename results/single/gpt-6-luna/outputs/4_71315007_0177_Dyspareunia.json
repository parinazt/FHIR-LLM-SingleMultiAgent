    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain with intercourse approximately 9–10/12, now with most attempts. Superficial and deep pain described as sharp burning at the entrance followed by a deeper ache; worse with initial penetration and in certain positions, and may linger minutes to hours afterward. Tried intercourse once with water-based lubricant and stopped early due to pain. No previous dyspareunia in earlier relationships."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No postcoital bleeding, dysuria, urinary frequency, abnormal vaginal discharge, odour, itch, fevers, systemic symptoms, bowel change, rectal bleeding, severe dysmenorrhoea, or urinary incontinence. No cyclical pelvic pain outside menses. Period cramps are manageable; cycles regular, 28–30 days, with moderate flow and dysmenorrhoea on days 1–2."
      }
    },
