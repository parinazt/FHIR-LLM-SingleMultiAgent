        "status": "final",
        "code": {
          "text": "Anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mild anxiety, usually manageable; increased over the past 4–6 weeks, feeling more wound up, especially at work on a noisy site with overtime."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Restlessness and concentration"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling restless and keyed up, with mildly decreased concentration at work, especially late afternoon."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep onset delayed by 30–60 minutes; occasional early waking 1–2 times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Patient-reported mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as “pretty steady, just cranky and anxious.” Denies anhedonia, suicidal ideation, and thoughts of self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
