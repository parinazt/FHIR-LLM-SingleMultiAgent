        },
        "code": {
          "text": "Trigger finger (stenosing tenosynovitis), right ring finger"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ring finger pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ring finger pain for 4–5/12; pain reported as up to 7/10, though patient describes it as “only a bit sore”. Worse after long days of paperwork or phone use and when lifting grandchildren."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ring finger locking and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ring finger catches and locks, especially in the morning. Stiffness lasts 10–15 minutes, then eases. Sometimes needs the left hand to straighten the finger. Reports clicking and popping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, numbness, tingling, weakness, fever, or spreading redness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vital signs"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vital signs stable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right ring finger examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild volar fullness at the MCP/A1 pulley with a palpable tender nodule. No erythema or warmth. Partial fist only; triggering from flexion to extension, requiring assistance on 2 of 3 attempts. Passive range of motion full and mildly tender. Palpable and audible click. Neurovascularly intact. Grip slightly reduced due to pain. No carpal tunnel signs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other small joints of hands, wrists, and elbows"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No abnormal findings (NAD)."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right hand X-ray"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fracture or dislocation. Mild interphalangeal osteoarthritis only; no erosions."
      }
    },
