    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Diarrhoea and bowel movements"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing since day 7 of a 2-week Bali trip, approximately 13 days ago. Initially 6–8 loose watery bowel movements per 24 hours, now 4–5 per 24 hours; no formed stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Stool characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional mucus; no blood and no melaena."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Crampy lower abdominal pain, worse before stool and easing after stool."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Nausea and vomiting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea; vomited twice on day 1 only, with no vomiting since."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Other reported symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels wiped out and light-headed on standing. Felt hot and cold during the first few days; no documented fever. No rash, arthralgia, jaundice, dark urine, shortness of breath, significant headache, or neck stiffness."
      }
    },
    {
