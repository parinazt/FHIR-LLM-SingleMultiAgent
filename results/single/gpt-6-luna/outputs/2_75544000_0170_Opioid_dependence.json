          "text": "Reported symptoms associated with withdrawal"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased sweating, loose stools, abdominal cramps, yawning, rhinorrhoea, teary eyes, poor sleep, feeling wired, decreased appetite, and strong craving for opioids."
      }
    },
