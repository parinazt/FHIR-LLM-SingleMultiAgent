    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Lower abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Three-day history of intermittent dull ache across the lower abdomen, rated 4–5/10, non-colicky and non-radiating; worse last night. No clear trigger or relation to meals. The patient wonders whether it relates to too many coffees and reports eating a dodgy meat pie at a service station two days earlier. Pain did not wake him from sleep. He was able to work but was uncomfortable bending and lifting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Bowel symptoms and associated gastrointestinal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels open daily with formed stools. Denies diarrhoea, constipation, per-rectal blood or mucus, melaena, nausea, vomiting, dyspepsia, heartburn, and regurgitation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary and genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency, urgency, haematuria, flank pain, and testicular pain; no trauma reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
