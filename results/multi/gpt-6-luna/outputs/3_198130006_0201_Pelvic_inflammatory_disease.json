        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sweats, weight loss, intermenstrual bleeding, postcoital bleeding, current dyspareunia, diarrhoea, constipation and right upper quadrant pain. Currently abstinent."
      }
    },
    {
