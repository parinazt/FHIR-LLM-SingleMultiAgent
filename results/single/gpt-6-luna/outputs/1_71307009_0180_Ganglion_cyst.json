        "code": {
          "text": "Left dorsal wrist lump and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lump present for approximately 6 months and slowly increasing in size; approximately 1–1.5 cm. Aching pain rated 3–6/10, especially after prolonged typing or lifting files. No trauma, locking, paraesthesia, weakness, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left wrist examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small, well-circumscribed, fluctuant lump on the dorsal left wrist, approximately 1–1.5 cm; non-tender to mildly tender; transilluminates. Overlying skin normal, with no erythema or warmth. Full active and passive range of motion; grip equal bilaterally; neurovascularly intact; pulses and capillary refill normal. No other joint swelling."
      }
    },
