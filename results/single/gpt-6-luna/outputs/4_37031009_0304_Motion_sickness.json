      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "code": {
          "text": "Possible migraine tendency; personal history and pattern are unclear, with no clear vestibular migraine pattern currently"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Symptoms associated with travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports nausea, mild spinning or lightheaded sensation, and cold sweats during travel, especially as a passenger in a car on winding roads. Symptoms are worse when reading or using a phone in the car and improve when looking at the horizon, sitting in the front passenger seat, or when the car stops. Symptoms are not present at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Vomiting during car travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Has vomited in a car a couple of times; timing is uncertain, possibly last month or the time before."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Nausea during flights"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Flights sometimes cause nausea, especially during take-off or landing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vertigo and positional symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No persistent vertigo at rest, no true room-spinning at rest, and no vertigo when rolling over in bed or with quick head turns. Currently asymptomatic at rest during the call."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Auditory and ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hearing loss or change, tinnitus, aural fullness, current ear pain, ear discharge, recent upper respiratory infection, and sinus symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies focal neurological symptoms, including diplopia, visual loss, dysarthria, dysphagia, limb weakness, facial droop, numbness, paraesthesia, gait disturbance, blackouts, and seizures."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, palpitations, syncope, sudden severe headache, fever, recent head trauma, abdominal pain, and altered bowel habit. Nausea and occasional vomiting occur only in motion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Headache history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports past severe headaches in high school and intermittent 'bad headaches' with nausea, but cannot describe the pattern; migraine history is uncertain and requires further assessment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Telehealth audio examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with a strong voice; affect appropriate and coherent; speech fluent without slurring. No audible cough or wheeze and no shortness of breath noted over the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Occasional OTC analgesic; exact medicine uncertain, possibly paracetamol or ibuprofen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Used as needed for pain; dose and exact medicine uncertain.",
            "asNeededBoolean": true
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-2",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-2",
        "status": "unknown",
        "medicationCodeableConcept": {
          "text": "OTC travel sickness medicine used as a child; identity uncertain, possibly hyoscine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-3",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-3",
        "status": "stopped",
        "medicationCodeableConcept": {
          "text": "Oral contraceptive pill, unspecified"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Used a few years ago and stopped."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hyoscine hydrobromide 300 microgram tablets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet 30 minutes before travel; may repeat every 4–6 hours as needed; maximum 4 tablets in 24 hours.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 300,
                  "unit": "microgram"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
                "value": 1200,
                "unit": "microgram"
              },
              "denominator": {
                "value": 24,
                "unit": "hour"
              }
            }
          }
        ],
        "dispenseRequest": {
          "numberOfRepeatsAllowed": 0,
          "quantity": {
            "value": 20,
            "unit": "tablets"
          }
        },
        "note": [
          {
            "text": "Trial on a short local trip before the long drive, particularly if intending to share driving. Do not drive until individual response is known; avoid concurrent sedating medicines and limit alcohol."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Promethazine 25 mg tablets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Backup option if hyoscine is ineffective or poorly tolerated. Take 1 tablet 1–2 hours before travel as needed for motion sickness; may repeat every 6–8 hours; maximum 4 tablets in 24 hours. Use only when a passenger; do not drive or operate machinery if taken.",
            "route": {
              "text": "oral"
            },
            "asNeededBoolean": true,
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 25,
                  "unit": "mg"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
                "value": 100,
                "unit": "mg"
              },
              "denominator": {
                "value": 24,
                "unit": "hour"
              }
            }
          }
        ],
        "dispenseRequest": {
          "numberOfRepeatsAllowed": 0,
          "quantity": {
            "value": 10,
            "unit": "tablets"
          }
        },
        "note": [
          {
            "text": "Strong sedation and impairment of performance were emphasized. Warned about additive sedation with alcohol or other sedatives."
          }
        ]
      }
    }
  ]
}
