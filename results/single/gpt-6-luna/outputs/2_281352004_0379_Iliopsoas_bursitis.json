    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right groin and anterior hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Aching pain with intermittent sharp twinges; onset is vague, possibly a few weeks to a couple of months. Baseline severity approximately 5/10, up to 7/10 with movement. Worse with hip flexion, lifting the leg into a car, stairs, sit-to-stand, putting on socks, and at the end of the day after standing or bending over low desks. Occasionally radiates into the anterior right thigh, not below the knee. Improved by rest, some stretching, and a heat pack; unsure which tablets help."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Effect of pain on work and activities"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working as a primary school teacher but avoiding playground duty; finds sitting on the floor with the children harder."
      }
    },
