        "code": {
          "text": "Bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms for a few months. Baseline constipation, now alternating: no bowel movement for 2–3 days with hard/lumpy stools and straining, then 1–2 days of loose stools (3–4 per day, not watery)."
      }
    },
