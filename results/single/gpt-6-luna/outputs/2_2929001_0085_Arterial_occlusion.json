        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Intermittent claudication"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right calf/foot pain when walking approximately 150–200 metres to the mailbox; needs to stop and pain settles within a few minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
