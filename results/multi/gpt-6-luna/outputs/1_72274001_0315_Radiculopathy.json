        "status": "final",
        "code": {
          "text": "Pain relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heat pack and rest. Naproxen and amitriptyline previously helped; patient self-stopped all medications 2 weeks ago."
      }
    },
    {
