          "text": "Migraine history and pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Migraine without aura, 1–2 episodes per month, clustering in the premenstrual week. No red flags."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
