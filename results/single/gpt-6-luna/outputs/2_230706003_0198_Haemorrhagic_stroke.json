    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Oropharynx, dentition, and temporomandibular joint examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oropharynx clear. Dentition reasonable with no obvious caries or tenderness. Mild bilateral TMJ crepitus, non-tender."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented; speech fluent; cranial nerves grossly intact including facial symmetry, extraocular movements intact, visual fields full. Mild right arm dysdiadochokinesia and slightly decreased fine finger movements compared with left; right upper extremity power 4+/5 and 5/5 elsewhere. Gait normal; no pronator drift."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
