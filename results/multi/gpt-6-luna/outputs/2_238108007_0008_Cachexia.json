        "status": "final",
        "code": {
          "text": "Mood and suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Low motivation but still enjoys cricket and grandchildren. Denies pervasive low mood, anhedonia and suicidal ideation."
      }
    },
