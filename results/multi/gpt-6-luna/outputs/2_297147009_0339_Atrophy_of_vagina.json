        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Likely genitourinary syndrome of menopause / vulvovaginal atrophy"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urinary frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports increased urinary frequency for approximately 3–4 months, worse over the last few weeks; voids every 1–2 hours during the day in small volumes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nocturia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports urinating 2–3 times at night, previously 0–1 times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary urgency and incontinence"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports mild urgency; denies urge incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, burning, visible haematuria, fever, flank pain, suprapubic pain, nausea, and vomiting. Reports being afebrile and otherwise feeling well."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Vaginal and vulval symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports vaginal symptoms for approximately 12 months: dryness and discomfort, stinging, and a sandpapery sensation, especially at the introitus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Dyspareunia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports pain with intercourse, decreased with supermarket lubricant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Vulval itching and rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports intermittent mild vulval itch; no obvious rash reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Vaginal bleeding and discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies post-vaginal bleeding. Reports occasional thin, non-offensive discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Menopausal status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports being postmenopausal for approximately 7 years; LMP reported as approximately age 51."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Behaviour during consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tangential with many side stories and needed redirection; engaged once focused."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Fatigue mentioned briefly; ongoing status not specified."
      }
    },
    {
