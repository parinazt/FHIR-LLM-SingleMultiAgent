    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Macrogol 3350 with electrolytes (Movicol) sachets"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Days 1–3: take 1 sachet hourly up to a maximum of 8 sachets per day; can space to every 2 hours if cramps or bloating. Aim for large stool output or clear liquid stools.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "h",
                "boundsDuration": {
                  "value": 3,
                  "unit": "days"
                }
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1,
                  "unit": "sachet"
                }
              }
            ],
            "maxDosePerPeriod": {
              "numerator": {
                "value": 8,
                "unit": "sachets"
              },
              "denominator": {
                "value": 1,
                "unit": "day"
              }
            }
          },
          {
            "text": "Then take 1–2 sachets daily on an ongoing basis, titrating to keep stools soft at least every 1–2 days; do not stop once improved.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseRange": {
                  "low": {
                    "value": 1,
                    "unit": "sachets"
                  },
                  "high": {
                    "value": 2,
                    "unit": "sachets"
                  }
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "PBS script printed for a quantity covering 3–5 days of intensive treatment plus at least 1 month of maintenance."
          }
        ]
      }
