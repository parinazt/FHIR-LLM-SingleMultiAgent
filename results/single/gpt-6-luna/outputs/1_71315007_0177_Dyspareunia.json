        "code": {
          "text": "Dyspareunia symptom pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dyspareunia on approximately 9–10 of 12 attempts, now occurring with most attempts. Superficial and deep pain described as sharp burning at the entrance followed by a deeper ache; worse with initial penetration and certain positions, and lingers for minutes to hours after sex."
      }
    },
