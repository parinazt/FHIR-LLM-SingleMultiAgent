        "status": "final",
        "code": {
          "text": "Near fall"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nearly fell in the bathroom last week; no actual fall and no head strike."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Resting tremor"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right-hand resting tremor reported as more obvious by the patient's wife. Examination: right greater than left resting pill-rolling tremor, improving with action."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Visual hallucinations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding visual hallucinations of people in the hallway in the evenings; non-threatening, with preserved insight. Wife feels they are more frequent when he misses medication or is more 'off'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
