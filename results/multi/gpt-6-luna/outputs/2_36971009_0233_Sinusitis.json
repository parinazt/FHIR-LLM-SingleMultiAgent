        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient says sinuses are 'crook again but not as bad as they get'. Mometasone spray helps when remembered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
