    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right foot ulcer"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ulcer at the right lateral forefoot near the 5th MTP, present approximately 10–12 weeks after striking foot on a bed frame; slowly increasing in size and depth. Approximately 1.5 x 1.0 cm, extending to dermis, punched-out edges, pale base with yellow slough and minimal serous ooze. Surrounding skin pale and slightly shiny. Very tender on palpation and cleaning. No significant erythema, warmth, malodour, exposed bone or tendon, fluctuance, tracking cellulitis, or other ulcers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp, significant pain, especially at night and worse with elevation while lying flat; often dangles leg off bed to sleep. Pain decreases when foot is dependent."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Bilateral exertional calf pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Can walk approximately 1–2 blocks on flat ground before tight calf pain develops bilaterally, right worse than left; settles within a few minutes of rest. Worsening over the last 6–12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Foot colour and temperature"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports right foot sometimes feels colder than left and turns white when elevated on recliner. On examination, right foot cooler and paler than left when supine; elevation to 30 degrees for 1 minute caused pallor of right forefoot and toes, followed by dependent rubor on lowering; milder changes on left. Distal feet cool bilaterally, right colder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Lower limb skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thin, shiny, hairless skin on shins and feet; thickened nails. No varicose veins or venous stasis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Capillary refill"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Delayed greater than 3 seconds in right toes; approximately 2–3 seconds on left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Lower limb pulses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Femoral pulses palpable bilaterally, left greater than right; no definite bruit (clinic noisy). Popliteal pulses difficult to assess bilaterally. Dorsalis pedis absent on right and very weak on left. Posterior tibial absent on right and weak, possibly monophasic, on left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Foot sensory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Light touch mildly decreased in toes bilaterally; monofilament decreased at several plantar sites bilaterally; vibration decreased at great toes. Patient reports tingling in toes and denies complete numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Right ankle-brachial pressure index"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 0.5, based on right ankle pressure approximately 70 and brachial pressure 140; handheld Doppler measurement limited by noisy environment."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
