        },
        "valueString": "Brief inspection of face, scalp, and dorsal hands found no obvious other suspicious lesions; this was not a full skin check."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone valerate 0.02% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply thinly to the lesion once daily for up to 2 weeks, then stop; for inflammation only, not definitive treatment.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "boundsDuration": {
                  "value": 2,
