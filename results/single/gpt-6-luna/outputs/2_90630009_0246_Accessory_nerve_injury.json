        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Prednisolone"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "50 mg by mouth each morning with food for 5 days",
            "route": {
              "text": "oral"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "duration": 5,
                "durationUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 50,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "Short course for severe neuropathic shoulder pain. Avoid NSAIDs while taking prednisolone; warned about mood changes, insomnia, and dyspepsia."
          }
        ]
      }
    },
