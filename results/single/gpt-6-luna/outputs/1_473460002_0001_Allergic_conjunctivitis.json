        "code": {
          "text": "Nasal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pale, boggy nasal mucosa with clear rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
