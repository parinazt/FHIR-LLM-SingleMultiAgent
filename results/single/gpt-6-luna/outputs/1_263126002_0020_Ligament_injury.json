    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well and comfortable; mild antalgic gait on the right."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right ankle inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild diffuse swelling around the lateral malleolus with faint resolving bruising. Skin intact; no erythema or deformity. Tender over ATFL and mildly over CFL; minimal tenderness directly over the tip/posterior edge of the lateral malleolus. No bony tenderness over the medial malleolus, base of the fifth metatarsal, or navicular; no syndesmosis or midfoot tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right ankle range of motion and strength"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsiflexion and plantar flexion mildly limited at end range by pain. Inversion reproduces lateral pain; eversion causes minimal symptoms. Power 4+/5 in all planes, limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right ankle stability and weight bearing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior drawer painful without obvious laxity compared with the left; talar tilt mildly painful without clear laxity. Able to bear weight for more than four steps in the room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right ankle neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Neurovascularly intact; dorsalis pedis and posterior tibial pulses palpable; capillary refill under 2 seconds."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right knee examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Knee asymptomatic; no effusion, full range of motion, no joint-line tenderness, and ligaments stable."
      }
    },
