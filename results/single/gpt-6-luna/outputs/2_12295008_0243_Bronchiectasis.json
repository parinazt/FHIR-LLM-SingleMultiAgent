    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Chronic morning productive cough and sputum"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usual pattern: a cupful of yellow sputum in the morning, then it settles. No increase in sputum volume or thickness and no change in smell."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Current respiratory symptoms and exacerbation features"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels pretty much the same as usual. No increased cough, shortness of breath, change in exercise tolerance, fever, chills, night sweats, chest pain, fatigue, or current haemoptysis. No increased sputum volume, thickness, or purulence. No haemoptysis for months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Exercise tolerance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still walks the dog for 20–30 minutes most days; slower uphill."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Recent antibiotic use and hospitalization"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No recent antibiotics or hospitalizations in the last 6–9 months. Usually has 1–2 infective exacerbations per year; none so far this year."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symmetrical chest expansion; resonant percussion bilaterally. Coarse inspiratory crackles bibasally, especially right lower lobe and left base, unchanged after deep breaths and cough. No focal bronchial breathing, wheeze, or increased work of breathing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and comfortable, speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination and heart failure symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur or peripheral oedema. No orthopnoea or paroxysmal nocturnal dyspnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "ENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nasal polyps or sinus tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Other examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clubbing or significant lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Patient concern about bronchiectasis"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worried that persistent crackles mean the lungs are wearing out quicker; asks whether cold damp weather or bathroom mould makes the lungs rattlier and whether repeat CT could show if disease is spreading."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Vaccination history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Influenza vaccine given this year. Pneumococcal booster was more than 5 years ago; schedule completion to be confirmed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Spirometry status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Annual spirometry overdue by more than 12 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Salbutamol metered-dose inhaler"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "100 mcg, 1–2 puffs as needed for shortness of breath; rare use, 1–2 times per month, only in cold weather with wheeze.",
            "asNeededBoolean": true,
            "route": {
              "text": "Inhalation"
            }
          }
        ]
      }
    }
  ]
