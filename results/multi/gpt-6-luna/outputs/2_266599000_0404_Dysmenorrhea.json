        },
        "code": {
          "text": "Previous iron deficiency associated with heavy menses"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Rash and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5 days of an itchy red rash on the flexor wrists, scattered forearms, and anterior neck. No pain, blisters, weeping, or pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Wrists and distal forearms: multiple ill-defined erythematous patches/thin plaques, 1–3 cm, with some excoriations; no vesicles, pustules, crusting, warmth, tenderness, or swelling. Anterior neck: a few faint erythematous macules. No mucosal, palm, sole, or genital involvement; no target lesions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated symptoms and observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, upper respiratory tract symptoms, joint pains, or oral or eye symptoms. Afebrile; observations within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Menstrual pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Period pain increased over the last few cycles. Pattern reported as stable, with no intermenstrual bleeding or postcoital bleeding."
      }
    },
    {
