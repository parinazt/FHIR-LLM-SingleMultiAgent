    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Visual acuity, left eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6/9 on Snellen testing in room; testing repeated because patient was distractible. Able to read a number plate across the car park."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pterygium described as a little wing of skin, present for years. Over the past 6–9 months, intermittent redness and mild irritation, worse on the left than right, especially after full days outdoors in wind and dust; occasional gritty sensation relieved by blinking or rinsing; mild end-of-day dryness; end-of-day left blur settles after overnight rest. Driving, including at night, and reading are okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nasal conjunctival fibrovascular triangular growth extending approximately 2.5–3 mm onto the cornea from the limbus, not near the visual axis. Mild conjunctival injection around lesion. No ulceration, obvious dellen, or purulent discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Right eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small nasal pinguecula or very early pterygium-like change, with no corneal involvement; asymptomatic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Ocular symptoms and examination negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no significant pain, photophobia, discharge, foreign-body sensation, trauma, halos, diplopia, or headache. Examination: pupils equal and round, reactive to light and accommodation, no relative afferent pupillary defect; extraocular movements full with no diplopia; lids within normal limits; no abrasion or ulcer on basic fluorescein check, tear film slightly irregular over pterygium only; no ciliary flush or photophobia on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Occupational environmental exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works outdoors most days supervising construction sites, with exposure to ultraviolet light, wind, and dust. Historically used poor eye protection: cap and sometimes sunglasses that were not wraparound."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
