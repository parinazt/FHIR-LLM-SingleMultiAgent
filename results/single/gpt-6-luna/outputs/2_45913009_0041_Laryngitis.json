          ]
        },
        "code": {
          "text": "Health anxiety / adjustment-type low mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Hoarseness and sore throat"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hoarseness and sore throat for about 5 days, starting after a week of heavy voice use. Voice hoarse but clear on the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Swallowing and oral intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild dysphagia due to soreness; still eating and drinking adequately. No choking. Drank water during the call without difficulty."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated respiratory and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors, night sweats, significant cough, shortness of breath, or stridor. Mild nasal congestion at the start of the week, now improving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Relevant exposure and smoking history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-smoker; no passive smoke exposure, recent intubation, or chemical exposure."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Health-related worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very anxious about throat cancer and silent reflux after online searching; repeatedly asked whether symptoms could be serious and whether scans or a camera examination were needed. Longstanding pattern of health anxiety and frequent checking, with catastrophic health worries."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Mood and functioning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling really down and teary this week, linked to throat worries. Sleep is broken with rumination; appetite is okay. Still working but finds it hard to focus. Enjoys time with partner and friends when distracted; no clear anhedonia. No previous formal diagnosis of depression or anxiety reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Suicidal ideation, self-harm, and substance use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation and self-harm. No excessive alcohol use or drug use reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Mental status and affect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On the phone, sounds tearful at times; thought content dominated by catastrophic health worries, with no psychotic symptoms. Alert and oriented; anxious affect."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Breathing and speech during telephone assessment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences. No audible stridor or laboured breathing and not short of breath on the phone."
      }
    }
  ]
