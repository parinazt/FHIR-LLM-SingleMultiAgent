      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported introital pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 2 years of superficial burning, sharp stinging pain at the introitus with tampon use and intercourse; sometimes throbbing pain for hours afterwards."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported deep pelvic pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional deep pelvic ache with penetration, especially in certain positions; mild chronic pelvic ache reported currently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period was 7 days ago; regular cycles every 28–30 days with moderate flow; no intermenstrual bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported current associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current abdominal pain apart from mild chronic pelvic ache; no fevers, rigors, dysuria, abnormal discharge, or postcoital bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-looking; appeared time pressured and was checking phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-distended; mild suprapubic/low pelvic tenderness to deep palpation; no guarding, rebound, or masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "External genital examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Labia majora and minora normal; no lesions or fissures. Mild vestibular erythema from 4–8 o'clock; no discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Hymenal tissue examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small crescentic hymenal remnant at the posterior introitus, slightly thicker but non-obstructive and appearing within normal anatomical variation; not rigid, with no active fissure or bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Cotton swab test of vestibule"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Marked allodynia, especially at 5–7 o'clock and just lateral to the urethral meatus; patient withdrew and described sharp burning pain to light touch."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Single-digit pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased pelvic floor tone with marked guarding; finger advancement was difficult and deep palpation was limited by pain, suggestive of pelvic floor overactivity/possible vaginismus component."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Speculum examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partially attempted; patient was very uncomfortable and requested to stop. Cervix grossly normal from the limited view, with no obvious discharge. No cervical motion tenderness on minimal movement."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Bimanual examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not completed due to pain and time constraints."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Current clinical features of acute pelvic inflammatory disease"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No systemic symptoms, significant tenderness, cervical motion tenderness, or abnormal discharge; clinician documented no clinical evidence of acute PID."
      }
    },
