          "text": "Orthopnoea and paroxysmal nocturnal dyspnoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies orthopnoea and PND."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
