    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported for 10/7, mid-to-lower lumbar, right greater than left; dull ache with a sharp twinge on flexion or lifting. Insidious onset without trauma or a single heavy lift. Worse at the end of the teaching day or while marking at a table; better lying flat and with heat. New firmer mattress approximately 3/52 ago and increased gardening may have triggered it."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radicular symptoms, neurological symptoms, bowel or bladder change, night pain, weight loss, or fevers reported. No urinary symptoms or CVA pain. No history of Ca reported."
      }
    },
