        "status": "final",
        "code": {
          "text": "Left shoulder swelling or fullness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the left shoulder looks somewhat puffier and more rounded than the right. Examination: no obvious deformity, possibly very slight anterolateral fullness compared with the right."
      }
    },
