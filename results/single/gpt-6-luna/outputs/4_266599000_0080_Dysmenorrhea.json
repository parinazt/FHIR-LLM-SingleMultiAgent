        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Impact of menstrual pain on work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Missed 2–3 work days in the last 3 months due to pain; concerned about ongoing absences."
      }
    },
    {
