    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1 week of red, mildly itchy spots, beginning as a few dots and becoming more numerous. Multiple small 2–5 mm erythematous, slightly raised papules over the upper anterior chest and shoulders, with scattered papules on the dorsal forearms; some coalesce into small patches. Mild excoriation. Distribution remains above the waist. Itch is worse in the evenings and after showering and does not wake the patient at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Skin findings absent"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vesicles, weeping, pustules, crusting, target lesions, or purpura. Face, palms, soles, and mucosa are spared."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated rash symptoms and findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, fever, systemic symptoms, or recent viral illness. No shortness of breath, wheeze, or lip or tongue swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Urinary frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voids 5–6 times per day and once overnight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Urinary stream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slow stream, unchanged from usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Urinary and genital symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current dysuria, haematuria, loin pain, or suprapubic pain. No genital rash, dysuria, or discharge. No UTI in over 1 year."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General appearance and behavior"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, in no acute distress, talkative, and tangential at times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
