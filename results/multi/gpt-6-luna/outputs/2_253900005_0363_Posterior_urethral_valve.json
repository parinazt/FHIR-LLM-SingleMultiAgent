    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Red, mildly itchy spots on the upper chest and dorsal forearms for about 1 week. Began as a few spots and became more numerous, remaining limited to the upper chest, shoulders and extensor forearms, not below the waist. Itch is worse in the evenings and after showering and does not wake the patient at night."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple small 2–5 mm erythematous, slightly raised papules over the upper anterior chest and shoulders, with scattered papules on the dorsal forearms; some coalesce into small patches. Mild excoriation. No vesicles, pustules, crusting, target lesions or purpura. Face, palms, soles and mucosa spared."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated respiratory and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, wheeze, lip or tongue swelling, fever, systemic symptoms or recent viral illness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Genitourinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No genital rash, dysuria, urethral discharge, haematuria, loin pain or suprapubic pain. No recent urinary tract infection for more than 1 year."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
