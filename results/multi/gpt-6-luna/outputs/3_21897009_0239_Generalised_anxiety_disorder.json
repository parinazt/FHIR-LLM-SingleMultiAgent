          "text": "Health-related worry and checking"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports using Google most nights to read about dementia, cancer, and symptoms; ruminates over minor bodily symptoms and fears cancer or rapidly worsening dementia."
      }
