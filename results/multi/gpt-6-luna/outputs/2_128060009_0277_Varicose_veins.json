        "code": {
          "text": "Right calf pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain initially increased over 2–3 days and is now stable or slightly better, especially with elevation and PRN paracetamol. Pain is 6/10 on walking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
