        "status": "final",
        "code": {
          "text": "Penile pain with intercourse and ejaculation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For about 8–9 months: pulling, burning pain in the penile shaft towards the tip with penetration and ejaculation, especially right when he finishes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
