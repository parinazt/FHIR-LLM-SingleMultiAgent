        "code": {
          "text": "STI screening results"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "HIV, syphilis, chlamydia, and gonorrhoea results were all negative."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Vaginal symptoms at follow-up"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Discharge and odour almost resolved after treatment; mild increase in clear discharge only. No itch, pain, dyspareunia, dysuria, or pelvic pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Medication-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Transient metallic taste and nausea after metronidazole, now resolved."
      }
    },
    {
