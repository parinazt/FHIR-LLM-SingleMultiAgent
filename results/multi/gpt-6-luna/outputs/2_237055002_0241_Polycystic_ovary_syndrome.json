    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Patient-reported rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash under both breasts and in the groin folds, with a few spots under the abdominal apron. Onset approximately 5 days ago; slightly increased over the past 2 days. Itchy with slight burning, worse after work when sweaty in tight uniform. Patient describes red patches with tiny bumps."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Patient-reported rash-associated findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, discharge, blisters, or pus reported. No fevers, rigors, malaise, or arthralgia reported. No previous recurrent fungal skin infections reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well-demarcated erythema in the inframammary and groin folds, with some peripheral scale and satellite papules, especially in the groin. Mild inframammary maceration. No pustules, weeping, fissures, cellulitis, or tenderness. No vesicles, urticaria, or widespread rash."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and nontender; no right upper quadrant tenderness or organomegaly noted on a limited examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Foot examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief examination: skin intact; no ulcers or obvious infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
