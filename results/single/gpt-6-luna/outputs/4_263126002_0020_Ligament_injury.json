          "reference": "Patient/patient-1"
        },
        "valueString": "Skin intact; no erythema or deformity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Right ankle tenderness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender over ATFL and mildly over CFL. Minimal tenderness directly over the tip/posterior edge of the lateral malleolus. No bony tenderness at the medial malleolus, base of the fifth metatarsal, or navicular. No tenderness at the syndesmosis or midfoot."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right ankle range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dorsiflexion and plantar flexion mildly limited at end range by pain; inversion reproduces lateral pain; eversion causes minimal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Right ankle power"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4+/5 in all planes, limited by pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right ankle stability tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anterior drawer painful but with no obvious laxity compared with the left. Talar tilt mildly painful with no clear laxity."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
