    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Rash history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rash began approximately 5/7 ago. Involves both flexor forearms, anterior neck, and a few lesions on the upper chest. Gradual increase in itch, especially at night and at work; itch rated 6–7/10 and wakes the patient from sleep."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Associated symptoms denied with rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies blisters, weeping, oral lesions, fever, URTI symptoms, shortness of breath, wheeze, facial or tongue swelling, difficulty swallowing, joint pain, and gastrointestinal symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Both flexor forearms have multiple 1–3 cm poorly demarcated erythematous, slightly raised dry patches and thin plaques excoriated from scratching. Scattered small erythematous papules/patches of similar appearance on the anterior neck and upper chest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Other skin examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No vesicles, crusting, weeping, warmth, target lesions, mucosal involvement, palmar or plantar lesions, generalized urticaria, or features of secondary bacterial infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "HEENT examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No facial, lip, or tongue oedema. Oropharynx clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear bilaterally; no wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
