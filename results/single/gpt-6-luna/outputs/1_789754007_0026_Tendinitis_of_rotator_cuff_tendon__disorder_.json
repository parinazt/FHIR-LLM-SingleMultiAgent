        "code": {
          "text": "Occupational strain from high manual handling and overhead tasks, contributing to shoulder symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradually increasing over approximately 3–4 weeks; baseline 3–4/10, up to 7/10 with overhead activity. Worse with overhead reaching and reaching behind the back. Night pain when lying on the left side, waking the patient a few times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Patient-reported left shoulder appearance and symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports the left shoulder looks slightly puffy and rounded compared with the right. No reported specific trauma or fall; symptoms coincided with extra shifts and increased manual handling and overhead tasks. No reported neck pain, paraesthesia, dropping objects, fevers, weight loss, or night sweats."
      }
    },
