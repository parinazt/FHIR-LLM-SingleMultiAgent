    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported abdominal and bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull LLQ ache for 4–5 days, 5–6/10, similar to the last episode but milder; worse yesterday and with movement or when bowels are very full, with some relief after a bowel movement; no radiation. Alternating constipation and loose stools over the past week. Stools sometimes a bit narrower, but not persistently. Passing flatus. No vomiting, PR bleeding, or melaena. Mild intermittent nausea; appetite slightly reduced but still eating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported constitutional, urinary, and cardiopulmonary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Possible fevers or chills on days 1–2; no temperatures recorded. Now feels 'off' but is coping with activities of daily living. No dysuria, urinary frequency, flank pain, chest pain, or shortness of breath."
      }
    },
