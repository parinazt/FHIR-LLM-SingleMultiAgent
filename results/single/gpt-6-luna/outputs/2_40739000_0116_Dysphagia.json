        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Swallowing difficulty"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Food feels as though it sticks halfway, around the mid sternum. Mainly affects solids such as meat and bread; solids are more affected than liquids. Occurs most days now. Needs to sip water to get food down and occasionally has to stop and wait."
      }
    },
