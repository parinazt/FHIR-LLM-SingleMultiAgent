    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported cough and associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dry cough for approximately 10 days, beginning after an URTI-type illness; sore throat and blocked nose mostly resolved. Cough is worse in the evenings and when talking a lot at work under air conditioning. Patient wondered whether iced coffee and air conditioning are triggers. No shortness of breath, wheeze, chest tightness, pleuritic chest pain, fever, chills, or haemoptysis. Appetite okay; energy slightly reduced; continues university and work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported facial and upper-arm skin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hypopigmented patches on the cheeks for approximately 3–4 months, more noticeable after tanning over summer; faint similar patches on the upper arms. Mild intermittent itch, especially after hot showers, with some dryness and flakiness. No pain, bleeding, or vesicles. Patient has been scrubbing the face with exfoliant to try to remove the white areas, and the skin now stings."
      }
    },
