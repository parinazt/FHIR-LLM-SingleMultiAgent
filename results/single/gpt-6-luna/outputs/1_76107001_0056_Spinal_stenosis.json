        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Lower limb neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tone normal. Power 5/5 in all groups. Knee reflexes 2+ and ankle reflexes 1+, symmetrical. Light-touch and pinprick sensation intact from L2 to S1."
      }
    },
