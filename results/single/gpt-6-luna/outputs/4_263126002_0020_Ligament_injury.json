    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ankle injury mechanism"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Twisted the right ankle stepping off a curb while carrying boxes, with inversion and plantar flexion; heard a small pop. Able to weight bear straight away but limping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right ankle pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain 4–6/10 when walking, worse on stairs and uneven ground. Still working with reduced weight bearing. Symptoms approximately 50% better since injury."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Right ankle swelling and bruising"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swelling and bruising around the lateral ankle developed within hours, worst in the first 48 hours. At review there is mild diffuse swelling around the lateral malleolus and faint resolving bruising."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
