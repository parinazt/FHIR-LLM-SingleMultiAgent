        "code": {
          "text": "Conjunctival examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral diffuse conjunctival injection, more palpebral, with marked chemosis, especially inferiorly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
