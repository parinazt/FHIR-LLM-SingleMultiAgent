    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Intermittent upper abdominal discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 3 weeks: intermittent, mainly epigastric, queasy/tight discomfort, mild to moderate."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nausea and motion-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Nausea without vomiting; worse in a car, especially on rough or unsealed roads, with sweating and feeling 'crook in the guts' after about 20 minutes on dirt roads. Sometimes occurs on the school bus. Worse when reading or using a phone in the car. Patient says this feels different from usual vestibular migraine: 'more my stomach turning, not spinning'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clear food trigger, GORD symptoms, change in bowel habit, PR blood, melaena, weight loss, fevers, or urinary symptoms. No new neurological symptoms or hearing loss; tinnitus stable."
      }
    },
