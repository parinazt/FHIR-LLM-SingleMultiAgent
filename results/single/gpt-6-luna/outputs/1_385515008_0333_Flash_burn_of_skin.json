          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Given intramuscularly today."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Mupirocin 2% ointment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to open/denuded cheek areas twice daily for up to 7 days or until epithelialised; stop and return for review if rash or irritation occurs.",
            "route": {
              "text": "Topical"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ]
      }
