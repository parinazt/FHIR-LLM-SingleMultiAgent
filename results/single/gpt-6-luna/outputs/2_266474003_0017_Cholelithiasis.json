        "status": "final",
        "code": {
          "text": "Current symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Asymptomatic today; specifically denies current pain, fever, rigors, shortness of breath, chest pain, and vomiting."
      }
    },
