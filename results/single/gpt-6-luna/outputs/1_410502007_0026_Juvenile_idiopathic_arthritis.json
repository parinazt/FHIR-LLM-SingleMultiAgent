    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tired for 2–3 months; still working part-time and managing activities of daily living, but feels wiped out after work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Morning stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Hands and knees stiff for 15–20 minutes most days; improves once moving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "JIA-related symptoms and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Joints currently described as “not too bad”; no overt joint swelling noted. No recent fevers, rash, weight loss, or night sweats. Last major flare was about 2 years ago and required a short prednisolone course. No symptoms of cytopenia or organ involvement reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep and energy drink use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep with late bedtime and phone scrolling; drinks one can of energy drink on most workdays."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Health-related anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very worried about a serious diagnosis, including cancer; extensive online searching and repeated requests for reassurance and cancer markers or scans. Anxious and mildly perseverative but redirectable; reassurance responsive but short lived. Longstanding health anxiety not formally diagnosed and no current psychological input. Insight intact; no suicidal ideation volunteered."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Psoriasis findings and related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent mild plaques on scalp and extensor elbows. No new widespread rash, dactylitis, or significant nail pitting reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Menstrual history and bleeding symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Menses regular every 28–32 days, bleeding for 3–4 days and using 3–4 pads daily; no clots. No rectal bleeding, melena, or haematuria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Diet and activity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diet described as fairly poor; often skips breakfast and eats less red meat. High takeaway intake and low fruit and vegetable intake. Limited exercise because of fatigue and concern about joint pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Eye symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No eye pain, redness, photophobia, or visual change. Last formal eye check was about 2 years ago."
      }
    },
    {
