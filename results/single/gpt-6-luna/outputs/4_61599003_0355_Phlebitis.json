    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Left medial calf symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For 7 days, mild symptoms in the same leg: a tender line over a previous varicose vein area. Earlier in the week there was some redness and slight warmth; the area feels like a bruise and now seems to be settling. Described as a strip about the length of a hand and not very wide. No whole-leg swelling; able to weight bear and walk inside the house."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported negative symptoms and examination limitations on telephone consult"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies sudden increase in calf pain, marked swelling, skin discolouration, shortness of breath, pleuritic chest pain, haemoptysis, dizziness, syncope, palpitations, fevers, or rigors. Voice coherent and speaking in full sentences. Calf circumference, tenderness, Homan sign, cord, warmth, and oedema could not be assessed by phone."
      }
    },
