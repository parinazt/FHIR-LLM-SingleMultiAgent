        "code": {
          "text": "Subacute abdominal pain; cause uncertain. Possible medication-related gastritis/dyspepsia, viral/simple gastroenteritis, nonspecific colitis, early diverticular or functional cause. Mesenteric vasculitis/ischaemia and biliary, pancreatic or renal colic considered less likely."
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
