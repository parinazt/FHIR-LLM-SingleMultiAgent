        },
        "valueString": "Alert and oriented to person, place, and time; fluent speech, symmetrical face, power 5/5 in upper and lower limbs, and normal gait."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Residual symptoms after traumatic brain injury"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports residual short-term memory issues and fatigue only; denies seizures and new neurological symptoms today. Living independently and working full time."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Mood and safety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as pretty stable overall, a bit flat some days but coping; mood described as OK during mental-state examination, with slightly constricted but reactive affect. Denies suicidal ideation, self-harm, hopelessness, and panic."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
