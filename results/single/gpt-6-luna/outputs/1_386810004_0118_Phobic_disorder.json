    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Symptoms with blood, needle, or injection exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports severe anxiety when exposed to or discussing blood, needles, and injections, with sweating, nausea, light-headedness, and feeling close to fainting; often needs to sit or leave the room, especially during vaccination clinics."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Loss of consciousness with phobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No actual loss of consciousness recently."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Avoidance of blood testing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoiding her own care; requested fasting blood tests have not been completed. Timing of the request is uncertain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Mood, energy, interest, and sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as a bit low but better than last year, and as a bit flat but okay; energy okay with some decreased interest. Sleeps 5–7 hours with broken sleep and early waking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, well-looking, mildly anxious and cooperative; occasionally tangential and vague on details. Neat appearance and good hygiene. Engaged, becoming tense and wringing hands when discussing needles. Speech normal in rate and volume, with some hesitancy recalling history. Affect constricted but reactive and congruent. Thought form largely linear, with prominent anticipatory anxiety about blood and needles. No delusions or hallucinations. Insight and judgement reasonable; recognises fear is excessive and interferes with care."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Suicidal and homicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies current suicidal ideation, plan, or homicidal ideation. Reports a past episode of passive suicidal ideation and no past attempts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
