    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bilateral frontal dull, constant headache for 3 days, described as a tight band around the forehead and behind the eyes. Severity 5/10, decreasing to 2–3/10 with Panadol. Worse at the end of the day, with screen work, and when skipping meals. Patient thinks it may relate to too much coffee on late shifts and air conditioning blowing on the face."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Headache-associated photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia only when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies nausea or vomiting, visual loss, focal neurological symptoms, speech problems, confusion, fever, neck stiffness, scalp tenderness, jaw claudication, thunderclap onset, being the worst headache ever, nocturnal waking, trauma, AC, known cancer, weight loss, and pregnancy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
