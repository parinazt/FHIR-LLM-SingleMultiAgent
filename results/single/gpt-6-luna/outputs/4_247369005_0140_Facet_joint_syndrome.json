        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Lumbar back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Longstanding intermittent pain localized to the lumbar region without radiation. Current flare began gradually approximately 3 weeks ago with no trauma. Pain is 4/10 at baseline and up to 7/10 after prolonged sitting or driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain aggravating and relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "Pain is exacerbated by extension and twisting, including hanging washing and reaching into the back seat. Improved with a heat pack, gentle stretches, and distraction."
      }
    },
    {
