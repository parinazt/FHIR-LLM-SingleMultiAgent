    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right lateral elbow pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent pain for approximately 9–10 months, persisting and worse over the last 2–3 months. Local ache at the lateral right elbow, sharp with lifting and gripping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Factors affecting right elbow pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with scanning groceries, lifting bags, pouring a kettle, and gripping a steering wheel, especially with the forearm pronated. Improved with rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Night pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Occasional night pain when rolling onto the affected side, waking the patient a few times per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Morning stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild morning stiffness that settles quickly; no morning stiffness lasting more than 30 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Reported right grip change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Subjective reduction in grip; occasionally drops heavier items."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Right elbow symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma, locking, giving way, redness, warmth, or obvious swelling reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Impact of right elbow pain on activities"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain increases on long, busy checkout shifts; patient swaps hands and takes brief breaks. Avoids heavy housework and gardening; activities of daily living remain okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Constitutional and other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No weight loss, fever, or night sweats. No neck pain, paraesthesia, true weakness (weakness is pain-limited only), other joint pain, rash, or psoriasis reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
