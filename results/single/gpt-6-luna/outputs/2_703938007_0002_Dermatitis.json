    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Left ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pinna with mild erythema and fine scale in the conchal bowl and post-auricular skin; mild tenderness of pinna and tragus. No swelling, cellulitis, or fluctuance. External auditory canal with mild erythema and scant dry scale; no oedema, debris, pus, moist crust, or odour. Tympanic membrane intact with normal landmarks and light reflex; no bulging, retraction, or effusion. No mastoid tenderness or post-auricular swelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
