    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, no acute distress; mildly anxious."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull ache for 3–4 days, initially periumbilical and then lower abdomen, described as mostly lower and sort of all over; severity 3–4/10, not colicky. Worse after large greasy meals and when leaning forward. Passing wind and an over-the-counter antacid help a little. No radiation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Abdominal associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bloating and increased flatus. No nausea, vomiting, dysuria, fever, weight loss, night pain, or appetite change. Bowel movements once daily, formed; no melaena or PR bleeding. No recent travel or sick contacts. Specifically denied persistent vomiting, haematemesis, PR bleeding, melaena, severe localised pain, jaundice, urinary symptoms, and trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender throughout; no guarding, rebound, masses, or organomegaly. Bowel sounds normal. No CVA tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Perianal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Severe perianal itching for approximately 3–4 months, gradually increasing; worse at night and after hot, sweaty shifts, often wakes the patient scratching. Now some soreness. Patient reports skin thickening and small spots of blood on toilet paper after scratching. No visible worms or nocturnal crawling sensation; no similar symptoms in household."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Bowel symptoms associated with perianal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowel movements once daily, formed, sometimes slightly loose after greasy food; no incontinence. No lumps, prolapsing tissue, or mucous discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Perianal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diffuse mild circumferential erythema, lichenification, excoriations, and a few superficial linear fissures. No weeping, ulcer, blister, or purulent discharge. Small soft, non-tender skin tag at 6 o'clock. No obvious external haemorrhoids, thrombosis, warts, abscess, or fistula openings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
