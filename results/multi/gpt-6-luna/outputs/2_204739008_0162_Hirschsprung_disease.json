        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Movicol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "May increase to 2–3 sachets per day short term if more than 2 days without a bowel motion or stool is hard; reduce back to usual once having a daily soft stool."
