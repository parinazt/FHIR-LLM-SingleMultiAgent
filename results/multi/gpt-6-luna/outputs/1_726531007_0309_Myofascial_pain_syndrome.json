          "text": "Sleep disturbance related to discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep mildly disturbed on some nights due to discomfort; no persistent night pain regularly waking the patient."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
