        "code": {
          "text": "Cardiorespiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies exertional chest pain, orthopnoea, paroxysmal nocturnal dyspnoea, leg swelling, and new shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Caffeine intake and perceived trigger"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels symptoms are worse after the second instant coffee; has reduced intake from 3–4 to 1–2 cups per day and reports this already helps."
      }
    },
    {
