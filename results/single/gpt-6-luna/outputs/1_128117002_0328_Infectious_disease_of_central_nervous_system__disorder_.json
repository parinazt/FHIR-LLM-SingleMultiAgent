          "text": "Intermittent blurry vision"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vision goes out of focus intermittently, especially when bending over or standing quickly, then settles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
