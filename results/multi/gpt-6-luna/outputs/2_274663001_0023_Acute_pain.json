        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no improvement; pain approximately 7/10 at worst, described as a deep ache in the lateral/posterior left shoulder"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Left shoulder pain aggravating factors and effect"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Worse with overhead movement and reaching behind the back; sleep is disturbed, especially when lying on the left side; affects some activities of daily living"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Pain radiation and associated neck pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies radiation below the elbow and denies neck pain"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Reported trauma and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma beyond the initial lifting event, fall, dislocation, fever, weight loss, and night sweats; reports no systemic symptoms"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Other reported symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, shortness of breath, and abdominal pain; denies numbness, tingling, weakness, and loss of grip. Briefly reports feeling really tired all the time"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left shoulder inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, swelling, erythema, or wasting"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left shoulder palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tender over the lateral deltoid insertion and upper trapezius; no bony tenderness over the clavicle, AC joint, or humeral head; no warmth"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Left shoulder active range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction to approximately 110°, limited by pain; forward flexion to approximately 150° with end-range pain; external rotation mildly limited by pain; internal rotation painful when reaching behind the back"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Left shoulder passive range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Slightly greater than active range; pain only at end range; no hard block"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Left shoulder strength"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rotator cuff strength 5-/5, limited by pain but symmetrical; no focal weakness"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Left shoulder special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful arc from 70–120°; Hawkins-Kennedy positive; Neer mildly positive; empty can painful with strength preserved; Speed and O'Brien tests equivocal"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full range of motion; no tenderness; Spurling test negative"
      }
    },
