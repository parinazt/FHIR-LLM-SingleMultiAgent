    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right ear symptoms for approximately 10 days: initially itching and mild discomfort, then increasing constant dull pain with sharp twinges on movement of the pinna or chewing; blocked sensation and reduced right-sided hearing; scant clear-to-yellow discharge noticed on the pillow, especially in the morning. Sleep disturbed by pain for the past 2 nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Relevant reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, rigors, headache, tinnitus, vertigo, facial weakness, severe deep nocturnal skull pain, recent upper respiratory infection, known foreign body, and trauma other than cotton bud use."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported recent ear exposures and self-management"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms began after several hot days working and sweating under ear muffs. Recently swimming in a local lake; water quality questioned. Has used new, cheaper over-ear hearing protection for the past few weeks; possible irritant effect questioned. Initially used cotton buds to clean the ear, now stopped."
      }
    },
