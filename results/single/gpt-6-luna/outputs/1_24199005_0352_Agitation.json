    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Agitation, irritability, and concentration difficulties"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reported at work and home. Gets “really wound up,” especially with noise, changes in routine, and unexpected instructions; symptoms have worsened over the last 6–12 months with increased work hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Agitation episodes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Episodes occur most days and include pacing, talking fast, and slamming doors. No physical aggression toward others; patient has punched walls and boxes and said, “I’d never hit anyone just need to hit something.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is poor and irregular; awake replaying work interactions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Caffeine intake"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 5–6 cans of energy drink on early shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sensory triggers at work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports that warehouse lights buzzing are a significant trigger; noise and unpredictable environments contribute to sensory overload."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sometimes wanting to disappear for a while, but says he would not do anything; no suicidal ideation today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mental status examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented ×3. Mildly restless and fidgeting, checking phone and wanting to rush the consultation. Speech pressured at times, normal volume and coherent. Mood: “stressed and on edge all the time.” Affect anxious and irritable, congruent and reactive. Thought form logical and goal-directed, slightly tangential when stressed. No delusions, hallucinations, suicidal ideation, or homicidal ideation today. Cognition grossly intact, with no inattention or fluctuation to suggest delirium. Insight and judgment reasonable."
      }
    },
