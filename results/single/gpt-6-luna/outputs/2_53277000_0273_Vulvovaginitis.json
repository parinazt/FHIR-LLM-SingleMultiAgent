    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache for 3 days, bilateral frontal, described as a dull, constant tight band around the forehead and behind the eyes; severity 5/10, improving to 2–3/10 with paracetamol. Worse at the end of the day, with screen work, and when skipping meals. Mild photophobia only when very tired. Patient wonders whether excessive coffee on late shifts and air conditioning blowing on the face contribute."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated headache symptoms and red-flag history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea or vomiting, visual loss, focal neurological symptoms, speech problems, confusion, fever, neck stiffness, scalp tenderness, jaw claudication, thunderclap onset, worst-ever headache, nocturnal waking, trauma, known cancer, weight loss, or pregnancy. No history of migraine or previous significant headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vulval symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 1 week of vulval itching and soreness, worse at night and after urination. White clumpy discharge without malodour. Mild superficial dyspareunia when symptoms are active. Scratching has caused excoriation. Patient reports recurrent thrush after antibiotics or when sugars are not well controlled."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated vulvovaginal and urinary symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deep pelvic pain, abdominal pain, fever, dysuria, urgency, intermenstrual bleeding, or postcoital bleeding. Clinician noted no features of PID, STI, or bacterial vaginosis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Vulval irritant exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses scented body wash and daily liners."
      }
    },
    {
