        "status": "final",
        "code": {
          "text": "Anxiety during telephone consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sounds anxious and coherent; repeatedly expresses worry about kidney failure and asks whether more tests are needed."
      }
    },
