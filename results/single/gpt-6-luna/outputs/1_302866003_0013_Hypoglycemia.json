    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Metformin XR"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Take 1 tablet (500 mg) at night with the evening meal for 1 week.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "duration": 1,
                "durationUnit": "wk"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 500,
                  "unit": "mg"
                }
              }
            ]
          },
          {
            "text": "Then, if tolerated, take 2 tablets (1000 mg total) at night with the evening meal.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 1000,
                  "unit": "mg"
                }
              }
            ]
          }
        ],
        "note": [
          {
            "text": "New plan; may differ from the previous GP regimen. Gastrointestinal side effects discussed. Advised to stop and seek review if vomiting, severe diarrhoea, shortness of breath, chest pain, or feeling very unwell."
          }
        ]
      }
