    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Right shoulder pain history and characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 5–6 days of right shoulder pain, beginning as a mild ache on waking and worsening, with marked flare over the last 24–48 hours. Described as sharp and grabbing with movement. Anterolateral right shoulder pain radiating to the mid-humerus, not past the elbow. Worse at night; unable to lie on the right side and struggling to sleep. Aggravated by reaching overhead, putting on a jumper, reaching behind the back, reaching across the body, and hanging washing. Arm by side helps; heat pack helps a bit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
