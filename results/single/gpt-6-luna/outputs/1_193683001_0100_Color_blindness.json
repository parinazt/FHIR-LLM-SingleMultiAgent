            }
          ]
        },
        "code": {
          "text": "Congenital red-green colour vision deficiency, stable"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported forearm rash and itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy rash on both forearms for approximately 10 days; still itchy but a bit better. Worse after work and in the evenings."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Associated symptoms and reported negatives with rash"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No pain, fevers, blisters, or weeping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported potential rash exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Works outdoors, pushes sleeves up, has used a new orange heavy-duty degreaser for 2–3 weeks, and has had more sun exposure. Reports the soap really stings if left on. Thinks the rash may be from the soap or from too much Red Bull."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Limited telehealth general examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well, no acute distress, talking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Forearm skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Limited video examination: patchy erythematous papular rash over the extensor surfaces of both forearms, right greater than left. No obvious vesicles, crust, pus, or significant swelling. Hands and palms spared. Appearance non-infected."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported rash colour change and difficulty monitoring colour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient has difficulty telling whether the rash is redder because of red-green colour vision deficiency. His wife reports it has gone from red to more brown."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new visual symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Tiredness and headaches"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Tiredness and headaches after long hot days; patient was asked to book a separate appointment if ongoing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
        "resourceType": "MedicationStatement",
        "id": "medication-statement-1",
        "status": "active",
        "medicationCodeableConcept": {
          "text": "Sorbolene"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosage": [
          {
            "text": "Using since the phone consultation 5 days ago; continue liberally."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to affected areas twice daily for 5–7 days, then once daily as settling. Maximum 2 weeks without review. Avoid face, groin, and broken skin.",
            "route": {
              "text": "Topical"
            }
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Cetirizine"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "10 mg at night as needed for itch; patient plans to use only if itch affects sleep.",
            "asNeededBoolean": true,
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ]
          }
        ]
      }
    }
