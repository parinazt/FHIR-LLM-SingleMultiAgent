        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Intrusive thoughts and images of harming baby"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports intrusive, ego-dystonic images of harming the baby, including on stairs and by smothering. Very distressed by the thoughts, says she would never act on them, and avoids being alone with the baby. No plan or intent to harm the baby."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports passive thoughts of wishing she would not wake up on some days; no plan or intent and no previous attempts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
