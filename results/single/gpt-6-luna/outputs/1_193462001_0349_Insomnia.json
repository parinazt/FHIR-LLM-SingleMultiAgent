        "code": {
          "text": "Sleep diary wakefulness after sleep onset"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "40–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep diary total sleep time and efficiency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Total sleep time 4–6 hours; sleep efficiency approximately 65–70%."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Caffeine use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Usually 3–4 coffees daily, up to 4 cups in the sleep diary; last coffee often at 5–6 pm and caffeine often consumed after 1500."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep-related behaviors and thoughts"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Uses screens in bed, checks work emails, and has screens in bed nightly per sleep diary. Reports pre-sleep rumination about replaying work matters. Sleeps in late on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Fatigue and mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels like she is running on empty; mood described as okay but tired and a bit snappy. Denies low mood, anhedonia, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Sleep-related symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies snoring, apnoeas, restless legs symptoms, parasomnias, and narcolepsy symptoms. No alcohol use for sleep and no benzodiazepine or sedative use."
      }
    },
