        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for 4/7, mainly across the central and bilateral lower lumbar region; described as a deep ache. Worse after long shifts standing and with bending; slightly better lying flat. No specific trauma or heavy lifting beyond usual work duties."
      }
    },
