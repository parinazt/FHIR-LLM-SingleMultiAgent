        "status": "final",
        "code": {
          "text": "Ocular history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of glaucoma or macular disease. Bilateral cataract surgery more than 10 years ago."
      }
