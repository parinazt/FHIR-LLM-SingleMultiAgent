    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports 3–4 days of intermittent dull abdominal pain, 3–4/10, peri-umbilical to lower abdomen and mostly lower, described as ‘sort of all over’. Not colicky. Worse after large greasy meals and leaning forward; passing wind and an over-the-counter antacid help somewhat. No radiation reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal pain associated symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bloating and increased flatus. Denies nausea, vomiting, dysuria, fever, weight loss, night pain, or reduced appetite. Denies persistent vomiting, haematemesis, rectal bleeding, melaena, severe localised pain, jaundice, urinary symptoms, and trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Bowel habit"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports one bowel motion daily, formed; sometimes slightly loose after greasy food. Denies melaena, rectal bleeding, and incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anal itching"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports severe perianal itching for approximately 3–4 months, gradually increasing, worse at night and after hot, sweaty shifts, often waking him scratching. Now some soreness. Brief relief with a cold shower."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Perianal symptoms and pertinent negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports skin thickening and small spots of blood on toilet paper after scratching. Denies lumps, prolapse, mucous discharge, visible worms, nocturnal crawling sensation, or similar symptoms in household members. Denies personal or family history of psoriasis, eczema, IBD, or other dermatoses; denies anal sex and known warts, fissure, or fistula. Denies fever, weight loss, and night sweats."
      }
    },
