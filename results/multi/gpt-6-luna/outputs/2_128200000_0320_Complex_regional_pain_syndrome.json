          "text": "Mild dizziness related to pregabalin, currently tolerable"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right foot pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Baseline burning and tingling pain approximately 5/10, increasing to 8/10 after work shifts; worse when the foot is dependent for long periods at work, a bit better with elevation and cool packs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Right foot skin tenderness and burning sensitivity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For the last 3–4 weeks, skin is very tender and feels like it is on fire if anything brushes it, even a sheet. Cannot keep a sock on for long."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Standing tolerance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Standing on a hard floor all day is not tolerable; continues working approximately 20–25 hours per week on her feet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Sleep disturbance related to right foot sensitivity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is sometimes disturbed when sheets touch the foot, 2–3 nights per week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Dizziness after morning pregabalin dose"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild dizziness or wooziness for 30–45 minutes after the morning dose; reports no falls."
      }
    },
    {
