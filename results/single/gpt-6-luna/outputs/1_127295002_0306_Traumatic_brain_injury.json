    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Persistent unusual sensation in the throat, described as something stuck there; pain mostly settled and now 1–2/10, worse later in the day and better in the morning. Occasional mild midline scratchy feeling just above the sternal notch, not increasing. Sometimes feels a little tight, but food and fluids go down fine; denies dysphagia to solids or fluids and denies odynophagia."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Voice and cough symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice mildly hoarse some evenings after work, otherwise normal. Occasional dry throat-clearing cough, especially in the afternoon; no nocturnal cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reflux symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heartburn a few nights per week, especially after spicy or fatty takeaway meals and late meals; denies regurgitation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Throat symptom-associated negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies fever, chills, weight loss, night sweats, haemoptysis, shortness of breath, chest pain, and appetite change. No history of choking, foreign-body ingestion, or caustic ingestion; no recent neck trauma or intubation since the initial TBI admission."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Throat and neck red-flag screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies progressive dysphagia, unilateral otalgia, neck mass, stridor, drooling, and trismus. No reported weight loss or systemic symptoms; non-smoker."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Oral and pharyngeal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Oral mucosa moist, no ulcers or thrush. Tonsils normal without erythema or exudate; uvula midline. Mild posterior pharyngeal cobblestoning; no visible mass or lesion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
