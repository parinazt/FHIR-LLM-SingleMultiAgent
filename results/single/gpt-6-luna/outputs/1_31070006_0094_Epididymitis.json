        "status": "final",
        "code": {
          "text": "Whitish urethral discharge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for 3 days, initially scant and now increased, especially in the morning; described as whitish and not really pus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Dysuria"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild dysuria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Left testicular and hemiscrotal pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull, constant ache for 3 days, rated 4–5/10; worse with standing or walking and better lying down or with supportive underwear. Patient says the pain tracks along the tube at the back, like the epididymis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Associated urinary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No frank haematuria, fever, rigors, flank pain, nausea, vomiting, or lower urinary tract symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Additional reported symptoms and negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No testicular lump, trauma, sudden onset of severe pain, weight loss, night sweats, abdominal pain, change in bowel habit, or back/flank pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Well appearing, in no apparent distress, walking easily and conversant."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender, with no suprapubic or flank tenderness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Penile and meatal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Normal external penile appearance; mild dried whitish discharge at the meatus and slight meatal erythema. No ulcers, vesicles, or warts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Scrotal and testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum mildly swollen and warmer than the right. Left epididymis feels thickened and is tender, especially at the head/body. Right testis and epididymis are normal and non-tender. No obvious masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Testicular position and cremasteric reflex examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cremasteric reflex present bilaterally; no high-riding testis or horizontal lie."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Spermatic cord and inguinal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild left spermatic cord tenderness. No varicocele or obvious hernia. No inguinal lymphadenopathy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Perineal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Perineum intact, with no erythema or induration."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Prostate and rectal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prostate mildly enlarged and smooth, non-tender, with no bogginess or marked tenderness. No perianal or rectal tenderness."
      }
    },
