    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Intermittent left-sided chest discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief left chest “twinges” lasting a few seconds, intermittent for 2–3 weeks, often at rest (watching television or in bed), non-exertional. Clinician considers them likely non-cardiac, possibly related to anxiety or musculoskeletal causes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported associated symptoms and exercise tolerance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, nausea, vomiting, or diaphoresis with the chest twinges. Walks the dog for 20–30 minutes most days without chest pain or reduced exercise tolerance. No presyncope, syncope, orthopnoea, paroxysmal nocturnal dyspnoea, or ankle swelling. No palpitations today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Anxiety and reported health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very anxious, with extensive internet searching and reassurance seeking. Worried the chest symptoms could be cancer or heart failure starting and asked whether anything was being missed and requested a full body scan."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General appearance and respiratory effort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxious but well; speaking in full sentences."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmur or rub. JVP not raised. No oedema. Peripheral pulses present; warm peripheries."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Chest examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Electrocardiogram"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sinus rhythm at approximately 72 beats/min; normal axis; no acute ST/T changes. Old inferior Q waves unchanged from prior ECG. No fast atrial fibrillation or acute ischaemia."
      }
