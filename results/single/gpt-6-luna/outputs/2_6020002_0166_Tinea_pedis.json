        "medicationCodeableConcept": {
          "text": "Terbinafine 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply once daily to both feet, including between the toes, for 14 days, then continue once daily for 1–2 weeks after clearance.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "route": {
              "text": "topical"
            }
          },
          {
            "text": "Apply once daily to the groin for 2–4 weeks, and for 1 week after clearance.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            },
            "route": {
              "text": "topical"
            }
          }
        ]
