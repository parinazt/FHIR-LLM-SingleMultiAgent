              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Moderate premenstrual syndrome, predominantly mood symptoms and irritability"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Throat tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent tight sensation in the throat, particularly in the evenings when lying down; described as feeling like something is stuck. Reported as occurring 4–5/7."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Throat and swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No true throat pain, dysphagia to solids or fluids, odynophagia, choking, or regurgitation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Hoarseness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent hoarseness, especially after a full day of teaching or yelling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Associated throat symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No coryzal symptoms, cough, fevers, weight loss, or night sweats."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Premenstrual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding irritability, marked mood swings, bloating, breast tenderness, and headaches during the week before menses; symptoms settle 1–2 days after bleeding starts, with the patient essentially well mid-cycle. Cycles are regular, 28–30 days; bleeding lasts 5–6 days. Symptom diary was completed for only part of one cycle and reportedly showed a luteal-phase pattern resolving after menses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "During the week before menses, feels like she is going to snap at everyone, with increased conflict at work and with partner. Reports being more short-fused through the month since starting with a new class. No persistent low mood or anhedonia outside the premenstrual week; denies suicidal ideation and self-harm."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Thyroid and cancer concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports being very anxious about possible thyroid disease or cancer after searching online."
      }
    },
