        "code": {
          "text": "Left foot examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bony enlargement of the left first metatarsophalangeal joint, described as consistent with early osteoarthritis; non-tender."
      }
    },
