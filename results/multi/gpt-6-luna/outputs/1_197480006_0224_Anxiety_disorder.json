    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Anxiety and worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling more on edge over the last few weeks and worrying about everything, especially memory and whether symptoms could be due to a heart problem or cancer. Worry is present most days and worse in the evenings and overnight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep and wakes 1–2 times per night with worry; settles after staff reassurance. No nightmares."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Chest tightness and fluttering"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent mild chest tightness and fluttering when anxious, lasting minutes and settling with slow breathing and staff presence. Reports no clear exertional component, radiation, diaphoresis, nausea, vomiting, or collapse. Describes a similar pattern for years."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and enjoyment"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling 'a bit low' some days but still enjoys chats and television; reports no loss of interest in all activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Memory and word finding"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports losing words more often and worries she is 'going downhill real fast'. Staff report no acute stepwise change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Requests for vital sign checks"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repeatedly requested that nursing staff check blood pressure and pulse during the past week 'in case I'm having a heart attack'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Other health concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient expressed concern that the water smelled funny and might affect her nerves, and that an extra cup of tea at night might not be good for her heart."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Staff-reported recent status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "RACF nurse reports no acute behavioural change, no falls, no recent infections, and that eating and drinking are okay. Anxiety episodes are short and self-limiting and managed with reassurance."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Elderly woman, neatly dressed, mildly anxious, cooperative and engaging; pleasant, with frequent reassurance seeking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Regular heart rate; dual heart sounds, no murmurs or rubs, JVP not elevated, and no oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Respiratory examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chest clear with good air entry."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Neurological and cognitive examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented to person and place; unsure of the exact date, saying 'November sometime'. Speech coherent. No focal deficit on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Affect and thought"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes feeling 'a bit worried all the time'; affect anxious and reactive. Thought content includes prominent health worries and catastrophic interpretations of benign symptoms. No delusions or hallucinations. Thought form mostly linear with some tangentiality, returning to health worries."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Insight and judgement"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partial insight: recognises anxiety but remains concerned that something serious could be missed. Judgement fair for simple decisions."
      }
    },
