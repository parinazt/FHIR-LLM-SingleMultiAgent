    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right great toe pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain around the base of the right great toe for 3–4 days, described as throbbing and burning; 6/10 at baseline and up to 8/10 after a long shift the previous day. Worse with walking and at night; difficulty wearing usual closed-in sneakers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Possible right great toe trauma"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No clear trauma recalled; patient is unsure but says she might have kicked the bed leg last week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported right first metatarsophalangeal swelling and redness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports that the right first metatarsophalangeal joint feels swollen and red."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
