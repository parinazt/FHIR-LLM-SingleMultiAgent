        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports sleep-onset insomnia while ruminating about work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Mood and stress"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes feeling stressed and a bit overwhelmed; reports being constantly on edge and unable to switch off in the context of work stress over the last 2–3/12. Denies persistent low mood, anhedonia, hopelessness, and suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Stress-related symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies current panic attacks; reports often feeling jittery with palpitations when stressed. Appetite reported as okay."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Brief mental state examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cooperative; speech normal rate and volume; affect mildly anxious and reactive; thought process coherent; thought content appropriate; no psychosis or suicidal ideation expressed."
      }
