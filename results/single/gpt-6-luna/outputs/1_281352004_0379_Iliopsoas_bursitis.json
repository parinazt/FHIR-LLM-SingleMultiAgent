    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported right groin/anterior hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vague onset, possibly a few weeks to a couple of months. Aching pain with intermittent sharp twinges, especially with hip flexion such as lifting the leg into a car, using stairs, moving from sitting to standing, and putting on socks. Worse at the end of the day after standing or bending over low desks. Occasional radiation into the anterior right thigh, not below the knee. Severity approximately 5/10 at baseline and up to 7/10 with movement. Improved by rest, some stretching, and a heat pack; unsure which tablets may help (possibly Panadol or Nurofen). Still working but avoiding playground duty; harder to sit on the floor with children."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Red-flag and associated symptom screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers, night sweats, weight loss, or recalled recent trauma. No bowel or bladder change or saddle anaesthesia. Mild occasional low back ache. No history of malignancy, TB, or IVDU. No abdominal, urinary, or gastrointestinal symptoms. No clinical features of sepsis currently."
      }
    },
