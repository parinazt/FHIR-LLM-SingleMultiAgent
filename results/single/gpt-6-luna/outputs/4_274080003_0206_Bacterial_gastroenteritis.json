      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Travel and food or water exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Two-week trip to Bali, including Kuta and Ubud; budget accommodation, daily street food, and mixed tap and bottled water. Multiple mosquito bites in the evenings. No malaria prophylaxis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Relevant exposure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Partner had loose stool for 2 days, which settled. No tattoos or procedures overseas, intravenous drug use, new unprotected sex, or known hepatitis contact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Relevant medical history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Generally well; no chronic diagnoses and no history of IBD or coeliac disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-20",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-20",
        "status": "final",
        "code": {
          "text": "Assessment of malaria, dengue, and hepatitis concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient is concerned about malaria, dengue, and hepatitis A/E. Clinician discussed these as unlikely given an afebrile, gastrointestinal-predominant presentation and timing. No dengue serology or malaria film ordered at this stage. Hepatitis A/E incubation was explained as longer, with no current features."
      }
    },
