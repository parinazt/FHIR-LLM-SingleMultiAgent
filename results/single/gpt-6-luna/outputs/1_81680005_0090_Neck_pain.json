        "code": {
          "text": "Acute watery diarrhoea, likely self-limiting infectious gastroenteritis (viral or foodborne) versus post-antibiotic gut flora change"
        },
        "subject": {
          "reference": "Patient/patient-1"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
