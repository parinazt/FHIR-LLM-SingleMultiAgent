        "code": {
          "text": "Back and bilateral hip pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ongoing lower back and bilateral hip pain, worse with prolonged standing and walking more than 50–100 m, relieved by sitting. Usual pain 5/10, flaring to 7/10."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
