        },
        "code": {
          "text": "Rectal cancer, post-treatment; surveillance overdue and current staging unclear"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Subacute cough; differential includes viral or atypical lower respiratory tract infection, early pneumonia, GORD-related cough, or cancer-related cough including lung metastases"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Cough"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cough for approximately 2–3 weeks, gradually worsening; mostly dry with occasional small amounts of clear/white sputum; worse overnight and on waking, disturbing sleep most nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Respiratory symptoms and reported negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath on exertion, described as puffing more while walking to the letterbox. Denies haemoptysis, pleuritic chest pain, wheeze, fever, chills, rigors, orthopnoea, and paroxysmal nocturnal dyspnoea. No recent upper respiratory tract infection."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Possible cough irritant exposures queried by patient"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient wondered whether a new home air freshener might be an irritant and queried whether bore water might be unsafe."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Appetite and weight"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Appetite has been poor intermittently since cancer treatment. Patient thinks he has lost a couple of kilos; no regular weights available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent lower abdominal discomfort and loose stools, described as longstanding. Denies persistent vomiting and marked abdominal distension; still passing flatus and stool. Reports no significant rectal bleeding, though sometimes a small amount of blood on the paper."
      }
    },
