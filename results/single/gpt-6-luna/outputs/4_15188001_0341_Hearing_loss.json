        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Small amount of dry cerumen bilaterally, not occlusive. No canal erythema or discharge. Tympanic membranes intact with normal light reflex; no bulging, retraction, effusion or perforation."
      }
    },
