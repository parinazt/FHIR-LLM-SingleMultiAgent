    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Progressive skin and oral mucosal pigmentation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports progressive darkening over approximately 3–4 months, including dorsal hands, knuckles, elbows, palmar creases, old scars on shins, gums, and inside cheeks. Examination shows subtle generalized bronzing compared with a prior identification photo, more marked hyperpigmentation at the reported sites, and brown macular pigmentation along gingival margins and buccal mucosa. No ulceration or leukoplakia. The assessment states the picture is consistent with chronic increased ACTH driving pigmentation despite replacement therapy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
