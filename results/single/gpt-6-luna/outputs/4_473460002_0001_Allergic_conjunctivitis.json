        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Fluticasone furoate nasal spray 27.5 mcg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Use 2 sprays in each nostril every morning for 1 week, then 1–2 sprays in each nostril every morning through the allergy season.",
            "route": {
              "text": "Intranasal"
            }
          }
        ]
      }
