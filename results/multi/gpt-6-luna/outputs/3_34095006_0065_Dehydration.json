    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acute pain for 4/7, mainly central and bilateral across the lower lumbar region, described as a deep ache. Worse after prolonged standing at work and with bending; slightly better lying flat. No specific trauma or heavy lifting beyond usual work duties. Pain reproducible with lumbar extension and prolonged standing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain associated symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No radiation to legs, numbness, tingling, weakness, saddle anaesthesia, bowel or bladder incontinence, fever, rigors, night sweats, recent viral symptoms, weight loss, or severe unrelenting night pain reported."
      }
    },
