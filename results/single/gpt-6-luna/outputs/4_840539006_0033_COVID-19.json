        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On day 5, feels mostly fine, with a little tiredness and scratchy throat; cough is improving. No fever for the last 48 hours. Eating and hydrating adequately."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
