    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Gambling pattern, control, and associated harms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports electronic gaming machine gambling most days at his workplace and sometimes at a nearby club, with some late-night online sports betting. Ongoing for at least 12 months and worse since the venue reopened after COVID. Preoccupied with gambling, including thinking about which machine is due at dinner. Reports difficulty controlling gambling: plans to spend $50 or be home by 9 pm but stays for hours and spends a few hundred dollars; last week spent about $1,200 over three nights. Reports being behind on credit card and Afterpay payments and having a small personal loan; thinks one good night will fix it. Reports increased conflict with his ex-partner about child support and conflict with his mother about money. Has stopped gym and fishing activities, preferring to keep money for gambling."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Brief problem gambling screen"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Both questions positive; screen indicates probable gambling disorder. PGSI not completed because of time and tangential history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Describes mood as flat and stressed in relation to gambling losses and debt, and as stressed and a bit ashamed during the assessment. No persistent low mood or anhedonia outside the gambling context."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Anxiety and panic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Anxiety is mostly related to money worries. No panic reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Poor sleep, with late-night phone use and betting until 2–3 am; reports insomnia after gambling losses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Suicidal thoughts and safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No current suicidal ideation or plan. Occasionally thinks it would be easier to disappear, but denies intent. Protective factors identified: daughter and close relationship with mother. Clinician assessed no acute suicide risk today and noted high psychosocial and financial risk if gambling continues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Alcohol use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 3–4 beers after late shifts and 6–7 beers on pay nights. Denies morning drinking and blackouts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
