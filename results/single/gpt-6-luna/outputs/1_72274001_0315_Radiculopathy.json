    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Neck and right arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for approximately 4 months, from the neck into the right lateral arm to the thumb and index finger. Initially worse, then partially decreased, now increasing again over the last 2–3 weeks, especially at night and keeping the patient awake most nights. Neuropathic quality described as shooting and burning."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right hand sensory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pins and needles in the right thumb and index finger with occasional numbness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Dropping objects"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports dropping things with the right hand a few times over the last month; describes this as possibly being clumsy."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Aggravating factors for neck and arm pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looking down at a phone, hanging washing, and long drives."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Pain relief and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heat pack and rest provide relief. Sleep is poor; some difficulty with activities of daily living, including hanging washing and carrying shopping. Reduced driving and some home visits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cervical spine examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right paracervical tenderness greater than left. Reduced extension and right lateral flexion; flexion slightly reduced. Spurling test positive, reproducing right arm pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Upper limb sensation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reduced light-touch sensation in the right thumb and index finger; left side normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right upper limb motor examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right elbow flexion 4+/5, wrist extension 4/5, grip 5/5; patient reports intermittent weakness."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Upper limb reflexes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right biceps and brachioradialis reflexes reduced compared with left; triceps reflexes equal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Neurological examination and gait"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Upper motor neuron signs absent. Hoffmann sign negative. Plantar responses flexor bilaterally. Gait to the door and back normal. Lower limb screen grossly normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Red flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies gait disturbance, limb heaviness, saddle symptoms, bowel or bladder incontinence or retention, bilateral symptoms, Lhermitte sign, fine motor decline, weight loss, fevers, night sweats, and trauma. No left-sided symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Comfortable at rest, moves neck cautiously, appears tired, and is in no acute distress."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient mentioned feeling more tired lately."
      }
    },
