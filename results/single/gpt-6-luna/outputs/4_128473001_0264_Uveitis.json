    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual intermittent blurry vision for approximately 3 weeks, left greater than right and worse at the end of the day; the patient feels as though she is straining the left eye. Mild left photophobia requiring squinting outdoors. Occasional dull ache around the left eye, not severe; no sharp pain. The right eye is described as 'ok maybe not as sharp as before'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported ocular symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No eye discharge, gritty sensation, or itch. No flashes, floaters, curtain, or visual field loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Visual acuity, right eye"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6/9 on an in-room Snellen chart."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
