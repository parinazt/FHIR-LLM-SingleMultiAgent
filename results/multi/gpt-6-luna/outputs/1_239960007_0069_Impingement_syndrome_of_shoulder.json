        "code": {
          "text": "Right subacromial pain syndrome / impingement, likely rotator cuff overload from repetitive overhead work"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Pain for approximately 5–6 days, initially a mild ache on waking and now worse, with a marked flare over the last 24–48 hours. Sharp and grabbing with movement. Pain is 7–8/10 with movement and 3/10 at rest. Anterolateral right shoulder pain radiating to the mid-humerus, not past the elbow. Worse at night; unable to lie on the right side and struggling to sleep. Aggravated by reaching overhead, putting on a jumper, reaching behind the back, reaching across the body, and hanging washing. Better with the arm by the side; heat pack helps a bit."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Pertinent symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No neck pain, paraesthesiae, chest pain, shortness of breath, fevers, sweats, weight loss, redness, or swelling."
      }
    },
