        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Low mood and tearfulness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling really down and teary this week, clearly linked to throat symptoms and fear of serious illness. Tearful at times on the phone. No formal previous diagnosis of depression or anxiety reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
