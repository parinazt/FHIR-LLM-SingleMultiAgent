        },
        "valueString": "Well-looking; mildly impatient and frequently on phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Visual acuity grossly intact; able to read phone and wall chart. Right eye: small, slightly raised yellow lesion on nasal bulbar conjunctiva adjacent to limbus, non-vascularised, with no corneal encroachment, significant injection, or tenderness. Left eye: smaller similar nasal lesion. Pupils equal and reactive; extraocular movements intact. No discharge, chemosis, or obvious pterygium."
      }
    },
