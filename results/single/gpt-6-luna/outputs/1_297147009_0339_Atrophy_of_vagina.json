        "code": {
          "text": "Likely genitourinary syndrome of menopause / vulvovaginal atrophy"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Urinary frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increased urinary frequency for approximately 3–4 months, worse over the last few weeks; voids small volumes every 1–2 hours during the day."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Nocturia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voids 2–3 times nightly, previously 0–1 times."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Urinary urgency and urge incontinence"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild urgency; no urge incontinence."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Urinary and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No dysuria or burning, visible haematuria, fever, flank pain, suprapubic pain, nausea, or vomiting."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Postmenopausal status"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Postmenopausal for approximately 7 years."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vaginal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For approximately 12 months: vaginal dryness and discomfort, stinging, and a 'sandpapery' sensation, especially at the introitus."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
