    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Acute low back pain for 4 days, mainly central and bilateral across the lower lumbar region, described as a deep ache. Worse after long standing shifts and with bending; slightly better lying flat. No specific trauma or heavy lifting beyond usual work duties. New mattress 2 weeks ago may be contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Back pain-associated negative symptoms and red flags"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg radiation, numbness, tingling, weakness, saddle anaesthesia, bowel or bladder incontinence, fever, rigors, night sweats, recent viral symptoms, weight loss, or trauma. No features identified of spinal infection, malignancy, renal colic, or pyelonephritis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported symptoms and hydration history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache for 2 days, dry mouth, light-headed on standing at work, darker urine today and reported markedly reduced urine volume. Reports decreased fluid intake over the past week, particularly in hot weather and during longer shifts; mainly drinking coffee and a couple of soft drinks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Bowel pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Known short bowel syndrome after small bowel resection. Baseline loose stools approximately 2–3 times daily; over the past week increased to 4–5 loose stools daily. No blood or severe cramping."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Patient-reported concern about kidney disease"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient repeatedly expressed concern that her kidneys were shutting down and insisted that she had a kidney infection or stones, despite being advised that examination and urinalysis were not suggestive of renal pathology. No urinary symptoms reported."
      }
    },
