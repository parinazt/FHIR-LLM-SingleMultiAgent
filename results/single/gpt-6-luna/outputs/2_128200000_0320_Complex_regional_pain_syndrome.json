        "code": {
          "text": "Right foot skin colour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild erythema and mottling over the dorsum compared with the left."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
