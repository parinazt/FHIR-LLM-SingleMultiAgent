        "code": {
          "text": "Foot numbness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild chronic numbness in the feet, unchanged from baseline for more than 6 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Leg weakness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No new leg weakness reported. Patient feels generally weaker and more tired, described as longstanding with cachexia."
      }
    },
    {
