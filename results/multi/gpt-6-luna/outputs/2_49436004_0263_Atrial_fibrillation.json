    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Lower back pain for approximately 7–10 days, gradual onset without specific injury; dull ache across the belt line, occasionally sharp with twisting. Worse getting out of bed, standing, and walking for more than a few minutes; eases sitting and leaning forward on walker. Sleep somewhat disturbed by pain when turning in bed; pain initially worse on lying, then settles. Patient wonders whether a new soft mattress or prolonged sitting in a lounge chair may contribute."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Low back pain severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Up to 7/10 at worst; currently approximately 4/10 after morning Panadol given by staff."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
