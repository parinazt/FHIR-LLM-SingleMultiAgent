        },
        "valueString": "No dysuria, urinary frequency, or haematuria reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels opened this morning with normal stool. No rectal blood or mucus, diarrhoea, constipation, or obstipation reported. No bloating beyond usual post-meal bloating."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Gynaecological symptoms and pregnancy possibility"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Last menstrual period approximately 2 weeks ago; regular cycles. No vaginal bleeding, discharge, or pelvic pain reported. Patient denies possible pregnancy and reports her husband had a vasectomy years ago."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Abdominal pain red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sudden-onset tearing pain, chest pain, shortness of breath, dizziness, syncope, jaundice, dark urine, or pale stool reported. Pain has not consistently localized to the right lower or right upper abdomen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
