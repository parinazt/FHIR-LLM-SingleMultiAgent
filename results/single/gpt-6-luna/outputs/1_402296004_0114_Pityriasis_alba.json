    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Ill-defined hypopigmented macules and patches on both cheeks and lateral jaw, 1–3 cm, with very fine scale on close inspection and non-sharply demarcated borders; background mildly tanned. No complete depigmentation or erythema. A few faint hypopigmented patches with minimal scale on the upper arms. No lesions consistent with tinea versicolor; trunk clear. No classic chalk-white vitiligo patches."
      }
    },
