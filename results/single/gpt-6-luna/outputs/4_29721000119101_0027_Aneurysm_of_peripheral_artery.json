    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Subjective fever"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling feverish for 2–3 days with chills and alternating hot and cold sensations overnight. Home thermometer was flat; no home temperature readings available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Night sweats"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports waking with a soaked shirt; wife reports he has been sweaty for the last two nights."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "General symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling achy and washed out. Wife reports he has been off his food and not himself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Frontal headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild frontal headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Appetite and nausea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Decreased appetite and some nausea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vomiting and diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies vomiting and diarrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Right popliteal region pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "For about one week, reports increased ache behind the right knee at the site of the known popliteal aneurysm: dull baseline pain with occasional sharp stabbing pain on walking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right leg swelling and warmth"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks the area behind the right knee may be a bit puffier and warmer than the other leg. On video it appeared slightly fuller than the left, but assessment of size, pulsatility and warmth was difficult because of poor lighting and video quality. No obvious erythema or skin breakdown seen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Trauma to right leg"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Exertional shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath on exertion over the past few days; reports puffing more when coming up the stairs."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Cardiorespiratory symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies chest pain, orthopnoea, paroxysmal nocturnal dyspnoea, cough, sore throat and rhinorrhoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Urinary and flank symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysuria, urinary frequency and flank pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Recent exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no recent dental work, skin infections or sick contacts. Patient wonders whether symptoms could relate to questionable mince or tank water that has tasted unusual; gastrointestinal symptoms are minimal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "General appearance and mental status on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and oriented; appears unwell but not toxic, speaking in full sentences. Face slightly flushed; no obvious pallor or cyanosis. Speech coherent with no obvious confusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Respiratory rate and effort on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Respiratory rate visually estimated at approximately 18–20 per minute; unlaboured, with no audible wheeze or cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Mobility and gait on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Able to stand and walk a few steps. Gait mildly antalgic, favouring the right leg, but stable."
      }
    },
