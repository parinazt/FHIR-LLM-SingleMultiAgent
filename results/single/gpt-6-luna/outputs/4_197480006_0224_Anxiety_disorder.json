    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Anxiety and worry"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports excessive worry most days, worse in the evenings and overnight; feels more on edge over the last few weeks and worries about memory, heart symptoms, and cancer."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Takes longer to fall asleep and wakes 1–2 times per night with worry; settles after staff reassurance. No nightmares."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Mood and anhedonia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit low some days and still enjoys chats and television; no anhedonia for all activities."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Suicidal ideation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies suicidal ideation today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Chest tightness and fluttering"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent mild chest tightness and fluttering when anxious, lasting minutes and settling with slow breathing and staff presence; similar pattern for years. No clear exertional component, radiation, diaphoresis, nausea, vomiting, or collapse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Cognitive concerns"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports losing words more often and worries she is going downhill quickly. Alert and oriented to person and place; unsure of exact date, saying November sometime. Speech coherent; no focal deficit on brief screen."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "RACF staff report"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No acute behavioural change or falls; short, self-limiting anxiety episodes managed with reassurance; eating and drinking adequately; no recent infections or new medications."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Reassurance-seeking behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repeatedly asked nursing staff over the past week to check blood pressure and pulse in case of a heart attack; repeatedly seeks reassurance about whether further tests are needed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "General appearance and behaviour"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Elderly woman, neatly dressed, mildly anxious, cooperative and engaging; frequent reassurance-seeking questions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Mental state examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mood described as a bit worried all the time; anxious and reactive affect. Prominent health worries and catastrophic interpretation of benign symptoms; no delusions or hallucinations. Thought form mostly linear with some tangentiality, returning to health worries. Partial insight and fair judgement for simple decisions."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Cardiovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Heart sounds dual; no murmurs or rubs. JVP not elevated; no oedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
