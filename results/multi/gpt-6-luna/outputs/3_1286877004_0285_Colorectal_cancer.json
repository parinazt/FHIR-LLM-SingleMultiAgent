          "text": "Metastatic colorectal cancer with recurrent malignant ascites"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Likely relative intravascular depletion with postural/light-headed symptoms during rapid large-volume drainage"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Diverticular disease, stable without acute symptoms"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Abdominal distension and tightness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports that his abdomen distends and feels tight between drains, then improves after drainage. Today he described it as pretty big again, but not as bad as when it is really tight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Ascitic fluid drainage amount and frequency"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports draining about 2 to 3 litres every second day. Says the oncology nurse told him he could drain up to 4 litres a day if needed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath when ascites is tense; no acute shortness of breath at rest. He spoke in full sentences during the phone call."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Light-headedness during drainage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit woozy if the fluid is let out quickly; his wife says they are trying to drain it slowly over a couple of hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels moving daily and softer. No PR bleeding, vomiting, colicky pain, or absolute constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other reported negative symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors, new focal severe abdominal pain, or confusion reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Weight and muscle loss"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports that his arms are getting skinny and is concerned he is losing protein through the drain. Progressive weight and muscle loss is noted in the history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Voice and speech during phone call"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice strong; not breathless during the call and no slurring."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports right shoulder soreness when pruning roses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Toenail concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient described a toenail as 'funny'; no further details recorded."
      }
    },
