        "code": {
          "text": "External eye inspection"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild left ciliary flush around the limbus; no obvious discharge or lid swelling. Right eye white and quiet."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
