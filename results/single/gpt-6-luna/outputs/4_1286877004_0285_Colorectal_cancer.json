          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Likely relative intravascular depletion associated with rapid large-volume ascites drainage"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Ascites drainage pattern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Draining about 2 to 3 litres every second day at home through a tunnelled peritoneal drain; oncology nurse said up to 4 litres a day if necessary."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Abdominal distension"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen distends and feels tight between drains, then improves after drainage. Described as pretty big again but not as bad as when really tight."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Shortness of breath"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild shortness of breath when ascites is tense; no acute shortness of breath at rest. Speaking in full sentences on the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Light-headedness with drainage"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Feels a bit woozy if the fluid is allowed to run out quickly; wife is trying to slow drainage over a couple of hours."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Weight and muscle loss"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Progressive weight and muscle loss; patient says his arms are getting skinny."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Bowel symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Bowels moving daily and softer. No PR bleeding, vomiting, colicky pain, or absolute constipation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Other symptoms and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fevers or rigors, new focal severe abdominal pain, or confusion. No features consistent with acute peritonitis or obstruction by history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Voice strong, not breathless during the call, and no slurring. No observations available; patient was at home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right shoulder soreness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right shoulder sore when pruning roses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Toenail concern"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports a 'funny toenail'; no further details provided."
      }
    },
