    {
      "fullUrl": "https://example.org/fhir/Observation/observation-27",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-27",
        "status": "final",
        "code": {
          "text": "Skin and mucosal findings on video"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Multiple well-demarcated raised erythematous violaceous plaques on cheeks and dorsal forearms, some coalescing, with smooth surface. No obvious vesicles, pustules, crusting, or ulceration. Patient reports tenderness to touch. No obvious facial swelling; lips and oral mucosa appear normal when mouth opened; no conjunctival injection."
      }
