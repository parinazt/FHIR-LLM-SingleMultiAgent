        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Distress when away from partner or home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports marked distress most days when away from her partner or home; says she feels physically sick and cannot focus until he returns."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Anticipatory anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports anticipatory anxiety the night before her partner goes to work or social events; symptoms have worsened over the last 2 months with his office days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Worry about partner's safety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient worries that something bad will happen and her partner will not come home; her thought content is dominated by worries about his safety and being alone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
