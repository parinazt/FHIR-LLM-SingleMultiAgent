    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left shoulder pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No improvement; pain approximately 7/10, described as a deep ache at the lateral/posterior left shoulder. Worse with overhead movement and reaching behind the back."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left shoulder pain-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sleep is disturbed, especially when lying on the left side. No radiation below the elbow and no neck pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Shoulder function and work"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still working and avoiding lifting; reports difficulty continuing to protect the shoulder."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Reported red-flag symptoms and relevant negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No trauma beyond the initial lift, fall, dislocation, systemic symptoms, fever, weight loss, night sweats, chest pain, shortness of breath, abdominal pain, numbness, tingling, weakness, or loss of grip."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and frustrated; not in obvious distress at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Left shoulder inspection and palpation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No deformity, swelling, erythema, or wasting. Tender over lateral deltoid insertion and upper trapezius. No bony tenderness over clavicle, AC joint, or humeral head; no warmth."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Left shoulder range of motion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Active abduction to approximately 110 degrees, limited by pain; forward flexion to approximately 150 degrees with end-range pain; external rotation mildly limited by pain; internal rotation painful when reaching behind the back. Passive range slightly greater than active, with pain only at end range and no hard block."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left shoulder strength and special tests"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Rotator cuff strength 5-/5, limited by pain but symmetrical; no focal weakness. Painful arc from 70–120 degrees; Hawkins-Kennedy positive; Neer mildly positive; empty can painful with strength preserved; Speed and O'Brien equivocal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Cervical spine and upper-limb neurovascular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Cervical spine full range of motion, no tenderness, Spurling test negative. Upper-limb neurovascular examination intact."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Fatigue"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient briefly reports feeling really tired all the time and requests a full blood check-up."
      }
    },
    {
