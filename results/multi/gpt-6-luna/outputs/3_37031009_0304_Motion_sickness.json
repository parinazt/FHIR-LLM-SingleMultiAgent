      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Motion sickness"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Travel-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports nausea, mild spinning or lightheaded sensation, and cold sweats during travel, especially as a passenger in a car on winding roads. Describes a long-standing tendency to feel unwell during travel, though onset and timeline are vague; recent increased awareness with longer drives to work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Factors affecting travel-associated symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Symptoms are worse when reading or using a phone in a moving car. They improve when looking at the horizon, sitting in the front passenger seat, or when the car stops."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vertigo symptoms at rest and with positional changes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports no symptoms at rest, no vertigo when rolling over in bed or with quick head turns, and denies true room spinning at rest."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Vomiting during car travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports vomiting in a car a couple of times; unsure when, saying possibly last month or the time before."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Symptoms during air travel"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports that flights sometimes cause nausea, especially during takeoff or landing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Reported hearing and ear symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies hearing loss, tinnitus, aural fullness, current ear pain, ear discharge, or hearing change."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported neurological and other red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies focal neurological symptoms, including diplopia, dysarthria, dysphagia, limb weakness, facial droop, weakness, numbness, or paraesthesia; denies visual loss, gait disturbance, blackout episodes, seizures, sudden severe headache, chest pain, shortness of breath, palpitations, syncope, fever, recent upper respiratory infection, sinus symptoms, or recent head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Gastrointestinal and psychological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports nausea and occasional vomiting only in motion. Denies abdominal pain, altered bowel habit, and anxiety or depression symptoms today. Reports variable sleep due to shift work, which she feels is baseline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Headache history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports past 'bad headaches' in high school and intermittent 'bad headaches' with nausea, but is unsure whether the earlier headaches were migraines and could not describe the pattern in detail."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Status during telephone consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Currently asymptomatic at rest during the call. Audio-only consultation; no vitals available."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Audio-only examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences with strong voice. Affect appropriate and coherent; speech fluent without slurring. No audible cough or wheeze and no shortness of breath noted over the phone."
      }
    },
    {
