    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left scrotal ache and dragging discomfort"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dull ache and dragging in the left hemiscrotum for 3–4 days; worse after standing all day at work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Left scrotal swelling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Swelling present for months, previously described to the patient as a hydrocoele; now feels slightly larger and more uncomfortable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Associated scrotal symptom negatives"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No sudden severe pain, nausea or vomiting, abdominal pain, dysuria, urinary frequency, haematuria, urethral discharge, fever, rigors, weight loss, night sweats, trauma, or lifting beyond usual."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Patient-reported groin findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient has not noticed an obvious groin lump into the canal or a cough impulse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks well and is talking clearly."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdomen soft and non-tender; no masses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Inguinal and femoral hernia examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No palpable inguinal or femoral hernia on cough."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Left scrotal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Left hemiscrotum enlarged and smooth, without erythema. Fluctuant, non-tender swelling around the left testis; transilluminates strongly. Left testis palpable within but difficult to fully delineate; feels normal where palpated, with no discrete lump."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Right testicular examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Right testis normal on examination."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "Other scrotal and groin examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No epididymal tenderness, palpable varicocele, increased warmth, or inguinal lymphadenopathy. No features suggesting acute torsion today."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Behaviour and mental state"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert, oriented, coherent. Mood described as “a bit irritable”; affect appropriate. No psychotic features. Calm and cooperative in consultation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-17",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-17",
        "status": "final",
        "code": {
          "text": "Reported irritability and mood symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports feeling “a bit on edge and cranky,” especially in the evenings after work. Denies low mood and anxiety; reports no new stressors and thinks this is probably because the scrotum is sore and annoying. Partner reports he has been “not himself” for 3–4 days and has been guarding his groin and walking differently for the last 2 days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-18",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-18",
        "status": "final",
        "code": {
          "text": "Concern about testicular cancer"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient asked whether he should be worried about cancer; partner is concerned about testicular cancer risk, particularly because he may present late if something changes. Clinician assessed risk as still low, with the hydrocoele obscuring examination of the testis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-19",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-19",
        "status": "final",
        "code": {
          "text": "Penile examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Foreskin retracts; no obvious issues."
      }
    },
