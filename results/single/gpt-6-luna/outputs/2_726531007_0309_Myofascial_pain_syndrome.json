      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-16",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-16",
        "status": "final",
        "code": {
          "text": "Health-related worry and observed anxiety"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Very health anxious, tense and fidgety; repeatedly expressed fear of cancer or a missed serious diagnosis, reported extensive internet searching, and requested scans or blood tests."
      }
    },
