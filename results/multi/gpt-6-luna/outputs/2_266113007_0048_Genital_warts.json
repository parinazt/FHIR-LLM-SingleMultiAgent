        "medicationCodeableConcept": {
          "text": "Imiquimod 5% cream (Aldara)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to visible warts three times weekly at night (e.g. Monday, Wednesday, Friday); wash off 6–10 hours later; use up to 16 weeks or until clearance. If marked irritation occurs, decrease frequency or pause.",
            "route": {
              "text": "Topical"
            },
