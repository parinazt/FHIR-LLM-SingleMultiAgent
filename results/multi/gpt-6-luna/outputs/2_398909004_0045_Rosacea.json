            }
          ]
        },
        "code": {
          "text": "Mild ocular rosacea"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Facial redness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central cheeks and nose red for approximately 12–18 months, worse over the last 6 months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Facial flushing"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent bright redness with heat, hot drinks, a glass of wine, and work stress; episodes last approximately 30–60 minutes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Facial burning and stinging"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burning and stinging, especially after showering and in the air-conditioned office."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Patient-reported pimples"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports no pimples: “no zits just goes bright red.”"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Response to topical metronidazole"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports it is “a bit better” and “takes the edge off”; still has episodes of bright redness. Uses the gel most days and misses some evening doses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Possible contributors to facial redness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient thinks a new “natural essential oil moisturiser” or “too much instant coffee at work” may be contributing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Gritty eyes"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild gritty eyes in the evenings for several months."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Patient-reported eye symptoms and contact lens use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No photophobia, blurred vision, or discharge; does not use contact lenses."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "General observations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Within normal limits."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Facial examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Central fixed erythema of the cheeks and nose with fine telangiectasia; no papules, pustules, comedones, or scale."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Eye examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild bilateral conjunctival injection. Visual acuity grossly okay on phone. PERRLA. No obvious lid disease."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationStatement/medication-statement-1",
      "resource": {
