    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports intermittent dull left-sided headache, 2–3/10, worse when overtired. Denies sudden severe headache, early-morning vomiting, and nocturnal headache waking him."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Cognition and memory"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports he has always been absent-minded. Patient and daughter (per prior notes and patient report) describe him as a bit more forgetful, misplacing items and repeating questions. He has some delay recalling exact dates but remains able to recount his hospital stay and daily routine consistently. Denies getting lost in familiar places."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Gait and balance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports feeling a bit wobbly, especially on first standing or in dim light, and needing furniture support indoors. Reports one near-fall 2 weeks ago while turning quickly in the kitchen; caught himself on a bench. No further actual falls since discharge."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Independent with basic self-care but slower; sits to shower because of fear of falling. Manages simple meals. Has stopped ladder work, roof work, and garden work."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Instrumental activities of daily living"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Not driving as advised by hospital. Relies on daughter for shopping and transport to appointments; daughter brings groceries and frozen meals weekly and has arranged direct debit for bills. Patient is not managing complex finances himself."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Sleep"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Broken sleep; wakes 2–3 times overnight thinking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Mood"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies low mood; acknowledges frustration about decreased independence. Denies suicidal ideation."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Visual symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports occasional eyes feeling a bit fuzzy when tired. Denies diplopia and acute visual loss."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Speech and swallowing symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies dysarthria, dysphasia, and swallowing issues."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Seizure history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of seizures before or after the subdural haematoma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Neurological symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "On direct questioning, denies facial asymmetry, limb weakness, and numbness. Denies new focal weakness, new incontinence, and rapid increase in confusion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "General status during telephone consultation"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Alert and conversant; oriented in conversation to person, place, and time. Engaged and polite; tends to minimise symptoms and repeatedly says he does not want to be a bother."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-13",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-13",
        "status": "final",
        "code": {
          "text": "Speech on telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speech fluent, with no word-finding difficulty over the phone."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-14",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-14",
        "status": "final",
        "code": {
          "text": "Respiratory status on telephone examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Speaking in full sentences; no audible shortness of breath."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-15",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-15",
        "status": "final",
        "code": {
          "text": "CT brain findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Per hospital discharge summary, CT brain approximately 6 weeks ago showed post burr-hole evacuation of left fronto-parietal chronic subdural haematoma, small residual collection, minimal midline shift, no acute haemorrhage, and no hydrocephalus. No repeat imaging since."
      }
    },
