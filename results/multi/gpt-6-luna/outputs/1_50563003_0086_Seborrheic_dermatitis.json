        "code": {
          "text": "Reported scalp and facial symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic flaky, itchy scalp and facial rash, increased over the last 3–4 weeks. Itch is mild; the skin feels tight and is described as greasy and scaly. Distribution reported: scalp, eyebrows, nasolabial folds, peri-auricular areas, and hairline."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Scalp examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Diffuse fine white-yellow scale with mild frontal and parietal erythema. No plaques, pustules, or fissures."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
