    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent dull band-like headache across the forehead and temples, sometimes extending to the occiput, for approximately 3 weeks. Worse later in the day after long bar shifts or screen use. Severity 3–4/10, up to 6/10 on bad days. Sleep helps; Panadol 500 mg, 1–2 tablets as needed, provides partial relief. Rare mild nausea. No thunderclap onset or worst-ever headache; no vomiting, photophobia, phonophobia, aura, visual changes, focal neurological symptoms, speech changes, confusion, fever, neck stiffness, weight loss, night sweats, sinus symptoms, or trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Neurological examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Non-focal; cranial nerves intact; gait and coordination normal; no meningism; fundoscopy showed no abnormality and no papilloedema."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Vulval symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient reports vulval 'little bumps' for 2–3 months and thinks they may be from shaving. Mild itch or irritation after sex or wiping; no significant pain, bleeding, discharge, or systemic symptoms."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Pelvic examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Approximately 6–8 soft, skin-coloured/verrucous papules, 2–4 mm, on the labia minora and posterior introitus; non-tender, with no ulceration or vesicles. No discharge. Vagina and cervix normal. No inguinal lymphadenopathy."
      }
    },
