        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies current chest pain, orthopnoea, and paroxysmal nocturnal dyspnoea."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-21",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-21",
        "status": "final",
        "code": {
          "text": "Cardiovascular and abdominal examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Dual heart sounds with no added sounds; no oedema; no carotid bruits. Abdomen soft and non-tender, no masses, no palpable AAA."
      }
    },
