    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Sleep disturbance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports poor sleep with repeated waking, estimating 4–5 hours of broken sleep. No difficulty initially falling asleep. Denies low mood, racing thoughts, or early waking independent of the ear pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Right ear pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Sharp pain at night when lying on the right side, described as like someone jabbing a match in the ear. Settles when turning over or rubbing the ear, then recurs when lying on it again. Ongoing approximately 3–4/12 and getting worse."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Right upper ear lesion"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports a small painful lump on the upper right ear for approximately 6/12, worse with pressure on the pillow and sometimes crusty. Examination: approximately 6–7 mm firm, tender, dome-shaped nodule on the helix/upper antihelix, with superficial central erosion and slight scale/crust and mild surrounding erythema. Very focal tenderness to light pressure. No fluctuation or warmth. No obvious rolled edge or pearly lesion; crust partly obscures the lesion."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Associated ear and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies ear discharge, bleeding other than cracking, hearing loss, tinnitus, vertigo, and fevers."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Ear examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No preauricular or postauricular nodes. Ear canals and tympanic membranes normal."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Brief skin examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Brief examination of face, scalp, and dorsal hands found no obvious other suspicious lesions; this was not a full skin check."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
