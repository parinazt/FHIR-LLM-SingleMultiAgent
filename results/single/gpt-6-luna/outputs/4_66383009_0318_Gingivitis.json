        "code": {
          "text": "Oral examination: plaque and calculus"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Generalised soft plaque and obvious supragingival calculus along the gingival margins, especially lingual lower incisors and buccal upper molars."
      }
    },
