            }
          ]
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Asthma, poorly controlled"
        }
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Pre-collapse symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "While on playground duty at school, the patient felt chest tightness and lightheadedness before collapsing."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Collapse and recovery"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "The patient next recalled being on the ground with colleagues around. Recovery was rapid, reported as under 1 minute; afterward she felt shaky, without a post-ictal state."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Witness-reported and patient-denied features during collapse"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Witnesses reported no convulsions. No incontinence or tongue bite. The patient reported no palpitations, chest pain, focal neurological symptoms, or headache."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Syncope history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No previous syncope reported. Patient reports no known cardiac history and is not pregnant by history."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Recent asthma symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Over the last 1–2 weeks, increased wheeze and shortness of breath with stairs and reading in class; night cough 3–4 times per week; salbutamol used most days."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Asthma severity features and possible triggers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Asthma diagnosed in the teenage years. No history of ICU admission or intubation; last ED visit was years ago. Patient reports substantial dust and upper respiratory infections at school."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Asthma symptoms on the day of collapse"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild chest tightness in the morning. Salbutamol 2 puffs approximately 1 hour before the event gave partial relief. Patient said the collapse did not feel like typical severe asthma; colleagues heard no audible wheeze."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
