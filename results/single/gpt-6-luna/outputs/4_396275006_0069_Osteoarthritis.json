        "status": "final",
        "code": {
          "text": "Lower-limb and red-flag symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No leg radiation, pins and needles, weakness, saddle numbness, or bladder/bowel issues. No fevers, weight loss, night sweats, or pain waking her from sleep. No trauma or cancer history reported; no systemic symptoms, neurological deficit, or sphincter disturbance elicited."
      }
    },
