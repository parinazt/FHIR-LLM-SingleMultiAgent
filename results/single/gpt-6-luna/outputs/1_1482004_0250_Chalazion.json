        "status": "final",
        "code": {
          "text": "Reported morning eye crusting"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Eyes are often a bit crusty in the mornings, reported in the context of chronic blepharitis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported ocular and systemic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Vision okay; no diplopia, significant eye pain, painful eye movements, photophobia, increased discharge beyond usual morning crusting, fever, or feeling systemically unwell. Patient reports being able to open and close the eye fully."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
