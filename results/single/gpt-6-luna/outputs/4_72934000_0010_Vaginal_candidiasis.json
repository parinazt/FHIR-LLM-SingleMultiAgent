          "text": "External burning with urination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Burning when urine hits the vulva; assessed as external dysuria from inflamed vulval tissue."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Vulvar symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itchy and burning vulva, worse at night and after shifts."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Vaginal discharge, patient-reported"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thick white discharge persists, but is a bit less than last week."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Pain with attempted sexual intercourse"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Superficial pain with attempted sex two nights ago; stopped due to pain."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Urinary symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No suprapubic pain, urgency, or haematuria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Other symptoms denied"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No fever, abdominal or flank pain, or abnormal bleeding."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
