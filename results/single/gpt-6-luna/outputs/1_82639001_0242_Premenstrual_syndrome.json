    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Recent febrile and respiratory illness symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "About 6 days before the visit, sudden subjective fevers, sweats, myalgias, mild headache, nasal and scratchy-throat symptoms for 2–3 days, and mild dry cough. Upper respiratory symptoms and fever have resolved; fever settled by the second day of menstrual bleeding. No thermometer reading was taken. Today feels mostly back to normal, with a little tiredness. No rigors, urinary symptoms, gastrointestinal symptoms, or rash; no shortness of breath beyond usual mild asthma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Premenstrual symptoms and menstrual history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding mood symptoms 7–10 days before menses, including irritability, tearfulness, and feeling unable to cope at school, with breast tenderness, bloating, and more migraines. Symptoms improve by day 1–2 of bleeding. Cycles regular every 28–30 days. Last menstrual period was 5 days before the visit. No contraception; not actively trying to conceive, but pregnancy would be acceptable. No suicidal ideation. Mood is reported to be okay between cycles."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Migraine history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Migraine without aura, 1–2 episodes per month, clustering in the premenstrual week. No red flags reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Asthma symptoms and reliever use"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild intermittent asthma. Used SABA 2 days before the visit in response to a dust storm. No nocturnal symptoms."
      }
    },
