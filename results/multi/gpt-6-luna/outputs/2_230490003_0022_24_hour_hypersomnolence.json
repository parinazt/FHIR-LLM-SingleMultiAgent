    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "General appearance"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Looks tired but comfortable."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Lumbar examination"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild tenderness of the right lumbar paraspinals; no midline tenderness. Slightly reduced flexion with pain, but able to move in all directions. Straight-leg raise negative bilaterally. Lower-limb power, reflexes, and sensation grossly normal. Gait okay. Examination was limited."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Daytime sleepiness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Longstanding hypersomnolence. Patient says she could nap pretty much any time, anywhere. Partner reportedly says she nods off on the couch and at work; patient minimizes the concern. Patient feels drowsy a lot and has zoned out at red lights, but denies actually falling asleep while driving."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-11",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-11",
        "status": "final",
        "code": {
          "text": "Sleep history and schedule"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Prior sleep study about 2 years ago with a private sleep specialist in Sydney reportedly showed periodic limb movements; records unavailable and patient is not on treatment. Patient kicks during sleep and this disturbs her partner. Per partner, no snoring or apnoeas. Patient denies cataplexy, sleep paralysis, and hallucinations. Usually in bed around 10–11 pm and gets up at 6–6:30 am; wakes unrefreshed."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-12",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-12",
        "status": "final",
        "code": {
          "text": "Mood and cognitive symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports low motivation, fatigue, poor concentration, and feeling foggy. Denies current suicidal ideation."
      }
    },
